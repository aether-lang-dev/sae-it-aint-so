// sae's stdlib ROM spec: mquickjs's core library (mode 2, which has no
// load() and no OS access) plus the page API. A page can reach only what is
// registered here; this list is the sandbox boundary.
//
// The DSL functions are mquickjs-ae's gen/genengine, linked into the same
// generator tool. Every name on the right ("sae_ui_vstack", ...) must have a
// prototype in src/sae_rom.c, or the ROM table fails to compile.

extern mqjs_stdlib_spec(mode: int) -> ptr
extern mqjs_extra_cfuncs(mode: int) -> ptr
extern build_global(spec: ptr) -> ptr
extern build_atoms(stdlib_name: ptr, global_obj: ptr, c_function_decl: ptr, argc: int, argv: ptr) -> int
extern object(_ctx: ptr, name: ptr) -> ptr
extern cfunc(_ctx: ptr, name: ptr, length: int, fn: ptr)
extern statics_of(spec: ptr) -> ptr
extern mq_cgetset(_ctx: ptr, name: ptr, getn: ptr, setn: ptr)

sae_stdlib_main(argc: int, argv: ptr) -> int {
    g = mqjs_stdlib_spec(2)

    u = statics_of(object(g, "ui"))
    cfunc(u, "vstack", 2, "sae_ui_vstack")
    cfunc(u, "hstack", 2, "sae_ui_hstack")
    cfunc(u, "text", 1, "sae_ui_text")
    cfunc(u, "btn", 2, "sae_ui_btn")
    cfunc(u, "divider", 0, "sae_ui_divider")
    cfunc(u, "button", 2, "sae_ui_button")
    cfunc(u, "scroll", 1, "sae_ui_scroll")
    cfunc(u, "spacer", 0, "sae_ui_spacer")
    cfunc(u, "textfield", 2, "sae_ui_textfield")
    cfunc(u, "get_text", 1, "sae_ui_get_text")
    cfunc(u, "set_text", 2, "sae_ui_set_text")
    cfunc(u, "clear", 1, "sae_ui_clear")
    cfunc(u, "into", 2, "sae_ui_into")
    cfunc(u, "toggle", 2, "sae_ui_toggle")
    cfunc(u, "slider", 4, "sae_ui_slider")
    cfunc(u, "picker", 1, "sae_ui_picker")
    cfunc(u, "picker_add", 2, "sae_ui_picker_add")
    cfunc(u, "progressbar", 1, "sae_ui_progressbar")
    cfunc(u, "set_progress", 2, "sae_ui_set_progress")
    cfunc(u, "set_toggle", 2, "sae_ui_set_toggle")
    cfunc(u, "get_toggle", 1, "sae_ui_get_toggle")
    cfunc(u, "set_slider", 2, "sae_ui_set_slider")
    cfunc(u, "get_slider", 1, "sae_ui_get_slider")
    cfunc(u, "styles", 1, "sae_ui_styles")
    cfunc(u, "add_class", 2, "sae_ui_add_class")
    cfunc(u, "style_id", 2, "sae_ui_style_id")
    cfunc(u, "timer", 2, "sae_ui_timer")
    cfunc(u, "set_visible", 2, "sae_ui_set_visible")
    cfunc(u, "timer_cancel", 1, "sae_ui_timer_cancel")
    cfunc(u, "onclick", 1, "sae_ui_onclick")
    cfunc(u, "margin", 4, "sae_ui_margin")
    cfunc(u, "bg_color", 4, "sae_ui_bg_color")
    cfunc(u, "ui_state", 1, "sae_ui_state")
    cfunc(u, "ui_set", 2, "sae_ui_set")
    cfunc(u, "text_bound", 3, "sae_ui_text_bound")

    v = statics_of(object(g, "vg"))
    cfunc(v, "scene", 4, "sae_vg_scene")
    cfunc(v, "circle", 4, "sae_vg_circle")
    cfunc(v, "rect", 5, "sae_vg_rect")
    cfunc(v, "rrect", 6, "sae_vg_rrect")
    cfunc(v, "line", 5, "sae_vg_line")
    cfunc(v, "path", 2, "sae_vg_path")
    cfunc(v, "text", 4, "sae_vg_text")
    cfunc(v, "g", 1, "sae_vg_g")
    cfunc(v, "fill", 1, "sae_vg_fill")
    cfunc(v, "stroke", 2, "sae_vg_stroke")
    cfunc(v, "opacity", 1, "sae_vg_opacity")
    cfunc(v, "transform", 1, "sae_vg_transform")
    cfunc(v, "on_click", 1, "sae_vg_on_click")
    cfunc(v, "set_fill", 2, "sae_vg_set_fill")
    cfunc(v, "set_text", 2, "sae_vg_set_text")
    cfunc(v, "set_stroke", 3, "sae_vg_set_stroke")
    cfunc(v, "set_opacity", 2, "sae_vg_set_opacity")

    ht = statics_of(object(g, "http"))
    cfunc(ht, "get", 2, "sae_http_get")
    cfunc(ht, "post", 4, "sae_http_post")

    st = statics_of(object(g, "storage"))
    cfunc(st, "get", 1, "sae_storage_get")
    cfunc(st, "set", 2, "sae_storage_set")
    cfunc(st, "remove", 1, "sae_storage_remove")

    bc = statics_of(object(g, "browserContext"))
    cfunc(bc, "changePage", 1, "sae_bc_change_page")
    cfunc(bc, "back", 0, "sae_bc_back")
    cfunc(bc, "forward", 0, "sae_bc_forward")
    cfunc(bc, "reload", 0, "sae_bc_reload")
    mq_cgetset(bc, "currentUrl", "sae_bc_current_url", "NULL")

    return build_atoms("js_stdlib", build_global(g), build_global(mqjs_extra_cfuncs(2)), argc, argv)
}
