// Generated-header node: builds the stdlib-ROM generator (mquickjs-ae's
// genengine plus sae's own spec) and runs it to emit the atom table and the
// ROM table. Published as c_header_dirs for the sae program node.

import bldr
import c
import c (sources, include, cflag, emit, aether_source)

aeb(cap) {
    bldr.build() {
        c.generated_header() {
            cflag("-D_GNU_SOURCE")
            cflag("-fno-math-errno")
            cflag("-fno-trapping-math")
            include("../mqjs")
            sources("sae_gen_main.c")
            sources("../mqjs/mquickjs_build.c")
            aether_source("../mqjs/gen/buildtool/bt_predicates.ae")
            aether_source("../mqjs/gen/buildtool/bt_atomlist.ae")
            aether_source("../mqjs/gen/genengine/module.ae")
            aether_source("sae_spec.ae")
            emit("-a", "mquickjs_atom.h")
            emit("", "sae_stdlib.h")
        }
        return 0
    }
}
