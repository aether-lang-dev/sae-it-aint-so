// services/shell — the one place sae hands a URL to the system (the page
// API's `shell.open`, app mode). See docs/architecture.md.
//
// It imports exactly one UI name, ui.open_url (AppKit's NSWorkspace on
// macOS), and two file calls for the spec log. tests/check_layers.sh fails
// if any other module in sae names open_url, so this is the only route to
// it: a build without this module has no way to open a URL at all.
//
// A URL is opened only if the app's grants (capabilities.shell.open in
// app.json, handed in by the kernel) list a prefix of it. A web page in the
// browser has no shell.

import ui (open_url)
import std.fs (read, write_atomic)
import std.string
import std.strarr

exports (new, configure, grant, granted, refusal, open)

// One launch's shell grants: the kernel holds one (new()) and passes it to
// every call; nothing here is module state.
struct Shell {
    enabled: int    // 0 in the browser
    log: string     // SAE_SHELL_LOG: record URLs here instead (specs)
    prefixes: ptr   // strarr: URL prefixes the app may open
}

// For a web page: no shell.
new() -> ptr {
    u = heap.new(Shell)
    u.enabled = 0
    u.log = ""
    u.prefixes = null
    return u as ptr
}

// Set up for an app (enabled 1) or a web page (0). `log`, when not "",
// is a file the URLs are appended to instead of being opened.
configure(h: ptr, enabled: int, log: string) {
    u = h as *Shell
    u.enabled = enabled
    u.log = string.copy(log)
    u.prefixes = strarr.new()
}

// A URL prefix the app may open ("https://github.com/").
grant(h: ptr, prefix: string) {
    u = h as *Shell
    if u.prefixes != null { strarr.push_copy(u.prefixes, prefix) }
}

// 1 if the app may open any URL at all.
granted(h: ptr) -> int {
    u = h as *Shell
    if u.enabled == 0 || u.prefixes == null { return 0 }
    if strarr.size(u.prefixes) > 0 { return 1 }
    return 0
}

// Why `url` may not be opened, or "".
refusal(h: ptr, url: string) -> string {
    u = h as *Shell
    if u.enabled == 0 { return "shell.open: not available to a web page" }
    if u.prefixes != null {
        n = strarr.size(u.prefixes)
        i = 0
        while i < n {
            if string.string_starts_with(url, strarr.get(u.prefixes, i)) == 1 { return "" }
            i = i + 1
        }
    }
    return "shell.open: this app may not open ${url} (app.json capabilities.shell.open lists what it may)"
}

// Open `url` if the grants allow it; "" or why not.
open(h: ptr, url: string) -> string {
    u = h as *Shell
    why = refusal(h, url)
    if why != "" { return why }
    if u.log != "" {
        prev, _e = read(u.log)
        _w = write_atomic(u.log, string.bytes("${prev}${url}\n"))
        return ""
    }
    open_url(url)
    return ""
}
