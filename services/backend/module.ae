// services/backend — an app's own backend process, on an inherited channel
// (docs/app-backend.md). The one place sae starts a program.
//
// sae is the parent: start() spawns the program app.json names with
// os.run_stdio, and the channel is the child's own stdin and stdout, two
// pipes only sae holds the other ends of. Nothing is written to the file
// system, nothing listens, and there is no key: holding the descriptors is
// the capability, and only sae and the child it started hold them. The same
// pipes work on every platform, Windows included, and through a container
// runtime that passes stdin and stdout through: start_wslc() runs a Linux
// backend in a WSL container on Windows (`wslc run --rm -i`).
//
// Each Backend is an instance with its own state (the kernel holds one per
// app); nothing here is shared between them. Frames are std.ipc's
// (a 4-byte big-endian length, then the bytes), each one JSON:
//
//   sae -> backend   {"id": n, "call": "<name>", "arg": "<string>"}
//   backend -> sae   {"id": n, "ok": true, "result": "<string>"}
//                    {"id": n, "ok": false, "error": "<message>"}
//                    {"event": "<name>", "data": "<string>"}
//
// The kernel reads them on the UI thread a tick at a time (poll never
// waits for a frame to start), so a backend cannot stall the window.
//
// poll reads each frame with services/frames rather than with
// ipc.read_frame_timeout, so that when the stream is not frames (a backend
// printed to stdout before it claimed the channel, or a wrapper wrote to it)
// the reason can quote the bytes that broke it.

import std.os
import std.io (fd_close)
import std.ipc
import std.list
import std.string
import std.json
import services.frames

exports (start, start_wslc, alive, why, call, poll, stop, excerpt, MAX_FRAME)

// The largest frame either side may send. A header announcing more is an
// error, and the channel is closed.
const MAX_FRAME = 1048576

// A frame that has begun must be whole within this; a backend that sends a
// header and stalls is cut off.
const FRAME_MS = 2000

// Grace between closing the channel and killing a backend that has not
// exited by itself.
const STOP_GRACE_S = 2

struct Backend {
    wr: int          // the child's stdin, written with frames, or -1 once closed
    rd: int          // the child's stdout, read for frames, or -1 once closed
    pid: int         // the child's spawn token, or -1 once reaped
    why: string      // why it is no longer running, "" while it is
    frames: int      // frames read so far
    hint: string     // said after an exit status when it exits before its first frame
}

// Start `program` (a path the kernel has already resolved inside the app)
// with the arguments in `argv` (a std.list of strings, or null).
// (backend, "") or (null, why).
start(program: string, argv: ptr) -> (ptr, string) {
    args = argv
    own = 0
    if args == null {
        args = list.new()
        own = 1
    }
    h, err = spawn_(program, args, "")
    if own == 1 { list.free(args) }
    if err != "" { return null, "backend: could not start ${program}: ${err}" }
    return h, ""
}

// Start a Linux backend in a WSL container on Windows: `wslc run --rm -i
// --pull never <image> <command...>`, the container's stdin and stdout the
// channel. `command` is a std.list of strings (the program inside the image
// and its arguments; empty runs the image's own). The image must be there
// already: sae does not pull one at launch (wslc writes its pull progress to
// stderr, not into the channel, but a pull is a download the person did not
// ask for, and calls would time out behind it). (backend, "") or (null, why);
// anywhere but Windows, why.
start_wslc(image: string, command: ptr) -> (ptr, string) {
    if os.platform() != "windows" {
        return null, "backend: a wslc backend runs only on Windows (wslc is Windows 11's WSL container tool); this is ${os.platform()}"
    }
    args = list.new()
    list.add(args, "run")
    list.add(args, "--rm")
    list.add(args, "-i")
    list.add(args, "--pull")
    list.add(args, "never")
    list.add(args, image)
    if command != null {
        n = list.size(command)
        i = 0
        while i < n {
            cv, _ = list.get_string(command, i)
            list.add(args, cv)
            i = i + 1
        }
    }
    hint = "(if wslc said the image is not there: wslc pull ${image}, or build it)"
    h, err = spawn_("wslc", args, hint)
    if err != "" {
        // Not on this process's PATH (a shell that set its own, as MSYS2's
        // does, without %ProgramFiles% either): where WSL installs it.
        pf = os.getenv("ProgramFiles")
        if pf == null || pf == "" { pf = "C:\\Program Files" }
        h2, err2 = spawn_("${pf}\\WSL\\wslc.exe", args, hint)
        if err2 == "" {
            h = h2
            err = ""
        }
    }
    list.free(args)
    if err != "" { return null, "backend: could not start wslc (Windows 11's WSL container tool): ${err}" }
    return h, ""
}

spawn_(program: string, args: ptr, hint: string) -> (ptr, string) {
    wr, rd, pid, err = os.run_stdio(program, args, null)
    if err != "" { return null, err }
    b = heap.new(Backend)
    b.wr = wr
    b.rd = rd
    b.pid = pid
    b.why = ""
    b.frames = 0
    b.hint = hint
    return b as ptr, ""
}

// 1 while the channel is open.
alive(h: ptr) -> int {
    if h == null { return 0 }
    b = h as *Backend
    if b.rd < 0 { return 0 }
    return 1
}

// Why the backend is no longer running ("" while it is).
why(h: ptr) -> string {
    if h == null { return "backend: none" }
    b = h as *Backend
    return b.why
}

// Ask the backend to run `name` with `arg`, as request `id`. "" or why not.
call(h: ptr, id: int, name: string, arg: string) -> string {
    if alive(h) == 0 { return why(h) }
    b = h as *Backend
    o = json.obj()
    _i = json.set(o, "id", json.from_int(id))
    _c = json.set(o, "call", json.str(name))
    _a = json.set(o, "arg", json.str(arg))
    text, eerr = json.encode(o)
    json.json_free(o)
    if eerr != "" { return "backend: ${eerr}" }
    if string.length(text) > MAX_FRAME { return "backend: the request is larger than ${MAX_FRAME} bytes" }
    werr = ipc.write_frame(b.wr, text)
    if werr != "" {
        lost_(b, "backend: the channel failed: ${werr}")
        return b.why
    }
    return ""
}

// The next frame the backend has sent, if one has begun: (frame, "") with
// the JSON text, ("", "") when none is waiting, ("", why) when the backend
// has gone (it closed the channel, or broke the protocol) and is stopped.
poll(h: ptr) -> (string, string) {
    if alive(h) == 0 { return "", why(h) }
    b = h as *Backend
    ready, werr = ipc.wait_readable(b.rd, 0)
    if werr != "" {
        lost_(b, "backend: the channel failed: ${werr}")
        return "", b.why
    }
    if ready == 0 { return "", "" }
    data, st, rerr = frames.read(b.rd, MAX_FRAME, FRAME_MS, " (its stdout is the channel: nothing but frames may be written there)")
    if st == frames.EOF {
        lost_(b, "")   // it closed its end: it has exited or is exiting
        return "", b.why
    }
    if st == frames.BROKE {
        lost_(b, "backend: ${rerr}")
        return "", b.why
    }
    if st == frames.FAILED {
        lost_(b, "backend: the channel failed: ${rerr}")
        return "", b.why
    }
    b.frames = b.frames + 1
    return data, ""
}

// `s` quoted for a reason (services/frames' excerpt).
excerpt(s: string) -> string {
    return frames.excerpt(s)
}

// Close the channel, give the backend STOP_GRACE_S to exit by itself, then
// kill it, and reap it. Safe to call twice.
stop(h: ptr) {
    if h == null { return }
    b = h as *Backend
    lost_(b, "backend: stopped")
}

// Close the channel and reap the child, killing it if it has not exited
// within STOP_GRACE_S. The first reason is kept; "" means the backend closed
// its end itself, and the reason is how it exited.
lost_(b: *Backend, reason: string) {
    if b.wr >= 0 {
        _c = fd_close(b.wr)
        b.wr = 0 - 1
    }
    if b.rd >= 0 {
        _d = fd_close(b.rd)
        b.rd = 0 - 1
    }
    how = ""
    if b.pid >= 0 {
        st, timed_out, _we = os.wait_pid_timeout(b.pid, STOP_GRACE_S)
        how = "it exited with status ${st}"
        if st != 0 && b.frames == 0 && b.hint != "" { how = "${how} ${b.hint}" }
        if timed_out == 1 {
            _k = os.kill(b.pid, 9)
            _w = os.wait_pid(b.pid)
            how = "it was killed: it had not exited ${STOP_GRACE_S} s after its channel closed"
        }
        b.pid = 0 - 1
    }
    if b.why == "" {
        if reason == "" { b.why = "backend: ${how}" } else { b.why = string.copy(reason) }
    }
}
