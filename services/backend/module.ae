// services/backend — an app's own backend process, on an inherited channel
// (docs/app-backend.md). The one place sae starts a program.
//
// sae is the parent: start() spawns the program app.json names with
// os.run_stdio, and the channel is the child's own stdin and stdout, two
// pipes only sae holds the other ends of. Nothing is written to the file
// system, nothing listens, and there is no key: holding the descriptors is
// the capability, and only sae and the child it started hold them. The same
// pipes work on every platform, Windows included, and through a container
// runtime that passes stdin and stdout through: start_wslc() runs a Linux
// backend in a WSL container on Windows (`wslc run --rm -i`).
//
// start_socket() is the second transport (docs/design/ipc-backends.md): the
// child gets one end of a socket pair at its fd 3 (std.ipc's socket
// channel), which carries the same frames both ways and, down only, an open
// descriptor (a document the person picked, call's `fd`); its stdout stays
// its own. It is contained with sandbox.spawn_socket, held to the grants
// app.json gave it, and fails closed where Aether cannot contain a child; or
// started with spawn_socket_uncontained when app.json says "none" or the
// person launched sae with --uncontained-backend. Not on Windows: std.ipc
// has no socket channel there.
//
// Each Backend is an instance with its own state (the kernel holds one per
// app); nothing here is shared between them. Frames are std.ipc's
// (a 4-byte big-endian length, then the bytes), each one JSON:
//
//   sae -> backend   {"id": n, "call": "<name>", "arg": "<string>"}
//   backend -> sae   {"id": n, "ok": true, "result": "<string>"}
//                    {"id": n, "ok": false, "error": "<message>"}
//                    {"event": "<name>", "data": "<string>"}
//
// The kernel reads them on the UI thread a tick at a time (poll never
// waits for a frame to start), so a backend cannot stall the window by
// writing; and calls go out through a services/frames Writer, written a
// tick at a time as the backend takes them (never with a write that waits),
// so it cannot stall the window by not reading either. A call
// it has not taken within frames.WRITE_MS (5 s) stops it, killed at once:
// "backend: it stopped reading its stdin".
//
// poll reads each frame with services/frames rather than with
// ipc.read_frame_timeout, so that when the stream is not frames (a backend
// printed to stdout before it claimed the channel, or a wrapper wrote to it)
// the reason can quote the bytes that broke it.

import std.os
import std.io (fd_close)
import std.ipc
import std.list
import std.string
import std.json
import std.sandbox
import services.frames

exports (start, start_wslc, start_socket, start_socket_env, socket, alive, why, call, send_frame, set_max_frame, poll, kill, stop, excerpt, MAX_FRAME)

// The largest frame either side may send. A header announcing more is an
// error, and the channel is closed.
const MAX_FRAME = 1048576

// A frame that has begun must be whole within this; a backend that sends a
// header and stalls is cut off.
const FRAME_MS = 2000

// Grace between closing the channel and killing a backend that has not
// exited by itself.
const STOP_GRACE_S = 2

struct Backend {
    out: ptr         // a services/frames Writer on the child's stdin, or null once closed
    rd: int          // the child's stdout, read for frames, or -1 once closed
    pid: int         // the child's spawn token, or -1 once reaped
    why: string      // why it is no longer running, "" while it is
    frames: int      // frames read so far
    hint: string     // said after an exit status when it exits before its first frame
    sock: int        // 1: the channel is a socket, rd the same descriptor the writer writes
    max: int         // the largest frame it may send (MAX_FRAME unless set_max_frame said)
}

// Start `program` (a path the kernel has already resolved inside the app)
// with the arguments in `argv` (a std.list of strings, or null).
// (backend, "") or (null, why).
start(program: string, argv: ptr) -> (ptr, string) {
    args = argv
    own = 0
    if args == null {
        args = list.new()
        own = 1
    }
    h, err = spawn_(program, args, "")
    if own == 1 { list.free(args) }
    if err != "" { return null, "backend: could not start ${program}: ${err}" }
    return h, ""
}

// Start a Linux backend in a WSL container on Windows: `wslc run --rm -i
// --pull never <image> <command...>`, the container's stdin and stdout the
// channel. `command` is a std.list of strings (the program inside the image
// and its arguments; empty runs the image's own). The image must be there
// already: sae does not pull one at launch (wslc writes its pull progress to
// stderr, not into the channel, but a pull is a download the person did not
// ask for, and calls would time out behind it). (backend, "") or (null, why);
// anywhere but Windows, why.
start_wslc(image: string, command: ptr) -> (ptr, string) {
    if os.platform() != "windows" {
        return null, "backend: a wslc backend runs only on Windows (wslc is Windows 11's WSL container tool); this is ${os.platform()}"
    }
    args = list.new()
    list.add(args, "run")
    list.add(args, "--rm")
    list.add(args, "-i")
    list.add(args, "--pull")
    list.add(args, "never")
    list.add(args, image)
    if command != null {
        n = list.size(command)
        i = 0
        while i < n {
            cv, _ = list.get_string(command, i)
            list.add(args, cv)
            i = i + 1
        }
    }
    hint = "(if wslc said the image is not there: wslc pull ${image}, or build it)"
    h, err = spawn_("wslc", args, hint)
    if err != "" {
        // Not on this process's PATH (a shell that set its own, as MSYS2's
        // does, without %ProgramFiles% either): where WSL installs it.
        pf = os.getenv("ProgramFiles")
        if pf == null || pf == "" { pf = "C:\\Program Files" }
        h2, err2 = spawn_("${pf}\\WSL\\wslc.exe", args, hint)
        if err2 == "" {
            h = h2
            err = ""
        }
    }
    list.free(args)
    if err != "" { return null, "backend: could not start wslc (Windows 11's WSL container tool): ${err}" }
    return h, ""
}

spawn_(program: string, args: ptr, hint: string) -> (ptr, string) {
    wr, rd, pid, err = os.run_stdio(program, args, null)
    if err != "" { return null, err }
    return new_(wr, rd, pid, hint, 0), ""
}

new_(wr: int, rd: int, pid: int, hint: string, sock: int) -> ptr {
    b = heap.new(Backend)
    b.out = frames.writer(wr)
    b.rd = rd
    b.pid = pid
    b.why = ""
    b.frames = 0
    b.hint = hint
    b.sock = sock
    b.max = MAX_FRAME
    return b as ptr
}

// Start `program` on a socket pair, its fd 3 the channel. `grants` is a
// std.list of "kind value" strings (kind read, write or env; a read or
// write value an absolute path, a folder ending in "/"), the whole of what
// it may reach, or null to start it with no sandbox at all.
// (backend, "") or (null, why); where the child cannot be contained, why,
// and nothing was started.
start_socket(program: string, argv: ptr, grants: ptr) -> (ptr, string) {
    return start_socket_env(program, argv, grants, null)
}

// start_socket with the child's whole environment given: `env` a std.list
// of "NAME=value" strings (null: this process's), as sae's GPU helper
// (services/gfx) is started with only the display and driver variables it
// needs.
start_socket_env(program: string, argv: ptr, grants: ptr, env: ptr) -> (ptr, string) {
    if os.platform() == "windows" {
        return null, "backend: a socket backend does not run on Windows (std.ipc has no socket channel or descriptor passing there); app.json capabilities.backend.channel \"stdio\" does"
    }
    args = argv
    own = 0
    if args == null {
        args = list.new()
        own = 1
    }
    g = sandbox.new("sae backend") {}
    ch = 0 - 1
    pid = 0 - 1
    err = ""
    if grants == null {
        ch, pid, err = sandbox.spawn_socket_uncontained(g, program, args, env)
    } else {
        n = list.size(grants)
        i = 0
        while i < n {
            gv, _ge = list.get_string(grants, i)
            grant_(g, gv)
            i = i + 1
        }
        ch, pid, err = sandbox.spawn_socket(g, program, args, env)
    }
    if own == 1 { list.free(args) }
    // The child has its own copy of the grants (a sealed memfd), so ours goes.
    sandbox.free(g)
    if err != "" { return null, "backend: could not start ${program}: ${err}" }
    return new_(ch, ch, pid, "", 1), ""
}

// One "kind value" grant added to `g`. A folder ("/" at the end) is
// granted with what is under it.
grant_(g: sandbox.Grants, gv: string) {
    sp = string.string_index_of(gv, " ")
    if sp < 0 { return }
    kind = string.string_substring(gv, 0, sp)
    v = string.string_substring(gv, sp + 1, string.length(gv))
    if kind == "env" {
        sandbox.grant_env(g, v)
        return
    }
    paths = list.new()
    if string.string_ends_with(v, "/") == 1 && string.length(v) > 1 {
        list.add(paths, string.string_substring(v, 0, string.length(v) - 1))
        list.add(paths, "${v}*")
    } else {
        list.add(paths, v)
    }
    k = 0
    while k < list.size(paths) {
        pv, _pe = list.get_string(paths, k)
        if kind == "read" { sandbox.grant_fs_read(g, pv) }
        if kind == "write" {
            sandbox.grant_fs_read(g, pv)
            sandbox.grant_fs_write(g, pv)
        }
        k = k + 1
    }
    list.free(paths)
}

// 1 when its channel is a socket (a descriptor can cross it).
socket(h: ptr) -> int {
    if h == null { return 0 }
    b = h as *Backend
    return b.sock
}

// 1 while the channel is open.
alive(h: ptr) -> int {
    if h == null { return 0 }
    b = h as *Backend
    if b.rd < 0 { return 0 }
    return 1
}

// Why the backend is no longer running ("" while it is).
why(h: ptr) -> string {
    if h == null { return "backend: none" }
    b = h as *Backend
    return b.why
}

// Ask the backend to run `name` with `arg`, as request `id`, handing it the
// open descriptor `fd` with the call (-1 for none; a socket backend only).
// This takes `fd`: it is closed once sent, or here when it cannot be.
// "" or why not.
call(h: ptr, id: int, name: string, arg: string, fd: int) -> string {
    if alive(h) == 0 {
        if fd >= 0 { _c0 = fd_close(fd) }
        return why(h)
    }
    b = h as *Backend
    if fd >= 0 && b.sock == 0 {
        _c1 = fd_close(fd)
        return "backend: a document crosses only a socket channel (app.json capabilities.backend.channel \"socket\"); this backend's channel is its stdin and stdout, which carry bytes only"
    }
    o = json.obj()
    _i = json.set(o, "id", json.from_int(id))
    _c = json.set(o, "call", json.str(name))
    _a = json.set(o, "arg", json.str(arg))
    if fd >= 0 { _f = json.set(o, "fd", json.boolean(1)) }
    text, eerr = json.encode(o)
    json.json_free(o)
    if eerr != "" {
        if fd >= 0 { _c2 = fd_close(fd) }
        return "backend: ${eerr}"
    }
    if string.length(text) > MAX_FRAME {
        if fd >= 0 { _c3 = fd_close(fd) }
        return "backend: the request is larger than ${MAX_FRAME} bytes"
    }
    werr = frames.put_fd(b.out, text, fd)
    if werr != "" {
        written_lost_(b)
        return b.why
    }
    return ""
}

// One frame of any bytes to the child, as it is (a caller with a protocol of
// its own: services/gfx). The same writer, bound and reasons as call's.
send_frame(h: ptr, data: string) -> string {
    if alive(h) == 0 { return why(h) }
    b = h as *Backend
    if frames.put(b.out, data) != "" {
        written_lost_(b)
        return b.why
    }
    return ""
}

// The largest frame the child may send from now on (MAX_FRAME at start).
set_max_frame(h: ptr, n: int) {
    if h == null { return }
    b = h as *Backend
    b.max = n
}

// The writer has failed: the backend stopped reading its stdin (killed at
// once: it is not reading, so closing its stdin would not end it), or the
// write failed (it closed its end).
written_lost_(b: *Backend) {
    why = frames.pump(b.out)
    if frames.stalled(b.out) == 1 {
        lost_(b, "backend: it stopped reading its stdin: ${why}; it was killed", 1)
    } else {
        lost_(b, "backend: the channel failed: ${why}", 0)
    }
}

// The next frame the backend has sent, if one has begun: (frame, "") with
// the JSON text, ("", "") when none is waiting, ("", why) when the backend
// has gone (it closed the channel, or broke the protocol) and is stopped.
poll(h: ptr) -> (string, string) {
    if alive(h) == 0 { return "", why(h) }
    b = h as *Backend
    // The calls written meanwhile, and the deadline on them held. A write
    // that failed waits for the read side: a backend that exited is said to
    // have, from its end of stream, not to have stopped reading.
    wfail = 0
    if frames.pump(b.out) != "" {
        if frames.stalled(b.out) == 1 {
            written_lost_(b)
            return "", b.why
        }
        wfail = 1
    }
    ready, werr = ipc.wait_readable(b.rd, 0)
    if werr != "" {
        lost_(b, "backend: the channel failed: ${werr}", 0)
        return "", b.why
    }
    if ready == 0 {
        if wfail == 1 {
            written_lost_(b)
            return "", b.why
        }
        return "", ""
    }
    data, st, rerr = frames.read(b.rd, b.max, FRAME_MS, " (its stdout is the channel: nothing but frames may be written there)")
    if st == frames.EOF {
        lost_(b, "", 0)   // it closed its end: it has exited or is exiting
        return "", b.why
    }
    if st == frames.BROKE {
        lost_(b, "backend: ${rerr}", 0)
        return "", b.why
    }
    if st == frames.FAILED {
        lost_(b, "backend: the channel failed: ${rerr}", 0)
        return "", b.why
    }
    b.frames = b.frames + 1
    return data, ""
}

// `s` quoted for a reason (services/frames' excerpt).
excerpt(s: string) -> string {
    return frames.excerpt(s)
}

// Close the channel, give the backend STOP_GRACE_S to exit by itself, then
// kill it, and reap it. Safe to call twice.
stop(h: ptr) {
    if h == null { return }
    b = h as *Backend
    lost_(b, "backend: stopped", 0)
}

// Kill it now, with no grace, and reap it: `reason` is why. Safe after stop.
kill(h: ptr, reason: string) {
    if h == null { return }
    b = h as *Backend
    lost_(b, reason, 1)
}

// Close the channel and reap the child, killing it if it has not exited
// within STOP_GRACE_S, or at once with `kill_now` 1 (it stopped reading: a
// grace would only hold the window up). The first reason is kept; "" means
// the backend closed its end itself, and the reason is how it exited.
lost_(b: *Backend, reason: string, kill_now: int) {
    if b.out != null {
        frames.close_writer(b.out)
        b.out = null
    }
    if b.rd >= 0 {
        // A socket's one descriptor was the writer's, closed with it.
        if b.sock == 0 { _d = fd_close(b.rd) }
        b.rd = 0 - 1
    }
    how = ""
    if b.pid >= 0 && kill_now == 1 {
        _k0 = os.kill(b.pid, 9)
        _w0 = os.wait_pid(b.pid)
        b.pid = 0 - 1
    }
    if b.pid >= 0 {
        st, timed_out, _we = os.wait_pid_timeout(b.pid, STOP_GRACE_S)
        how = "it exited with status ${st}"
        if st != 0 && b.frames == 0 && b.hint != "" { how = "${how} ${b.hint}" }
        if timed_out == 1 {
            _k = os.kill(b.pid, 9)
            _w = os.wait_pid(b.pid)
            how = "it was killed: it had not exited ${STOP_GRACE_S} s after its channel closed"
        }
        b.pid = 0 - 1
    }
    if b.why == "" {
        if reason == "" { b.why = "backend: ${how}" } else { b.why = string.copy(reason) }
    }
}
