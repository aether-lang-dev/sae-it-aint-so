// services/clipboard — the one place sae touches the system clipboard on a
// page's behalf: the page API's `clipboard` object. See
// docs/page-services.md, section 8.
//
// The rules (agreed 2026-10-14), each checked here before the clipboard is
// touched:
//   - write: while the page handles a click or a key (the kernel says so),
//     or at any time for an app whose app.json grants clipboard "write";
//   - read: while the page handles the person's own paste (Ctrl or Cmd+V),
//     or at any time for an app whose app.json grants clipboard "read" and
//     whose page seeks clipboard-read. Reading is the sensitive half:
//     passwords pass through clipboards.
// A refusal is a message naming the rule; the caller (the page-API gate)
// throws it.
//
// What this module can reach is its imports: aether-ui's two clipboard calls
// and std.string. tests/check_layers.sh holds it to that, and holds those
// two calls to this module.

import ui (clipboard_read, clipboard_write)
import std.string

exports (new, configure, grant_write, grant_read, write_text, read_text)

const PASTE = 2   // the person's own paste

// One launch's clipboard grants: the kernel holds one (new()) and passes it
// to every call; nothing here is module state.
struct Clipboard {
    write_any: int   // app.json grants clipboard "write"
    read_any: int    // app.json grants clipboard "read"
}

// For a web page (no grants) or an app, before its grants are read.
new() -> ptr {
    c = heap.new(Clipboard)
    c.write_any = 0
    c.read_any = 0
    return c as ptr
}

// Back to no grants.
configure(h: ptr) {
    c = h as *Clipboard
    c.write_any = 0
    c.read_any = 0
}

grant_write(h: ptr) {
    c = h as *Clipboard
    c.write_any = 1
}

grant_read(h: ptr) {
    c = h as *Clipboard
    c.read_any = 1
}

// "" or why not. `gesture` is the kernel's: 0, CLICK or PASTE.
write_text(h: ptr, text: string, gesture: int) -> string {
    c = h as *Clipboard
    if gesture == 0 && c.write_any == 0 {
        return "clipboard.write_text: only while the page handles a click or a key"
    }
    clipboard_write(text)
    return ""
}

// (its text, "") or ("", why not). `sought_read` is 1 when the page seeks
// clipboard-read (and so may use an app's read grant).
read_text(h: ptr, gesture: int, sought_read: int) -> (string, string) {
    c = h as *Clipboard
    if gesture != PASTE && (c.read_any == 0 || sought_read == 0) {
        return "", "clipboard.read_text: only while the page handles the person's paste (Ctrl or Cmd+V)"
    }
    return clipboard_read(), ""
}
