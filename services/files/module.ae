// services/files — the one place sae touches the file system on a page's
// behalf (the page API's `fs` object, app mode). See docs/architecture.md.
//
// What this module can reach is its imports, and nothing else: std.fs and
// std.dir for the work, std.sandbox to fence it, std.string and std.strarr
// to hold grants. It cannot
// name the environment (std.os), the network, the UI or the engine; the
// kernel hands it what it needs (configure, grant_read, grant_write).
// tests/check_layers.sh holds the import list to that.
//
// Every operation takes the page's path as written, resolves it to where it
// leads (resolve), and checks the result against the app's grants before
// touching anything. A refusal is a message naming the call, the grant and
// the resolved path; the caller (the page-API gate) throws it. Then it acts
// inside std.sandbox's enforce, with the app's grants as the sandbox's
// (fence_), so a slip in these checks is still refused by Aether's own
// (aether/docs/containment-sandbox.md).

import std.fs
import std.dir
import std.string
import std.strarr
import std.sandbox
import std.encoding

exports (new, configure, grant_read, grant_write, granted, resolve, path,
         read_text, write_text, read_base64, write_base64, exists, list_json, mkdir, remove)

// One launch's file grants: the kernel holds one (new()), configures it for
// an app, and passes it to every call; nothing here is module state.
struct Files {
    enabled: int        // 0 in the browser: pages there get no fs
    app_data: string    // $APPDATA, and where relative paths go
    home: string
    temp: string
    windows: int        // 1: paths are C:/... (the kernel's form of C:\...)
    reads: ptr          // strarr: resolved directory prefixes ending in "/"
    writes: ptr         // ... that may also be changed
}

// Grants for a web page: none.
new() -> ptr {
    f = heap.new(Files)
    f.enabled = 0
    f.app_data = ""
    f.home = ""
    f.temp = ""
    f.windows = 0
    f.reads = null
    f.writes = null
    return f as ptr
}

// Set up for an app (enabled 1) or a web page (0), with the roots the
// $-prefixes expand to. The kernel reads them from the environment, with
// "/" separators. windows is 1 on Windows: an absolute path there starts
// with a drive (C:/), and a page's "\" is a separator, as Windows reads it.
configure(h: ptr, enabled: int, app_data: string, home: string, temp: string, windows: int) {
    f = h as *Files
    f.enabled = enabled
    f.windows = windows
    f.app_data = string.copy(app_data)
    f.home = string.copy(home)
    f.temp = string.copy(temp)
    f.reads = strarr.new()
    f.writes = strarr.new()
}

// A read grant: everything under `root` ($APPDATA/, $DOCUMENTS/notes/, ...).
// A root that cannot be resolved grants nothing.
grant_read(h: ptr, root: string) {
    f = h as *Files
    add_root_(h, f.reads, root)
}

// A write grant: create, overwrite, remove and mkdir under `root` (and read).
grant_write(h: ptr, root: string) {
    f = h as *Files
    add_root_(h, f.writes, root)
}

// 1 if the app has any fs grant at all (a page that seeks fs is refused at
// load without one).
granted(h: ptr) -> int {
    f = h as *Files
    if f.enabled == 0 { return 0 }
    n = 0
    if f.reads != null { n = n + strarr.size(f.reads) }
    if f.writes != null { n = n + strarr.size(f.writes) }
    if n > 0 { return 1 }
    return 0
}

add_root_(h: ptr, l: ptr, raw: string) {
    if l == null { return }
    r = resolve(h, raw)
    if r == "" { return }
    if string.string_ends_with(r, "/") == 0 { r = string.concat(r, "/") }
    strarr.push_copy(l, r)
}

// $APPDATA, $HOME, $DOCUMENTS, $DOWNLOADS, $DESKTOP, $TEMP at the front of a
// path, expanded.
expand_(h: ptr, s: string) -> string {
    f = h as *Files
    if string.string_starts_with(s, "$APPDATA") == 1 {
        _m = fs.mkdir_p(f.app_data)
        return string.concat(f.app_data, string.string_substring(s, 8, string.length(s)))
    }
    if string.string_starts_with(s, "$HOME") == 1 { return string.concat(f.home, string.string_substring(s, 5, string.length(s))) }
    if string.string_starts_with(s, "$DOCUMENTS") == 1 { return string.concat("${f.home}/Documents", string.string_substring(s, 10, string.length(s))) }
    if string.string_starts_with(s, "$DOWNLOADS") == 1 { return string.concat("${f.home}/Downloads", string.string_substring(s, 10, string.length(s))) }
    if string.string_starts_with(s, "$DESKTOP") == 1 { return string.concat("${f.home}/Desktop", string.string_substring(s, 8, string.length(s))) }
    if string.string_starts_with(s, "$TEMP") == 1 { return string.concat(f.temp, string.string_substring(s, 5, string.length(s))) }
    return s
}

// A path made absolute (relative ones are in $APPDATA) and resolved to where
// it leads, so a prefix check means what it says. It is walked a component
// at a time, as the kernel walks it: "." is dropped, ".." goes to the parent
// of what is resolved so far (which has no symlinks left in it), and a
// symlink is followed to where it points. A component that does not exist
// yet is kept as written, and a ".." after it removes it again. Taking ".."
// out as text first would be wrong: with link -> /elsewhere/dir,
// "$APPDATA/link/../x" is /elsewhere/x. A path that cannot be resolved (a
// dangling symlink, a loop) gives "", which no grant covers. Aether's
// std.sandbox resolves paths the same way (runtime/aether_sandbox_path.h).
//
// On Windows the walk is the same below the drive: "C:/x/../y" is C:/y, a
// ".." at the drive's root stays there, and a path with no drive ("/x",
// "//server/share") gives "", as no grant names one.
resolve(h: ptr, raw: string) -> string {
    f = h as *Files
    p = expand_(h, raw)
    drive = ""
    if f.windows == 1 {
        p = string.string_replace_all(p, "\\", "/")
        if drive_of_(p) == "" {
            if string.string_starts_with(p, "/") == 1 { return "" }
            p = "${f.app_data}/${p}"
        }
        drive = drive_of_(p)
        if drive == "" { return "" }
        p = string.string_substring(p, 2, string.length(p))
    } else if string.string_starts_with(p, "/") == 0 {
        p = "${f.app_data}/${p}"
    }
    res = ""
    n = string.length(p)
    i = 0
    while i <= n {
        j = i
        while j < n && string.char_at(p, j) != 47 { j = j + 1 }
        seg = string.string_substring(p, i, j)
        if seg == ".." {
            k = string.length(res) - 1
            while k > 0 && string.char_at(res, k) != 47 { k = k - 1 }
            if k < 0 { k = 0 }
            res = string.string_substring(res, 0, k)
        } else if seg != "" && seg != "." {
            res = "${res}/${seg}"
            if fs.fs_is_symlink("${drive}${res}") == 1 {
                rp, _k, err = fs.realpath("${drive}${res}")
                if err != "" { return "" }
                res = string.copy(rp)
                if f.windows == 1 {
                    res = string.string_replace_all(res, "\\", "/")
                    if string.string_starts_with(res, "//?/") == 1 { res = string.string_substring(res, 4, string.length(res)) }
                    drive = drive_of_(res)
                    if drive == "" { return "" }
                    res = string.string_substring(res, 2, string.length(res))
                }
                if res == "/" { res = "" }
            }
        }
        i = j + 1
    }
    if res == "" { return "${drive}/" }
    return "${drive}${res}"
}

// 1 for a Windows path that is absolute but names no drive ("/etc/hosts",
// \\server\share), which resolve refuses.
driveless_(h: ptr, raw: string) -> int {
    p = string.string_replace_all(expand_(h, raw), "\\", "/")
    if drive_of_(p) == "" && string.string_starts_with(p, "/") == 1 { return 1 }
    return 0
}

// "C:" for a path that starts with a drive ("C:/..." or just "C:"), the
// letter upper-cased so one folder has one spelling; "" otherwise.
drive_of_(p: string) -> string {
    if string.length(p) < 2 || string.char_at(p, 1) != 58 { return "" }
    if string.length(p) > 2 && string.char_at(p, 2) != 47 { return "" }
    c = string.char_at(p, 0)
    if c >= 97 && c <= 122 { c = c - 32 }
    if c < 65 || c > 90 { return "" }
    return string.concat(string.string_substring("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c - 65, c - 64), ":")
}

prefix_in_(l: ptr, s: string) -> int {
    if l == null { return 0 }
    n = strarr.size(l)
    i = 0
    while i < n {
        if string.string_starts_with(s, strarr.get(l, i)) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

within_(l: ptr, p: string) -> int {
    if prefix_in_(l, p) == 1 { return 1 }
    // A grant root itself ("/x/" grants "/x").
    return prefix_in_(l, string.concat(p, "/"))
}

// The resolved path a call may use, or why not: (path, "") or ("", reason).
// write is 1 for a change. `what` names the page's call in the reason.
path(h: ptr, raw: string, write: int, what: string) -> (string, string) {
    f = h as *Files
    if f.enabled == 0 { return "", "${what}: fs is not available to a web page" }
    p = resolve(h, raw)
    if p == "" && f.windows == 1 && driveless_(h, raw) == 1 {
        kind = "read"
        if write == 1 { kind = "write" }
        return "", "${what}: outside this app's fs.${kind} grant: ${raw} (no drive)"
    }
    if p == "" { return "", "${what}: cannot resolve ${raw} (a dangling symlink, or a loop)" }
    if write == 1 {
        if within_(f.writes, p) == 1 { return p, "" }
        return "", "${what}: outside this app's fs.write grant: ${p}"
    }
    if within_(f.reads, p) == 1 || within_(f.writes, p) == 1 { return p, "" }
    return "", "${what}: outside this app's fs.read grant: ${p}"
}

// The app's grants as a std.sandbox grant list: read roots readable, write
// roots readable, writable and made and removed in. Release with
// sandbox.free.
fence_(h: ptr) -> sandbox.Grants {
    f = h as *Files
    reads = f.reads
    writes = f.writes
    return sandbox.new("fs: this app's app.json grants") {
        i = 0
        while i < strarr.size(reads) {
            grant_fs_read("${strarr.get(reads, i)}*")
            i = i + 1
        }
        j = 0
        while j < strarr.size(writes) {
            grant_fs("${strarr.get(writes, j)}*")
            j = j + 1
        }
    }
}

// The operations: each checks first, then acts, fenced. (text, "") or ("", error).

read_text(h: ptr, raw: string) -> (string, string) {
    p, why = path(h, raw, 0, "fs.read_text")
    if why != "" { return "", why }
    t = ""
    err = ""
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        t, err = fs.read(p)
    }
    sandbox.free(perms)
    if err != "" { return "", "fs.read_text: ${err}" }
    return t, ""
}

write_text(h: ptr, raw: string, text: string) -> string {
    err = ""
    p, why = path(h, raw, 1, "fs.write_text")
    if why != "" { return why }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        err = fs.write_atomic(p, string.bytes(text))
    }
    sandbox.free(perms)
    if err != "" { return "fs.write_text: ${err}" }
    return ""
}

// A binary file's bytes as base64 (padded): (its base64, "") or ("", why).
read_base64(h: ptr, raw: string) -> (string, string) {
    data = ""
    n = 0
    err = ""
    p, why = path(h, raw, 0, "fs.read_base64")
    if why != "" { return "", why }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        data, n, err = fs.read_binary(p)
    }
    sandbox.free(perms)
    if err != "" { return "", "fs.read_base64: ${err}" }
    if n == 0 { return "", "" }
    return encoding.base64_encode_padded(string.bytes(data)), ""
}

// Bytes given as base64 written atomically: "" or why.
write_base64(h: ptr, raw: string, b64: string) -> string {
    err = ""
    p, why = path(h, raw, 1, "fs.write_base64")
    if why != "" { return why }
    bytes, derr = encoding.base64_decode(b64)
    if derr != "" { return "fs.write_base64: not base64" }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        err = fs.write_atomic(p, string.bytes(bytes))
    }
    sandbox.free(perms)
    if err != "" { return "fs.write_base64: ${err}" }
    return ""
}

// (1 or 0, "") or (0, reason).
exists(h: ptr, raw: string) -> (int, string) {
    yes = 0
    p, why = path(h, raw, 0, "fs.exists")
    if why != "" { return 0, why }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        yes = fs.exists(p)
    }
    sandbox.free(perms)
    return yes, ""
}

// The names in a directory, as a JSON array of strings.
list_json(h: ptr, raw: string) -> (string, string) {
    l = null
    lerr = ""
    p, why = path(h, raw, 0, "fs.list")
    if why != "" { return "", why }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        l, lerr = dir.list(p)
    }
    sandbox.free(perms)
    if lerr != "" { return "", "fs.list: ${lerr}" }
    out = "["
    n = dir.list_count(l)
    i = 0
    while i < n {
        if i > 0 { out = string.concat(out, ",") }
        out = string.concat(out, quote_(dir.list_get(l, i)))
        i = i + 1
    }
    return string.concat(out, "]"), ""
}

mkdir(h: ptr, raw: string) -> string {
    made = 0
    p, why = path(h, raw, 1, "fs.mkdir")
    if why != "" { return why }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        _m = fs.mkdir_p(p)
        made = fs.exists(p)
    }
    sandbox.free(perms)
    if made == 0 { return "fs.mkdir: could not create ${p}" }
    return ""
}

remove(h: ptr, raw: string) -> string {
    e = ""
    p, why = path(h, raw, 1, "fs.remove")
    if why != "" { return why }
    perms = fence_(h)
    sandbox.enforce(perms) callback {
        kind, _sz, _mt, serr = fs.file_stat(p)
        if serr != "" {
            e = "no such file: ${p}"
        } else if kind == 2 {
            e = fs.delete_dir(p)
        } else {
            e = fs.delete(p)
        }
    }
    sandbox.free(perms)
    if e != "" { return "fs.remove: ${e}" }
    return ""
}

quote_(s: string) -> string {
    out = "\""
    i = 0
    while i < string.length(s) {
        c = string.char_at(s, i)
        if c == 34 { out = string.concat(out, "\\\"") }
        else if c == 92 { out = string.concat(out, "\\\\") }
        else if c < 32 { out = string.concat(out, " ") }
        else { out = string.concat(out, string.from_char(c)) }
        i = i + 1
    }
    return string.concat(out, "\"")
}
