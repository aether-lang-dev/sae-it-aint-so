// services/sqlite — an app's databases (app.json capabilities.sqlite), and
// the one place sae touches the SQLite engine. See docs/architecture.md and
// docs/page-services.md section 6.
//
// The kernel opens each database the app declares (at a path it chooses:
// the app's private data folder, keyed per installed app), applies the
// app's migrations, and hands the connection to one actor per database.
// Pages see a name (`sqlite.fred`) and three calls, all/get/run, with
// values always passed as `?` (or `$name`) parameters, never spliced into
// the SQL. This module runs the statements: it binds parameters from the
// page's JSON, steps, and materialises the rows as JSON for the kernel to
// hand back on the UI thread.
//
// What it can reach is its imports: the engine (contrib.sqlite, which
// tests/check_layers.sh lets no other module import), std.json for the
// page's values and the rows, std.string and std.strarr. It cannot name the
// file system, the environment or the network; the kernel gives it a path
// and the migration texts.
//
// Escape routes switched off. SQLite can reach beyond its own file: ATTACH
// DATABASE '/any/path', DETACH, load_extension(), VACUUM INTO '/path', and
// PRAGMAs that name a directory. Every connection this module opens is held
// to one file three ways, all in the engine, not by reading the SQL:
//
//   - the authorizer (sqlite.set_authorizer): a callback the engine asks before compiling
//     each operation; it denies SQLITE_ATTACH, SQLITE_DETACH (so VACUUM
//     too: VACUUM INTO attaches its target, and a plain VACUUM a temporary
//     file, so neither runs in version 1), the load_extension function, and
//     the directory PRAGMAs (temp_store_directory, data_store_directory).
//   - SQLITE_LIMIT_ATTACHED set to 0 (sqlite.limit), so an ATTACH could
//     not succeed even if the authorizer were not consulted.
//   - extension loading off (sqlite.enable_load_extension(db, 0)), so no
//     code is loaded from a file.
//
// All three, and the column names, types, doubles, 64-bit binds,
// last_insert_rowid and named parameters, are contrib.sqlite's own since
// Aether 0.801.0 (asks/sqlite-authorizer.md, resolved); this module declares
// no extern and no SQLite number of its own. An Aether function cast
// `as fn(...)` is the C function pointer the authorizer takes, so no C is
// needed here.

import contrib.sqlite as engine
import std.json
import std.string
import std.strarr

exports (open, close, migrate, execute, applied, KIND_ALL, KIND_GET, KIND_RUN, KIND_EXEC, MIGRATIONS_TABLE)

// What a job asks for.
const KIND_ALL = 1    // every row, as an array of objects
const KIND_GET = 2    // the first row as an object, or null
const KIND_RUN = 3    // no rows: { changes, lastId }
const KIND_EXEC = 4   // the kernel's own statement (BEGIN, COMMIT, ROLLBACK)

const MIGRATIONS_TABLE = "_sae_migrations"

// Open the database file at `path` with every escape route off. Returns
// (db, "") or (null, why).
open(path: string) -> (ptr, string) {
    db, err = engine.open(path)
    if err != "" { return null, "${err}: ${path}" }
    _l = engine.limit(db, engine.SQLITE_LIMIT_ATTACHED, 0)
    xerr = engine.enable_load_extension(db, 0)
    if xerr != "" {
        _c0 = engine.close(db)
        return null, "could not switch extension loading off (${xerr}): ${path}"
    }
    aerr = engine.set_authorizer(db, authorize_ as fn(ptr, int, string, string, string, string) -> int, null)
    if aerr != "" {
        _c = engine.close(db)
        return null, "could not install the authorizer (${aerr}): ${path}"
    }
    ferr = engine.exec(db, "PRAGMA foreign_keys = ON")
    if ferr != "" {
        _c2 = engine.close(db)
        return null, "${ferr}: ${path}"
    }
    return db, ""
}

close(db: ptr) -> string {
    if db == null { return "" }
    return engine.close(db)
}

// The engine asks this before compiling each operation (on whichever
// thread runs the statement; it touches nothing shared). Deny what reaches
// past the database's own file; everything else is the app's business.
authorize_(ud: ptr, action: int, a1: string, a2: string, a3: string, a4: string) -> int {
    if action == engine.SQLITE_ATTACH || action == engine.SQLITE_DETACH { return engine.SQLITE_DENY }
    if action == engine.SQLITE_FUNCTION && string.string_length(a2) > 0 {
        if string.to_lower(a2) == "load_extension" { return engine.SQLITE_DENY }
    }
    if action == engine.SQLITE_PRAGMA && string.string_length(a1) > 0 {
        nm = string.to_lower(a1)
        if nm == "temp_store_directory" || nm == "data_store_directory" { return engine.SQLITE_DENY }
    }
    return engine.SQLITE_OK
}

// SQLite's "not authorized" is the authorizer's; say what sae switched off.
plain_error_(err: string) -> string {
    if string.string_starts_with(err, "not authorized") == 1 || err == "authorization denied" {
        return "not available to an app: a database is one file (ATTACH, DETACH, load_extension, VACUUM and PRAGMAs naming a directory are switched off)"
    }
    return err
}

// Apply one migration script if the database has not seen it: `name` is
// how it is recorded (its path in app.json), `sql` the script, which may
// hold several statements. Returns (1, "") when applied, (0, "") when it
// had been already, (0, why) when it failed, in which case nothing of it
// is kept (the script runs in a transaction).
migrate(db: ptr, name: string, sql: string) -> (int, string) {
    cerr = engine.exec(db, "CREATE TABLE IF NOT EXISTS ${MIGRATIONS_TABLE} (name TEXT PRIMARY KEY, applied_at TEXT NOT NULL DEFAULT (datetime('now')))")
    if cerr != "" { return 0, plain_error_(cerr) }
    seen, serr = applied(db, name)
    if serr != "" { return 0, serr }
    if seen == 1 { return 0, "" }
    berr = engine.exec(db, "BEGIN")
    if berr != "" { return 0, plain_error_(berr) }
    err = engine.exec(db, sql)
    if err == "" {
        st, perr = engine.prepare(db, "INSERT INTO ${MIGRATIONS_TABLE} (name) VALUES (?)")
        err = perr
        if st != null {
            _b = engine.bind_text(st, 1, name)
            rc, serr2 = engine.step(st, db)
            if serr2 != "" { err = serr2 }
            if rc != engine.SQLITE_DONE && err == "" { err = "could not record the migration" }
            _f = engine.finalize(st)
        }
    }
    if err != "" {
        _r = engine.exec(db, "ROLLBACK")
        return 0, plain_error_(err)
    }
    cerr2 = engine.exec(db, "COMMIT")
    if cerr2 != "" {
        _r2 = engine.exec(db, "ROLLBACK")
        return 0, plain_error_(cerr2)
    }
    return 1, ""
}

// (1, "") if the migration `name` is recorded as applied, (0, "") if not.
applied(db: ptr, name: string) -> (int, string) {
    st, perr = engine.prepare(db, "SELECT 1 FROM ${MIGRATIONS_TABLE} WHERE name = ?")
    if st == null { return 0, plain_error_(perr) }
    _b = engine.bind_text(st, 1, name)
    rc, err = engine.step(st, db)
    _f = engine.finalize(st)
    if err != "" { return 0, plain_error_(err) }
    if rc == engine.SQLITE_ROW { return 1, "" }
    return 0, ""
}

// Run one statement for a page. `params_json` is the page's parameters as
// JSON: an array for `?` placeholders, an object for `$name` ones, or "".
// Returns (result_json, "") or ("", why). The result is what the kind
// asks for: KIND_ALL an array of row objects, KIND_GET the first row or
// null, KIND_RUN { changes, lastId }, KIND_EXEC null.
execute(db: ptr, kind: int, sql: string, params_json: string) -> (string, string) {
    if db == null { return "", "no database" }
    if kind == KIND_EXEC {
        err = engine.exec(db, sql)
        if err != "" { return "", plain_error_(err) }
        return "null", ""
    }
    st, perr = engine.prepare(db, sql)
    if st == null { return "", plain_error_(perr) }
    berr = bind_all_(st, params_json)
    if berr != "" {
        _f0 = engine.finalize(st)
        return "", berr
    }
    out = ""
    err = ""
    if kind == KIND_RUN {
        rc, serr = engine.step(st, db)
        err = serr
        if err == "" && rc != engine.SQLITE_DONE && rc != engine.SQLITE_ROW { err = "step failed (${rc})" }
        if err == "" {
            long last = engine.last_insert_rowid(db)
            out = "{\"changes\":${engine.changes(db)},\"lastId\":${last}}"
        }
    } else {
        rows = json.arr()
        ncol = engine.column_count(st)
        names = strarr.new()
        c = 0
        while c < ncol {
            strarr.push_copy(names, engine.column_name(st, c))
            c = c + 1
        }
        n = 0
        while true {
            rc, serr = engine.step(st, db)
            if serr != "" {
                err = serr
                break
            }
            if rc != engine.SQLITE_ROW { break }
            _p = json.push(rows, row_(st, ncol, names))
            n = n + 1
            if kind == KIND_GET { break }
        }
        strarr.free(names)
        if err == "" {
            if kind == KIND_GET {
                if n == 0 {
                    out = "null"
                } else {
                    first, _ferr = json.array_get(rows, 0)
                    enc, _eerr = json.encode(first)
                    out = enc
                }
            } else {
                enc2, _eerr2 = json.encode(rows)
                out = enc2
            }
        }
        json.json_free(rows)
    }
    _f = engine.finalize(st)
    if err != "" { return "", plain_error_(err) }
    return out, ""
}

// One row of the statement as a JSON object: INTEGER as an integer, FLOAT
// as a number, TEXT as a string, NULL as null; a BLOB as its text (binary
// columns are not in version 1).
row_(st: ptr, ncol: int, names: ptr) -> ptr {
    o = json.obj()
    c = 0
    while c < ncol {
        t = engine.column_type(st, c)
        v = json.null_value()
        if t == engine.SQLITE_INTEGER {
            long iv = engine.column_int64(st, c)
            v = json.from_int(iv)
        }
        if t == engine.SQLITE_FLOAT { v = json.num(engine.column_double(st, c)) }
        if t == engine.SQLITE_TEXT || t == engine.SQLITE_BLOB { v = json.str(engine.column_text(st, c)) }
        _s = json.set(o, strarr.get(names, c), v)
        c = c + 1
    }
    return o
}

// Bind the page's parameters: an array to `?` slots by position (as many
// as the statement has), an object to `$name` (or :name, @name) slots by
// name. A value is a number, string, boolean or null; nothing else.
bind_all_(st: ptr, params_json: string) -> string {
    want = engine.bind_parameter_count(st)
    if params_json == "" || params_json == "null" || params_json == "undefined" {
        if want > 0 { return "the statement has ${want} parameter(s) and none were given" }
        return ""
    }
    pv, perr = json.parse(params_json)
    if perr != "" { return "parameters: ${perr}" }
    err = ""
    t = json.json_type(pv)
    if t == 4 {
        n = json.json_array_size(pv)
        if n != want {
            err = "the statement has ${want} parameter(s), ${n} given"
        } else {
            i = 0
            while i < n && err == "" {
                err = bind_one_(st, i + 1, json.json_array_get_raw(pv, i), "?${i + 1}")
                i = i + 1
            }
        }
    } else if t == 5 {
        n = json.json_object_size_raw(pv)
        i = 0
        while i < n && err == "" {
            key = json.json_object_key_at(pv, i)
            idx = engine.bind_parameter_index(st, "$${key}")
            if idx == 0 { idx = engine.bind_parameter_index(st, ":${key}") }
            if idx == 0 { idx = engine.bind_parameter_index(st, "@${key}") }
            if idx == 0 {
                err = "the statement has no parameter named $${key}"
            } else {
                err = bind_one_(st, idx, json.json_object_value_at(pv, i), "$${key}")
            }
            i = i + 1
        }
        if err == "" && n != want { err = "the statement has ${want} parameter(s), ${n} given" }
    } else {
        err = "parameters must be an array (for ?) or an object (for \$name)"
    }
    json.json_free(pv)
    return err
}

bind_one_(st: ptr, idx: int, v: ptr, shown: string) -> string {
    t = json.json_type(v)
    if t == 4 || t == 5 { return "parameter ${shown}: a value is a number, string, boolean or null, not an array or object" }
    err = ""
    if t == 0 { err = engine.bind_null(st, idx) }
    if t == 1 { err = engine.bind_int(st, idx, json.json_get_bool(v)) }
    if t == 2 {
        if json.json_is_integer(v) == 1 {
            long lv = json.json_get_long(v)
            err = engine.bind_int64(st, idx, lv)
        } else {
            err = engine.bind_double(st, idx, json.json_get_number(v))
        }
    }
    if t == 3 {
        s, _serr = json.get_string(v)
        err = engine.bind_text(st, idx, s)
    }
    if err != "" { return "parameter ${shown}: ${err}" }
    return ""
}
