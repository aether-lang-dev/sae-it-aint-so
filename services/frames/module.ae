// services/frames — std.ipc's frames (a 4-byte big-endian length, then the
// bytes) over a pipe, for the two channels sae holds: an app's backend
// (services/backend, sae the parent) and the control channel
// (services/channel, sae the child). Nothing here is shared between
// channels: read takes the descriptor it reads, and each Writer is an
// instance of its own.
//
// read() takes a frame whose first byte has arrived (the caller asked
// ipc.wait_readable with a wait of 0 first), and bounds the rest of it by
// `frame_ms`. It reads the bytes itself, rather than with
// ipc.read_frame_timeout, so that when the stream is not frames (a program
// printed to the channel, or a wrapper wrote to it) the reason can quote the
// bytes that broke it.
//
// A Writer sends frames without the UI thread ever waiting for the peer to
// read them. A write to a pipe blocks once the pipe is full (64 KB or so),
// and a peer that has stopped reading never empties it; Aether 0.908.0's
// std.ipc has no way to ask whether a pipe will take more, nor a write that
// does not wait (asks/aether-ipc-wait-writable.md). So the frames go to a
// thread of their own (std.worker's run_detached, one a batch): put() queues
// a frame and returns at once, and pump(), from the owner's UI tick, hands the
// queue to a new thread when the last batch is done. A frame not taken within
// WRITE_MS is the peer's fault: pump() says so, and the owner drops the
// channel. The thread may still be waiting in write() then; it owns the
// descriptor from that moment and closes it when write() returns (the peer
// reads, exits or is killed), so no descriptor is closed under it.

import std.ipc
import std.io (fd_close)
import std.list
import std.string
import std.sync
import std.time (now_ms)
import std.worker

exports (read, excerpt, writer, put, pump, stalled, close_writer, OK, EOF, BROKE, FAILED, WRITE_MS)

// read's outcomes.
const OK = 0       // (data, OK, "")
const EOF = 1      // the stream ended before a frame began: the other end closed it
const BROKE = 2    // not frames: why is "it broke the protocol: ..."
const FAILED = 3   // the descriptor failed: why is std.ipc's reason

// How much of a stream that broke the protocol a reason quotes.
const EXCERPT_BYTES = 48

// One frame from `fd`, at most `max` bytes, its first byte already there:
// (data, OK, ""), ("", EOF, ""), ("", BROKE, why) or ("", FAILED, why).
// `note` follows the excerpt when what came is not a frame header at all
// (" (its stdout is the channel: ...)"), saying where the bytes went wrong.
read(fd: int, max: int, frame_ms: int, note: string) -> (string, int, string) {
    start = now_ms()
    head = ""
    while string.length(head) < 4 {
        chunk, st = some_(fd, 4 - string.length(head), start, frame_ms)
        if st == 1 {
            if string.length(head) == 0 { return "", EOF, "" }
            return "", BROKE, "it broke the protocol: the stream ended inside a frame's header, after ${excerpt(head)}"
        }
        if st == 2 {
            return "", BROKE, "it broke the protocol: ${excerpt(head)} and then nothing for ${frame_ms} ms, which is not a frame"
        }
        if st == 3 { return "", FAILED, chunk }
        head = string.concat(head, chunk)
    }
    n = byte_(head, 0) * 16777216 + byte_(head, 1) * 65536 + byte_(head, 2) * 256 + byte_(head, 3)
    if n > max {
        // Not a header: quote what came, with whatever follows at once.
        more = ""
        r, _we = ipc.wait_readable(fd, 50)
        if r == 1 {
            m, _re = ipc.read(fd, EXCERPT_BYTES)
            more = m
        }
        return "", BROKE, "it broke the protocol: ${excerpt(string.concat(head, more))} is not a frame${note}"
    }
    data = ""
    while string.length(data) < n {
        chunk, st = some_(fd, n - string.length(data), start, frame_ms)
        if st == 1 {
            return "", BROKE, "it broke the protocol: the stream ended inside a frame of ${n} bytes, after ${excerpt(data)}"
        }
        if st == 2 {
            return "", BROKE, "it broke the protocol: a frame of ${n} bytes not whole within ${frame_ms} ms, after ${excerpt(data)}"
        }
        if st == 3 { return "", FAILED, chunk }
        data = string.concat(data, chunk)
    }
    return data, OK, ""
}

// Up to `want` bytes, within frame_ms of `start`: (bytes, 0), ("", 1) at
// end of stream, ("", 2) at the deadline, (why, 3) when the descriptor failed.
some_(fd: int, want: int, start: long, frame_ms: int) -> (string, int) {
    left = frame_ms - ((now_ms() - start) as int)
    if left < 0 { left = 0 }
    ready, werr = ipc.wait_readable(fd, left)
    if werr != "" { return werr, 3 }
    if ready == 0 { return "", 2 }
    chunk, rerr = ipc.read(fd, want)
    if rerr != "" { return rerr, 3 }
    if string.length(chunk) == 0 { return "", 1 }
    return chunk, 0
}

byte_(s: string, i: int) -> int {
    c = string.string_char_at(s, i)
    if c < 0 { c = c + 256 }
    return c
}

// `s` quoted for a reason: at most EXCERPT_BYTES bytes, printable ASCII as
// it is, \n \r \t \" \\ as such and any other byte as \xHH, then "..." if
// there was more.
excerpt(s: string) -> string {
    hex = "0123456789abcdef"
    out = "\""
    n = string.length(s)
    i = 0
    while i < n && i < EXCERPT_BYTES {
        c = byte_(s, i)
        if c == 10 {
            out = string.concat(out, "\\n")
        } else if c == 13 {
            out = string.concat(out, "\\r")
        } else if c == 9 {
            out = string.concat(out, "\\t")
        } else if c == 34 {
            out = string.concat(out, "\\\"")
        } else if c == 92 {
            out = string.concat(out, "\\\\")
        } else if c >= 32 && c < 127 {
            out = string.concat(out, string.string_from_char(c))
        } else {
            hi = string.string_substring(hex, c / 16, c / 16 + 1)
            lo = string.string_substring(hex, c % 16, c % 16 + 1)
            out = string.concat(out, "\\x${hi}${lo}")
        }
        i = i + 1
    }
    out = string.concat(out, "\"")
    if n > EXCERPT_BYTES { out = string.concat(out, "...") }
    return out
}

// --- writing ---

// A frame handed to the peer must be taken whole within this, or the peer
// has stopped reading.
const WRITE_MS = 5000

// Bytes queued and not yet handed to the thread past which the peer is not
// keeping up, however recently it took a frame.
const MOST_QUEUED = 16777216

// A Writer's thread state (its `state` cell).
const IDLE = 0        // no thread: the UI thread may touch batch and err
const WRITING = 1     // a thread is writing the batch
const ABANDONED = 2   // a thread is writing, and the owner has closed the writer: the thread closes fd
const CLOSED = 3      // fd closed

struct Writer {
    fd: int          // the descriptor written; the thread's alone once ABANDONED
    queue: ptr       // std.list of frames not yet handed to a thread (UI thread only)
    queued: int      // their bytes
    batch: ptr       // std.list of the frames the thread is writing, or null
    batched: int     // their bytes
    state: ptr       // std.sync cell: IDLE, WRITING, ABANDONED or CLOSED
    taken: ptr       // std.sync cell: frames of the batch written so far
    err: string      // the thread's failure, read once IDLE
    seen: long       // taken, as pump last saw it
    since: long      // when pump last saw it move, or the batch began
    why: string      // why the writer failed, "" while it has not
    stall: int       // 1 when why is the peer not reading
}

// A writer for `fd`: frames put with put() go out in order on a thread of
// their own. close_writer() closes fd (or has the thread close it).
writer(fd: int) -> ptr {
    w = heap.new(Writer)
    w.fd = fd
    w.queue = list.new()
    w.queued = 0
    w.batch = null
    w.batched = 0
    w.state = sync.atomic_new(IDLE)
    w.taken = sync.atomic_new(0)
    w.err = ""
    w.seen = 0
    w.since = 0
    w.why = ""
    w.stall = 0
    return w as ptr
}

// Queue `data` as one frame and start it on its way: "" or why the writer
// has failed (pump's reasons).
put(h: ptr, data: string) -> string {
    w = h as *Writer
    if w.why != "" { return w.why }
    if sync.atomic_load(w.state) >= ABANDONED { return "closed" }
    if w.queued + string.length(data) > MOST_QUEUED {
        fail_(w, "more than ${MOST_QUEUED / 1048576} MB waiting to be taken", 1)
        return w.why
    }
    list.add(w.queue, data)
    w.queued = w.queued + string.length(data)
    return pump(h)
}

// Called from the owner's UI tick: the last batch's outcome taken, the next
// begun, and the deadline held. "" while all is well, or why the writer has
// failed: the peer not taking a frame within WRITE_MS (stalled() is 1), or
// the write's own error (the peer closed its end, say). Never waits.
pump(h: ptr) -> string {
    w = h as *Writer
    if w.why != "" { return w.why }
    st = sync.atomic_load(w.state)
    if st == WRITING {
        t = sync.atomic_load(w.taken)
        now = now_ms()
        if t != w.seen {
            w.seen = t
            w.since = now
            return ""
        }
        if now - w.since > WRITE_MS {
            left = w.queued + w.batched
            fail_(w, "a frame waited ${WRITE_MS / 1000} s and was not taken (${left} bytes waiting)", 1)
        }
        return w.why
    }
    if st != IDLE { return "closed" }
    if w.batch != null {
        if w.err != "" {
            fail_(w, w.err, 0)
            return w.why
        }
        list.free(w.batch)
        w.batch = null
        w.batched = 0
    }
    if list.size(w.queue) > 0 { start_(w) }
    return w.why
}

// 1 when the writer failed because the peer stopped reading.
stalled(h: ptr) -> int {
    w = h as *Writer
    return w.stall
}

fail_(w: *Writer, why: string, stall: int) {
    if w.why != "" { return }
    w.why = string.copy(why)
    w.stall = stall
}

// The queue handed to a new thread.
start_(w: *Writer) {
    w.batch = w.queue
    w.batched = w.queued
    w.queue = list.new()
    w.queued = 0
    w.err = ""
    sync.atomic_store(w.taken, 0)
    w.seen = 0
    w.since = now_ms()
    sync.atomic_store(w.state, WRITING)
    wp = w as ptr
    ok = worker.run_detached(|| {
        write_batch_(wp)
        return wp
    })
    if ok == false {
        sync.atomic_store(w.state, IDLE)
        fail_(w, "no thread to write with", 0)
    }
}

// On the writer's thread: the batch, in order. The UI thread touches
// neither the batch nor err until the state is IDLE again; if the owner
// closed the writer meanwhile (ABANDONED), the descriptor is this thread's
// to close.
write_batch_(h: ptr) {
    w = h as *Writer
    n = list.size(w.batch)
    i = 0
    err = ""
    while i < n {
        s, _ge = list.get_string(w.batch, i)
        e = ipc.write_frame(w.fd, s)
        if e != "" {
            err = e
            break
        }
        _t = sync.atomic_add(w.taken, 1)
        i = i + 1
    }
    if err != "" { w.err = string.copy(err) }
    if sync.atomic_cas(w.state, WRITING, IDLE) == 0 {
        _c = fd_close(w.fd)
        sync.atomic_store(w.state, CLOSED)
    }
}

// Close the writer: frames not yet written are dropped. The descriptor is
// closed now, or by the thread still writing when its write returns. Safe
// to call twice.
close_writer(h: ptr) {
    if h == null { return }
    w = h as *Writer
    if sync.atomic_cas(w.state, WRITING, ABANDONED) == 1 { return }
    if sync.atomic_load(w.state) == IDLE {
        _c = fd_close(w.fd)
        sync.atomic_store(w.state, CLOSED)
    }
}
