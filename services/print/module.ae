// services/print — the one place sae hands a document to the system's
// printing (the page API's `printing.pdf`, app mode, capabilities.print).
// It imports exactly one UI name, ui.print_pdf (AppKit's print panel, GTK's
// print dialog, the file's Print verb on Win32, UIKit's print interaction),
// and writes the PDF the page made to a file of its own for it. Under a
// test aether-ui records the request (the driver's GET /printed) instead of
// showing the dialog.
import ui (print_pdf)
import std.fs (write_atomic, mkdir_p)
import std.string
import std.encoding

exports (new, configure, granted, pdf)

// One launch's printing: the kernel holds one (new()) and passes it to every
// call; nothing here is module state.
struct Printing {
    enabled: int   // 0 without capabilities.print, and in the browser
    dir: string    // where the files to print are written
    n: int         // files written so far
}

// For a web page: no printing.
new() -> ptr {
    r = heap.new(Printing)
    r.enabled = 0
    r.dir = ""
    r.n = 0
    return r as ptr
}

// Set up for an app that may print (enabled 1), its files written in dir.
configure(h: ptr, enabled: int, dir: string) {
    r = h as *Printing
    r.enabled = enabled
    r.dir = string.copy(dir)
}

granted(h: ptr) -> int {
    r = h as *Printing
    return r.enabled
}

// A PDF (its bytes as base64) to the system's print dialog, its job named
// title: "" when the dialog was asked for, else why not.
pdf(h: ptr, b64: string, title: string) -> string {
    r = h as *Printing
    if r.enabled == 0 { return "printing.pdf: this app may not print (app.json capabilities.print)" }
    raw, derr = encoding.base64_decode(b64)
    if derr != "" { return "printing.pdf: not base64" }
    if string.length(raw) < 5 || string.starts_with(raw, "%PDF-") == 0 { return "printing.pdf: not a PDF" }
    // The app's data folder exists only once something wrote there.
    merr = mkdir_p(r.dir)
    if merr != "" { return "printing.pdf: ${merr} ${r.dir}" }
    r.n = r.n + 1
    path = "${r.dir}/sae-print-${r.n}.pdf"
    err = write_atomic(path, string.bytes(raw))
    if err != "" { return "printing.pdf: ${err}" }
    if print_pdf(path, title) == 0 { return "printing.pdf: this system has no print dialog for it" }
    return ""
}
