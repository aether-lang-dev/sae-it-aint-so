// spec_pomatez.ae — the Pomatez port (examples/pomatez) as an app, driven as a
// person would. SAE_TIME_SCALE=60 makes a minute a second; SAE_STORAGE_DIR
// keeps the run's app storage out of ~/.sae.
//
//   SAE_TEST_APP=examples/pomatez SAE_TIME_SCALE=60 \
//     SAE_STORAGE_DIR=target/spec-storage tests/run_spec.sh spec_pomatez
import std.spec
import std.string
import std.fs
import std.os (os_getenv)
import saedriver as b
import uidriver

// The ring's top tick, in canvas pixels: viewBox (100, 14) of a 200x200 box.
tick_x() -> int { return b.vg_px_x(100.0, 200.0, 200.0) }
tick_y() -> int { return b.vg_px_y(14.0, 200.0, 200.0) }

stored(key: string) -> string {
    d = os_getenv("SAE_STORAGE_DIR")
    if d == null { return "" }
    body, err = fs.read("${d}/app-Pomatez/${key}")
    if string.length(err) > 0 { return "" }
    return body
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "Pomatez on sae") {
        spec.it("starts on the timer: Stay Focused, 25:00, round 1 of 4") callback {
            b.assert_text("Stay Focused", "period")
            b.assert_text("25:00", "Pomatez's default 25 minutes")
            b.assert_text("Round 1 of 4", "round")
            b.assert_text("Working on: Port Pomatez to sae", "the first task, from the default list")
            spec.assert_true(b.button_exists("Start"), "a Start button")
        }
        spec.it("draws the ring in Pomatez's focus blue") callback {
            spec.assert_true(b.wait_for_vg_pixel(tick_x(), tick_y(), 0x007bc7), "top tick is #007bc7")
        }
        spec.it("Config: one-minute focus and short break") callback {
            b.click("Config")
            b.slide_nth(0, 1)
            b.assert_text("Stay focus: 1 min", "focus slider")
            b.slide_nth(1, 1)
            b.assert_text("Short break: 1 min", "short break slider")
            b.click("Timer")
            b.assert_text("01:00", "the stopped timer takes the new length")
        }
        spec.it("a focus period runs out into a short break, with Pomatez's notice") callback {
            b.click("Start")
            spec.assert_true(b.button_exists("Pause"), "Start became Pause")
            spec.assert_true(b.wait_for_console("notify: Focus time finished. Enjoy your 1 minute short break."),
                "the notice")
            b.assert_text("Short Break", "now a short break")
            b.assert_text("Round 1 of 4", "same round")
            spec.assert_true(b.wait_for_vg_pixel(tick_x(), tick_y(), 0x00855f), "the ring turned break green")
        }
        spec.it("the break ends: round 2, stopped, because auto start is off") callback {
            spec.assert_true(b.wait_for_console("notify: Break time finished."), "the notice")
            b.assert_text("Stay Focused", "back to focus")
            b.assert_text("Round 2 of 4", "next round")
            spec.assert_true(b.button_exists("Start"), "stopped")
            spec.assert_true(b.wait_for_vg_pixel(tick_x(), tick_y(), 0x007bc7), "blue again")
        }
        spec.it("Pause stops the clock, Reset restarts the period") callback {
            b.click("Start")
            sleep(300)
            b.click("Pause")
            before = b.page_texts()
            sleep(1200)
            spec.assert_str_eq(b.page_texts(), before, "nothing moved while paused")
            b.assert_no_text("01:00", "time had passed")
            b.click("Reset")
            b.assert_text("01:00", "reset")
        }
        spec.it("Skip moves on without a notice") callback {
            b.click("Skip")
            b.assert_text("Short Break", "skipped to the break")
            b.click("Skip")
            b.assert_text("Stay Focused", "and back")
            b.assert_text("Round 3 of 4", "a round further")
        }
        spec.it("Tasks: add one, tick one off, and the timer shows what is next") callback {
            b.click("Tasks")
            b.set_field("Write the spec")
            b.click("Add task")
            b.assert_text("2 to do, 0 done", "added")
            b.check("Port Pomatez to sae")
            b.assert_text("1 to do, 1 done", "ticked off")
            b.assert_text("Working on: Write the spec", "the timer's next task")
        }
        spec.it("config and tasks persist in the app's storage") callback {
            spec.assert_contains(stored("config"), "\"stayFocus\":1", "config saved")
            spec.assert_contains(stored("tasks"), "Write the spec", "tasks saved")
            spec.assert_contains(stored("tasks"), "\"done\":true", "with the ticked one")
        }
        spec.it("Restore defaults puts Pomatez's rules back") callback {
            b.click("Config")
            b.click("Restore defaults")
            b.assert_text("Stay focus: 25 min", "focus 25")
            b.assert_text("Short break: 5 min", "short break 5")
            b.click("Timer")
            b.assert_text("25:00", "the timer too")
            spec.assert_contains(stored("config"), "\"stayFocus\":25", "saved")
        }
    }
    return spec.run_summary(fw)
}
