// spec_life.ae — demo 14: Conway's Life on a raster. A blinker evolves as a
// blinker does (horizontal, vertical, horizontal), the generation label
// follows, a click toggles a cell, the frame clock runs it, and the picker
// loads patterns. The page is site/life.ts.
//
//   tests/run_spec.sh spec_life
import std.spec
import std.string
import saedriver as b
import uidriver

const ALIVE = 0x5adc78
const DEAD = 0x12161e

// The pixel at cell (cx, cy) of the 64x64 viewBox is alive (1) or dead (0).
cell(cx: int, cy: int) -> int {
    x = b.vg_px_x(cx + 0.5, 64.0, 64.0)
    y = b.vg_px_y(cy + 0.5, 64.0, 64.0)
    if b.vg_pixel_near(x, y, ALIVE, 30) == 1 { return 1 }
    return 0
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "life (demo 14)") {
        spec.it("loads a blinker: three cells in a row at generation 0") callback {
            b.navigate(b.test_url("/life"))
            b.assert_page("Life", "200 ", "life page")
            spec.assert_true(b.wait_for_console("life: Blinker loaded"), "pattern loaded")
            spec.assert_true(b.wait_for_text("Generation 0"), "the bound label")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(32.5, 64.0, 64.0), b.vg_px_y(32.5, 64.0, 64.0), ALIVE), "centre alive")
            spec.assert_eq(cell(31, 32), 1, "left alive")
            spec.assert_eq(cell(33, 32), 1, "right alive")
            spec.assert_eq(cell(32, 31), 0, "above dead")
            spec.assert_eq(cell(32, 33), 0, "below dead")
            spec.assert_true(b.vg_pixel_near(b.vg_px_x(10.5, 64.0, 64.0), b.vg_px_y(10.5, 64.0, 64.0), DEAD, 30) == 1, "an empty cell is the dead colour")
        }
        spec.it("one step turns it vertical, two steps turn it back") callback {
            b.click("Step")
            spec.assert_true(b.wait_for_text("Generation 1"), "generation 1")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(32.5, 64.0, 64.0), b.vg_px_y(31.5, 64.0, 64.0), ALIVE), "above alive now")
            spec.assert_eq(cell(32, 33), 1, "below alive")
            spec.assert_eq(cell(31, 32), 0, "left dead")
            spec.assert_eq(cell(33, 32), 0, "right dead")
            spec.assert_eq(cell(32, 32), 1, "centre still alive")
            b.click("Step")
            spec.assert_true(b.wait_for_text("Generation 2"), "generation 2")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(31.5, 64.0, 64.0), b.vg_px_y(32.5, 64.0, 64.0), ALIVE), "left alive again")
            spec.assert_eq(cell(32, 31), 0, "above dead again")
        }
        spec.it("a click toggles the cell under it, in cell coordinates") callback {
            b.vg_click(b.vg_px_x(10.5, 64.0, 64.0), b.vg_px_y(20.5, 64.0, 64.0))
            spec.assert_true(b.wait_for_console("life: cell 10,20 born"), "the handler mapped the click to a cell")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(10.5, 64.0, 64.0), b.vg_px_y(20.5, 64.0, 64.0), ALIVE), "and it is drawn alive")
            b.vg_click(b.vg_px_x(10.5, 64.0, 64.0), b.vg_px_y(20.5, 64.0, 64.0))
            spec.assert_true(b.wait_for_console("life: cell 10,20 died"), "toggled back")
        }
        spec.it("Run steps it on the frame clock; a lone cell dies") callback {
            b.check("Run")
            spec.assert_true(b.wait_for_text("Generation 8"), "generations advance on frames")
            b.check("Run")
            sleep(300)
            n = b.page_texts()
            spec.assert_true(string.contains(n, "Generation ") == 1, "still counting while it was on")
        }
        spec.it("the picker loads another pattern at generation 0") callback {
            b.pick(1)
            spec.assert_true(b.wait_for_console("life: Glider loaded"), "glider")
            spec.assert_true(b.wait_for_text("Generation 0"), "count reset")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(2.5, 64.0, 64.0), b.vg_px_y(1.5, 64.0, 64.0), ALIVE), "the glider's head")
            spec.assert_eq(cell(32, 32), 0, "the blinker is gone")
        }
    }
    return spec.run_summary(fw)
}
