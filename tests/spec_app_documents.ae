// spec_app_documents.ae — the documents page API: the person picks, the page
// gets a handle (a name and its text), never a path; a cancel is null.
// Headless, so each picker takes the answer the spec queued.
//   AETHER_UI_HEADLESS=1 SAE_TEST_APP=tests/apps/documents tests/run_spec.sh spec_app_documents
import std.spec
import std.string
import std.fs
import std.os (os_getenv)
import saedriver as b
import uidriver

tmp_dir() -> string {
    t = os_getenv("TMPDIR")
    if t == null { return "/tmp" }
    while string.ends_with(t, "/") == 1 { t = string.substring(t, 0, string.length(t) - 1) }
    return t
}

main() {
    fw = spec.init()
    uidriver.wait_server()
    dir = "${tmp_dir()}/sae-documents"
    _m = fs.mkdir_p(dir)
    _w = fs.write("${dir}/costs.json", "the costs")
    _d = fs.delete("${dir}/budget.json")
    spec.describe(fw, "documents: picked files, as handles") {
        spec.it("pick_open: the person picks, the page reads it by name") callback {
            uidriver.answer_prompt("open", "${dir}/costs.json")
            b.click("open")
            b.assert_text("open: costs.json says the costs", "read what was picked")
            spec.assert_contains(uidriver.prompts(), "\"title\":\"Open a sheet\"", "the picker asked as the page said")
        }
        spec.it("pick_save: the page writes where the person chose") callback {
            uidriver.answer_prompt("save", "${dir}/budget.json")
            b.click("save")
            b.assert_text("save: saved budget.json", "saved")
            body, _e = fs.read("${dir}/budget.json")
            spec.assert_str_eq(body, "{\"saved\":true}", "on disk")
            spec.assert_contains(uidriver.prompts(), "\"default_name\":\"budget.json\"", "the suggested name")
        }
        spec.it("a cancelled picker is null") callback {
            uidriver.answer_prompt("open", "")
            b.click("open")
            b.assert_text("open: cancelled", "null")
        }
        spec.it("a handle shows a name and its two calls, not a path") callback {
            uidriver.answer_prompt("open", "${dir}/costs.json")
            b.click("what a handle shows")
            b.assert_text("what a handle shows: name,read_text,write_text", "nothing else")
            spec.assert_eq(string.contains(b.page_texts(), dir), 0, "no path on the page")
        }
        spec.it("no fs, no raw gates, and documents cannot be changed") callback {
            b.click("what else is there")
            b.assert_text("what else is there: fs undefined, raw undefined, frozen true", "only documents")
        }
    }
    return spec.run_summary(fw)
}
