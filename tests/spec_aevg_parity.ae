// spec_aevg_parity.ae -- the corpus files emitted as AeVG-TS pages
// (tools/gen-corpus.sh: site/corpus_<name>.ts) render through the driver
// as the parity harness says they should: the canvas's pixels, sampled on
// a grid, against librsvg's reference PNG for the same file
// (aether-ui/vg/test/screenshots/svg-compare-aevg/<name>_ref.png), as a
// per-pixel mean absolute error (lib/png_mae.py, the measure of
// aether-ui's vg/test/svg-compare-aevg.py).
//
//   tests/run_spec.sh spec_aevg_parity
import std.spec
import std.string
import std.fs
import std.os
import saedriver as b
import uidriver

const REFS = "../aether-ui/vg/test/screenshots/svg-compare-aevg"

// The page's canvas, 400 x 400 as the reference is, sampled every 4 px, and
// its error against the reference. -1.0 when something went wrong (said).
parity(name: string) -> float {
    b.navigate(b.test_url("/corpus_${name}"))
    spec.assert_true(b.wait_for_text("corpus: ${name}"), "the ${name} page loads")
    spec.assert_true(b.wait_for_vg_canvas(), "the page has a canvas")
    cw = uidriver.widget_int_field_by_id(b.vg_canvas(), "w")
    ch = uidriver.widget_int_field_by_id(b.vg_canvas(), "h")
    spec.assert_eq(cw, 400, "the canvas is 400 wide (centred by its spacers, not stretched)")
    spec.assert_eq(ch, 400, "and 400 high")
    grid = b.vg_grid(400, 400, 4)
    path = "../target/parity_${name}.txt"
    werr = fs.write(path, grid)
    spec.assert_str_eq(werr, "", "the grid is written")
    out, eerr = os.exec("python3 lib/png_mae.py ${REFS}/${name}_ref.png ${path} 400 400 4")
    if eerr != "" {
        spec.fail("png_mae.py: ${eerr} ${out}")
        return 0.0 - 1.0
    }
    // "mae 3.21 samples 10000"
    rest = string.substring(out, 4, string.length(out))
    sp = string.index_of(rest, " ")
    v, verr = string.to_double(string.substring(rest, 0, sp))
    if verr != "" {
        spec.fail("png_mae.py said: ${out}")
        return 0.0 - 1.0
    }
    println("    parity ${name}: ${out}")
    return v
}

main() {
    fw = spec.init()
    uidriver.wait_server()
    spec.describe(fw, "corpus pages against librsvg") {
        spec.it("heart: one filled, stroked path") callback {
            spec.assert_true(parity("heart") <= 12.0, "heart within 12 (a stroke's edge and antialiasing)")
        }
        spec.it("compass: paths and a thick-stroked ellipse") callback {
            spec.assert_true(parity("compass") <= 12.0, "compass within 12")
        }
        spec.it("beacon: a group's fill and stroke cascading to its paths") callback {
            spec.assert_true(parity("beacon") <= 12.0, "beacon within 12")
        }
        spec.it("atom: rotated ellipses, a root stroke-width, nested groups") callback {
            spec.assert_true(parity("atom") <= 12.0, "atom within 12")
        }
        spec.it("AJ_Digital_Camera: 175 gradients, 80 shapes, inline styles") callback {
            // 33.7 while every gradient painted nothing (the host dropped
            // their stops; spec_aevg says why), 18.4 since they paint
            // (2026-10-10). The rest is gradient detail the live path draws
            // differently from librsvg; the bound keeps headroom over 18.4.
            spec.assert_true(parity("AJ_Digital_Camera") <= 25.0, "camera within 25")
        }
    }
    return spec.run_summary(fw)
}
