// spec_charts.ae -- the Charts port (examples/charts) as an app: the animated
// bars held at t=0 (Pause, Restart) with their values and pixels, the heat
// map's colour at a cell, the line chart's interpolations, series and zoom.
//
//   SAE_TEST_APP=examples/charts tests/run_spec.sh spec_charts
import std.spec
import std.string
import saedriver as b
import uidriver

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "Charts on sae") {
        spec.it("starts on the bars; held at t=0 they have Tsyne's values") callback {
            b.assert_text("Animated bars", "the bar view")
            b.click("Pause")
            b.click("Restart")
            spec.assert_true(b.button_exists("Resume"), "paused")
            spec.assert_true(b.wait_for_vg_canvas() == 1, "the chart is drawn")
            sleep(300)
            nodes = b.vg_nodes()
            spec.assert_contains(nodes, "\"text\":\"105\"", "bar 2: 70 + 40 sin 60 degrees")
            spec.assert_contains(nodes, "\"text\":\"125\"", "bar 3")
            spec.assert_contains(nodes, "\"text\":\"95\"", "bar 5")
        }
        spec.it("the bars are drawn at those heights, in their colours") callback {
            // 400 x 250 viewBox. Bar 1 (x 40 to 83) is 68 high: 142 to 210.
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(62.0, 400.0, 250.0), b.vg_px_y(200.0, 400.0, 250.0), 0xFF6B6B), "bar 1 is red low down")
            spec.assert_true(b.vg_pixel_near(b.vg_px_x(62.0, 400.0, 250.0), b.vg_px_y(100.0, 400.0, 250.0), 0xFFFFFF, 6) == 1, "and white above it")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(115.0, 400.0, 250.0), b.vg_px_y(100.0, 400.0, 250.0), 0x4ECDC4), "bar 2 is taller, teal at y 100")
        }
        spec.it("Randomize changes the phases: the values move") callback {
            before = b.vg_nodes()
            b.click("Randomize")
            sleep(300)
            spec.assert_true(string.equals(b.vg_nodes(), before) == 0, "the bars are not where they were")
        }
        spec.it("the heat map at t=0: cell (0,0) is 50, a yellow green") callback {
            b.click("Heatmap")
            b.assert_text("Temperature/value distribution over time", "the heat map view")
            b.click("Restart")
            spec.assert_true(b.wait_for_vg_canvas() == 1, "drawn")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(30.0, 350.0, 360.0), b.vg_px_y(30.0, 350.0, 360.0), 0x8EA300), "viridis(50) is rgb(142, 163, 0)")
            spec.assert_contains(b.vg_nodes(), "100 (high)", "the legend")
        }
        spec.it("the line chart: four interpolations, zoom and series") callback {
            b.click("Lines")
            b.assert_text("Interpolation: linear | Zoom: 100%", "the status line")
            spec.assert_true(b.wait_for_vg_canvas() == 1, "drawn")
            // the point (50, 42) is at plot (320, 208.8), in the scene (380, 268.8)
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(380.0, 760.0, 480.0), b.vg_px_y(268.8, 760.0, 480.0), 0xFF6B6B), "a data point's red dot")
            b.click("catmull-rom")
            b.assert_text("Interpolation: catmull-rom | Zoom: 100%", "interpolation changed")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(380.0, 760.0, 480.0), b.vg_px_y(268.8, 760.0, 480.0), 0xFF6B6B), "the curve still passes through its points")
            b.check("Show multiple series")
            spec.assert_true(b.wait_for_vg_pixel(b.vg_px_x(380.0, 760.0, 480.0), b.vg_px_y(322.8, 760.0, 480.0), 0x45B7D1), "the third series passes through (50, 27)")
            b.click("Zoom In")
            b.assert_text("Interpolation: catmull-rom | Zoom: 115%", "zoomed 15%")
            b.click("Reset Zoom")
            b.assert_text("Interpolation: catmull-rom | Zoom: 100%", "reset")
        }
    }
    return spec.run_summary(fw)
}
