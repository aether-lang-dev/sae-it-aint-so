// spec_app_bus.ae — the control bus (docs/control-bus.md): another program
// on this machine drives an app, with the courier key from the courier file
// and every message sealed. This spec is that other program: it reads the
// file, seals with services/secure_channel (aeo's), and speaks raw HTTP over
// std.tcp, so it can also send what a well-behaved client never would.
//   SAE_TEST_FLAGS=--control-bus SAE_APPDATA_DIR=$PWD/target/bus-appdata \
//     SAE_TEST_APP=tests/apps/bus tests/run_spec.sh spec_app_bus
import std.spec
import std.string
import std.fs
import std.tcp
import std.json
import std.os (os_getenv)
import std.os
import std.list
import std.http.client
import std.time (now_ms)
import saedriver as b
import uidriver
import services.secure_channel
import busclient (courier_path_, courier_, port_of_, exchange_, request_, command_)

main() {
    fw = spec.init()
    uidriver.wait_server()
    spec.describe(fw, "the control bus, switched on at launch") {
        spec.it("listening: the courier file has the address and a key, only for this user; the title says so") callback {
            spec.assert_true(b.wait_for_console("sae: control bus: listening"), "listening")
            url, key = courier_()
            spec.assert_true(string.starts_with(url, "http://127.0.0.1:") == 1, "on loopback: ${url}")
            spec.assert_true(string.ends_with(url, "/api/sheet") == 1, "at the app's name")
            spec.assert_true(string.length(key) >= 20, "a key")
            if os.platform() == "windows" {
                // The DACL, as SDDL (principals by SID, any locale): protected,
                // nothing inherited from the folder, and none of Users,
                // Authenticated Users or Everyone (fs.chmod 0600, aether #3649).
                dacl = dacl_of_(courier_path_())
                spec.assert_true(string.starts_with(dacl, "D:P") == 1, "a protected DACL: ${dacl}")
                spec.assert_eq(string.contains(dacl, "ID;"), 0, "nothing inherited: ${dacl}")
                spec.assert_eq(string.contains(dacl, ";;;BU)") + string.contains(dacl, ";;;AU)") + string.contains(dacl, ";;;WD)"), 0, "readable only by this user: ${dacl}")
            } else {
                argv = list.new()
                list.add(argv, "-c")
                list.add(argv, "stat -c %a \"$0\" 2>/dev/null || stat -f %Lp \"$0\"")
                list.add(argv, courier_path_())
                mode, _code, _merr = os.run_capture("sh", argv, null)
                spec.assert_str_eq(string.trim(mode), "600", "readable only by this user")
            }
            spec.assert_contains(uidriver.get_body("/windows"), "Bus test - control bus on", "the title marked")
        }
        spec.it("a sealed command reaches the page's handler; its answer comes back sealed") callback {
            _u, key = courier_()
            status, plain = command_(key, "SETCELL(A1, 100)")
            spec.assert_str_eq(status, "HTTP/1.1 200 OK", "answered")
            spec.assert_contains(plain, "\"success\":true", "succeeded")
            spec.assert_contains(plain, "\"echo\":\"SETCELL(A1, 100)\"", "the handler's result")
            b.assert_text("last: SETCELL(A1, 100)", "the page saw it")
        }
        spec.it("the ui channel is the app's to grant: this one does not, so @ui is refused, the page never asked") callback {
            _u, key = courier_()
            status, plain = command_(key, "@ui GET /widgets")
            spec.assert_str_eq(status, "HTTP/1.1 200 OK", "answered")
            spec.assert_contains(plain, "\"success\":false", "refused")
            spec.assert_contains(plain, "does not grant capabilities.controlBus.ui", "saying why")
        }
        spec.it("an async handler, and one that throws") callback {
            _u, key = courier_()
            _s1, later = command_(key, "later")
            spec.assert_contains(later, "\"late\":true", "a promise's value")
            _s2, boom = command_(key, "boom")
            spec.assert_contains(boom, "\"success\":false", "failed")
            spec.assert_contains(boom, "the handler failed", "saying why")
        }
        spec.it("a handler the page's time limit stops: answered as stopped at once, and the page told") callback {
            _u, key = courier_()
            t0 = os.now_monotonic_ms()
            _s, spin = command_(key, "spin")
            took = os.now_monotonic_ms() - t0
            spec.assert_contains(spin, "\"success\":false", "failed")
            spec.assert_contains(spin, "stopped: it ran past the app's limit of 5 s for one piece of work", "saying why")
            spec.assert_true(took < 9000, "answered when stopped (${took} ms), not at the bus's 10 s deadline")
            spec.assert_true(b.wait_for_text("stopped: interrupted (1)"), "the page told: interrupted")
            _s2, after = command_(key, "after")
            spec.assert_contains(after, "\"echo\":\"after\"", "and the next request served as ever")
        }
        spec.it("a handler that never answers: answered at the deadline, and the page told") callback {
            _u, key = courier_()
            _s, hang = command_(key, "hang")
            spec.assert_contains(hang, "the app did not answer in 10 s", "answered for it")
            spec.assert_true(b.wait_for_text("stopped: deadline (2)"), "the page told: deadline")
            _s2, after = command_(key, "after again")
            spec.assert_contains(after, "\"echo\":\"after again\"", "and the next request served")
        }
        spec.it("refused: unsealed, the wrong key, a replay, a browser, another host, too big, another path") callback {
            url, key = courier_()
            port = port_of_(url)
            here = "127.0.0.1:${port}"
            s1, _b1 = exchange_(port, request_(port, "/api/sheet", here, "", "{\"command\":\"x\"}"))
            spec.assert_str_eq(s1, "HTTP/1.1 401 Unauthorized", "unsealed")
            s2, _b2 = exchange_(port, request_(port, "/api/sheet", here, "", secure_channel.seal_line("not the key", "{\"command\":\"x\"}")))
            spec.assert_str_eq(s2, "HTTP/1.1 401 Unauthorized", "the wrong key")
            frame = secure_channel.seal_line(key, "{\"command\":\"once\"}")
            s3, _b3 = exchange_(port, request_(port, "/api/sheet", here, "", frame))
            s4, b4 = exchange_(port, request_(port, "/api/sheet", here, "", frame))
            spec.assert_str_eq(s3, "HTTP/1.1 200 OK", "the first time")
            spec.assert_str_eq(s4, "HTTP/1.1 401 Unauthorized", "the same frame again: a replay")
            spec.assert_contains(b4, "(replay)", "said so")
            s5, _b5 = exchange_(port, request_(port, "/api/sheet", here, "Origin: https://evil.test\r\n", secure_channel.seal_line(key, "{\"command\":\"x\"}")))
            spec.assert_str_eq(s5, "HTTP/1.1 403 Forbidden", "a browser (Origin)")
            s6, _b6 = exchange_(port, request_(port, "/api/sheet", "evil.test:${port}", "", secure_channel.seal_line(key, "{\"command\":\"x\"}")))
            spec.assert_str_eq(s6, "HTTP/1.1 403 Forbidden", "another host (DNS rebinding)")
            big = "x"
            while string.length(big) < 5000 { big = "${big}${big}" }
            s7, _b7 = exchange_(port, request_(port, "/api/sheet", here, "", big))
            spec.assert_str_eq(s7, "HTTP/1.1 413 Payload Too Large", "past maxRequestBytes")
            s8, _b8 = exchange_(port, request_(port, "/api/other", here, "", secure_channel.seal_line(key, "{\"command\":\"x\"}")))
            spec.assert_str_eq(s8, "HTTP/1.1 404 Not Found", "another path")
            spec.assert_true(b.wait_for_console("sae: control bus: refused a request from a web browser"), "refusals logged")
            body, _e = fs.read(target_log_())
            spec.assert_eq(string.contains(body, key), 0, "and the key never")
        }
        spec.it("a reply from a server without the key does not open") callback {
            _u, key = courier_()
            fake = secure_channel.seal_line("an impostor's key", "{\"success\":true}")
            _p, why = secure_channel.open_line(key, fake)
            spec.assert_true(string.length(why) > 0, "refused: ${why}")
        }
        // A client that asks and then never reads: the answer ("big", 4 MB
        // sealed) is far more than the socket holds. sae writes what the
        // socket takes, a tick at a time, so the window keeps answering;
        // after 5 s the client is dropped, saying so. Before 2026-11-11 the
        // answer was one tcp.write on the UI thread, and the window stopped
        // answering for as long as the socket stayed full (35 s on macOS).
        spec.it("a client that never reads its answer: the window keeps answering, and after 5 s the client is dropped, saying so") callback {
            url, key = courier_()
            port = port_of_(url)
            sock, cerr = tcp.connect_buffered("127.0.0.1", port, 16384)
            spec.assert_str_eq(cerr, "", "connected")
            if cerr != "" { return }
            o = json.obj()
            _c = json.set(o, "command", json.str("big"))
            plain_in, _se = json.encode(o)
            json.json_free(o)
            _w = tcp.write(sock, request_(port, "/api/sheet", "127.0.0.1:${port}", "", secure_channel.seal_line(key, plain_in)))
            sleep(300)
            if responsive_(8, 400, "while the answer waits") == 0 {
                _x = tcp.tcp_close(sock)
                return
            }
            spec.assert_true(b.wait_for_text("last: big"), "the page answered")
            // Winsock takes the whole answer however little the client reads
            // (64 MB in 31 ms on win11), so there the socket never fills and
            // there is nothing to drop; the window answering is the point.
            if os.platform() != "windows" {
                spec.assert_true(b.wait_for_console_secs("sae: control bus: dropped a client that did not read its answer", 15), "dropped, saying so")
            }
            _r = responsive_(2, 100, "after")
            _x = tcp.tcp_close(sock)
            _s, after = command_(key, "after the deaf one")
            spec.assert_contains(after, "\"echo\":\"after the deaf one\"", "and the next request served")
        }
        spec.it("bus.stop: the courier file goes, the title is plain again, nothing listens") callback {
            url, _k = courier_()
            port = port_of_(url)
            b.click("stop")
            spec.assert_true(b.wait_for_console("sae: control bus: stopped"), "stopped")
            spec.assert_eq(fs.exists(courier_path_()), 0, "the file deleted")
            spec.assert_eq(string.contains(uidriver.get_body("/windows"), "control bus on"), 0, "the title plain")
            s, _b = exchange_(port, "x")
            spec.assert_true(string.starts_with(s, "no connection") == 1 || s == "", "nothing listening: ${s}")
            b.click("serve")
            spec.assert_true(b.wait_for_console_n("sae: control bus: listening", 2), "and serving again")
            _u2, key2 = courier_()
            spec.assert_true(key2 != "", "a new key")
        }
    }
    return spec.run_summary(fw)
}

// How long the window took to answer the driver (GET /windows, served on
// sae's UI thread), or -1 when it did not within 2 s.
answered_in_() -> long {
    t0 = now_ms()
    req = client.request("GET", uidriver.url_of("/windows"))
    _t = client.set_timeout(req, 2s)
    resp, cerr = client.send_request(req)
    client.request_free(req)
    if cerr != "" { return 0 - 1 }
    client.response_free(resp)
    return now_ms() - t0
}

// The window answers the driver within a second, `n` times, `gap_ms` apart:
// 1, or 0 (the case failed) at the first time it does not.
responsive_(n: int, gap_ms: int, msg: string) -> int {
    i = 0
    while i < n {
        ms = answered_in_()
        spec.assert_true(ms >= 0 && ms < 1000, "${msg}: the window answered the driver in ${ms} ms (-1: not within 2 s)")
        if ms < 0 || ms >= 1000 { return 0 }
        sleep(gap_ms)
        i = i + 1
    }
    return 1
}

// The DACL part of `path`'s security descriptor on Windows, in SDDL
// (PowerShell's Get-Acl), "" when it cannot be read. An MSYS2 path
// (/c/...) is given to PowerShell as C:/...
dacl_of_(path: string) -> string {
    p = path
    if string.length(p) > 2 && string.starts_with(p, "/") == 1 && string.substring(p, 2, 3) == "/" {
        p = "${string.to_upper(string.substring(p, 1, 2))}:${string.substring(p, 2, string.length(p))}"
    }
    av = list.new()
    list.add(av, "-NoProfile")
    list.add(av, "-NonInteractive")
    list.add(av, "-Command")
    list.add(av, "(Get-Acl -LiteralPath '${p}').Sddl")
    out, _st, _err = os.run_capture("powershell.exe", av, null)
    list.free(av)
    at = string.index_of(out, "D:")
    if at < 0 { return "" }
    return string.trim(string.substring(out, at, string.length(out)))
}

target_log_() -> string {
    return os_getenv("SAE_TEST_LOG")
}
