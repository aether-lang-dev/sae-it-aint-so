// spec_grid.ae — site/grid.ts: ui.datagrid on a page. Cells from the page's
// function, a sticky header, a click naming the cell, scrolling from code
// and from the scrollbar, and the window's size bounded.
//
//   tests/run_spec.sh spec_grid
import std.spec
import std.string
import std.json
import saedriver as b
import uidriver

// The grip at the right edge of the header cell whose label is t (the
// widget with class aui-grid-grip sharing the label's parent).
grip_of(t: string) -> int {
    parent = uidriver.widget_int_field_by_id(uidriver.widget_id_by_text(t), "parent")
    body = uidriver.get_body("/widgets")
    v, _jerr = json.parse(body)
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if uidriver.field_int(w, "parent") == parent && string.contains(uidriver.field_str(w, "classes"), "aui-grid-grip") == 1 {
            id = uidriver.field_int(w, "id")
        }
        i = i + 1
    }
    json.json_free(v)
    return id
}

// The widget with this placeholder (a text field), or 0.
by_placeholder(ph: string) -> int {
    body = uidriver.get_body("/widgets")
    v, _jerr = json.parse(body)
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "placeholder"), ph) == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "ui.datagrid") {
        spec.it("shows the first window from the page's function") callback {
            b.navigate(b.test_url("/grid"))
            spec.assert_true(b.wait_for_text("Grid"), "the page loads")
            spec.assert_true(b.wait_for_text("A1"), "cell A1")
            spec.assert_true(b.wait_for_text("E15"), "cell E15, the last shown")
            b.assert_text("#", "the header's corner")
        }
        spec.it("a click names the cell") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("C4")}/click", "click C4")
            spec.assert_true(b.wait_for_console("grid picked 3,3"), "row 3 (0-based), column 3")
            b.assert_text("picked: 3,3", "and the page showed it")
        }
        spec.it("keys move the selection; Return activates") callback {
            uidriver.post_ok("/window/key?combo=Down", "Down")
            spec.assert_true(b.wait_for_console("grid selected 4,3 to 4,3"), "Down from the clicked cell")
            uidriver.post_ok("/window/key?combo=Shift%2BRight", "Shift+Right")
            spec.assert_true(b.wait_for_console("grid selected 4,3 to 4,4"), "Shift extends from the anchor")
            uidriver.post_ok("/window/key?combo=Return", "Return")
            spec.assert_true(b.wait_for_console("grid activated 4,4"), "Return on the cursor")
        }
        spec.it("selects from code") callback {
            b.click("Select B2:D5")
            spec.assert_true(b.wait_for_console("grid selected 1,2 to 4,4"), "the range, cursor last")
        }
        spec.it("columns resize and move from code") callback {
            b.click("Widen B")
            spec.assert_true(b.wait_for_console("grid B is 150 wide"), "the width reads back")
            b.click("Move B to E")
            spec.assert_true(b.wait_for_console("grid moved 2 to 5; view 5 shows model 2"), "on_col_move, and the model column")
        }
        spec.it("a column frozen beside the row numbers, and freed") callback {
            b.click("Freeze A")
            spec.assert_true(b.wait_for_console("grid frozen columns 1"), "A frozen")
            b.click("Free columns")
            spec.assert_true(b.wait_for_console("grid frozen columns now 0"), "and freed")
        }
        spec.it("a grid given half its height, and all of it again") callback {
            b.click("Full height")
            spec.assert_true(b.wait_for_console("grid height 360"), "fifteen rows of 24")
            b.click("Half height")
            spec.assert_true(b.wait_for_console("grid height 180"), "half: seven and a half rows' room")
            b.click("Full height")
            spec.assert_true(b.console_contains("grid height 360") == 1, "and all again")
        }
        spec.it("several areas: one added from code, read back, and cleared") callback {
            b.click("Add an area")
            spec.assert_true(b.wait_for_console("grid areas 1,1,2,2; selection 5,3,6,4"), "the first kept as an area, the second the selection")
            b.click("One area")
            spec.assert_true(b.wait_for_console("grid areas now \"\""), "cleared")
        }
        spec.it("a header clicked, not dragged, is told with its model column") callback {
            h = uidriver.widget_id_by_text("D")
            uidriver.post_ok("/widget/${h}/drag?x=10&y=8&dx=0&dy=0", "press and let go D's header")
            spec.assert_true(b.wait_for_console("grid header clicked 4"), "on_header_click heard model column 4")
        }
        spec.it("and by dragging a header") callback {
            g = grip_of("C")
            spec.assert_contains(uidriver.get_body("/widget/${g}"), "\"cursor\":\"col-resize\"", "C's grip shows the col-resize pointer")
            uidriver.post_ok("/widget/${g}/drag?x=3&y=8&dx=-40&dy=0", "drag C's grip")
            spec.assert_true(b.wait_for_console("grid resized 2 to 56"), "C (now view 2) narrowed by 40")
        }
        spec.it("a double click edits a cell; on_cell_edit stores it") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("B7")}/double_click", "double-click B7")
            // The editor is the newest text field (the chrome's address bar
            // is the first).
            bar = uidriver.widget_id_of("textfield", "")
            ed = 0
            i = 0
            while i < 30 && ed == 0 {
                last = uidriver.widget_id_last_of("textfield", "")
                if last != bar { ed = last }
                if ed == 0 { sleep(100) }
                i = i + 1
            }
            spec.assert_true(ed > 0, "an editor opened")
            uidriver.post_ok("/widget/${ed}/set_text?v=hello", "type hello")
            uidriver.post_ok("/widget/${ed}/submit", "Return")
            spec.assert_true(b.wait_for_console("grid edited 6,2 = hello"), "row 6, model column 2")
            spec.assert_true(b.wait_for_text("hello"), "the cell shows it")
        }
        spec.it("cell_style colours a cell; edit_text holds a formula behind its value") callback {
            spec.assert_contains(uidriver.get_body("/widget/${uidriver.widget_id_by_text("B3")}"), "\"bg\":\"#ffe0e0\"", "B3 the alarm background")
            spec.assert_contains(uidriver.get_body("/widget/${uidriver.widget_id_by_text("B3")}"), "\"fontWeight\":\"bold\"", "bold")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("D9")}/double_click", "double-click D9")
            bar = uidriver.widget_id_of("textfield", "")
            ed = 0
            i = 0
            while i < 30 && ed == 0 {
                last = uidriver.widget_id_last_of("textfield", "")
                if last != bar && last != by_placeholder("note") { ed = last }
                if ed == 0 { sleep(100) }
                i = i + 1
            }
            spec.assert_true(ed > 0, "an editor opened")
            uidriver.post_ok("/widget/${ed}/set_text?v=%3D200%2B34", "type =200+34")
            uidriver.post_ok("/widget/${ed}/submit", "Return")
            spec.assert_true(b.wait_for_text("234"), "the cell shows the value")
            spec.assert_contains(uidriver.get_body("/widget/${uidriver.widget_id_by_text("234")}"), "\"anchor\":\"end\"", "at the right")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("234")}/double_click", "double-click it again")
            ed2 = 0
            j = 0
            while j < 30 && ed2 == 0 {
                last = uidriver.widget_id_last_of("textfield", "")
                if last != bar && last != by_placeholder("note") { ed2 = last }
                if ed2 == 0 { sleep(100) }
                j = j + 1
            }
            spec.assert_str_eq(uidriver.widget_text_by_id(ed2), "=200+34", "the editor holds the formula")
            uidriver.post_ok("/window/key?combo=Escape", "Escape")
        }
        spec.it("ui.datagrid_fit_col fits a column; ui.text_measure measures in a label's font") callback {
            b.click("Fit A")
            spec.assert_true(b.wait_for_console("grid A fitted to "), "fitted")
            spec.assert_true(b.wait_for_console("grid resized 1 to "), "and on_col_resize heard it")
            spec.assert_false(b.console_contains("\"A1\" measures 0"), "a label's measure is not 0")
        }
        spec.it("the first form still works: a cell function in the block's place") callback {
            spec.assert_true(b.wait_for_text("s21"), "the small grid's last cell")
            b.assert_text("S1", "and its header, set by handle through a chain")
        }
        spec.it("onsubmit() in a field's block; ondrag() and pointer_shape() in a label's") callback {
            f = by_placeholder("note")
            spec.assert_true(f > 0, "the note field")
            uidriver.post_ok("/widget/${f}/set_text?v=hi", "type hi")
            uidriver.post_ok("/widget/${f}/submit", "Return")
            spec.assert_true(b.wait_for_console("note submitted hi"), "onsubmit ran")
            uidriver.post_ok("/widget/${f}/focus", "focus the note")
            spec.assert_true(b.wait_for_console("note focus 1"), "onfocuschange heard focus come in")
            uidriver.post_ok("/widget/${uidriver.widget_id_of("textfield", "")}/focus", "focus the address bar")
            spec.assert_true(b.wait_for_console("note focus 0"), "and leave")
            spec.assert_true(b.wait_for_console("key_text comma is ,"), "ui.key_text turns a key name into its text")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("drag me")}/drag?x=3&y=3&dx=12&dy=5", "drag the label")
            spec.assert_true(b.wait_for_console("dragged by 12,5"), "ondrag heard the release")
            spec.assert_contains(uidriver.get_body("/widget/${uidriver.widget_id_by_text("drag me")}"), "\"cursor\":\"grab\"", "pointer_shape gave it the grab pointer")
        }
        spec.it("scrolls from code") callback {
            b.click("To row 500000")
            spec.assert_true(b.wait_for_console("grid first 499999,10"), "the first row and column shown")
            spec.assert_true(b.wait_for_text("J500000"), "cell J500000 at the top left")
            b.assert_text("#", "the header is still there")
        }
        spec.it("and from its scrollbar") callback {
            v = uidriver.widget_id_last_of("slider", "")
            h = uidriver.widget_id_of("slider", "")
            vs = h
            if uidriver.widget_int_field_by_id(v, "h") > uidriver.widget_int_field_by_id(v, "w") { vs = v }
            uidriver.post_ok("/widget/${vs}/set_value?v=999985", "drag to the end")
            spec.assert_true(b.wait_for_text("J1000000"), "the last row")
        }
        spec.it("rows: one hidden shows no text, row numbers stay model rows; a row frozen") callback {
            spec.assert_true(b.wait_for_text("n1:1"), "row 2 shown")
            b.click("Hide row 2")
            spec.assert_true(b.wait_for_console("rows: shown row 1 is model row 2"), "the second row shown is model row 2")
            spec.assert_true(b.wait_for_text_gone("n1:1"), "row 2's cells show nothing")
            b.click("Freeze a row")
            spec.assert_true(string.contains(uidriver.get_body("/widget/${uidriver.widget_id_by_text("n0:2")}"), "aui-grid-frozen") == 1, "row 1 frozen")
        }
        spec.it("a style past colour and bold: italic, underline, a border, a data bar, a corner, a tooltip") callback {
            w = uidriver.get_body("/widget/${uidriver.widget_id_by_text("n0:1")}")
            spec.assert_contains(w, "\"fontStyle\":\"italic\"", "italic")
            spec.assert_contains(w, "\"textDecoration\":\"underline\"", "underlined")
            spec.assert_contains(w, "\"borderBottom\":", "a bottom border")
            spec.assert_contains(w, "\"bar\":", "a data bar")
            spec.assert_contains(w, "\"corner\":", "a corner marker")
            spec.assert_contains(w, "\"tooltip\":\"a note\"", "the tooltip")
        }
        spec.it("merges: one rectangle, read back; undone") callback {
            b.click("Merge")
            spec.assert_true(b.wait_for_console("rows: merged 3,1,2,2"), "merged")
            b.click("Unmerge")
            spec.assert_true(b.wait_for_console("rows: merge of 4,2 is \"\""), "unmerged")
            b.click("Tall rows")
            spec.assert_true(b.wait_for_console("rows: heights set"), "row heights set")
        }
        spec.it("the editor's text is heard as it is typed; text goes in at the caret") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("n2:1")}/double_click", "double-click n2:1")
            spec.assert_true(b.wait_for_console("rows typing n2:1 @4"), "heard as it opened, the caret at its end")
            b.click("Insert X1")
            spec.assert_true(b.wait_for_console("rows typing n2:1X1 @6"), "X1 at the caret")
            uidriver.post_ok("/window/key?combo=Escape", "Escape")
        }
        spec.it("the selection glides once asked; the headers hide and show") callback {
            b.click("Glide")
            spec.assert_true(b.wait_for_console("grid glides 300 ms"), "asked")
            // The grid is at its last rows (the scrollbar's case above).
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("J999999")}/click", "click J999999")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("L999999")}/click", "click L999999, two to the right")
            spec.assert_true(b.wait_for_console("grid gliding from "), "the box glides from where it was")
            b.click("Picture")
            spec.assert_true(b.wait_for_console("grid picture on 999998,12"), "a picture asked for, in the cell selected")
            spec.assert_true(uidriver.wait_body_contains("/widgets", "\"type\":\"image\"", 40), "drawn over its cell")
            b.click("Picture")
            spec.assert_true(b.wait_for_console("grid picture off"), "and taken away")
            b.click("Taller rows")
            spec.assert_true(b.wait_for_console("grid rows 36 high"), "every row 36 high")
            b.click("Taller rows")
            spec.assert_true(b.wait_for_console("grid rows 24 high"), "and back")
            b.click("Headers")
            spec.assert_true(b.wait_for_console("grid headers shown false"), "hidden")
            b.click("Headers")
            spec.assert_true(b.wait_for_console("grid headers shown true"), "shown")
        }
        spec.it("ui.textarea: several lines, bound both ways") callback {
            b.click("Two lines")
            spec.assert_true(b.wait_for_text("story has 2 lines"), "the state set it")
            uidriver.post_ok("/widget/${by_placeholder("story")}/set_text?v=a%0Ab%0Ac", "type three lines")
            spec.assert_true(b.wait_for_text("story has 3 lines"), "typing set the state")
        }
    }
    return spec.run_summary(fw)
}
