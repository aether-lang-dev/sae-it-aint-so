// spec_nav.ae — sae's navigation spec: walks the demo site in site/ by
// clicking real buttons, the way a person would, and asserts on what the
// chrome and the pages show. Run it with tests/run_spec.sh, which starts
// the page server and sae-driver (see saedriver.ae).
import std.spec
import std.string
import saedriver as b
import uidriver

const HOME: string = "Welcome to Sae it ain't so"

go_home(msg: string) {
    b.click("Home")
    b.assert_page(HOME, "200 ", msg)
}

key_at_(label: string, f: string) -> int {
    return uidriver.widget_int_field_by_id(uidriver.widget_id_of("button", label), f)
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "loading and the chrome") {
        spec.it("home loads, and the page sees its own URL") callback {
            b.assert_page(string.concat("You are at ", b.test_url("/")), "200 ", "home")
            b.assert_url(b.test_url("/"), "status line")
            spec.assert_str_eq(b.current_url(), b.test_url("/"), "address field")
        }
        spec.it("a page link changes page") callback {
            b.click("About")
            b.assert_url(b.test_url("/about"), "about")
            b.assert_text("About", "about page")
        }
        spec.it("Back, then Forward") callback {
            b.back()
            b.assert_page(HOME, "200 ", "back to home")
            b.forward()
            b.assert_page("About", string.concat("200 ", b.test_url("/about")), "forward to about")
            go_home("home again")
        }
        spec.it("typing an address and pressing Go navigates") callback {
            b.navigate(b.test_url("/about"))
            b.assert_page("About", string.concat("200 ", b.test_url("/about")), "navigate")
        }
        spec.it("Reload reloads the same page") callback {
            b.reload()
            b.assert_page("About", string.concat("200 ", b.test_url("/about")), "reload")
            go_home("home after reload")
        }
    }

    spec.describe(fw, "HTTP outcomes") {
        spec.it("an unknown path shows the site's 404 page") callback {
            b.click("A page that is not there")
            b.assert_page("404: no such page", "404 ", "404 page")
            spec.assert_eq(b.status_code(), 404, "status code")
            go_home("home from 404")
        }
        spec.it("a 302 is followed") callback {
            b.click("Old home (302 to /)")
            b.assert_page(HOME, string.concat("200 ", b.test_url("/")), "302 to /")
        }
    }

    spec.describe(fw, "broken pages") {
        spec.it("a page that throws keeps what it built and says so") callback {
            b.click("A page that throws")
            b.assert_text("This page failed: see the console.", "failure notice")
            b.assert_text("Before the error", "before the throw")
            b.assert_text("Inside the block", "inside the block")
            b.assert_no_text("Never reached", "after the throw")
            b.back()
            b.assert_page(HOME, "200 ", "Back after a broken page")
        }
        spec.it("a page outside the dialect says where, and builds nothing") callback {
            b.click("A page outside the dialect")
            b.assert_text("This page could not be read:", "notice")
            spec.assert_contains(b.page_texts(), "unsupported:4:1: enum is not erasable TypeScript",
                "where")
            b.assert_no_text("You should not see this", "nothing built")
            b.back()
            b.assert_page(HOME, "200 ", "Back from the unreadable page")
        }
        spec.it("a page that seeks the file system is refused before it runs") callback {
            b.click("A page that seeks the file system")
            b.assert_text("This page cannot run here:", "notice")
            spec.assert_contains(b.page_texts(), "seeks local-filesystem, which a web page in the browser cannot have", "why")
            b.assert_no_text("You should not see this", "none of it ran")
            b.back()
            b.assert_page(HOME, "200 ", "Back from the refused page")
        }
        spec.it("a page using what it did not seek is refused where it does") callback {
            b.click("A page that uses what it did not seek")
            b.assert_text("This page could not be read:", "notice")
            spec.assert_contains(b.page_texts(), "unsought:4:1: fs needs \"seeks local-filesystem\" at the top of the page", "where")
            b.assert_no_text("You should not see this", "none of it ran")
            b.back()
            b.assert_page(HOME, "200 ", "Back from the unreadable page")
        }
        spec.it("a page with scoped seeks makes the requests it names and no others") callback {
            b.click("Scoped requests")
            b.click("Sought GET")
            b.assert_text("sought GET: ok 200", "a sought method and path")
            b.click("Sought POST")
            b.assert_text("sought POST: ok 200", "the second method on the same path")
            b.click("Unsought path")
            b.assert_text("unsought path: refused (this page's seeks do not cover GET ${b.test_url("/api/headers")})", "a path it did not seek")
            b.click("Unsought method")
            b.assert_text("unsought method: refused (this page's seeks do not cover PUT ${b.test_url("/api/echo")})", "a method it did not seek")
            b.click("Redirect within")
            b.assert_text("redirect within: ok 200", "a redirect to a sought URL is followed")
            b.click("Redirect beyond")
            b.assert_text("redirect beyond: refused (redirected to ${b.test_url("/api/headers")}: this page's seeks do not cover GET ${b.test_url("/api/headers")})",
                "a redirect is held to the scopes too")
            b.click("Home")
            b.assert_page(HOME, "200 ", "home")
        }
        spec.it("a web page may scope another origin; each request there needs that origin's consent") callback {
            b.click("A page that seeks another origin")
            b.assert_text("far: ok=true 200", "the scope is allowed, and the consenting answer arrives")
            b.assert_text("far-none: ok=false", "the same origin without consent is refused")
            b.click("Home")
            b.assert_page(HOME, "200 ", "home")
        }
        spec.it("a page that can do without what it seeks loads, and finds it absent") callback {
            b.click("A page that can do without")
            b.assert_text("files: not available, working without", "fs is absent, not refused")
            b.assert_text("open-urls: not available, working without", "an optional privilege the browser cannot give leaves shell absent")
            b.back()
            b.assert_page(HOME, "200 ", "Back from the page that did without")
        }
        spec.it("modern TypeScript runs as written: a class, an Error subclass, and an await on http") callback {
            b.click("Modern TypeScript")
            b.assert_text("clicks: 0", "a class with a private field")
            b.assert_text("caught Overdrawn: overdrawn by 5", "an Error subclass thrown in a block keeps its class")
            b.click("Bump")
            b.click("Bump")
            b.assert_text("clicks: 2", "its getter")
            b.click("Load")
            b.assert_text("loaded: n=42 first=a others=bc missing=none", "await on http, destructuring, ?. and ??")
            b.click("Home")
            b.assert_page(HOME, "200 ", "home")
        }
        spec.it("a page that loops forever is stopped; the browser carries on") callback {
            b.click("A page that loops forever")
            b.assert_text("Before the loop", "what it built first stays")
            spec.assert_true(b.wait_for_console("InternalError: interrupted"), "stopped by the time limit")
            b.assert_no_text("Never reached", "after")
            b.back()
            b.assert_page(HOME, "200 ", "and the browser still navigates")
        }
        spec.it("a modifier outside a container throws; earlier widgets stay") callback {
            b.click("Modifier misuse")
            b.assert_text("This page failed: see the console.", "failure notice")
            b.assert_text("Before the misuse", "before")
            b.assert_no_text("Never reached", "after")
            spec.assert_true(b.wait_for_console("margin() must be called inside a container's block"),
                "console says why")
            b.back()
            b.assert_page(HOME, "200 ", "Back from misuse")
        }
    }

    spec.describe(fw, "page state and handlers") {
        spec.it("the counter's handler runs per click") callback {
            b.click("Counter")
            b.assert_page("Counter page", "200 ", "counter")
            b.click("Increment")
            b.click("Increment")
            b.click("Increment")
            spec.assert_true(b.wait_for_console("count 3"), "console counts to 3")
            go_home("home from counter")
        }
        spec.it("the calculator (the design doc's example)") callback {
            b.click("Calculator")
            b.assert_page(" 0", "200 ", "calculator")
            b.click("4")
            b.click("2")
            b.assert_text(" 42", "4 2 shows 42 (state bound to text)")
            b.click("C")
            b.assert_text(" 0", "C clears")
            b.click("7"); b.click("+"); b.click("3"); b.click("=")
            b.assert_text(" 10", "7 + 3 = 10")
            b.click("C")
            b.click("6"); b.click("*"); b.click("7"); b.click("=")
            b.assert_text(" 42", "6 * 7 = 42")
            // grid(4, () => { equal_cells(); [..."789+456-123*0C=/"].forEach(key) })
            spec.assert_eq(key_at_("8", "y"), key_at_("7", "y"), "8 beside 7")
            spec.assert_eq(key_at_("+", "y"), key_at_("7", "y"), "+ ends the first row")
            spec.assert_eq(key_at_("4", "x"), key_at_("7", "x"), "4 under 7")
            spec.assert_eq(key_at_("/", "x"), key_at_("+", "x"), "/ under +")
            spec.assert_gt(key_at_("0", "y"), key_at_("1", "y"), "0 on the last row")
            // Equal by constraint; frames are then snapped to whole pixels, so
            // a grid whose width does not divide by 4 has one cell a pixel
            // wider (which width that is moves with the window's content).
            wd = key_at_("C", "w") - key_at_("7", "w")
            spec.assert_true(wd >= -1 && wd <= 1, "equal cells, to the pixel (C ${key_at_("C", "w")}, 7 ${key_at_("7", "w")})")
            go_home("home from calculator")
        }
        spec.it("a text field's handler, get_text, and a scroll block") callback {
            b.click("Form")
            b.assert_page("echo: ", "200 ", "form")
            b.set_field("Ada Lovelace & co")
            b.assert_text("echo: Ada Lovelace & co", "handler gets the text, encoded and back")
            b.click("Read")
            b.assert_text("read: Ada Lovelace & co", "get_text reads the field")
            b.assert_text("row 29", "scroll block built its rows")
            go_home("home from form")
        }
    }

    spec.describe(fw, "pages ported from Tsyne") {
        spec.it("scrolling: a hundred lines in a scroll block") callback {
            b.click("Scrolling")
            b.assert_page("Scrolling Demo", "200 ", "scrolling page")
            b.assert_text("Line 100: This is a line of text to demonstrate scrolling. Scroll down to see more!",
                "the last line was built")
            b.click("Back to Home")
            b.assert_page(HOME, "200 ", "home")
        }
        spec.it("dynamic: a counter updated in place with set_text") callback {
            b.click("Dynamic updates")
            b.assert_page("Dynamic Updates Demo", "200 ", "dynamic page")
            b.click("+")
            b.click("+")
            b.click("-")
            b.assert_text("Count: 1", "+ + - is 1")
            b.click("Reset")
            b.assert_text("Count: 0", "reset")
        }
        spec.it("dynamic: a list rebuilt in place with clear and into") callback {
            b.assert_text("  3. Initial Item 3", "the initial list")
            b.set_field("Milk")
            b.click("Add Item")
            b.assert_text("  4. Milk", "added from the field")
            b.click("Remove Last")
            spec.assert_true(b.wait_for_text_gone("  4. Milk"), "removed")
            b.assert_text("  3. Initial Item 3", "the rest stay")
            b.click("Clear All")
            b.assert_text("(no items)", "cleared")
            b.assert_no_text("  1. Initial Item 1", "nothing left")
            spec.assert_true(b.wait_for_console("items: 0"), "the page saw it")
        }
        spec.it("dynamic: a page cannot rewrite the browser's own widgets") callback {
            b.click("Try to rewrite the browser")
            spec.assert_true(b.wait_for_console("refused "), "the page reports")
            spec.assert_true(b.console_contains("refused all "), "every handle below the page's own was refused")
            spec.assert_str_eq(b.current_url(), b.test_url("/dynamic"), "the address bar is untouched")
            spec.assert_true(string.starts_with(b.status_line(), "200 ") == 1, "the status line is untouched")
            b.click("Back to Home")
            b.assert_page(HOME, "200 ", "home")
        }
    }

    spec.describe(fw, "inputs and indicators") {
        spec.it("a checkbox's handler, and reading it back") callback {
            b.click("Widget interactions")
            b.assert_page("Widget Interactions", "200 ", "widgets page")
            b.check("Enable feature")
            b.assert_text("Checkbox: on (callbacks: 1)", "checked")
            b.check("Enable feature")
            b.assert_text("Checkbox: off (callbacks: 2)", "unchecked")
            b.click("Verify Checkbox")
            spec.assert_true(b.wait_for_console("checkbox reads 0"), "get_toggle reads it")
            b.click("Check the box from code")
            b.click("Verify Checkbox")
            spec.assert_true(b.wait_for_console("checkbox reads 1"), "set_toggle sets it")
        }
        spec.it("a drop-down's handler gets the index") callback {
            b.pick(2)
            b.assert_text("Selected: Blue (index 2)", "picked Blue")
        }
        spec.it("a slider's handler, and a progress bar it drives") callback {
            b.slide_to(80)
            b.assert_text("Slider: 80", "slid to 80")
            spec.assert_contains(uidriver.get_body("/widgets"), "\"value\":0.8", "the progress bar follows")
            b.click("Slider to 0")
            b.assert_text("Slider: 0", "set from code")
            b.click("Read Slider")
            spec.assert_true(b.wait_for_console("slider reads 0"), "get_slider reads it")
        }
        spec.it("a text field read on demand") callback {
            b.set_field("hello")
            b.click("Read Entry")
            b.assert_text("Entry: hello", "read")
            b.click("Back to Home")
            b.assert_page(HOME, "200 ", "home")
        }
    }

    spec.describe(fw, "styles, the CSS-alike") {
        spec.it("kind, class and #id rules reach the platform") callback {
            b.click("Banking (styles)")
            b.assert_page("Current account", "200 ", "banking page")
            spec.assert_str_eq(b.style_of("text", "Current account", "fg"), "#6030bf", "header.label colour")
            spec.assert_str_eq(b.style_of("text", "Current account", "fontWeight"), "bold", "header.label weight")
            spec.assert_str_eq(b.style_of("text", "Balance: 1250 EUR", "fg"), "#224488", "#balance colour, as \"#rrggbb\"")
            spec.assert_str_eq(b.style_of("button", "Send", "fg"), "#5c458a", "button colour")
            spec.assert_str_eq(b.style_of("text", "Theme:", "fontFamily"), "monospace", "root font family")
        }
        spec.it("the browser's chrome is not styled") callback {
            spec.assert_str_eq(b.style_of("button", "Back", "fg"), "", "chrome Back")
            spec.assert_str_eq(b.style_of("textfield", "", "fontFamily"), "monospace", "the page's own field is")
            spec.assert_str_eq(b.style_of("text", b.status_line(), "fg"), "", "the status line")
        }
        spec.it("the page still works under its styles") callback {
            b.set_field("250")
            b.click("Send")
            b.assert_text("Balance: 1000 EUR", "sent")
            b.assert_text("Sent 250 EUR", "status")
            spec.assert_str_eq(b.style_of("text", "Balance: 1000 EUR", "fg"), "#224488", "set_text keeps the style")
        }
        spec.it("a new sheet restyles the page in place (Swiby's theme switch)") callback {
            b.pick(1)
            spec.assert_true(b.wait_for_console("theme green"), "picked green")
            spec.assert_str_eq(b.style_of("text", "Current account", "fg"), "#a3bf30", "header.label colour")
            spec.assert_true(string.equals(b.style_of("text", "Current account", "fontWeight"), "bold") == 0,
                "un-bolded")
            spec.assert_str_eq(b.style_of("text", "Balance: 1000 EUR", "fg"), "#406030", "#balance colour")
            spec.assert_str_eq(b.style_of("text", "Theme:", "fontFamily"), "serif", "root font family")
        }
        spec.it("styles go with the page") callback {
            b.click("Back to Home")
            b.assert_page(HOME, "200 ", "home")
            spec.assert_str_eq(b.style_of("text", HOME, "fg"), "", "home is unstyled")
            spec.assert_str_eq(b.style_of("text", HOME, "fontFamily"), "", "no family either")
        }
    }

    spec.describe(fw, "http, on Aether's actor core") {
        spec.it("GET and POST reach the page's own origin") callback {
            b.click("HTTP from a page")
            b.assert_page("HTTP from a page", "200 ", "http page")
            b.click("GET echo")
            b.assert_text("get: 200 echo: hello", "GET")
            b.click("POST echo")
            b.assert_text("post: 200 posted: a body", "POST")
        }
        spec.it("http.fetch: the same requests, awaited, refused the same way") callback {
            b.click("Fetch POST")
            b.assert_text("fetch: 200 posted: awaited body | other origin ok=false", "awaited POST, then a refusal as res.ok false")
        }
        spec.it("a redirect to another origin is answered only with that origin's consent") callback {
            b.click("Redirect away")
            b.assert_text("away: http://localhost:8091/api/json did not allow this page's origin http://127.0.0.1:8091: the response carries no Sae-Allow-Origin: http://127.0.0.1:8091 (or *)",
                "each hop checked as the first URL was; the final answer needs the CORS-alike's consent")
        }
        spec.it("res.json() parses the body") callback {
            b.click("GET json")
            b.assert_text("json: n=42, 3 items, last c", "parsed")
        }
        spec.it("the UI stays live while a request is out (it runs on an actor)") callback {
            b.click("Slow GET")
            b.assert_text("slow: waiting", "sent")
            b.click("Click me")
            b.click("Click me")
            b.assert_text("clicks: 2", "clicks handled during the request")
            b.assert_text("slow: waiting", "and the request is still out")
            b.assert_text("slow: 200 slow done", "then it lands")
        }
        spec.it("another origin without its consent is refused, through the callback") callback {
            b.click("Other origin")
            b.assert_text("refused: ok=false status=0 http://localhost:8091/api/echo?msg=other did not allow this page's origin http://127.0.0.1:8091: the response carries no Sae-Allow-Origin: http://127.0.0.1:8091 (or *)",
                "refused: ok false, status 0, the reason in res.error")
        }
        spec.it("req.cancel(): the callback never runs") callback {
            b.click("Slow, then cancel")
            spec.assert_contains(b.page_texts(), "cancel: request ", "the request object has an id")
            sleep(900)
            spec.assert_false(b.console_contains("a cancelled request's callback ran"), "not run")
        }
        spec.it("a reply for a page that has gone is dropped") callback {
            b.click("Slow, then leave")
            b.assert_page(HOME, "200 ", "left")
            sleep(1200)
            spec.assert_false(b.console_contains("this callback must not run"), "not run")
            b.assert_text(HOME, "and the browser is fine")
        }
    }

    spec.describe(fw, "vector graphics") {
        spec.it("draws, and a shape's on_click runs JS that repaints it") callback {
            b.click("Vector graphics")
            b.assert_page("Vector graphics", "200 ", "vg page")
            // The circle's centre is viewBox (30, 40) in a 100x100 viewBox.
            x = b.vg_px_x(30.0, 100.0, 100.0)
            y = b.vg_px_y(40.0, 100.0, 100.0)
            spec.assert_true(b.wait_for_vg_pixel(x, y, 0xcc4444), "circle draws red")
            b.vg_click(x, y)
            spec.assert_true(b.wait_for_vg_pixel(x, y, 0x33aa33), "clicked: green")
            spec.assert_true(b.wait_for_console("circle clicked at 30,40; 1 so far"),
                "the handler got viewBox coordinates")
            b.click("Blue circle")
            spec.assert_true(b.wait_for_vg_pixel(x, y, 0x3366cc), "vg.set_fill from a ui button: blue")
            go_home("home from vg")
        }
        spec.it("a vg shape outside vg.scene throws; earlier widgets stay") callback {
            b.click("Vector graphics misuse")
            b.assert_text("This page failed: see the console.", "failure notice")
            b.assert_text("Before the vg misuse", "before")
            b.assert_no_text("Never reached", "after")
            spec.assert_true(b.wait_for_console("vg.circle() must be called inside vg.scene()"),
                "console says why")
            b.back()
            b.assert_page(HOME, "200 ", "back")
        }
    }

    spec.describe(fw, "teardown") {
        spec.it("five round trips leave the widget census where it started") callback {
            baseline = b.widget_count()
            i = 0
            while i < 5 {
                b.click("About")
                b.assert_page("About", "200 ", "about")
                go_home("home")
                i = i + 1
            }
            spec.assert_true(b.wait_for_widget_count(baseline),
                "widget census back to the home page's (no leak)")
        }
        spec.it("a screenshot saves a PNG") callback {
            spec.assert_str_eq(b.screenshot("../target/spec_nav.png"), "", "screenshot")
        }
    }

    return spec.run_summary(fw)
}
