// spec_sheet.ae — demo 18, Spreadsheet: formulas typed through the formula
// bar or into a cell, an edit rippling downstream, a parse error that says
// where, a cycle found and mended, a paste in one batch, the function
// library, per-cell styles (numbers to the right, errors in red), the
// grid's keys and column resize, fill down and right, copy and paste within
// the sheet (formulas moving, $ fixing), Delete over a selection, and
// clearing. The page is site/sheet.ts;
// lower/tests/mod/sheet_*.ts test its model headless.
//
// The grid is ui.datagrid, read and clicked through tests/lib/griddriver.ae.
//
//   tests/run_spec.sh spec_sheet
import std.spec
import std.string
import std.json
import saedriver as b
import griddriver as g
import uidriver

const TRIES = 60
const POLL_MS = 50

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "spreadsheet (demo 18)") {
        spec.it("opens on an empty 10 x 20 grid with A1 selected") callback {
            b.navigate(b.test_url("/sheet"))
            b.assert_page("Spreadsheet", "200 ", "sheet page")
            spec.assert_true(b.wait_for_text("A1: (empty)"), "the status line")
            spec.assert_true(b.wait_for_text("No problems"), "the computed summary")
            spec.assert_gt(g.cell_id("A", 1), 0, "A1 is there")
            spec.assert_gt(g.cell_id("J", 20), 0, "and J20, the last")
            spec.assert_eq(g.cell_id("K", 1), 0, "and no column K")
            spec.assert_eq(string.length(g.cell_text("A", 1)), 0, "A1 is empty")
        }
        spec.it("formulas read the cells they name") callback {
            g.enter("A1", "2")
            spec.assert_true(b.wait_for_console("sheet: A1 = 2"), "A1 set")
            g.enter("B1", "=A1*10")
            g.enter("C1", "=B1+A1")
            spec.assert_true(b.wait_for_console("sheet: C1 = 22"), "C1 worked out")
            spec.assert_true(g.wait_cell("A", 1, "2"), "A1 shows 2")
            spec.assert_true(g.wait_cell("B", 1, "20"), "B1 shows 20")
            spec.assert_true(g.wait_cell("C", 1, "22"), "C1 shows 22")
            spec.assert_true(b.wait_for_text("C1: =B1+A1 → 22"), "the status line describes the cell entered")
        }
        spec.it("an edit ripples through everything downstream") callback {
            g.enter("A1", "5")
            spec.assert_true(g.wait_cell("B", 1, "50"), "B1 follows A1")
            spec.assert_true(g.wait_cell("C", 1, "55"), "and C1 follows both")
        }
        spec.it("clicking a cell puts its formula in the formula bar") callback {
            g.pick("B", 1)
            spec.assert_true(b.wait_for_text("B1: =A1*10 → 50"), "B1 described")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(g.formula_field()), "=A1*10"), 1, "the formula field holds what was typed")
        }
        spec.it("a parse error shows #ERROR!, in red, and says where in the formula") callback {
            g.enter("D1", "=SUM(A1")
            spec.assert_true(g.wait_cell("D", 1, "#ERROR!"), "D1 shows #ERROR!")
            spec.assert_eq(g.cell_has("D", 1, "\"fg\":\"#c0392b\""), 1, "in red")
            spec.assert_true(b.wait_for_text("D1: =SUM(A1 → #ERROR! parse error at 8: expected ')' but found the end"), "the status line says where")
            spec.assert_true(b.wait_for_text("1 problem"), "the summary counts it")
            spec.assert_true(b.wait_for_text("D1: #ERROR! parse error at 8: expected ')' but found the end"), "the problem list shows it")
            g.enter("D1", "=SUM(A1:C1)")
            spec.assert_true(g.wait_cell("D", 1, "110"), "mended, D1 sums the row")
            spec.assert_eq(g.cell_has("D", 1, "\"fg\":\"#c0392b\""), 0, "no longer red")
            spec.assert_true(b.wait_for_text("No problems"), "and the list empties")
        }
        spec.it("a cycle shows #CYCLE! in every cell on it, until it is broken") callback {
            g.enter("A2", "=B2")
            g.enter("B2", "=A2")
            spec.assert_true(g.wait_cell("A", 2, "#CYCLE!"), "A2")
            spec.assert_true(g.wait_cell("B", 2, "#CYCLE!"), "B2")
            spec.assert_true(b.wait_for_text("2 problems"), "two problems")
            spec.assert_true(b.wait_for_text("A2: #CYCLE! a circular reference: A2 → B2 → A2"), "the path, from A2")
            spec.assert_true(b.wait_for_text("B2: #CYCLE! a circular reference: B2 → A2 → B2"), "and from B2")
            g.enter("B2", "3")
            spec.assert_true(g.wait_cell("A", 2, "3"), "A2 reads B2 again")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
        }
        spec.it("a paste sets many cells in one batch; numbers sit to the right") callback {
            b.click("Paste example")
            spec.assert_true(b.wait_for_console("sheet: pasted the example: 24 cells set"), "24 cells")
            spec.assert_true(g.wait_cell("A", 1, "Item"), "A1 is the heading now")
            spec.assert_true(g.wait_cell("D", 2, "2.7"), "D2 = B2*C2")
            spec.assert_true(g.wait_cell("B", 5, "9"), "B5 sums the quantities")
            spec.assert_true(g.wait_cell("D", 5, "7.2"), "D5 sums the totals")
            spec.assert_true(g.wait_cell("D", 6, "0.8"), "D6 = ROUND(D5/B5, 2)")
            spec.assert_true(g.wait_cell("C", 1, "Price"), "C1's formula was pasted over")
            spec.assert_eq(g.cell_has("D", 5, "\"anchor\":\"end\""), 1, "a number at the right")
            spec.assert_eq(g.cell_has("A", 5, "\"anchor\":\"end\""), 0, "text at the left")
        }
        spec.it("the library's lookups, conditionals and error traps work on the example") callback {
            g.enter("E2", "=VLOOKUP(\"Bread\", A2:D4, 4, FALSE)")
            spec.assert_true(g.wait_cell("E", 2, "2.2"), "VLOOKUP finds Bread's total")
            g.enter("E3", "=COUNTIF(B2:B4, \">1\")")
            spec.assert_true(g.wait_cell("E", 3, "2"), "COUNTIF counts quantities over 1")
            g.enter("E4", "=IFERROR(D5/0, \"n/a\")")
            spec.assert_true(g.wait_cell("E", 4, "n/a"), "IFERROR traps a divide by zero")
            g.enter("B3", "4")
            spec.assert_true(g.wait_cell("E", 3, "3"), "COUNTIF follows an edit")
            spec.assert_true(g.wait_cell("E", 2, "8.8"), "and so does VLOOKUP, through D3")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
            spec.assert_true(string.contains(b.page_texts(), "Excel functions: ABS, AND, AVERAGE,") == 1, "the page lists its functions")
        }
        spec.it("a double click edits a cell in place, opening on its formula") callback {
            uidriver.post_ok("/widget/${g.cell_id("D", 2)}/double_click", "double-click D2")
            ed = g.editor()
            spec.assert_gt(ed, 0, "an editor opened")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(ed), "=B2*C2"), 1, "holding the formula, not 2.7")
            uidriver.post_ok("/widget/${ed}/set_text?v=%3DB2*C2*2", "type =B2*C2*2")
            uidriver.post_ok("/widget/${ed}/submit", "Return")
            spec.assert_true(b.wait_for_console("sheet: D2 = 5.4"), "the edit went through the sheet")
            spec.assert_true(g.wait_cell("D", 2, "5.4"), "D2 shows it")
            spec.assert_true(g.wait_cell("D", 5, "16.5"), "and D5 below, which sums it: 5.4 + 8.8 + 2.3")
        }
        spec.it("the grid's keys move the selection, and the formula bar follows") callback {
            g.pick("A", 1)
            spec.assert_true(b.wait_for_text("A1: Item → Item"), "A1")
            uidriver.post_ok("/window/key?combo=Right", "Right")
            spec.assert_true(b.wait_for_text("B1: Qty → Qty"), "Right: B1")
            uidriver.post_ok("/window/key?combo=Down", "Down")
            spec.assert_true(b.wait_for_text("B2: 6 → 6"), "Down: B2")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(g.formula_field()), "6"), 1, "the formula bar holds it")
        }
        spec.it("dragging a header's grip resizes its column") callback {
            g = g.grip_of("C")
            spec.assert_gt(g, 0, "C's grip")
            uidriver.post_ok("/widget/${g}/drag?x=3&y=8&dx=60&dy=0", "drag C's grip right")
            spec.assert_true(b.wait_for_console("sheet: column C is 140 wide"), "80 + 60")
        }
        spec.it("double-clicking a header's grip fits its column to its text") callback {
            // The label is the column less its 6 px grip; wait for the drag's
            // layout to land first.
            w0 = 0
            k = 0
            while k < TRIES && w0 < 130 {
                w0 = uidriver.widget_int_field_by_id(g.header_id("C"), "w")
                if w0 < 130 { sleep(POLL_MS) }
                k = k + 1
            }
            spec.assert_true(w0 >= 130, "C is 140 wide after the drag (its label ${w0})")
            uidriver.post_ok("/widget/${g.grip_of("C")}/double_click", "double-click C's grip")
            spec.assert_true(b.wait_for_console("sheet: column C is "), "the fit is a resize the page hears")
            w1 = w0
            i = 0
            while i < TRIES && w1 == w0 {
                w1 = uidriver.widget_int_field_by_id(g.header_id("C"), "w")
                if w1 == w0 { sleep(POLL_MS) }
                i = i + 1
            }
            spec.assert_true(w1 < w0, "narrower than 140: Price, 0.45, 2.2 ... are short (got ${w1})")
            spec.assert_true(w1 > 30, "but wide enough for them (got ${w1})")
        }
        spec.it("Ctrl+D fills a formula down, its references moving with it") callback {
            g.enter("F2", "=B2*2")
            spec.assert_true(g.wait_cell("F", 2, "12"), "F2 doubles B2")
            g.pick("F", 2)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Ctrl+D")
            spec.assert_true(b.wait_for_console("sheet: filled F2:F4 down: 2 cells set"), "F3 and F4 set in one go")
            spec.assert_true(g.wait_cell("F", 3, "8"), "F3 = B3*2")
            spec.assert_true(g.wait_cell("F", 4, "4"), "F4 = B4*2")
        }
        spec.it("Ctrl+R fills right") callback {
            g.pick("F", 2)
            g.key("Shift+Right")
            g.key("Ctrl+R")
            spec.assert_true(b.wait_for_console("sheet: filled F2:G2 right: 1 cells set"), "G2 set")
            spec.assert_true(g.wait_cell("G", 2, "0.9"), "G2 = C2*2")
        }
        spec.it("Ctrl+C and Ctrl+V copy within the sheet: relative references move, $ ones stay") callback {
            g.enter("H2", "=$B$2+C2")
            spec.assert_true(g.wait_cell("H", 2, "6.45"), "H2 = 6 + 0.45")
            g.pick("H", 2)
            g.key("Ctrl+C")
            spec.assert_true(b.wait_for_console("sheet: copied H2:H2"), "copied")
            g.pick("I", 4)
            g.key("Ctrl+V")
            spec.assert_true(b.wait_for_console("sheet: pasted at I4: 1 cells set"), "pasted")
            spec.assert_true(g.wait_cell("I", 4, "8.3"), "I4 = $B$2 + D4 = 6 + 2.3")
            spec.assert_true(b.wait_for_text("I4: =$B$2+D4 → 8.3"), "C2 moved one right and two down; $B$2 stayed")
        }
        spec.it("Delete clears the selection, but not while a field has the focus") callback {
            g.pick("F", 3)
            g.key("Shift+Down")
            uidriver.post_ok("/widget/${g.formula_field()}/focus", "focus the formula field")
            g.key("Delete")
            sleep(300)
            spec.assert_eq(b.console_contains("sheet: cleared F3:F4"), 0, "Delete in the field is the field's")
            spec.assert_true(g.wait_cell("F", 3, "8"), "F3 kept")
            g.pick("F", 3)
            g.key("Shift+Down")
            g.key("Delete")
            spec.assert_true(b.wait_for_console("sheet: cleared F3:F4: 2 cells set"), "both cleared")
            spec.assert_true(g.wait_cell("F", 3, ""), "F3 is empty")
            spec.assert_true(g.wait_cell("F", 4, ""), "F4 is empty")
            spec.assert_true(g.wait_cell("F", 2, "12"), "F2, outside the selection, kept")
        }
        spec.it("Ctrl+Z undoes a change and its ripple; Redo does it again") callback {
            g.enter("B4", "20")
            spec.assert_true(g.wait_cell("D", 4, "23"), "D4 = B4 * C4")
            g.pick("B", 4)
            g.key("Ctrl+Z")
            spec.assert_true(b.wait_for_console("sheet: undo:"), "undone")
            spec.assert_true(g.wait_cell("B", 4, "2"), "B4 back to 2")
            spec.assert_true(g.wait_cell("D", 4, "2.3"), "and D4 with it")
            b.click("Redo")
            spec.assert_true(g.wait_cell("D", 4, "23"), "redone")
            b.click("Undo")
            spec.assert_true(g.wait_cell("B", 4, "2"), "and undone by the button")
        }
        spec.it("Clear all empties the sheet") callback {
            g.pick("B", 2)
            b.click("Clear all")
            spec.assert_true(b.wait_for_console("sheet: cleared:"), "cleared")
            spec.assert_true(g.wait_cell("D", 5, ""), "D5 is empty")
            spec.assert_true(g.wait_cell("A", 1, ""), "A1 is empty")
            spec.assert_true(b.wait_for_text("B2: (empty)"), "the status line follows the selected cell, B2")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
        }
        spec.it("RexxJS formulas: the Tauri app's budget opens, its setup script's TAX_RATE in every tax") callback {
            b.click("Budget (RexxJS)")
            spec.assert_true(b.wait_for_console("sheet: opened Sample Budget: 20 cells, RexxJS formulas"), "opened")
            spec.assert_true(b.wait_for_text("RexxJS formulas"), "the setting says so")
            spec.assert_true(g.wait_cell("C", 2, "96"), "C2 = B2 * TAX_RATE")
            spec.assert_true(g.wait_cell("D", 6, "1404"), "D6 = SUM_RANGE(\"D2:D4\")")
            spec.assert_true(b.wait_for_text("Setup script: -- Budget spreadsheet setup"), "its setup script")
            g.pick("A", 1)
            spec.assert_true(b.wait_for_text("A1: Item → Item (Item name)"), "a cell's comment, from the file")
        }
        spec.it("RexxJS formulas: edits ripple; || joins, |> pipes, > compares; an error says why") callback {
            g.enter("B2", "1000")
            spec.assert_true(g.wait_cell("C", 2, "80"), "tax follows the price")
            spec.assert_true(g.wait_cell("D", 6, "1188"), "and the total below")
            g.enter("E2", "=UPPER(A2) || '!'")
            spec.assert_true(g.wait_cell("E", 2, "LAPTOP!"), "||")
            g.enter("E3", "=A3 |> LOWER")
            spec.assert_true(g.wait_cell("E", 3, "mouse"), "|>")
            g.enter("E4", "=B2 > 500")
            spec.assert_true(g.wait_cell("E", 4, "1"), "a comparison")
            g.enter("E5", "=1/0")
            spec.assert_true(g.wait_cell("E", 5, "#ERROR!"), "an error")
            spec.assert_true(b.wait_for_text("E5: =1/0 → #ERROR! Division by zero"), "why")
        }
        spec.it("the setting: the same formulas read as Excel fail, and read as RexxJS again") callback {
            b.click("Excel formulas")
            spec.assert_true(b.wait_for_console("sheet: Excel formulas"), "switched")
            spec.assert_true(g.wait_cell("C", 2, "#NAME?"), "B2 * TAX_RATE: Excel has no name TAX_RATE")
            spec.assert_true(g.wait_cell("D", 2, "#NAME?"), "and what reads it")
            b.click("RexxJS formulas")
            spec.assert_true(b.wait_for_console("sheet: RexxJS formulas"), "back")
            spec.assert_true(g.wait_cell("C", 2, "80"), "C2 again")
            spec.assert_true(g.wait_cell("D", 6, "1188"), "and D6")
        }
        spec.it("the app's formatted sheet: number formats, styles, and conditional styles in RexxJS") callback {
            b.click("Formatted (RexxJS)")
            spec.assert_true(b.wait_for_console("sheet: opened Formatted Spreadsheet Example: 50 cells"), "opened")
            spec.assert_true(g.wait_cell("C", 4, "$1,000.00"), "C4 in $#,##0.00")
            spec.assert_true(g.wait_cell("C", 5, "-$150.50"), "C5, negative")
            spec.assert_true(g.wait_cell("D", 12, "$3,998.75"), "D12, the final balance")
            spec.assert_true(g.wait_cell("G", 4, "85.00%"), "G4 in 0.00%")
            spec.assert_eq(g.cell_has("C", 5, "\"fg\":\"#d32f2f\""), 1, "C5 < 0: STYLE_IF gives RED_TEXT()")
            spec.assert_eq(g.cell_has("C", 6, "\"fg\":\"#388e3c\""), 1, "C6 >= 0: GREEN_TEXT()")
            spec.assert_eq(g.cell_has("A", 3, "\"fg\":\"#000000\""), 1, "A3 bold, black")
            spec.assert_eq(g.cell_has("G", 10, "\"fg\":\"#0d47a1\""), 1, "G10: STYLE(...)'s colour")
        }
        spec.it("a conditional style follows an edit; a format and a comment are set by hand") callback {
            g.enter("C6", "-5")
            spec.assert_true(g.wait_cell("C", 6, "-$5.00"), "C6 is negative now")
            spec.assert_eq(g.cell_has("C", 6, "\"fg\":\"#d32f2f\""), 1, "and red, as STYLE_IF says")
            g.pick("D", 12)
            b.set_field_by("format", "number:0")
            uidriver.post_ok("/widget/${g.field("format")}/submit", "Return in the format field")
            spec.assert_true(g.wait_cell("D", 12, "1494"), "D12 in number:0 (3998.75 - 2505)")
            b.set_field_by("comment", "what is left")
            uidriver.post_ok("/widget/${g.field("comment")}/submit", "Return in the comment field")
            spec.assert_true(b.wait_for_text("D12: =D9 → 1493.75 (what is left)"), "the comment on the status line")
        }
        spec.it("Insert row moves the ledger down, formulas, formats and conditional styles with it; Delete row takes it back") callback {
            g.pick("A", 5)
            b.click("Insert row")
            spec.assert_true(b.wait_for_console("sheet: inserted 1 row at 5:"), "inserted")
            spec.assert_true(g.wait_cell("D", 6, "$849.50"), "D5 is D6 now, formatted")
            spec.assert_true(g.wait_cell("B", 5, ""), "an empty row where it was")
            spec.assert_eq(g.cell_has("C", 6, "\"fg\":\"#d32f2f\""), 1, "C6 (was C5) still red: its STYLE_IF moved with it")
            g.pick("D", 6)
            spec.assert_true(b.wait_for_text("D6: =D4 + C6 → 849.5"), "its formula reads its row")
            g.pick("A", 5)
            b.click("Delete row")
            spec.assert_true(b.wait_for_console("sheet: deleted 1 row at 5:"), "deleted")
            spec.assert_true(g.wait_cell("D", 5, "$849.50"), "D5 again")
            spec.assert_true(g.wait_cell("D", 12, "1494"), "and the final balance where it was, in its number:0")
        }
        spec.it("Sort Z→A orders the selection's rows by the cursor's column, formats and conditional styles with them") callback {
            g.pick("F", 4)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Right")
            b.click("Sort Z→A")
            spec.assert_true(b.wait_for_console("sheet: sorted F4:G7 by G, descending"), "sorted")
            spec.assert_true(g.wait_cell("F", 4, "Product C"), "92% first")
            spec.assert_true(g.wait_cell("G", 4, "92.00%"), "in its format")
            spec.assert_true(g.wait_cell("F", 7, "Product B"), "45% last")
            g.pick("A", 1)   // the selection blends into a cell's background
            spec.assert_eq(g.cell_has("G", 7, "\"bg\":\"#ffebee\""), 1, "G7, under 50%, red: its STYLE_IF moved and reads its row")
            spec.assert_eq(g.cell_has("G", 4, "\"bg\":\"#e8f5e9\""), 1, "G4 green")
        }
        spec.it("Find lists and selects the matches; Replace all changes them, as one undo") callback {
            b.set_field_by("find", "product")
            b.click("Find")
            spec.assert_true(b.wait_for_console("sheet: find product: F4 F5 F6 F7"), "four, any case")
            spec.assert_true(b.wait_for_text("4 found: F4, F5, F6, F7"), "said")
            b.set_field_by("replace with", "Item")
            b.click("Replace all")
            spec.assert_true(g.wait_cell("F", 4, "Item C"), "replaced")
            spec.assert_true(g.wait_cell("F", 7, "Item B"), "every one")
            g.pick("F", 4)
            g.key("Ctrl+Z")
            spec.assert_true(g.wait_cell("F", 7, "Product B"), "one undo puts them all back")
        }
        spec.it("the command bar runs any command as the panels do, and says why when it cannot") callback {
            g.command("cell.set cell=J1 input=\"=2*21\"")
            spec.assert_true(b.wait_for_console("sheet: J1 = 42"), "run")
            spec.assert_true(g.wait_cell("J", 1, "42"), "J1 shows it")
            g.command("rows.delete at=99")
            spec.assert_true(b.wait_for_console("sheet: refused: 99 is not a row on the sheet"), "refused")
            spec.assert_true(b.wait_for_text("99 is not a row on the sheet"), "on the status line")
            g.command("cell.get cell=G4")
            spec.assert_true(b.wait_for_text("G4 = 0.92 → \"0.92\""), "an output shows below the bar")
        }
        spec.it("a RexxJS script drives the sheet through ADDRESS SHEET, SETCELL and GETCELL") callback {
            g.script("ADDRESS SHEET \"cell.set cell=J2 input=5\"; LET r = SETCELL(\"J3\", \"=J2 * 3\"); SAY \"J3 is\" GETCELL(\"J3\")")
            spec.assert_true(b.wait_for_console("sheet: say J3 is 15"), "SAY")
            spec.assert_true(g.wait_cell("J", 3, "15"), "J3 set by SETCELL")
            spec.assert_true(g.wait_cell("J", 2, "5"), "J2 by ADDRESS SHEET")
            g.pick("J", 2)
            g.key("Ctrl+Z")
            spec.assert_true(g.wait_cell("J", 3, ""), "a script's changes undo as commands do")
        }
        spec.it("Name the selection names a range; a formula reads it; the Name Box goes to it") callback {
            g.pick("C", 4)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            b.set_field_by("name", "amounts")
            b.click("Name the selection")
            spec.assert_true(b.wait_for_console("sheet: AMOUNTS is C4:C9"), "named")
            spec.assert_true(b.wait_for_text("AMOUNTS = C4:C9"), "listed")
            g.enter("J4", "=SUM_RANGE(\"amounts\")")
            spec.assert_true(g.wait_cell("J", 4, "1493.75"), "a RexxJS formula reads it")
            g.enter("C9", "1801")
            spec.assert_true(g.wait_cell("J", 4, "1494.75"), "and follows its cells")
            b.set_field_by("cell", "amounts")
            uidriver.post_ok("/widget/${g.field("cell")}/submit", "Return in the address field")
            spec.assert_true(b.wait_for_text("AMOUNTS is C4:C9"), "the Name Box goes to it")
        }
        spec.it("Fill series, AutoSum and Paste values, from the edit bar") callback {
            g.enter("A14", "Mon")
            g.enter("B14", "1")
            g.enter("B15", "2")
            g.pick("A", 14)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Right")
            b.click("Fill series")
            spec.assert_true(b.wait_for_console("sheet: filled A14:B18 as a series"), "filled")
            spec.assert_true(g.wait_cell("A", 18, "Fri"), "Mon to Fri")
            spec.assert_true(g.wait_cell("B", 18, "5"), "1, 2 ... 5")
            g.pick("B", 19)
            b.click("AutoSum")
            spec.assert_true(g.wait_cell("B", 19, "15"), "AutoSum of the numbers above")
            spec.assert_true(b.wait_for_text("B19: =SUM_RANGE(\"B14:B18\") → 15"), "in RexxJS formulas, SUM_RANGE")
            g.key("Ctrl+C")
            g.pick("C", 19)
            b.click("Paste values")
            spec.assert_true(b.wait_for_text("C19: 15 → 15"), "the value, not the formula")
        }
        spec.it("a validation rule refuses what breaks it; Circle invalid marks what got past") callback {
            g.pick("H", 14)
            g.key("Shift+Down")
            b.set_field_by("allowed", "1..10")
            b.click("Allow whole numbers")
            spec.assert_true(b.wait_for_console("sheet: H14:H15 must be a whole number from 1 to 10"), "set")
            g.enter("H14", "50")
            spec.assert_true(b.wait_for_console("sheet: refused: H14 must be a whole number from 1 to 10"), "refused")
            spec.assert_true(b.wait_for_text("H14 must be a whole number from 1 to 10"), "and said")
            spec.assert_true(g.wait_cell("H", 14, ""), "the cell keeps what it had")
            g.enter("H14", "7")
            spec.assert_true(g.wait_cell("H", 14, "7"), "a whole number in range is kept")
            g.command("cell.set cell=J9 input=99")
            g.command("edit.copy range=J9")
            g.command("edit.paste at=H15")
            b.click("Circle invalid")
            spec.assert_true(b.wait_for_console("sheet: 1 invalid: H15"), "a paste got past it; circled")
            g.pick("A", 1)
            spec.assert_eq(g.cell_has("H", 15, "\"bg\":\"#ffd6d6\""), 1, "marked")
        }
        spec.it("sheets as tabs: a formula reads another sheet, follows it, and is #REF! when it goes") callback {
            b.set_field_by("sheet", "Costs")
            b.click("Add sheet")
            spec.assert_true(b.wait_for_console("sheet: added Costs"), "added")
            spec.assert_true(b.wait_for_text("On Costs:"), "and on it")
            spec.assert_true(g.wait_cell("D", 12, ""), "an empty sheet")
            g.enter("B2", "100")
            b.click("Sheet1")
            spec.assert_true(b.wait_for_console("sheet: Sheet1"), "back")
            spec.assert_true(g.wait_cell("J", 4, "1494.75"), "Sheet1's cells")
            g.enter("J10", "=Costs_B2 * 2")
            spec.assert_true(g.wait_cell("J", 10, "200"), "Costs_B2, in RexxJS formulas")
            b.click("Costs")
            g.enter("B2", "21")
            b.click("Sheet1")
            spec.assert_true(g.wait_cell("J", 10, "42"), "follows it")
            b.click("Costs")
            b.click("Delete sheet")
            spec.assert_true(b.wait_for_console("sheet: deleted Costs"), "deleted")
            spec.assert_true(b.wait_for_text("On Sheet1:"), "on Sheet1 again")
            spec.assert_true(g.wait_cell("J", 10, "#REF!"), "what read it is #REF!")
        }
        spec.it("Save keeps the workbook in the page's storage; New empties it; Open brings it back") callback {
            b.set_field_by("file name", "Spec book")
            b.click("Save")
            spec.assert_true(b.wait_for_console("sheet: saved Spec book: 1 sheet, "), "saved")
            spec.assert_true(b.wait_for_text("saved: Spec book"), "listed")
            b.click("New")
            spec.assert_true(b.wait_for_console("sheet: a new workbook"), "new")
            spec.assert_true(g.wait_cell("J", 4, ""), "empty")
            b.click("Open")
            spec.assert_true(b.wait_for_console("sheet: opened Spec book: "), "opened")
            spec.assert_true(g.wait_cell("J", 4, "1494.75"), "its formulas, worked out")
            spec.assert_true(g.wait_cell("C", 4, "$1,000.00"), "its formats")
            spec.assert_eq(g.cell_has("C", 5, "\"fg\":\"#d32f2f\""), 1, "its conditional styles")
        }
        spec.it("CSV: imported at the selected cell, and exported from the selection") callback {
            b.set_field_by("CSV", "x,\"y, z\"")
            g.pick("H", 17)
            b.click("Import CSV")
            spec.assert_true(b.wait_for_console("sheet: imported 1 rows at H17"), "imported")
            spec.assert_true(g.wait_cell("I", 17, "y, z"), "a quoted field")
            g.key("Shift+Right")
            b.click("Export CSV")
            spec.assert_true(b.wait_for_text("x,\"y, z\""), "exported, quoted again")
        }
        spec.it("auditing: trace precedents and dependents, Show formulas, Evaluate formula, a watch") callback {
            b.click("Excel formulas")
            g.enter("H18", "2")
            g.enter("I18", "=H18*21")
            g.enter("J18", "=SUM(H18:I18)")
            g.pick("J", 18)
            b.click("Trace precedents")
            spec.assert_true(b.wait_for_console("sheet: J18 reads H18 I18"), "traced")
            spec.assert_eq(g.cell_has("I", 18, "\"bg\":\"#dbe9ff\""), 1, "what it reads, in blue")
            b.click("Evaluate formula")
            spec.assert_true(b.wait_for_text("J18: SUM(H18:I18) → SUM({2,42}) → 44"), "the steps")
            b.click("Add watch")
            spec.assert_true(b.wait_for_text("Watch Sheet1!J18: =SUM(H18:I18) = 44"), "watched")
            g.pick("H", 18)
            b.click("Trace dependents")
            spec.assert_true(b.wait_for_console("sheet: H18 is read by I18 J18"), "dependents")
            spec.assert_eq(g.cell_has("J", 18, "\"bg\":\"#ffe3c2\""), 1, "in orange")
            b.click("Remove arrows")
            g.enter("H18", "3")
            spec.assert_true(b.wait_for_text("Watch Sheet1!J18: =SUM(H18:I18) = 66"), "the watch follows")
            b.click("Show formulas")
            spec.assert_true(g.wait_cell("I", 18, "=H18*21"), "formulas shown")
            b.click("Show formulas")
            spec.assert_true(g.wait_cell("I", 18, "63"), "values again")
            b.click("Unwatch Sheet1!J18")
            spec.assert_true(b.wait_for_text_gone("Watch Sheet1!J18: =SUM(H18:I18) = 66"), "unwatched")
        }
        spec.it("conditional formatting rules over the selection; an Excel number format's colour") callback {
            g.pick("B", 14)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            b.set_field_by("rule value", "3")
            b.click("Greater than")
            spec.assert_true(b.wait_for_console("sheet: B14:B18: cell value > 3"), "a rule")
            b.click("Icon set")
            spec.assert_true(b.wait_for_text("1. B14:B18: cell value > 3; 2. B14:B18: icon set arrows"), "listed")
            spec.assert_true(g.wait_cell("B", 18, "↑ 5"), "an icon in the text")
            g.pick("A", 1)
            spec.assert_eq(g.cell_has("B", 18, "\"bg\":\"#ffc7ce\""), 1, "over 3: Excel's light red")
            spec.assert_eq(g.cell_has("B", 15, "\"bg\":\"#ffc7ce\""), 0, "2 is not")
            g.pick("B", 14)
            b.set_field_by("format", "0.00;[Red]-0.00")
            uidriver.post_ok("/widget/${g.field("format")}/submit", "Return in the format field")
            g.enter("B14", "-1")
            spec.assert_true(g.wait_cell("B", 14, "↓ -1.00"), "the format's negative section, after the icon")
            g.pick("A", 1)
            spec.assert_eq(g.cell_has("B", 14, "\"fg\":\"#ff0000\""), 1, "in its [Red]")
            g.pick("B", 14)
            g.key("Shift+Down")
            b.click("Clear rules")
            spec.assert_true(b.wait_for_console("sheet: cleared 2 rules"), "cleared")
            spec.assert_true(g.wait_cell("B", 18, "5"), "no icon")
        }
        spec.it("a chart of the selection, drawn in vg, follows its cells; a sparkline in a cell") callback {
            g.pick("A", 15)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Right")
            b.click("Bar chart")
            spec.assert_true(b.wait_for_console("sheet: inserted a bar chart of A15:B17"), "inserted")
            spec.assert_true(b.wait_for_text("Chart 1: bar chart of A15:B17"), "listed")
            spec.assert_true(string.contains(b.vg_nodes(), "\"text\":\"Tue\"") == 1, "its categories drawn")
            spec.assert_true(string.contains(b.vg_nodes(), "\"fill\":\"#4472c4\"") == 1, "its bars, in the palette")
            g.enter("B17", "40")
            spec.assert_true(b.wait_for_console("sheet: B17 = 40"), "an edit")
            spec.assert_true(string.contains(b.vg_nodes(), "\"text\":\"40\"") == 1, "the scale follows it")
            g.pick("B", 15)
            g.key("Shift+Down")
            g.key("Shift+Down")
            b.click("Sparkline")
            spec.assert_true(g.wait_cell("C", 15, "▁▁█"), "a sparkline beside it")
            b.click("Delete chart 1")
            spec.assert_true(b.wait_for_text_gone("Chart 1: bar chart of A15:B17"), "deleted")
        }
        spec.it("a dynamic array spills, is #SPILL! while something is in the way, and spills again when it is cleared") callback {
            g.enter("F14", "=SEQUENCE(3)*2")
            spec.assert_true(g.wait_cell("F", 16, "6"), "spilled into F15:F16")
            g.enter("G14", "=SUM(F14#)")
            spec.assert_true(g.wait_cell("G", 14, "12"), "F14# is all of it")
            g.enter("F15", "x")
            spec.assert_true(g.wait_cell("F", 14, "#SPILL!"), "in the way")
            spec.assert_true(g.wait_cell("F", 16, ""), "the spill gone")
            g.command("cell.set cell=F15 input=\"\"")
            spec.assert_true(g.wait_cell("F", 16, "6"), "spilled again")
            spec.assert_true(g.wait_cell("G", 14, "12"), "and read again")
        }
        spec.it("Goal seek, Text to columns and Remove duplicates from the data bar") callback {
            g.enter("I2", "1")
            g.enter("I3", "=I2*I2+2*I2")
            g.pick("I", 3)
            b.set_field_by("goal", "15")
            b.set_field_by("by changing", "I2")
            b.click("Goal seek")
            spec.assert_true(b.wait_for_console("sheet: I3 = 15 with I2 = 3"), "sought")
            spec.assert_true(g.wait_cell("I", 2, "3"), "the input changed")
            g.enter("I5", "p;q")
            g.pick("I", 5)
            b.set_field_by("delimiter", ";")
            b.click("Text to columns")
            spec.assert_true(g.wait_cell("J", 5, "q"), "split into J5")
            spec.assert_true(g.wait_cell("I", 5, "p"), "the first part in place")
            g.enter("I6", "a")
            g.enter("I7", "A")
            g.enter("I8", "b")
            g.pick("I", 6)
            g.key("Shift+Down")
            g.key("Shift+Down")
            b.click("Remove duplicates")
            spec.assert_true(b.wait_for_console("sheet: removed 1 duplicate row of I6:I8; 2 left"), "removed")
            spec.assert_true(g.wait_cell("I", 7, "b"), "the rest moved up")
        }
        spec.it("a cell's look: Ctrl+I, Underline, borders, wrapped text, a comment's corner and tooltip, data bars") callback {
            g.enter("A20", "look")
            g.pick("A", 20)
            g.key("Ctrl+I")
            spec.assert_true(b.wait_for_console("sheet: A20: italic"), "Ctrl+I")
            b.click("Underline")
            b.click("Outline borders")
            spec.assert_true(b.wait_for_console("sheet: A20: outline borders"), "outlined")
            g.pick("B", 20)
            spec.assert_eq(g.cell_has("A", 20, "\"fontStyle\":\"italic\""), 1, "italic")
            spec.assert_eq(g.cell_has("A", 20, "\"textDecoration\":\"underline\""), 1, "underlined")
            spec.assert_eq(g.cell_has("A", 20, "\"borderTop\":"), 1, "a top border")
            g.pick("C", 20)
            b.set_field_by("comment", "noted")
            uidriver.post_ok("/widget/${g.field("comment")}/submit", "Return in the comment field")
            spec.assert_true(b.wait_for_console("sheet: C20 comment noted"), "commented")
            spec.assert_eq(g.cell_has("C", 20, "\"tooltip\":\"noted\""), 1, "its tooltip")
            spec.assert_eq(g.cell_has("C", 20, "\"corner\":"), 1, "its corner marker")
            // A wrapped row is taller, so the grid shows fewer rows: row 20 last.
            g.enter("B20", "a long line of text that wraps in its cell")
            g.pick("B", 20)
            b.click("Wrap text")
            spec.assert_true(b.wait_for_console("sheet: B20: wrapped"), "wrapped")
            g.pick("B", 15)
            g.key("Shift+Down")
            g.key("Shift+Down")
            b.click("Data bars")
            spec.assert_true(b.wait_for_console("sheet: B15:B17: data bars #638ec6"), "data bars")
            g.pick("A", 1)
            spec.assert_eq(g.cell_has("B", 17, "\"bar\":"), 1, "a bar drawn")
        }
        spec.it("rows and columns out of view: a filter, hidden columns, a frozen row") callback {
            g.enter("D14", "n")
            g.enter("D15", "5")
            g.enter("D16", "50")
            g.enter("D17", "500")
            g.pick("D", 14)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Shift+Down")
            b.set_field_by("filter by", ">10")
            b.click("Filter")
            spec.assert_true(b.wait_for_console("sheet: filtered D14:D17 by D >10: 1 row hidden"), "filtered")
            spec.assert_true(g.wait_cell("D", 15, ""), "row 15's cells show nothing")
            spec.assert_true(g.wait_cell("D", 16, "50"), "row 16 is still there")
            b.click("Clear filter")
            spec.assert_true(g.wait_cell("D", 15, "5"), "back")
            g.goto("I2")
            b.click("Hide columns")
            spec.assert_true(b.wait_for_console("sheet: hid column I"), "hid I")
            spec.assert_true(g.wait_cell("I", 2, ""), "I2 shows nothing")
            // As in Excel: select across the hidden column to unhide it.
            g.goto("H2")
            g.pick("H", 2)
            g.key("Shift+Right")
            b.click("Unhide columns")
            spec.assert_true(b.wait_for_console("sheet: showed columns H to J"), "unhid H to J")
            spec.assert_true(g.wait_cell("I", 2, "3"), "I2 again")
            g.goto("C1")
            b.click("Freeze top row")
            spec.assert_true(b.wait_for_console("sheet: froze 1 row"), "froze")
            spec.assert_contains(uidriver.get_body("/widget/${g.cell_id("C", 1)}"), "aui-grid-frozen", "row 1 frozen")
            b.click("Unfreeze")
            spec.assert_true(b.wait_for_console("sheet: unfroze rows"), "unfroze")
        }
    }
    return spec.run_summary(fw)
}
