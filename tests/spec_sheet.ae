// spec_sheet.ae — demo 18, Spreadsheet: formulas typed through the formula
// bar or into a cell, an edit rippling downstream, a parse error that says
// where, a cycle found and mended, a paste in one batch, the function
// library, per-cell styles (numbers to the right, errors in red), the
// grid's keys and column resize, and clearing. The page is site/sheet.ts;
// lower/tests/mod/sheet_*.ts test its model headless.
//
// The grid is ui.datagrid: a cell is the aui-grid-cell widget under its
// column's header (aui-grid-header) and beside its row's number
// (aui-grid-frozen), read and clicked through the driver's widget tree.
//
//   tests/run_spec.sh spec_sheet
import std.spec
import std.string
import std.json
import saedriver as b
import uidriver

const TRIES = 60
const POLL_MS = 50

has_class_(w: ptr, c: string) -> int { return string.contains(uidriver.field_str(w, "classes"), c) }

// The widget id of the cell at column `col` ("A".."J") and row `row` (1..20),
// or 0.
cell_id(col: string, row: int) -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    n = json.json_array_size(v)
    cx = 0 - 1
    cy = 0 - 1
    i = 0
    while i < n {
        w = json.json_array_get_raw(v, i)
        t = uidriver.field_str(w, "text")
        if has_class_(w, "aui-grid-header") == 1 && string.equals(t, col) == 1 {
            cx = uidriver.field_int(w, "x") + uidriver.field_int(w, "w") / 2
        }
        if has_class_(w, "aui-grid-frozen") == 1 && string.equals(t, "${row}") == 1 {
            cy = uidriver.field_int(w, "y") + uidriver.field_int(w, "h") / 2
        }
        i = i + 1
    }
    id = 0
    if cx >= 0 && cy >= 0 {
        i = 0
        while i < n {
            w = json.json_array_get_raw(v, i)
            if has_class_(w, "aui-grid-cell") == 1 {
                x = uidriver.field_int(w, "x")
                y = uidriver.field_int(w, "y")
                if cx >= x && cx < x + uidriver.field_int(w, "w") && cy >= y && cy < y + uidriver.field_int(w, "h") {
                    id = uidriver.field_int(w, "id")
                }
            }
            i = i + 1
        }
    }
    json.json_free(v)
    return id
}

cell_text(col: string, row: int) -> string { return uidriver.widget_text_by_id(cell_id(col, row)) }

// 1 once the cell reads `want`.
wait_cell(col: string, row: int, want: string) -> int {
    i = 0
    while i < TRIES {
        if string.equals(cell_text(col, row), want) == 1 { return 1 }
        sleep(POLL_MS)
        i = i + 1
    }
    return 0
}

// A field of the cell's widget as the driver reports it ("fg", "anchor").
cell_has(col: string, row: int, what: string) -> int {
    return string.contains(uidriver.get_body("/widget/${cell_id(col, row)}"), what)
}

pick(col: string, row: int) { uidriver.post_ok("/widget/${cell_id(col, row)}/click", "click ${col}${row}") }

// The formula field is the last text field the page made; Return in it enters.
formula_field() -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "placeholder"), "formula") == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

enter(cell: string, formula: string) {
    b.set_field_by("cell", cell)
    b.set_field_by("formula", formula)
    uidriver.post_ok("/widget/${formula_field()}/submit", "Return in the formula field")
}

// The editor a double click opens over a cell: the newest text field that is
// neither the address bar nor one of the page's two.
editor() -> int {
    bar = uidriver.widget_id_of("textfield", "")
    ff = formula_field()
    i = 0
    while i < 30 {
        last = uidriver.widget_id_last_of("textfield", "")
        if last != bar && last != ff && last > ff { return last }
        sleep(100)
        i = i + 1
    }
    return 0
}

// The resize grip of column `col`'s header.
grip_of(col: string) -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    parent = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if has_class_(w, "aui-grid-header") == 1 && string.equals(uidriver.field_str(w, "text"), col) == 1 { parent = uidriver.field_int(w, "parent") }
        i = i + 1
    }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if uidriver.field_int(w, "parent") == parent && has_class_(w, "aui-grid-grip") == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "spreadsheet (demo 18)") {
        spec.it("opens on an empty 10 x 20 grid with A1 selected") callback {
            b.navigate(b.test_url("/sheet"))
            b.assert_page("Spreadsheet", "200 ", "sheet page")
            spec.assert_true(b.wait_for_text("A1: (empty)"), "the status line")
            spec.assert_true(b.wait_for_text("No problems"), "the computed summary")
            spec.assert_gt(cell_id("A", 1), 0, "A1 is there")
            spec.assert_gt(cell_id("J", 20), 0, "and J20, the last")
            spec.assert_eq(cell_id("K", 1), 0, "and no column K")
            spec.assert_eq(string.length(cell_text("A", 1)), 0, "A1 is empty")
        }
        spec.it("formulas read the cells they name") callback {
            enter("A1", "2")
            spec.assert_true(b.wait_for_console("sheet: A1 = 2"), "A1 set")
            enter("B1", "=A1*10")
            enter("C1", "=B1+A1")
            spec.assert_true(b.wait_for_console("sheet: C1 = 22"), "C1 worked out")
            spec.assert_true(wait_cell("A", 1, "2"), "A1 shows 2")
            spec.assert_true(wait_cell("B", 1, "20"), "B1 shows 20")
            spec.assert_true(wait_cell("C", 1, "22"), "C1 shows 22")
            spec.assert_true(b.wait_for_text("C1: =B1+A1 → 22"), "the status line describes the cell entered")
        }
        spec.it("an edit ripples through everything downstream") callback {
            enter("A1", "5")
            spec.assert_true(wait_cell("B", 1, "50"), "B1 follows A1")
            spec.assert_true(wait_cell("C", 1, "55"), "and C1 follows both")
        }
        spec.it("clicking a cell puts its formula in the formula bar") callback {
            pick("B", 1)
            spec.assert_true(b.wait_for_text("B1: =A1*10 → 50"), "B1 described")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(formula_field()), "=A1*10"), 1, "the formula field holds what was typed")
        }
        spec.it("a parse error shows #ERROR!, in red, and says where in the formula") callback {
            enter("D1", "=SUM(A1")
            spec.assert_true(wait_cell("D", 1, "#ERROR!"), "D1 shows #ERROR!")
            spec.assert_eq(cell_has("D", 1, "\"fg\":\"#c0392b\""), 1, "in red")
            spec.assert_true(b.wait_for_text("D1: =SUM(A1 → #ERROR! parse error at 8: expected ')' but found the end"), "the status line says where")
            spec.assert_true(b.wait_for_text("1 problem"), "the summary counts it")
            spec.assert_true(b.wait_for_text("D1: #ERROR! parse error at 8: expected ')' but found the end"), "the problem list shows it")
            enter("D1", "=SUM(A1:C1)")
            spec.assert_true(wait_cell("D", 1, "110"), "mended, D1 sums the row")
            spec.assert_eq(cell_has("D", 1, "\"fg\":\"#c0392b\""), 0, "no longer red")
            spec.assert_true(b.wait_for_text("No problems"), "and the list empties")
        }
        spec.it("a cycle shows #CYCLE! in every cell on it, until it is broken") callback {
            enter("A2", "=B2")
            enter("B2", "=A2")
            spec.assert_true(wait_cell("A", 2, "#CYCLE!"), "A2")
            spec.assert_true(wait_cell("B", 2, "#CYCLE!"), "B2")
            spec.assert_true(b.wait_for_text("2 problems"), "two problems")
            spec.assert_true(b.wait_for_text("A2: #CYCLE! a circular reference: A2 → B2 → A2"), "the path, from A2")
            spec.assert_true(b.wait_for_text("B2: #CYCLE! a circular reference: B2 → A2 → B2"), "and from B2")
            enter("B2", "3")
            spec.assert_true(wait_cell("A", 2, "3"), "A2 reads B2 again")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
        }
        spec.it("a paste sets many cells in one batch; numbers sit to the right") callback {
            b.click("Paste example")
            spec.assert_true(b.wait_for_console("sheet: pasted the example: 24 cells set"), "24 cells")
            spec.assert_true(wait_cell("A", 1, "Item"), "A1 is the heading now")
            spec.assert_true(wait_cell("D", 2, "2.7"), "D2 = B2*C2")
            spec.assert_true(wait_cell("B", 5, "9"), "B5 sums the quantities")
            spec.assert_true(wait_cell("D", 5, "7.2"), "D5 sums the totals")
            spec.assert_true(wait_cell("D", 6, "0.8"), "D6 = ROUND(D5/B5, 2)")
            spec.assert_true(wait_cell("C", 1, "Price"), "C1's formula was pasted over")
            spec.assert_eq(cell_has("D", 5, "\"anchor\":\"end\""), 1, "a number at the right")
            spec.assert_eq(cell_has("A", 5, "\"anchor\":\"end\""), 0, "text at the left")
        }
        spec.it("the library's lookups, conditionals and error traps work on the example") callback {
            enter("E2", "=VLOOKUP(\"Bread\", A2:D4, 4, FALSE)")
            spec.assert_true(wait_cell("E", 2, "2.2"), "VLOOKUP finds Bread's total")
            enter("E3", "=COUNTIF(B2:B4, \">1\")")
            spec.assert_true(wait_cell("E", 3, "2"), "COUNTIF counts quantities over 1")
            enter("E4", "=IFERROR(D5/0, \"n/a\")")
            spec.assert_true(wait_cell("E", 4, "n/a"), "IFERROR traps a divide by zero")
            enter("B3", "4")
            spec.assert_true(wait_cell("E", 3, "3"), "COUNTIF follows an edit")
            spec.assert_true(wait_cell("E", 2, "8.8"), "and so does VLOOKUP, through D3")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
            spec.assert_true(string.contains(b.page_texts(), "Functions: ABS, AND, AVERAGE,") == 1, "the page lists its functions")
        }
        spec.it("a double click edits a cell in place, opening on its formula") callback {
            uidriver.post_ok("/widget/${cell_id("D", 2)}/double_click", "double-click D2")
            ed = editor()
            spec.assert_gt(ed, 0, "an editor opened")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(ed), "=B2*C2"), 1, "holding the formula, not 2.7")
            uidriver.post_ok("/widget/${ed}/set_text?v=%3DB2*C2*2", "type =B2*C2*2")
            uidriver.post_ok("/widget/${ed}/submit", "Return")
            spec.assert_true(b.wait_for_console("sheet: D2 = 5.4"), "the edit went through the sheet")
            spec.assert_true(wait_cell("D", 2, "5.4"), "D2 shows it")
            spec.assert_true(wait_cell("D", 5, "16.5"), "and D5 below, which sums it: 5.4 + 8.8 + 2.3")
        }
        spec.it("the grid's keys move the selection, and the formula bar follows") callback {
            pick("A", 1)
            spec.assert_true(b.wait_for_text("A1: Item → Item"), "A1")
            uidriver.post_ok("/window/key?combo=Right", "Right")
            spec.assert_true(b.wait_for_text("B1: Qty → Qty"), "Right: B1")
            uidriver.post_ok("/window/key?combo=Down", "Down")
            spec.assert_true(b.wait_for_text("B2: 6 → 6"), "Down: B2")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(formula_field()), "6"), 1, "the formula bar holds it")
        }
        spec.it("dragging a header's grip resizes its column") callback {
            g = grip_of("C")
            spec.assert_gt(g, 0, "C's grip")
            uidriver.post_ok("/widget/${g}/drag?x=3&y=8&dx=60&dy=0", "drag C's grip right")
            spec.assert_true(b.wait_for_console("sheet: column C is 140 wide"), "80 + 60")
        }
        spec.it("Clear all empties the sheet") callback {
            b.click("Clear all")
            spec.assert_true(b.wait_for_console("sheet: cleared:"), "cleared")
            spec.assert_true(wait_cell("D", 5, ""), "D5 is empty")
            spec.assert_true(wait_cell("A", 1, ""), "A1 is empty")
            spec.assert_true(b.wait_for_text("B2: (empty)"), "the status line follows the selected cell, B2")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
        }
    }
    return spec.run_summary(fw)
}
