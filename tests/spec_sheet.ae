// spec_sheet.ae — demo 18, Spreadsheet: formulas typed through the formula
// bar or into a cell, an edit rippling downstream, a parse error that says
// where, a cycle found and mended, a paste in one batch, the function
// library, per-cell styles (numbers to the right, errors in red), the
// grid's keys and column resize, fill down and right, copy and paste within
// the sheet (formulas moving, $ fixing), Delete over a selection, and
// clearing. The page is site/sheet.ts;
// lower/tests/mod/sheet_*.ts test its model headless.
//
// The grid is ui.datagrid, read and clicked through tests/lib/griddriver.ae.
//
//   tests/run_spec.sh spec_sheet
import std.spec
import std.string
import std.json
import saedriver as b
import griddriver as g
import uidriver

const TRIES = 60
const POLL_MS = 50

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "spreadsheet (demo 18)") {
        spec.it("opens on an empty 10 x 20 grid with A1 selected") callback {
            b.navigate(b.test_url("/sheet"))
            b.assert_page("Spreadsheet", "200 ", "sheet page")
            spec.assert_true(b.wait_for_text("A1: (empty)"), "the status line")
            spec.assert_true(b.wait_for_text("No problems"), "the computed summary")
            spec.assert_gt(g.cell_id("A", 1), 0, "A1 is there")
            spec.assert_gt(g.cell_id("J", 20), 0, "and J20, the last")
            spec.assert_eq(g.cell_id("K", 1), 0, "and no column K")
            spec.assert_eq(string.length(g.cell_text("A", 1)), 0, "A1 is empty")
        }
        spec.it("formulas read the cells they name") callback {
            g.enter("A1", "2")
            spec.assert_true(b.wait_for_console("sheet: A1 = 2"), "A1 set")
            g.enter("B1", "=A1*10")
            g.enter("C1", "=B1+A1")
            spec.assert_true(b.wait_for_console("sheet: C1 = 22"), "C1 worked out")
            spec.assert_true(g.wait_cell("A", 1, "2"), "A1 shows 2")
            spec.assert_true(g.wait_cell("B", 1, "20"), "B1 shows 20")
            spec.assert_true(g.wait_cell("C", 1, "22"), "C1 shows 22")
            spec.assert_true(b.wait_for_text("C1: =B1+A1 → 22"), "the status line describes the cell entered")
        }
        spec.it("an edit ripples through everything downstream") callback {
            g.enter("A1", "5")
            spec.assert_true(g.wait_cell("B", 1, "50"), "B1 follows A1")
            spec.assert_true(g.wait_cell("C", 1, "55"), "and C1 follows both")
        }
        spec.it("clicking a cell puts its formula in the formula bar") callback {
            g.pick("B", 1)
            spec.assert_true(b.wait_for_text("B1: =A1*10 → 50"), "B1 described")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(g.formula_field()), "=A1*10"), 1, "the formula field holds what was typed")
        }
        spec.it("a parse error shows #ERROR!, in red, and says where in the formula") callback {
            g.enter("D1", "=SUM(A1")
            spec.assert_true(g.wait_cell("D", 1, "#ERROR!"), "D1 shows #ERROR!")
            spec.assert_eq(g.cell_has("D", 1, "\"fg\":\"#c0392b\""), 1, "in red")
            spec.assert_true(b.wait_for_text("D1: =SUM(A1 → #ERROR! parse error at 8: expected ')' but found the end"), "the status line says where")
            spec.assert_true(b.wait_for_text("1 problem"), "the summary counts it")
            spec.assert_true(b.wait_for_text("D1: #ERROR! parse error at 8: expected ')' but found the end"), "the problem list shows it")
            g.enter("D1", "=SUM(A1:C1)")
            spec.assert_true(g.wait_cell("D", 1, "110"), "mended, D1 sums the row")
            spec.assert_eq(g.cell_has("D", 1, "\"fg\":\"#c0392b\""), 0, "no longer red")
            spec.assert_true(b.wait_for_text("No problems"), "and the list empties")
        }
        spec.it("a cycle shows #CYCLE! in every cell on it, until it is broken") callback {
            g.enter("A2", "=B2")
            g.enter("B2", "=A2")
            spec.assert_true(g.wait_cell("A", 2, "#CYCLE!"), "A2")
            spec.assert_true(g.wait_cell("B", 2, "#CYCLE!"), "B2")
            spec.assert_true(b.wait_for_text("2 problems"), "two problems")
            spec.assert_true(b.wait_for_text("A2: #CYCLE! a circular reference: A2 → B2 → A2"), "the path, from A2")
            spec.assert_true(b.wait_for_text("B2: #CYCLE! a circular reference: B2 → A2 → B2"), "and from B2")
            g.enter("B2", "3")
            spec.assert_true(g.wait_cell("A", 2, "3"), "A2 reads B2 again")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
        }
        spec.it("a paste sets many cells in one batch; numbers sit to the right") callback {
            b.click("Paste example")
            spec.assert_true(b.wait_for_console("sheet: pasted the example: 24 cells set"), "24 cells")
            spec.assert_true(g.wait_cell("A", 1, "Item"), "A1 is the heading now")
            spec.assert_true(g.wait_cell("D", 2, "2.7"), "D2 = B2*C2")
            spec.assert_true(g.wait_cell("B", 5, "9"), "B5 sums the quantities")
            spec.assert_true(g.wait_cell("D", 5, "7.2"), "D5 sums the totals")
            spec.assert_true(g.wait_cell("D", 6, "0.8"), "D6 = ROUND(D5/B5, 2)")
            spec.assert_true(g.wait_cell("C", 1, "Price"), "C1's formula was pasted over")
            spec.assert_eq(g.cell_has("D", 5, "\"anchor\":\"end\""), 1, "a number at the right")
            spec.assert_eq(g.cell_has("A", 5, "\"anchor\":\"end\""), 0, "text at the left")
        }
        spec.it("the library's lookups, conditionals and error traps work on the example") callback {
            g.enter("E2", "=VLOOKUP(\"Bread\", A2:D4, 4, FALSE)")
            spec.assert_true(g.wait_cell("E", 2, "2.2"), "VLOOKUP finds Bread's total")
            g.enter("E3", "=COUNTIF(B2:B4, \">1\")")
            spec.assert_true(g.wait_cell("E", 3, "2"), "COUNTIF counts quantities over 1")
            g.enter("E4", "=IFERROR(D5/0, \"n/a\")")
            spec.assert_true(g.wait_cell("E", 4, "n/a"), "IFERROR traps a divide by zero")
            g.enter("B3", "4")
            spec.assert_true(g.wait_cell("E", 3, "3"), "COUNTIF follows an edit")
            spec.assert_true(g.wait_cell("E", 2, "8.8"), "and so does VLOOKUP, through D3")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
            spec.assert_true(string.contains(b.page_texts(), "Excel functions: ABS, AND, AVERAGE,") == 1, "the page lists its functions")
        }
        spec.it("a double click edits a cell in place, opening on its formula") callback {
            uidriver.post_ok("/widget/${g.cell_id("D", 2)}/double_click", "double-click D2")
            ed = g.editor()
            spec.assert_gt(ed, 0, "an editor opened")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(ed), "=B2*C2"), 1, "holding the formula, not 2.7")
            uidriver.post_ok("/widget/${ed}/set_text?v=%3DB2*C2*2", "type =B2*C2*2")
            uidriver.post_ok("/widget/${ed}/submit", "Return")
            spec.assert_true(b.wait_for_console("sheet: D2 = 5.4"), "the edit went through the sheet")
            spec.assert_true(g.wait_cell("D", 2, "5.4"), "D2 shows it")
            spec.assert_true(g.wait_cell("D", 5, "16.5"), "and D5 below, which sums it: 5.4 + 8.8 + 2.3")
        }
        spec.it("the grid's keys move the selection, and the formula bar follows") callback {
            g.pick("A", 1)
            spec.assert_true(b.wait_for_text("A1: Item → Item"), "A1")
            uidriver.post_ok("/window/key?combo=Right", "Right")
            spec.assert_true(b.wait_for_text("B1: Qty → Qty"), "Right: B1")
            uidriver.post_ok("/window/key?combo=Down", "Down")
            spec.assert_true(b.wait_for_text("B2: 6 → 6"), "Down: B2")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(g.formula_field()), "6"), 1, "the formula bar holds it")
        }
        spec.it("dragging a header's grip resizes its column") callback {
            g = g.grip_of("C")
            spec.assert_gt(g, 0, "C's grip")
            uidriver.post_ok("/widget/${g}/drag?x=3&y=8&dx=60&dy=0", "drag C's grip right")
            spec.assert_true(b.wait_for_console("sheet: column C is 140 wide"), "80 + 60")
        }
        spec.it("double-clicking a header's grip fits its column to its text") callback {
            // The label is the column less its 6 px grip; wait for the drag's
            // layout to land first.
            w0 = 0
            k = 0
            while k < TRIES && w0 < 130 {
                w0 = uidriver.widget_int_field_by_id(g.header_id("C"), "w")
                if w0 < 130 { sleep(POLL_MS) }
                k = k + 1
            }
            spec.assert_true(w0 >= 130, "C is 140 wide after the drag (its label ${w0})")
            uidriver.post_ok("/widget/${g.grip_of("C")}/double_click", "double-click C's grip")
            spec.assert_true(b.wait_for_console("sheet: column C is "), "the fit is a resize the page hears")
            w1 = w0
            i = 0
            while i < TRIES && w1 == w0 {
                w1 = uidriver.widget_int_field_by_id(g.header_id("C"), "w")
                if w1 == w0 { sleep(POLL_MS) }
                i = i + 1
            }
            spec.assert_true(w1 < w0, "narrower than 140: Price, 0.45, 2.2 ... are short (got ${w1})")
            spec.assert_true(w1 > 30, "but wide enough for them (got ${w1})")
        }
        spec.it("Ctrl+D fills a formula down, its references moving with it") callback {
            g.enter("F2", "=B2*2")
            spec.assert_true(g.wait_cell("F", 2, "12"), "F2 doubles B2")
            g.pick("F", 2)
            g.key("Shift+Down")
            g.key("Shift+Down")
            g.key("Ctrl+D")
            spec.assert_true(b.wait_for_console("sheet: filled F2:F4 down: 2 cells set"), "F3 and F4 set in one go")
            spec.assert_true(g.wait_cell("F", 3, "8"), "F3 = B3*2")
            spec.assert_true(g.wait_cell("F", 4, "4"), "F4 = B4*2")
        }
        spec.it("Ctrl+R fills right") callback {
            g.pick("F", 2)
            g.key("Shift+Right")
            g.key("Ctrl+R")
            spec.assert_true(b.wait_for_console("sheet: filled F2:G2 right: 1 cells set"), "G2 set")
            spec.assert_true(g.wait_cell("G", 2, "0.9"), "G2 = C2*2")
        }
        spec.it("Ctrl+C and Ctrl+V copy within the sheet: relative references move, $ ones stay") callback {
            g.enter("H2", "=$B$2+C2")
            spec.assert_true(g.wait_cell("H", 2, "6.45"), "H2 = 6 + 0.45")
            g.pick("H", 2)
            g.key("Ctrl+C")
            spec.assert_true(b.wait_for_console("sheet: copied H2:H2"), "copied")
            g.pick("I", 4)
            g.key("Ctrl+V")
            spec.assert_true(b.wait_for_console("sheet: pasted at I4: 1 cells set"), "pasted")
            spec.assert_true(g.wait_cell("I", 4, "8.3"), "I4 = $B$2 + D4 = 6 + 2.3")
            spec.assert_true(b.wait_for_text("I4: =$B$2+D4 → 8.3"), "C2 moved one right and two down; $B$2 stayed")
        }
        spec.it("Delete clears the selection, but not while a field has the focus") callback {
            g.pick("F", 3)
            g.key("Shift+Down")
            uidriver.post_ok("/widget/${g.formula_field()}/focus", "focus the formula field")
            g.key("Delete")
            sleep(300)
            spec.assert_eq(b.console_contains("sheet: cleared F3:F4"), 0, "Delete in the field is the field's")
            spec.assert_true(g.wait_cell("F", 3, "8"), "F3 kept")
            g.pick("F", 3)
            g.key("Shift+Down")
            g.key("Delete")
            spec.assert_true(b.wait_for_console("sheet: cleared F3:F4: 2 cells set"), "both cleared")
            spec.assert_true(g.wait_cell("F", 3, ""), "F3 is empty")
            spec.assert_true(g.wait_cell("F", 4, ""), "F4 is empty")
            spec.assert_true(g.wait_cell("F", 2, "12"), "F2, outside the selection, kept")
        }
        spec.it("Ctrl+Z undoes a change and its ripple; Redo does it again") callback {
            g.enter("B4", "20")
            spec.assert_true(g.wait_cell("D", 4, "23"), "D4 = B4 * C4")
            g.pick("B", 4)
            g.key("Ctrl+Z")
            spec.assert_true(b.wait_for_console("sheet: undo:"), "undone")
            spec.assert_true(g.wait_cell("B", 4, "2"), "B4 back to 2")
            spec.assert_true(g.wait_cell("D", 4, "2.3"), "and D4 with it")
            b.click("Redo")
            spec.assert_true(g.wait_cell("D", 4, "23"), "redone")
            b.click("Undo")
            spec.assert_true(g.wait_cell("B", 4, "2"), "and undone by the button")
        }
        spec.it("Clear all empties the sheet") callback {
            g.pick("B", 2)
            b.click("Clear all")
            spec.assert_true(b.wait_for_console("sheet: cleared:"), "cleared")
            spec.assert_true(g.wait_cell("D", 5, ""), "D5 is empty")
            spec.assert_true(g.wait_cell("A", 1, ""), "A1 is empty")
            spec.assert_true(b.wait_for_text("B2: (empty)"), "the status line follows the selected cell, B2")
            spec.assert_true(b.wait_for_text("No problems"), "no problems")
        }
        spec.it("RexxJS formulas: the Tauri app's budget opens, its setup script's TAX_RATE in every tax") callback {
            b.click("Budget (RexxJS)")
            spec.assert_true(b.wait_for_console("sheet: opened Sample Budget: 20 cells, RexxJS formulas"), "opened")
            spec.assert_true(b.wait_for_text("RexxJS formulas"), "the setting says so")
            spec.assert_true(g.wait_cell("C", 2, "96"), "C2 = B2 * TAX_RATE")
            spec.assert_true(g.wait_cell("D", 6, "1404"), "D6 = SUM_RANGE(\"D2:D4\")")
            spec.assert_true(b.wait_for_text("Setup script: -- Budget spreadsheet setup"), "its setup script")
            g.pick("A", 1)
            spec.assert_true(b.wait_for_text("A1: Item → Item (Item name)"), "a cell's comment, from the file")
        }
        spec.it("RexxJS formulas: edits ripple; || joins, |> pipes, > compares; an error says why") callback {
            g.enter("B2", "1000")
            spec.assert_true(g.wait_cell("C", 2, "80"), "tax follows the price")
            spec.assert_true(g.wait_cell("D", 6, "1188"), "and the total below")
            g.enter("E2", "=UPPER(A2) || '!'")
            spec.assert_true(g.wait_cell("E", 2, "LAPTOP!"), "||")
            g.enter("E3", "=A3 |> LOWER")
            spec.assert_true(g.wait_cell("E", 3, "mouse"), "|>")
            g.enter("E4", "=B2 > 500")
            spec.assert_true(g.wait_cell("E", 4, "1"), "a comparison")
            g.enter("E5", "=1/0")
            spec.assert_true(g.wait_cell("E", 5, "#ERROR!"), "an error")
            spec.assert_true(b.wait_for_text("E5: =1/0 → #ERROR! Division by zero"), "why")
        }
        spec.it("the setting: the same formulas read as Excel fail, and read as RexxJS again") callback {
            b.click("Excel formulas")
            spec.assert_true(b.wait_for_console("sheet: Excel formulas"), "switched")
            spec.assert_true(g.wait_cell("C", 2, "#ERROR!"), "B2 * TAX_RATE is not Excel")
            spec.assert_true(g.wait_cell("D", 2, "#ERROR!"), "and what reads it")
            b.click("RexxJS formulas")
            spec.assert_true(b.wait_for_console("sheet: RexxJS formulas"), "back")
            spec.assert_true(g.wait_cell("C", 2, "80"), "C2 again")
            spec.assert_true(g.wait_cell("D", 6, "1188"), "and D6")
        }
    }
    return spec.run_summary(fw)
}
