// griddriver.ae — verbs for a page built on ui.datagrid with a formula bar
// (site/sheet.ts), on saedriver and aether-ui's uidriver.
//
// A cell is the aui-grid-cell widget under its column's header
// (aui-grid-header) and beside its row's number (aui-grid-frozen), read and
// clicked through the driver's widget tree. The formula bar is two fields,
// placeholders "cell" and "formula"; Return in the formula field enters.

exports(
    cell_id, cell_text, wait_cell, cell_has, pick, goto, formula_field, enter, editor,
    header_id, grip_of, key, field, command, script
)

import std.string
import std.json
import saedriver as b
import uidriver

const TRIES = 60
const POLL_MS = 50

has_class_(w: ptr, c: string) -> int { return string.contains(uidriver.field_str(w, "classes"), c) }

// The widget id of the cell at column `col` ("A".."J") and row `row` (1..20),
// or 0 when it is not shown: the cell whose column header (a11y_header, the
// header widget's id) reads `col` and whose row (a11y_row, the model row
// from 1) is `row`, as the grid tells assistive technology (a frozen row's
// cells are aui-grid-frozen rather than aui-grid-cell). Frozen, hidden,
// taller and moved rows and columns do not change it.
cell_id(col: string, row: int) -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    n = json.json_array_size(v)
    header = 0
    i = 0
    while i < n {
        w = json.json_array_get_raw(v, i)
        if has_class_(w, "aui-grid-header") == 1 && string.equals(uidriver.field_str(w, "text"), col) == 1 { header = uidriver.field_int(w, "id") }
        i = i + 1
    }
    id = 0
    if header > 0 {
        i = 0
        while i < n {
            w = json.json_array_get_raw(v, i)
            if (has_class_(w, "aui-grid-cell") == 1 || has_class_(w, "aui-grid-frozen") == 1) && uidriver.field_int(w, "a11y_header") == header && uidriver.field_int(w, "a11y_row") == row {
                id = uidriver.field_int(w, "id")
            }
            i = i + 1
        }
    }
    json.json_free(v)
    return id
}

cell_text(col: string, row: int) -> string { return uidriver.widget_text_by_id(cell_id(col, row)) }

// 1 once the cell reads `want`.
wait_cell(col: string, row: int, want: string) -> int {
    i = 0
    while i < TRIES {
        if string.equals(cell_text(col, row), want) == 1 { return 1 }
        sleep(POLL_MS)
        i = i + 1
    }
    return 0
}

// A field of the cell's widget as the driver reports it ("fg", "anchor").
cell_has(col: string, row: int, what: string) -> int {
    return string.contains(uidriver.get_body("/widget/${cell_id(col, row)}"), what)
}

pick(col: string, row: int) { uidriver.post_ok("/widget/${cell_id(col, row)}/click", "click ${col}${row}") }

// The formula field is the last text field the page made; Return in it enters.
formula_field() -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "placeholder"), "formula") == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

enter(cell: string, formula: string) {
    b.set_field_by("cell", cell)
    b.set_field_by("formula", formula)
    uidriver.post_ok("/widget/${formula_field()}/submit", "Return in the formula field")
}

// A cell selected through the address field (the Name Box), as a person
// goes to one that may be scrolled out of view: the grid brings it in.
goto(cell: string) {
    b.set_field_by("cell", cell)
    uidriver.post_ok("/widget/${field("cell")}/submit", "Return in the address field")
}

// The editor a double click opens over a cell: the newest text field with
// no placeholder, made after every field the page has (each of which has
// one: cell, formula, comment, format), or 0 once it does not appear.
editor() -> int {
    i = 0
    while i < 30 {
        id = newest_bare_field_()
        if id > 0 { return id }
        sleep(100)
        i = i + 1
    }
    return 0
}

newest_bare_field_() -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    page = 0
    bare = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "type"), "textfield") == 1 {
            id = uidriver.field_int(w, "id")
            if string.length(uidriver.field_str(w, "placeholder")) > 0 {
                if id > page { page = id }
            } else if id > bare {
                bare = id
            }
        }
        i = i + 1
    }
    json.json_free(v)
    if page > 0 && bare > page { return bare }
    return 0
}

// The header label of column `col`.
header_id(col: string) -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if has_class_(w, "aui-grid-header") == 1 && string.equals(uidriver.field_str(w, "text"), col) == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

// The resize grip of column `col`'s header.
grip_of(col: string) -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    parent = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if has_class_(w, "aui-grid-header") == 1 && string.equals(uidriver.field_str(w, "text"), col) == 1 { parent = uidriver.field_int(w, "parent") }
        i = i + 1
    }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if uidriver.field_int(w, "parent") == parent && has_class_(w, "aui-grid-grip") == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

key(combo: string) { uidriver.post_ok("/window/key?combo=${b.url_encode(combo)}", combo) }

// The page's text field with this placeholder, or 0.
field(placeholder: string) -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "placeholder"), placeholder) == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

// A command line run through the page's command bar ("command" field,
// Return), as a person would type it: the seam under the panels.
command(line: string) {
    b.set_field_by("command", line)
    uidriver.post_ok("/widget/${field("command")}/submit", "Return in the command bar")
}

// A RexxJS script run through the command bar ("RexxJS script" field, the
// Run script button); ';' ends a clause.
script(text: string) {
    b.set_field_by("RexxJS script", text)
    b.click("Run script")
}

