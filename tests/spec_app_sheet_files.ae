// spec_app_sheet_files.ae — demo 18 run as an installed app (site/app.json):
// files the person picks, through documents. Headless, so each picker takes
// the answer the spec queued.
//   AETHER_UI_HEADLESS=1 SAE_TEST_APP=site tests/run_spec.sh spec_app_sheet_files
import std.spec
import std.string
import std.fs
import std.os (os_getenv)
import saedriver as b
import griddriver as g
import uidriver

tmp_dir() -> string {
    t = os_getenv("TMPDIR")
    if t == null { return "/tmp" }
    while string.ends_with(t, "/") == 1 { t = string.substring(t, 0, string.length(t) - 1) }
    return t
}

main() {
    fw = spec.init()
    uidriver.wait_server()
    dir = "${tmp_dir()}/sae-sheet-files"
    _m = fs.mkdir_p(dir)
    _w1 = fs.write("${dir}/book.json", "{\"name\": \"Spec book\", \"formulas\": \"excel\", \"cells\": {\"A1\": \"2\", \"B1\": {\"content\": \"=A1*21\"}}}")
    _w2 = fs.write("${dir}/more.csv", "7,8\n9,10\n")
    _d1 = fs.delete("${dir}/saved.json")
    _d2 = fs.delete("${dir}/out.csv")
    spec.describe(fw, "demo 18 as an app: files the person picks") {
        spec.it("Open file reads a workbook in the Tauri app's format") callback {
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened Spec book: 2 cells, Excel formulas"), "opened")
            spec.assert_true(g.wait_cell("B", 1, "42"), "its formula worked out")
        }
        spec.it("Save file writes the workbook where the person chose") callback {
            uidriver.answer_prompt("save", "${dir}/saved.json")
            b.click("Save file")
            spec.assert_true(b.wait_for_console("sheet: saved saved.json"), "saved")
            body, _e = fs.read("${dir}/saved.json")
            spec.assert_contains(body, "\"name\":\"Spec book\"", "the workbook's name")
            spec.assert_contains(body, "\"expression\":\"A1*21\"", "and its formula")
            spec.assert_contains(uidriver.prompts(), "\"default_name\":\"Spec book.json\"", "the name suggested")
        }
        spec.it("Export CSV file writes what the sheet shows") callback {
            uidriver.answer_prompt("save", "${dir}/out.csv")
            b.click("Export CSV file")
            spec.assert_true(b.wait_for_console("sheet: exported out.csv"), "exported")
            body, _e = fs.read("${dir}/out.csv")
            spec.assert_contains(body, "2,42", "the values")
        }
        spec.it("Open file reads a CSV file in at the selected cell") callback {
            g.pick("D", 3)
            uidriver.answer_prompt("open", "${dir}/more.csv")
            b.click("Open file")
            spec.assert_true(g.wait_cell("E", 4, "10"), "at D3")
        }
        spec.it("a cancelled picker changes nothing") callback {
            uidriver.answer_prompt("open", "")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "still the same workbook")
        }
    }
    return spec.run_summary(fw)
}
