// spec_rexxsheet.ae — demo 19, RexxSheet: the Tauri spreadsheet's model,
// RexxJS adapter and function library on sae, under a ui.datagrid view.
// It opens on the app's test sheet; formulas are RexxJS expressions; edits
// ripple; errors say why, in red; a cycle is #CIRCULAR!; an editor opens on
// the formula; the budget sheet's setup script defines TAX_RATE for its
// cells. The page is site/rexxsheet.ts; lower/tests/mod/rexxsheet_*.ts test
// its model and view headless.
//
//   tests/run_spec.sh spec_rexxsheet
import std.spec
import std.string
import saedriver as b
import griddriver as g
import uidriver

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "RexxSheet (demo 19)") {
        spec.it("opens on the app's test sheet, every formula worked out by RexxJS") callback {
            b.navigate(b.test_url("/rexxsheet"))
            b.assert_page("RexxSheet", "200 ", "rexxsheet page")
            spec.assert_true(b.wait_for_console("rexxsheet: loaded Test Sheet: 10 cells"), "loaded")
            spec.assert_true(g.wait_cell("A", 4, "30"), "A4 = A1 + A2")
            spec.assert_true(g.wait_cell("A", 5, "60"), "A5 = SUM_RANGE(\"A1:A3\")")
            spec.assert_true(g.wait_cell("B", 2, "HELLO"), "B2 = UPPER(B1)")
            spec.assert_true(g.wait_cell("C", 3, "15"), "C3 = C1 * C2")
            spec.assert_true(b.wait_for_text("A1: 10 → 10 (Plain number)"), "the status line, with the file's comment")
            spec.assert_true(b.wait_for_text("Setup script: -- Simple test spreadsheet for development"), "and its setup script")
        }
        spec.it("an edit ripples through everything that reads it") callback {
            g.enter("A1", "100")
            spec.assert_true(b.wait_for_console("rexxsheet: A1 = 100"), "A1 set")
            spec.assert_true(g.wait_cell("A", 4, "120"), "A4 follows")
            spec.assert_true(g.wait_cell("A", 5, "150"), "and A5")
        }
        spec.it("formulas are RexxJS: || joins, |> pipes") callback {
            g.enter("D1", "=UPPER(B1) || '!'")
            spec.assert_true(g.wait_cell("D", 1, "HELLO!"), "D1")
            g.enter("D2", "=B1 |> LOWER")
            spec.assert_true(g.wait_cell("D", 2, "hello"), "D2")
            spec.assert_eq(g.cell_has("A", 4, "\"anchor\":\"end\""), 1, "numbers sit to the right")
            spec.assert_eq(g.cell_has("D", 1, "\"anchor\":\"end\""), 0, "text to the left")
        }
        spec.it("an error is #ERROR!, in red, and the status line says why") callback {
            g.enter("D3", "=1/0")
            spec.assert_true(g.wait_cell("D", 3, "#ERROR!"), "D3")
            spec.assert_eq(g.cell_has("D", 3, "\"fg\":\"#c0392b\""), 1, "in red")
            spec.assert_true(b.wait_for_text("D3: =1/0 → #ERROR! Division by zero"), "why")
        }
        spec.it("a cycle is #CIRCULAR! until it is broken") callback {
            g.enter("E1", "=E2")
            g.enter("E2", "=E1 + 1")
            spec.assert_true(g.wait_cell("E", 1, "#CIRCULAR!"), "E1")
            spec.assert_true(g.wait_cell("E", 2, "#CIRCULAR!"), "E2")
            spec.assert_true(b.wait_for_text("E2: =E1 + 1 → #CIRCULAR! Circular reference: E2 → E1 → E2"), "the route")
            g.enter("E2", "7")
            spec.assert_true(g.wait_cell("E", 1, "7"), "mended")
        }
        spec.it("a double click edits a cell in place, opening on its formula") callback {
            uidriver.post_ok("/widget/${g.cell_id("A", 4)}/double_click", "double-click A4")
            ed = g.editor()
            spec.assert_gt(ed, 0, "an editor opened")
            spec.assert_eq(string.equals(uidriver.widget_text_by_id(ed), "=A1 + A2"), 1, "holding the formula, not 120")
            uidriver.post_ok("/widget/${ed}/set_text?v=%3DA1%20*%202", "type =A1 * 2")
            uidriver.post_ok("/widget/${ed}/submit", "Return")
            spec.assert_true(b.wait_for_console("rexxsheet: A4 = 200"), "the edit went through the model")
            spec.assert_true(g.wait_cell("A", 4, "200"), "A4 shows it")
        }
        spec.it("the budget sheet's setup script defines TAX_RATE for its cells") callback {
            b.click("Budget")
            spec.assert_true(b.wait_for_console("rexxsheet: loaded Sample Budget: 20 cells"), "loaded")
            spec.assert_true(g.wait_cell("C", 2, "96"), "C2 = B2 * TAX_RATE")
            spec.assert_true(g.wait_cell("D", 6, "1404"), "D6 sums the totals")
            spec.assert_true(g.wait_cell("A", 5, ""), "the test sheet's cells are gone")
            spec.assert_true(b.wait_for_text("Setup script: -- Budget spreadsheet setup"), "its setup script")
            g.enter("B2", "1000")
            spec.assert_true(g.wait_cell("C", 2, "80"), "tax follows the price")
            spec.assert_true(g.wait_cell("D", 6, "1188"), "and the total below")
        }
    }
    return spec.run_summary(fw)
}
