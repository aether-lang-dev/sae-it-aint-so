// lower: the sae page dialect to the JavaScript QuickJS (sae's engine) runs.
//
// The dialect is TypeScript restricted to `--erasableSyntaxOnly`, over
// modern JavaScript (ES2023: classes, async/await, generators, destructuring,
// spread, optional chaining, ...), which QuickJS runs as written. Lowering
// never re-prints the program. It tokenizes, parses the grammar enough to
// know what each token is, and erases the TypeScript by overwriting it with
// spaces (the ts-blank-space approach), so every line AND column stays where
// the author wrote it. Nothing else is rewritten.
//
// It also holds a page to what it may name: the "seeks" lines at its top
// unlock fs, http and shell, and a "hide" at the top of a function takes
// names away from it (docs/app-capabilities.md).
//
// The one rewrite that is not an erasure: a static `import` or `export`
// statement becomes a call on `$sae`, the loader object the host hands the
// page (README, "Modules"), and a unit that imports, exports or awaits at
// its top level is wrapped in one function expression (its first line gets
// a prefix, its last a suffix) so the host can call it with that object.
// The line count still holds.
//
// Refused, each with an error naming line and column: the TypeScript that
// is not erasable (enum, namespace, parameter properties), decorators,
// import.meta, export in a page, top-level await in a module.

import std.string
import std.strbuilder
import std.strarr
import std.mem

exports (lower_source, lower_module, page_seeks, page_optional, page_scopes, page_imports, page_wrapped, LOWER_VERSION)

extern malloc(n: long) -> ptr
extern realloc(p: ptr, n: long) -> ptr
extern free(p: ptr)

// Part of sae's bytecode cache key: bump it whenever output changes.
const LOWER_VERSION = "lower-4"

// ---------------------------------------------------------------------------
// A growable int vector.

struct IVec {
    data: ptr
    len: int
    cap: int
}

iv_new_() -> *IVec {
    v = malloc(sizeof(IVec)) as *IVec
    v.cap = 64
    v.len = 0
    v.data = malloc(256)
    return v
}

iv_push_(v: *IVec, x: int) {
    if v.len == v.cap {
        v.cap = v.cap * 2
        v.data = realloc(v.data, v.cap * 4)
    }
    mem.set_int(v.data, v.len * 4, x)
    v.len = v.len + 1
}

iv_get_(v: *IVec, i: int) -> int {
    return mem.get_int(v.data, i * 4)
}

iv_set_(v: *IVec, i: int, x: int) {
    mem.set_int(v.data, i * 4, x)
}

iv_pop_(v: *IVec) -> int {
    v.len = v.len - 1
    return mem.get_int(v.data, v.len * 4)
}

iv_top_(v: *IVec) -> int {
    return mem.get_int(v.data, (v.len - 1) * 4)
}

iv_free_(v: *IVec) {
    free(v.data)
    free(v)
}

// ---------------------------------------------------------------------------
// Tokens

const T_EOF = 0
const T_IDENT = 1
const T_NUM = 2
const T_STR = 3
const T_TPL_FULL = 4     // `...` with no substitution
const T_TPL_HEAD = 5     // `...${
const T_TPL_MID = 6      // }...${
const T_TPL_TAIL = 7     // }...`
const T_PUNCT = 8
const T_REGEX = 9

// Everything the lowerer knows about one source file.
struct Lx {
    src: string
    n: int
    kind: ptr        // *IVec, per token
    start: ptr
    end: ptr
    line: ptr        // 1-based
    col: ptr         // 1-based
    nlb: ptr         // 1 if a line break precedes the token
    mate: ptr        // index of the matching bracket, or -1
    err: string
    err_line: int
    err_col: int
    // parser
    pos: int
    last_end: int    // end offset of the last consumed token
    // a `>>` or `>>>` closing nested type arguments one `>` at a time
    gt_tok: int      // the token partly used, or -1
    gt_used: int     // how many of its `>` are used
    ta_depth: int    // type argument and parameter lists open
    es: ptr          // edits: start, end, seq, replacement
    ee: ptr
    eq: ptr
    er: ptr          // std.strarr of owned replacement strings
    ei: ptr          // per edit: its index in er (edits can be rolled back)
    seq: int
    // scopes
    sc_names: ptr    // std.strarr: let/const/class names of enclosing blocks
    sc_mark: ptr     // *IVec: sc_names length at each block start
    fn_vars: ptr     // std.strarr: var/function/parameter names, stacked
    fn_varbase: ptr  // per function: fn_vars length at its start
        sealed: string   // objects the page's "seeks" lines unlock, as ",fs,http,"
    sought: string   // the privileges it requires, as ",local-filesystem,outgoing-http,"
    optional: string // the privileges it uses if granted (", reduced functionality without")
    scopes: string   // scoped seeks, one per line: "privilege\tVERBS\tpattern\n"
    hides: ptr       // std.strarr: "hide" names in force, stacked by function
    hide_base: ptr   // per function: hides length at its start
    // modules (README, "Modules")
    is_module: int   // 1: lowering a module (exports allowed, $exports given)
    has_io: int      // 1 once an import or export was rewritten
    tla: int         // 1 once an `await` was seen outside every function
    tla_off: int     // where the first one was
    imports: string  // what the unit imports: "spec\tline\tcol\n" per import
    wrapped: int     // 1: the output is a function expression (see wrap_)
}

ch_(x: *Lx, i: int) -> int {
    if i >= x.n { return 0 }
    return string.string_char_at_n(x.src, x.n, i)
}

is_id_start_(c: int) -> int {
    if c >= 97 && c <= 122 { return 1 }
    if c >= 65 && c <= 90 { return 1 }
    if c == 95 || c == 36 { return 1 }
    if c >= 128 { return 1 }
    return 0
}

is_id_char_(c: int) -> int {
    if is_id_start_(c) == 1 { return 1 }
    if c >= 48 && c <= 57 { return 1 }
    return 0
}

is_digit_(c: int) -> int {
    if c >= 48 && c <= 57 { return 1 }
    return 0
}

fail_at_(x: *Lx, off: int, msg: string) {
    if x.err != "" { return }
    line = 1
    col = 1
    i = 0
    while i < off && i < x.n {
        if ch_(x, i) == 10 {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    x.err = string.concat(msg, "")
    x.err_line = line
    x.err_col = col
}

tk_kind_(x: *Lx, i: int) -> int { return iv_get_(x.kind as *IVec, i) }
tk_start_(x: *Lx, i: int) -> int { return iv_get_(x.start as *IVec, i) }
tk_end_(x: *Lx, i: int) -> int { return iv_get_(x.end as *IVec, i) }
tk_nlb_(x: *Lx, i: int) -> int { return iv_get_(x.nlb as *IVec, i) }
tk_mate_(x: *Lx, i: int) -> int { return iv_get_(x.mate as *IVec, i) }
ntok_(x: *Lx) -> int { return (x.kind as *IVec).len }

// Does token i's text equal lit?
tk_is_(x: *Lx, i: int, lit: string) -> int {
    s = tk_start_(x, i)
    e = tk_end_(x, i)
    ln = string.length(lit)
    if e - s != ln { return 0 }
    k = 0
    while k < ln {
        if ch_(x, s + k) != string.string_char_at_n(lit, ln, k) { return 0 }
        k = k + 1
    }
    return 1
}

tk_text_(x: *Lx, i: int) -> string {
    return string.string_substring(x.src, tk_start_(x, i), tk_end_(x, i))
}

push_tok_(x: *Lx, kind: int, s: int, e: int, nl: int) {
    iv_push_(x.kind as *IVec, kind)
    iv_push_(x.start as *IVec, s)
    iv_push_(x.end as *IVec, e)
    iv_push_(x.nlb as *IVec, nl)
    iv_push_(x.mate as *IVec, -1)
}

// The punctuators, longest first within each length.
punct_len_(x: *Lx, i: int) -> int {
    c0 = ch_(x, i)
    c1 = ch_(x, i + 1)
    c2 = ch_(x, i + 2)
    c3 = ch_(x, i + 3)
    if c0 == 62 && c1 == 62 && c2 == 62 && c3 == 61 { return 4 }      // >>>=
    if c0 == 46 && c1 == 46 && c2 == 46 { return 3 }                  // ...
    if c0 == 61 && c1 == 61 && c2 == 61 { return 3 }                  // ===
    if c0 == 33 && c1 == 61 && c2 == 61 { return 3 }                  // !==
    if c0 == 42 && c1 == 42 && c2 == 61 { return 3 }                  // **=
    if c0 == 60 && c1 == 60 && c2 == 61 { return 3 }                  // <<=
    if c0 == 62 && c1 == 62 && c2 == 61 { return 3 }                  // >>=
    if c0 == 62 && c1 == 62 && c2 == 62 { return 3 }                  // >>>
    if c0 == 38 && c1 == 38 && c2 == 61 { return 3 }                  // &&=
    if c0 == 124 && c1 == 124 && c2 == 61 { return 3 }                // ||=
    if c0 == 63 && c1 == 63 && c2 == 61 { return 3 }                  // ??=
    if c0 == 63 && c1 == 46 && is_digit_(c2) == 0 { return 2 }        // ?.
    if c1 == 61 {
        // == != <= >= += -= *= /= %= &= |= ^=
        if c0 == 61 || c0 == 33 || c0 == 60 || c0 == 62 || c0 == 43 || c0 == 45 { return 2 }
        if c0 == 42 || c0 == 47 || c0 == 37 || c0 == 38 || c0 == 124 || c0 == 94 { return 2 }
    }
    if c0 == 61 && c1 == 62 { return 2 }                              // =>
    if c0 == 38 && c1 == 38 { return 2 }                              // &&
    if c0 == 124 && c1 == 124 { return 2 }                            // ||
    if c0 == 63 && c1 == 63 { return 2 }                              // ??
    if c0 == 43 && c1 == 43 { return 2 }                              // ++
    if c0 == 45 && c1 == 45 { return 2 }                              // --
    if c0 == 60 && c1 == 60 { return 2 }                              // <<
    if c0 == 62 && c1 == 62 { return 2 }                              // >>
    if c0 == 42 && c1 == 42 { return 2 }                              // **
    return 1
}

// Can a regular expression start here, given the previous token?
regex_allowed_(x: *Lx) -> int {
    nt = ntok_(x)
    if nt == 0 { return 1 }
    p = nt - 1
    k = tk_kind_(x, p)
    if k == T_NUM || k == T_STR || k == T_REGEX || k == T_TPL_FULL || k == T_TPL_TAIL { return 0 }
    if k == T_IDENT {
        if tk_is_(x, p, "return") == 1 || tk_is_(x, p, "typeof") == 1 { return 1 }
        if tk_is_(x, p, "case") == 1 || tk_is_(x, p, "do") == 1 || tk_is_(x, p, "else") == 1 { return 1 }
        if tk_is_(x, p, "in") == 1 || tk_is_(x, p, "of") == 1 || tk_is_(x, p, "new") == 1 { return 1 }
        if tk_is_(x, p, "delete") == 1 || tk_is_(x, p, "void") == 1 || tk_is_(x, p, "throw") == 1 { return 1 }
        if tk_is_(x, p, "instanceof") == 1 { return 1 }
        return 0
    }
    if tk_is_(x, p, ")") == 1 || tk_is_(x, p, "]") == 1 || tk_is_(x, p, "}") == 1 { return 0 }
    if tk_is_(x, p, "++") == 1 || tk_is_(x, p, "--") == 1 { return 0 }
    return 1
}

// Scan template characters from i (just after ` or }) to the closing `
// or the next ${. Returns the offset after the delimiter, and whether it
// ended with ${ (1) or ` (0); -1 offset on an unterminated template.
scan_tpl_(x: *Lx, i: int) -> (int, int) {
    while i < x.n {
        c = ch_(x, i)
        if c == 92 {
            i = i + 2
        } else {
            if c == 96 { return i + 1, 0 }
            if c == 36 && ch_(x, i + 1) == 123 { return i + 2, 1 }
            i = i + 1
        }
    }
    return -1, 0
}

lex_(x: *Lx) {
    i = 0
    nl = 1
    // Brace depth inside each open template substitution, innermost last.
    tdepth = iv_new_()
    while i < x.n && x.err == "" {
        c = ch_(x, i)
        if c == 10 {
            nl = 1
            i = i + 1
        } else if c == 32 || c == 9 || c == 13 || c == 11 || c == 12 {
            i = i + 1
        } else if c == 47 && ch_(x, i + 1) == 47 {
            while i < x.n && ch_(x, i) != 10 { i = i + 1 }
        } else if c == 47 && ch_(x, i + 1) == 42 {
            j = i + 2
            while j < x.n && (ch_(x, j) != 42 || ch_(x, j + 1) != 47) {
                if ch_(x, j) == 10 { nl = 1 }
                j = j + 1
            }
            if j >= x.n {
                fail_at_(x, i, "unterminated comment")
                return
            }
            i = j + 2
        } else if is_id_start_(c) == 1 || c == 92 {
            j = i + 1
            while j < x.n && (is_id_char_(ch_(x, j)) == 1 || ch_(x, j) == 92) { j = j + 1 }
            push_tok_(x, T_IDENT, i, j, nl)
            nl = 0
            i = j
        } else if is_digit_(c) == 1 || (c == 46 && is_digit_(ch_(x, i + 1)) == 1) {
            j = i + 1
            while j < x.n {
                d = ch_(x, j)
                if is_id_char_(d) == 1 || d == 46 {
                    j = j + 1
                } else if (d == 43 || d == 45) && (ch_(x, j - 1) == 101 || ch_(x, j - 1) == 69) && ch_(x, i + 1) != 120 && ch_(x, i + 1) != 88 {
                    j = j + 1
                } else {
                    break
                }
            }
            push_tok_(x, T_NUM, i, j, nl)
            nl = 0
            i = j
        } else if c == 34 || c == 39 {
            j = i + 1
            while j < x.n && ch_(x, j) != c {
                if ch_(x, j) == 92 { j = j + 1 }
                if ch_(x, j) == 10 {
                    fail_at_(x, i, "unterminated string")
                    return
                }
                j = j + 1
            }
            if j >= x.n {
                fail_at_(x, i, "unterminated string")
                return
            }
            push_tok_(x, T_STR, i, j + 1, nl)
            nl = 0
            i = j + 1
        } else if c == 96 {
            e, more = scan_tpl_(x, i + 1)
            if e < 0 {
                fail_at_(x, i, "unterminated template literal")
                return
            }
            if more == 1 {
                push_tok_(x, T_TPL_HEAD, i, e, nl)
                iv_push_(tdepth, 0)
            } else {
                push_tok_(x, T_TPL_FULL, i, e, nl)
            }
            nl = 0
            i = e
        } else if c == 125 && tdepth.len > 0 && iv_top_(tdepth) == 0 {
            e, more = scan_tpl_(x, i + 1)
            if e < 0 {
                fail_at_(x, i, "unterminated template literal")
                return
            }
            if more == 1 {
                push_tok_(x, T_TPL_MID, i, e, nl)
            } else {
                push_tok_(x, T_TPL_TAIL, i, e, nl)
                iv_pop_(tdepth)
            }
            nl = 0
            i = e
        } else if c == 47 && regex_allowed_(x) == 1 {
            j = i + 1
            in_class = 0
            while j < x.n {
                d = ch_(x, j)
                if d == 10 {
                    fail_at_(x, i, "unterminated regular expression")
                    return
                }
                if d == 92 {
                    j = j + 2
                } else {
                    if d == 91 { in_class = 1 }
                    if d == 93 { in_class = 0 }
                    if d == 47 && in_class == 0 { break }
                    j = j + 1
                }
            }
            j = j + 1
            while j < x.n && is_id_char_(ch_(x, j)) == 1 { j = j + 1 }
            push_tok_(x, T_REGEX, i, j, nl)
            nl = 0
            i = j
        } else {
            ln = punct_len_(x, i)
            if c == 123 && tdepth.len > 0 { iv_set_(tdepth, tdepth.len - 1, iv_top_(tdepth) + 1) }
            if c == 125 && tdepth.len > 0 { iv_set_(tdepth, tdepth.len - 1, iv_top_(tdepth) - 1) }
            push_tok_(x, T_PUNCT, i, i + ln, nl)
            nl = 0
            i = i + ln
        }
    }
    push_tok_(x, T_EOF, x.n, x.n, 1)
    iv_free_(tdepth)
}

// Pair every ( [ { with its closer (template substitutions pair their own
// braces through the HEAD/MID/TAIL tokens, which are not counted here).
match_brackets_(x: *Lx) {
    st = iv_new_()
    nt = ntok_(x)
    i = 0
    while i < nt && x.err == "" {
        if tk_kind_(x, i) == T_PUNCT {
            if tk_is_(x, i, "(") == 1 || tk_is_(x, i, "[") == 1 || tk_is_(x, i, "{") == 1 {
                iv_push_(st, i)
            } else if tk_is_(x, i, ")") == 1 || tk_is_(x, i, "]") == 1 || tk_is_(x, i, "}") == 1 {
                if st.len == 0 {
                    fail_at_(x, tk_start_(x, i), "unmatched closing bracket")
                } else {
                    o = iv_pop_(st)
                    oc = ch_(x, tk_start_(x, o))
                    cc = ch_(x, tk_start_(x, i))
                    ok = 0
                    if oc == 40 && cc == 41 { ok = 1 }
                    if oc == 91 && cc == 93 { ok = 1 }
                    if oc == 123 && cc == 125 { ok = 1 }
                    if ok == 0 {
                        fail_at_(x, tk_start_(x, i), "mismatched bracket")
                    }
                    iv_set_(x.mate as *IVec, o, i)
                    iv_set_(x.mate as *IVec, i, o)
                }
            }
        }
        i = i + 1
    }
    if st.len > 0 && x.err == "" {
        fail_at_(x, tk_start_(x, iv_top_(st)), "unclosed bracket")
    }
    iv_free_(st)
}

// ---------------------------------------------------------------------------
// Edits

edit_(x: *Lx, s: int, e: int, text: string) {
    iv_push_(x.es as *IVec, s)
    iv_push_(x.ee as *IVec, e)
    iv_push_(x.eq as *IVec, x.seq)
    iv_push_(x.ei as *IVec, strarr.size(x.er))
    x.seq = x.seq + 1
    _r = strarr.push_copy(x.er, text)
}

// Forget the edits recorded after the first n (a construct that turned out
// to be erased whole).
edits_truncate_(x: *Lx, n: int) {
    (x.es as *IVec).len = n
    (x.ee as *IVec).len = n
    (x.eq as *IVec).len = n
    (x.ei as *IVec).len = n
}

insert_(x: *Lx, at: int, text: string) {
    edit_(x, at, at, text)
}

// Overwrite [s, e) with spaces, keeping every line break.
blank_(x: *Lx, s: int, e: int) {
    if e <= s { return }
    sb = strbuilder.new(e - s + 1)
    i = s
    while i < e {
        c = ch_(x, i)
        if c == 10 || c == 13 {
            strbuilder.append_byte(sb, c)
        } else {
            strbuilder.append_byte(sb, 32)
        }
        i = i + 1
    }
    edit_(x, s, e, strbuilder.finish(sb))
}

// Replace [s, e) with text, carrying the span's line breaks along so the
// lines after it do not move.
replace_keep_lines_(x: *Lx, s: int, e: int, text: string) {
    sb = strbuilder.new(e - s + string.length(text) + 1)
    strbuilder.append(sb, text)
    i = s
    while i < e {
        if ch_(x, i) == 10 { strbuilder.append_byte(sb, 10) }
        i = i + 1
    }
    edit_(x, s, e, strbuilder.finish(sb))
}

// Number of edits recorded so far (to tell whether a span needed any).
nedits_(x: *Lx) -> int {
    return (x.es as *IVec).len
}

apply_edits_(x: *Lx) -> string {
    es = x.es as *IVec
    ee = x.ee as *IVec
    eq = x.eq as *IVec
    n = es.len
    // Order by (start, seq): an insertion sort over an index vector. Edits
    // arrive almost sorted (the parser walks forward), so this is ~linear.
    ord = iv_new_()
    i = 0
    while i < n {
        iv_push_(ord, i)
        j = ord.len - 1
        while j > 0 {
            a = iv_get_(ord, j - 1)
            b = iv_get_(ord, j)
            sa = iv_get_(es, a)
            sb2 = iv_get_(es, b)
            if sa < sb2 { break }
            if sa == sb2 && iv_get_(eq, a) < iv_get_(eq, b) { break }
            iv_set_(ord, j - 1, b)
            iv_set_(ord, j, a)
            j = j - 1
        }
        i = i + 1
    }
    out = strbuilder.new(x.n + n * 8 + 16)
    cur = 0
    k = 0
    while k < n {
        idx = iv_get_(ord, k)
        s = iv_get_(es, idx)
        e = iv_get_(ee, idx)
        if s < cur {
            fail_at_(x, s, "internal error: overlapping rewrites")
            iv_free_(ord)
            return ""
        }
        if s > cur { strbuilder.append(out, string.string_substring(x.src, cur, s)) }
        strbuilder.append(out, strarr.get(x.er, iv_get_(x.ei as *IVec, idx)))
        cur = e
        k = k + 1
    }
    if cur < x.n { strbuilder.append(out, string.string_substring(x.src, cur, x.n)) }
    iv_free_(ord)
    return strbuilder.finish(out)
}

// ---------------------------------------------------------------------------
// Parser plumbing

cur_(x: *Lx) -> int { return x.pos }

at_(x: *Lx, lit: string) -> int {
    k = tk_kind_(x, x.pos)
    if k != T_PUNCT && k != T_IDENT { return 0 }
    return tk_is_(x, x.pos, lit)
}

at_off_(x: *Lx, d: int, lit: string) -> int {
    i = x.pos + d
    if i >= ntok_(x) { return 0 }
    k = tk_kind_(x, i)
    if k != T_PUNCT && k != T_IDENT { return 0 }
    return tk_is_(x, i, lit)
}

advance_(x: *Lx) {
    if tk_kind_(x, x.pos) == T_EOF { return }
    x.last_end = tk_end_(x, x.pos)
    x.pos = x.pos + 1
}

expect_(x: *Lx, lit: string) -> int {
    if at_(x, lit) == 1 {
        advance_(x)
        return 1
    }
    if x.err == "" {
        if tk_kind_(x, x.pos) == T_EOF {
            fail_at_(x, tk_start_(x, x.pos), "expected '${lit}' before the end of the page")
        } else {
            fail_at_(x, tk_start_(x, x.pos), "expected '${lit}' but found '${tk_text_(x, x.pos)}'")
        }
    }
    return 0
}

unsupported_(x: *Lx, i: int, what: string) {
    fail_at_(x, tk_start_(x, i), "${what} is not in the page dialect")
}

// Statement end: ';', or automatic semicolon insertion before a line break,
// '}' or the end.
semi_(x: *Lx) {
    if at_(x, ";") == 1 {
        advance_(x)
        return
    }
    if tk_nlb_(x, x.pos) == 1 || at_(x, "}") == 1 || tk_kind_(x, x.pos) == T_EOF { return }
    if x.err == "" {
        fail_at_(x, tk_start_(x, x.pos), "expected ';' but found '${tk_text_(x, x.pos)}'")
    }
}

is_ident_tok_(x: *Lx, i: int) -> int {
    if tk_kind_(x, i) == T_IDENT { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Scopes: which names the page's code binds itself (a parameter called fs is
// its own, not the capability), and which a "hide" takes away.

fn_push_(x: *Lx) {
    iv_push_(x.fn_varbase as *IVec, strarr.size(x.fn_vars))
    iv_push_(x.hide_base as *IVec, strarr.size(x.hides))
}

fn_pop_(x: *Lx) {
    vb = iv_pop_(x.fn_varbase as *IVec)
    strarr_truncate_(x.fn_vars, vb)
    hb = iv_pop_(x.hide_base as *IVec)
    strarr_truncate_(x.hides, hb)
}

strarr_truncate_(a: ptr, n: int) {
    // strarr has no truncate; overwrite the tail with "" so a later lookup
    // cannot see it.
    i = n
    sz = strarr.size(a)
    while i < sz {
        strarr.set(a, i, "")
        i = i + 1
    }
}

block_push_(x: *Lx) {
    iv_push_(x.sc_mark as *IVec, strarr.size(x.sc_names))
}

block_pop_(x: *Lx) {
    m = iv_pop_(x.sc_mark as *IVec)
    strarr_truncate_(x.sc_names, m)
}

name_in_(a: ptr, from: int, name: string) -> int {
    sz = strarr.size(a)
    i = from
    while i < sz {
        if strarr.get(a, i) == name { return 1 }
        i = i + 1
    }
    return 0
}

// The name at token i is bound here: in the current block (let, const,
// class, catch) or function (var, function, parameter).
declare_(x: *Lx, i: int, fnwide: int) {
    if fnwide == 1 {
        _v = strarr.push_copy(x.fn_vars, tk_text_(x, i))
    } else {
        _s = strarr.push_copy(x.sc_names, tk_text_(x, i))
    }
}

// ---------------------------------------------------------------------------
// TypeScript types: skipped (and blanked by the caller)

// Skip a type starting at token i. Returns the index after it, or -1.
skip_type_(x: *Lx, i: int) -> int {
    // leading | or &
    if tk_is_(x, i, "|") == 1 || tk_is_(x, i, "&") == 1 { i = i + 1 }
    i = skip_type_operand_(x, i)
    if i < 0 { return -1 }
    while tk_is_(x, i, "|") == 1 || tk_is_(x, i, "&") == 1 {
        i = skip_type_operand_(x, i + 1)
        if i < 0 { return -1 }
    }
    // conditional type: A extends B ? C : D
    if tk_is_(x, i, "extends") == 1 && tk_nlb_(x, i) == 0 {
        j = skip_type_(x, i + 1)
        if j < 0 { return -1 }
        if tk_is_(x, j, "?") == 0 { return -1 }
        j = skip_type_(x, j + 1)
        if j < 0 || tk_is_(x, j, ":") == 0 { return -1 }
        return skip_type_(x, j + 1)
    }
    return i
}

// The tokenizer reads `>>` and `>>>` as one token (a shift), but in
// `Map<string, Set<number>>` each `>` closes a list of its own. These let
// the type skippers use such a token one `>` at a time: the token at i is a
// '>' with one still unused, and closing uses it. An index stays on a
// partly used token until its last '>' is used.
gt_left_(x: *Lx, i: int) -> int {
    n = 0
    if tk_is_(x, i, ">") == 1 { n = 1 }
    if tk_is_(x, i, ">>") == 1 { n = 2 }
    if tk_is_(x, i, ">>>") == 1 { n = 3 }
    if n > 0 && x.gt_tok == i { n = n - x.gt_used }
    return n
}

close_gt_(x: *Lx, i: int) -> int {
    left = gt_left_(x, i)
    if left <= 1 {
        if x.gt_tok == i { x.gt_tok = -1 }
        return i + 1
    }
    if x.gt_tok != i {
        x.gt_tok = i
        x.gt_used = 0
    }
    x.gt_used = x.gt_used + 1
    return i
}

// Open a list (a fresh outermost one forgets any half-used token from a
// failed attempt), and close it: the outermost list must use its token up,
// or it was not a type argument list (`a < b >> c`).
ta_open_(x: *Lx) {
    if x.ta_depth == 0 { x.gt_tok = -1 }
    x.ta_depth = x.ta_depth + 1
}

ta_close_(x: *Lx, i: int) -> int {
    x.ta_depth = x.ta_depth - 1
    if i < 0 { return -1 }
    if x.ta_depth == 0 && x.gt_tok == i {
        x.gt_tok = -1
        return -1
    }
    return i
}

skip_type_args_(x: *Lx, i: int) -> int {
    // i at '<'. Returns the index after the matching '>' or -1.
    if tk_is_(x, i, "<") == 0 { return -1 }
    ta_open_(x)
    return ta_close_(x, skip_type_args_in_(x, i + 1))
}

skip_type_args_in_(x: *Lx, i: int) -> int {
    if gt_left_(x, i) > 0 { return close_gt_(x, i) }
    while true {
        i = skip_type_(x, i)
        if i < 0 { return -1 }
        if tk_is_(x, i, ",") == 1 {
            i = i + 1
        } else if gt_left_(x, i) > 0 {
            return close_gt_(x, i)
        } else {
            return -1
        }
    }
    return -1
}

// Skip a type parameter list <T, U extends X = Y>.
skip_type_params_(x: *Lx, i: int) -> int {
    if tk_is_(x, i, "<") == 0 { return -1 }
    ta_open_(x)
    return ta_close_(x, skip_type_params_in_(x, i + 1))
}

skip_type_params_in_(x: *Lx, i: int) -> int {
    while true {
        if tk_is_(x, i, "const") == 1 || tk_is_(x, i, "in") == 1 || tk_is_(x, i, "out") == 1 { i = i + 1 }
        if is_ident_tok_(x, i) == 0 { return -1 }
        i = i + 1
        if tk_is_(x, i, "extends") == 1 {
            i = skip_type_(x, i + 1)
            if i < 0 { return -1 }
        }
        if tk_is_(x, i, "=") == 1 {
            i = skip_type_(x, i + 1)
            if i < 0 { return -1 }
        }
        if tk_is_(x, i, ",") == 1 {
            i = i + 1
            if gt_left_(x, i) > 0 { return close_gt_(x, i) }
        } else if gt_left_(x, i) > 0 {
            return close_gt_(x, i)
        } else {
            return -1
        }
    }
    return -1
}

skip_type_operand_(x: *Lx, i: int) -> int {
    k = tk_kind_(x, i)
    // prefix operators
    if tk_is_(x, i, "keyof") == 1 || tk_is_(x, i, "readonly") == 1 || tk_is_(x, i, "unique") == 1 || tk_is_(x, i, "infer") == 1 {
        if is_ident_tok_(x, i + 1) == 1 || tk_is_(x, i + 1, "(") == 1 || tk_is_(x, i + 1, "[") == 1 || tk_is_(x, i + 1, "{") == 1 {
            return skip_type_operand_(x, i + 1)
        }
    }
    if tk_is_(x, i, "typeof") == 1 {
        i = i + 1
        if is_ident_tok_(x, i) == 0 { return -1 }
        i = i + 1
        while tk_is_(x, i, ".") == 1 && is_ident_tok_(x, i + 1) == 1 { i = i + 2 }
        return skip_type_suffix_(x, i)
    }
    if tk_is_(x, i, "new") == 1 {
        i = i + 1
        if tk_is_(x, i, "<") == 1 {
            i = skip_type_params_(x, i)
            if i < 0 { return -1 }
        }
        if tk_is_(x, i, "(") == 0 { return -1 }
        j = tk_mate_(x, i) + 1
        if tk_is_(x, j, "=>") == 0 { return -1 }
        return skip_type_(x, j + 1)
    }
    if tk_is_(x, i, "<") == 1 {
        // generic function type <T>(a: T) => T
        i = skip_type_params_(x, i)
        if i < 0 || tk_is_(x, i, "(") == 0 { return -1 }
        j = tk_mate_(x, i) + 1
        if tk_is_(x, j, "=>") == 0 { return -1 }
        return skip_type_(x, j + 1)
    }
    if tk_is_(x, i, "(") == 1 {
        j = tk_mate_(x, i) + 1
        if tk_is_(x, j, "=>") == 1 { return skip_type_(x, j + 1) }
        return skip_type_suffix_(x, j)
    }
    if tk_is_(x, i, "[") == 1 || tk_is_(x, i, "{") == 1 {
        return skip_type_suffix_(x, tk_mate_(x, i) + 1)
    }
    if k == T_STR || k == T_NUM || k == T_TPL_FULL {
        return skip_type_suffix_(x, i + 1)
    }
    if tk_is_(x, i, "-") == 1 && tk_kind_(x, i + 1) == T_NUM {
        return skip_type_suffix_(x, i + 2)
    }
    if k == T_TPL_HEAD {
        // template literal type: find its TAIL
        depth = 0
        j = i
        while tk_kind_(x, j) != T_EOF {
            kj = tk_kind_(x, j)
            if kj == T_TPL_HEAD { depth = depth + 1 }
            if kj == T_TPL_TAIL {
                depth = depth - 1
                if depth == 0 { return skip_type_suffix_(x, j + 1) }
            }
            j = j + 1
        }
        return -1
    }
    if k == T_IDENT {
        // a type predicate: x is T / asserts x [is T]
        if tk_is_(x, i, "asserts") == 1 && is_ident_tok_(x, i + 1) == 1 && tk_nlb_(x, i + 1) == 0 {
            i = i + 2
            if tk_is_(x, i, "is") == 1 { return skip_type_(x, i + 1) }
            return i
        }
        if tk_is_(x, i + 1, "is") == 1 && tk_nlb_(x, i + 1) == 0 {
            return skip_type_(x, i + 2)
        }
        i = i + 1
        while tk_is_(x, i, ".") == 1 && is_ident_tok_(x, i + 1) == 1 { i = i + 2 }
        if tk_is_(x, i, "<") == 1 && tk_nlb_(x, i) == 0 {
            i = skip_type_args_(x, i)
            if i < 0 { return -1 }
        }
        return skip_type_suffix_(x, i)
    }
    return -1
}

// T[] and T[K] suffixes.
skip_type_suffix_(x: *Lx, i: int) -> int {
    while tk_is_(x, i, "[") == 1 && tk_nlb_(x, i) == 0 {
        i = tk_mate_(x, i) + 1
    }
    return i
}

// At ':' (current token): blank ': Type'. Returns 1 if a type was there.
erase_annotation_(x: *Lx) -> int {
    if at_(x, ":") == 0 { return 0 }
    s = tk_start_(x, x.pos)
    j = skip_type_(x, x.pos + 1)
    if j < 0 {
        fail_at_(x, tk_start_(x, x.pos + 1), "cannot read this type annotation")
        return 0
    }
    blank_(x, s, tk_end_(x, j - 1))
    x.pos = j
    x.last_end = tk_end_(x, j - 1)
    return 1
}

// Blank tokens [i, j) and move the cursor past them.
erase_tokens_(x: *Lx, i: int, j: int) {
    blank_(x, tk_start_(x, i), tk_end_(x, j - 1))
    x.pos = j
    x.last_end = tk_end_(x, j - 1)
}

// ---------------------------------------------------------------------------
// Statements

// ---------------------------------------------------------------------------
// What a page may name: "seeks <privilege>" lines at the top of the page
// unlock fs, http and shell; "hide a, b" at the top of a function takes
// names away from it. Checked by name where each object is used.
// docs/app-capabilities.md.

const CAPS = ",ui,vg,http,fs,shell,sqlite,storage,browserContext,"

// The text of string token i, without its quotes.
str_inner_(x: *Lx, i: int) -> string {
    t = tk_text_(x, i)
    if string.length(t) < 2 { return "" }
    return string.substring(t, 1, string.length(t) - 1)
}

// "a, b" -> each name, trimmed, into `out` (a strarr); or as ",a,b," text.
names_of_(list: string) -> string {
    out = ","
    parts = string.split(list, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.trim(string.string_array_get(parts, i))
        if nm != "" { out = string.concat(out, string.concat(nm, ",")) }
        i = i + 1
    }
    return out
}

// The privileges a page can seek, by the name a page uses for each, and the
// page-API object each one unlocks. ui, vg, storage and browserContext every
// page has, so they are not sought. "database" takes the database's name
// ("seeks database fred", one line per database) and unlocks sqlite.fred;
// it is kept as "database fred" in the sought and optional lists.
const SEEKABLE = ",local-filesystem:fs,outgoing-http:http,open-urls:shell,database:sqlite,"
const PRIVILEGED = ",fs,http,shell,sqlite,"

// The object a privilege unlocks ("local-filesystem" -> "fs"), or "".
object_of_(privilege: string) -> string {
    at = string.index_of(SEEKABLE, ",${privilege}:")
    if at < 0 { return "" }
    from = at + string.length(privilege) + 2
    to = from
    while string.char_at(SEEKABLE, to) != 44 { to = to + 1 }
    return string.substring(SEEKABLE, from, to)
}

// The privilege that unlocks an object ("fs" -> "local-filesystem").
privilege_of_(obj: string) -> string {
    at = string.index_of(SEEKABLE, ":${obj},")
    if at < 0 { return "" }
    k = at - 1
    while string.char_at(SEEKABLE, k) != 44 { k = k - 1 }
    return string.substring(SEEKABLE, k + 1, at)
}

// The "seeks" lines at the top of a page: string statements, one after
// another, one privilege each, optionally narrowed to a scope and optionally
// marked as something the page can do without:
//
//     "seeks outgoing-http";
//     "seeks outgoing-http GET,PATCH https://api.github.com/notifications/*";
//     "seeks outgoing-http GET /api/*, reduced functionality without";
//     "seeks database fred";
//
// The page may then name the objects those unlock. The kernel checks each
// against what the context grants before the page runs, and checks every
// request against the page's scopes. docs/app-capabilities.md.
const OPTIONAL_SUFFIX = ", reduced functionality without"
const HTTP_VERBS = ",GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS,"

// The words of s, split on spaces, empty ones dropped, as a strarr.
words_of_(s: string) -> ptr {
    out = strarr.new()
    parts = string.split(s, " ")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        w = string.trim(string.string_array_get(parts, i))
        if w != "" { _p = strarr.push_copy(out, w) }
        i = i + 1
    }
    return out
}

// 1 if `s` can name a database: a letter or "_", then letters, digits and
// "_" (it becomes a property of `sqlite`, and a file name).
db_name_ok_(s: string) -> int {
    n = string.length(s)
    if n == 0 || n > 64 { return 0 }
    i = 0
    while i < n {
        c = string.char_at(s, i)
        ok = 0
        if c >= 97 && c <= 122 { ok = 1 }
        if c >= 65 && c <= 90 { ok = 1 }
        if c == 95 { ok = 1 }
        if i > 0 && c >= 48 && c <= 57 { ok = 1 }
        if ok == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Why an outgoing-http scope ("GET,POST" and a URL pattern) is malformed, or "".
http_scope_error_(verbs: string, pattern: string) -> string {
    vs = string.split(verbs, ",")
    nv = string.string_array_size(vs)
    i = 0
    while i < nv {
        v = string.string_array_get(vs, i)
        if v == "" || string.contains(HTTP_VERBS, ",${v},") == 0 {
            return "\"${v}\" is not an HTTP method (GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS)"
        }
        i = i + 1
    }
    if string.starts_with(pattern, "/") == 1 { return "" }
    rest = ""
    if string.starts_with(pattern, "https://") == 1 { rest = string.substring(pattern, 8, string.length(pattern)) }
    if string.starts_with(pattern, "http://") == 1 { rest = string.substring(pattern, 7, string.length(pattern)) }
    if rest == "" {
        return "\"${pattern}\" is not a URL pattern: it starts with https://, http:// or / (this page's own origin)"
    }
    slash = string.index_of(rest, "/")
    host = rest
    if slash >= 0 { host = string.substring(rest, 0, slash) }
    if host == "" { return "\"${pattern}\" names no host" }
    if string.contains(host, "*") == 1 {
        return "\"${pattern}\": the scheme, host and port are matched exactly; only the path may use *"
    }
    return ""
}

page_seeks_(x: *Lx) {
    j = x.pos
    while tk_kind_(x, j) == T_STR && x.err == "" {
        d = str_inner_(x, j)
        if string.starts_with(d, "seeks ") == 0 { return }
        rest = string.trim(string.substring(d, 6, string.length(d)))
        optional = 0
        if string.ends_with(rest, OPTIONAL_SUFFIX) == 1 {
            optional = 1
            rest = string.trim(string.substring(rest, 0, string.length(rest) - string.length(OPTIONAL_SUFFIX)))
        }
        ws = words_of_(rest)
        nw = strarr.size(ws)
        nm = ""
        if nw > 0 { nm = strarr.get(ws, 0) }
        if string.ends_with(nm, ",") == 1 || (nw > 1 && string.starts_with(strarr.get(ws, 1), ",") == 1) {
            fail_at_(x, tk_start_(x, j), "\"seeks\" takes one privilege per line; give each its own")
            return
        }
        obj = object_of_(nm)
        if obj == "" {
            fail_at_(x, tk_start_(x, j), "\"seeks ${nm}\": not something a page can seek (local-filesystem, outgoing-http, open-urls, database <name>)")
            return
        }
        scoped = 0
        if nm == "database" {
            // The name is part of the privilege: "database fred" is one
            // privilege, "database atlas" another; each line names one.
            if nw != 2 || db_name_ok_(strarr.get(ws, 1)) == 0 {
                fail_at_(x, tk_start_(x, j), "\"seeks database\" takes the database's name, as app.json capabilities.sqlite spells it: \"seeks database fred\"")
                return
            }
            nm = "database ${strarr.get(ws, 1)}"
            nw = 1
        }
        if nw > 1 {
            if nm != "outgoing-http" {
                fail_at_(x, tk_start_(x, j), "\"seeks ${nm}\" cannot take a scope yet; seek it without one (only outgoing-http can be scoped so far)")
                return
            }
            if nw != 3 {
                fail_at_(x, tk_start_(x, j), "a scoped seek is a method list and a URL pattern: \"seeks outgoing-http GET https://example.com/api/*\"")
                return
            }
            why = http_scope_error_(strarr.get(ws, 1), strarr.get(ws, 2))
            if why != "" {
                fail_at_(x, tk_start_(x, j), why)
                return
            }
            scoped = 1
        }
        // One privilege is required or optional, scoped or not: never both.
        was_req = string.contains(x.sought, ",${nm},")
        was_opt = string.contains(x.optional, ",${nm},")
        if (optional == 1 && was_req == 1) || (optional == 0 && was_opt == 1) {
            fail_at_(x, tk_start_(x, j), "${nm} is sought both as required and as \"reduced functionality without\"")
            return
        }
        was_scoped = string.contains(x.scopes, "${nm}\t")
        if (was_req == 1 || was_opt == 1) && was_scoped != scoped {
            fail_at_(x, tk_start_(x, j), "${nm} is sought both with and without a scope; scope every line or none")
            return
        }
        if optional == 1 {
            if was_opt == 0 { x.optional = string.concat(x.optional, "${nm},") }
        } else {
            if was_req == 0 { x.sought = string.concat(x.sought, "${nm},") }
        }
        if scoped == 1 {
            x.scopes = string.concat(x.scopes, "${nm}\t${strarr.get(ws, 1)}\t${strarr.get(ws, 2)}\n")
        }
        strarr.free(ws)
        if string.contains(x.sealed, ",${obj},") == 0 { x.sealed = string.concat(x.sealed, "${obj},") }
        j = j + 1
        if tk_is_(x, j, ";") == 1 { j = j + 1 }
    }
}

// A directive at token i (a string statement) at the top of a function:
// "hide a, b". A "seeks" line anywhere but the top of the page is an error.
directive_(x: *Lx, i: int, page_top: int) {
    if tk_kind_(x, i) != T_STR { return }
    d = str_inner_(x, i)
    if string.starts_with(d, "seeks ") == 1 {
        if page_top == 0 {
            fail_at_(x, tk_start_(x, i), "\"seeks\" belongs at the top of a page; a function says \"hide\"")
        }
        return
    }
    if string.starts_with(d, "hide ") == 1 {
        ns = names_of_(string.substring(d, 5, string.length(d)))
        parts = string.split(ns, ",")
        n = string.string_array_size(parts)
        k = 0
        while k < n {
            nm = string.string_array_get(parts, k)
            if nm != "" { _h = strarr.push_copy(x.hides, nm) }
            k = k + 1
        }
    }
}

// A capability name used at token i: refused if the page's seal leaves it
// out or a hide covers it, unless the code bound that name itself.
cap_check_(x: *Lx, i: int) {
    nm = tk_text_(x, i)
    if string.contains(CAPS, ",${nm},") == 0 { return }
    if name_in_(x.fn_vars, 0, nm) == 1 || name_in_(x.sc_names, 0, nm) == 1 { return }
    if name_in_(x.hides, 0, nm) == 1 {
        fail_at_(x, tk_start_(x, i), "${nm} is hidden here (a \"hide\" directive)")
        return
    }
    // fs, http, shell and sqlite need a "seeks" line; ui, vg, storage and
    // browserContext every page has.
    if string.contains(PRIVILEGED, ",${nm},") == 1 && string.contains(x.sealed, ",${nm},") == 0 {
        if nm == "sqlite" {
            fail_at_(x, tk_start_(x, i), "sqlite needs \"seeks database <name>\" at the top of the page")
            return
        }
        fail_at_(x, tk_start_(x, i), "${nm} needs \"seeks ${privilege_of_(nm)}\" at the top of the page")
    }
}

parse_program_(x: *Lx) {
    if x.is_module == 1 {
        if tk_kind_(x, x.pos) == T_STR && string.starts_with(str_inner_(x, x.pos), "seeks ") == 1 {
            fail_at_(x, tk_start_(x, x.pos), "a module cannot seek; the page that imports it does, and the module may then name what it sought")
            return
        }
    } else {
        page_seeks_(x)
    }
    while tk_kind_(x, x.pos) != T_EOF && x.err == "" {
        parse_statement_(x)
    }
    if x.err == "" { wrap_(x) }
}

// An `await` at token i: outside every function it makes the unit a
// top-level-await page (wrap_ makes the wrapper async).
note_await_(x: *Lx, i: int) {
    if (x.fn_varbase as *IVec).len > 0 { return }
    if x.tla == 0 { x.tla_off = tk_start_(x, i) }
    x.tla = 1
}

parse_block_body_(x: *Lx) {
    // at '{'
    expect_(x, "{")
    block_push_(x)
    while at_(x, "}") == 0 && tk_kind_(x, x.pos) != T_EOF && x.err == "" {
        parse_statement_(x)
    }
    block_pop_(x)
    expect_(x, "}")
}

// Is token i the start of a TS declaration statement that is erased whole?
// (`type X =`, `interface X`, `declare ...`)
ts_decl_kind_(x: *Lx, i: int) -> int {
    if is_ident_tok_(x, i + 1) == 0 || tk_nlb_(x, i + 1) == 1 { return 0 }
    if tk_is_(x, i, "interface") == 1 { return 1 }
    if tk_is_(x, i, "type") == 1 { return 2 }
    if tk_is_(x, i, "declare") == 1 { return 3 }
    if tk_is_(x, i, "abstract") == 1 && tk_is_(x, i + 1, "class") == 1 { return 4 }
    if tk_is_(x, i, "enum") == 1 { return 5 }
    if tk_is_(x, i, "namespace") == 1 || tk_is_(x, i, "module") == 1 { return 6 }
    return 0
}

// Skip an import/export type statement: to ';' or a line break, stepping
// over brackets.
skip_stmt_(x: *Lx, i: int) -> int {
    first = i
    while tk_kind_(x, i) != T_EOF {
        if tk_is_(x, i, ";") == 1 { return i + 1 }
        if i > first && tk_nlb_(x, i) == 1 { return i }
        if tk_is_(x, i, "{") == 1 || tk_is_(x, i, "(") == 1 || tk_is_(x, i, "[") == 1 {
            i = tk_mate_(x, i) + 1
        } else {
            i = i + 1
        }
    }
    return i
}

// Skip a declaration to its end without parsing it: through a top-level
// '{...}' body, or to ';' / a line break at bracket depth 0. A line that
// starts with '|', '&', '?' or ':' goes on with the type (no statement
// starts with one): a union written one member a line, a conditional type
// one branch a line.
skip_decl_(x: *Lx, i: int) -> int {
    first = i
    while tk_kind_(x, i) != T_EOF {
        if tk_is_(x, i, ";") == 1 { return i + 1 }
        if i > first + 1 && tk_nlb_(x, i) == 1 && tk_is_(x, i, "|") == 0 && tk_is_(x, i, "&") == 0 && tk_is_(x, i, "?") == 0 && tk_is_(x, i, ":") == 0 && tk_is_(x, i - 1, "{") == 0 && tk_is_(x, i - 1, ",") == 0 && tk_is_(x, i - 1, "=") == 0 && tk_is_(x, i - 1, "|") == 0 && tk_is_(x, i - 1, "&") == 0 && tk_is_(x, i - 1, ":") == 0 {
            return i
        }
        if tk_is_(x, i, "{") == 1 {
            j = tk_mate_(x, i) + 1
            if tk_is_(x, j, ";") == 1 { return j + 1 }
            if tk_is_(x, i - 1, "=") == 1 || tk_is_(x, i - 1, ":") == 1 || tk_is_(x, i - 1, "|") == 1 || tk_is_(x, i - 1, "&") == 1 || tk_is_(x, i - 1, "<") == 1 || tk_is_(x, i - 1, ",") == 1 {
                i = j
            } else {
                return j
            }
        } else if tk_is_(x, i, "(") == 1 || tk_is_(x, i, "[") == 1 {
            i = tk_mate_(x, i) + 1
        } else {
            i = i + 1
        }
    }
    return i
}

parse_statement_(x: *Lx) {
    if x.err != "" { return }
    i = x.pos
    k = tk_kind_(x, i)

    if k == T_PUNCT {
        if tk_is_(x, i, "{") == 1 {
            parse_block_body_(x)
            return
        }
        if tk_is_(x, i, ";") == 1 {
            advance_(x)
            return
        }
        if tk_is_(x, i, "@") == 1 {
            unsupported_(x, i, "a decorator")
            return
        }
    }

    if k == T_IDENT {
        dk = ts_decl_kind_(x, i)
        if dk == 4 {
            // abstract class: the class stays, `abstract` goes
            blank_(x, tk_start_(x, i), tk_end_(x, i))
            advance_(x)
            parse_class_(x, 1)
            return
        }
        if dk == 5 {
            fail_at_(x, tk_start_(x, i), "enum is not erasable TypeScript (--erasableSyntaxOnly); use a const object")
            return
        }
        if dk == 6 {
            fail_at_(x, tk_start_(x, i), "namespace is not erasable TypeScript (--erasableSyntaxOnly)")
            return
        }
        if dk == 2 && tk_is_(x, i + 1, "=") == 1 {
            dk = 0
        }
        if dk > 0 {
            j = skip_decl_(x, i)
            erase_tokens_(x, i, j)
            return
        }
        if tk_is_(x, i, "var") == 1 || tk_is_(x, i, "let") == 1 || tk_is_(x, i, "const") == 1 {
            if tk_is_(x, i, "let") == 1 && is_ident_tok_(x, i + 1) == 0 && at_off_(x, 1, "[") == 0 && at_off_(x, 1, "{") == 0 {
                // `let` used as an identifier
            } else {
                parse_var_decl_(x, 0)
                semi_(x)
                return
            }
        }
        if tk_is_(x, i, "function") == 1 {
            parse_function_(x, 1, 0)
            return
        }
        if tk_is_(x, i, "async") == 1 && tk_is_(x, i + 1, "function") == 1 && tk_nlb_(x, i + 1) == 0 {
            parse_function_(x, 1, 0)
            return
        }
        if tk_is_(x, i, "class") == 1 {
            parse_class_(x, 1)
            return
        }
        if tk_is_(x, i, "import") == 1 && at_off_(x, 1, "(") == 0 && at_off_(x, 1, ".") == 0 {
            if tk_is_(x, i + 1, "type") == 1 && (is_ident_tok_(x, i + 2) == 1 || tk_is_(x, i + 2, "{") == 1 || tk_is_(x, i + 2, "*") == 1) && tk_is_(x, i + 2, "from") == 0 {
                j = skip_stmt_(x, i)
                erase_tokens_(x, i, j)
                return
            }
            parse_import_(x)
            return
        }
        if tk_is_(x, i, "import") == 1 && at_off_(x, 1, ".") == 1 {
            fail_at_(x, tk_start_(x, i), "import.meta is not available: a page has no module URL of its own")
            return
        }
        if tk_is_(x, i, "export") == 1 {
            if tk_is_(x, i + 1, "type") == 1 && tk_is_(x, i + 2, "{") == 1 {
                j = skip_stmt_(x, i)
                erase_tokens_(x, i, j)
                return
            }
            if tk_is_(x, i + 1, "type") == 1 || tk_is_(x, i + 1, "interface") == 1 || tk_is_(x, i + 1, "declare") == 1 {
                j = skip_decl_(x, i)
                erase_tokens_(x, i, j)
                return
            }
            parse_export_(x)
            return
        }
        if tk_is_(x, i, "if") == 1 {
            advance_(x)
            expect_(x, "(")
            parse_expr_(x)
            expect_(x, ")")
            parse_statement_(x)
            if at_(x, "else") == 1 {
                advance_(x)
                parse_statement_(x)
            }
            return
        }
        if tk_is_(x, i, "for") == 1 {
            parse_for_(x)
            return
        }
        if tk_is_(x, i, "while") == 1 {
            advance_(x)
            expect_(x, "(")
            parse_expr_(x)
            expect_(x, ")")
            parse_statement_(x)
            return
        }
        if tk_is_(x, i, "do") == 1 {
            advance_(x)
            parse_statement_(x)
            expect_(x, "while")
            expect_(x, "(")
            parse_expr_(x)
            expect_(x, ")")
            if at_(x, ";") == 1 { advance_(x) }
            return
        }
        if tk_is_(x, i, "return") == 1 {
            advance_(x)
            if at_(x, ";") == 0 && at_(x, "}") == 0 && tk_nlb_(x, x.pos) == 0 && tk_kind_(x, x.pos) != T_EOF {
                parse_expr_(x)
            }
            semi_(x)
            return
        }
        if tk_is_(x, i, "break") == 1 || tk_is_(x, i, "continue") == 1 {
            advance_(x)
            if is_ident_tok_(x, x.pos) == 1 && tk_nlb_(x, x.pos) == 0 { advance_(x) }
            semi_(x)
            return
        }
        if tk_is_(x, i, "throw") == 1 {
            advance_(x)
            parse_expr_(x)
            semi_(x)
            return
        }
        if tk_is_(x, i, "try") == 1 {
            advance_(x)
            parse_block_body_(x)
            if at_(x, "catch") == 1 {
                advance_(x)
                block_push_(x)
                if at_(x, "(") == 1 {
                    advance_(x)
                    parse_binding_(x, 0)
                    erase_annotation_(x)
                    expect_(x, ")")
                }
                parse_block_body_(x)
                block_pop_(x)
            }
            if at_(x, "finally") == 1 {
                advance_(x)
                parse_block_body_(x)
            }
            return
        }
        if tk_is_(x, i, "switch") == 1 {
            advance_(x)
            expect_(x, "(")
            parse_expr_(x)
            expect_(x, ")")
            expect_(x, "{")
            block_push_(x)
            while at_(x, "}") == 0 && tk_kind_(x, x.pos) != T_EOF && x.err == "" {
                if at_(x, "case") == 1 {
                    advance_(x)
                    parse_expr_(x)
                    expect_(x, ":")
                } else if at_(x, "default") == 1 {
                    advance_(x)
                    expect_(x, ":")
                } else {
                    parse_statement_(x)
                }
            }
            block_pop_(x)
            expect_(x, "}")
            return
        }
        // label:
        if tk_is_(x, i + 1, ":") == 1 && is_reserved_(x, i) == 0 {
            advance_(x)
            advance_(x)
            parse_statement_(x)
            return
        }
    }

    parse_expr_(x)
    semi_(x)
}

is_reserved_(x: *Lx, i: int) -> int {
    if tk_is_(x, i, "default") == 1 || tk_is_(x, i, "case") == 1 { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Modules: static import and export, rewritten in place (README, "Modules").
//
// The host resolves, fetches and runs a page's imports before the page, and
// hands each unit a loader object, `$sae`, as the parameter of the function
// the unit is wrapped in (wrap_ below); a module also gets `$exports`, the
// object its importers see. The rewrites, each on the statement's own
// lines so the line count holds:
//
//   import { a, b as c } from "./m.ts"   const { a, b: c } = $sae.m("./m.ts")
//   import * as ns from "./m.ts"         const ns = $sae.m("./m.ts")
//   import d from "./m.ts"               const d = $sae.m("./m.ts").default
//   import "./m.ts"                      $sae.m("./m.ts")
//   export const a = 1, b = 2            const a = 1, b = 2;$sae.x($exports, "a", () => a, "b", () => b)
//   export function f() {}               function f() {};$sae.x($exports, "f", () => f)
//   export { a, b as c }                 $sae.x($exports, "a", () => a, "c", () => b)
//   export { a as b } from "./m.ts"      $sae.x($exports, "b", () => $sae.m("./m.ts").a)
//   export * from "./m.ts"               $sae.all($exports, $sae.m("./m.ts"))
//   export default expr                  $exports.default = expr
//
// `$sae.m(spec)` is the namespace object of a module the host already ran
// (the page's import closure, in dependency order); `$sae.x` defines each
// export as a getter, so a namespace reads a module's `let` as it is now;
// an imported binding is a `const` copy taken when the import runs.

// 1 if the parser is outside every function and block (a module statement's
// place).
top_level_(x: *Lx) -> int {
    if (x.fn_varbase as *IVec).len > 0 { return 0 }
    if (x.sc_mark as *IVec).len > 0 { return 0 }
    return 1
}

// The 1-based line and column of offset off.
line_col_(x: *Lx, off: int) -> (int, int) {
    line = 1
    col = 1
    i = 0
    while i < off && i < x.n {
        if ch_(x, i) == 10 {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return line, col
}

// The module specifier at string token j, checked and recorded for the host
// with the position of the statement at offset at. "" if refused.
module_spec_(x: *Lx, j: int, at: int) -> string {
    if tk_kind_(x, j) != T_STR {
        fail_at_(x, tk_start_(x, j), "expected a module name in quotes")
        return ""
    }
    spec = str_inner_(x, j)
    if spec == "" || string.contains(spec, "\\") == 1 {
        fail_at_(x, tk_start_(x, j), "a module name is a path on this origin (\"./m.ts\", \"/lib/m.ts\") or \"sae:<name>\"")
        return ""
    }
    line, col = line_col_(x, at)
    x.imports = string.concat(x.imports, "${spec}\t${line}\t${col}\n")
    return spec
}

// One `name [as alias]` of an import or export list, at the cursor. Type-only
// entries (`type A`, `type A as B`) are skipped. Returns (name, alias),
// both "" for a skipped one. bind 1 declares the alias (an import binds a
// name of the code's own).
parse_spec_name_(x: *Lx, bind: int) -> (string, string) {
    if at_(x, "type") == 1 && is_ident_tok_(x, x.pos + 1) == 1 && tk_is_(x, x.pos + 1, "as") == 0 {
        advance_(x)
        advance_(x)
        if at_(x, "as") == 1 {
            advance_(x)
            advance_(x)
        }
        return "", ""
    }
    if is_ident_tok_(x, x.pos) == 0 {
        fail_at_(x, tk_start_(x, x.pos), "expected a name in an import or export list (string names are not supported)")
        return "", ""
    }
    nm = tk_text_(x, x.pos)
    ai = x.pos
    advance_(x)
    alias = nm
    if at_(x, "as") == 1 {
        advance_(x)
        if is_ident_tok_(x, x.pos) == 0 {
            fail_at_(x, tk_start_(x, x.pos), "expected a name after 'as'")
            return "", ""
        }
        alias = tk_text_(x, x.pos)
        ai = x.pos
        advance_(x)
    }
    if bind == 1 { declare_(x, ai, 0) }
    return nm, alias
}

// `import ...`, at `import`.
parse_import_(x: *Lx) {
    i = x.pos
    s0 = tk_start_(x, i)
    if top_level_(x) == 0 {
        fail_at_(x, s0, "import belongs at the top level of a page, outside every function and block")
        return
    }
    advance_(x)
    defname = ""
    ns = ""
    named = ""
    if tk_kind_(x, x.pos) != T_STR {
        if is_ident_tok_(x, x.pos) == 1 && at_(x, "from") == 0 {
            defname = tk_text_(x, x.pos)
            declare_(x, x.pos, 0)
            advance_(x)
            if at_(x, ",") == 1 { advance_(x) }
        }
        if at_(x, "*") == 1 {
            advance_(x)
            if expect_(x, "as") == 0 { return }
            if is_ident_tok_(x, x.pos) == 0 {
                fail_at_(x, tk_start_(x, x.pos), "expected a name after 'as'")
                return
            }
            ns = tk_text_(x, x.pos)
            declare_(x, x.pos, 0)
            advance_(x)
        } else if at_(x, "{") == 1 {
            advance_(x)
            while at_(x, "}") == 0 && x.err == "" {
                nm, alias = parse_spec_name_(x, 1)
                if x.err != "" { return }
                if nm != "" {
                    if named != "" { named = string.concat(named, ", ") }
                    if alias == nm { named = string.concat(named, nm) } else { named = string.concat(named, "${nm}: ${alias}") }
                }
                if at_(x, ",") == 1 { advance_(x) } else { break }
            }
            if expect_(x, "}") == 0 { return }
        }
        if expect_(x, "from") == 0 { return }
    }
    j = x.pos
    _spec = module_spec_(x, j, s0)
    if x.err != "" { return }
    e = tk_end_(x, j)
    advance_(x)
    m = "$sae.m(${tk_text_(x, j)})"
    parts = ""
    if defname != "" { parts = "${defname} = ${m}.default" }
    if ns != "" {
        if parts != "" { parts = string.concat(parts, ", ") }
        parts = string.concat(parts, "${ns} = ${m}")
    }
    if named != "" {
        if parts != "" { parts = string.concat(parts, ", ") }
        parts = string.concat(parts, "{ ${named} } = ${m}")
    }
    text = m
    if parts != "" { text = "const ${parts}" }
    replace_keep_lines_(x, s0, e, text)
    x.has_io = 1
    semi_(x)
}

// The names declared since the strarr `a` had `from` entries, as
// `, "n", () => n` pairs for $sae.x. (A truncated scope leaves "" entries,
// which are skipped.)
export_pairs_(a: ptr, from: int) -> string {
    out = ""
    sz = strarr.size(a)
    k = from
    while k < sz {
        nm = strarr.get(a, k)
        if nm != "" { out = string.concat(out, ", \"${nm}\", () => ${nm}") }
        k = k + 1
    }
    return out
}

// `export ...`, at `export`, in a module.
parse_export_(x: *Lx) {
    i = x.pos
    s0 = tk_start_(x, i)
    if top_level_(x) == 0 {
        fail_at_(x, s0, "export belongs at the top level of a module, outside every function and block")
        return
    }
    if x.is_module == 0 {
        fail_at_(x, s0, "a page cannot export: nothing imports a page (export belongs in a module)")
        return
    }
    x.has_io = 1
    if tk_is_(x, i + 1, "default") == 1 {
        replace_keep_lines_(x, s0, tk_end_(x, i + 1), "$exports.default =")
        x.pos = i + 2
        x.last_end = tk_end_(x, i + 1)
        if at_(x, "function") == 1 || (at_(x, "async") == 1 && at_off_(x, 1, "function") == 1) {
            parse_function_(x, 0, 0)
            if at_(x, ";") == 1 { advance_(x) }
            return
        }
        if at_(x, "class") == 1 {
            parse_class_(x, 0)
            if at_(x, ";") == 1 { advance_(x) }
            return
        }
        parse_assign_(x)
        semi_(x)
        return
    }
    if tk_is_(x, i + 1, "*") == 1 {
        x.pos = i + 2
        alias = ""
        if at_(x, "as") == 1 {
            advance_(x)
            if is_ident_tok_(x, x.pos) == 0 {
                fail_at_(x, tk_start_(x, x.pos), "expected a name after 'as'")
                return
            }
            alias = tk_text_(x, x.pos)
            advance_(x)
        }
        if expect_(x, "from") == 0 { return }
        j = x.pos
        _s = module_spec_(x, j, s0)
        if x.err != "" { return }
        e = tk_end_(x, j)
        advance_(x)
        m = "$sae.m(${tk_text_(x, j)})"
        if alias == "" {
            replace_keep_lines_(x, s0, e, "$sae.all($exports, ${m})")
        } else {
            replace_keep_lines_(x, s0, e, "$sae.x($exports, \"${alias}\", () => ${m})")
        }
        semi_(x)
        return
    }
    if tk_is_(x, i + 1, "{") == 1 {
        x.pos = i + 2
        names = strarr.new()
        aliases = strarr.new()
        while at_(x, "}") == 0 && x.err == "" {
            nm, alias = parse_spec_name_(x, 0)
            if x.err != "" { return }
            if nm != "" {
                _n = strarr.push_copy(names, nm)
                _a = strarr.push_copy(aliases, alias)
            }
            if at_(x, ",") == 1 { advance_(x) } else { break }
        }
        if expect_(x, "}") == 0 { return }
        e = x.last_end
        from = ""
        if at_(x, "from") == 1 {
            advance_(x)
            j = x.pos
            _s = module_spec_(x, j, s0)
            if x.err != "" { return }
            e = tk_end_(x, j)
            advance_(x)
            from = "$sae.m(${tk_text_(x, j)})."
        }
        pairs = ""
        n = strarr.size(names)
        k = 0
        while k < n {
            pairs = string.concat(pairs, ", \"${strarr.get(aliases, k)}\", () => ${from}${strarr.get(names, k)}")
            k = k + 1
        }
        strarr.free(names)
        strarr.free(aliases)
        replace_keep_lines_(x, s0, e, "$sae.x($exports${pairs})")
        semi_(x)
        return
    }
    // a declaration: `export` goes, the declaration stays, and its names are
    // registered after it
    blank_(x, s0, tk_end_(x, i))
    advance_(x)
    sc0 = strarr.size(x.sc_names)
    fv0 = strarr.size(x.fn_vars)
    if at_(x, "var") == 1 || at_(x, "let") == 1 || at_(x, "const") == 1 {
        parse_var_decl_(x, 0)
        semi_(x)
    } else if at_(x, "function") == 1 || (at_(x, "async") == 1 && at_off_(x, 1, "function") == 1) {
        parse_function_(x, 1, 0)
    } else if at_(x, "class") == 1 {
        parse_class_(x, 1)
    } else if at_(x, "abstract") == 1 && at_off_(x, 1, "class") == 1 {
        blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
        advance_(x)
        parse_class_(x, 1)
    } else if at_(x, "enum") == 1 {
        fail_at_(x, tk_start_(x, x.pos), "enum is not erasable TypeScript (--erasableSyntaxOnly); use a const object")
        return
    } else {
        fail_at_(x, tk_start_(x, x.pos), "expected a declaration, { names }, * or default after export")
        return
    }
    if x.err != "" { return }
    pairs = string.concat(export_pairs_(x.sc_names, sc0), export_pairs_(x.fn_vars, fv0))
    insert_(x, x.last_end, ";$sae.x($exports${pairs})")
}

// Wrap the unit in a function expression the host calls with the loader
// object (and a module's exports object): a prefix before the first
// character and a suffix after the last, so the line count holds. Only a
// unit that imports, exports or awaits at its top level is wrapped; any
// other page is the erased script it always was. A unit whose last line has
// no newline gets one before the suffix (that is the one line added).
wrap_(x: *Lx) {
    if x.is_module == 1 && x.tla == 1 {
        fail_at_(x, x.tla_off, "top-level await belongs in a page, not a module: a module's exports are ready when the page runs")
        return
    }
    if x.is_module == 0 && x.has_io == 0 && x.tla == 0 { return }
    prefix = "(function ($sae) {"
    if x.tla == 1 { prefix = "(async function ($sae) {" }
    if x.is_module == 1 { prefix = "(function ($sae, $exports) {" }
    insert_(x, 0, prefix)
    // Before any rewrite that starts at offset 0 (an import on line 1).
    iv_set_(x.eq as *IVec, (x.eq as *IVec).len - 1, -1)
    suffix = "})"
    if x.n == 0 || ch_(x, x.n - 1) != 10 { suffix = "\n})" }
    insert_(x, x.n, suffix)
    x.wrapped = 1
}

parse_for_(x: *Lx) {
    advance_(x)    // for
    if at_(x, "await") == 1 {
        note_await_(x, x.pos)
        advance_(x)
    }
    expect_(x, "(")
    block_push_(x)
    if at_(x, "let") == 1 || at_(x, "const") == 1 || at_(x, "var") == 1 {
        parse_var_decl_(x, 1)
    } else if at_(x, ";") == 0 {
        parse_expr_no_in_(x)
    }
    if at_(x, "of") == 1 || at_(x, "in") == 1 {
        advance_(x)
        parse_assign_(x)
    } else {
        expect_(x, ";")
        if at_(x, ";") == 0 { parse_expr_(x) }
        expect_(x, ";")
        if at_(x, ")") == 0 { parse_expr_(x) }
    }
    expect_(x, ")")
    parse_statement_(x)
    block_pop_(x)
}

// var/let/const declarations. in_for: inside a for head (no 'in' operator,
// and an initializer is optional before 'of'/'in').
parse_var_decl_(x: *Lx, in_for: int) {
    fnwide = 0
    if at_(x, "var") == 1 { fnwide = 1 }
    advance_(x)
    while x.err == "" {
        parse_binding_(x, fnwide)
        if at_(x, "!") == 1 {
            // definite assignment: let x!: number
            blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
            advance_(x)
        }
        erase_annotation_(x)
        if at_(x, "=") == 1 {
            advance_(x)
            if in_for == 1 { parse_assign_no_in_(x) } else { parse_assign_(x) }
        }
        if at_(x, ",") == 0 { break }
        advance_(x)
    }
}

// A binding: a name, or a destructuring pattern ([a, , ...b], {a, b: c,
// [k]: d = 1, ...rest}), nested to any depth. Its names are bound in the
// current block (fnwide 0) or function (fnwide 1).
parse_binding_(x: *Lx, fnwide: int) {
    if x.err != "" { return }
    if is_ident_tok_(x, x.pos) == 1 {
        declare_(x, x.pos, fnwide)
        advance_(x)
        return
    }
    if at_(x, "[") == 1 {
        advance_(x)
        while at_(x, "]") == 0 && x.err == "" {
            if at_(x, ",") == 1 {
                advance_(x)
            } else {
                if at_(x, "...") == 1 { advance_(x) }
                parse_binding_(x, fnwide)
                if at_(x, "=") == 1 {
                    advance_(x)
                    parse_assign_(x)
                }
                if at_(x, ",") == 1 { advance_(x) } else { break }
            }
        }
        expect_(x, "]")
        return
    }
    if at_(x, "{") == 1 {
        advance_(x)
        while at_(x, "}") == 0 && x.err == "" {
            if at_(x, "...") == 1 {
                advance_(x)
                parse_binding_(x, fnwide)
            } else if at_(x, "[") == 1 {
                // computed key: [expr]: binding
                advance_(x)
                parse_assign_(x)
                expect_(x, "]")
                expect_(x, ":")
                parse_binding_(x, fnwide)
            } else {
                ki = x.pos
                kk = tk_kind_(x, ki)
                if kk != T_IDENT && kk != T_STR && kk != T_NUM {
                    fail_at_(x, tk_start_(x, ki), "expected a property name in a destructuring pattern")
                    return
                }
                advance_(x)
                if at_(x, ":") == 1 {
                    advance_(x)
                    parse_binding_(x, fnwide)
                } else {
                    if kk != T_IDENT {
                        fail_at_(x, tk_start_(x, ki), "a string or number key needs ': name'")
                        return
                    }
                    declare_(x, ki, fnwide)
                }
            }
            if at_(x, "=") == 1 {
                advance_(x)
                parse_assign_(x)
            }
            if at_(x, ",") == 1 { advance_(x) } else { break }
        }
        expect_(x, "}")
        return
    }
    fail_at_(x, tk_start_(x, x.pos), "expected a name or a destructuring pattern")
}

// ---------------------------------------------------------------------------
// Functions and classes

// Parameters, starting at '('. Erases their TypeScript; binds their names.
parse_params_(x: *Lx) {
    cl_i = tk_mate_(x, x.pos)
    expect_(x, "(")
    while x.pos < cl_i && x.err == "" {
        if at_(x, "this") == 1 && (tk_is_(x, x.pos + 1, ":") == 1 || tk_is_(x, x.pos + 1, ",") == 1 || x.pos + 1 == cl_i) {
            // TS `this` parameter: erase it and its comma
            blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
            advance_(x)
            erase_annotation_(x)
            if at_(x, ",") == 1 {
                blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
                advance_(x)
            }
        } else {
            if at_(x, "public") == 1 || at_(x, "private") == 1 || at_(x, "protected") == 1 || at_(x, "readonly") == 1 || at_(x, "override") == 1 {
                fail_at_(x, tk_start_(x, x.pos), "parameter properties are not erasable TypeScript (--erasableSyntaxOnly)")
                return
            }
            if at_(x, "@") == 1 {
                unsupported_(x, x.pos, "a decorator")
                return
            }
            if at_(x, "...") == 1 { advance_(x) }
            parse_binding_(x, 1)
            if at_(x, "?") == 1 {
                blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
                advance_(x)
            }
            erase_annotation_(x)
            if at_(x, "=") == 1 {
                advance_(x)
                parse_assign_(x)
            }
            if at_(x, ",") == 1 { advance_(x) }
        }
    }
    expect_(x, ")")
}

// [async] function [*] [name] [<T>] (params) [: R] { body }, at its first
// token; or, for a method (is_method 1), from just after its name (at '('
// or '<'). A declaration or method without a body (an overload signature,
// an abstract method) is erased whole, from `from` (its first token).
// Returns 1 if it was erased.
parse_function_at_(x: *Lx, is_decl: int, is_method: int, from: int) -> int {
    ne0 = nedits_(x)
    if is_method == 0 {
        if at_(x, "async") == 1 { advance_(x) }
        advance_(x)   // function
        if at_(x, "*") == 1 { advance_(x) }
        if is_ident_tok_(x, x.pos) == 1 {
            if is_decl == 1 { declare_(x, x.pos, 1) }
            advance_(x)
        } else if is_decl == 1 {
            fail_at_(x, tk_start_(x, x.pos), "expected a function name")
            return 0
        }
    }
    if at_(x, "<") == 1 {
        j = skip_type_params_(x, x.pos)
        if j < 0 {
            fail_at_(x, tk_start_(x, x.pos), "cannot read these type parameters")
            return 0
        }
        erase_tokens_(x, x.pos, j)
    }
    fn_push_(x)
    block_push_(x)
    parse_params_(x)
    erase_annotation_(x)
    if at_(x, "{") == 0 {
        block_pop_(x)
        fn_pop_(x)
        if (is_decl == 1 || is_method == 1) && x.err == "" {
            // an overload signature or abstract method: no body, erased whole
            if at_(x, ";") == 1 { advance_(x) }
            edits_truncate_(x, ne0)
            blank_(x, tk_start_(x, from), x.last_end)
            return 1
        }
        expect_(x, "{")
        return 0
    }
    directive_(x, x.pos + 1, 0)
    parse_block_body_(x)
    block_pop_(x)
    fn_pop_(x)
    return 0
}

parse_function_(x: *Lx, is_decl: int, is_method: int) {
    _e = parse_function_at_(x, is_decl, is_method, x.pos)
}

// An arrow function, at its first token: `async`, an identifier (single
// parameter), '(' or '<'.
parse_arrow_(x: *Lx) {
    if at_(x, "async") == 1 && tk_is_(x, x.pos + 1, "=>") == 0 { advance_(x) }
    fn_push_(x)
    block_push_(x)
    if is_ident_tok_(x, x.pos) == 1 {
        declare_(x, x.pos, 1)
        advance_(x)
    } else {
        if at_(x, "<") == 1 {
            j = skip_type_params_(x, x.pos)
            erase_tokens_(x, x.pos, j)
        }
        parse_params_(x)
        erase_annotation_(x)
    }
    if expect_(x, "=>") == 0 { return }
    if at_(x, "{") == 1 {
        directive_(x, x.pos + 1, 0)
        parse_block_body_(x)
    } else {
        parse_assign_(x)
    }
    block_pop_(x)
    fn_pop_(x)
}

// Is the token at i the start of an arrow function?
arrow_ahead_(x: *Lx, i: int) -> int {
    if tk_is_(x, i, "async") == 1 && tk_nlb_(x, i + 1) == 0 {
        if is_ident_tok_(x, i + 1) == 1 && tk_is_(x, i + 2, "=>") == 1 { return 1 }
        if tk_is_(x, i + 1, "(") == 1 || tk_is_(x, i + 1, "<") == 1 {
            if arrow_ahead_(x, i + 1) == 1 { return 1 }
        }
    }
    if is_ident_tok_(x, i) == 1 && tk_is_(x, i + 1, "=>") == 1 && tk_nlb_(x, i + 1) == 0 { return 1 }
    if tk_is_(x, i, "<") == 1 {
        j = skip_type_params_(x, i)
        if j < 0 || tk_is_(x, j, "(") == 0 { return 0 }
        i = j
    }
    if tk_is_(x, i, "(") == 1 {
        j = tk_mate_(x, i) + 1
        if tk_is_(x, j, "=>") == 1 && tk_nlb_(x, j) == 0 { return 1 }
        if tk_is_(x, j, ":") == 1 {
            k = skip_type_(x, j + 1)
            if k > 0 && tk_is_(x, k, "=>") == 1 { return 1 }
        }
    }
    return 0
}

// TypeScript-only member and parameter modifiers, erased in a class body.
ts_modifier_(x: *Lx, i: int) -> int {
    if tk_is_(x, i, "public") == 1 || tk_is_(x, i, "private") == 1 || tk_is_(x, i, "protected") == 1 { return 1 }
    if tk_is_(x, i, "readonly") == 1 || tk_is_(x, i, "override") == 1 || tk_is_(x, i, "abstract") == 1 { return 1 }
    if tk_is_(x, i, "declare") == 1 { return 1 }
    return 0
}

// Is the token at i a member's key (rather than a modifier word used as
// one, as in `static() {}` or a field named `readonly`)?
member_key_follows_(x: *Lx, i: int) -> int {
    j = i + 1
    if tk_is_(x, j, "(") == 1 || tk_is_(x, j, "=") == 1 || tk_is_(x, j, ";") == 1 || tk_is_(x, j, ":") == 1 { return 1 }
    if tk_is_(x, j, "?") == 1 || tk_is_(x, j, "!") == 1 || tk_is_(x, j, "<") == 1 || tk_is_(x, j, "}") == 1 { return 1 }
    if tk_nlb_(x, j) == 1 { return 1 }
    return 0
}

// class [name] [<T>] [extends E [<A>]] [implements I, J] { members }, at
// `class`. is_decl binds the name in the current block.
parse_class_(x: *Lx, is_decl: int) {
    advance_(x)   // class
    if is_ident_tok_(x, x.pos) == 1 && at_(x, "extends") == 0 && at_(x, "implements") == 0 {
        if is_decl == 1 { declare_(x, x.pos, 0) }
        advance_(x)
    }
    if at_(x, "<") == 1 {
        j = skip_type_params_(x, x.pos)
        if j < 0 {
            fail_at_(x, tk_start_(x, x.pos), "cannot read these type parameters")
            return
        }
        erase_tokens_(x, x.pos, j)
    }
    if at_(x, "extends") == 1 {
        advance_(x)
        parse_call_member_(x)
        if at_(x, "<") == 1 {
            j = skip_type_args_(x, x.pos)
            if j > 0 { erase_tokens_(x, x.pos, j) }
        }
    }
    if at_(x, "implements") == 1 {
        j = x.pos
        while tk_is_(x, j, "{") == 0 && tk_kind_(x, j) != T_EOF { j = j + 1 }
        erase_tokens_(x, x.pos, j)
    }
    expect_(x, "{")
    while at_(x, "}") == 0 && tk_kind_(x, x.pos) != T_EOF && x.err == "" {
        parse_member_(x)
    }
    expect_(x, "}")
}

// One class member.
parse_member_(x: *Lx) {
    from = x.pos
    ne_start = nedits_(x)
    if at_(x, ";") == 1 {
        advance_(x)
        return
    }
    if at_(x, "@") == 1 {
        unsupported_(x, x.pos, "a decorator")
        return
    }
    // static { ... }
    if at_(x, "static") == 1 && at_off_(x, 1, "{") == 1 {
        advance_(x)
        fn_push_(x)
        parse_block_body_(x)
        fn_pop_(x)
        return
    }
    // modifiers, TS ones erased; `declare` and `abstract` members erased whole
    erase_whole = 0
    while x.err == "" {
        if ts_modifier_(x, x.pos) == 1 && member_key_follows_(x, x.pos) == 0 {
            if at_(x, "declare") == 1 || at_(x, "abstract") == 1 { erase_whole = 1 }
            blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
            advance_(x)
        } else if (at_(x, "static") == 1 || at_(x, "accessor") == 1) && member_key_follows_(x, x.pos) == 0 {
            advance_(x)
        } else {
            break
        }
    }
    // index signature: [key: T]: U;
    if at_(x, "[") == 1 && is_ident_tok_(x, x.pos + 1) == 1 && tk_is_(x, x.pos + 2, ":") == 1 {
        j = skip_decl_(x, x.pos)
        erase_tokens_(x, from, j)
        return
    }
    is_method_kw = 0
    if (at_(x, "async") == 1 || at_(x, "get") == 1 || at_(x, "set") == 1) && member_key_follows_(x, x.pos) == 0 {
        advance_(x)
        is_method_kw = 1
    }
    if at_(x, "*") == 1 {
        advance_(x)
        is_method_kw = 1
    }
    if parse_prop_key_(x) == 0 { return }
    if at_(x, "?") == 1 || at_(x, "!") == 1 {
        blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
        advance_(x)
    }
    if at_(x, "(") == 1 || at_(x, "<") == 1 {
        erased = parse_function_at_(x, 0, 1, from)
        if erased == 1 {
            // erased whole: drop the modifier blanks made before it too
            edits_truncate_(x, ne_start)
            blank_(x, tk_start_(x, from), x.last_end)
        } else if erase_whole == 1 && x.err == "" {
            fail_at_(x, tk_start_(x, from), "an abstract or declare method cannot have a body")
        }
        return
    }
    if is_method_kw == 1 {
        expect_(x, "(")
        return
    }
    // a field
    erase_annotation_(x)
    if at_(x, "=") == 1 {
        advance_(x)
        fn_push_(x)
        parse_assign_(x)
        fn_pop_(x)
    }
    if at_(x, ";") == 1 { advance_(x) } else { semi_(x) }
    if erase_whole == 1 && x.err == "" {
        edits_truncate_(x, ne_start)
        blank_(x, tk_start_(x, from), x.last_end)
    }
}

// A property key in an object literal or class body: a name, #private,
// string, number, or [computed]. 1 if one was read.
parse_prop_key_(x: *Lx) -> int {
    if at_(x, "#") == 1 && is_ident_tok_(x, x.pos + 1) == 1 {
        advance_(x)
        advance_(x)
        return 1
    }
    if at_(x, "[") == 1 {
        advance_(x)
        parse_assign_(x)
        expect_(x, "]")
        return 1
    }
    k = tk_kind_(x, x.pos)
    if k == T_IDENT || k == T_STR || k == T_NUM {
        advance_(x)
        return 1
    }
    fail_at_(x, tk_start_(x, x.pos), "expected a property name")
    return 0
}

// ---------------------------------------------------------------------------
// Expressions

parse_expr_(x: *Lx) {
    parse_assign_(x)
    while at_(x, ",") == 1 && x.err == "" {
        advance_(x)
        parse_assign_(x)
    }
}

// The no-'in' variants for a for(;;) head share the code through a flag:
// 'in' is never a binary operator while it is set.
parse_expr_no_in_(x: *Lx) {
    parse_assign_inner_(x, 1)
    while at_(x, ",") == 1 && x.err == "" {
        advance_(x)
        parse_assign_inner_(x, 1)
    }
}

parse_assign_no_in_(x: *Lx) {
    parse_assign_inner_(x, 1)
}

parse_assign_(x: *Lx) {
    parse_assign_inner_(x, 0)
}

is_assign_op_(x: *Lx) -> int {
    if tk_kind_(x, x.pos) != T_PUNCT { return 0 }
    if at_(x, "=") == 1 || at_(x, "+=") == 1 || at_(x, "-=") == 1 || at_(x, "*=") == 1 || at_(x, "/=") == 1 { return 1 }
    if at_(x, "%=") == 1 || at_(x, "<<=") == 1 || at_(x, ">>=") == 1 || at_(x, ">>>=") == 1 { return 1 }
    if at_(x, "&=") == 1 || at_(x, "|=") == 1 || at_(x, "^=") == 1 || at_(x, "**=") == 1 { return 1 }
    if at_(x, "&&=") == 1 || at_(x, "||=") == 1 || at_(x, "??=") == 1 { return 1 }
    return 0
}

parse_assign_inner_(x: *Lx, no_in: int) {
    if x.err != "" { return }
    if arrow_ahead_(x, x.pos) == 1 {
        parse_arrow_(x)
        return
    }
    if at_(x, "yield") == 1 {
        advance_(x)
        if at_(x, "*") == 1 { advance_(x) }
        if tk_nlb_(x, x.pos) == 0 && at_(x, ")") == 0 && at_(x, "]") == 0 && at_(x, "}") == 0 && at_(x, ",") == 0 && at_(x, ";") == 0 && at_(x, ":") == 0 && tk_kind_(x, x.pos) != T_EOF {
            parse_assign_inner_(x, no_in)
        }
        return
    }
    parse_conditional_(x, no_in)
    if is_assign_op_(x) == 1 {
        advance_(x)
        parse_assign_inner_(x, no_in)
    }
}

parse_conditional_(x: *Lx, no_in: int) {
    parse_binary_(x, 0, no_in)
    if at_(x, "?") == 1 {
        advance_(x)
        parse_assign_(x)
        expect_(x, ":")
        parse_assign_inner_(x, no_in)
    }
}

// Binary precedence of the operator at the cursor, 0 if none.
binop_prec_(x: *Lx, no_in: int) -> int {
    k = tk_kind_(x, x.pos)
    if k == T_IDENT {
        if at_(x, "instanceof") == 1 { return 7 }
        if at_(x, "in") == 1 && no_in == 0 { return 7 }
        if (at_(x, "as") == 1 || at_(x, "satisfies") == 1) && tk_nlb_(x, x.pos) == 0 { return 7 }
        return 0
    }
    if k != T_PUNCT { return 0 }
    if at_(x, "??") == 1 { return 1 }
    if at_(x, "||") == 1 { return 1 }
    if at_(x, "&&") == 1 { return 2 }
    if at_(x, "|") == 1 { return 3 }
    if at_(x, "^") == 1 { return 4 }
    if at_(x, "&") == 1 { return 5 }
    if at_(x, "==") == 1 || at_(x, "!=") == 1 || at_(x, "===") == 1 || at_(x, "!==") == 1 { return 6 }
    if at_(x, "<") == 1 || at_(x, ">") == 1 || at_(x, "<=") == 1 || at_(x, ">=") == 1 { return 7 }
    if at_(x, "<<") == 1 || at_(x, ">>") == 1 || at_(x, ">>>") == 1 { return 8 }
    if at_(x, "+") == 1 || at_(x, "-") == 1 { return 9 }
    if at_(x, "*") == 1 || at_(x, "/") == 1 || at_(x, "%") == 1 { return 10 }
    if at_(x, "**") == 1 { return 11 }
    return 0
}

parse_binary_(x: *Lx, min_prec: int, no_in: int) {
    parse_unary_(x)
    while x.err == "" {
        p = binop_prec_(x, no_in)
        if p == 0 || p <= min_prec { return }
        if at_(x, "as") == 1 || at_(x, "satisfies") == 1 {
            s = tk_start_(x, x.pos)
            if tk_is_(x, x.pos + 1, "const") == 1 {
                j = x.pos + 2
            } else {
                j = skip_type_(x, x.pos + 1)
            }
            if j < 0 {
                fail_at_(x, tk_start_(x, x.pos + 1), "cannot read this type")
                return
            }
            blank_(x, s, tk_end_(x, j - 1))
            x.pos = j
            x.last_end = tk_end_(x, j - 1)
        } else {
            advance_(x)
            // ** is right-associative: a ** b ** c is a ** (b ** c)
            if p == 11 { parse_binary_(x, 10, no_in) } else { parse_binary_(x, p, no_in) }
        }
    }
}

parse_unary_(x: *Lx) {
    if x.err != "" { return }
    k = tk_kind_(x, x.pos)
    if k == T_PUNCT {
        if at_(x, "!") == 1 || at_(x, "~") == 1 || at_(x, "+") == 1 || at_(x, "-") == 1 || at_(x, "++") == 1 || at_(x, "--") == 1 {
            advance_(x)
            parse_unary_(x)
            return
        }
        if at_(x, "<") == 1 {
            // a TS type assertion <T>expr
            j = skip_type_args_(x, x.pos)
            if j < 0 {
                fail_at_(x, tk_start_(x, x.pos), "unexpected '<'")
                return
            }
            erase_tokens_(x, x.pos, j)
            parse_unary_(x)
            return
        }
    }
    if k == T_IDENT {
        if at_(x, "typeof") == 1 || at_(x, "void") == 1 || at_(x, "delete") == 1 {
            advance_(x)
            parse_unary_(x)
            return
        }
        if at_(x, "await") == 1 && tk_nlb_(x, x.pos + 1) == 0 && starts_expr_(x, x.pos + 1) == 1 {
            note_await_(x, x.pos)
            advance_(x)
            parse_unary_(x)
            return
        }
    }
    parse_postfix_(x)
}

// Can an expression start at token i? (So `await x` is an await, and an
// identifier named await is not.)
starts_expr_(x: *Lx, i: int) -> int {
    k = tk_kind_(x, i)
    if k == T_EOF { return 0 }
    if k != T_PUNCT { return 1 }
    if tk_is_(x, i, "(") == 1 || tk_is_(x, i, "[") == 1 || tk_is_(x, i, "{") == 1 { return 1 }
    if tk_is_(x, i, "!") == 1 || tk_is_(x, i, "~") == 1 || tk_is_(x, i, "+") == 1 || tk_is_(x, i, "-") == 1 { return 1 }
    if tk_is_(x, i, "++") == 1 || tk_is_(x, i, "--") == 1 || tk_is_(x, i, "<") == 1 || tk_is_(x, i, "#") == 1 { return 1 }
    return 0
}

parse_postfix_(x: *Lx) {
    parse_call_member_(x)
    while x.err == "" {
        if (at_(x, "++") == 1 || at_(x, "--") == 1) && tk_nlb_(x, x.pos) == 0 {
            advance_(x)
        } else if at_(x, "!") == 1 && tk_nlb_(x, x.pos) == 0 && at_off_(x, 1, "=") == 0 {
            // TS non-null assertion
            blank_(x, tk_start_(x, x.pos), tk_end_(x, x.pos))
            advance_(x)
            parse_call_member_tail_(x)
        } else {
            return
        }
    }
}

parse_call_member_(x: *Lx) {
    if at_(x, "new") == 1 {
        advance_(x)
        if at_(x, ".") == 1 {
            // new.target
            advance_(x)
            advance_(x)
            parse_call_member_tail_(x)
            return
        }
        // the constructor: a member expression without calls
        parse_primary_(x)
        while x.err == "" {
            if at_(x, ".") == 1 {
                advance_(x)
                if at_(x, "#") == 1 { advance_(x) }
                advance_(x)
            } else if at_(x, "[") == 1 {
                advance_(x)
                parse_expr_(x)
                expect_(x, "]")
            } else {
                break
            }
        }
        if at_(x, "<") == 1 {
            j = skip_type_args_(x, x.pos)
            if j > 0 && tk_is_(x, j, "(") == 1 { erase_tokens_(x, x.pos, j) }
        }
        if at_(x, "(") == 1 { parse_args_(x) }
        parse_call_member_tail_(x)
        return
    }
    parse_primary_(x)
    parse_call_member_tail_(x)
}

parse_call_member_tail_(x: *Lx) {
    while x.err == "" {
        if at_(x, ".") == 1 || at_(x, "?.") == 1 {
            opt = at_(x, "?.")
            advance_(x)
            if opt == 1 && at_(x, "(") == 1 {
                parse_args_(x)
            } else if opt == 1 && at_(x, "[") == 1 {
                advance_(x)
                parse_expr_(x)
                expect_(x, "]")
            } else {
                if at_(x, "#") == 1 { advance_(x) }
                if tk_kind_(x, x.pos) != T_IDENT {
                    fail_at_(x, tk_start_(x, x.pos), "expected a property name after '.'")
                    return
                }
                advance_(x)
            }
        } else if at_(x, "[") == 1 {
            advance_(x)
            parse_expr_(x)
            expect_(x, "]")
        } else if at_(x, "(") == 1 {
            parse_args_(x)
        } else if at_(x, "<") == 1 && tk_nlb_(x, x.pos) == 0 {
            // f<T>(...): type arguments, if what follows is a call
            j = skip_type_args_(x, x.pos)
            if j > 0 && (tk_is_(x, j, "(") == 1 || tk_kind_(x, j) == T_TPL_FULL || tk_kind_(x, j) == T_TPL_HEAD) {
                erase_tokens_(x, x.pos, j)
            } else {
                return
            }
        } else if tk_kind_(x, x.pos) == T_TPL_FULL || tk_kind_(x, x.pos) == T_TPL_HEAD {
            // a tagged template
            parse_template_(x)
        } else {
            return
        }
    }
}

parse_args_(x: *Lx) {
    expect_(x, "(")
    while at_(x, ")") == 0 && x.err == "" {
        if at_(x, "...") == 1 { advance_(x) }
        parse_assign_(x)
        if at_(x, ",") == 1 { advance_(x) } else { break }
    }
    expect_(x, ")")
}

parse_primary_(x: *Lx) {
    if x.err != "" { return }
    i = x.pos
    k = tk_kind_(x, i)
    if k == T_NUM || k == T_STR || k == T_REGEX {
        advance_(x)
        return
    }
    if k == T_TPL_FULL || k == T_TPL_HEAD {
        parse_template_(x)
        return
    }
    if k == T_IDENT {
        if tk_is_(x, i, "function") == 1 {
            parse_function_(x, 0, 0)
            return
        }
        if tk_is_(x, i, "async") == 1 && tk_is_(x, i + 1, "function") == 1 && tk_nlb_(x, i + 1) == 0 {
            parse_function_(x, 0, 0)
            return
        }
        if tk_is_(x, i, "class") == 1 {
            parse_class_(x, 0)
            return
        }
        if tk_is_(x, i, "import") == 1 && tk_is_(x, i + 1, ".") == 1 {
            fail_at_(x, tk_start_(x, i), "import.meta is not available: a page has no module URL of its own")
            return
        }
        cap_check_(x, i)
        advance_(x)
        return
    }
    if k == T_PUNCT {
        if tk_is_(x, i, "(") == 1 {
            advance_(x)
            parse_expr_(x)
            expect_(x, ")")
            return
        }
        if tk_is_(x, i, "[") == 1 {
            parse_array_(x)
            return
        }
        if tk_is_(x, i, "{") == 1 {
            parse_object_(x)
            return
        }
        if tk_is_(x, i, "#") == 1 && is_ident_tok_(x, i + 1) == 1 {
            // #field in obj
            advance_(x)
            advance_(x)
            return
        }
    }
    if k == T_EOF {
        fail_at_(x, tk_start_(x, i), "unexpected end of the page")
        return
    }
    fail_at_(x, tk_start_(x, i), "unexpected '${tk_text_(x, i)}'")
}

parse_array_(x: *Lx) {
    expect_(x, "[")
    while at_(x, "]") == 0 && x.err == "" {
        if at_(x, ",") == 1 {
            advance_(x)
        } else {
            if at_(x, "...") == 1 { advance_(x) }
            parse_assign_(x)
            if at_(x, ",") == 1 { advance_(x) } else { break }
        }
    }
    expect_(x, "]")
}

parse_object_(x: *Lx) {
    expect_(x, "{")
    while at_(x, "}") == 0 && x.err == "" {
        i = x.pos
        if at_(x, "...") == 1 {
            advance_(x)
            parse_assign_(x)
        } else {
            is_method_kw = 0
            if (at_(x, "async") == 1 || at_(x, "get") == 1 || at_(x, "set") == 1) && member_key_follows_(x, x.pos) == 0 && at_off_(x, 1, ",") == 0 {
                advance_(x)
                is_method_kw = 1
            }
            if at_(x, "*") == 1 {
                advance_(x)
                is_method_kw = 1
            }
            ki = x.pos
            kk = tk_kind_(x, ki)
            if parse_prop_key_(x) == 0 { return }
            if at_(x, "(") == 1 || at_(x, "<") == 1 {
                parse_function_(x, 0, 1)
            } else if is_method_kw == 1 {
                expect_(x, "(")
                return
            } else if at_(x, ":") == 1 {
                advance_(x)
                parse_assign_(x)
            } else if kk == T_IDENT && (at_(x, ",") == 1 || at_(x, "}") == 1 || at_(x, "=") == 1) {
                // shorthand { a }, or { a = 1 } in a destructuring assignment
                cap_check_(x, ki)
                if at_(x, "=") == 1 {
                    advance_(x)
                    parse_assign_(x)
                }
            } else {
                fail_at_(x, tk_start_(x, x.pos), "expected ':' after a property name")
                return
            }
        }
        if at_(x, ",") == 1 { advance_(x) } else { break }
    }
    expect_(x, "}")
}

// A template literal (or a tagged template's): its substitutions are
// expressions, parsed for their TypeScript and names; the rest stays.
parse_template_(x: *Lx) {
    if tk_kind_(x, x.pos) == T_TPL_FULL {
        advance_(x)
        return
    }
    advance_(x)   // HEAD
    while x.err == "" {
        parse_expr_(x)
        kj = tk_kind_(x, x.pos)
        if kj == T_TPL_MID {
            advance_(x)
        } else if kj == T_TPL_TAIL {
            advance_(x)
            return
        } else {
            fail_at_(x, tk_start_(x, x.pos), "expected '}' to close a template substitution")
            return
        }
    }
}

// ---------------------------------------------------------------------------

lx_new_(src: string) -> *Lx {
    x = heap.new(Lx)
    x.src = src
    x.n = string.length(src)
    x.kind = iv_new_()
    x.start = iv_new_()
    x.end = iv_new_()
    x.nlb = iv_new_()
    x.mate = iv_new_()
    x.err = ""
    x.pos = 0
    x.last_end = 0
    x.gt_tok = -1
    x.gt_used = 0
    x.ta_depth = 0
    x.es = iv_new_()
    x.ee = iv_new_()
    x.eq = iv_new_()
    x.er = strarr.new()
    x.ei = iv_new_()
    x.seq = 0
    x.sc_names = strarr.new()
    x.sc_mark = iv_new_()
    x.fn_vars = strarr.new()
    x.fn_varbase = iv_new_()
        x.sealed = ","
    x.sought = ","
    x.optional = ","
    x.scopes = ""
    x.hides = strarr.new()
    x.hide_base = iv_new_()
    x.is_module = 0
    x.has_io = 0
    x.tla = 0
    x.tla_off = 0
    x.imports = ""
    x.wrapped = 0
    return x
}

lx_free_(x: *Lx) {
    iv_free_(x.kind as *IVec)
    iv_free_(x.start as *IVec)
    iv_free_(x.end as *IVec)
    iv_free_(x.nlb as *IVec)
    iv_free_(x.mate as *IVec)
    iv_free_(x.es as *IVec)
    iv_free_(x.ee as *IVec)
    iv_free_(x.eq as *IVec)
    strarr.free(x.er)
    iv_free_(x.ei as *IVec)
    strarr.free(x.sc_names)
    iv_free_(x.sc_mark as *IVec)
    strarr.free(x.fn_vars)
    iv_free_(x.fn_varbase as *IVec)
    strarr.free(x.hides)
    iv_free_(x.hide_base as *IVec)
    heap.free(x)
}

// What the last page lowered seeks: the privileges it requires, as
// ",local-filesystem,"; those it can do without; and its scoped seeks, one
// per line as "privilege\tVERBS\tpattern".
var last_seeks_: string = ""
var last_optional_: string = ""
var last_scopes_: string = ""
// ... and what it imports ("spec\tline\tcol" per line), and whether its
// output is a function expression to call with the loader object.
var last_imports_: string = ""
var last_wrapped_: int = 0

page_seeks() -> string { return last_seeks_ }
page_optional() -> string { return last_optional_ }
page_scopes() -> string { return last_scopes_ }
page_imports() -> string { return last_imports_ }
page_wrapped() -> int { return last_wrapped_ }

// Lower one page. Returns (js_source, error): error is "" on success, or
// "name:line:col: message".
lower_source(src: string, name: string) -> (string, string) {
    return lower_unit_(src, name, 0, "")
}

// Lower one module: exports allowed, no seeks of its own; it may name the
// privileged objects of `seeks`, the importing page's (",outgoing-http,"),
// as if it had sought them. Its output is always a function expression
// (page_wrapped() is 1) taking ($sae, $exports).
lower_module(src: string, name: string, seeks: string) -> (string, string) {
    return lower_unit_(src, name, 1, seeks)
}

lower_unit_(src: string, name: string, is_module: int, seeks: string) -> (string, string) {
    x = lx_new_(src)
    x.is_module = is_module
    if is_module == 1 {
        parts = string.split(seeks, ",")
        np = string.string_array_size(parts)
        k = 0
        while k < np {
            obj = object_of_(string.string_array_get(parts, k))
            if obj != "" && string.contains(x.sealed, ",${obj},") == 0 { x.sealed = string.concat(x.sealed, "${obj},") }
            k = k + 1
        }
    }
    lex_(x)
    if x.err == "" { match_brackets_(x) }
    if x.err == "" { parse_program_(x) }
    out = ""
    last_seeks_ = ""
    last_optional_ = ""
    last_scopes_ = ""
    last_imports_ = ""
    last_wrapped_ = 0
    if x.err == "" {
        out = apply_edits_(x)
        last_seeks_ = string.copy(x.sought)
        last_optional_ = string.copy(x.optional)
        last_scopes_ = string.copy(x.scopes)
        last_imports_ = string.copy(x.imports)
        last_wrapped_ = x.wrapped
    }
    err = ""
    if x.err != "" { err = "${name}:${x.err_line}:${x.err_col}: ${x.err}" }
    lx_free_(x)
    return out, err
}
