}

// printing.pdf(base64, title): a PDF the page made (its bytes as base64) to
// the system's print dialog, its job named title, if capabilities.print
// lets the app print. App mode only.
sae_printing_pdf(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    pdf = own_(arg_str_(ctx, argv, argc, 0))
    why = printing.refusal(browser_of_(p).printing, pdf)
    if why != "" { return sae_throw_type_error(ctx, why) }
    later_add_(browser_of_(p), LATER_PRINT_PDF, pdf, own_(arg_str_(ctx, argv, argc, 1)))   // the dialog and its file, after the entry
    return 0
}

// shell.open(url): hand a URL to the system (the default browser for https:),
// if capabilities.shell.open lists a prefix of it. App mode only.
sae_shell_open(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    url = own_(arg_str_(ctx, argv, argc, 0))
    why = shell.refusal(browser_of_(p).shell, url)
    if why != "" { return sae_throw_type_error(ctx, why) }
    later_add_(browser_of_(p), LATER_SHELL_OPEN, url, "")   // handed to the system, after the entry
    return 0
}

// --- the page API: storage ---
//
// storage.get(key) / set(key, value) / remove(key): string values that
// outlive the page and the process, like localStorage. Scoped to the app (in
// app mode) or the page's origin (in the browser), so one site never reads
// another's. Keys are letters, digits, '.', '_' and '-'. The file system is
// the kernel's (storage_file_ below); a page reaches only these three calls.

sae_storage_get(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_str_, own_, quickjs, sae_throw_type_error, storage_key_ok_, storage_read_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.get(key): key must be letters, digits, '.', '_' or '-'") }
    v, found = storage_read_(p.storage_dir, key)
    if found == 0 { return quickjs.new_null(ctx) }
    return quickjs.new_string(ctx, v)
}

sae_storage_set(p: *Page, this_val: int, argv: int) -> int {
    seal except STORAGE_MAX, arg_str_, esc_storage_over_, esc_storage_refuse_, own_, quickjs, sae_throw_type_error, storage_key_ok_, storage_write_, `string`
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.set(key, value): key must be letters, digits, '.', '_' or '-'") }
    val = own_(arg_str_(ctx, argv, argc, 1))
    if string.length(val) > STORAGE_MAX { return sae_throw_type_error(ctx, "storage.set: value over 1 MB") }
    if esc_storage_over_(p.storage_dir, key, string.length(val)) == 1 { return esc_storage_refuse_(ctx, p) }   // wave1/escape: the origin's cap
    if storage_write_(p.storage_dir, key, val) == 0 { return sae_throw_type_error(ctx, "storage.set: could not save") }
    return 0
}

sae_storage_remove(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_str_, own_, quickjs, sae_throw_type_error, storage_key_ok_, storage_remove_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.remove(key): key must be letters, digits, '.', '_' or '-'") }
    storage_remove_(p.storage_dir, key)
    return 0
}

// vg.resize(h, w, hh) -> h: the scene h is in (h a scene or any shape of
// it) asks for a canvas of w x hh px from now on, in place of the size it
// was made at: its shapes, handlers and bindings stay, and it is drawn
// again at the new size (its canvas pinned so, through aether-ui's width
// and height, on every backend; the canvas's resize hook re-maps the
// viewBox as a window resize does).
sae_vg_resize(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_int_, quickjs, sae_throw_type_error, ui, vg, vg_node_of_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    n = vg_node_of_(p, h)
    if n == null { return sae_throw_type_error(ctx, "vg.resize(h, w, h): h is not a scene or shape this page made") }
    w = arg_int_(ctx, argv, argc, 1, 0)
    hh = arg_int_(ctx, argv, argc, 2, 0)
    if w < 1 || hh < 1 || w > 16384 || hh > 16384 { return sae_throw_type_error(ctx, "vg.resize(h, w, h): w and h must be 1 to 16384 px") }
    scene = vg.node_scene(n)
    cw = ui.canvas_widget(vg.scene_canvas(scene))
    _w = ui.width(cw, w)
    _h = ui.height(cw, hh)
    return quickjs.new_int(ctx, h)
}

sae_vg_set_fill(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_int_, arg_str_, quickjs, sae_throw_type_error, vg, vg_node_of_, vg_repaint_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    n = vg_node_of_(p, arg_int_(ctx, argv, argc, 0, 0))
    if n == null { return sae_throw_type_error(ctx, "vg.set_fill(h, color): h is not a vg shape") }
    vg.element_set_fill(vg.node_element(n), arg_str_(ctx, argv, argc, 1))
    vg_repaint_(n)
    return 0
}

// vg.set_text(h, s): change a vg.text shape's text (a clock, a counter).
sae_vg_set_text(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_int_, arg_str_, quickjs, sae_throw_type_error, vg, vg_node_of_, vg_repaint_
