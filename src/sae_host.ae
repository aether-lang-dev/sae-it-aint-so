// --- the core library's host functions (mode 2 of genengine) ---

// All of print's output goes through C stdio (the engine's log sink for
// non-strings is fwrite to stdout too), then is flushed, so it cannot
// interleave with the host's own println output.
@c_callback
js_print(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    out = sae_stdout()
    i = 0
    while i < argc {
        if i != 0 { putchar(32) }
        v = arg_(argv, i)
        if JS_IsString(ctx, v) != 0 {
            fputs(arg_str_(ctx, argv, argc, i), out)
        } else {
            JS_PrintValueF(ctx, v, JS_DUMP_LONG)
        }
        i = i + 1
    }
    putchar(10)
    fflush(out)
    return sae_js_undefined()
}

@c_callback
js_date_now(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    return JS_NewInt64(ctx, now_unix_ms_())
}

@c_callback
js_performance_now(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    return JS_NewInt64(ctx, now_ms_())
}

@c_callback
js_date_constructor(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    ac = argc & (0 - 1 - FRAME_CF_CTOR)
    float val = 0.0
    if ac == 0 {
        long ms = now_unix_ms_()
        val = ms
    } else {
        if ac == 1 && JS_IsNumber(ctx, arg_(argv, 0)) != 0 {
            p = page_of_(ctx)
            if JS_ToNumber(ctx, p.scratch, arg_(argv, 0)) != 0 { return sae_js_exception() }
            val = mem.get_float64(p.scratch, 0)
        } else {
            return sae_throw_type_error(ctx, "unsupported Date() parameter")
        }
    }
    return JS_NewDate(ctx, val)
}

// --- URLs and fetching ---

// --- http (the kernel side of the http page API) ---

struct HttpJob {
    id: int
    method: string
    url: string
    body: string
    ctype: string
    status: int
    resp: string
    err: string
}

// A request a page is waiting on: which page (by load), and its callback.
struct HttpWait {
    id: int
    page: ptr
    seq: int
    ref: ptr
}

message HttpRun { job: ptr }
message HttpDone { job: ptr }
message HttpTake {}

// Does the blocking request, on a scheduler thread, then hands the job to
// the inbox. One job at a time per fetcher; the pool gives concurrency.
actor HttpFetcher {
    receive {
        HttpRun(job) -> {
            http_do_(job)
            ib = actors.whereis("sae-http-inbox")
            ib ! HttpDone { job: job }
        }
    }
}

// Finished jobs, until the UI thread takes them. http_done_ is touched only
// in these handlers, so the actor serializes every access to it.
var http_done_: ptr = null

actor HttpInbox {
    receive {
        HttpDone(job) -> {
            if http_done_ == null { http_done_ = list.new() }
            list.add(http_done_, job)
        }
        HttpTake() -> {
            long r = 0
            if http_done_ != null {
                if list.size(http_done_) > 0 {
                    j, _ = list.get(http_done_, 0)
                    list.list_remove(http_done_, 0)
                    r = mem.ptr_to_long(j)
                }
            }
            reply r
        }
    }
}

const HTTP_FETCHERS = 4

var http_pool_: ptr = null      // std.list of the fetchers, spawned on first use
var http_next_ = 0
var http_waits_: ptr = null     // std.list of *HttpWait
var http_ids_ = 0
var http_timer_ = 0
var http_allow_: ptr = null     // app mode: strarr of allowed URL prefixes

http_do_(jp: ptr) {
    j = jp as *HttpJob
    req = client.request(j.method, j.url)
    if req == null {
        j.err = "not a valid URL"
        return
    }
    client.set_timeout(req, 15s)
    client.set_follow_redirects(req, 5)
    if j.method == "POST" {
        ct = j.ctype
        if ct == "" { ct = "text/plain" }
        _sb = client.set_body(req, string.bytes(j.body), ct)
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        j.err = own_(err)
        return
    }
    j.status = client.response_status(resp)
    j.resp = own_(client.response_body(resp))
    client.response_free(resp)
}

// "" if a page at page_url may reach url, else why not.
http_refusal_(page_url: string, url: string) -> string {
    if is_http_(url) == 0 { return "http.get/post takes an http(s) URL: ${url}" }
    if app_dir_ != "" {
        if http_allow_ != null {
            n = strarr.size(http_allow_)
            i = 0
            while i < n {
                if string.string_starts_with(url, strarr.get(http_allow_, i)) == 1 { return "" }
                i = i + 1
            }
        }
        return "this app may not reach ${url} (app.json \"http\" lists what it may)"
    }
    if is_http_(page_url) == 1 {
        po = string.string_substring(page_url, 0, origin_end_(page_url))
        uo = string.string_substring(url, 0, origin_end_(url))
        if po == uo { return "" }
    }
    return "a page may reach only its own origin: ${url}"
}

http_start_(ctx: ptr, method: string, url_arg: string, body: string, ctype: string, ref: ptr) -> long {
    p = page_of_(ctx)
    if ref == null { return sae_throw_type_error(ctx, "http: the last argument must be a function") }
    url = resolve_(p.url, url_arg)
    if http_waits_ == null { http_waits_ = list.new() }
    http_ids_ = http_ids_ + 1
    j = heap.new(HttpJob)
    j.id = http_ids_
    j.method = method
    j.url = own_(url)
    j.body = body
    j.ctype = ctype
    j.status = 0
    j.resp = ""
    j.err = http_refusal_(p.url, url)
    w = heap.new(HttpWait)
    w.id = j.id
    w.page = p as ptr
    w.seq = p.seq
    w.ref = ref
    list.add(http_waits_, w as ptr)
    if j.err != "" {
        // Refused: no request, but the answer comes the same way, later.
        ib0 = http_inbox_()
        ib0 ! HttpDone { job: j as ptr }
    } else {
        f = http_fetcher_()
        f ! HttpRun { job: j as ptr }
    }
    if http_timer_ == 0 { http_timer_ = ui.timer(20, || { http_poll_() }) }
    return JS_NewInt32(ctx, j.id)
}

http_inbox_() -> ptr {
    ib = actors.whereis("sae-http-inbox")
    if ib == null {
        ib = spawn(HttpInbox())
        actors.register("sae-http-inbox", ib)
    }
    return ib
}

http_fetcher_() -> ptr {
    _ib = http_inbox_()
    if http_pool_ == null {
        http_pool_ = list.new()
        k = 0
        while k < HTTP_FETCHERS {
            list.add(http_pool_, spawn(HttpFetcher()))
            k = k + 1
        }
    }
    f, _ = list.get(http_pool_, http_next_ % HTTP_FETCHERS)
    http_next_ = http_next_ + 1
    return f
}

// On the UI thread: take every finished job and run its page's callback.
http_poll_() {
    ib = http_inbox_()
    while true {
        jl = ib ? HttpTake {}
        if jl == 0 { break }
        http_deliver_(mem.long_to_ptr(jl) as *HttpJob)
    }
    if list.size(http_waits_) == 0 {
        ui.timer_cancel(http_timer_)
        http_timer_ = 0
    }
}

http_deliver_(j: *HttpJob) {
    n = list.size(http_waits_)
    i = 0
    while i < n {
        wv, _ = list.get(http_waits_, i)
        w = wv as *HttpWait
        if w.id == j.id {
            list.list_remove(http_waits_, i)
            b = browser_
            if b != null {
                cur = (b as *Browser).page
                if cur != null && cur == w.page && (cur as *Page).seq == w.seq {
                    p = cur as *Page
                    r = call3_http_(p.ctx, w.ref, j.status, j.resp, j.err)
                    if sae_js_is_exception(r) != 0 { report_exception_(p.ctx, "an http callback") }
                }
            }
            heap.free(w)
            heap.free(j)
            return
        }
        i = i + 1
    }
    heap.free(j)
}

// fn(status, body, err): each argument pushed as soon as it exists, so it is
// rooted on the engine stack before the next allocation can move anything;
// the function is read from its root last.
call3_http_(ctx: ptr, ref: ptr, status: int, body: string, err: string) -> long {
    if JS_StackCheck(ctx, 5) != 0 { return sae_js_exception() }
    JS_PushArg(ctx, JS_NewString(ctx, err))
    JS_PushArg(ctx, JS_NewString(ctx, body))
    JS_PushArg(ctx, JS_NewInt32(ctx, status))
    JS_PushArg(ctx, mem.get_long(ref, 0))
    JS_PushArg(ctx, sae_js_null())
    return JS_Call(ctx, 3)
}

// --- storage (the kernel side of the storage page API) ---

const STORAGE_MAX = 1048576

storage_key_ok_(k: string) -> int {
    n = string.length(k)
    if n == 0 || n > 128 { return 0 }
    i = 0
    while i < n {
        c = string.char_at(k, i)
        ok = 0
        if c >= 97 && c <= 122 { ok = 1 }
        if c >= 65 && c <= 90 { ok = 1 }
        if c >= 48 && c <= 57 { ok = 1 }
        if c == 46 || c == 95 || c == 45 { ok = 1 }
        if ok == 0 { return 0 }
        i = i + 1
    }
    if string.string_starts_with(k, ".") == 1 { return 0 }
    return 1
}

// The folder a page's storage lives in: one per app, or per origin.
// $SAE_STORAGE_DIR, else ~/.sae/storage.
storage_dir_(url: string) -> string {
    root = env_("SAE_STORAGE_DIR")
    if root == "" { root = "${env_("HOME")}/.sae/storage" }
    scope = "file"
    if is_app_(url) == 1 { scope = string.concat("app-", app_name_) }
    if is_http_(url) == 1 { scope = string.string_substring(url, 0, origin_end_(url)) }
    // A folder name: anything but letters, digits, '.', '-' becomes '_'.
    out = ""
    i = 0
    while i < string.length(scope) {
        c = string.char_at(scope, i)
        keep = 0
        if c >= 97 && c <= 122 { keep = 1 }
        if c >= 65 && c <= 90 { keep = 1 }
        if c >= 48 && c <= 57 { keep = 1 }
        if c == 46 || c == 45 { keep = 1 }
        if keep == 1 { out = string.concat(out, string.from_char(c)) } else { out = string.concat(out, "_") }
        i = i + 1
    }
    return "${root}/${out}"
}

storage_read_(url: string, key: string) -> (string, int) {
    v, err = fs.read("${storage_dir_(url)}/${key}")
    if err != "" { return "", 0 }
    return v, 1
}

storage_write_(url: string, key: string, val: string) -> int {
    d = storage_dir_(url)
    _m = fs.mkdir_p(d)
    werr = fs.write_atomic("${d}/${key}", string.bytes(val))
    if werr != "" { return 0 }
    return 1
}

storage_remove_(url: string, key: string) {
    _r = fs.remove_tree("${storage_dir_(url)}/${key}")
}

is_app_(u: string) -> int {
    return string.string_starts_with(u, "app:")
}

// The file an app: URL names: app:/about is <app>/about.ts (or .js), app:/ is
// the index, and a path that already ends in .ts or .js is taken as it is.
app_file_(url: string) -> string {
    path = string.string_substring(url, 4, string.length(url))
    if path == "" || path == "/" { path = "/index" }
    if string.string_ends_with(path, "/") == 1 { path = string.concat(path, "index") }
    stem = string.concat(app_dir_, path)
    if string.string_ends_with(stem, ".ts") == 1 || string.string_ends_with(stem, ".js") == 1 { return stem }
    if fs.exists("${stem}.ts") == 1 { return "${stem}.ts" }
    return "${stem}.js"
}

// Read an app page. A missing one is the app's own 404 page, as the dev page
// server serves it, when the app has one.
fetch_app_(url: string) -> (int, string, string, string) {
    f = app_file_(url)
    src, ferr = fs.read(f)
    if ferr == "" { return 200, src, own_(url), "" }
    nf = app_file_("app:/404")
    src2, ferr2 = fs.read(nf)
    if ferr2 == "" { return 404, src2, own_(url), "" }
    return 0, "", own_(url), "no such page in this app: ${url}"
}

is_http_(u: string) -> int {
    if string.string_starts_with(u, "http://") == 1 { return 1 }
    if string.string_starts_with(u, "https://") == 1 { return 1 }
    return 0
}

// The end of "scheme://host[:port]" in an http(s) URL.
origin_end_(u: string) -> int {
    start = string.string_index_of(u, "://") + 3
    rest = string.string_substring(u, start, string.length(u))
    slash = string.string_index_of(rest, "/")
    if slash < 0 { return string.length(u) }
    return start + slash
}

// Everything up to and including the last '/' of s (or "" if none).
dir_of_(s: string) -> string {
    i = string.length(s) - 1
    while i >= 0 {
        if string.string_substring(s, i, i + 1) == "/" {
            return string.string_substring(s, 0, i + 1)
        }
        i = i - 1
    }
    return ""
}

// Resolve href against the URL of the page that asked for it. Absolute
// http(s) URLs pass through; "/x" is origin-relative; anything else is
// relative to the base's directory. A base that is a file path resolves the
// same way against the file system.
resolve_(base: string, href: string) -> string {
    if is_http_(href) == 1 { return own_(href) }
    if is_app_(href) == 1 { return own_(href) }
    if is_app_(base) == 1 {
        if string.string_starts_with(href, "/") == 1 { return string.concat("app:", href) }
        return string.concat(dir_of_(base), href)
    }
    if is_http_(base) == 1 {
        oe = origin_end_(base)
        if string.string_starts_with(href, "/") == 1 {
            return string.concat(string.string_substring(base, 0, oe), href)
        }
        path_part = string.string_substring(base, oe, string.length(base))
        if path_part == "" { path_part = "/" }
        return string.concat(string.concat(string.string_substring(base, 0, oe), dir_of_(path_part)), href)
    }
    if string.string_starts_with(href, "/") == 1 { return own_(href) }
    return string.concat(dir_of_(base), href)
}

// Fetch a page. Returns (status, body, final_url, err): status is the HTTP
// status (200 for a file read), final_url is where redirects ended, and err
// is "" unless nothing could be fetched at all.
fetch_(url: string) -> (int, string, string, string) {
    if is_app_(url) == 1 { return fetch_app_(url) }
    if is_http_(url) == 0 {
        src, ferr = fs.read(url)
        if ferr != "" { return 0, "", url, ferr }
        return 200, src, url, ""
    }
    req = client.request("GET", url)
    if req == null { return 0, "", url, "not a valid URL" }
    client.set_timeout(req, 10s)
    client.set_follow_redirects(req, 5)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", url, err }
    status = client.response_status(resp)
    body = client.response_body(resp)
    final_url = own_(client.response_url(resp))
    client.response_free(resp)
    if final_url == "" { final_url = own_(url) }
    return status, body, final_url, ""
}

// --- pages ---

page_new_(b: *Browser, url: string) -> *Page {
    p = heap.new(Page)
    p.browser = b
    p.url = own_(url)
    p.mem_block = malloc(b.page_mem)
    p.stack = malloc(STACK_MAX * 4)
    p.depth = 0
    p.refs = list.new()
    p.scratch = malloc(8)
    p.cbuf = malloc(sae_cstringbuf_size())
    p.ui_ns = 0
    p.ui_calls = 0
    p.vg_stack = malloc(STACK_MAX * 8)
    p.vg_depth = 0
    p.vg_nodes = list.new()
    p.stacks = list.new()
    p.sheet = null
    p.sheet_strs = list.new()
    p.timers = list.new()
    page_seq_ = page_seq_ + 1
    p.seq = page_seq_
    p.ctx = sae_new_context(p.mem_block, b.page_mem)
    JS_SetContextOpaque(p.ctx, p)
    p.root = ui.vstack(mem.long_to_ptr(b.content), 4)
    // After the root: it is the browser's, like the content area it sits in.
    p.first_handle = aether_ui_widget_count_impl() + 1
    push_(p, p.root)
    return p
}

page_free_(p: *Page) {
    // A page's timers stop with it: a tick after this would call into a
    // freed JS context.
    nt = list.size(p.timers)
    ti = 0
    while ti < nt {
        tv, _ = list.get(p.timers, ti)
        tid = mem.ptr_to_long(tv)
        if tid != 0 { ui.timer_cancel(tid) }
        ti = ti + 1
    }
    list.free(p.timers)
    n = list.size(p.refs)
    i = 0
    while i < n {
        ref, _ = list.get(p.refs, i)
        JS_DeleteGCRef(p.ctx, ref)
        free(ref)
        i = i + 1
    }
    list.free(p.refs)
    list.free(p.vg_nodes)
    list.free(p.stacks)
    // The page's sheet styles only its own widgets: un-set it before the
    // next page builds, then free it (free_styles refuses the current one).
    if p.sheet != null {
        aether_ui_current_sheet_set_impl(null)
        ui.free_styles(p.sheet)
    }
    list.free(p.sheet_strs)
    free(p.vg_stack)
    JS_FreeContext(p.ctx)
    free(p.mem_block)
    free(p.stack)
    free(p.scratch)
    free(p.cbuf)
    heap.free(p)
}

// Run page source into the page's content area: parse to bytecode, then run.
// Returns 1 on success. Fills times_ns[0..1] with the parse and run times.
page_run_(p: *Page, src: string, times_ns: ptr) -> int {
    long t0 = os.now_monotonic_ns()
    fnv = JS_Parse(p.ctx, src, string.length(src), p.url, 0)
    long t1 = os.now_monotonic_ns()
    mem.set_long(times_ns, 0, t1 - t0)
    mem.set_long(times_ns, 8, 0)
    if sae_js_is_exception(fnv) != 0 {
        report_exception_(p.ctx, p.url)
        return 0
    }
    r = JS_Run(p.ctx, fnv)
    mem.set_long(times_ns, 8, os.now_monotonic_ns() - t1)
    if sae_js_is_exception(r) != 0 {
        report_exception_(p.ctx, p.url)
        return 0
    }
    return 1
}

// --- navigation ---

set_status_(b: *Browser, s: string) {
    if b.status != 0 { ui.set_text(b.status, s) }
}

// Tear down the current page (its widgets, then its context) and load url
// into the content area. Does not touch history.
load_(b: *Browser, url: string) {
    long t0 = os.now_monotonic_ns()
    status, body, final_url, err = fetch_(url)
    long t_fetch = os.now_monotonic_ns()

    ui.clear_children(b.content)
    if b.page != null {
        page_free_(b.page as *Page)
        b.page = null
    }
    if b.addr != 0 { ui.set_text(b.addr, final_url) }

    if err != "" {
        ui.text(mem.long_to_ptr(b.content), "Could not load ${url}")
        ui.text(mem.long_to_ptr(b.content), err)
        set_status_(b, "error: ${err}")
        println("sae: could not load ${url}: ${err}")
        b.last_ok = 0
        return
    }

    long t_lower0 = os.now_monotonic_ns()
    es5, lerr = lower.lower_source(body, final_url)
    long lower_ns = os.now_monotonic_ns() - t_lower0
    if lerr != "" {
        ui.text(mem.long_to_ptr(b.content), "This page could not be read:")
        ui.text(mem.long_to_ptr(b.content), lerr)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${lerr}")
        b.last_ok = 0
        return
    }

    p = page_new_(b, final_url)
    b.page = p
    times = malloc(16)
    ok = page_run_(p, es5, times)
    long parse_ns = mem.get_long(times, 0)
    long run_ns = mem.get_long(times, 8)
    free(times)
    b.last_ok = ok
    // vg scenes record their shapes while the page builds and draw once it
    // is done (AeVG's deferred mode, so a shape's trailing fill() is known
    // before it paints). Aether's window() drains that after its block; a
    // page loads into an already-running window, so drain it here.
    aether_ui_surface_flush_deferred_impl()
    if ok == 0 {
        ui.text(mem.long_to_ptr(b.content), "This page failed: see the console.")
    }
    set_status_(b, "${status} ${final_url}")
    println("sae: ${status} ${final_url} (us) fetch=${us_(t_fetch - t0)} lower=${us_(lower_ns)} parse=${us_(parse_ns)} run=${us_(run_ns)} widgets=${us_(p.ui_ns)}/${p.ui_calls} js=${us_(run_ns - p.ui_ns)}")
}

hist_url_(b: *Browser, i: int) -> string {
    return strarr.get(b.history, i)
}

// Go to url as a new history entry, dropping any forward entries.
go_(b: *Browser, url: string) {
    i = b.hist_index + 1
    if i < strarr.size(b.history) {
        strarr.set(b.history, i, own_(url))
    } else {
        strarr.push_copy(b.history, url)
    }
    b.hist_index = i
    b.hist_len = i + 1
    load_(b, url)
}

run_nav_(b: *Browser) {
    kind = b.pending_kind
    url = b.pending_url
    b.pending_kind = NAV_NONE
    if kind == NAV_GO {
        // An app's pages navigate only among themselves (Tauri's default).
        if app_dir_ != "" && is_app_(url) == 0 {
            println("sae: this app navigates only to its own pages; refused ${url}")
            fflush(sae_stdout())
            return
        }
        go_(b, url)
    }
    if kind == NAV_BACK {
        if b.hist_index > 0 {
            b.hist_index = b.hist_index - 1
            load_(b, hist_url_(b, b.hist_index))
        }
    }
    if kind == NAV_FORWARD {
        if b.hist_index + 1 < b.hist_len {
            b.hist_index = b.hist_index + 1
            load_(b, hist_url_(b, b.hist_index))
        }
    }
    if kind == NAV_RELOAD {
        if b.hist_index >= 0 { load_(b, hist_url_(b, b.hist_index)) }
    }
}

// Record a navigation and carry it out on the next turn of the event loop.
// The latest request wins, as a second click on a link would.
request_nav_(b: *Browser, kind: int, url: string) {
    b.pending_kind = kind
    b.pending_url = own_(url)
    if b.nav_timer == 0 {
        b.nav_timer = ui.timer(1, || {
            ui.timer_cancel(b.nav_timer)
            b.nav_timer = 0
            run_nav_(b)
        })
    }
}

// --- the window ---

build_chrome_(b: *Browser, root: int) {
    rctx = mem.long_to_ptr(root)
    bar = ui.hstack(rctx, 4)
    bctx = mem.long_to_ptr(bar)
    ui.btn(bctx, "Back", || { request_nav_(b, NAV_BACK, "") })
    ui.btn(bctx, "Forward", || { request_nav_(b, NAV_FORWARD, "") })
    ui.btn(bctx, "Reload", || { request_nav_(b, NAV_RELOAD, "") })
    b.addr = ui.textfield(bctx, "address", |s: string| { })
    ui.btn(bctx, "Go", || {
        typed = ui.get_text(b.addr)
        base = ""
        if b.page != null { base = (b.page as *Page).url }
        request_nav_(b, NAV_GO, resolve_(base, typed))
    })
    b.status = ui.text(rctx, "")
    ui.divider(rctx)
    build_content_(b, rctx)
}

// The scrolling area pages build into. In app mode it is all there is.
build_content_(b: *Browser, rctx: ptr) {
    scroller = ui.scrollview(rctx)
    b.content = ui.vstack(mem.long_to_ptr(scroller), 4)
}

browser_new_() -> *Browser {
    b = heap.new(Browser)
    b.history = strarr.new()
    b.hist_len = 0
    b.hist_index = -1
    b.page = null
    b.pending_kind = NAV_NONE
    b.nav_timer = 0
    b.page_mem = PAGE_MEM_DEFAULT
    pm = env_("SAE_PAGE_MEM")
    if pm != "" {
        v, perr = string.to_long(pm)
        if perr == "" && v > 0 { b.page_mem = v }
    }
    return b
}

// --- app mode ---
//
// `sae --app <dir>`, or a binary that finds its pages beside it in a macOS
// .app bundle (Contents/Resources/app): no browser chrome, the window titled
// and sized for the app, pages loaded from <dir> as app: URLs. The optional
// <dir>/app.json:
//   { "name": "Banking", "start": "/", "width": 800, "height": 600 }

// The pages a packaged binary carries: <exe dir>/../Resources/app (the .app
// layout tools/saepack.sh makes), or "" when there are none.
bundled_app_dir_(exe: string) -> string {
    d = string.concat(dir_of_(exe), "../Resources/app")
    if fs.exists("${d}/app.json") == 1 { return d }
    if fs.exists("${d}/index.ts") == 1 { return d }
    if fs.exists("${d}/index.js") == 1 { return d }
    return ""
}

// A string or int setting from app.json, or the default.
app_setting_(v: ptr, key: string, dflt: string) -> string {
    if v == null { return dflt }
    f = json.json_object_get_raw(v, key)
    if f == null { return dflt }
    sv, serr = json.get_string(f)
    if serr != "" { return dflt }
    return own_(sv)
}

app_setting_int_(v: ptr, key: string, dflt: int) -> int {
    if v == null { return dflt }
    f = json.json_object_get_raw(v, key)
    if f == null { return dflt }
    return json.json_get_int(f)
}

// The last path component, for an app's default name.
base_name_(d: string) -> string {
    t = d
    while string.string_ends_with(t, "/") == 1 { t = string.string_substring(t, 0, string.length(t) - 1) }
    return string.string_substring(t, string.length(dir_of_(t)), string.length(t))
}

// sae <url | page>             the browser
// sae --app <dir>              an app, without browser chrome
// sae (in a packaged .app)     the app bundled beside the binary
@c_callback
sae_main(arg1: string, arg2: string, exe: string) -> int {
    app = ""
    start_url = arg1
    if arg1 == "--app" { app = arg2 }
    if arg1 == "" { app = bundled_app_dir_(exe) }
    if app == "" && start_url == "" {
        println("usage: sae <url | page.js>   or   sae --app <dir>")
        return 2
    }
    title = "Sae it ain't so"
    w = 800
    h = 600
    b = browser_new_()
    browser_ = b as ptr
    root = aether_ui_vstack_create(6)
    if app != "" {
        while string.string_ends_with(app, "/") == 1 { app = string.string_substring(app, 0, string.length(app) - 1) }
        app_dir_ = own_(app)
        manifest = null
        mtext, merr = fs.read("${app}/app.json")
        if merr == "" {
            mv, _jerr = json.parse(mtext)
            manifest = mv
        }
        title = app_setting_(manifest, "name", base_name_(app))
        app_name_ = own_(title)
        w = app_setting_int_(manifest, "width", 800)
        h = app_setting_int_(manifest, "height", 600)
        start_url = resolve_("app:/", app_setting_(manifest, "start", "/"))
        http_allow_ = strarr.new()
        if manifest != null {
            al = json.json_object_get_raw(manifest, "http")
            if al != null {
                na = json.json_array_size(al)
                ai = 0
                while ai < na {
                    sv, serr = json.get_string(json.json_array_get_raw(al, ai))
                    if serr == "" { strarr.push_copy(http_allow_, sv) }
                    ai = ai + 1
                }
            }
        }
        build_content_(b, mem.long_to_ptr(root))
    } else {
        build_chrome_(b, root)
    }
    go_(b, start_url)

    if env_("SAE_NO_WINDOW") != "" {
        if b.page != null { page_free_(b.page as *Page) }
        if b.last_ok == 1 { return 0 }
        return 1
    }
    port = env_("AETHER_UI_TEST_PORT")
    if port != "" {
        pn, _ = string.to_int(port)
        ui.enable_test_server_root(pn, root)
    }
    ui.window_run(title, w, h, root)
    if b.page != null { page_free_(b.page as *Page) }
    return 0
}
