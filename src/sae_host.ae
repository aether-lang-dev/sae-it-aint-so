    // A privilege the page can do without and was not granted has no object at
    // all, so `typeof http === "undefined"` tells the page.
    space(g, "http", WHEN_APP_OR_WEB_SEEKS, "outgoing-http") {
        api("get", sae_http_get, 2) {
            arg("url", T_STR)
            arg_ts("fn", "(res: sae.HttpResponse) => void")
            gives_ts("sae.HttpRequest")
            doc("GETs url on an actor; fn(res) runs on the UI thread. Where a page may reach is the kernel's decision: refused, res.ok is false and res.error says why.")
        }
        api("post", sae_http_post, 4) {
            arg("url", T_STR)
            arg("body", T_STR)
            arg("contentType", T_STR)
            arg_ts("fn", "(res: sae.HttpResponse) => void")
            gives_ts("sae.HttpRequest")
            doc("POSTs body as contentType; fn(res) runs on the UI thread.")
        }
        api("cancel", sae_http_cancel, 1) {
            arg("id", T_INT)
            doc("The request's callback will not run (the request may still finish on its actor).")
        }
        api("request", sae_http_request, 2) {
            arg_ts("options", "sae.HttpOptions")
            arg_ts("fn", "(res: sae.HttpResponse) => void")
            gives_ts("sae.HttpRequest")
            doc("A request of any method, with headers; res.headers holds the answer's, with lowercased names.")
        }
        provided("fetch", 1) {
            arg_ts("urlOrOptions", "string | sae.HttpOptions")
            gives_ts("Promise<sae.HttpResponse>")
            doc("The same request as a promise of the same response object, refused the same way (res.ok false, never a rejection).")
        }
        js_wrapper("sae:http", HTTP_FETCH_JS)
    }
