    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "setInterval(fn, ms, ...args): fn must be a function (sae does not eval a string)") }
    ms = delay_arg_(ctx, argv, argc, 1)
    return quickjs.new_int(ctx, timer_add_(page_of_(ctx), ref, rest_args_(ctx, argv, argc, 2), ms, 1, 0))
}

// Release a list of PageRaf records' handles and free them.
rafs_drop_(p: *Page, l: ptr) {
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        r = v as *PageRaf
        if r.fn_h != 0 { quickjs.release(p.ctx, r.fn_h) }
        heap.free(r)
        i = i + 1
    }
}

// One display frame for the page: run the callbacks requested before it
// began, each with the same timestamp, then stop the subscription if no
// callback asked for another frame.
rafs_frame_(ctx: ptr) {
    p = page_of_(ctx)
    if p == null { return }
    batch = p.rafs
    p.rafs = list.new()
    p.raf_batch = batch
    ts = raf_now_()
    n = list.size(batch)
    i = 0
    while i < n {
        v, _ = list.get(batch, i)
        r = v as *PageRaf
        if r.id != 0 {
            r.id = 0
            a = quickjs.new_array(ctx)
            fh = quickjs.new_float(ctx, ts)
            _e = quickjs.set_index(ctx, a, 0, fh)
            quickjs.release(ctx, fh)
            if calln_(ctx, r.fn_h, a) < 0 { report_exception_(ctx, "an animation frame callback") }
            quickjs.release(ctx, a)
            settle_(ctx)
        }
        i = i + 1
    }
    p.raf_batch = null
    rafs_drop_(p, batch)
    list.free(batch)
    if list.size(p.rafs) == 0 && p.frame_sub != 0 {
        ui.frame_cancel(p.frame_sub)
        p.frame_sub = 0
    }
}

// requestAnimationFrame(fn) / ui.frame(fn): call fn(timestamp) once, on the
// next display frame. Returns an id for cancelAnimationFrame.
sae_request_frame(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "requestAnimationFrame(fn): fn must be a function") }
    r = heap.new(PageRaf)
    p.raf_ids = p.raf_ids + 1
    r.id = p.raf_ids
    r.fn_h = ref
    list.add(p.rafs, r as ptr)
    if p.frame_sub == 0 {
        p.frame_sub = ui.on_frame(|t: float| { rafs_frame_(ctx) })
    }
    return quickjs.new_int(ctx, r.id)
}

// cancelAnimationFrame(id) / ui.frame_cancel(id): the callback will not run,
// even if its frame has begun. Another id is ignored.
sae_cancel_frame(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    id = arg_int_(ctx, argv, argc, 0, 0)
    if id <= 0 { return 0 }
    raf_cancel_in_(p.rafs, id)
    if p.raf_batch != null { raf_cancel_in_(p.raf_batch, id) }
    return 0
}

raf_cancel_in_(l: ptr, id: int) {
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        r = v as *PageRaf
        if r.id == id { r.id = 0 }
        i = i + 1
    }
}

// --- the page API: http, on Aether's actor core ---
//
//   const req = http.get(url, (res) => {
//     if (!res.ok) { show(res.error || `HTTP ${res.status}`); return; }
//     render(res.json());          // or res.text
//   });
//   http.post(url, body, contentType, (res) => ...)
//   req.cancel()                   // its callback will not run
//
// res is { ok, status, text, error, json() }: ok is a 2xx answer; status is
// 0 when nothing came back; error is "" unless the request failed or was
// refused.
//
// The request runs on an Aether actor (an HttpFetcher, one of a small pool),
// on the scheduler's threads, so the UI thread never waits on the network.
// Each finished job goes to the HttpInbox actor; while any are in flight a
// UI timer asks the inbox for them and runs the page's callback on the UI
// thread, where the JS engine lives. A reply for a page that has since gone,
// or for a cancelled request, is dropped.
//
// Where a page may reach: in the browser, its own origin; in an app, the
// URL prefixes app.json lists under capabilities.http (Tauri's allowlist,
// deny by default), checked in services/net before any socket and on every
// redirect hop. The rest is refused: res.ok false, res.error saying why,
// delivered the same way.

sae_http_get(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    return http_start_(ctx, "GET", own_(arg_str_(ctx, argv, argc, 0)), "", "", null, held_fn_(ctx, argv, argc, 1))
}

// http.cancel(id): what req.cancel() calls. The request may still run to
// completion on its actor; its callback will not.
sae_http_cancel(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    http_cancel_(page_of_(ctx), arg_int_(ctx, argv, argc, 0, 0))
    return 0
}

sae_http_post(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    return http_start_(ctx, "POST", own_(arg_str_(ctx, argv, argc, 0)),
                       own_(arg_str_(ctx, argv, argc, 1)), own_(arg_str_(ctx, argv, argc, 2)),
                       null, held_fn_(ctx, argv, argc, 3))
}

// http.request({ method, url, headers, body, contentType }, (res) => ...):
// any method, request headers; res.headers holds the response's, lowercased.
sae_http_request(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if argc < 2 { return sae_throw_type_error(ctx, "http.request(options, fn)") }
    opt = quickjs.arg(ctx, argv, 0)
    method = js_prop_str_(ctx, opt, "method", "GET")
    url = js_prop_str_(ctx, opt, "url", "")
    body = js_prop_str_(ctx, opt, "body", "")
    ctype = js_prop_str_(ctx, opt, "contentType", "")
    hdrs = null
    hv, _e = quickjs.get(ctx, opt, "headers")
    if quickjs.type_of(ctx, hv) == "object" {
        keys = quickjs.keys(ctx, hv)
        hdrs = strarr.new()
        n = quickjs.length(ctx, keys)
        i = 0
        while i < n {
            name = js_key_(ctx, keys, i)
            val = js_prop_str_(ctx, hv, name, "")
            strarr.push_copy(hdrs, "${name}: ${val}")
            i = i + 1
        }
        quickjs.release(ctx, keys)
    }
    quickjs.release(ctx, hv)
    quickjs.release(ctx, opt)
    if url == "" { return sae_throw_type_error(ctx, "http.request: options.url is missing") }
    return http_start_(ctx, string.to_upper(method), url, body, ctype, hdrs, held_fn_(ctx, argv, argc, 1))
}

