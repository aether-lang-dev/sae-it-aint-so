// --- the page API: vg (AeVG vector graphics) ---
//
// The AeVG DSL, with trailing blocks as last arguments, as in `ui`:
//
//   vg.scene("0 0 100 100", 400, 300, () => {
//     const c = vg.circle(30, 40, 18, () => { vg.fill("#c44"); vg.on_click(...) })
//   })
//
// AeVG is a port of Tsyne's Cosyne CVG, so this is Cosyne for sae pages, in
// the block form rather than Cosyne's fluent `.fill()` chains. A shape
// returns a handle for vg.set_fill(h, ...) and friends.

vg_top_(p: *Page) -> ptr {
    return mem.get_ptr(p.vg_stack, (p.vg_depth - 1) * 8)
}

vg_push_(p: *Page, node: ptr) -> int {
    if p.vg_depth >= STACK_MAX { return 0 }
    mem.set_ptr(p.vg_stack, p.vg_depth * 8, node)
    p.vg_depth = p.vg_depth + 1
    return 1
}

vg_node_of_(p: *Page, h: int) -> ptr {
    if h < 1 || h > list.size(p.vg_nodes) { return null }
    n, _ = list.get(p.vg_nodes, h - 1)
    return n
}

// Register a node, run the shape's block (if the page gave one at fn_at)
// with it on top, and return its handle.
vg_shape_done_(ctx: ptr, argv: ptr, argc: int, fn_at: int, node: ptr) -> long {
    p = page_of_(ctx)
    list.add(p.vg_nodes, node)
    h = list.size(p.vg_nodes)
    if argc > fn_at {
        fnv = arg_(argv, fn_at)
        if JS_IsFunction(ctx, fnv) == 0 {
            return sae_throw_type_error(ctx, "a vg shape's block must be a function")
        }
        if vg_push_(p, node) == 0 { return sae_throw_type_error(ctx, "vg shapes nested too deeply") }
        r = call0_(ctx, fnv)
        p.vg_depth = p.vg_depth - 1
        if sae_js_is_exception(r) != 0 { return r }
    }
    return JS_NewInt32(ctx, h)
}

// A shape needs an open scene; a modifier needs an open shape (the scene
// root is not one).
vg_scene_open_(ctx: ptr) -> int {
    return page_of_(ctx).vg_depth >= 1
}

vg_shape_open_(ctx: ptr) -> int {
    return page_of_(ctx).vg_depth >= 2
}

// Repaint a scene after a change made outside a vg click (a ui button, a
// timer): clear, re-flush the shapes with their current style, present.
vg_repaint_(node: ptr) {
    scene = vg.node_scene(node)
    cid = vg.scene_canvas(scene)
    if cid == 0 { return }
    ui.canvas_clear(cid)
    live.vg_flush_live(scene, cid, 0.0)
    ui.canvas_redraw(cid)
}

// Call a held JS function with two number arguments. Each number is pushed
// as soon as it exists, so it is rooted on the engine stack before the next
// allocation can move anything.
call2_num_(ctx: ptr, ref: ptr, a: float, b: float) -> long {
    if JS_StackCheck(ctx, 4) != 0 { return sae_js_exception() }
    JS_PushArg(ctx, JS_NewFloat64(ctx, b))
    JS_PushArg(ctx, JS_NewFloat64(ctx, a))
    JS_PushArg(ctx, mem.get_long(ref, 0))
    JS_PushArg(ctx, sae_js_null())
    return JS_Call(ctx, 2)
}

// Call a held JS function with one number argument.
call1_num_(ctx: ptr, ref: ptr, a: float) -> long {
    if JS_StackCheck(ctx, 3) != 0 { return sae_js_exception() }
    JS_PushArg(ctx, JS_NewFloat64(ctx, a))
    JS_PushArg(ctx, mem.get_long(ref, 0))
    JS_PushArg(ctx, sae_js_null())
    return JS_Call(ctx, 1)
}

// Hold argument i if it is a function, for a widget's change handler;
// null when the page passed none.
held_fn_(ctx: ptr, argv: ptr, argc: int, i: int) -> ptr {
    if argc <= i { return null }
    if JS_IsFunction(ctx, arg_(argv, i)) == 0 { return null }
    return hold_(ctx, arg_(argv, i))
}

// Run a widget's change handler with one number.
fire_num_(ctx: ptr, ref: ptr, v: float, what: string) {
    if ref == null { return }
    r = call1_num_(ctx, ref, v)
    if sae_js_is_exception(r) != 0 { report_exception_(ctx, what) }
}

// The handle argument of a get_/set_ function, or 0 (and a pending throw)
// when it is not a widget this page made.
own_arg_(ctx: ptr, argv: ptr, argc: int) -> int {
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(page_of_(ctx), h) == 0 { return 0 }
    return h
}

// --- the page API: inputs and indicators (aether-ui's names) ---

// toggle(label, onChange(on)): a checkbox; on is 1 or 0.
