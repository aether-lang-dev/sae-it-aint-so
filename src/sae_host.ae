// --- the page API: storage ---
//
// storage.get(key) / set(key, value) / remove(key): string values that
// outlive the page and the process, like localStorage. Scoped to the app (in
// app mode) or the page's origin (in the browser), so one site never reads
// another's. Keys are letters, digits, '.', '_' and '-'. The file system is
// the kernel's (storage_file_ below); a page reaches only these three calls.

sae_storage_get(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.get(key): key must be letters, digits, '.', '_' or '-'") }
    v, found = storage_read_(page_of_(ctx).url, key)
    if found == 0 { return quickjs.new_null(ctx) }
    return quickjs.new_string(ctx, v)
}

sae_storage_set(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.set(key, value): key must be letters, digits, '.', '_' or '-'") }
    val = own_(arg_str_(ctx, argv, argc, 1))
    if string.length(val) > STORAGE_MAX { return sae_throw_type_error(ctx, "storage.set: value over 1 MB") }
    if storage_write_(page_of_(ctx).url, key, val) == 0 { return sae_throw_type_error(ctx, "storage.set: could not save") }
    return 0
}

sae_storage_remove(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.remove(key): key must be letters, digits, '.', '_' or '-'") }
    storage_remove_(page_of_(ctx).url, key)
    return 0
}

