// ui.datagrid_on_edit_change(g, fn(text, caret)): the open editor's text as
// it is typed (and as it opens), with its caret.
sae_ui_datagrid_on_edit_change(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    g = dgrid_arg_(p, argv, argc)
    if g == null { return sae_throw_type_error(ctx, "ui.datagrid_on_edit_change: g is not a grid this page made") }
    if argc <= 1 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.datagrid_on_edit_change(g, fn): fn must be a function (text, caret) => void") }
    ref = hold_arg_(ctx, argv, 1)
    _g = ui.datagrid_on_edit_change(g) callback |t: string, caret: int| {
        call_si_(p, ref, t, caret, "a ui.datagrid edit-change handler")
        settle_(p)
    }
    return quickjs.new_int(ctx, arg_int_(ctx, argv, argc, 0, 0))
}
