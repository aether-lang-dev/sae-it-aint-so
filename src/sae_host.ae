    n = vg.path(vg_top_(p), utils.points_to_path(ae_points_arg_(p, argv, argc), 0))
    return ae_shape_done_(p, argv, argc, 1, n, K_SHAPE)
}

// ellipse(cx, cy, rx, ry, fn?): two arcs, as the transpiler emits it.
sae_ae_ellipse(p: *Page, this_val: int, argv: int) -> int {
