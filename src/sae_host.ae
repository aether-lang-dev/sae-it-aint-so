// Apply one property of a vg.set() object (or a bind_pos result) to a node.
// Geometry keys write the element's shape geometry, which the next flush
// draws from (circle: cx, cy, r; rect: x, y, w|width, h|height; line: x1,
// y1, x2, y2), once the shape has been drawn once.
ae_apply_prop_(ctx: ptr, r: *AeRec, key: string, obj: int) -> int {
    if key == "fill" { aevg.rec_set_fill(r, ae_prop_str_(ctx, obj, key)); return 1 }
    if key == "opacity" { aevg.rec_set_opacity(r, ae_prop_num_(ctx, obj, key, 1.0)); return 1 }
    if key == "transform" { aevg.rec_set_transform(r, ae_prop_str_(ctx, obj, key)); return 1 }
    if key == "visible" {
        h, _e = quickjs.get(ctx, obj, key)
        aevg.rec_set_visible(r, quickjs.to_bool(ctx, h))
        quickjs.release(ctx, h)
        return 1
    }
    if key == "stroke" {
        h2, _e2 = quickjs.get(ctx, obj, key)
        if quickjs.type_of(ctx, h2) == "string" {
            aevg.rec_set_stroke(r, own_(quickjs.to_string(ctx, h2)), 1.0)
        } else {
            aevg.rec_set_stroke(r, ae_index_str_(ctx, h2, 0), ae_index_num_(ctx, h2, 1))
        }
        quickjs.release(ctx, h2)
        return 1
    }
    if key == "stroke_width" {
        if r.el != null && element.element_has_stroke(r.el) == 1 {
            aevg.rec_set_stroke(r, own_(element.element_last_stroke_color(r.el)), ae_prop_num_(ctx, obj, key, 1.0))
        }
        return 1
    }
    if key == "text" {
        if r.el != null { vg.element_set_text(r.el, ae_prop_str_(ctx, obj, key)) }
        aevg.scene_mark_dirty(r.scene as *AeScene)
        return 1
    }
    if r.el == null { return 0 }
    // A text moves by x and y too (aether-ui's text_set_pos); it was the one
    // node vg.set could not move.
    if r.kind == K_TEXT {
        if key == "x" || key == "y" {
            nx = element.element_geo0(r.el)
            ny = element.element_geo1(r.el)
            if key == "x" { nx = ae_prop_num_(ctx, obj, key, nx) }
            if key == "y" { ny = ae_prop_num_(ctx, obj, key, ny) }
            vg.element_text_set_pos(r.el, nx, ny)
            aevg.scene_mark_dirty(r.scene as *AeScene)
            return 1
        }
        return 0
    }
    slot = 0 - 1
    st = element.element_shape_type(r.el)
    if st == SHAPE_CIRCLE {
        if key == "cx" { slot = 0 }
        if key == "cy" { slot = 1 }
        if key == "r" { slot = 2 }
    }
    if st == SHAPE_RECT {
        if key == "x" { slot = 0 }
        if key == "y" { slot = 1 }
        if key == "w" || key == "width" { slot = 2 }
        if key == "h" || key == "height" { slot = 3 }
    }
    if st == SHAPE_LINE {
        if key == "x1" { slot = 0 }
        if key == "y1" { slot = 1 }
        if key == "x2" { slot = 2 }
        if key == "y2" { slot = 3 }
    }
    if slot < 0 { return 0 }
    element.element_set_geo(r.el, slot, ae_prop_num_(ctx, obj, key, 0.0))
    // The flush syncs the draw attrs from the geometry only for a shape with
    // a position binding; give it one (never evaluated by sae).
    if element.element_pos_binding(r.el) == null {
        element.element_bind_pos(r.el, ae_no_pos_)
    }
    aevg.scene_mark_dirty(r.scene as *AeScene)
    return 1
}

// The position binding sae gives a moved shape: never evaluated by sae.
ae_no_pos_() -> ptr { return null }

// Apply every property of a JS object.
ae_apply_obj_(ctx: ptr, r: *AeRec, obj: int) {
    ks = quickjs.keys(ctx, obj)
    n = quickjs.length(ctx, ks)
    i = 0
    while i < n {
        k = ae_index_str_(ctx, ks, i)
        _a = ae_apply_prop_(ctx, r, k, obj)
        i = i + 1
    }
    quickjs.release(ctx, ks)
}

// vg.set(h, { fill, stroke: [c, w], opacity, transform, text, visible, cx,
// cy, r, x, y, w, h, x1, y1, x2, y2 }): several changes, one repaint.
sae_ae_set(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(ctx, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.set(h, props): h is not a vg node") }
    if argc < 2 { return 0 }
    obj = quickjs.arg(ctx, argv, 1)
    if quickjs.type_of(ctx, obj) == "object" { ae_apply_obj_(ctx, r, obj) }
    quickjs.release(ctx, obj)
    ae_repaint_(ctx)
    return 0
}

// vg.get(h): what the node currently has: fill, opacity, transform (its
// own), visible, text, and its geometry once drawn.
sae_ae_get(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(ctx, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.get(h): h is not a vg node") }
    o = quickjs.new_object(ctx)
    ae_put_str_(ctx, o, "transform", r.tf)
    ae_put_num_(ctx, o, "opacity", r.op)
    vb = quickjs.new_bool(ctx, r.visible)
    _v = quickjs.set(ctx, o, "visible", vb)
    quickjs.release(ctx, vb)
    if r.el != null {
        ae_put_str_(ctx, o, "fill", element.element_last_fill(r.el))
        if element.element_has_stroke(r.el) == 1 {
            ae_put_str_(ctx, o, "stroke", element.element_last_stroke_color(r.el))
            ae_put_num_(ctx, o, "stroke_width", element.element_last_stroke_width(r.el))
        }
        lt = element.element_last_text(r.el)
        if lt != null { ae_put_str_(ctx, o, "text", lt) }
        if r.kind == K_TEXT {
            ae_put_num_(ctx, o, "x", element.element_geo0(r.el))
            ae_put_num_(ctx, o, "y", element.element_geo1(r.el))
        }
        st = element.element_shape_type(r.el)
        if st == SHAPE_CIRCLE {
            ae_put_num_(ctx, o, "cx", element.element_geo0(r.el))
            ae_put_num_(ctx, o, "cy", element.element_geo1(r.el))
            ae_put_num_(ctx, o, "r", element.element_geo2(r.el))
        }
        if st == SHAPE_RECT {
            ae_put_num_(ctx, o, "x", element.element_geo0(r.el))
            ae_put_num_(ctx, o, "y", element.element_geo1(r.el))
            ae_put_num_(ctx, o, "w", element.element_geo2(r.el))
            ae_put_num_(ctx, o, "h", element.element_geo3(r.el))
        }
        if st == SHAPE_LINE {
            ae_put_num_(ctx, o, "x1", element.element_geo0(r.el))
            ae_put_num_(ctx, o, "y1", element.element_geo1(r.el))
            ae_put_num_(ctx, o, "x2", element.element_geo2(r.el))
            ae_put_num_(ctx, o, "y2", element.element_geo3(r.el))
        }
    }
    return o
}

ae_put_str_(ctx: ptr, o: int, k: string, v: string) {
    h = quickjs.new_string(ctx, v)
    _s = quickjs.set(ctx, o, k, h)
    quickjs.release(ctx, h)
}

ae_put_num_(ctx: ptr, o: int, k: string, v: float) {
    h = quickjs.new_float(ctx, v)
    _s = quickjs.set(ctx, o, k, h)
    quickjs.release(ctx, h)
}

// --- vg bindings: evaluated by vg.refresh() ---

// A binding modifier: bind_fill(fn) inside a shape's block, or
// bind_fill(h, fn) from anywhere. Returns the record and holds fn.
ae_bind_args_(ctx: ptr, argv: int, argc: int, name: string) -> (ptr, int) {
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) == 1 {
        r = ae_rec_of_handle_(ctx, arg_int_(ctx, argv, argc, 0, 0))
        if r == null { return null, 0 }
        return r as ptr, hold_arg_(ctx, argv, 1)
    }
    if argc >= 1 && is_fn_arg_(ctx, argv, 0) == 1 {
        r2 = ae_modifier_rec_(ctx, name)
        if r2 == null { return null, 0 }
        return r2 as ptr, hold_arg_(ctx, argv, 0)
    }
    return null, 0
}

ae_bind_add_(ctx: ptr, r: *AeRec, kind: int, fn_h: int) {
    b = heap.new(AeBind)
    b.rec = r as ptr
    b.scene = r.scene
    b.kind = kind
    b.fn_h = fn_h
    list.add(ae_page_(ctx).binds, b as ptr)
}

ae_bind_(ctx: ptr, argv: int, kind: int, name: string) -> int {
    argc = quickjs.arg_count(ctx, argv)
    rp, fn_h = ae_bind_args_(ctx, argv, argc, name)
    r = rp as *AeRec
    if rp == null { return sae_throw_type_error(ctx, "vg.${name}(fn) must be called inside a shape's block (or as vg.${name}(h, fn)), with a function") }
    ae_bind_add_(ctx, r, kind, fn_h)
    ae_eval_bind_(ctx, r, kind, fn_h)
    ae_repaint_(ctx)
    return 0
}

sae_ae_bind_fill(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_FILL, "bind_fill")
}

sae_ae_bind_stroke(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_STROKE, "bind_stroke")
}

sae_ae_bind_opacity(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_OPACITY, "bind_opacity")
}

sae_ae_bind_text(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_TEXT, "bind_text")
}

sae_ae_bind_pos(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_POS, "bind_pos")
}

sae_ae_bind_transform(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_TRANSFORM, "bind_transform")
}

sae_ae_visible_when(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return ae_bind_(ctx, argv, AB_WHEN, "visible_when")
}

// vg.view_box(fn): inside a scene's block: the viewBox follows fn's string
// (zoom and pan as state; the prelude accepts a state too).
sae_ae_view_box(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.view_box(fn) must be called inside vg.scene()") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "vg.view_box(fn): fn must be a function") }
    r = ae_top_rec_(ctx)
    if r == null { return 0 }
    ae_bind_add_(ctx, r, AB_VIEWBOX, hold_arg_(ctx, argv, 0))
    return 0
}

// vg.set_view_box(scene, "x y w h"): the scene handle is what vg.scene()
// returned.
sae_ae_set_view_box(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(ctx, arg_int_(ctx, argv, argc, 0, 0))
    if r == null || r.kind != K_SCENE { return sae_throw_type_error(ctx, "vg.set_view_box(scene, vb): scene is not one this page made") }
    aevg.scene_set_view_box(ae_model_(ctx), r.scene as *AeScene, own_(arg_str_(ctx, argv, argc, 1)))
    ae_repaint_(ctx)
    return 0
}

// Evaluate one binding: call its function, apply the value.
ae_eval_bind_(ctx: ptr, r: *AeRec, kind: int, fn_h: int) {
    v = ae_call_value_(ctx, fn_h, "a vg binding")
    if v == 0 { return }
    t = quickjs.type_of(ctx, v)
    if kind == AB_FILL {
        if t != "undefined" { aevg.rec_set_fill(r, own_(quickjs.to_string(ctx, v))) }
    } else if kind == AB_STROKE {
        if t == "string" { aevg.rec_set_stroke(r, own_(quickjs.to_string(ctx, v)), 1.0) }
        else if t == "object" { aevg.rec_set_stroke(r, ae_index_str_(ctx, v, 0), ae_index_num_(ctx, v, 1)) }
    } else if kind == AB_OPACITY {
        aevg.rec_set_opacity(r, quickjs.to_float(ctx, v))
    } else if kind == AB_TEXT {
        if r.el != null {
            vg.element_set_text(r.el, own_(quickjs.to_string(ctx, v)))
            aevg.scene_mark_dirty(r.scene as *AeScene)
        }
    } else if kind == AB_POS {
        if t == "object" { ae_apply_obj_(ctx, r, v) }
    } else if kind == AB_TRANSFORM {
        aevg.rec_set_transform(r, own_(quickjs.to_string(ctx, v)))
    } else if kind == AB_WHEN {
        aevg.rec_set_visible(r, quickjs.to_bool(ctx, v))
    } else if kind == AB_VIEWBOX {
        sc = r.scene as *AeScene
        nv = own_(quickjs.to_string(ctx, v))
        if nv != sc.vb { aevg.scene_set_view_box(ae_model_(ctx), sc, nv) }
    }
    quickjs.release(ctx, v)
    settle_(ctx)
}

// vg.refresh(): re-evaluate every binding and repaint what changed. The
// prelude calls it after a state is set (once per batch).
sae_ae_refresh(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ap = ae_page_(ctx)
    n = list.size(ap.binds)
    i = 0
    while i < n {
        v, _ = list.get(ap.binds, i)
        b = v as *AeBind
        ae_eval_bind_(ctx, b.rec as *AeRec, b.kind, b.fn_h)
        i = i + 1
    }
    ae_repaint_(ctx)
    return 0
}

// --- vg defs: gradients and clip paths, named and registered on the scene ---

// vg.defs(fn): inside a scene's block; the gradients and clip paths declared
// in fn are registered together (a gradient may href one declared before it).
sae_ae_defs(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.defs(fn) must be called inside vg.scene()") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "vg.defs(fn): fn must be a function") }
    ap = ae_page_(ctx)
    if ap.defs_sb != null { return sae_throw_type_error(ctx, "vg.defs() cannot nest") }
    r = ae_top_rec_(ctx)
    ap.defs_sb = strbuilder.new(256)
    ap.defs_scene = r.scene
    c = call_arg_(ctx, argv, 0)
    svg = strbuilder.finish(ap.defs_sb)
    ap.defs_sb = null
    if c < 0 { return rethrow_(ctx) }
    aevg.defs_register(r.scene as *AeScene, svg)
    return 0
}

// The open defs block's builder, or null (with the error thrown).
ae_defs_sb_(ctx: ptr, name: string) -> ptr {
    ap = ae_page_(ctx)
    return ap.defs_sb
}

// stops: [[offset, color], [offset, color, opacity], ...] as <stop>s.
// A gradient's stops, [[offset, color, opacity?], ...]. The caller checks
// for "array": contrib.quickjs's type_of names an array "array", not
// "object" (checking "object" dropped every stop, so a gradient painted
// nothing).
ae_stops_(ctx: ptr, sb: ptr, stops: int) {
    n = quickjs.length(ctx, stops)
    i = 0
    while i < n {
        st, _e = quickjs.get_index(ctx, stops, i)
        _a = strbuilder.append(sb, "<stop")
        _b = strbuilder.append(sb, aevg.attr_str("offset", ae_index_str_(ctx, st, 0)))
        _c = strbuilder.append(sb, aevg.attr_str("stop-color", ae_index_str_(ctx, st, 1)))
        _d = strbuilder.append(sb, aevg.attr_str("stop-opacity", ae_index_str_(ctx, st, 2)))
        _f = strbuilder.append(sb, "/>")
        quickjs.release(ctx, st)
        i = i + 1
    }
}

// The options a gradient may carry: { units, transform, href, spread }.
ae_gradient_opts_(ctx: ptr, sb: ptr, argv: int, argc: int, at: int) {
    if argc <= at { return }
    o = quickjs.arg(ctx, argv, at)
    if quickjs.type_of(ctx, o) == "object" {
        _a = strbuilder.append(sb, aevg.attr_str("gradientUnits", ae_prop_str_(ctx, o, "units")))
        _b = strbuilder.append(sb, aevg.attr_str("gradientTransform", ae_prop_str_(ctx, o, "transform")))
        href = ae_prop_str_(ctx, o, "href")
        if string.length(href) > 0 { _c = strbuilder.append(sb, aevg.attr_str("xlink:href", "#${href}")) }
        _d = strbuilder.append(sb, aevg.attr_str("spreadMethod", ae_prop_str_(ctx, o, "spread")))
    }
    quickjs.release(ctx, o)
}

// vg.linear_gradient(id, x1, y1, x2, y2, stops, opts?): coordinates as
// fractions of the shape's box, or in viewBox units with
// { units: "userSpaceOnUse" }. A shape uses it with fill("url(#id)").
sae_ae_linear_gradient(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    sb = ae_defs_sb_(ctx, "linear_gradient")
    if sb == null { return sae_throw_type_error(ctx, "vg.linear_gradient() must be called inside vg.defs()") }
    _a = strbuilder.append(sb, "<linearGradient")
    _b = strbuilder.append(sb, aevg.attr_str("id", arg_str_(ctx, argv, argc, 0)))
    _c = strbuilder.append(sb, aevg.attr_str("x1", arg_str_(ctx, argv, argc, 1)))
    _d = strbuilder.append(sb, aevg.attr_str("y1", arg_str_(ctx, argv, argc, 2)))
    _e = strbuilder.append(sb, aevg.attr_str("x2", arg_str_(ctx, argv, argc, 3)))
    _f = strbuilder.append(sb, aevg.attr_str("y2", arg_str_(ctx, argv, argc, 4)))
    ae_gradient_opts_(ctx, sb, argv, argc, 6)
    _g = strbuilder.append(sb, ">")
    if argc > 5 {
        stops = quickjs.arg(ctx, argv, 5)
        if quickjs.type_of(ctx, stops) == "array" { ae_stops_(ctx, sb, stops) }
        quickjs.release(ctx, stops)
    }
    _h = strbuilder.append(sb, "</linearGradient>")
    return 0
}

// vg.radial_gradient(id, cx, cy, r, stops, opts?): opts may add fx and fy.
sae_ae_radial_gradient(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    sb = ae_defs_sb_(ctx, "radial_gradient")
    if sb == null { return sae_throw_type_error(ctx, "vg.radial_gradient() must be called inside vg.defs()") }
    _a = strbuilder.append(sb, "<radialGradient")
    _b = strbuilder.append(sb, aevg.attr_str("id", arg_str_(ctx, argv, argc, 0)))
    _c = strbuilder.append(sb, aevg.attr_str("cx", arg_str_(ctx, argv, argc, 1)))
    _d = strbuilder.append(sb, aevg.attr_str("cy", arg_str_(ctx, argv, argc, 2)))
    _e = strbuilder.append(sb, aevg.attr_str("r", arg_str_(ctx, argv, argc, 3)))
    if argc > 5 {
        o = quickjs.arg(ctx, argv, 5)
        if quickjs.type_of(ctx, o) == "object" {
            _fx = strbuilder.append(sb, aevg.attr_str("fx", ae_prop_str_(ctx, o, "fx")))
            _fy = strbuilder.append(sb, aevg.attr_str("fy", ae_prop_str_(ctx, o, "fy")))
        }
        quickjs.release(ctx, o)
    }
    ae_gradient_opts_(ctx, sb, argv, argc, 5)
    _g = strbuilder.append(sb, ">")
    if argc > 4 {
        stops = quickjs.arg(ctx, argv, 4)
        if quickjs.type_of(ctx, stops) == "array" { ae_stops_(ctx, sb, stops) }
        quickjs.release(ctx, stops)
    }
    _h = strbuilder.append(sb, "</radialGradient>")
    return 0
}

// vg.clip_path(id, shapes, opts?): shapes as [["rect", x, y, w, h],
// ["circle", cx, cy, r], ["ellipse", cx, cy, rx, ry], ["path", d],
// ["polygon", points]]; a shape is clipped with { clip: id } ... which the
// deferred shape verbs cannot carry yet (see the report), so a clip path
// today is registered and waits for that attribute.
sae_ae_clip_path(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    sb = ae_defs_sb_(ctx, "clip_path")
    if sb == null { return sae_throw_type_error(ctx, "vg.clip_path() must be called inside vg.defs()") }
    _a = strbuilder.append(sb, "<clipPath")
    _b = strbuilder.append(sb, aevg.attr_str("id", arg_str_(ctx, argv, argc, 0)))
    if argc > 2 {
        o = quickjs.arg(ctx, argv, 2)
        if quickjs.type_of(ctx, o) == "object" {
            _t = strbuilder.append(sb, aevg.attr_str("transform", ae_prop_str_(ctx, o, "transform")))
            _u = strbuilder.append(sb, aevg.attr_str("clipPathUnits", ae_prop_str_(ctx, o, "units")))
        }
        quickjs.release(ctx, o)
    }
    _c = strbuilder.append(sb, ">")
    if argc > 1 {
        shapes = quickjs.arg(ctx, argv, 1)
        n = quickjs.length(ctx, shapes)
        i = 0
        while i < n {
            s, _e = quickjs.get_index(ctx, shapes, i)
            kind = ae_index_str_(ctx, s, 0)
            if kind == "rect" {
                _r = strbuilder.append(sb, "<rect${aevg.attr_str("x", ae_index_str_(ctx, s, 1))}${aevg.attr_str("y", ae_index_str_(ctx, s, 2))}${aevg.attr_str("width", ae_index_str_(ctx, s, 3))}${aevg.attr_str("height", ae_index_str_(ctx, s, 4))}/>")
            } else if kind == "circle" {
                _ci = strbuilder.append(sb, "<circle${aevg.attr_str("cx", ae_index_str_(ctx, s, 1))}${aevg.attr_str("cy", ae_index_str_(ctx, s, 2))}${aevg.attr_str("r", ae_index_str_(ctx, s, 3))}/>")
            } else if kind == "ellipse" {
                _el = strbuilder.append(sb, "<ellipse${aevg.attr_str("cx", ae_index_str_(ctx, s, 1))}${aevg.attr_str("cy", ae_index_str_(ctx, s, 2))}${aevg.attr_str("rx", ae_index_str_(ctx, s, 3))}${aevg.attr_str("ry", ae_index_str_(ctx, s, 4))}/>")
            } else if kind == "path" {
                _pa = strbuilder.append(sb, "<path${aevg.attr_str("d", ae_index_str_(ctx, s, 1))}/>")
            } else if kind == "polygon" {
                _po = strbuilder.append(sb, "<polygon${aevg.attr_str("points", ae_index_str_(ctx, s, 1))}/>")
            }
            quickjs.release(ctx, s)
            i = i + 1
        }
        quickjs.release(ctx, shapes)
    }
    _d = strbuilder.append(sb, "</clipPath>")
    return 0
}

// vg.css(text): CSS rules for the open scene (kind selectors such as
// `path { stroke: #000 }`; class selectors wait for a class attribute on
// shapes, as clip paths do).
sae_ae_css(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.css(text) must be called inside vg.scene()") }
    r = ae_top_rec_(ctx)
    if r == null { return 0 }
    aevg.css_register(r.scene as *AeScene, own_(arg_str_(ctx, argv, argc, 0)))
    return 0
}

// The registrations, in one block for api_register_ (called from there).
ae_register_(p: *Page) {
    q = p.ctx
    u, _ue = quickjs.get_global(q, "ui")
    reg_(q, u, "_cell", 2, sae_ae_cell)
    reg_(q, u, "_cell_get", 2, sae_ae_cell_get)
    reg_(q, u, "_cell_set", 3, sae_ae_cell_set)
    reg_(q, u, "_computed", 3, sae_ae_computed)
    reg_(q, u, "_batch", 1, sae_ae_batch)
    reg_(q, u, "_bind", 4, sae_ae_bind)
    reg_(q, u, "_widget_kind", 1, sae_ae_widget_kind)
    reg_(q, u, "_remove_child", 2, sae_ae_remove_child)
    reg_(q, u, "set_enabled", 2, sae_ae_set_enabled)
    quickjs.release(q, u)
    v, _ve = quickjs.get_global(q, "vg")
    // These supersede the earlier registrations of the same names (see the
    // banner above): the page sees the versions with the scene record.
    reg_(q, v, "scene", 4, sae_ae_scene)
    reg_(q, v, "circle", 4, sae_ae_circle)
    reg_(q, v, "rect", 5, sae_ae_rect)
    reg_(q, v, "rrect", 6, sae_ae_rrect)
    reg_(q, v, "line", 5, sae_ae_line)
    reg_(q, v, "path", 2, sae_ae_path)
    reg_(q, v, "text", 4, sae_ae_text)
    reg_(q, v, "g", 1, sae_ae_g)
    reg_(q, v, "fill", 1, sae_ae_fill)
    reg_(q, v, "stroke", 2, sae_ae_stroke)
    reg_(q, v, "opacity", 1, sae_ae_opacity)
    reg_(q, v, "transform", 1, sae_ae_transform)
    reg_(q, v, "on_click", 1, sae_ae_on_click)
    // New.
    reg_(q, v, "polygon", 2, sae_ae_polygon)
    reg_(q, v, "polyline", 2, sae_ae_polyline)
    reg_(q, v, "ellipse", 5, sae_ae_ellipse)
    reg_(q, v, "text_sized", 5, sae_ae_text_sized)
    reg_(q, v, "text_anchored", 6, sae_ae_text_anchored)
    reg_(q, v, "into", 2, sae_ae_into)
    reg_(q, v, "linecap", 1, sae_ae_linecap)
    reg_(q, v, "linejoin", 1, sae_ae_linejoin)
    reg_(q, v, "tooltip", 1, sae_ae_tooltip)
    reg_(q, v, "cursor", 1, sae_ae_cursor)
    reg_(q, v, "on_hover", 1, sae_ae_on_hover)
    reg_(q, v, "on_double_click", 1, sae_ae_on_double_click)
    reg_(q, v, "on_right_click", 1, sae_ae_on_right_click)
    reg_(q, v, "on_drag", 1, sae_ae_on_drag)
    reg_(q, v, "on_drag_end", 1, sae_ae_on_drag_end)
    reg_(q, v, "on_scroll", 1, sae_ae_on_scroll)
    reg_(q, v, "set_transform", 2, sae_ae_set_transform)
    reg_(q, v, "set_visible", 2, sae_ae_set_visible)
    reg_(q, v, "remove", 1, sae_ae_remove)
    reg_(q, v, "set", 2, sae_ae_set)
    reg_(q, v, "get", 1, sae_ae_get)
    reg_(q, v, "bind_fill", 2, sae_ae_bind_fill)
    reg_(q, v, "bind_stroke", 2, sae_ae_bind_stroke)
    reg_(q, v, "bind_opacity", 2, sae_ae_bind_opacity)
    reg_(q, v, "bind_text", 2, sae_ae_bind_text)
    reg_(q, v, "bind_pos", 2, sae_ae_bind_pos)
    reg_(q, v, "bind_transform", 2, sae_ae_bind_transform)
    reg_(q, v, "visible_when", 2, sae_ae_visible_when)
    reg_(q, v, "view_box", 1, sae_ae_view_box)
    reg_(q, v, "set_view_box", 2, sae_ae_set_view_box)
    reg_(q, v, "refresh", 0, sae_ae_refresh)
    reg_(q, v, "defs", 1, sae_ae_defs)
    reg_(q, v, "linear_gradient", 7, sae_ae_linear_gradient)
    reg_(q, v, "radial_gradient", 6, sae_ae_radial_gradient)
    reg_(q, v, "clip_path", 3, sae_ae_clip_path)
    reg_(q, v, "css", 1, sae_ae_css)
    quickjs.release(q, v)
    // The JS surface over these: state, computed, bind, each, batch, the
    // bind tagged template, vg.animate, vg.items (src/sae_prelude.js).
    pre, perr = quickjs.eval(q, sae_prelude(), "sae:prelude")
    if perr != "" { say_("sae: the prelude failed:\n${perr}") }
    quickjs.release(q, pre)
}

// ===== end wave1/aevg =====

// --- URLs and fetching ---

// --- http (the kernel side of the http page API) ---

struct HttpJob {
    id: int
    method: string
    url: string
    body: string
    ctype: string
    headers: ptr     // strarr of "Name: value", or null
    page_url: string // the page that asked, and its scopes: every redirect
    scopes: string   //   hop is checked against them as the first URL was
    status: int
    resp: string
    resp_headers: string
    err: string
    refused_hop: int // err is capabilities.http refusing a redirect hop: logged on delivery
}

// A request a page is waiting on: which page (by load), and its callback.
struct HttpWait {
    id: int
    page: ptr
    seq: int
    ref: int         // the page's callback (a handle of its runtime)
}

message HttpRun { job: ptr }
message HttpDone { job: ptr }
message HttpTake {}

// Does the blocking request, on a scheduler thread, then hands the job to
// the inbox. One job at a time per fetcher; the pool gives concurrency.
actor HttpFetcher {
    receive {
        HttpRun(job) -> {
            http_do_(job)
            ib = actors.whereis("sae-http-inbox")
            ib ! HttpDone { job: job }
        }
    }
}

// Finished jobs, until the UI thread takes them. http_done_ is touched only
// in these handlers, so the actor serializes every access to it.
var http_done_: ptr = null

actor HttpInbox {
    receive {
        HttpDone(job) -> {
            if http_done_ == null { http_done_ = list.new() }
            list.add(http_done_, job)
        }
        HttpTake() -> {
            long r = 0
            if http_done_ != null {
                if list.size(http_done_) > 0 {
                    j, _ = list.get(http_done_, 0)
                    list.list_remove(http_done_, 0)
                    r = mem.ptr_to_long(j)
                }
            }
            reply r
        }
    }
}

const HTTP_FETCHERS = 4

var http_pool_: ptr = null      // std.list of the fetchers, spawned on first use
var http_next_ = 0
var http_waits_: ptr = null     // std.list of *HttpWait
var http_ids_ = 0
var http_timer_ = 0

// A redirect status: the response names where to go next.
is_redirect_(status: int) -> int {
    if status == 301 || status == 302 || status == 303 || status == 307 || status == 308 { return 1 }
    return 0
}

const REDIRECT_HOPS = 5

// Run one request on a fetcher actor. Redirects are followed here, not by
// the client, so every hop is checked against the page's grant and scopes
// exactly as the first URL was: an allowed URL cannot redirect a page to
// one it may not reach.
http_do_(jp: ptr) {
    j = jp as *HttpJob
    url = j.url
    method = j.method
    body = j.body
    host0 = string.string_substring(url, 0, origin_end_(url))
    cross = 0        // a hop left the first origin: credentials stay behind
    if esc_cross_start_(j) == 1 { cross = 1 }   // wave1/escape: or the first URL already did
    hops = 0
    while 1 == 1 {
        // services/net builds the request only if app.json capabilities.http
        // covers the URL; every hop comes back through here.
        req, nerr = net.open_request(method, url)
        if req == null {
            j.err = own_(nerr)
            if string.string_starts_with(nerr, "this app may not reach") == 1 { j.refused_hop = 1 }
            return
        }
        client.set_timeout(req, 15s)
        if j.headers != null {
            nh = strarr.size(j.headers)
            hi = 0
            while hi < nh {
                line = strarr.get(j.headers, hi)
                c = string.index_of(line, ": ")
                if c > 0 {
                    hname = string.string_substring(line, 0, c)
                    lname = string.to_lower(hname)
                    if esc_header_kept_(lname) == 1 && (cross == 0 || (lname != "authorization" && lname != "cookie" && lname != "proxy-authorization")) {
                        _sh = client.set_header(req, hname, string.string_substring(line, c + 2, string.length(line)))
                    }
                }
                hi = hi + 1
            }
        }
        esc_send_origin_(req, j, cross)   // wave1/escape: Origin across origins, in the browser
        if body != "" || method == "POST" || method == "PUT" || method == "PATCH" {
            ct = j.ctype
            if ct == "" { ct = "text/plain" }
            _sb = client.set_body(req, string.bytes(body), ct)
        }
        resp, err = client.send_request(req)
        client.request_free(req)
        if err != "" {
            j.err = own_(err)
            return
        }
        status = client.response_status(resp)
        loc = ""
        if is_redirect_(status) == 1 { loc = client.response_header(resp, "Location") }
        if loc == "" {
            if esc_cors_refused_(j, resp, cross, url) == 1 {   // wave1/escape: the CORS-alike
                client.response_free(resp)
                return
            }
            j.status = status
            j.resp = own_(client.response_body(resp))
            j.resp_headers = own_(client.response_headers(resp))
            client.response_free(resp)
            return
        }
        client.response_free(resp)
        hops = hops + 1
        if hops > REDIRECT_HOPS {
            j.err = "too many redirects (more than ${REDIRECT_HOPS}) from ${j.url}"
            return
        }
        next = resolve_(url, loc)
        if string.string_starts_with(url, "https://") == 1 && string.string_starts_with(next, "http://") == 1 {
            j.err = "refused a redirect from https to http: ${next}"
            return
        }
        // 303, and 301/302 after a POST, continue as a GET without a body.
        if status == 303 || ((status == 301 || status == 302) && method == "POST") {
            method = "GET"
            body = ""
        }
        why = http_refusal_(j.page_url, j.scopes, method, next)
        if why != "" {
            j.err = "redirected to ${next}: ${why}"
            if net.refusal(next) != "" { j.refused_hop = 1 }
            return
        }
        if string.string_substring(next, 0, origin_end_(next)) != host0 { cross = 1 }
        url = next
    }
}

// 1 if s[i..] matches the glob g[k..]: "*" is any run of characters but
// "/", "**" any run at all, everything else itself.
glob_at_(g: string, k: int, s: string, i: int) -> int {
    gn = string.length(g)
    sn = string.length(s)
    while k < gn {
        c = string.string_char_at(g, k)
        if c == 42 {
            deep = 0
            if k + 1 < gn && string.string_char_at(g, k + 1) == 42 { deep = 1 }
            nk = k + 1 + deep
            jj = i
            while jj <= sn {
                if glob_at_(g, nk, s, jj) == 1 { return 1 }
                if jj < sn && deep == 0 && string.string_char_at(s, jj) == 47 { return 0 }
                jj = jj + 1
            }
            return 0
        }
        if i >= sn { return 0 }
        if string.string_char_at(s, i) != c { return 0 }
        i = i + 1
        k = k + 1
    }
    if i == sn { return 1 }
    return 0
}

// The path of an http(s) URL, without its query or fragment ("/" if none).
url_path_(u: string) -> string {
    path = string.string_substring(u, origin_end_(u), string.length(u))
    q = string.index_of(path, "?")
    if q >= 0 { path = string.string_substring(path, 0, q) }
    h = string.index_of(path, "#")
    if h >= 0 { path = string.string_substring(path, 0, h) }
    if path == "" { path = "/" }
    return path
}

// 1 if one of a page's scopes ("VERBS\tpattern" lines, patterns absolute)
// covers `method` on `url`: the method is listed, the origin is the
// pattern's exactly, and the path matches its glob. The query is not part
// of the match.
scope_covers_(scopes: string, method: string, url: string) -> int {
    origin = string.string_substring(url, 0, origin_end_(url))
    path = url_path_(url)
    lines = string.split(scopes, "\n")
    n = string.string_array_size(lines)
    i = 0
    while i < n {
        line = string.string_array_get(lines, i)
        i = i + 1
        tab = string.index_of(line, "\t")
        if tab > 0 {
            verbs = string.string_substring(line, 0, tab)
            pat = string.string_substring(line, tab + 1, string.length(line))
            if string.contains(",${verbs},", ",${method},") == 1 {
                if string.string_substring(pat, 0, origin_end_(pat)) == origin {
                    if glob_at_(url_path_(pat), 0, path, 0) == 1 { return 1 }
                }
            }
        }
    }
    return 0
}

// A request app.json capabilities.http refused, on the console: once per
// refusal, from the UI thread.
net_log_(why: string) {
    println("sae: refused: ${why}")
    fflush(sae_stdout())
}

// "" if a page at page_url, with these scopes ("" when it seeks
// outgoing-http unscoped), may make this request, else why not. The grant
// (app.json, or a web page's own origin) is checked first, then the scopes.
http_refusal_(page_url: string, scopes: string, method: string, url: string) -> string {
    if is_http_(url) == 0 { return "http.get/post takes an http(s) URL: ${url}" }
    granted = 0
    if app_dir_ != "" {
        // app.json capabilities.http, held by services/net: the server first,
        // then the path prefix.
        nwhy = net.refusal(url)
        if nwhy != "" { return nwhy }
        granted = 1
    }
    if granted == 0 {
        if is_http_(page_url) == 0 { return "a page may reach only its own origin: ${url}" }
        po = string.string_substring(page_url, 0, origin_end_(page_url))
        uo = string.string_substring(url, 0, origin_end_(url))
        // wave1/escape: another origin may be tried (the CORS-alike decides on
        // the response); mixed content may not.
        if po != uo {
            ew = esc_cross_why_(page_url, url)
            if ew != "" { return ew }
        }
    }
    if scopes != "" && scope_covers_(scopes, method, url) == 0 {
        return "this page's seeks do not cover ${method} ${url}"
    }
    return ""
}

http_start_(ctx: ptr, method: string, url_arg: string, body: string, ctype: string, headers: ptr, ref: int) -> int {
    p = page_of_(ctx)
    if ref == 0 { return sae_throw_type_error(ctx, "http: the last argument must be a function") }
    url = resolve_(p.url, url_arg)
    // A URL app.json capabilities.http does not cover is refused like any
    // other (res.ok false, below), and logged once. Only in an app; in the
    // browser services/net checks nothing.
    if app_dir_ != "" && is_http_(url) == 1 {
        nwhy = net.refusal(url)
        if nwhy != "" { net_log_(nwhy) }
    }
    esc_log_mixed_(p, url)   // wave1/escape: mixed content, logged once here
    if esc_http_inflight_(p) >= ESC_HTTP_INFLIGHT_MAX { return esc_http_refuse_(ctx, p, ref) }   // wave1/escape: the in-flight cap
    if http_waits_ == null { http_waits_ = list.new() }
    http_ids_ = http_ids_ + 1
    j = heap.new(HttpJob)
    j.id = http_ids_
    j.method = method
    j.url = own_(url)
    j.body = body
    j.ctype = ctype
    j.headers = headers
    j.status = 0
    j.resp = ""
    j.resp_headers = ""
    j.page_url = p.url
    j.scopes = p.http_scopes
    j.refused_hop = 0
    j.err = http_refusal_(p.url, p.http_scopes, method, url)
    w = heap.new(HttpWait)
    w.id = j.id
    w.page = p as ptr
    w.seq = p.seq
    w.ref = ref
    list.add(http_waits_, w as ptr)
    if j.err != "" {
        // Refused: no request, but the answer comes the same way, later.
        ib0 = http_inbox_()
        ib0 ! HttpDone { job: j as ptr }
    } else {
        f = http_fetcher_()
        f ! HttpRun { job: j as ptr }
    }
    if http_timer_ == 0 { http_timer_ = ui.timer(20, || { http_poll_() }) }
    // The request object: { id, cancel() }.
    if http_helpers_(ctx, p) == 0 { return rethrow_(ctx) }
    args = quickjs.new_array(ctx)
    idh = quickjs.new_int(ctx, j.id)
    _s = quickjs.set_index(ctx, args, 0, idh)
    quickjs.release(ctx, idh)
    r, err = quickjs.call(ctx, p.http_req, 0, args)
    quickjs.release(ctx, args)
    if err != "" { return rethrow_(ctx) }
    return r
}

// The two small JS functions the http API hands pages, compiled once per page
// and held as GC roots: one makes the response object (so res.json() is a
// method), one the request object (so req.cancel() is). 1 when they are
// ready.
http_helpers_(ctx: ptr, p: *Page) -> int {
    if p.http_res != 0 { return 1 }
    rs = "(function (ok, status, text, error, raw) { var h = {}; var ls = raw.split(/\\r?\\n/); for (var i = 1; i < ls.length; i++) { var c = ls[i].indexOf(':'); if (c > 0) h[ls[i].slice(0, c).trim().toLowerCase()] = ls[i].slice(c + 1).trim(); } return { ok: ok, status: status, text: text, error: error, headers: h, json: function () { return JSON.parse(this.text); } }; })"
    qs = "(function (id) { return { id: id, cancel: function () { http.cancel(id); } }; })"
    rf, e1 = quickjs.eval(ctx, rs, "sae:http")
    if e1 != "" { return 0 }
    p.http_res = rf
    qf, e2 = quickjs.eval(ctx, qs, "sae:http")
    if e2 != "" { return 0 }
    p.http_req = qf
    return 1
}

http_cancel_(p: *Page, id: int) {
    if http_waits_ == null { return }
    n = list.size(http_waits_)
    i = 0
    while i < n {
        wv, _ = list.get(http_waits_, i)
        w = wv as *HttpWait
        if w.id == id && w.page == p as ptr {
            list.list_remove(http_waits_, i)
            heap.free(w)
            return
        }
        i = i + 1
    }
}

http_inbox_() -> ptr {
    ib = actors.whereis("sae-http-inbox")
    if ib == null {
        ib = spawn(HttpInbox())
        actors.register("sae-http-inbox", ib)
    }
    return ib
}

http_fetcher_() -> ptr {
    _ib = http_inbox_()
    if http_pool_ == null {
        http_pool_ = list.new()
        k = 0
        while k < HTTP_FETCHERS {
            list.add(http_pool_, spawn(HttpFetcher()))
            k = k + 1
        }
    }
    f, _ = list.get(http_pool_, http_next_ % HTTP_FETCHERS)
    http_next_ = http_next_ + 1
    return f
}

// On the UI thread: take every finished job and run its page's callback.
http_poll_() {
    ib = http_inbox_()
    while true {
        jl = ib ? HttpTake {}
        if jl == 0 { break }
        http_deliver_(mem.long_to_ptr(jl) as *HttpJob)
    }
    if list.size(http_waits_) == 0 {
        ui.timer_cancel(http_timer_)
        http_timer_ = 0
    }
}

http_deliver_(j: *HttpJob) {
    if j.refused_hop == 1 { net_log_(j.err) }
    n = list.size(http_waits_)
    i = 0
    while i < n {
        wv, _ = list.get(http_waits_, i)
        w = wv as *HttpWait
        if w.id == j.id {
            list.list_remove(http_waits_, i)
            b = browser_
            if b != null {
                cur = (b as *Browser).page
                if cur != null && cur == w.page && (cur as *Page).seq == w.seq {
                    p = cur as *Page
                    r = call_http_(p, w.ref, j.status, j.resp, j.err, j.resp_headers)
                    if r < 0 { report_exception_(p.ctx, "an http callback") }
                    settle_(p.ctx)
                }
            }
            heap.free(w)
            heap.free(j)
            return
        }
        i = i + 1
    }
    heap.free(j)
}

// fn(res): res is made by the page's response maker, then handed to fn.
call_http_(p: *Page, ref: int, status: int, text: string, err: string, raw_headers: string) -> int {
    ctx = p.ctx
    if http_helpers_(ctx, p) == 0 { return 0 - 1 }
    ok = 0
    if err == "" && status >= 200 && status < 300 { ok = 1 }
    args = quickjs.new_array(ctx)
    a0 = quickjs.new_bool(ctx, ok)
    a1 = quickjs.new_int(ctx, status)
    a2 = quickjs.new_string(ctx, text)
    a3 = quickjs.new_string(ctx, err)
    a4 = quickjs.new_string(ctx, raw_headers)
    _s0 = quickjs.set_index(ctx, args, 0, a0)
    _s1 = quickjs.set_index(ctx, args, 1, a1)
    _s2 = quickjs.set_index(ctx, args, 2, a2)
    _s3 = quickjs.set_index(ctx, args, 3, a3)
    _s4 = quickjs.set_index(ctx, args, 4, a4)
    quickjs.release(ctx, a0)
    quickjs.release(ctx, a1)
    quickjs.release(ctx, a2)
    quickjs.release(ctx, a3)
    quickjs.release(ctx, a4)
    res, e1 = quickjs.call(ctx, p.http_res, 0, args)
    quickjs.release(ctx, args)
    if e1 != "" { return 0 - 1 }
    args2 = quickjs.new_array(ctx)
    _s5 = quickjs.set_index(ctx, args2, 0, res)
    quickjs.release(ctx, res)
    r = calln_(ctx, ref, args2)
    quickjs.release(ctx, args2)
    return r
}

// --- capabilities (the kernel side; docs/app-capabilities.md) ---

// The http, fs and shell grants live in services/net, services/files and
// services/shell.

// The app's own data folder: $SAE_APPDATA_DIR, else the platform's place.
app_data_dir_() -> string {
    d = env_("SAE_APPDATA_DIR")
    if d != "" { return d }
    if os.platform() == "darwin" { return "${env_("HOME")}/Library/Application Support/${app_name_}" }
    return "${env_("HOME")}/.local/share/${app_name_}"
}

// A JSON text made into a JS value (JSON.parse, from the host), for a
// page-API call to return.
json_value_(ctx: ptr, text: string) -> int {
    h, err = quickjs.parse_json(ctx, text)
    if err != "" { return sae_throw_type_error(ctx, "bad JSON from the host: ${err}") }
    return h
}

// 1 if this context can give a page the privilege `nm`. A web page in the
// browser gets outgoing-http (to its own origin) and nothing else; an app
// gets each only as far as app.json grants it.
available_(nm: string) -> int {
    if app_dir_ == "" {
        if nm == "outgoing-http" { return 1 }
        return 0
    }
    if nm == "outgoing-http" { return net.granted() }
    if nm == "local-filesystem" { return files.granted() }
    if nm == "open-urls" { return shell.granted() }
    if string.string_starts_with(nm, "database ") == 1 { return sqlite_granted_(string.string_substring(nm, 9, string.length(nm))) }   // wave1/sqlite
    return 0
}

// Why a page that seeks `seeks` (",local-filesystem,...", from its "seeks"
// lines) cannot run here, or "".
seek_refusal_(url: string, seeks: string) -> string {
    if seeks == "" { return "" }
    missing = ""
    parts = string.split(seeks, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.string_array_get(parts, i)
        if nm != "" && available_(nm) == 0 {
            if missing == "" { missing = nm } else { missing = "${missing}, ${nm}" }
        }
        i = i + 1
    }
    if missing == "" { return "" }
    if app_dir_ == "" { return "${url} seeks ${missing}, which a web page in the browser cannot have" }
    return "${url} seeks ${missing}, which this app's app.json does not grant"
}

// A page's outgoing-http scopes (lowerer lines "outgoing-http\tVERBS\tpattern")
// checked against what this context grants, with path-only patterns ("/api/*")
// made absolute against the page's own origin. Returns the scopes as the
// page keeps them ("VERBS\tpattern" lines) and "", or "" and why the page
// cannot run. A scope must lie inside the grant: within app.json's http
// prefixes in an app, on the page's own origin in the browser.
http_scopes_for_(page_url: string, scopes: string) -> (string, string) {
    out = ""
    lines = string.split(scopes, "\n")
    n = string.string_array_size(lines)
    i = 0
    while i < n {
        line = string.string_array_get(lines, i)
        i = i + 1
        if string.string_starts_with(line, "outgoing-http\t") == 1 {
            rest = string.string_substring(line, 14, string.length(line))
            tab = string.index_of(rest, "\t")
            verbs = string.string_substring(rest, 0, tab)
            pat = string.string_substring(rest, tab + 1, string.length(rest))
            shown = "seeks outgoing-http ${verbs} ${pat}"
            if string.string_starts_with(pat, "/") == 1 {
                if is_http_(page_url) == 0 {
                    return "", "${page_url} ${shown}: a path-only pattern means the page's own origin, and this page has none; name the full URL"
                }
                pat = string.concat(string.string_substring(page_url, 0, origin_end_(page_url)), pat)
            }
            if app_dir_ != "" {
                lit = pat
                star = string.index_of(pat, "*")
                if star >= 0 { lit = string.string_substring(pat, 0, star) }
                if net.refusal(lit) != "" {
                    return "", "${page_url} ${shown}, beyond what this app's app.json grants (capabilities.http)"
                }
            } else {
                // wave1/escape: any http(s) origin, held to the CORS-alike per
                // request; not http: from an https: page.
                ew = esc_scope_why_(page_url, pat)
                if ew != "" { return "", "${page_url} ${shown}, ${ew}" }
            }
            out = string.concat(out, "${verbs}\t${pat}\n")
        }
    }
    return out, ""
}

// The privileges a page can do without (",outgoing-http,") that this context
// cannot give it, as ",local-filesystem,": their objects are left out, so the
// page sees `typeof fs === "undefined"` and falls back.
absent_of_(optional: string) -> string {
    out = ","
    parts = string.split(optional, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.string_array_get(parts, i)
        if nm != "" && available_(nm) == 0 { out = string.concat(out, "${nm},") }
        i = i + 1
    }
    return out
}

// The privileges a page seeks neither required nor optional
// ("local-filesystem,open-urls,"), to leave out with the absent ones.
unsought_(seeks: string, optional: string) -> string {
    out = ""
    names = string.split("outgoing-http,local-filesystem,open-urls", ",")
    n = string.string_array_size(names)
    i = 0
    while i < n {
        nm = string.string_array_get(names, i)
        if string.contains(",${seeks},${optional},", ",${nm},") == 0 { out = string.concat(out, "${nm},") }
        i = i + 1
    }
    return out
}

// The strings of a JSON array `key` in object `v` (none if absent), each
// handed to `add`.
grants_from_(v: ptr, key: string, add: fn) {
    if v == null { return }
    a = json.json_object_get_raw(v, key)
    if a == null { return }
    n = json.json_array_size(a)
    i = 0
    while i < n {
        sv, serr = json.get_string(json.json_array_get_raw(a, i))
        if serr == "" { call(add, sv) }
        i = i + 1
    }
}

// The app's grants from app.json "capabilities", handed to the services
// that enforce them (http's stay here, with the actors that make requests).
read_capabilities_(manifest: ptr) {
    t = env_("TMPDIR")
    if t == "" { t = "/tmp" }
    while string.string_ends_with(t, "/") == 1 { t = string.string_substring(t, 0, string.length(t) - 1) }
    files.configure(1, app_data_dir_(), env_("HOME"), t)
    shell.configure(1, env_("SAE_SHELL_LOG"))
    // capabilities.http is the app's whole network: absent or empty is none
    // (Tauri's deny by default). An entry services/net does not understand
    // allows nothing and is reported.
    net.configure(1)
    if manifest == null { return }
    caps = json.json_object_get_raw(manifest, "capabilities")
    if caps == null { return }
    grants_from_(caps, "http", |u: string| {
        nerr = net.allow(u)
        if nerr != "" { println("sae: ${nerr}") }
    })
    grants_from_(json.json_object_get_raw(caps, "shell"), "open", |u: string| { shell.grant(u) })
    fsg = json.json_object_get_raw(caps, "fs")
    grants_from_(fsg, "read", |r: string| { files.grant_read(r) })
    grants_from_(fsg, "write", |r: string| { files.grant_write(r) })
}

// --- storage (the kernel side of the storage page API) ---

const STORAGE_MAX = 1048576

storage_key_ok_(k: string) -> int {
    n = string.length(k)
    if n == 0 || n > 128 { return 0 }
    i = 0
    while i < n {
        c = string.char_at(k, i)
        ok = 0
        if c >= 97 && c <= 122 { ok = 1 }
        if c >= 65 && c <= 90 { ok = 1 }
        if c >= 48 && c <= 57 { ok = 1 }
        if c == 46 || c == 95 || c == 45 { ok = 1 }
        if ok == 0 { return 0 }
        i = i + 1
    }
    if string.string_starts_with(k, ".") == 1 { return 0 }
    return 1
}

// A short, stable hash of s as 16 hex digits: two 32-bit multiply-xor lanes
// (FNV-1a, and the same with another seed and multiplier; the products stay
// below 2^57, so nothing overflows). For naming storage folders,
// not for security.
hash_hex_(s: string) -> string {
    long h1 = 2166136261
    long h2 = 2654435761
    n = string.length(s)
    i = 0
    while i < n {
        long c = string.string_char_at(s, i) as long
        h1 = ((h1 ^ c) * 16777619) % 4294967296
        h2 = ((h2 ^ c) * 1000003) % 4294967296
        i = i + 1
    }
    a = string.string_pad_start(string.string_from_int_radix(h1, 16), 8, 48)
    b2 = string.string_pad_start(string.string_from_int_radix(h2, 16), 8, 48)
    return "${a}${b2}"
}

// A directory as the OS spells it (symlinks and .. resolved), or as given if
// it cannot be resolved.
canonical_dir_(d: string) -> string {
    p, _k, err = fs.realpath(d)
    if err != "" || p == "" { return own_(d) }
    return own_(p)
}

// The bundle identifier of the macOS .app whose executable is `exe`
// (Contents/Info.plist, as tools/saepack.sh writes it), or "".
bundle_id_(exe: string) -> string {
    plist, err = fs.read(string.concat(dir_of_(exe), "../Info.plist"))
    if err != "" { return "" }
    k = string.index_of(plist, "<key>CFBundleIdentifier</key>")
    if k < 0 { return "" }
    rest = string.string_substring(plist, k, string.length(plist))
    a = string.index_of(rest, "<string>")
    z = string.index_of(rest, "</string>")
    if a < 0 || z < a { return "" }
    return own_(string.string_substring(rest, a + 8, z))
}

// What an installed app's storage is keyed by: never its display name (two
// apps may share one). A packaged macOS .app: its bundle identifier. Any
// other app (sae --app <dir>, an APK, whose pages are copied to app/ in the
// package's own files folder): its folder, canonical, hashed, after the
// folder's own name for a person reading the storage folder.
app_storage_key_(dir: string, exe: string, bundled: int) -> string {
    if bundled == 1 {
        bid = bundle_id_(exe)
        if bid != "" { return "id-${bid}" }
    }
    c = canonical_dir_(dir)
    return "${base_name_(c)}-${hash_hex_(c)}"
}

var app_key_: string = ""   // app mode: app_storage_key_, set at start

// The folder a page's storage lives in: one per installed app (app_key_),
// per origin, or, for a page loaded from a file, per directory: the file
// system's nearest thing to a site, so a folder of pages that link to one
// another shares storage, and pages in another folder do not.
// $SAE_STORAGE_DIR, else ~/.sae/storage, or .sae/storage in the working
// directory where there is no $HOME (an Android app: its own files folder).
storage_dir_(url: string) -> string {
    root = env_("SAE_STORAGE_DIR")
    home = env_("HOME")
    if home == "" { home = "." }
    if root == "" { root = "${home}/.sae/storage" }
    scope = "file"
    if is_app_(url) == 1 { scope = string.concat("app-", app_key_) }
    if is_http_(url) == 1 { scope = string.string_substring(url, 0, origin_end_(url)) }
    if is_app_(url) == 0 && is_http_(url) == 0 {
        d = dir_of_(url)
        if d == "" { d = "." }
        cd = canonical_dir_(d)
        scope = "file-${base_name_(cd)}-${hash_hex_(cd)}"
    }
    // A folder name: anything but letters, digits, '.', '-' becomes '_'.
    out = ""
    i = 0
    while i < string.length(scope) {
        c = string.char_at(scope, i)
        keep = 0
        if c >= 97 && c <= 122 { keep = 1 }
        if c >= 65 && c <= 90 { keep = 1 }
        if c >= 48 && c <= 57 { keep = 1 }
        if c == 46 || c == 45 { keep = 1 }
        if keep == 1 { out = string.concat(out, string.from_char(c)) } else { out = string.concat(out, "_") }
        i = i + 1
    }
    return "${root}/${out}"
}

storage_read_(url: string, key: string) -> (string, int) {
    v, err = fs.read("${storage_dir_(url)}/${key}")
    if err != "" { return "", 0 }
    return v, 1
}

storage_write_(url: string, key: string, val: string) -> int {
    d = storage_dir_(url)
    _m = fs.mkdir_p(d)
    werr = fs.write_atomic("${d}/${key}", string.bytes(val))
    if werr != "" { return 0 }
    return 1
}

storage_remove_(url: string, key: string) {
    _r = fs.remove_tree("${storage_dir_(url)}/${key}")
}

is_app_(u: string) -> int {
    return string.string_starts_with(u, "app:")
}

// The file an app: URL names: app:/about is <app>/about.ts (or .js), app:/ is
// the index, and a path that already ends in .ts or .js is taken as it is.
app_file_(url: string) -> string {
    path = string.string_substring(url, 4, string.length(url))
    if path == "" || path == "/" { path = "/index" }
    if string.string_ends_with(path, "/") == 1 { path = string.concat(path, "index") }
    stem = string.concat(app_dir_, path)
    if string.string_ends_with(stem, ".ts") == 1 || string.string_ends_with(stem, ".js") == 1 { return stem }
    if fs.exists("${stem}.ts") == 1 { return "${stem}.ts" }
    return "${stem}.js"
}

// Read an app page. A missing one is the app's own 404 page, as the dev page
// server serves it, when the app has one.
fetch_app_(url: string) -> (int, string, string, string) {
    f = app_file_(url)
    src, ferr = fs.read(f)
    if ferr == "" { return 200, src, own_(url), "" }
    nf = app_file_("app:/404")
    src2, ferr2 = fs.read(nf)
    if ferr2 == "" { return 404, src2, own_(url), "" }
    return 0, "", own_(url), "no such page in this app: ${url}"
}

is_http_(u: string) -> int {
    if string.string_starts_with(u, "http://") == 1 { return 1 }
    if string.string_starts_with(u, "https://") == 1 { return 1 }
    return 0
}

// The end of "scheme://host[:port]" in an http(s) URL.
origin_end_(u: string) -> int {
    start = string.string_index_of(u, "://") + 3
    rest = string.string_substring(u, start, string.length(u))
    slash = string.string_index_of(rest, "/")
    if slash < 0 { return string.length(u) }
    return start + slash
}

// Everything up to and including the last '/' of s (or "" if none).
dir_of_(s: string) -> string {
    i = string.length(s) - 1
    while i >= 0 {
        if string.string_substring(s, i, i + 1) == "/" {
            return string.string_substring(s, 0, i + 1)
        }
        i = i - 1
    }
    return ""
}

// Resolve href against the URL of the page that asked for it. Absolute
// http(s) URLs pass through; "/x" is origin-relative; anything else is
// relative to the base's directory. A base that is a file path resolves the
// same way against the file system.
resolve_(base: string, href: string) -> string {
    if is_http_(href) == 1 { return own_(href) }
    if is_app_(href) == 1 { return own_(href) }
    if is_app_(base) == 1 {
        if string.string_starts_with(href, "/") == 1 { return string.concat("app:", href) }
        return string.concat(dir_of_(base), href)
    }
    if is_http_(base) == 1 {
        oe = origin_end_(base)
        if string.string_starts_with(href, "/") == 1 {
            return string.concat(string.string_substring(base, 0, oe), href)
        }
        path_part = string.string_substring(base, oe, string.length(base))
        if path_part == "" { path_part = "/" }
        return string.concat(string.concat(string.string_substring(base, 0, oe), dir_of_(path_part)), href)
    }
    if string.string_starts_with(href, "/") == 1 { return own_(href) }
    return string.concat(dir_of_(base), href)
}

// Fetch a page. Returns (status, body, final_url, err): status is the HTTP
// status (200 for a file read), final_url is where redirects ended, and err
// is "" unless nothing could be fetched at all.
fetch_(url: string) -> (int, string, string, string) {
    if is_app_(url) == 1 { return fetch_app_(url) }
    // An app's pages are its own (app.json "start" included): it loads no
    // page from a file or the network, whatever capabilities.http lists.
    if app_dir_ != "" { return 0, "", own_(url), "this app loads only its own pages (app:/...): ${url}" }
    if is_http_(url) == 0 {
        src, ferr = fs.read(url)
        if ferr != "" { return 0, "", url, ferr }
        return 200, src, url, ""
    }
    req, nerr = net.open_request("GET", url)
    if req == null { return 0, "", url, "not a valid URL" }
    client.set_timeout(req, 10s)
    client.set_follow_redirects(req, 5)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", url, err }
    status = client.response_status(resp)
    body = client.response_body(resp)
    final_url = own_(client.response_url(resp))
    client.response_free(resp)
    if final_url == "" { final_url = own_(url) }
    return status, body, final_url, ""
}

// --- pages ---

// --- the page's engine: the only code that makes, runs and frees one ---

engine_new_(mem_bytes: long) -> ptr {
    kb = (mem_bytes / 1024) as int
    q = quickjs.runtime(kb, 0)
    if q != null {
        // SAE_PAGE_TIME_MS overrides the limit (specs use a short one).
        ms = PAGE_TIME_MS
        tv = env_("SAE_PAGE_TIME_MS")
        if tv != "" {
            n, nerr = string.to_int(tv)
            if nerr == "" && n > 0 { ms = n }
        }
        quickjs.set_time_limit(q, ms)
    }
    return q
}

engine_eval_(q: ptr, src: string, url: string) -> (int, string) {
    return quickjs.eval(q, src, url)
}

engine_dispose_(q: ptr) { quickjs.dispose(q) }

// One page-API function: obj[name] calls the Aether function f.
reg_(q: ptr, obj: int, name: string, arity: int, f: fn) {
    h = quickjs.function(q, name, arity, f)
    _e = quickjs.set(q, obj, name, h)
    quickjs.release(q, h)
}

// One global page-API function: globalThis[name] calls the Aether function f.
glob_fn_(q: ptr, name: string, arity: int, f: fn) {
    h = quickjs.function(q, name, arity, f)
    quickjs.set_global(q, name, h)
    quickjs.release(q, h)
}

// Install the page API in a page's runtime: everything a page can reach is
// registered here, so this function is the sandbox boundary. fs and shell
// exist only in app mode: a
// web page has no such objects at all.
api_register_(p: *Page) {
    q = p.ctx
    u = quickjs.new_object(q)
    reg_(q, u, "vstack", 2, sae_ui_vstack)
    reg_(q, u, "hstack", 2, sae_ui_hstack)
    reg_(q, u, "grid", 3, sae_ui_grid)
    reg_(q, u, "equal_cells", 0, sae_ui_equal_cells)
    reg_(q, u, "text", 1, sae_ui_text)
    reg_(q, u, "btn", 2, sae_ui_btn)
    reg_(q, u, "divider", 0, sae_ui_divider)
    reg_(q, u, "button", 2, sae_ui_button)
    reg_(q, u, "scroll", 1, sae_ui_scroll)
    reg_(q, u, "spacer", 0, sae_ui_spacer)
    reg_(q, u, "textfield", 2, sae_ui_textfield)
    reg_(q, u, "get_text", 1, sae_ui_get_text)
    reg_(q, u, "set_text", 2, sae_ui_set_text)
    reg_(q, u, "clear", 1, sae_ui_clear)
    reg_(q, u, "into", 2, sae_ui_into)
    reg_(q, u, "toggle", 2, sae_ui_toggle)
    reg_(q, u, "slider", 4, sae_ui_slider)
    reg_(q, u, "picker", 1, sae_ui_picker)
    reg_(q, u, "picker_add", 2, sae_ui_picker_add)
    reg_(q, u, "progressbar", 1, sae_ui_progressbar)
    reg_(q, u, "set_progress", 2, sae_ui_set_progress)
    reg_(q, u, "set_toggle", 2, sae_ui_set_toggle)
    reg_(q, u, "get_toggle", 1, sae_ui_get_toggle)
    reg_(q, u, "set_slider", 2, sae_ui_set_slider)
    reg_(q, u, "get_slider", 1, sae_ui_get_slider)
    reg_(q, u, "styles", 1, sae_ui_styles)
    reg_(q, u, "add_class", 2, sae_ui_add_class)
    reg_(q, u, "style_id", 2, sae_ui_style_id)
    reg_(q, u, "timer", 2, sae_ui_timer)
    reg_(q, u, "set_visible", 2, sae_ui_set_visible)
    reg_(q, u, "timer_cancel", 1, sae_ui_timer_cancel)
    reg_(q, u, "after", 2, sae_ui_after)
    reg_(q, u, "sleep", 1, sae_ui_sleep)
    reg_(q, u, "frame", 1, sae_request_frame)
    reg_(q, u, "frame_cancel", 1, sae_cancel_frame)
    reg_(q, u, "onclick", 1, sae_ui_onclick)
    reg_(q, u, "margin", 4, sae_ui_margin)
    reg_(q, u, "bg_color", 4, sae_ui_bg_color)
    reg_(q, u, "ui_state", 1, sae_ui_state)
    reg_(q, u, "ui_set", 2, sae_ui_set)
    reg_(q, u, "text_bound", 3, sae_ui_text_bound)
    reg_(q, u, "on_key", 1, sae_ui_on_key)
    reg_(q, u, "on_submit", 2, sae_ui_on_submit)
    reg_(q, u, "focus", 1, sae_ui_focus)
    reg_(q, u, "text_wrapped", 2, sae_ui_text_wrapped)
    reg_(q, u, "width", 1, sae_ui_width)
    reg_(q, u, "height", 1, sae_ui_height)
    quickjs.set_global(q, "ui", u)
    quickjs.release(q, u)

    v = quickjs.new_object(q)
    reg_(q, v, "scene", 4, sae_vg_scene)
    reg_(q, v, "circle", 4, sae_vg_circle)
    reg_(q, v, "rect", 5, sae_vg_rect)
    reg_(q, v, "rrect", 6, sae_vg_rrect)
    reg_(q, v, "line", 5, sae_vg_line)
    reg_(q, v, "path", 2, sae_vg_path)
    reg_(q, v, "text", 4, sae_vg_text)
    reg_(q, v, "g", 1, sae_vg_g)
    reg_(q, v, "fill", 1, sae_vg_fill)
    reg_(q, v, "stroke", 2, sae_vg_stroke)
    reg_(q, v, "opacity", 1, sae_vg_opacity)
    reg_(q, v, "transform", 1, sae_vg_transform)
    reg_(q, v, "on_click", 1, sae_vg_on_click)
    reg_(q, v, "set_fill", 2, sae_vg_set_fill)
    reg_(q, v, "set_text", 2, sae_vg_set_text)
    reg_(q, v, "set_stroke", 3, sae_vg_set_stroke)
    reg_(q, v, "set_opacity", 2, sae_vg_set_opacity)
    // ===== wave1/raster: pixels from a page =====
    reg_(q, v, "raster", 4, sae_vg_raster)
    reg_(q, v, "raster_update", 2, sae_vg_raster_update)
    reg_(q, v, "raster_size", 1, sae_vg_raster_size)
    reg_(q, v, "image", 2, sae_vg_image)
    reg_(q, v, "box", 4, sae_vg_box)
    reg_(q, v, "fit", 1, sae_vg_fit)
    reg_(q, v, "rendering", 1, sae_vg_rendering)
    reg_(q, v, "measure", 2, sae_vg_measure)
    reg_(q, v, "ellipsize", 3, sae_vg_ellipsize)
    uimg, _ue = quickjs.get_global(q, "ui")
    reg_(q, uimg, "image", 2, sae_ui_image)
    quickjs.release(q, uimg)
    // ===== end wave1/raster =====
    quickjs.set_global(q, "vg", v)
    quickjs.release(q, v)

    // A privilege the page can do without and was not granted has no
    // object at all, so `typeof http === "undefined"` tells the page.
    if string.contains(p.absent, ",outgoing-http,") == 0 {
    ht = quickjs.new_object(q)
    reg_(q, ht, "get", 2, sae_http_get)
    reg_(q, ht, "post", 4, sae_http_post)
    reg_(q, ht, "cancel", 1, sae_http_cancel)
    reg_(q, ht, "request", 2, sae_http_request)
    quickjs.set_global(q, "http", ht)
    quickjs.release(q, ht)
    // http.fetch(url or options): the same request as a promise of the same
    // response object, for `await`. It runs on the same actors; the promise
    // resolves where a callback would have run.
    hf, _hfe = quickjs.eval(q, "http.fetch = function (o) { return new Promise(function (resolve) { if (typeof o === 'string') http.get(o, resolve); else http.request(o, resolve); }); };", "sae:http")
    quickjs.release(q, hf)
    }

    if app_dir_ != "" && string.contains(p.absent, ",local-filesystem,") == 0 {
        fo = quickjs.new_object(q)
        reg_(q, fo, "read_text", 1, sae_fs_read_text)
        reg_(q, fo, "readFileSync", 2, sae_fs_read_text)
        reg_(q, fo, "write_text", 2, sae_fs_write_text)
        reg_(q, fo, "writeFileSync", 2, sae_fs_write_text)
        reg_(q, fo, "exists", 1, sae_fs_exists)
        reg_(q, fo, "existsSync", 1, sae_fs_exists)
        reg_(q, fo, "list", 1, sae_fs_list)
        reg_(q, fo, "readdirSync", 1, sae_fs_list)
        reg_(q, fo, "mkdir", 1, sae_fs_mkdir)
        reg_(q, fo, "remove", 1, sae_fs_remove)
        quickjs.set_global(q, "fs", fo)
        quickjs.release(q, fo)
    }
    if app_dir_ != "" && string.contains(p.absent, ",open-urls,") == 0 {
        sho = quickjs.new_object(q)
        reg_(q, sho, "open", 1, sae_shell_open)
        quickjs.set_global(q, "shell", sho)
        quickjs.release(q, sho)
    }

    // ===== wave1/sqlite: sqlite.<name> for each database the page seeks and app.json declares =====
    sdbs = sqlite_page_dbs_(p)
    if sdbs != "," {
        so = quickjs.new_object(q)
        snames = string.split(sdbs, ",")
        sn = string.string_array_size(snames)
        si = 0
        while si < sn {
            sname = string.string_array_get(snames, si)
            si = si + 1
            if sname == "" { continue }
            dbo = quickjs.new_object(q)
            nmh = quickjs.new_string(q, sname)
            _sd = quickjs.set(q, dbo, "__db", nmh)
            quickjs.release(q, nmh)
            reg_(q, dbo, "all", 2, sae_sqlite_all)
            reg_(q, dbo, "get", 2, sae_sqlite_get)
            reg_(q, dbo, "run", 2, sae_sqlite_run)
            reg_(q, dbo, "transaction", 1, sae_sqlite_transaction)
            reg_(q, dbo, "__begin", 1, sae_sqlite_begin)
            reg_(q, dbo, "__end", 2, sae_sqlite_end)
            _so = quickjs.set(q, so, sname, dbo)
            quickjs.release(q, dbo)
        }
        quickjs.set_global(q, "sqlite", so)
        quickjs.release(q, so)
    }
    // ===== end wave1/sqlite =====

    st = quickjs.new_object(q)
    reg_(q, st, "get", 1, sae_storage_get)
    reg_(q, st, "set", 2, sae_storage_set)
    reg_(q, st, "remove", 1, sae_storage_remove)
    quickjs.set_global(q, "storage", st)
    quickjs.release(q, st)

    bc = quickjs.new_object(q)
    reg_(q, bc, "changePage", 1, sae_bc_change_page)
    reg_(q, bc, "back", 0, sae_bc_back)
    reg_(q, bc, "forward", 0, sae_bc_forward)
    reg_(q, bc, "reload", 0, sae_bc_reload)
    cu = quickjs.new_string(q, p.url)
    _c = quickjs.set(q, bc, "currentUrl", cu)
    quickjs.release(q, cu)
    quickjs.set_global(q, "browserContext", bc)
    quickjs.release(q, bc)

    pr = quickjs.function(q, "print", 1, js_print)
    quickjs.set_global(q, "print", pr)
    quickjs.release(q, pr)
    // The web's timer names, page-scoped like ui.timer: the same queue, so
    // they need no grant and stop with the page ("the page API: timers").
    glob_fn_(q, "setTimeout", 2, sae_set_timeout)
    glob_fn_(q, "setInterval", 2, sae_set_interval)
    glob_fn_(q, "clearTimeout", 1, sae_ui_timer_cancel)
    glob_fn_(q, "clearInterval", 1, sae_ui_timer_cancel)
    glob_fn_(q, "requestAnimationFrame", 1, sae_request_frame)
    glob_fn_(q, "cancelAnimationFrame", 1, sae_cancel_frame)
    d, _e1 = quickjs.get_global(q, "Date")
    reg_(q, d, "now", 0, js_date_now)
    quickjs.release(q, d)
    perf = quickjs.new_object(q)
    reg_(q, perf, "now", 0, js_performance_now)
    quickjs.set_global(q, "performance", perf)
    quickjs.release(q, perf)

    // ===== wave1/imports: the loader's two functions. Not globals: each
    // unit meets them on the $sae object its wrapper takes (modules_prepare_).
    p.mod_get = quickjs.function(q, "m", 1, sae_mod_get)
    p.mod_fail = quickjs.function(q, "fail", 1, sae_mod_fail)
    // ===== wave1/aevg: the reactive and AeVG surfaces (their reg_ lines are
    // in ae_register_, one block, above) =====
    ae_register_(p)
}

page_new_(b: *Browser, url: string, absent: string, http_scopes: string) -> *Page {
    p = heap.new(Page)
    p.browser = b
    p.url = own_(url)
    p.absent = own_(absent)
    p.http_scopes = own_(http_scopes)
    p.stack = malloc(STACK_MAX * 4)
    p.depth = 0
    p.ui_ns = 0
    p.ui_calls = 0
    p.vg_stack = malloc(STACK_MAX * 8)
    p.vg_depth = 0
    p.vg_nodes = list.new()
    p.stacks = list.new()
    p.grids = list.new()
    p.sheet = null
    p.sheet_strs = list.new()
    p.timers = list.new()
    p.timer_ids = 0
    p.timer_seq = 0
    p.timer_nesting = 0
    p.timers_running = 0
    p.wake = 0
    p.wake_due = 0
    p.rafs = list.new()
    p.raf_batch = null
    p.raf_ids = 0
    p.frame_sub = 0
    p.key_ref = 0
    page_seq_ = page_seq_ + 1
    p.seq = page_seq_
    p.http_res = 0
    p.http_req = 0
    p.ctx = engine_new_(b.page_mem)
    if pages_ == null { pages_ = list.new() }
    list.add(pages_, p as ptr)
    api_register_(p)
    p.root = ui.vstack(mem.long_to_ptr(b.content), 4)
    // After the root: it is the browser's, like the content area it sits in.
    p.first_handle = aether_ui_widget_count_impl() + 1
    push_(p, p.root)
    return p
}

page_free_(p: *Page) {
    esc_free_(p)   // wave1/escape: the page's cap state
    // A page's timers and animation frames stop with it: a tick after this
    // would call into a freed runtime.
    timers_free_(p)
    modules_free_(p)   // wave1/imports: its module registry
    raster_page_free_(p)   // wave1/raster: its rasters' buffers
    list.free(p.vg_nodes)
    list.free(p.stacks)
    list.free(p.grids)
    // The page's sheet styles only its own widgets: un-set it before the
    // next page builds, then free it (free_styles refuses the current one).
    if p.sheet != null {
        aether_ui_current_sheet_set_impl(null)
        ui.free_styles(p.sheet)
    }
    list.free(p.sheet_strs)
    free(p.vg_stack)
    // The runtime goes with everything it held: the page's handlers, its
    // http helpers, its pending promises.
    n = list.size(pages_)
    i = 0
    while i < n {
        pv, _ = list.get(pages_, i)
        if pv == p as ptr {
            list.list_remove(pages_, i)
            break
        }
        i = i + 1
    }
    engine_dispose_(p.ctx)
    free(p.stack)
    heap.free(p)
}

// Run page source into the page's content area, then the promise jobs it
// queued. Returns 1 on success. Fills times_ns[0..1]: QuickJS compiles and
// runs in one call, so the run time holds both and the parse time is 0.
page_run_(p: *Page, src: string, times_ns: ptr) -> int {
    long t0 = os.now_monotonic_ns()
    mem.set_long(times_ns, 0, 0)
    v, err = engine_eval_(p.ctx, src, p.url)
    // wave1/imports: a page with imports or a top-level await is a function
    if err == "" && p.wrapped == 1 { v, err = modules_run_page_(p, v) }
    mem.set_long(times_ns, 8, os.now_monotonic_ns() - t0)
    if err != "" {
        say_("sae: uncaught exception in ${p.url}:\n${err}")
        return 0
    }
    quickjs.release(p.ctx, v)
    settle_(p.ctx)
    return 1
}

// ===== wave1/imports: static import, the module registry, and the sae: =====
// ===== library (README "Modules", lower/README.md "Modules") =====
//
// A page's `import` statements are resolved and run before the page. The
// lowerer rewrites each into `$sae.m(spec)` and wraps the page in a function
// taking `$sae`; modules_prepare_ walks the import closure (fetched on the
// same path and rules as pages, each module lowered as a module, hashed,
// cycles refused), runs each module in dependency order into the page's
// registry (url -> namespace object, freed with the page), and
// modules_run_page_ then calls the page with its $sae. `$sae.m` is the one
// page-reachable function here: it looks a resolved URL up in the registry
// and nothing else, so a page can reach only what it imported statically.
//
// Resolution (module_resolve_): "sae:<name>" is the library bundled with
// sae (services/stdlib, no capability needed); "./x.ts", "../x.ts" and
// "/x.ts" resolve against the importer, and must stay on the page's origin
// (browser), inside the bundle (app: URLs), or inside the page's folder
// (a page loaded from a file); an absolute http(s) URL is allowed only on
// the page's own origin. Everything else is refused: another origin, data:,
// any other scheme, bare names. An import may name the bytes it expects,
// "./x.ts#sha256-<hex>", and is refused on a mismatch.
//
// The loader lives here, in the kernel, because it is page lifecycle: it
// needs fetch_ (the one page-fetch path, with its own-origin and app rules)
// and the engine's eval. The library and the integrity checks are a
// service (services/stdlib), an effect held to its imports: it reads one
// directory and digests bytes, and nothing else.

struct PageModule {
    url: string
    ns: int          // the module's namespace ($exports) object, held
}

const MODULES_MAX = 64

// Where lib/sae is: $SAE_LIB_DIR, or beside the binary (an install's
// lib/sae next to bin/, a packaged .app's Resources/lib/sae, or this
// repository's lib/sae above target/build/bin/). "" if nowhere.
lib_dir_(exe: string) -> string {
    d = env_("SAE_LIB_DIR")
    if d != "" { return d }
    base = dir_of_(exe)
    cands = strarr.new()
    _c1 = strarr.push_copy(cands, "${base}../lib/sae")
    _c2 = strarr.push_copy(cands, "${base}../Resources/lib/sae")
    _c3 = strarr.push_copy(cands, "${base}../../../lib/sae")
    _c4 = strarr.push_copy(cands, "${base}lib/sae")
    out = ""
    i = 0
    while i < strarr.size(cands) {
        c = strarr.get(cands, i)
        if out == "" && fs.exists("${c}/MANIFEST") == 1 { out = own_(c) }
        i = i + 1
    }
    strarr.free(cands)
    return out
}

// A path with its "." and ".." segments collapsed (a leading "/" is kept,
// a relative path stays relative). Returns (path, climbed): climbed 1 if a
// ".." reached above the root.
norm_path_(path: string) -> (string, int) {
    abs = string.string_starts_with(path, "/")
    parts = string.split(path, "/")
    n = string.string_array_size(parts)
    kept = strarr.new()
    nk = 0      // entries of kept in use (strarr has no pop)
    climbed = 0
    i = 0
    while i < n {
        seg = string.string_array_get(parts, i)
        if seg == ".." {
            if nk == 0 { climbed = 1 } else { nk = nk - 1 }
        } else if seg != "." && (seg != "" || i == n - 1) {
            if nk < strarr.size(kept) { strarr.set(kept, nk, seg) } else { _k = strarr.push_copy(kept, seg) }
            nk = nk + 1
        }
        i = i + 1
    }
    out = ""
    k = 0
    while k < nk {
        out = string.concat(out, "/${strarr.get(kept, k)}")
        k = k + 1
    }
    strarr.free(kept)
    if out == "" { out = "/" }
    if abs == 0 { out = string.string_substring(out, 1, string.length(out)) }
    return out, climbed
}

// The origin of an http(s) URL, lowercased.
origin_of_(u: string) -> string {
    return string.string_to_lower(string.string_substring(u, 0, origin_end_(u)))
}

// Resolve an import specifier against the URL of the unit that imports it.
// Returns (url, why): why is "" when the import is allowed.
module_resolve_(importer: string, spec: string) -> (string, string) {
    clean, _hex, ierr = stdlib.integrity_of(spec)
    if ierr != "" { return "", ierr }
    if string.string_starts_with(clean, "sae:") == 1 {
        name = string.string_substring(clean, 4, string.length(clean))
        if stdlib.name_ok(name) == 0 { return "", "\"${clean}\" is not a library module name: sae:<letters, digits and dashes>" }
        return own_(clean), ""
    }
    if string.string_starts_with(clean, "data:") == 1 {
        return "", "\"${clean}\": data: imports are refused; a page's code comes from its own origin, its bundle, or sae:"
    }
    rel = 0
    if string.string_starts_with(clean, "./") == 1 || string.string_starts_with(clean, "../") == 1 || string.string_starts_with(clean, "/") == 1 { rel = 1 }
    if rel == 0 && is_http_(clean) == 0 && is_app_(clean) == 0 {
        return "", "\"${clean}\" cannot be imported: no bare names (there is no npm here) and no other scheme; a path on this origin (\"./m.ts\", \"/lib/m.ts\") or \"sae:<name>\""
    }
    if app_dir_ != "" {
        if is_http_(clean) == 1 { return "", "\"${clean}\": an app imports only from its own bundle (app:/...) or sae:" }
        u = clean
        if rel == 1 { u = resolve_(importer, clean) }
        path, climbed = norm_path_(string.string_substring(u, 4, string.length(u)))
        if climbed == 1 { return "", "\"${clean}\" climbs above the app's bundle" }
        return string.concat("app:", path), ""
    }
    if is_app_(clean) == 1 { return "", "\"${clean}\": app: pages exist only in an app" }
    if is_http_(importer) == 1 {
        u = clean
        if rel == 1 { u = resolve_(importer, clean) }
        if origin_of_(u) != origin_of_(importer) {
            return "", "\"${clean}\" is not on this page's origin (${origin_of_(importer)}): a page imports only from its own origin or sae:"
        }
        oe = origin_end_(u)
        path, climbed = norm_path_(string.string_substring(u, oe, string.length(u)))
        if climbed == 1 { return "", "\"${clean}\" climbs above the site's root" }
        return string.concat(string.string_substring(u, 0, oe), path), ""
    }
    // a page loaded from a file: its folder is its origin
    if is_http_(clean) == 1 { return "", "\"${clean}\": a page loaded from a file imports only from its own folder or sae:" }
    folder = dir_of_(importer)
    u = resolve_(importer, clean)
    path, climbed = norm_path_(u)
    if climbed == 1 || string.string_starts_with(path, folder) == 0 {
        return "", "\"${clean}\" is outside this page's folder (${folder}): a page loaded from a file imports only from there or sae:"
    }
    return path, ""
}

// The JavaScript side of the loader: a factory making each unit's $sae
// object (its url, $sae.m, and the two helpers the export rewrites use).
const MOD_FACTORY_JS = "(function (m) { return function (url) { return { url: url, m: m, x: function (e) { for (var i = 1; i + 1 < arguments.length; i += 2) Object.defineProperty(e, arguments[i], { get: arguments[i + 1], enumerable: true, configurable: true }); }, all: function (e, ns) { Object.keys(ns).forEach(function (k) { if (k !== 'default' && !(k in e)) Object.defineProperty(e, k, { get: function () { return ns[k]; }, enumerable: true, configurable: true }); }); } }; }; })"

// A one-element arguments array for quickjs.call (released by the caller).
args1_(ctx: ptr, h: int) -> int {
    a = quickjs.new_array(ctx)
    _e = quickjs.set_index(ctx, a, 0, h)
    return a
}

// A unit's $sae object (a new handle).
mod_loader_(p: *Page, url: string) -> (int, string) {
    us = quickjs.new_string(p.ctx, url)
    a = args1_(p.ctx, us)
    lo, err = quickjs.call(p.ctx, p.mod_factory, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, us)
    return lo, err
}

// The registry entry for url, or null.
mod_find_(p: *Page, url: string) -> *PageModule {
    if p.modules == null { return null }
    n = list.size(p.modules)
    i = 0
    while i < n {
        mv, _ = list.get(p.modules, i)
        m = mv as *PageModule
        if m.url == url { return m }
        i = i + 1
    }
    return null
}

// Fetch, check, lower and run one module and, first, the modules it
// imports. chain is the import path so far ("a -> b"), for cycles. Returns
// "" or why not.
mod_load_(p: *Page, url: string, seeks: string, hex: string, chain: string, loading: ptr) -> string {
    if mod_find_(p, url) != null { return "" }
    if list.size(p.modules) >= MODULES_MAX { return "${url}: more than ${MODULES_MAX} modules in one page" }
    n = strarr.size(loading)
    i = 0
    while i < n {
        if strarr.get(loading, i) == url { return "import cycle: ${chain} -> ${url}" }
        i = i + 1
    }
    src = ""
    if string.string_starts_with(url, "sae:") == 1 {
        s, rerr = stdlib.read_module(string.string_substring(url, 4, string.length(url)))
        if rerr != "" { return rerr }
        src = s
    } else {
        status, body, _final, ferr = fetch_(url)
        if ferr != "" { return "${url}: ${ferr}" }
        if status != 200 { return "${url}: answered ${status}, not 200 (a module must be served as itself)" }
        src = body
    }
    if hex != "" {
        got = stdlib.sha256(src)
        if got != hex { return "${url}: sha256 ${got} does not match the import's #sha256-${hex}" }
    }
    text, lerr = lower.lower_module(src, url, seeks)
    if lerr != "" { return lerr }
    imports = own_(lower.page_imports())
    _l = strarr.push_copy(loading, url)
    why = mod_imports_(p, url, imports, seeks, "${chain} -> ${url}", loading)
    strarr.set(loading, strarr.size(loading) - 1, "")   // popped (no pop in strarr)
    if why != "" { return why }
    return mod_run_(p, url, text)
}

// Load each import of a unit at url, from the lowerer's list ("spec\tline\tcol").
mod_imports_(p: *Page, url: string, imports: string, seeks: string, chain: string, loading: ptr) -> string {
    lines = string.split(imports, "\n")
    n = string.string_array_size(lines)
    i = 0
    while i < n {
        l = string.string_array_get(lines, i)
        if l != "" {
            f = string.split(l, "\t")
            spec = string.string_array_get(f, 0)
            at = "${url}:${string.string_array_get(f, 1)}:${string.string_array_get(f, 2)}"
            target, why = module_resolve_(url, spec)
            if why != "" { return "${at}: import refused: ${why}" }
            _c, hex, _e = stdlib.integrity_of(spec)
            why2 = mod_load_(p, target, seeks, hex, chain, loading)
            if why2 != "" { return "${at}: import \"${spec}\": ${why2}" }
        }
        i = i + 1
    }
    return ""
}

// Run a lowered module (a function of ($sae, $exports)) and register its
// namespace.
mod_run_(p: *Page, url: string, text: string) -> string {
    fn, err = engine_eval_(p.ctx, text, url)
    if err != "" { return "${url}: ${err}" }
    lo, lerr = mod_loader_(p, url)
    if lerr != "" {
        quickjs.release(p.ctx, fn)
        return "${url}: ${lerr}"
    }
    ns = quickjs.new_object(p.ctx)
    a = quickjs.new_array(p.ctx)
    _e1 = quickjs.set_index(p.ctx, a, 0, lo)
    _e2 = quickjs.set_index(p.ctx, a, 1, ns)
    r, cerr = quickjs.call(p.ctx, fn, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, lo)
    quickjs.release(p.ctx, fn)
    if cerr != "" {
        quickjs.release(p.ctx, ns)
        return "${url}: ${cerr}"
    }
    quickjs.release(p.ctx, r)
    m = heap.new(PageModule)
    m.url = own_(url)
    m.ns = ns
    list.add(p.modules, m as ptr)
    return ""
}

// After the page is lowered and made, before it runs: load its import
// closure. Reads the lowerer's record of the page (what it imports, whether
// it is wrapped) before any module is lowered over it. Returns "" or why
// the page cannot run.
modules_prepare_(p: *Page) -> string {
    p.modules = list.new()
    p.mod_factory = 0
    p.wrapped = lower.page_wrapped()
    imports = own_(lower.page_imports())
    seeks = string.concat(lower.page_seeks(), lower.page_optional())
    if imports == "" && p.wrapped == 0 { return "" }
    f, ferr = engine_eval_(p.ctx, MOD_FACTORY_JS, "sae:loader")
    if ferr != "" { return "the module loader could not start: ${ferr}" }
    a = args1_(p.ctx, p.mod_get)
    fac, cerr = quickjs.call(p.ctx, f, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, f)
    if cerr != "" { return "the module loader could not start: ${cerr}" }
    p.mod_factory = fac
    loading = strarr.new()
    _l = strarr.push_copy(loading, p.url)
    why = mod_imports_(p, p.url, imports, seeks, p.url, loading)
    strarr.free(loading)
    return why
}

// Run a wrapped page: call its function with the page's $sae. An async
// wrapper (a top-level await) gives a promise; a rejection of it is
// reported as an uncaught exception, through $sae.fail. Returns (value, "")
// or (0, error).
modules_run_page_(p: *Page, fn: int) -> (int, string) {
    lo, lerr = mod_loader_(p, p.url)
    if lerr != "" {
        quickjs.release(p.ctx, fn)
        return 0, lerr
    }
    a = args1_(p.ctx, lo)
    r, err = quickjs.call(p.ctx, fn, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, lo)
    quickjs.release(p.ctx, fn)
    if err != "" { return 0, err }
    if quickjs.type_of(p.ctx, r) == "promise" {
        then, terr = quickjs.get(p.ctx, r, "then")
        if terr == "" {
            ta = quickjs.new_array(p.ctx)
            und = quickjs.new_undefined(p.ctx)
            _t1 = quickjs.set_index(p.ctx, ta, 0, und)
            _t2 = quickjs.set_index(p.ctx, ta, 1, p.mod_fail)
            r2, _e = quickjs.call(p.ctx, then, r, ta)
            quickjs.release(p.ctx, r2)
            quickjs.release(p.ctx, und)
            quickjs.release(p.ctx, ta)
            quickjs.release(p.ctx, then)
        }
    }
    return r, ""
}

modules_free_(p: *Page) {
    if p.modules == null { return }
    n = list.size(p.modules)
    i = 0
    while i < n {
        mv, _ = list.get(p.modules, i)
        m = mv as *PageModule
        quickjs.release(p.ctx, m.ns)
        heap.free(m)
        i = i + 1
    }
    list.free(p.modules)
    p.modules = null
    if p.mod_factory != 0 { quickjs.release(p.ctx, p.mod_factory) }
    quickjs.release(p.ctx, p.mod_get)
    quickjs.release(p.ctx, p.mod_fail)
}

// --- the page API: $sae, the loader object a unit's wrapper takes ---

// $sae.m(spec): the namespace of a module this page imported, resolved
// against the unit's own URL (this.url). Nothing is fetched here: a module
// not in the registry (not imported statically) is a TypeError.
sae_mod_get(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    spec = arg_str_(ctx, argv, argc, 0)
    url = js_prop_str_(ctx, this_val, "url", p.url)
    target, why = module_resolve_(url, spec)
    if why != "" { return sae_throw_type_error(ctx, "import refused: ${why}") }
    m = mod_find_(p, target)
    if m == null { return sae_throw_type_error(ctx, "\"${spec}\" is not imported by this page (imports are static: an import statement at the top of the page)") }
    return quickjs.dup(ctx, m.ns)
}

// $sae.fail(e): what a page's top-level await left unhandled.
sae_mod_fail(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    say_("sae: uncaught exception in ${p.url} (after a top-level await):\n${arg_str_(ctx, argv, argc, 0)}")
    return 0
}

// --- navigation ---

set_status_(b: *Browser, s: string) {
    if b.status != 0 { ui.set_text(b.status, s) }
}

// Tear down the current page (its widgets, then its context) and load url
// into the content area. Does not touch history.
load_(b: *Browser, url: string) {
    long t0 = os.now_monotonic_ns()
    status, body, final_url, err = fetch_(url)
    long t_fetch = os.now_monotonic_ns()

    ui.clear_children(b.content)
    if b.page != null {
        page_free_(b.page as *Page)
        b.page = null
    }
    if b.addr != 0 { ui.set_text(b.addr, final_url) }

    if err != "" {
        ui.text(mem.long_to_ptr(b.content), "Could not load ${url}")
        ui.text(mem.long_to_ptr(b.content), err)
        set_status_(b, "error: ${err}")
        println("sae: could not load ${url}: ${err}")
        b.last_ok = 0
        return
    }

    long t_lower0 = os.now_monotonic_ns()
    es5, lerr = lower.lower_source(body, final_url)
    long lower_ns = os.now_monotonic_ns() - t_lower0
    if lerr != "" {
        ui.text(mem.long_to_ptr(b.content), "This page could not be read:")
        ui.text(mem.long_to_ptr(b.content), lerr)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${lerr}")
        b.last_ok = 0
        return
    }

    // What the page seeks, against what this context grants: refused here,
    // before any of its code runs, with the reason (docs/app-capabilities.md).
    why = seek_refusal_(final_url, lower.page_seeks())
    if why != "" {
        ui.text(mem.long_to_ptr(b.content), "This page cannot run here:")
        ui.text(mem.long_to_ptr(b.content), why)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${why}")
        b.last_ok = 0
        return
    }

    // Optional privileges this context cannot give are left out; scopes are
    // checked against the grant here too, before any of the page runs. An
    // optional outgoing-http whose scope reaches past the grant goes the
    // same way as one not granted at all: the page does without.
    absent = absent_of_(lower.page_optional())
    // A privilege the page does not seek at all has no object either. The
    // lowerer refuses a page that names one unsought, but only by name:
    // without this, globalThis["ht" + "tp"] would reach it.
    absent = string.concat(absent, unsought_(lower.page_seeks(), lower.page_optional()))
    scopes, swhy = http_scopes_for_(final_url, lower.page_scopes())
    if swhy != "" {
        if string.contains(lower.page_optional(), ",outgoing-http,") == 1 {
            absent = string.concat(absent, "outgoing-http,")
            swhy = ""
            scopes = ""
        }
    }
    if swhy != "" {
        ui.text(mem.long_to_ptr(b.content), "This page cannot run here:")
        ui.text(mem.long_to_ptr(b.content), swhy)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${swhy}")
        b.last_ok = 0
        return
    }

    p = page_new_(b, final_url, absent, scopes)
    b.page = p
    // ===== wave1/imports: the page's static imports, fetched, lowered and
    // run before the page (README "Modules"); refused with the reason.
    mwhy = modules_prepare_(p)
    if mwhy != "" {
        ui.text(mem.long_to_ptr(b.content), "This page's imports could not be loaded:")
        ui.text(mem.long_to_ptr(b.content), mwhy)
        set_status_(b, "${status} ${final_url}")
        say_("sae: ${mwhy}")
        b.last_ok = 0
        return
    }
    times = malloc(16)
    ok = page_run_(p, es5, times)
    long parse_ns = mem.get_long(times, 0)
    long run_ns = mem.get_long(times, 8)
    free(times)
    b.last_ok = ok
    // vg scenes record their shapes while the page builds and draw once it
    // is done (AeVG's deferred mode, so a shape's trailing fill() is known
    // before it paints). Aether's window() drains that after its block; a
    // page loads into an already-running window, so drain it here.
    aether_ui_surface_flush_deferred_impl()
    if ok == 0 {
        ui.text(mem.long_to_ptr(b.content), "This page failed: see the console.")
    }
    set_status_(b, "${status} ${final_url}")
    println("sae: ${status} ${final_url} (us) fetch=${us_(t_fetch - t0)} lower=${us_(lower_ns)} parse=${us_(parse_ns)} run=${us_(run_ns)} widgets=${us_(p.ui_ns)}/${p.ui_calls} js=${us_(run_ns - p.ui_ns)}")
}

hist_url_(b: *Browser, i: int) -> string {
    return strarr.get(b.history, i)
}

// Go to url as a new history entry, dropping any forward entries.
go_(b: *Browser, url: string) {
    i = b.hist_index + 1
    if i < strarr.size(b.history) {
        strarr.set(b.history, i, own_(url))
    } else {
        strarr.push_copy(b.history, url)
    }
    b.hist_index = i
    b.hist_len = i + 1
    load_(b, url)
}

// 1 while the pending navigation is one typed into the address bar.
var nav_typed_ = 0

run_nav_(b: *Browser) {
    kind = b.pending_kind
    url = b.pending_url
    b.pending_kind = NAV_NONE
    if kind == NAV_GO {
        // An app's pages navigate only among themselves (Tauri's default).
        if app_dir_ != "" && is_app_(url) == 0 {
            println("sae: this app navigates only to its own pages; refused ${url}")
            fflush(sae_stdout())
            return
        }
        // wave1/escape: a web page stays on http(s); no path climbs out.
        // The rule holds a page's own navigations; an address typed into
        // the browser's bar is the person's, and goes where they say (a file
        // page's folder does not bound them), as esc_nav_check_ intends.
        typed = nav_typed_
        nav_typed_ = 0
        nurl = url
        if typed == 0 || app_dir_ != "" {
            n2, nwhy = esc_nav_check_(b, url)
            if nwhy != "" {
                esc_log_(nwhy)
                return
            }
            nurl = n2
        }
        go_(b, nurl)
    }
    if kind == NAV_BACK {
        if b.hist_index > 0 {
            b.hist_index = b.hist_index - 1
            load_(b, hist_url_(b, b.hist_index))
        }
    }
    if kind == NAV_FORWARD {
        if b.hist_index + 1 < b.hist_len {
            b.hist_index = b.hist_index + 1
            load_(b, hist_url_(b, b.hist_index))
        }
    }
    if kind == NAV_RELOAD {
        if b.hist_index >= 0 { load_(b, hist_url_(b, b.hist_index)) }
    }
}

// Record a navigation and carry it out on the next turn of the event loop.
// The latest request wins, as a second click on a link would.
request_nav_(b: *Browser, kind: int, url: string) {
    b.pending_kind = kind
    b.pending_url = own_(url)
    nav_typed_ = 0   // the Go button sets it again after this; a page never does
    if b.nav_timer == 0 {
        b.nav_timer = ui.timer(1, || {
            ui.timer_cancel(b.nav_timer)
            b.nav_timer = 0
            run_nav_(b)
        })
    }
}

// --- the window ---

build_chrome_(b: *Browser, root: int) {
    rctx = mem.long_to_ptr(root)
    bar = ui.hstack(rctx, 4)
    bctx = mem.long_to_ptr(bar)
    ui.btn(bctx, "Back", || { request_nav_(b, NAV_BACK, "") })
    ui.btn(bctx, "Forward", || { request_nav_(b, NAV_FORWARD, "") })
    ui.btn(bctx, "Reload", || { request_nav_(b, NAV_RELOAD, "") })
    b.addr = ui.textfield(bctx, "address", |s: string| { })
    ui.btn(bctx, "Go", || {
        typed = ui.get_text(b.addr)
        base = ""
        if b.page != null { base = (b.page as *Page).url }
        // Local addresses are paths from the working directory, just like
        // the command-line argument and the path shown in this field.
        // Only web/app addresses resolve against the current page. Page
        // links still use resolve_ for directory-relative navigation.
        target = own_(typed)
        if is_http_(base) == 1 || is_app_(base) == 1 {
            target = resolve_(base, typed)
        }
        request_nav_(b, NAV_GO, target)
        nav_typed_ = 1   // the person asked, not the page: see run_nav_
    })
    b.status = ui.text(rctx, "")
    ui.divider(rctx)
    build_content_(b, rctx)
}

// The scrolling area pages build into. In app mode it is all there is.
build_content_(b: *Browser, rctx: ptr) {
    scroller = ui.scrollview(rctx)
    b.content = ui.vstack(mem.long_to_ptr(scroller), 4)
}

browser_new_() -> *Browser {
    b = heap.new(Browser)
    b.history = strarr.new()
    b.hist_len = 0
    b.hist_index = -1
    b.page = null
    b.pending_kind = NAV_NONE
    b.nav_timer = 0
    b.page_mem = PAGE_MEM_DEFAULT
    pm = env_("SAE_PAGE_MEM")
    if pm != "" {
        v, perr = string.to_long(pm)
        if perr == "" && v > 0 { b.page_mem = v }
    }
    return b
}

// --- app mode ---
//
// `sae --app <dir>`, or a binary that finds its pages beside it in a macOS
// .app bundle (Contents/Resources/app): no browser chrome, the window titled
// and sized for the app, pages loaded from <dir> as app: URLs. The optional
// <dir>/app.json:
//   { "name": "Banking", "start": "/", "width": 800, "height": 600 }

// 1 if `d` holds an app: an app.json, index.ts or index.js.
is_app_dir_(d: string) -> int {
    if fs.exists("${d}/app.json") == 1 { return 1 }
    if fs.exists("${d}/index.ts") == 1 { return 1 }
    if fs.exists("${d}/index.js") == 1 { return 1 }
    return 0
}

// The pages a packaged binary carries, or "" when there are none:
// <exe dir>/../Resources/app (the .app layout tools/saepack.sh makes), else
// app/ in the working directory (an APK from tools/saepack-android.sh: the
// Android backend copies the app's assets out and runs it among them).
bundled_app_dir_(exe: string) -> string {
    d = string.concat(dir_of_(exe), "../Resources/app")
    if is_app_dir_(d) == 1 { return d }
    if is_app_dir_("app") == 1 { return "app" }
    return ""
}

// A string or int setting from app.json, or the default.
app_setting_(v: ptr, key: string, dflt: string) -> string {
    if v == null { return dflt }
    f = json.json_object_get_raw(v, key)
    if f == null { return dflt }
    sv, serr = json.get_string(f)
    if serr != "" { return dflt }
    return own_(sv)
}

app_setting_int_(v: ptr, key: string, dflt: int) -> int {
    if v == null { return dflt }
    f = json.json_object_get_raw(v, key)
    if f == null { return dflt }
    return json.json_get_int(f)
}

// The last path component, for an app's default name.
base_name_(d: string) -> string {
    t = d
    while string.string_ends_with(t, "/") == 1 { t = string.string_substring(t, 0, string.length(t) - 1) }
    return string.string_substring(t, string.length(dir_of_(t)), string.length(t))
}

// sae <url | page>             the browser
// sae --app <dir>              an app, without browser chrome
// sae (in a packaged .app)     the app bundled beside the binary
// sae (in an APK)              the app among the files it runs in
main() {
    code = sae_main(os.args_get(1), os.args_get(2), os.argv0())
    if code != 0 { exit(code) }
}

sae_main(arg1: string, arg2: string, exe: string) -> int {
    app = ""
    start_url = arg1
    if arg1 == "--app" { app = arg2 }
    if arg1 == "" { app = bundled_app_dir_(exe) }
    if app == "" && start_url == "" {
        println("usage: sae <url | page.js>   or   sae --app <dir>")
        return 2
    }
    title = "Sae it ain't so"
    w = 800
    h = 600
    b = browser_new_()
    browser_ = b as ptr
    stdlib.configure(lib_dir_(exe))   // wave1/imports: the sae: library
    root = aether_ui_vstack_create(6)
    sqlite_why = ""   // wave1/sqlite: why the app cannot start, if a database cannot be opened or migrated
    if app != "" {
        while string.string_ends_with(app, "/") == 1 { app = string.string_substring(app, 0, string.length(app) - 1) }
        app_dir_ = own_(app)
        manifest = null
        mtext, merr = fs.read("${app}/app.json")
        if merr == "" {
            mv, _jerr = json.parse(mtext)
            manifest = mv
        }
        title = app_setting_(manifest, "name", base_name_(app))
        app_name_ = own_(title)
        bundled = 0
        if arg1 == "" { bundled = 1 }
        app_key_ = app_storage_key_(app, exe, bundled)
        w = app_setting_int_(manifest, "width", 800)
        h = app_setting_int_(manifest, "height", 600)
        start_url = resolve_("app:/", app_setting_(manifest, "start", "/"))
        read_capabilities_(manifest)
        sqlite_why = sqlite_start_(manifest)   // wave1/sqlite: before any page runs
        build_content_(b, mem.long_to_ptr(root))
    } else {
        build_chrome_(b, root)
    }
    if sqlite_why != "" { sqlite_refuse_app_(b, sqlite_why) } else { go_(b, start_url) }   // wave1/sqlite

    if env_("SAE_NO_WINDOW") != "" {
        if b.page != null { page_free_(b.page as *Page) }
        if b.last_ok == 1 { return 0 }
        return 1
    }
    port = env_("AETHER_UI_TEST_PORT")
    if port != "" {
        pn, _ = string.to_int(port)
        ui.enable_test_server_root(pn, root)
    }
    // The page lives as long as the window, so it is not freed here: a
    // desktop backend's window_run returns as the process ends, and
    // Android's returns at once (the platform's loop runs the app from
    // then on, through the page's handlers).
    ui.window_run(title, w, h, root)
    return 0
}
