        }
        api("a11y_label", sae_ui_a11y_label, 2) {
            arg("h", T_HANDLE)
            arg("text", T_STR)
            gives(T_HANDLE)
            doc("What a screen reader calls a widget or a vg scene.")
        }
        api("a11y_role", sae_ui_a11y_role, 2) {
            arg("h", T_HANDLE)
            arg("role", T_STR)
            gives(T_HANDLE)
            doc("What a widget or a vg scene is to a screen reader (button, heading, group, image, list, listitem, grid, ... none).")
        }
        api("a11y_description", sae_ui_a11y_description, 2) {
            arg("h", T_HANDLE)
            arg("text", T_STR)
            gives(T_HANDLE)
            doc("The longer account a screen reader reads after the name.")
        }
        api("a11y_announce", sae_ui_a11y_announce, 2) {
            arg("h", T_HANDLE)
            arg("text", T_STR)
            gives(T_HANDLE)
            doc("A line a screen reader says now, without moving the focus.")
        }
        api("click_through", sae_ui_click_through, 2) {
            arg("h", T_HANDLE)
            arg("on", T_FLAG)
            gives(T_HANDLE)
            doc("Lets the pointer pass through a widget or a vg scene to what lies under it.")
        }
        api("_textarea", sae_ui_textarea, 2) {
            arg("placeholder", T_STR)
            opt_ts("onChange", "(text: string) => void")
            gives(T_WIDGET)
            internal()
            doc("The host primitive under ui.textarea.")
        }
        api("text_measure", sae_ui_text_measure, 2) {
            arg("h", T_WIDGET)
            arg("text", T_STR)
            gives(T_INT)
            doc("How wide text would be in label h's font, in px.")
        }
        api("cells", sae_ui_amb_cells, 1) {
            arg_ts("fn", "(row: number, col: number) => string")
            doc("In a datagrid's block: the cell function, giving a cell's text (a model column).")
        }
        api("headers", sae_ui_amb_headers, 1) {
            arg_ts("fn", "(col: number) => string")
            doc("In a datagrid's block: a column's header text.")
        }
        api("on_cell_click", sae_ui_amb_on_cell_click, 1) {
            arg_ts("fn", "(row: number, col: number) => void")
            doc("In a datagrid's block: a cell was clicked.")
        }
        api("on_cell_select", sae_ui_amb_on_cell_select, 1) {
            arg_ts("fn", "(row: number, col: number) => void")
            doc("In a datagrid's block: the selection moved to a cell.")
        }
        api("on_cell_activate", sae_ui_amb_on_cell_activate, 1) {
