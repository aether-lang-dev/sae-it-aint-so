// sae's host: the browser window, one mquickjs context per page, and the
// page API that context can reach (`ui` and `browserContext`).
//
// The page API mirrors the Aether DSL. In Aether, `vstack(4) { ... }` makes a
// handle, attaches it to the ambient `_ctx`, and runs the trailing block with
// `_ctx` set to that handle. Here a page calls `ui.vstack(4, function () {
// ... })` and the host does the same thing at run time with a stack of
// handles: push, call the function, pop. The bottom of the stack is the
// browser's content area, so a page's top-level widgets land there.
//
// Navigation is deferred. A page asks for it (browserContext.changePage)
// from inside its own JS, often from a click handler whose button is about to
// be destroyed; so the request is recorded and carried out on the next turn
// of the event loop, after the JS call has returned.

import ui
import std.mem
import std.fs
import std.os
import std.list
import std.strarr
import std.string
import std.http.client
import lower
import vg
import vg.live
import std.json
import std.actors

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern sae_new_context(mem_block: ptr, mem_size: long) -> ptr
extern sae_js_undefined() -> long
extern sae_js_null() -> long
extern sae_js_exception() -> long
extern sae_js_is_exception(v: long) -> int
extern sae_gcref_size() -> long
extern sae_cstringbuf_size() -> long
extern sae_throw_type_error(ctx: ptr, msg: string) -> long
extern sae_stdout() -> ptr
extern JS_FreeContext(ctx: ptr)
extern JS_SetContextOpaque(ctx: ptr, opaque: ptr)
extern JS_GetContextOpaque(ctx: ptr) -> ptr
extern JS_Parse(ctx: ptr, input: string, input_len: long, filename: string, eval_flags: int) -> long
extern JS_Run(ctx: ptr, val: long) -> long
extern JS_GetException(ctx: ptr) -> long
extern JS_PrintValueF(ctx: ptr, val: long, flags: int)
extern JS_IsString(ctx: ptr, val: long) -> int
extern JS_IsFunction(ctx: ptr, val: long) -> int
extern JS_ToCStringLen(ctx: ptr, plen: ptr, val: long, buf: ptr) -> string
extern JS_ToInt32(ctx: ptr, pres: ptr, val: long) -> int
extern JS_NewInt32(ctx: ptr, val: int) -> long
extern JS_NewInt64(ctx: ptr, val: long) -> long
extern JS_NewString(ctx: ptr, buf: string) -> long
extern JS_NewDate(ctx: ptr, epoch_ms: float) -> long
extern JS_IsNumber(ctx: ptr, val: long) -> int
extern JS_ToNumber(ctx: ptr, pres: ptr, val: long) -> int
extern JS_AddGCRef(ctx: ptr, ref: ptr) -> ptr
extern JS_DeleteGCRef(ctx: ptr, ref: ptr)
extern JS_StackCheck(ctx: ptr, len: int) -> int
extern JS_PushArg(ctx: ptr, val: long)
extern JS_Call(ctx: ptr, call_flags: int) -> long
extern putchar(c: int) -> int
extern fputs(s: string, stream: ptr) -> int
extern fflush(stream: ptr) -> int
extern aether_ui_vstack_create(spacing: int) -> int
extern aether_ui_surface_flush_deferred_impl()
extern JS_NewFloat64(ctx: ptr, d: float) -> long
extern aether_ui_widget_count_impl() -> int
extern aether_ui_test_server_banner_handle() -> int
extern aether_ui_current_sheet_set_impl(sheet: ptr)
extern JS_GetGlobalObject(ctx: ptr) -> long
extern JS_GetPropertyStr(ctx: ptr, obj: long, name: string) -> long
extern JS_GetPropertyUint32(ctx: ptr, obj: long, idx: int) -> long

const JS_DUMP_LONG = 1
const FRAME_CF_CTOR = 65536
const STACK_MAX = 64
const PAGE_MEM_DEFAULT = 1048576

const NAV_NONE = 0
const NAV_GO = 1
const NAV_BACK = 2
const NAV_FORWARD = 3
const NAV_RELOAD = 4

// App mode (`sae --app <dir>`, or a packaged .app): the folder of pages the
// app is made of, "" in browser mode. Its pages are app:/<path> URLs, mapped
// onto <dir>/<path>.ts or .js the way tools/pageserver maps a site.
var app_dir_ = ""
var app_name_ = ""
var page_seq_ = 0
var browser_: ptr = null   // the one browser, for completions that arrive later

// The browser: chrome widgets, history, and the page currently shown.
struct Browser {
    addr: int        // address field
    status: int      // status line
    content: int     // the content area pages build into
    history: ptr     // std.strarr of URL copies; entries past hist_len are stale
    hist_len: int
    hist_index: int
    page: ptr        // *Page, or null
    pending_kind: int
    pending_url: string
    nav_timer: int
    page_mem: long
    last_ok: int     // did the last load fetch and run cleanly
}

// One per loaded page, hung off its JSContext's opaque slot.
struct Page {
    ctx: ptr
    browser: ptr     // *Browser
    url: string
    mem_block: ptr
    stack: ptr       // handles, STACK_MAX ints
    depth: int
    refs: ptr        // std.list of JSGCRef*, the JS functions widgets hold
    scratch: ptr     // 8 bytes for out-params
    cbuf: ptr        // JSCStringBuf for JS_ToCStringLen
    ui_ns: long      // time spent inside ui builders (excludes nested page blocks)
    ui_calls: int
    // AeVG: a second stack, of vg nodes. vg.scene pushes its root, each
    // shape with a block pushes itself; fill/stroke/... act on the top.
    vg_stack: ptr    // STACK_MAX node pointers
    vg_depth: int
    vg_nodes: ptr    // std.list: the nodes handed to the page (handle = index + 1)
    // Widget handles are never reused, so every widget this page made has a
    // handle at least first_handle. A page may name only those: not the
    // address bar, the status line, the driver's banner or a past page's.
    first_handle: int
    stacks: ptr      // std.list: the vstack/hstack handles this page made
    root: int        // the page's own stack in the content area: its widgets
                     //   go in it, its styles stop at it, it goes with the page
    sheet: ptr       // the page's AeCS sheet (ui.styles), or null
    sheet_strs: ptr  // std.list: selector and family strings the sheet borrows
    timers: ptr      // std.list: the ui.timer ids this page started (0 once cancelled)
    seq: int         // which load this is: an http reply for an older page is dropped
}

page_of_(ctx: ptr) -> *Page {
    return JS_GetContextOpaque(ctx) as *Page
}

browser_of_(ctx: ptr) -> *Browser {
    return page_of_(ctx).browser as *Browser
}

// An owned copy of a borrowed string (a JS_ToCStringLen result, say).
own_(s: string) -> string {
    return string.concat(s, "")
}

// An environment variable's value, "" when unset (os.getenv gives null).
env_(name: string) -> string {
    v = os.getenv(name)
    if v == null { return "" }
    return v
}

us_(ns: long) -> long { return ns / 1000 }

// The clocks, for page-API functions, which cannot name `os` (see "The page
// veto" below).
now_ns_() -> long { return os.now_monotonic_ns() }
now_ms_() -> long { return scaled_(os.now_monotonic_ms(), 0) }
now_unix_ms_() -> long { return scaled_(os.now_unix_ms(), 1) }

// SAE_TIME_SCALE=<n> runs the clocks pages see (Date.now, new Date(),
// performance.now) n times fast, from the moment each is first read, so a
// spec can watch a minute-long timer finish in seconds. Off (1x) unless set.
var time_scale_ = 0
var time_base_mono_: long = 0
var time_base_unix_: long = 0

scaled_(real: long, which: int) -> long {
    if time_scale_ == 0 {
        time_scale_ = 1
        sv = env_("SAE_TIME_SCALE")
        if sv != "" {
            n, nerr = string.to_int(sv)
            if nerr == "" && n > 1 { time_scale_ = n }
        }
    }
    if time_scale_ == 1 { return real }
    if which == 0 {
        if time_base_mono_ == 0 { time_base_mono_ = real }
        return time_base_mono_ + (real - time_base_mono_) * time_scale_
    }
    if time_base_unix_ == 0 { time_base_unix_ = real }
    return time_base_unix_ + (real - time_base_unix_) * time_scale_
}

arg_(argv: ptr, i: int) -> long {
    return mem.get_long(argv, i * 8)
}

// The argument as a C string, valid until the next arg_str_ call on this page.
arg_str_(ctx: ptr, argv: ptr, argc: int, i: int) -> string {
    if i >= argc { return "" }
    p = page_of_(ctx)
    return JS_ToCStringLen(ctx, p.scratch, arg_(argv, i), p.cbuf)
}

arg_int_(ctx: ptr, argv: ptr, argc: int, i: int, dflt: int) -> int {
    if i >= argc { return dflt }
    p = page_of_(ctx)
    if JS_ToInt32(ctx, p.scratch, arg_(argv, i)) != 0 { return dflt }
    return mem.get_int(p.scratch, 0)
}

top_(p: *Page) -> int {
    return mem.get_int(p.stack, (p.depth - 1) * 4)
}

push_(p: *Page, handle: int) -> int {
    if p.depth >= STACK_MAX { return 0 }
    mem.set_int(p.stack, p.depth * 4, handle)
    p.depth = p.depth + 1
    return 1
}

pop_(p: *Page) {
    if p.depth > 0 { p.depth = p.depth - 1 }
}

// Call a JS function with no arguments. Returns the JSValue result, which is
// the exception sentinel if the function threw.
call0_(ctx: ptr, fnv: long) -> long {
    if JS_StackCheck(ctx, 2) != 0 { return sae_js_exception() }
    JS_PushArg(ctx, fnv)
    JS_PushArg(ctx, sae_js_null())
    return JS_Call(ctx, 0)
}

report_exception_(ctx: ptr, where_: string) {
    println("sae: uncaught exception in ${where_}:")
    JS_PrintValueF(ctx, JS_GetException(ctx), JS_DUMP_LONG)
    putchar(10)
    fflush(sae_stdout())
}

// Keep a JS function alive (and findable after a compacting GC) for as long
// as the page lives. Returns the JSGCRef; its first word is the value.
hold_(ctx: ptr, fnv: long) -> ptr {
    p = page_of_(ctx)
    ref = malloc(sae_gcref_size())
    slot = JS_AddGCRef(ctx, ref)
    mem.set_long(slot, 0, fnv)
    list.add(p.refs, ref)
    return ref
}

// A container builder: make it under the current top, then run the page's
// block function with it on top. The pop happens even if the block throws,
// so later widgets never attach to the wrong parent.
container_(ctx: ptr, argv: ptr, argc: int, handle: int) -> long {
    p = page_of_(ctx)
    if argc >= 2 {
        fnv = arg_(argv, 1)
        if JS_IsFunction(ctx, fnv) == 0 {
            return sae_throw_type_error(ctx, "container block must be a function")
        }
        if push_(p, handle) == 0 {
            return sae_throw_type_error(ctx, "containers nested too deeply")
        }
        r = call0_(ctx, fnv)
        pop_(p)
        if sae_js_is_exception(r) != 0 { return r }
    }
    return JS_NewInt32(ctx, handle)
}

// Is `h` a widget this page made? (See Page.first_handle.)
owned_(p: *Page, h: int) -> int {
    if h < p.first_handle { return 0 }
    // The driver's banner is made lazily, on its first request, so in a
    // sae-driver build it can land among the first page's handles.
    if h == aether_ui_test_server_banner_handle() { return 0 }
    return 1
}

// Is `h` a vstack or hstack this page made?
own_stack_(p: *Page, h: int) -> int {
    n = list.size(p.stacks)
    i = 0
    while i < n {
        v, _ = list.get(p.stacks, i)
        if mem.ptr_to_long(v) == h { return 1 }
        i = i + 1
    }
    return 0
}

// Account a builder call's native time to the page, so the timing report
// can split engine time from widget-creation time.
ui_done_(p: *Page, t: long) {
    p.ui_ns = p.ui_ns + (os.now_monotonic_ns() - t)
    p.ui_calls = p.ui_calls + 1
}

// --- The page veto ---
//
// Every function a page can reach (everything gen/sae_spec.ae registers,
// listed in src/sae_rom.c's SAE_JSFN prototypes) opens with the same `hide`
// line. It takes the kernel out of that function's scope: the file system,
// the environment and clocks (`os`), the network (`client`), the lowerer,
// the page-lifecycle functions that fetch, parse and run pages, and the
// engine's raw parse/run/context calls. Naming any of them in a page-API
// function, at any depth (an `if` body, a nested block, a closure), is a
// compile error.
//
// What a page-API function may use of the kernel, it reaches through named
// helpers: `request_nav_` (navigation, deferred to the event loop),
// `resolve_` (URL arithmetic), `now_ns_`/`now_ms_`/`now_unix_ms_` (clocks).
//
// This is Aether's compile-time `hide` (aether/docs/hide-and-seal.md):
// it stops a page-facing function from naming the kernel, not a helper it
// calls from doing so, so the helpers stay few and narrow. The list grows;
// the end state is `seal except`, a whitelist per function.
// tests/check_page_veto.sh fails if a page-API function lacks the line, or
// if the compiler does not enforce it.

// --- the page API: ui (named in gen/sae_spec.ae) ---

@c_callback
sae_ui_vstack(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    long t = now_ns_()
    h = ui.vstack(mem.long_to_ptr(top_(p)), arg_int_(ctx, argv, argc, 0, 0))
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    return container_(ctx, argv, argc, h)
}

@c_callback
sae_ui_hstack(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    long t = now_ns_()
    h = ui.hstack(mem.long_to_ptr(top_(p)), arg_int_(ctx, argv, argc, 0, 0))
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    return container_(ctx, argv, argc, h)
}

@c_callback
sae_ui_text(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    label = arg_str_(ctx, argv, argc, 0)
    long t = now_ns_()
    h = ui.text(mem.long_to_ptr(top_(p)), label)
    ui_done_(p, t)
    return JS_NewInt32(ctx, h)
}

@c_callback
sae_ui_divider(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    long t = now_ns_()
    h = ui.divider(mem.long_to_ptr(top_(p)))
    ui_done_(p, t)
    return JS_NewInt32(ctx, h)
}

@c_callback
sae_ui_btn(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    label = arg_str_(ctx, argv, argc, 0)
    if argc < 2 || JS_IsFunction(ctx, arg_(argv, 1)) == 0 {
        return sae_throw_type_error(ctx, "btn(label, fn): fn must be a function")
    }
    ref = hold_(ctx, arg_(argv, 1))
    on_press = || {
        r = call0_(ctx, mem.get_long(ref, 0))
        if sae_js_is_exception(r) != 0 { report_exception_(ctx, "a click handler") }
    }
    long t = now_ns_()
    h = ui.btn(mem.long_to_ptr(top_(p)), label, on_press)
    ui_done_(p, t)
    return JS_NewInt32(ctx, h)
}

// A modifier (margin, bg_color, onclick) acts on the innermost container or
// widget the page opened. At the page's top level there is none: the top of
// the stack is the browser's own content area, which a page must not
// restyle. Aether makes that a compile error; here it throws.
modifier_target_(ctx: ptr, name: string) -> int {
    p = page_of_(ctx)
    if p.depth < 2 { return 0 }
    return top_(p)
}

arg_num_(ctx: ptr, argv: ptr, argc: int, i: int, dflt: float) -> float {
    if i >= argc { return dflt }
    p = page_of_(ctx)
    if JS_ToNumber(ctx, p.scratch, arg_(argv, i)) != 0 { return dflt }
    return mem.get_float64(p.scratch, 0)
}

// Call a held JS function with one string argument.
call1_str_(ctx: ptr, ref: ptr, s: string) -> long {
    if JS_StackCheck(ctx, 3) != 0 { return sae_js_exception() }
    // Allocate the string first: the GC may move the function, so read it
    // from its root afterwards.
    sv = JS_NewString(ctx, s)
    JS_PushArg(ctx, sv)
    JS_PushArg(ctx, mem.get_long(ref, 0))
    JS_PushArg(ctx, sae_js_null())
    return JS_Call(ctx, 1)
}

// button(label, block?): a plain button; the block (if any) runs with the
// button on top, for onclick/bg_color/margin.
@c_callback
sae_ui_button(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    label = arg_str_(ctx, argv, argc, 0)
    long t = now_ns_()
    h = ui.button(mem.long_to_ptr(top_(p)), label)
    ui_done_(p, t)
    return container_(ctx, argv, argc, h)
}

@c_callback
sae_ui_scroll(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    long t = now_ns_()
    sv = ui.scrollview(mem.long_to_ptr(top_(p)))
    h = ui.vstack(mem.long_to_ptr(sv), 0)
    ui_done_(p, t)
    // scroll(block): the block's widgets go in the scrolled stack
    if argc >= 1 && JS_IsFunction(ctx, arg_(argv, 0)) != 0 {
        if push_(p, h) == 0 { return sae_throw_type_error(ctx, "containers nested too deeply") }
        r = call0_(ctx, arg_(argv, 0))
        pop_(p)
        if sae_js_is_exception(r) != 0 { return r }
    }
    return JS_NewInt32(ctx, sv)
}

@c_callback
sae_ui_spacer(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    h = ui.spacer(mem.long_to_ptr(top_(p)))
    return JS_NewInt32(ctx, h)
}

// textfield(placeholder, onChange?): onChange(text) on every edit.
@c_callback
sae_ui_textfield(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    placeholder = own_(arg_str_(ctx, argv, argc, 0))
    has_fn = 0
    ref = null
    if argc >= 2 && JS_IsFunction(ctx, arg_(argv, 1)) != 0 {
        has_fn = 1
        ref = hold_(ctx, arg_(argv, 1))
    }
    on_change = |s: string| {
        if has_fn == 1 {
            r = call1_str_(ctx, ref, s)
            if sae_js_is_exception(r) != 0 { report_exception_(ctx, "a textfield handler") }
        }
    }
    long t = now_ns_()
    h = ui.textfield(mem.long_to_ptr(top_(p)), placeholder, on_change)
    ui_done_(p, t)
    return JS_NewInt32(ctx, h)
}

// get_text(handle): synchronous, in-process (Tsyne needed an await here).
@c_callback
sae_ui_get_text(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(page_of_(ctx), h) == 0 { return sae_throw_type_error(ctx, "get_text(h): h is not a widget this page made") }
    return JS_NewString(ctx, ui.get_text(h))
}

@c_callback
sae_ui_set_text(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(page_of_(ctx), h) == 0 { return sae_throw_type_error(ctx, "set_text(h, s): h is not a widget this page made") }
    t = arg_str_(ctx, argv, argc, 1)
    ui.set_text(h, t)
    // A button's caption too (Start / Pause): aether-ui keeps that in its own
    // setter, a no-op on anything that is not a button.
    _b = ui.set_button_label(h, t)
    return sae_js_undefined()
}

// clear(h): empty a vstack or hstack the page made, so it can be built
// again with into(). Tsyne pages could not do this (its dynamic-demo logs
// instead of redrawing its list).
@c_callback
sae_ui_clear(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if own_stack_(p, h) == 0 { return sae_throw_type_error(ctx, "clear(h): h is not a vstack or hstack this page made") }
    ui.clear_children(h)
    return sae_js_undefined()
}

// into(h, block): run block with a stack the page made as the parent, so
// its widgets land there, the way the stack's own block did.
@c_callback
sae_ui_into(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if own_stack_(p, h) == 0 { return sae_throw_type_error(ctx, "into(h, fn): h is not a vstack or hstack this page made") }
    if argc < 2 { return sae_throw_type_error(ctx, "into(h, fn): fn is missing") }
    return container_(ctx, argv, argc, h)
}

@c_callback
sae_ui_onclick(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    target = modifier_target_(ctx, "onclick")
    if target == 0 { return sae_throw_type_error(ctx, "onclick() must be called inside a widget's block") }
    if argc < 1 || JS_IsFunction(ctx, arg_(argv, 0)) == 0 {
        return sae_throw_type_error(ctx, "onclick(fn): fn must be a function")
    }
    ref = hold_(ctx, arg_(argv, 0))
    ui.onclick(mem.long_to_ptr(target), || {
        r = call0_(ctx, mem.get_long(ref, 0))
        if sae_js_is_exception(r) != 0 { report_exception_(ctx, "a click handler") }
    })
    return sae_js_undefined()
}

