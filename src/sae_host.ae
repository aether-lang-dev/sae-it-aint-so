    argc = quickjs.arg_count(ctx, argv)
    mo = browser_of_(p).menu_open
    if mo == 0 { return sae_throw_type_error(ctx, "ui.menu_item_accel(label, accel, fn) must be called inside a ui.menu block") }
    if argc < 3 || is_fn_arg_(ctx, argv, 2) == 0 { return sae_throw_type_error(ctx, "ui.menu_item_accel(label, accel, fn): fn must be a function") }
    seq = p.seq
    ref = hold_arg_(ctx, argv, 2)
    ui.menu_item_accel(mo, arg_str_(ctx, argv, argc, 0), arg_str_(ctx, argv, argc, 1), || {
        if ae_live_(lb_, ctx, seq) == 1 { fire_click_(p, ref) }
    })
    return 0
}

// ui.shortcut_chord(first, second, fn): a two-key sequence ("Primary+K",
// then "Primary+S") within about a second and a half. An installed app's
// (window keys outlive a web page, which keeps to ui.on_key).
sae_ui_shortcut_chord(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    lb_ = p.browser as *Browser
    argc = quickjs.arg_count(ctx, argv)
    if browser_of_(p).app_dir == "" { return sae_throw_type_error(ctx, "ui.shortcut_chord: only an installed app binds window keys (a web page has ui.on_key)") }
    if argc < 3 || is_fn_arg_(ctx, argv, 2) == 0 { return sae_throw_type_error(ctx, "ui.shortcut_chord(first, second, fn): fn must be a function") }
    seq = p.seq
    ref = hold_arg_(ctx, argv, 2)
    ui.shortcut_chord(chord_key_(arg_str_(ctx, argv, argc, 0)), chord_key_(arg_str_(ctx, argv, argc, 1)), || {
        if ae_live_(lb_, ctx, seq) == 1 { fire_click_(p, ref) }
    })
    return 0
}

// A chord's key as aether-ui's shortcut syntax names it: Primary is
// Command on macOS (and iOS), Ctrl elsewhere.
chord_key_(k: string) -> string {
    b = ui.backend_name()
    primary = "Ctrl"
    if b == "macos" || b == "uikit" { primary = "Cmd" }
    return string.string_replace_all(k, "Primary", primary)
}

// ui.menu_separator(): a line between items of the menu whose block is running.
sae_ui_menu_separator(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    mo = browser_of_(p).menu_open
    if mo == 0 { return sae_throw_type_error(ctx, "ui.menu_separator() must be called inside a ui.menu block") }
    ui.menu_separator(mo)
    return 0
}

// A modifier (margin, bg_color, onclick) acts on the innermost container or
// widget the page opened. At the page's top level there is none: the top of
// the stack is the browser's own content area, which a page must not
// restyle. Aether makes that a compile error; here it throws.
modifier_target_(p: *Page, name: string) -> int {
    if p.depth < 2 { return 0 }
    return top_(p)
}

arg_num_(ctx: ptr, argv: int, argc: int, i: int, dflt: float) -> float {
    if i >= argc { return dflt }
    return quickjs.arg_float(ctx, argv, i)
}

// Call a held JS function with one string argument.
call1_str_(p: *Page, ref: int, s: string) -> int {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    v = quickjs.new_string(ctx, s)
    _s = js_set_index_(p, args, 0, v)
    quickjs.release(ctx, v)
    r = calln_(p, ref, args)
    quickjs.release(ctx, args)
    return r
}

// button(label, block?): a plain button; the block (if any) runs with the
// button on top, for onclick/bg_color/margin.
sae_ui_button(p: *Page, this_val: int, argv: int) -> int {
