        // From the prelude (src/sae_prelude.js), not the host: the reactive
        // surface, which is also a set of globals.
        provided("state", 1) {
            arg("initial", T_ANY)
            signature("<T>(initial: T): sae.State<T>")
            doc("A reactive value: a number, string or boolean is one aether-ui cell; any other value is kept by the page and the cell counts its versions.")
        }
        provided("computed", 0) {
            rest("args")
            signature("<T>(...args: [...states: sae.State<any>[], fn: () => T]): sae.State<T>")
            doc("computed(...states, fn): a state that follows fn(), evaluated again whenever one of states changes; fn last, so it may be a trailing block.")
        }
        provided("bind", 1) {
            arg("widget", T_ANY)
            rest("rest")
            signature("<W extends sae.Widget>(widget: W, state: sae.State<any> | number): W")
            signature("(strings: TemplateStringsArray, ...values: unknown[]): sae.Widget")
            doc("The widget's text follows the state (a text field and a string state both ways); the tagged template bind`` is a label following several states.")
        }
        provided("bind_enabled", 3) {
            arg("widget", T_WIDGET)
            arg("state", T_ANY)
            opt("invert", T_FLAG)
            gives(T_WIDGET)
            doc("The widget is enabled while the state is true (while false with invert).")
        }
        provided("bind_hidden", 3) {
            arg("widget", T_WIDGET)
            arg("state", T_ANY)
            opt("invert", T_FLAG)
            gives(T_WIDGET)
            doc("The widget is hidden while the state is true (while false with invert).")
        }
        provided("each", 3) {
            arg("list", T_ANY)
            arg("key", T_ANY)
            arg("render", T_FN)
            gives(T_WIDGET)
            signature("<T>(list: sae.State<T[]>, key: keyof T | ((item: T) => unknown), render: (item: T, i: number) => unknown): sae.Widget")
            doc("A column of rows (a row of them inside an hstack), one per item of the list, keyed: a row whose key stays is kept.")
        }
        provided("batch", 1) {
            arg("fn", T_FN)
            signature("<T>(fn: () => T): T")
            doc("Runs fn; the observers of every state it sets run once, at the end.")
        }
        provided("textarea", 0) {
            beyond("placeholder", T_STR)
            beyond_ts("onChange", "(text: string) => void")
            gives(T_WIDGET)
            doc("A multi-line text field; bind binds it both ways to a string state.")
        }
