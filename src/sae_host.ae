// vg.into(h, fn): run fn with a group (or the scene root) the page made on
// top, so its shapes land there: components rendered again, data joins.
sae_ae_into(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(ctx, arg_int_(ctx, argv, argc, 0, 0))
    if r == null || r.el != null { return sae_throw_type_error(ctx, "vg.into(h, fn): h is not a group or scene this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "vg.into(h, fn): fn must be a function") }
    p = page_of_(ctx)
    if vg_push_(p, r.node) == 0 { return sae_throw_type_error(ctx, "vg shapes nested too deeply") }
    c = call_arg_(ctx, argv, 1)
    p.vg_depth = p.vg_depth - 1
    if c < 0 { return rethrow_(ctx) }
    ae_repaint_(ctx)
    return 0
}

