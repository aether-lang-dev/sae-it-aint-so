            arg("kind", T_STR)
            arg("h", T_INT)
            gives(T_ANY)
            internal()
            doc("The host primitive under State.value.")
        }
        api("_cell_set", sae_ae_cell_set, 3) {
            arg("kind", T_STR)
            arg("h", T_INT)
            arg("v", T_ANY)
            internal()
            doc("The host primitive under State.set.")
        }
        api("_computed", sae_ae_computed, 3) {
            arg("fn", T_FN)
            arg("a", T_INT)
            arg("b", T_INT)
            internal()
            doc("The host primitive under computed(): fn runs when either cell changes.")
