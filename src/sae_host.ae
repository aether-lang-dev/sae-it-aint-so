// polygon(points, fn?) and polyline(points, fn?): points as SVG writes them
// ("x,y x,y ...") or as a flat array of numbers; a path underneath, as
// aether-ui's transpiler and loader draw them.
ae_points_arg_(ctx: ptr, argv: int, argc: int) -> string {
    if argc < 1 { return "" }
    h = quickjs.arg(ctx, argv, 0)
    t = quickjs.type_of(ctx, h)
    if t == "string" {
        quickjs.release(ctx, h)
        return own_(arg_str_(ctx, argv, argc, 0))
    }
    n = quickjs.length(ctx, h)
    sb = strbuilder.new(64)
    i = 0
    while i < n {
        if i > 0 {
            if i % 2 == 1 { _c = strbuilder.append(sb, ",") } else { _s = strbuilder.append(sb, " ") }
        }
        _v = strbuilder.append(sb, ae_index_str_(ctx, h, i))
        i = i + 1
    }
    quickjs.release(ctx, h)
    return strbuilder.finish(sb)
}

sae_ae_polygon(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.polygon() must be called inside vg.scene()") }
    p = page_of_(ctx)
    n = vg.path(vg_top_(p), utils.points_to_path(ae_points_arg_(ctx, argv, argc), 1))
    return ae_shape_done_(ctx, argv, argc, 1, n, K_SHAPE)
}

