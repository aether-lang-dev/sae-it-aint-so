// --- the page API: timers ---
//
// Every timer a page starts (ui.timer, ui.after, ui.sleep, setTimeout,
// setInterval) is a PageTimer in the page's own queue, and the queue runs on
// ONE aether-ui one-shot (ui.timer_once) armed for its earliest due time: the
// page's "wake". When it fires, the timers that are due run in order of due
// time, then of creation (HTML's order for timers with the same delay), each
// followed by the page's promise jobs, and the wake is re-armed. A one-shot
// leaves the queue BEFORE its callback runs, so it runs exactly once however
// slow its callback is or whatever it throws; an interval is rescheduled
// before its callback runs, from now, so a slow one drifts rather than
// bursting. A timer started while the batch runs waits for the next wake,
// as a task queued by a task does.
//
// Ids are the page's own (1, 2, ...), shared by every kind, so timer_cancel,
// clearTimeout and clearInterval each cancel any of them, as in a browser.
// A page reaches only its own queue: there is no way to name another page's
// timer. When the page goes, page_free_ cancels the wake and its frame
// subscription and drops the queue: nothing fires afterwards, and a pending
// ui.sleep promise is never settled (it goes with the runtime).
//
// Clamping, as HTML does it: a negative, NaN or overflowing (> 2^31-1)
// delay is 0; a timer started from a timer callback nested more than 5 deep,
// and an interval past its fifth run, has at least 4 ms. ui.timer keeps its
// floor of 10 ms. A delay of 0 runs on the next turn of the event loop.
//
// requestAnimationFrame (and ui.frame) is a separate list: the page holds
// one aether-ui on_frame subscription while the list is not empty, and each
// display frame runs (and empties) the list as it stood when the frame began,
// passing every callback the same timestamp, on performance.now()'s clock in
// fractional milliseconds. A callback that requests again is in the next
// frame. When nothing is waiting the subscription is cancelled, so an idle
// page costs no frames.

struct PageTimer {
    id: int
    due: long        // ms on the real monotonic clock
    interval: int    // ms between runs; 0 for a one-shot
    floor: int       // the interval's minimum (10 for ui.timer, else 0)
    seq: int         // queue order among equal due times
    nesting: int     // HTML's timer nesting level
    fn_h: int        // the held JS function
    args_h: int      // a held JS array of extra arguments, or 0
    alive: int
}

struct PageRaf {
    id: int          // 0 once cancelled
    fn_h: int
}

// The real (unscaled) monotonic clock in ms: SAE_TIME_SCALE speeds up the
// clocks a page reads, not its timers.
real_ms_() -> long { return os.now_monotonic_ms() }

// The clock requestAnimationFrame's timestamp is on: performance.now()'s,
// with the fraction kept.
raf_now_(b: *Browser) -> float {
    long ms = now_ms_(b.clock)   // also starts SAE_TIME_SCALE's base
    if b.clock.scale == 1 { return esc_perf_now_(b) }   // wave1/escape: coarse in the browser
    return ms as float
}

// A delay argument as HTML reads it: NaN, negative and overflowing are 0.
delay_arg_(ctx: ptr, argv: int, argc: int, i: int) -> int {
    if i >= argc { return 0 }
    d = quickjs.arg_float(ctx, argv, i)
    if d != d || d < 0.0 || d > 2147483647.0 { return 0 }
    return d as int
}

// Start a timer on page p: fn_h and args_h become the queue's (released when
// the timer goes). Returns its id.
timer_add_(p: *Page, fn_h: int, args_h: int, ms: int, repeat: int, floor: int) -> int {
    level = p.timer_nesting
    if ms < 0 { ms = 0 }
    if level > 5 && ms < 4 { ms = 4 }
    if ms < floor { ms = floor }
    t = heap.new(PageTimer)
    p.timer_ids = p.timer_ids + 1
    t.id = p.timer_ids
    t.due = real_ms_() + ms
    t.interval = 0
    if repeat == 1 { t.interval = ms }
    if repeat == 1 && t.interval < 1 { t.interval = 0 - 1 }   // setInterval(fn, 0)
    t.floor = floor
    p.timer_seq = p.timer_seq + 1
    t.seq = p.timer_seq
    t.nesting = level + 1
    t.fn_h = fn_h
    t.args_h = args_h
    t.alive = 1
    list.add(p.timers, t as ptr)
    if p.timers_running == 0 { timers_arm_(p) }
    return t.id
}

// Release a timer's JS handles and free it.
timer_drop_(p: *Page, t: *PageTimer) {
    if t.fn_h != 0 { quickjs.release(p.ctx, t.fn_h) }
    if t.args_h != 0 { quickjs.release(p.ctx, t.args_h) }
    heap.free(t)
}

// Remove the cancelled and the finished from the queue.
timers_sweep_(p: *Page) {
    i = list.size(p.timers) - 1
    while i >= 0 {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 0 {
            list.list_remove(p.timers, i)
            timer_drop_(p, t)
        }
        i = i - 1
    }
}

// The index of the earliest timer due by `now` and queued by `seq_max`, -1
// if none is.
timers_next_(p: *Page, now: long, seq_max: int) -> int {
    best = 0 - 1
    long best_due = 0
    best_seq = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 1 && t.due <= now && t.seq <= seq_max {
            if best < 0 || t.due < best_due || (t.due == best_due && t.seq < best_seq) {
                best = i
                best_due = t.due
                best_seq = t.seq
            }
        }
        i = i + 1
    }
    return best
}

// Arm the page's wake for its earliest timer, or disarm it when none is left.
timers_arm_(p: *Page) {
    long due = 0
    found = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 1 && (found == 0 || t.due < due) {
            due = t.due
            found = 1
        }
        i = i + 1
    }
    if found == 0 {
        if p.wake != 0 { ui.timer_cancel(p.wake) }
        p.wake = 0
        return
    }
    if p.wake != 0 && p.wake_due == due { return }
    if p.wake != 0 { ui.timer_cancel(p.wake) }
    long wait = due - real_ms_()
    if wait < 0 { wait = 0 }
    ctx = p.ctx
    p.wake_due = due
    wb = p.browser as *Browser
    p.wake = ui.timer_once(wait as int, || {
        lp = page_of_(wb, ctx)   // the page may have gone since
        if lp != null { timers_wake_(lp) }
    })
}

// The wake fired: run what is due, in order, then re-arm.
timers_wake_(p: *Page) {
    ctx = p.ctx
    p.wake = 0
    long now = real_ms_()
    seq_max = p.timer_seq   // what this batch started with
    p.timers_running = 1
    ti = timers_next_(p, now, seq_max)
    while ti >= 0 {
        tv, _ = list.get(p.timers, ti)
        t = tv as *PageTimer
        if t.interval == 0 {
            t.alive = 0   // a one-shot leaves the queue before it runs
        } else {
            level = t.nesting
            iv = t.interval
            if iv < 0 { iv = 0 }
            if level > 5 && iv < 4 { iv = 4 }
            if iv < t.floor { iv = t.floor }
            t.due = now + iv
            t.nesting = level + 1
            p.timer_seq = p.timer_seq + 1
            t.seq = p.timer_seq   // not again in this batch, even at 0 ms
        }
        p.timer_nesting = t.nesting
        r = 0
        if t.args_h != 0 { r = calln_(p, t.fn_h, t.args_h) }
        else { r = call0_(p, t.fn_h) }
        p.timer_nesting = 0
        if r < 0 { report_exception_(p, "a timer") }
        settle_(p)
        ti = timers_next_(p, now, seq_max)
    }
    p.timers_running = 0
    timers_sweep_(p)
    timers_arm_(p)
}

// Cancel one of page p's timers by id; any other id is ignored.
timer_cancel_id_(p: *Page, id: int) {
    if id <= 0 { return }
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.id == id && t.alive == 1 {
            t.alive = 0
            if p.timers_running == 0 {
                timers_sweep_(p)
                timers_arm_(p)
            }
            return
        }
        i = i + 1
    }
}

// The page goes: its wake, its frame subscription and every queued callback.
timers_free_(p: *Page) {
    if p.wake != 0 { ui.timer_cancel(p.wake) }
    p.wake = 0
    if p.frame_sub != 0 { ui.frame_cancel(p.frame_sub) }
    p.frame_sub = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        timer_drop_(p, v as *PageTimer)
        i = i + 1
    }
    list.free(p.timers)
    rafs_drop_(p, p.rafs)
    list.free(p.rafs)
}

// Extra arguments i.. of a call as a held JS array, or 0 when there are none.
rest_args_(p: *Page, argv: int, argc: int, i: int) -> int {
    ctx = p.ctx
    if argc <= i { return 0 }
    a = quickjs.new_array(ctx)
    k = i
    while k < argc {
        h = quickjs.arg(ctx, argv, k)
        _e = js_set_index_(p, a, k - i, h)
        quickjs.release(ctx, h)
        k = k + 1
    }
    return a
}

// timer(ms, fn): call fn every ms milliseconds (at least 10) until
// timer_cancel(id) or the page goes. Returns the timer's id.
sae_ui_timer(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ms = arg_int_(ctx, argv, argc, 0, 1000)
    ref = held_fn_(ctx, argv, argc, 1)
    if ref == 0 { return sae_throw_type_error(ctx, "timer(ms, fn): fn must be a function") }
    return quickjs.new_int(ctx, timer_add_(p, ref, 0, ms, 1, 10))
}

// after(ms, fn): call fn once, ms milliseconds from now. Returns an id that
// timer_cancel (and clearTimeout) take.
sae_ui_after(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ms = delay_arg_(ctx, argv, argc, 0)
    ref = held_fn_(ctx, argv, argc, 1)
    if ref == 0 { return sae_throw_type_error(ctx, "after(ms, fn): fn must be a function") }
    return quickjs.new_int(ctx, timer_add_(p, ref, 0, ms, 0, 0))
}

// sleep(ms): a promise that resolves (to undefined) ms milliseconds from now.
// If the page goes first it never settles, and goes with the page's runtime.
sae_ui_sleep(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ms = delay_arg_(ctx, argv, argc, 0)
    pr = quickjs.new_promise(ctx)
    resolve, _e1 = js_get_(p, pr, "resolve")
    promise, _e2 = js_get_(p, pr, "promise")
    quickjs.release(ctx, pr)
    _id = timer_add_(p, resolve, 0, ms, 0, 0)
    return promise
}

// timer_cancel(id) / clearTimeout(id) / clearInterval(id): stop one of this
// page's timers. Another id, or none, is ignored.
sae_ui_timer_cancel(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 { return 0 }
    timer_cancel_id_(p, delay_arg_(ctx, argv, argc, 0))
    return 0
}

// setTimeout(fn, ms, ...args): call fn(...args) once, ms from now.
sae_set_timeout(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "setTimeout(fn, ms, ...args): fn must be a function (sae does not eval a string)") }
    ms = delay_arg_(ctx, argv, argc, 1)
    return quickjs.new_int(ctx, timer_add_(p, ref, rest_args_(p, argv, argc, 2), ms, 0, 0))
}

// setInterval(fn, ms, ...args): call fn(...args) every ms until cleared.
sae_set_interval(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "setInterval(fn, ms, ...args): fn must be a function (sae does not eval a string)") }
    ms = delay_arg_(ctx, argv, argc, 1)
    return quickjs.new_int(ctx, timer_add_(p, ref, rest_args_(p, argv, argc, 2), ms, 1, 0))
}

// Release a list of PageRaf records' handles and free them.
rafs_drop_(p: *Page, l: ptr) {
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        r = v as *PageRaf
        if r.fn_h != 0 { quickjs.release(p.ctx, r.fn_h) }
        heap.free(r)
        i = i + 1
    }
}

// One display frame for the page: run the callbacks requested before it
// began, each with the same timestamp, then stop the subscription if no
// callback asked for another frame.
rafs_frame_(p: *Page) {
    ctx = p.ctx
    batch = p.rafs
    p.rafs = list.new()
    p.raf_batch = batch
    ts = raf_now_(p.browser as *Browser)
    n = list.size(batch)
    i = 0
    while i < n {
        v, _ = list.get(batch, i)
        r = v as *PageRaf
        if r.id != 0 {
            r.id = 0
            a = quickjs.new_array(ctx)
            fh = quickjs.new_float(ctx, ts)
            _e = js_set_index_(p, a, 0, fh)
            quickjs.release(ctx, fh)
            if calln_(p, r.fn_h, a) < 0 { report_exception_(p, "an animation frame callback") }
            quickjs.release(ctx, a)
            settle_(p)
        }
        i = i + 1
    }
    p.raf_batch = null
    rafs_drop_(p, batch)
    list.free(batch)
    if list.size(p.rafs) == 0 && p.frame_sub != 0 {
        ui.frame_cancel(p.frame_sub)
        p.frame_sub = 0
    }
}

// requestAnimationFrame(fn) / ui.frame(fn): call fn(timestamp) once, on the
// next display frame. Returns an id for cancelAnimationFrame.
sae_request_frame(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "requestAnimationFrame(fn): fn must be a function") }
    r = heap.new(PageRaf)
    p.raf_ids = p.raf_ids + 1
    r.id = p.raf_ids
    r.fn_h = ref
    list.add(p.rafs, r as ptr)
    if p.frame_sub == 0 {
        fb = p.browser as *Browser
        p.frame_sub = ui.on_frame(|t: float| {
            lp = page_of_(fb, ctx)   // the page may have gone since
            if lp != null { rafs_frame_(lp) }
        })
    }
    return quickjs.new_int(ctx, r.id)
}

// cancelAnimationFrame(id) / ui.frame_cancel(id): the callback will not run,
// even if its frame has begun. Another id is ignored.
sae_cancel_frame(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    id = arg_int_(ctx, argv, argc, 0, 0)
    if id <= 0 { return 0 }
    raf_cancel_in_(p.rafs, id)
    if p.raf_batch != null { raf_cancel_in_(p.raf_batch, id) }
    return 0
}

raf_cancel_in_(l: ptr, id: int) {
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        r = v as *PageRaf
        if r.id == id { r.id = 0 }
        i = i + 1
    }
}

// --- the page API: http, on Aether's actor core ---
//
//   const req = http.get(url, (res) => {
//     if (!res.ok) { show(res.error || `HTTP ${res.status}`); return; }
//     render(res.json());          // or res.text
//   });
//   http.post(url, body, contentType, (res) => ...)
//   req.cancel()                   // its callback will not run
//
// res is { ok, status, text, error, json() }: ok is a 2xx answer; status is
// 0 when nothing came back; error is "" unless the request failed or was
// refused.
//
// The request runs on a thread of its own (http_run_), off the scheduler's
// threads, so neither the UI thread nor any actor waits on the network.
// Each finished job goes to the HttpInbox actor; while any are in flight a
// UI timer asks the inbox for them and runs the page's callback on the UI
// thread, where the JS engine lives. A reply for a page that has since gone,
// or for a cancelled request, is dropped.
//
// Where a page may reach: in the browser, its own origin; in an app, the
// URL prefixes app.json lists under capabilities.http (Tauri's allowlist,
// deny by default), checked in services/net before any socket and on every
// redirect hop. The rest is refused: res.ok false, res.error saying why,
// delivered the same way.

sae_http_get(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    return http_start_(p, "GET", own_(arg_str_(ctx, argv, argc, 0)), "", "", null, held_fn_(ctx, argv, argc, 1))
}

// http.cancel(id): what req.cancel() calls. The request may still run to
// completion on its actor; its callback will not.
sae_http_cancel(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    http_cancel_(p, arg_int_(ctx, argv, argc, 0, 0))
    return 0
}

sae_http_post(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    return http_start_(p, "POST", own_(arg_str_(ctx, argv, argc, 0)),
                       own_(arg_str_(ctx, argv, argc, 1)), own_(arg_str_(ctx, argv, argc, 2)),
                       null, held_fn_(ctx, argv, argc, 3))
}

// http.request({ method, url, headers, body, contentType }, (res) => ...):
// any method, request headers; res.headers holds the response's, lowercased.
sae_http_request(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 2 { return sae_throw_type_error(ctx, "http.request(options, fn)") }
    opt = quickjs.arg(ctx, argv, 0)
    method = js_prop_str_(p, opt, "method", "GET")
    url = js_prop_str_(p, opt, "url", "")
    body = js_prop_str_(p, opt, "body", "")
    ctype = js_prop_str_(p, opt, "contentType", "")
    hdrs = null
    hv, _e = js_get_(p, opt, "headers")
    if quickjs.type_of(ctx, hv) == "object" {
        keys = js_keys_(p, hv)
        hdrs = strarr.new()
        n = js_length_(p, keys)
        i = 0
        while i < n {
            name = js_key_(p, keys, i)
            val = js_prop_str_(p, hv, name, "")
            strarr.push_copy(hdrs, "${name}: ${val}")
            i = i + 1
        }
        quickjs.release(ctx, keys)
    }
    quickjs.release(ctx, hv)
    quickjs.release(ctx, opt)
    if url == "" { return sae_throw_type_error(ctx, "http.request: options.url is missing") }
    return http_start_(p, string.to_upper(method), url, body, ctype, hdrs, held_fn_(ctx, argv, argc, 1))
}

// --- the page API: fs and shell (app mode, within the app's grants) ---
//
// Gates onto services/files and services/shell (docs/architecture.md): each
// takes the page's arguments, calls the service, and throws its refusal or
// error. The services resolve and check every path and URL against
// capabilities in app.json; a page in the browser gets a refusal from both.
// See docs/app-capabilities.md.

sae_fs_read_text(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    path = own_(arg_str_(ctx, argv, argc, 0))
    leave_grants_(p)
    text, err = files.read_text(browser_of_(p).files, path)
    enter_grants_(p)
    if err != "" { return sae_throw_type_error(ctx, err) }
    return quickjs.new_string(ctx, text)
}

// --- the page API: bus, the control bus (services/bus has the rules) ---
//
// One page serves at a time: the last to call bus.serve. The bus listens
// only when the person started the app with --control-bus; otherwise
// bus.serve says so once and nothing listens. While it listens the window's
// title says so. A UI timer polls the listener (services/bus), hands each
// request to the page's dispatcher, one at a time, and the page's answer
// comes back through bus.answer. A request the page has not answered in
// BUS_DEADLINE_MS is answered for it, as failed.
//
// The control channel (--control-stdio, services/channel) is the other way
// in, to the same bus.serve: the program that started sae sends the same
// commands over sae's stdin and stdout, and nothing listens. One launch has
// one or the other: with the channel, bus.serve tells the parent a page
// serves ({"event": "serving"}) instead of listening, and the same tick
// (bus_tick_) reads the channel instead of the listener. ctl_next_ and
// ctl_answer_ are the one place the two differ.

const BUS_DEADLINE_MS = 10000

sae_bus_serve(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    b = p.browser as *Browser
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "bus.serve(fn): fn must be a function") }
    if p.bus_ref != 0 { quickjs.release(ctx, p.bus_ref) }
    p.bus_ref = hold_arg_(ctx, argv, 0)
    if p.bus_stopped_ref != 0 {
        quickjs.release(ctx, p.bus_stopped_ref)
        p.bus_stopped_ref = 0
    }
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) == 1 { p.bus_stopped_ref = hold_arg_(ctx, argv, 1) }
    b.bus_page = p as ptr
    ch = b.control
    if ch != null {
        channel.event(ch, "serving")
        return 0
    }
    if b.bus_flag == 0 {
        if b.bus_told_off == 0 {
            b.bus_told_off = 1
            say_("sae: control bus: off; start the app with --control-bus to switch it on")
        }
        return 0
    }
    if bus.listening(b.bus) == 0 { later_add_(b, LATER_BUS_LISTEN, "", "") }   // the courier file and the socket, after the entry
    return 0
}

sae_bus_stop(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    b = p.browser as *Browser
    if p.bus_ref != 0 {
        quickjs.release(ctx, p.bus_ref)
        p.bus_ref = 0
    }
    if p.bus_stopped_ref != 0 {
        quickjs.release(ctx, p.bus_stopped_ref)
        p.bus_stopped_ref = 0
    }
    if b.bus_page == p as ptr { b.bus_page = null }
    later_add_(b, LATER_BUS_SILENCE, "", "")   // the courier file and the socket, after the entry
    return 0
}

sae_bus_answer(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    id = arg_int_(ctx, argv, argc, 0, 0)
    b = browser_of_(p)
    if id != b.bus_inflight { return 0 }   // answered already (its deadline passed)
    ctl_answer_(b, id, arg_int_(ctx, argv, argc, 1, 0), own_(arg_str_(ctx, argv, argc, 2)), own_(arg_str_(ctx, argv, argc, 3)))
    b.bus_inflight = 0
    return 0
}

// Listen (the courier file written), the title marked, the poll timer on.
bus_listen_(b: *Browser) -> string {
    if bus.listening(b.bus) == 1 { return "" }
    why = bus.start(b.bus, b.app_data)
    if why != "" { return why }
    ui.set_window_title(1, "${b.app_name} - control bus on")
    say_("sae: control bus: listening (other programs on this machine can control ${b.app_name})")
    if b.bus_timer == 0 { b.bus_timer = ui.timer(20, || { bus_tick_(b) }) }
    return ""
}

// Stop listening: the courier file gone, the title as it was.
bus_silence_(b: *Browser) {
    if bus.listening(b.bus) == 0 { return }
    bus.stop(b.bus)
    if b.bus_timer != 0 {
        ui.timer_cancel(b.bus_timer)
        b.bus_timer = 0
    }
    b.bus_inflight = 0
    ui.set_window_title(1, b.app_name)
    say_("sae: control bus: stopped")
}

// Each tick: what has arrived read, refusals logged, and the next request
// handed to the page (one at a time).
bus_tick_(b: *Browser) {
    // Page JS is running (a nested event loop under a host call): the page's
    // grants are in force, and this is the kernel's own work. Wait for the
    // next tick.
    if b.entry_depth > 0 { return }
    bus_ui_poll_(b)
    ch = b.control
    if ch != null {
        channel.poll(ch)
        cl = channel.take_log(ch)
        if cl != "" { say_(cl) }
        if channel.alive(ch) == 0 {
            control_gone_(b)
            return
        }
    } else {
        bus.poll(b.bus)
        l = bus.take_log(b.bus)
        if l != "" { say_(l) }
    }
    if b.bus_inflight != 0 {
        if b.bus_interrupted == 1 {
            bus_stop_request_(b, "interrupted", "stopped: it ran past the app's limit of ${PAGE_TIME_MS / 1000} s for one piece of work")
        } else if now_ms_(b.clock) - b.bus_since > BUS_DEADLINE_MS {
            bus_stop_request_(b, "deadline", "the app did not answer in ${BUS_DEADLINE_MS / 1000} s")
        }
        return
    }
    id, command = ctl_next_(b)
    if id == 0 { return }
    if string.starts_with(command, "@ui ") == 1 {
        bus_ui_(b, id, command)
        return
    }
    if bus.declared(b.bus) == 0 {
        ctl_answer_(b, id, 0, "", "this app's app.json does not declare a control bus (capabilities.controlBus)")
        return
    }
    if b.bus_page == null {
        ctl_answer_(b, id, 0, "", "no page of this app is serving the control bus")
        return
    }
    p = b.bus_page as *Page
    if p.bus_ref == 0 {
        ctl_answer_(b, id, 0, "", "no page of this app is serving the control bus")
        return
    }
    b.bus_inflight = id
    b.bus_since = now_ms_(b.clock)
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    iv = quickjs.new_int(ctx, id)
    _a = js_set_index_(p, args, 0, iv)
    quickjs.release(ctx, iv)
    cv = quickjs.new_string(ctx, command)
    _b = js_set_index_(p, args, 1, cv)
    quickjs.release(ctx, cv)
    b.bus_interrupted = 0
    r = calln_(p, p.bus_ref, args)
    quickjs.release(ctx, args)
    if r < 0 { report_exception_(p, "the control bus's handler") }
    settle_(p)
    if b.bus_interrupted == 1 && b.bus_inflight == id {
        bus_stop_request_(b, "interrupted", "stopped: it ran past the app's limit of ${PAGE_TIME_MS / 1000} s for one piece of work")
    }
}

// The next request for the page, from the channel or the bus.
ctl_next_(b: *Browser) -> (int, string) {
    ch = b.control
    if ch != null {
        id, command = channel.next(ch)
        return id, command
    }
    id2, command2 = bus.next(b.bus)
    return id2, command2
}

// A request answered, on the channel or the bus it came by.
ctl_answer_(b: *Browser, id: int, success: int, result_json: string, error: string) {
    ch = b.control
    if ch != null {
        channel.answer(ch, id, success, result_json, error)
        return
    }
    bus.answer(b.bus, id, success, result_json, error)
}

// At launch, with --control-stdio: the channel held to the bus's request
// size, the window marked, and the tick that reads it started. It needs no
// page yet: requests that come before one serves are answered so.
control_start_(b: *Browser) {
    channel.configure(b.control, bus.request_limit(b.bus))
    if bus.declared(b.bus) == 0 {
        say_("sae: control channel: this app's app.json does not declare a control bus (capabilities.controlBus): every request is refused")
    } else {
        say_("sae: control channel: on (the program that started sae can control ${b.app_name}; nothing listens)")
    }
    b.control_timer = ui.timer(20, || { bus_tick_(b) })
}

// The program that started sae closed the channel, or broke it. Without a
// window (AETHER_UI_HEADLESS) no one else can use the app, so sae stops, as
// a child whose parent has gone should; with one, the person may be using
// it, so it stays and only the title's mark goes.
control_gone_(b: *Browser) {
    say_("sae: ${channel.why(b.control)}")
    if b.control_timer != 0 {
        ui.timer_cancel(b.control_timer)
        b.control_timer = 0
    }
    b.bus_inflight = 0
    if env_("AETHER_UI_HEADLESS") != "" {
        say_("sae: control channel: no window and no channel: stopping")
        if b.backend != null { backend.stop(b.backend) }
        exit(0)
    }
    ui.set_window_title(1, b.app_name)
}

// The control bus's ui channel (app.json capabilities.controlBus.ui, and a
// sae-driver build run with AETHER_UI_TEST_PORT): "@ui GET /widgets",
// "@ui POST /window/key?combo=Down", "@ui GET /screenshot?b64=1" (answered as
// the PNG in base64) go to the app's own UI driver, on this machine, as the
// driver answers them; the paths are a short list (what a person at the
// window can do: look, press keys, click a widget), and the answer is the
// driver's. The driver answers on the UI thread, which this is, so the
// connection is read a tick at a time (bus_ui_poll_), never waited on, and
// answered on the bus when the driver has closed it.
bus_ui_(b: *Browser, id: int, command: string) {
    if b.bus_ui_granted == 0 {
        ctl_answer_(b, id, 0, "", "this app's app.json does not grant capabilities.controlBus.ui")
        return
    }
    port = env_("AETHER_UI_TEST_PORT")
    if port == "" {
        ctl_answer_(b, id, 0, "", "this sae has no UI driver (a sae-driver build, started with AETHER_UI_TEST_PORT)")
        return
    }
    rest = string.substring(command, 4, string.length(command))
    sp = string.index_of(rest, " ")
    if sp <= 0 {
        ctl_answer_(b, id, 0, "", "@ui <GET|POST> <path>")
        return
    }
    method = string.substring(rest, 0, sp)
    path = string.trim(string.substring(rest, sp + 1, string.length(rest)))
    if bus_ui_path_ok_(method, path) == 0 {
        ctl_answer_(b, id, 0, "", "@ui: ${method} ${path} is not a path the control bus passes to the UI driver")
        return
    }
    p_port, perr = string.to_int(port)
    sock, cerr = tcp.connect("127.0.0.1", p_port)
    if cerr != "" {
        ctl_answer_(b, id, 0, "", "the UI driver: no connection: ${cerr}")
        return
    }
    req = "${method} ${path} HTTP/1.1\r\nHost: 127.0.0.1:${port}\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
    _w = tcp.write(sock, req)
    pend = heap.new(BusUi)
    pend.id = id
    pend.sock = sock
    pend.got = ""
    pend.since = now_ms_(b.clock)
    list.add(b.bus_ui_pending, pend as ptr)
}

// A ui request waiting on the driver: its connection, and what has come.
struct BusUi {
    id: int
    sock: ptr
    got: string
    since: long
}


// Each tick: what each pending request's connection has for it read (the
// driver answers on the UI thread, which this is, so nothing waits for it
// here); one whose driver closed the connection is answered on the bus.
bus_ui_poll_(b: *Browser) {
    i = 0
    while i < list.size(b.bus_ui_pending) {
        pv, _e = list.get(b.bus_ui_pending, i)
        pend = pv as *BusUi
        done = 0
        ready, _pe = tcp.poll(pend.sock, 0)
        if ready {
            data, rerr = tcp.read(pend.sock, 65536)
            if rerr != "" || data == "" { done = 1 } else { pend.got = own_("${pend.got}${data}") }
        }
        if done == 0 && now_ms_(b.clock) - pend.since > BUS_DEADLINE_MS {
            _c = tcp.tcp_close(pend.sock)
            ctl_answer_(b, pend.id, 0, "", "the UI driver did not answer in ${BUS_DEADLINE_MS / 1000} s")
            list.list_remove(b.bus_ui_pending, i)
            heap.free(pend)
            continue
        }
        if done == 1 {
            _c = tcp.tcp_close(pend.sock)
            end = string.index_of(pend.got, "\r\n\r\n")
            if end < 0 {
                ctl_answer_(b, pend.id, 0, "", "the UI driver answered nothing")
            } else {
                line = string.substring(pend.got, 0, string.index_of(pend.got, "\r\n"))
                status = 0
                sp1 = string.index_of(line, " ")
                if sp1 > 0 {
                    st, _se = string.to_int(string.substring(line, sp1 + 1, sp1 + 4))
                    status = st
                }
                bus_ui_answer_(b, pend.id, status, string.substring(pend.got, end + 4, string.length(pend.got)), "")
            }
            list.list_remove(b.bus_ui_pending, i)
            heap.free(pend)
            continue
        }
        i = i + 1
    }
}

// What the ui channel passes: looking (the widgets, a widget, the focus, a
// pick, the screenshot as text) and what a person at the window does (a
// widget clicked or typed into, a key, the focus moved on as Tab moves it, a
// resize). Nothing that stops the app
// or reaches outside it.
bus_ui_path_ok_(method: string, path: string) -> int {
    if string.contains(path, "..") == 1 { return 0 }
    q = string.index_of(path, "?")
    base = path
    if q >= 0 { base = string.substring(path, 0, q) }
    if method == "GET" {
        if base == "/widgets" || base == "/focus" || base == "/window/pick" { return 1 }
        if path == "/screenshot?b64=1" { return 1 }
        if string.starts_with(base, "/widget/") == 1 && string.contains(string.substring(base, 8, string.length(base)), "/") == 0 { return 1 }
        return 0
    }
    if method == "POST" {
        if base == "/window/key" || base == "/window/resize" || base == "/focus/move" { return 1 }
        if string.starts_with(base, "/widget/") == 1 {
            tail = string.substring(base, 8, string.length(base))
            sl = string.index_of(tail, "/")
            if sl > 0 {
                verb = string.substring(tail, sl + 1, string.length(tail))
                if verb == "click" || verb == "set_text" || verb == "focus" || verb == "hover" || verb == "toggle" || verb == "set_value" { return 1 }
            }
        }
        return 0
    }
    return 0
}

// The driver's answer on the bus: a JSON body as it is, other text as a JSON string.
bus_ui_answer_(b: *Browser, id: int, status: int, body: string, err: string) {
    if err != "" {
        ctl_answer_(b, id, 0, "", "the UI driver: ${err}")
        return
    }
    if status < 200 || status >= 300 {
        ctl_answer_(b, id, 0, "", "the UI driver answered ${status}: ${body}")
        return
    }
    if string.starts_with(body, "{") == 1 || string.starts_with(body, "[") == 1 {
        ctl_answer_(b, id, 1, body, "")
        return
    }
    quoted = string.string_replace_all(string.string_replace_all(body, "\\", "\\\\"), "\"", "\\\"")
    ctl_answer_(b, id, 1, "\"${quoted}\"", "")
}

// The request in flight answered as failed, its handler no longer awaited,
// and the page told why in an entry of its own (bus.serve's second
// function): "interrupted" when the page's time limit stopped it, its
// promise never to settle; "deadline" when it was answered for it while
// still running. The page puts back what the request had done.
bus_stop_request_(b: *Browser, reason: string, why: string) {
    ctl_answer_(b, b.bus_inflight, 0, "", why)
    b.bus_inflight = 0
    b.bus_interrupted = 0
    if b.bus_page == null { return }
    p = b.bus_page as *Page
    if p.bus_stopped_ref == 0 { return }
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    rv = quickjs.new_string(ctx, reason)
    _a = js_set_index_(p, args, 0, rv)
    quickjs.release(ctx, rv)
    r = calln_(p, p.bus_stopped_ref, args)
    quickjs.release(ctx, args)
    if r < 0 { report_exception_(p, "the control bus's stopped handler") }
    settle_(p)
}

// --- the page API: backend, the app's own process (docs/app-backend.md) ---
//
// app.json capabilities.backend { "program": "<file in the app>", "args":
// [...] } names a program sae starts when the app does, or { "wslc": {
// "image": "<image>", "command": [...] } } a Linux one in a WSL container on
// Windows (services/backend: os.run_stdio, its stdin and stdout the
// channel, nothing on the file system and nothing listening). A page that seeks it gets `backend`: invoke(name, arg)
// is a promise for the backend's answer, on(name, fn) hears what it sends
// unasked, on_gone(fn) hears that it has gone. A UI timer reads its frames
// and hands each to the page that is showing; an answer for a page that has
// gone is dropped. A backend that does not start, or goes, is said once;
// every call waiting is failed with why, and later calls fail at once.

// A call's default deadline; app.json capabilities.backend.deadlineMs sets
// the app's own, from BACKEND_DEADLINE_MIN to BACKEND_DEADLINE_MAX.
const BACKEND_DEADLINE_MS = 10000
const BACKEND_DEADLINE_MIN = 100
const BACKEND_DEADLINE_MAX = 600000
const BACKEND_FRAMES_PER_TICK = 32

// The program app.json names, inside the app: "" and why not.
backend_program_(b: *Browser, prog: string) -> (string, string) {
    if prog == "" { return "", "app.json capabilities.backend.program: the backend program, a file inside the app" }
    if string.string_starts_with(prog, "/") == 1 || string.contains(prog, "\\") == 1 || string.contains(prog, ":") == 1 {
        return "", "app.json capabilities.backend.program: a path inside the app (${prog} is not)"
    }
    path, climbed = norm_path_(prog)
    if climbed == 1 || string.contains("/${path}/", "/../") == 1 {
        return "", "app.json capabilities.backend.program: a path inside the app (${prog} climbs out)"
    }
    full = "${b.app_dir}/${path}"
    if os.platform() == "windows" && string.string_ends_with(full, ".exe") == 0 { full = string.concat(full, ".exe") }
    if fs.exists(full) == 0 { return "", "backend: no program at ${full} (build it first: docs/app-backend.md)" }
    return full, ""
}

// Start the backend app.json declares, before the first page runs. A wrong
// declaration refuses the app (returned); a program that does not start, a
// wslc backend anywhere but Windows, or a contained one where Aether cannot
// contain a child, is said, and the app runs without it (its pages' calls
// fail with why).
backend_start_(b: *Browser, manifest: ptr) -> string {
    if manifest == null { return "" }
    caps = json.json_object_get_raw(manifest, "capabilities")
    if caps == null { return "" }
    decl = json.json_object_get_raw(caps, "backend")
    if decl == null { return "" }
    if json.json_type(decl) != 5 { return "app.json capabilities.backend must be an object: { \"program\": \"<file>\", \"args\": [...] } or { \"wslc\": { \"image\": \"<image>\", \"command\": [...] } }" }
    b.backend_declared = 1
    dmv = json.json_object_get_raw(decl, "deadlineMs")
    if dmv != null {
        dm = json.json_get_int(dmv)
        if dm < BACKEND_DEADLINE_MIN || dm > BACKEND_DEADLINE_MAX {
            return "app.json capabilities.backend.deadlineMs: from ${BACKEND_DEADLINE_MIN} to ${BACKEND_DEADLINE_MAX} (ms a call may wait for its answer)"
        }
        b.backend_deadline_ms = dm
    }
    wv = json.json_object_get_raw(decl, "wslc")
    pv = json.json_object_get_raw(decl, "program")
    if wv != null && pv != null { return "app.json capabilities.backend: a \"program\" or a \"wslc\" container, not both" }
    socket = 0
    cv = json.json_object_get_raw(decl, "channel")
    if cv != null {
        cs, _ce = json.get_string(cv)
        if cs == "socket" {
            socket = 1
        } else if cs != "stdio" {
            return "app.json capabilities.backend.channel: \"stdio\" (its stdin and stdout, the default) or \"socket\" (docs/design/ipc-backends.md)"
        }
    }
    sv = json.json_object_get_raw(decl, "sandbox")
    if socket == 1 && sv == null { return "app.json capabilities.backend.sandbox: a socket backend says what it may reach ({ \"read\": [...], \"write\": [...], \"env\": [...] }, {} for nothing) or \"none\" for no sandbox" }
    if socket == 0 && sv != null { return "app.json capabilities.backend.sandbox: only a socket backend is contained (\"channel\": \"socket\"); one on stdin and stdout is not" }
    d = heap.new(BackendDecl)
    d.wslc = 0
    d.socket = socket
    d.args = list.new()
    d.grants = null
    b.backend_decl = d as ptr
    if wv != null {
        if socket == 1 { return "app.json capabilities.backend: a wslc backend's channel is its stdin and stdout (wslc passes no socket)" }
        image, command, werr = backend_wslc_(wv, decl)
        if werr != "" {
            list.free(command)
            return werr
        }
        d.wslc = 1
        d.program = image
        list.free(d.args)
        d.args = command
    } else {
        prog = ""
        if pv != null {
            ps, _pe = json.get_string(pv)
            prog = own_(ps)
        }
        _full, perr = backend_program_(b, prog)
        if perr != "" && string.string_starts_with(perr, "app.json") == 1 { return perr }
        d.program = prog
        grants_from_(decl, "args", |a: string| { list.add(d.args, own_(a)) })
        if socket == 1 {
            gerr = backend_grants_(b, d, sv)
            if gerr != "" { return gerr }
        }
    }
    b.backend_why = "backend: not started"
    _w = backend_launch_(b)
    return ""
}

// app.json capabilities.backend.sandbox: "none", or an object of grants
// (read and write: paths, as app.json fs grants write them, a relative one
// inside the app; env: variable names), kept in d.grants as
// services/backend.start_socket takes them. "" or why the app is refused.
backend_grants_(b: *Browser, d: *BackendDecl, sv: ptr) -> string {
    if json.json_type(sv) != 5 {
        ns, _ne = json.get_string(sv)
        if ns == "none" { return "" }
        return "app.json capabilities.backend.sandbox: an object of grants, or \"none\""
    }
    d.grants = list.new()
    n = json.object_size(sv)
    i = 0
    while i < n {
        k, _kv, _ke = json.object_entry(sv, i)
        if k != "read" && k != "write" && k != "env" {
            return "app.json capabilities.backend.sandbox.${k}: not a grant sae gives a backend (read, write, env)"
        }
        i = i + 1
    }
    raw = list.new()
    grants_from_(sv, "env", |e: string| { list.add(raw, "env ${e}") })
    grants_from_(sv, "read", |r: string| { list.add(raw, "read ${r}") })
    grants_from_(sv, "write", |r: string| { list.add(raw, "write ${r}") })
    // The paths, each made absolute where it leads.
    j = 0
    while j < list.size(raw) {
        gv, _ge = list.get_string(raw, j)
        g = own_(gv)
        if string.string_starts_with(g, "env ") == 1 {
            list.add(d.grants, g)
        } else {
            sp = string.string_index_of(g, " ")
            kind = string.string_substring(g, 0, sp)
            pth, perr = backend_grant_path_(b, string.string_substring(g, sp + 1, string.length(g)))
            if perr != "" {
                list.free(raw)
                return perr
            }
            list.add(d.grants, "${kind} ${pth}")
        }
        j = j + 1
    }
    list.free(raw)
    return ""
}

// A backend's read or write grant as an absolute path where it leads ("/" at
// the end kept: a folder and what is under it). $APPDATA, $HOME, $TEMP and the
// others as app.json fs grants have them; a relative path is inside the app.
backend_grant_path_(b: *Browser, raw: string) -> (string, string) {
    folder = string.string_ends_with(raw, "/")
    p = raw
    if string.string_starts_with(raw, "$") == 0 && string.string_starts_with(raw, "/") == 0 {
        rel, climbed = norm_path_(raw)
        if climbed == 1 || string.contains("/${rel}/", "/../") == 1 {
            return "", "app.json capabilities.backend.sandbox: ${raw} climbs out of the app"
        }
        p = "${b.app_dir}/${rel}"
    }
    r = files.resolve(b.files, p)
    if r == "" { return "", "app.json capabilities.backend.sandbox: ${raw} does not lead anywhere that can be granted" }
    if folder == 1 && string.string_ends_with(r, "/") == 0 { r = string.concat(r, "/") }
    return r, ""
}

// Start the backend b.backend_decl declares: "" when it runs, or why not
// (said once; its pages' calls fail with it).
backend_launch_(b: *Browser) -> string {
    if b.backend_decl == null { return b.backend_why }
    d = b.backend_decl as *BackendDecl
    h = null
    serr = ""
    what = d.program
    how = ""
    if d.wslc == 1 {
        h, serr = backend.start_wslc(d.program, d.args)
        what = "wslc ${d.program}"
    } else {
        full, perr = backend_program_(b, d.program)
        if perr != "" {
            serr = perr
        } else if d.socket == 1 {
            grants = d.grants
            how = " on a socket, contained"
            if grants == null {
                how = " on a socket, not contained (app.json sandbox \"none\")"
            } else if b.uncontained == 1 {
                grants = null
                how = " on a socket, not contained (--uncontained-backend)"
            }
            h, serr = backend.start_socket(full, d.args, grants)
        } else {
            h, serr = backend.start(full, d.args)
        }
    }
    if serr != "" {
        b.backend_why = own_(serr)
        say_("sae: ${serr}")
        return b.backend_why
    }
    b.backend = h
    b.backend_why = ""
    say_("sae: backend: ${what} started${how}")
    b.backend_timer = ui.timer(10, || { backend_tick_(b) })
    return ""
}

// app.json capabilities.backend.wslc { "image": "<image>", "command":
// ["<program in the image>", "<arg>", ...] }: (image, command as a std.list
// the caller frees, "") or (_, list, why the app is refused). The image is a
// name wslc knows (no spaces, not an option); the command may be empty (the
// image's own) and its first word is not an option either, so neither can
// reach wslc as one of its own flags.
backend_wslc_(wv: ptr, decl: ptr) -> (string, ptr, string) {
    command = list.new()
    if json.json_type(wv) != 5 { return "", command, "app.json capabilities.backend.wslc must be an object: { \"image\": \"<image>\", \"command\": [...] }" }
    if json.json_object_get_raw(decl, "args") != null { return "", command, "app.json capabilities.backend: a wslc backend's arguments go in wslc.command, not args" }
    iv = json.json_object_get_raw(wv, "image")
    image = ""
    if iv != null {
        is, _ie = json.get_string(iv)
        image = own_(is)
    }
    if image == "" || string.string_starts_with(image, "-") == 1 || string.contains(image, " ") == 1 {
        return "", command, "app.json capabilities.backend.wslc.image: the image to run, as wslc names it (\"${image}\" is not one)"
    }
    grants_from_(wv, "command", |a: string| { list.add(command, own_(a)) })
    if list.size(command) > 0 {
        fv, _ = list.get_string(command, 0)
        if string.string_starts_with(fv, "-") == 1 {
            return "", command, "app.json capabilities.backend.wslc.command: the program in the image first, not an option"
        }
    }
    return image, command, ""
}

sae_backend_listen(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "backend: its dispatcher must be a function") }
    if p.backend_ref != 0 { quickjs.release(ctx, p.backend_ref) }
    p.backend_ref = hold_arg_(ctx, argv, 0)
    return 0
}

// raw.call(name, arg, doc): the call's id, or 0 when there is no backend to
// ask (raw.why() says why). `doc`, when not 0, is a documents handle: the
// picked file is opened (services/documents) and handed over with the call
// as an open descriptor, on a socket backend only; a refusal throws.
sae_backend_call(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    b = p.browser as *Browser
    if b.backend == null || backend.alive(b.backend) == 0 { return quickjs.new_int(ctx, 0) }
    dh = arg_int_(ctx, argv, argc, 2, 0)
    fd = 0 - 1
    if dh != 0 {
        if backend.socket(b.backend) == 0 {
            return sae_throw_type_error(ctx, "backend.invoke: a document crosses only to a socket backend (app.json capabilities.backend.channel \"socket\"); this one's channel is its stdin and stdout, which carry bytes only")
        }
        f, ferr = documents.open_fd(b.documents, dh)
        if ferr != "" { return sae_throw_type_error(ctx, "backend.invoke: ${ferr}") }
        fd = f
    }
    b.backend_ids = b.backend_ids + 1
    id = b.backend_ids
    err = backend.call(b.backend, id, own_(arg_str_(ctx, argv, argc, 0)), own_(arg_str_(ctx, argv, argc, 1)), fd)
    if err != "" {
        backend_gone_(b, err)
        return quickjs.new_int(ctx, 0)
    }
    c = heap.new(BackendCall)
    c.id = id
    c.seq = p.seq
    c.since = now_ms_(b.clock)
    list.add(b.backend_calls, c as ptr)
    return quickjs.new_int(ctx, id)
}

// raw.restart(): the kill switch. Its id; the backend is killed at once and
// started again after the page's entry (an effect outside the page:
// later_add_), and the dispatcher hears (3, id, ok, "", why) when it has.
sae_backend_restart(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    b = p.browser as *Browser
    if b.backend_decl == null { return sae_throw_type_error(ctx, "backend.restart: ${b.backend_why}") }
    b.backend_ids = b.backend_ids + 1
    r = heap.new(BackendRestart)
    r.id = b.backend_ids
    r.seq = p.seq
    list.add(b.backend_restarts, r as ptr)
    later_add_(b, LATER_BACKEND_RESTART, "", "")
    return quickjs.new_int(ctx, r.id)
}

// The restart backend.restart() asked for, done once no entry runs: the
// backend killed (no grace), its calls failed and on_gone told, then started
// again from its declaration, and every page that asked told how it went.
backend_restart_(b: *Browser) {
    if list.size(b.backend_restarts) == 0 { return }
    if b.backend != null {
        backend.kill(b.backend, "backend: restarted by the page")
        backend_gone_(b, "backend: restarted by the page")
    }
    why = backend_launch_(b)
    ok = 1
    if why != "" { ok = 0 }
    while list.size(b.backend_restarts) > 0 {
        rv, _ = list.get(b.backend_restarts, 0)
        r = rv as *BackendRestart
        list.list_remove(b.backend_restarts, 0)
        backend_deliver_(b, r.seq, 3, r.id, ok, "", why)
        heap.free(r)
    }
}

sae_backend_why(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    b = p.browser as *Browser
    return quickjs.new_string(ctx, b.backend_why)
}

// Hand the showing page (kind, id, ok, name, payload): 0 an answer, 1 an
// event, 2 the backend has gone, 3 a restart settled.
backend_deliver_(b: *Browser, seq: int, kind: int, id: int, ok: int, name: string, payload: string) {
    if b.page == null { return }
    p = b.page as *Page
    if seq != 0 && p.seq != seq { return }
    if p.backend_ref == 0 { return }
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    v0 = quickjs.new_int(ctx, kind)
    _a = js_set_index_(p, args, 0, v0)
    quickjs.release(ctx, v0)
    v1 = quickjs.new_int(ctx, id)
    _b = js_set_index_(p, args, 1, v1)
    quickjs.release(ctx, v1)
    v2 = quickjs.new_int(ctx, ok)
    _c = js_set_index_(p, args, 2, v2)
    quickjs.release(ctx, v2)
    v3 = quickjs.new_string(ctx, name)
    _d = js_set_index_(p, args, 3, v3)
    quickjs.release(ctx, v3)
    v4 = quickjs.new_string(ctx, payload)
    _e = js_set_index_(p, args, 4, v4)
    quickjs.release(ctx, v4)
    r = calln_(p, p.backend_ref, args)
    quickjs.release(ctx, args)
    if r < 0 { report_exception_(p, "the backend's handler") }
    settle_(p)
}

// The call `id` waits no longer: (its page's seq, 1), or (0, 0) if it was
// not waiting (answered already, or its deadline passed).
backend_take_call_(b: *Browser, id: int) -> (int, int) {
    n = list.size(b.backend_calls)
    i = 0
    while i < n {
        cv, _ = list.get(b.backend_calls, i)
        c = cv as *BackendCall
        if c.id == id {
            seq = c.seq
            list.list_remove(b.backend_calls, i)
            heap.free(c)
            return seq, 1
        }
        i = i + 1
    }
    return 0, 0
}

// The backend has gone (or never answers again): said once, every call
// waiting failed with why, the page told, the timer stopped.
backend_gone_(b: *Browser, why: string) {
    if b.backend == null { return }
    backend.stop(b.backend)
    b.backend = null
    b.backend_why = own_(why)
    say_("sae: ${why}")
    if b.backend_timer != 0 {
        ui.timer_cancel(b.backend_timer)
        b.backend_timer = 0
    }
    while list.size(b.backend_calls) > 0 {
        cv, _ = list.get(b.backend_calls, 0)
        c = cv as *BackendCall
        list.list_remove(b.backend_calls, 0)
        backend_deliver_(b, c.seq, 0, c.id, 0, "", why)
        heap.free(c)
    }
    backend_deliver_(b, 0, 2, 0, 0, "", why)
}

backend_tick_(b: *Browser) {
    // Page JS is running (a nested event loop under a host call): the page's
    // grants are in force, and this is the kernel's own work. Wait for the
    // next tick.
    if b.entry_depth > 0 { return }
    if b.backend == null { return }
    k = 0
    while k < BACKEND_FRAMES_PER_TICK {
        k = k + 1
        frame, why = backend.poll(b.backend)
        if why != "" {
            backend_gone_(b, why)
            return
        }
        if frame == "" { break }
        v, perr = json.parse(frame)
        if perr != "" || v == null {
            backend_gone_(b, "backend: it broke the protocol: the frame ${backend.excerpt(frame)} is not JSON")
            return
        }
        ev = json.json_object_get_raw(v, "event")
        if ev != null {
            en, _ee = json.get_string(ev)
            dv = json.json_object_get_raw(v, "data")
            data = ""
            if dv != null {
                ds, _de = json.get_string(dv)
                data = own_(ds)
            }
            name = own_(en)
            json.json_free(v)
            backend_deliver_(b, 0, 1, 0, 1, name, data)
        } else {
            idv = json.json_object_get_raw(v, "id")
            id = 0
            if idv != null { id = json.json_get_int(idv) }
            okv = json.json_object_get_raw(v, "ok")
            ok = 0
            if okv != null { ok = json.json_get_bool(okv) }
            pl = "result"
            if ok == 0 { pl = "error" }
            plv = json.json_object_get_raw(v, pl)
            payload = ""
            if plv != null {
                ps, _pe = json.get_string(plv)
                payload = own_(ps)
            }
            json.json_free(v)
            seq, waiting = backend_take_call_(b, id)
            if waiting == 1 { backend_deliver_(b, seq, 0, id, ok, "", payload) }
        }
        if b.backend == null { return }
    }
    // Calls past their deadline: failed, the backend kept (it may answer
    // the next).
    now = now_ms_(b.clock)
    i = 0
    while i < list.size(b.backend_calls) {
        cv, _ = list.get(b.backend_calls, i)
        c = cv as *BackendCall
        if now - c.since > b.backend_deadline_ms {
            list.list_remove(b.backend_calls, i)
            backend_deliver_(b, c.seq, 0, c.id, 0, "", "the backend did not answer in ${b.backend_deadline_ms} ms")
            heap.free(c)
        } else {
            i = i + 1
        }
    }
}

// --- the page API: clipboard (services/clipboard has the rules) ---

sae_clip_write(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    err = clipboard.write_text(browser_of_(p).clipboard, own_(arg_str_(ctx, argv, argc, 0)), browser_of_(p).gesture)
    if err != "" { return sae_throw_type_error(ctx, err) }
    return 0
}

sae_clip_read(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    sought_read = 0
    if string.contains(p.absent, ",clipboard-read,") == 0 { sought_read = 1 }
    text, err = clipboard.read_text(browser_of_(p).clipboard, browser_of_(p).gesture, sought_read)
    if err != "" { return sae_throw_type_error(ctx, err) }
    return quickjs.new_string(ctx, text)
}

// --- the page API: documents (app mode, capabilities.documents) ---
//
// The person picks; services/documents keeps the path and gives a handle,
// and fences each read and write to that one file. A cancelled picker is
// handle 0, which the page sees as null.

// A path the person picked, kept as a handle, and added to the live grant
// list of the page that asked (and so of this entry: the runtime lends the
// list, it does not copy it). A cancelled picker is 0.
docs_adopt_(p: *Page, path: string) -> int {
    h = documents.adopt(browser_of_(p).documents, path)
    if h != 0 { documents.grant_path(p.grants, path) }
    return quickjs.new_int(p.ctx, h)
}

sae_docs_pick_open(p: *Page, this_val: int, argv: int) -> int {
