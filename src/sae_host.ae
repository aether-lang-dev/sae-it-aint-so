        api("pointer_cursor", sae_ui_pointer_cursor, 2) {
            arg("h", T_WIDGET)
            arg("name", T_STR)
            gives(T_WIDGET)
            doc("The mouse pointer over a widget (\"col-resize\", \"row-resize\", \"move\", \"grab\", \"pointer\", \"text\", \"crosshair\", \"not-allowed\", \"wait\", \"default\").")
        }
        api("pointer_shape", sae_ui_pointer_shape, 1) {
            arg("name", T_STR)
            doc("In a widget's block: the same as pointer_cursor.")
        }
        api("on_focus_change", sae_ui_on_focus_change, 2) {
            arg("h", T_HANDLE)
            arg_ts("fn", "(inside: number) => void")
            gives(T_HANDLE)
            doc("fn(inside) when the focus comes into a widget or a vg scene, or leaves.")
        }
        api("on_layout", sae_ui_on_layout, 2) {
            arg("h", T_WIDGET)
            arg_ts("fn", "(w: number, h: number) => void")
            gives(T_WIDGET)
            doc("A stack was laid out at a new size (after its allocation settles).")
