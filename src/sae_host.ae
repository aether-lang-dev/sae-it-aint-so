// --- the page API: vg (AeVG vector graphics) ---
//
// The AeVG DSL, with trailing blocks as last arguments, as in `ui`:
//
//   vg.scene("0 0 100 100", 400, 300, () => {
//     const c = vg.circle(30, 40, 18, () => { vg.fill("#c44"); vg.on_click(...) })
//   })
//
// AeVG is a port of Tsyne's Cosyne CVG, so this is Cosyne for sae pages, in
// the block form rather than Cosyne's fluent `.fill()` chains. A shape
// returns a handle for vg.set_fill(h, ...) and friends.

vg_top_(p: *Page) -> ptr {
    return mem.get_ptr(p.vg_stack, (p.vg_depth - 1) * 8)
}

vg_push_(p: *Page, node: ptr) -> int {
    if p.vg_depth >= STACK_MAX { return 0 }
    mem.set_ptr(p.vg_stack, p.vg_depth * 8, node)
    p.vg_depth = p.vg_depth + 1
    return 1
}

vg_node_of_(p: *Page, h: int) -> ptr {
    i = h - VG_BASE
    if i < 1 || i > list.size(p.vg_nodes) { return null }
    n, _ = list.get(p.vg_nodes, i - 1)
    return n
}

// Register a node, run the shape's block (if the page gave one at fn_at)
// with it on top, and return its handle.
vg_shape_done_(p: *Page, argv: int, argc: int, fn_at: int, node: @keep ptr) -> int {
    ctx = p.ctx
    list.add(p.vg_nodes, node)
    h = VG_BASE + list.size(p.vg_nodes)
    if argc > fn_at {
        if is_fn_arg_(ctx, argv, fn_at) == 0 {
            return sae_throw_type_error(ctx, "a vg shape's block must be a function")
        }
        if vg_push_(p, node) == 0 { return sae_throw_type_error(ctx, "vg shapes nested too deeply") }
        r = call_arg_(p, argv, fn_at)
        p.vg_depth = p.vg_depth - 1
        if r < 0 { return rethrow_(ctx) }
    }
    return quickjs.new_int(ctx, h)
}

// A shape needs an open scene; a modifier needs an open shape (the scene
// root is not one).
vg_scene_open_(p: *Page) -> int {
    return p.vg_depth >= 1
}

vg_shape_open_(p: *Page) -> int {
    return p.vg_depth >= 2
}

// Repaint a scene after a change made outside a vg click (a ui button, a
// timer): clear, re-flush the shapes with their current style, present.
vg_repaint_(node: ptr) {
    scene = vg.node_scene(node)
    cid = vg.scene_canvas(scene)
    if cid == 0 { return }
    ui.canvas_clear(cid)
    live.vg_flush_live(scene, cid, 0.0)
    ui.canvas_redraw(cid)
}

// Call a held JS function with number arguments (a, and b unless nb is 1).
call_nums_(p: *Page, ref: int, a: float, b: float, nb: int) -> int {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    va = quickjs.new_float(ctx, a)
    _s1 = js_set_index_(p, args, 0, va)
    quickjs.release(ctx, va)
    if nb == 2 {
        vb = quickjs.new_float(ctx, b)
        _s2 = js_set_index_(p, args, 1, vb)
        quickjs.release(ctx, vb)
    }
    r = calln_(p, ref, args)
    quickjs.release(ctx, args)
    return r
}

// Hold argument i if it is a function, for a widget's change handler; 0
// when the page passed none.
held_fn_(ctx: ptr, argv: int, argc: int, i: int) -> int {
    if argc <= i { return 0 }
    if is_fn_arg_(ctx, argv, i) == 0 { return 0 }
    return hold_arg_(ctx, argv, i)
}

// Run a widget's change handler with one number.
fire_num_(p: *Page, ref: int, v: float, what: string) {
    ctx = p.ctx
    if ref == 0 { return }
    if call_nums_(p, ref, v, 0.0, 1) < 0 { report_exception_(p, what) }
    settle_(p)
}

// The handle argument of a get_/set_ function, or 0 when it is not a widget
// this page made.
own_arg_(p: *Page, argv: int, argc: int) -> int {
    ctx = p.ctx
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(p, h) == 0 { return 0 }
    return h
}

