// vg.g(fn): a group. Its block's fill, stroke, opacity and transform reach
// the shapes made inside it (and set_transform(g, t) turns them all later).
sae_ae_g(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_shape_done_, aevg_K_GROUP, quickjs, sae_throw_type_error, vg, vg_scene_open_, vg_top_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(p) == 0 { return sae_throw_type_error(ctx, "vg.g() must be called inside vg.scene()") }
    n = vg.g(vg_top_(p))
    return ae_shape_done_(p, argv, argc, 0, n, K_GROUP)
}

// vg.into(h, fn): run fn with a group (or the scene root) the page made on
// top, so its shapes land there: components rendered again, data joins.
sae_ae_into(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_rec_of_handle_, ae_repaint_, arg_int_, call_arg_, is_fn_arg_, quickjs, rethrow_, sae_throw_type_error, vg_push_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null || r.el != null { return sae_throw_type_error(ctx, "vg.into(h, fn): h is not a group or scene this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "vg.into(h, fn): fn must be a function") }
    if vg_push_(p, r.node) == 0 { return sae_throw_type_error(ctx, "vg shapes nested too deeply") }
    c = call_arg_(p, argv, 1)
    p.vg_depth = p.vg_depth - 1
    if c < 0 { return rethrow_(ctx) }
    ae_repaint_(p)
    return 0
}

// The modifiers: fill, stroke, opacity and transform on the open node, with
// the group cascade.
ae_modifier_rec_(p: *Page, name: string) -> *AeRec {
    if vg_shape_open_(p) == 0 { return null }
    return ae_top_rec_(p)
}

sae_ae_fill(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, aevg, arg_str_, own_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "fill")
    if r == null { return sae_throw_type_error(ctx, "vg.fill() must be called inside a shape's block") }
    aevg.rec_set_fill(r, own_(arg_str_(ctx, argv, argc, 0)))
    return 0
}

sae_ae_stroke(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, aevg, arg_num_, arg_str_, own_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "stroke")
    if r == null { return sae_throw_type_error(ctx, "vg.stroke() must be called inside a shape's block") }
    aevg.rec_set_stroke(r, own_(arg_str_(ctx, argv, argc, 0)), arg_num_(ctx, argv, argc, 1, 1.0))
    return 0
}

sae_ae_opacity(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, aevg, arg_num_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "opacity")
    if r == null { return sae_throw_type_error(ctx, "vg.opacity() must be called inside a shape's block") }
    aevg.rec_set_opacity(r, arg_num_(ctx, argv, argc, 0, 1.0))
    return 0
}

// vg.clip(id): in a shape's or a group's block, clip it to the clip path
// `id` from vg.defs (vg.clip_path). Only what lies inside the outline draws.
sae_ae_clip(p: *Page, this_val: int, argv: int) -> int {
    seal except AeScene, ae_modifier_rec_, aevg, arg_str_, own_, quickjs, sae_throw_type_error, `string`, vg
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "clip")
    if r == null { return sae_throw_type_error(ctx, "vg.clip() must be called inside a shape's or group's block") }
    id = arg_str_(ctx, argv, argc, 0)
    if string.length(id) == 0 { return sae_throw_type_error(ctx, "vg.clip(id): id names a vg.clip_path") }
    if r.node != null { vg.clip_path(r.node, own_("url(#${id})")) }
    aevg.scene_mark_dirty(r.scene as *AeScene)
    return 0
}

sae_ae_transform(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, aevg, arg_str_, own_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "transform")
    if r == null { return sae_throw_type_error(ctx, "vg.transform() must be called inside a shape's block") }
    aevg.rec_set_transform(r, own_(arg_str_(ctx, argv, argc, 0)))
    return 0
}

// linecap("round"|"square"|"butt"), linejoin("round"|"bevel"|"miter"): on
// the open shape, or on a group for the shapes made inside it afterwards.
sae_ae_linecap(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, arg_str_, own_, quickjs, sae_throw_type_error, vg
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "linecap")
    if r == null { return sae_throw_type_error(ctx, "vg.linecap() must be called inside a shape's block") }
    if r.el != null { vg.linecap(r.node, own_(arg_str_(ctx, argv, argc, 0))) }
    return 0
}

sae_ae_linejoin(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, arg_str_, own_, quickjs, sae_throw_type_error, vg
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "linejoin")
    if r == null { return sae_throw_type_error(ctx, "vg.linejoin() must be called inside a shape's block") }
    if r.el != null { vg.linejoin(r.node, own_(arg_str_(ctx, argv, argc, 0))) }
    return 0
}

// tooltip(s) and cursor(s) on the open shape. The tooltip shows on hover
// (natively on the canvas, or drawn where aether-ui draws them); the cursor
// is kept on the element for aether-ui to apply when its canvases can.
sae_ae_tooltip(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, arg_str_, own_, quickjs, sae_throw_type_error, vg
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "tooltip")
    if r == null || r.el == null { return sae_throw_type_error(ctx, "vg.tooltip() must be called inside a shape's block") }
    vg.tooltip(r.node, own_(arg_str_(ctx, argv, argc, 0)))
    r.interactive = 1
    return 0
}

sae_ae_cursor(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_modifier_rec_, arg_str_, own_, quickjs, sae_throw_type_error, vg
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_modifier_rec_(p, "cursor")
    if r == null || r.el == null { return sae_throw_type_error(ctx, "vg.cursor() must be called inside a shape's block") }
    vg.cursor(r.node, own_(arg_str_(ctx, argv, argc, 0)))
    r.interactive = 1
    return 0
}

// --- vg events: click (as before), hover, double and right click, drag, scroll ---

// The handler's shape and its scene, for a modifier that takes fn.
ae_event_rec_(p: *Page, argv: int, argc: int, name: string) -> *AeRec {
    ctx = p.ctx
    r = ae_modifier_rec_(p, name)
    if r == null || r.el == null { return null }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return null }
    r.interactive = 1
    return r
}

sae_ae_on_click(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_click")
    if r == null { return sae_throw_type_error(ctx, "vg.on_click(fn) must be called inside a shape's block, with a function") }
    r.h_click = hold_arg_(ctx, argv, 0)
    return 0
}

sae_ae_on_double_click(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_double_click")
    if r == null { return sae_throw_type_error(ctx, "vg.on_double_click(fn) must be called inside a shape's block, with a function") }
    r.h_dbl = hold_arg_(ctx, argv, 0)
    return 0
}

// on_right_click(fn): a right click on the shape (a long press on touch),
// dispatched by the scene's canvas hook (ae_wire_canvas_).
sae_ae_on_right_click(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_right_click")
    if r == null { return sae_throw_type_error(ctx, "vg.on_right_click(fn) must be called inside a shape's block, with a function") }
    r.h_right = hold_arg_(ctx, argv, 0)
    return 0
}

// on_hover(fn(inside)): inside is true as the pointer enters, false as it
// leaves.
sae_ae_on_hover(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_hover")
    if r == null { return sae_throw_type_error(ctx, "vg.on_hover(fn) must be called inside a shape's block, with a function") }
    r.h_hover = hold_arg_(ctx, argv, 0)
    return 0
}

// on_drag(fn(x, y, dx, dy)): the pointer moving with the button down over
// this shape, in viewBox units (once at the press, with zero deltas, then
// per move); on_drag_end(fn(x, y)) when it is released.
sae_ae_on_drag(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_drag")
    if r == null { return sae_throw_type_error(ctx, "vg.on_drag(fn) must be called inside a shape's block, with a function") }
    r.h_drag = hold_arg_(ctx, argv, 0)
    return 0
}

sae_ae_on_drag_end(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_drag_end")
    if r == null { return sae_throw_type_error(ctx, "vg.on_drag_end(fn) must be called inside a shape's block, with a function") }
    r.h_drag_end = hold_arg_(ctx, argv, 0)
    return 0
}

// on_scroll(fn(dx, dy)): the wheel over this shape; dy < 0 is away from
// the user (zoom in, by convention), in canvas pixels.
sae_ae_on_scroll(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_event_rec_, hold_arg_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_event_rec_(p, argv, argc, "on_scroll")
    if r == null { return sae_throw_type_error(ctx, "vg.on_scroll(fn) must be called inside a shape's block, with a function") }
    r.h_scroll = hold_arg_(ctx, argv, 0)
    return 0
}

// --- vg setters: a shape or group changed from anywhere ---

// vg.set_transform(h, t): a shape's or group's own transform; a group's
// children follow (the mode dial turns as one).
sae_ae_set_transform(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_rec_of_handle_, ae_repaint_, aevg, arg_int_, arg_str_, own_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.set_transform(h, t): h is not a vg node") }
    aevg.rec_set_transform(r, own_(arg_str_(ctx, argv, argc, 1)))
    ae_repaint_(p)
    return 0
}

sae_ae_set_visible(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_rec_of_handle_, ae_repaint_, aevg, arg_int_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.set_visible(h, on): h is not a vg node") }
    aevg.rec_set_visible(r, quickjs.arg_bool(ctx, argv, 1))
    ae_repaint_(p)
    return 0
}

// vg.remove(h): the node is hidden and done with (a data join's exit).
sae_ae_remove(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_rec_of_handle_, ae_repaint_, aevg, arg_int_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.remove(h): h is not a vg node") }
    aevg.rec_set_visible(r, 0)
    r.interactive = 0
    ae_repaint_(p)
    return 0
}

// Apply one property of a vg.set() object (or a bind_pos result) to a node.
// Geometry keys write the element's shape geometry, which the next flush
// draws from (circle: cx, cy, r; rect: x, y, w|width, h|height; line: x1,
// y1, x2, y2), once the shape has been drawn once.
ae_apply_prop_(p: *Page, r: *AeRec, key: string, obj: int) -> int {
    ctx = p.ctx
    if key == "fill" { aevg.rec_set_fill(r, ae_prop_str_(p, obj, key)); return 1 }
    if key == "opacity" { aevg.rec_set_opacity(r, ae_prop_num_(p, obj, key, 1.0)); return 1 }
    if key == "transform" { aevg.rec_set_transform(r, ae_prop_str_(p, obj, key)); return 1 }
    if key == "visible" {
        h, _e = js_get_(p, obj, key)
        aevg.rec_set_visible(r, js_to_bool_(p, h))
        quickjs.release(ctx, h)
        return 1
    }
    if key == "stroke" {
        h2, _e2 = js_get_(p, obj, key)
        if quickjs.type_of(ctx, h2) == "string" {
            aevg.rec_set_stroke(r, own_(js_str_(p, h2)), 1.0)
        } else {
            aevg.rec_set_stroke(r, ae_index_str_(p, h2, 0), ae_index_num_(p, h2, 1))
        }
        quickjs.release(ctx, h2)
        return 1
    }
    if key == "stroke_width" {
        if r.el != null && element.element_has_stroke(r.el) == 1 {
            aevg.rec_set_stroke(r, own_(element.element_last_stroke_color(r.el)), ae_prop_num_(p, obj, key, 1.0))
        }
        return 1
    }
    if key == "text" {
        if r.el != null { vg.element_set_text(r.el, ae_prop_str_(p, obj, key)) }
        aevg.scene_mark_dirty(r.scene as *AeScene)
        return 1
    }
    if r.el == null { return 0 }
    // A text moves by x and y too (aether-ui's text_set_pos); it was the one
    // node vg.set could not move.
    if r.kind == K_TEXT {
        if key == "x" || key == "y" {
            nx = element.element_geo0(r.el)
            ny = element.element_geo1(r.el)
            if key == "x" { nx = ae_prop_num_(p, obj, key, nx) }
            if key == "y" { ny = ae_prop_num_(p, obj, key, ny) }
            vg.element_text_set_pos(r.el, nx, ny)
            aevg.scene_mark_dirty(r.scene as *AeScene)
            return 1
        }
        return 0
    }
    slot = 0 - 1
    st = element.element_shape_type(r.el)
    if st == SHAPE_CIRCLE {
        if key == "cx" { slot = 0 }
        if key == "cy" { slot = 1 }
        if key == "r" { slot = 2 }
    }
    if st == SHAPE_RECT {
        if key == "x" { slot = 0 }
        if key == "y" { slot = 1 }
        if key == "w" || key == "width" { slot = 2 }
        if key == "h" || key == "height" { slot = 3 }
    }
    if st == SHAPE_LINE {
        if key == "x1" { slot = 0 }
        if key == "y1" { slot = 1 }
        if key == "x2" { slot = 2 }
        if key == "y2" { slot = 3 }
    }
    if slot < 0 { return 0 }
    element.element_set_geo(r.el, slot, ae_prop_num_(p, obj, key, 0.0))
    // The flush syncs the draw attrs from the geometry only for a shape with
    // a position binding; give it one (never evaluated by sae).
    if element.element_pos_binding(r.el) == null {
        element.element_bind_pos(r.el, ae_no_pos_)
    }
    aevg.scene_mark_dirty(r.scene as *AeScene)
    return 1
}

// The position binding sae gives a moved shape: never evaluated by sae.
ae_no_pos_() -> ptr { return null }

// Apply every property of a JS object.
ae_apply_obj_(p: *Page, r: *AeRec, obj: int) {
    ctx = p.ctx
    ks = js_keys_(p, obj)
    n = js_length_(p, ks)
    i = 0
    while i < n {
        k = ae_index_str_(p, ks, i)
        _a = ae_apply_prop_(p, r, k, obj)
        i = i + 1
    }
    quickjs.release(ctx, ks)
}

// vg.set(h, { fill, stroke: [c, w], opacity, transform, text, visible, cx,
// cy, r, x, y, w, h, x1, y1, x2, y2 }): several changes, one repaint.
sae_ae_set(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_apply_obj_, ae_rec_of_handle_, ae_repaint_, arg_int_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.set(h, props): h is not a vg node") }
    if argc < 2 { return 0 }
    obj = quickjs.arg(ctx, argv, 1)
    if quickjs.type_of(ctx, obj) == "object" { ae_apply_obj_(p, r, obj) }
    quickjs.release(ctx, obj)
    ae_repaint_(p)
    return 0
}

// vg.get(h): what the node currently has: fill, opacity, transform (its
// own), visible, text, and its geometry once drawn.
sae_ae_get(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_put_num_, ae_put_str_, ae_rec_of_handle_, aevg_K_TEXT, arg_int_, element, element_SHAPE_CIRCLE, element_SHAPE_LINE, element_SHAPE_RECT, js_set_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.get(h): h is not a vg node") }
    o = quickjs.new_object(ctx)
    ae_put_str_(p, o, "transform", r.tf)
    ae_put_num_(p, o, "opacity", r.op)
    vb = quickjs.new_bool(ctx, r.visible)
    _v = js_set_(p, o, "visible", vb)
    quickjs.release(ctx, vb)
    if r.el != null {
        ae_put_str_(p, o, "fill", element.element_last_fill(r.el))
        if element.element_has_stroke(r.el) == 1 {
            ae_put_str_(p, o, "stroke", element.element_last_stroke_color(r.el))
            ae_put_num_(p, o, "stroke_width", element.element_last_stroke_width(r.el))
        }
        lt = element.element_last_text(r.el)
        if lt != null { ae_put_str_(p, o, "text", lt) }
        if r.kind == K_TEXT {
            ae_put_num_(p, o, "x", element.element_geo0(r.el))
            ae_put_num_(p, o, "y", element.element_geo1(r.el))
        }
        st = element.element_shape_type(r.el)
        if st == SHAPE_CIRCLE {
            ae_put_num_(p, o, "cx", element.element_geo0(r.el))
            ae_put_num_(p, o, "cy", element.element_geo1(r.el))
            ae_put_num_(p, o, "r", element.element_geo2(r.el))
        }
        if st == SHAPE_RECT {
            ae_put_num_(p, o, "x", element.element_geo0(r.el))
            ae_put_num_(p, o, "y", element.element_geo1(r.el))
            ae_put_num_(p, o, "w", element.element_geo2(r.el))
            ae_put_num_(p, o, "h", element.element_geo3(r.el))
        }
        if st == SHAPE_LINE {
            ae_put_num_(p, o, "x1", element.element_geo0(r.el))
            ae_put_num_(p, o, "y1", element.element_geo1(r.el))
            ae_put_num_(p, o, "x2", element.element_geo2(r.el))
            ae_put_num_(p, o, "y2", element.element_geo3(r.el))
        }
    }
    return o
}

ae_put_str_(p: *Page, o: int, k: string, v: string) {
    ctx = p.ctx
    h = quickjs.new_string(ctx, v)
    _s = js_set_(p, o, k, h)
    quickjs.release(ctx, h)
}

ae_put_num_(p: *Page, o: int, k: string, v: float) {
    ctx = p.ctx
    h = quickjs.new_float(ctx, v)
    _s = js_set_(p, o, k, h)
    quickjs.release(ctx, h)
}

// --- vg bindings: evaluated by vg.refresh() ---

// A binding modifier: bind_fill(fn) inside a shape's block, or
// bind_fill(h, fn) from anywhere. Returns the record and holds fn.
ae_bind_args_(p: *Page, argv: int, argc: int, name: string) -> (ptr, int) {
    ctx = p.ctx
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) == 1 {
        r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
        if r == null { return null, 0 }
        return r as ptr, hold_arg_(ctx, argv, 1)
    }
    if argc >= 1 && is_fn_arg_(ctx, argv, 0) == 1 {
        r2 = ae_modifier_rec_(p, name)
        if r2 == null { return null, 0 }
        return r2 as ptr, hold_arg_(ctx, argv, 0)
    }
    return null, 0
}

ae_bind_add_(p: *Page, r: *AeRec, kind: int, fn_h: int) {
    b = heap.new(AeBind)
    b.rec = r as ptr
    b.scene = r.scene
    b.kind = kind
    b.fn_h = fn_h
    list.add(ae_page_(p).binds, b as ptr)
}

ae_bind_(p: *Page, argv: int, kind: int, name: string) -> int {
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    rp, fn_h = ae_bind_args_(p, argv, argc, name)
    r = rp as *AeRec
    if rp == null { return sae_throw_type_error(ctx, "vg.${name}(fn) must be called inside a shape's block (or as vg.${name}(h, fn)), with a function") }
    ae_bind_add_(p, r, kind, fn_h)
    ae_eval_bind_(p, r, kind, fn_h)
    ae_repaint_(p)
    return 0
}

sae_ae_bind_fill(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_FILL, ae_bind_
    return ae_bind_(p, argv, AB_FILL, "bind_fill")
}

sae_ae_bind_stroke(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_STROKE, ae_bind_
    return ae_bind_(p, argv, AB_STROKE, "bind_stroke")
}

sae_ae_bind_opacity(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_OPACITY, ae_bind_
    return ae_bind_(p, argv, AB_OPACITY, "bind_opacity")
}

sae_ae_bind_text(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_TEXT, ae_bind_
    return ae_bind_(p, argv, AB_TEXT, "bind_text")
}

sae_ae_bind_pos(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_POS, ae_bind_
    return ae_bind_(p, argv, AB_POS, "bind_pos")
}

sae_ae_bind_transform(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_TRANSFORM, ae_bind_
    return ae_bind_(p, argv, AB_TRANSFORM, "bind_transform")
}

sae_ae_visible_when(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_WHEN, ae_bind_
    return ae_bind_(p, argv, AB_WHEN, "visible_when")
}

// vg.view_box(fn): inside a scene's block: the viewBox follows fn's string
// (zoom and pan as state; the prelude accepts a state too).
sae_ae_view_box(p: *Page, this_val: int, argv: int) -> int {
    seal except AB_VIEWBOX, ae_bind_add_, ae_top_rec_, hold_arg_, is_fn_arg_, quickjs, sae_throw_type_error, vg_scene_open_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(p) == 0 { return sae_throw_type_error(ctx, "vg.view_box(fn) must be called inside vg.scene()") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "vg.view_box(fn): fn must be a function") }
    r = ae_top_rec_(p)
    if r == null { return 0 }
    ae_bind_add_(p, r, AB_VIEWBOX, hold_arg_(ctx, argv, 0))
    return 0
}

// vg.set_view_box(scene, "x y w h"): the scene handle is what vg.scene()
// returned.
sae_ae_set_view_box(p: *Page, this_val: int, argv: int) -> int {
    seal except AeScene, ae_model_, ae_rec_of_handle_, ae_repaint_, aevg, aevg_K_SCENE, arg_int_, arg_str_, own_, quickjs, sae_throw_type_error
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    r = ae_rec_of_handle_(p, arg_int_(ctx, argv, argc, 0, 0))
    if r == null || r.kind != K_SCENE { return sae_throw_type_error(ctx, "vg.set_view_box(scene, vb): scene is not one this page made") }
    aevg.scene_set_view_box(ae_model_(p), r.scene as *AeScene, own_(arg_str_(ctx, argv, argc, 1)))
    ae_repaint_(p)
    return 0
}

// Evaluate one binding: call its function, apply the value.
ae_eval_bind_(p: *Page, r: *AeRec, kind: int, fn_h: int) {
    ctx = p.ctx
    v = ae_call_value_(p, fn_h, "a vg binding")
    if v == 0 { return }
    t = quickjs.type_of(ctx, v)
    if kind == AB_FILL {
        if t != "undefined" { aevg.rec_set_fill(r, own_(js_str_(p, v))) }
    } else if kind == AB_STROKE {
        if t == "string" { aevg.rec_set_stroke(r, own_(js_str_(p, v)), 1.0) }
        // [colour, width]: contrib.quickjs's type_of names an array "array"
        else if t == "array" { aevg.rec_set_stroke(r, ae_index_str_(p, v, 0), ae_index_num_(p, v, 1)) }
    } else if kind == AB_OPACITY {
        aevg.rec_set_opacity(r, js_to_float_(p, v))
    } else if kind == AB_TEXT {
        if r.el != null {
            vg.element_set_text(r.el, own_(js_str_(p, v)))
            aevg.scene_mark_dirty(r.scene as *AeScene)
        }
    } else if kind == AB_POS {
        if t == "object" { ae_apply_obj_(p, r, v) }
    } else if kind == AB_TRANSFORM {
        aevg.rec_set_transform(r, own_(js_str_(p, v)))
    } else if kind == AB_WHEN {
        aevg.rec_set_visible(r, js_to_bool_(p, v))
    } else if kind == AB_VIEWBOX {
        sc = r.scene as *AeScene
        nv = own_(js_str_(p, v))
        if nv != sc.vb { aevg.scene_set_view_box(ae_model_(p), sc, nv) }
    }
    quickjs.release(ctx, v)
    settle_(p)
}

// vg.refresh(): re-evaluate every binding and repaint what changed. The
// prelude calls it after a state is set (once per batch).
sae_ae_refresh(p: *Page, this_val: int, argv: int) -> int {
    seal except AeBind, AeRec, ae_eval_bind_, ae_page_, ae_repaint_, list
    ap = ae_page_(p)
    n = list.size(ap.binds)
    i = 0
    while i < n {
        v, _ = list.get(ap.binds, i)
        b = v as *AeBind
        ae_eval_bind_(p, b.rec as *AeRec, b.kind, b.fn_h)
        i = i + 1
    }
    ae_repaint_(p)
    return 0
}

// --- vg defs: gradients and clip paths, named and registered on the scene ---

// vg.defs(fn): inside a scene's block; the gradients and clip paths declared
// in fn are registered together (a gradient may href one declared before it).
sae_ae_defs(p: *Page, this_val: int, argv: int) -> int {
    seal except AeScene, ae_page_, ae_top_rec_, aevg, call_arg_, is_fn_arg_, quickjs, rethrow_, sae_throw_type_error, strbuilder, vg_scene_open_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(p) == 0 { return sae_throw_type_error(ctx, "vg.defs(fn) must be called inside vg.scene()") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "vg.defs(fn): fn must be a function") }
    ap = ae_page_(p)
    if ap.defs_sb != null { return sae_throw_type_error(ctx, "vg.defs() cannot nest") }
    r = ae_top_rec_(p)
    ap.defs_sb = strbuilder.new(256)
    ap.defs_scene = r.scene
    c = call_arg_(p, argv, 0)
    svg = strbuilder.finish(ap.defs_sb)
    ap.defs_sb = null
    if c < 0 { return rethrow_(ctx) }
    aevg.defs_register(r.scene as *AeScene, svg)
    return 0
}

// The open defs block's builder, or null (with the error thrown).
ae_defs_sb_(p: *Page, name: string) -> ptr {
    ap = ae_page_(p)
    return ap.defs_sb
}

// stops: [[offset, color], [offset, color, opacity], ...] as <stop>s.
// A gradient's stops, [[offset, color, opacity?], ...]. The caller checks
// for "array": contrib.quickjs's type_of names an array "array", not
// "object" (checking "object" dropped every stop, so a gradient painted
// nothing).
ae_stops_(p: *Page, sb: ptr, stops: int) {
    ctx = p.ctx
    n = js_length_(p, stops)
    i = 0
    while i < n {
        st, _e = js_get_index_(p, stops, i)
        _a = strbuilder.append(sb, "<stop")
        _b = strbuilder.append(sb, aevg.attr_str("offset", ae_index_str_(p, st, 0)))
        _c = strbuilder.append(sb, aevg.attr_str("stop-color", ae_index_str_(p, st, 1)))
        _d = strbuilder.append(sb, aevg.attr_str("stop-opacity", ae_index_str_(p, st, 2)))
        _f = strbuilder.append(sb, "/>")
        quickjs.release(ctx, st)
        i = i + 1
    }
}

// The options a gradient may carry: { units, transform, href, spread }.
ae_gradient_opts_(p: *Page, sb: ptr, argv: int, argc: int, at: int) {
    ctx = p.ctx
    if argc <= at { return }
    o = quickjs.arg(ctx, argv, at)
    if quickjs.type_of(ctx, o) == "object" {
        _a = strbuilder.append(sb, aevg.attr_str("gradientUnits", ae_prop_str_(p, o, "units")))
        _b = strbuilder.append(sb, aevg.attr_str("gradientTransform", ae_prop_str_(p, o, "transform")))
        href = ae_prop_str_(p, o, "href")
        if string.length(href) > 0 { _c = strbuilder.append(sb, aevg.attr_str("xlink:href", "#${href}")) }
        _d = strbuilder.append(sb, aevg.attr_str("spreadMethod", ae_prop_str_(p, o, "spread")))
    }
    quickjs.release(ctx, o)
}

// vg.linear_gradient(id, x1, y1, x2, y2, stops, opts?): coordinates as
// fractions of the shape's box, or in viewBox units with
// { units: "userSpaceOnUse" }. A shape uses it with fill("url(#id)").
sae_ae_linear_gradient(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_defs_sb_, ae_gradient_opts_, ae_stops_, aevg, arg_str_, quickjs, sae_throw_type_error, strbuilder
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    sb = ae_defs_sb_(p, "linear_gradient")
    if sb == null { return sae_throw_type_error(ctx, "vg.linear_gradient() must be called inside vg.defs()") }
    _a = strbuilder.append(sb, "<linearGradient")
    _b = strbuilder.append(sb, aevg.attr_str("id", arg_str_(ctx, argv, argc, 0)))
    _c = strbuilder.append(sb, aevg.attr_str("x1", arg_str_(ctx, argv, argc, 1)))
    _d = strbuilder.append(sb, aevg.attr_str("y1", arg_str_(ctx, argv, argc, 2)))
    _e = strbuilder.append(sb, aevg.attr_str("x2", arg_str_(ctx, argv, argc, 3)))
    _f = strbuilder.append(sb, aevg.attr_str("y2", arg_str_(ctx, argv, argc, 4)))
    ae_gradient_opts_(p, sb, argv, argc, 6)
    _g = strbuilder.append(sb, ">")
    if argc > 5 {
        stops = quickjs.arg(ctx, argv, 5)
        if quickjs.type_of(ctx, stops) == "array" { ae_stops_(p, sb, stops) }
        quickjs.release(ctx, stops)
    }
    _h = strbuilder.append(sb, "</linearGradient>")
    return 0
}

// vg.radial_gradient(id, cx, cy, r, stops, opts?): opts may add fx and fy.
sae_ae_radial_gradient(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_defs_sb_, ae_gradient_opts_, ae_prop_str_, ae_stops_, aevg, arg_str_, quickjs, sae_throw_type_error, strbuilder
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    sb = ae_defs_sb_(p, "radial_gradient")
    if sb == null { return sae_throw_type_error(ctx, "vg.radial_gradient() must be called inside vg.defs()") }
    _a = strbuilder.append(sb, "<radialGradient")
    _b = strbuilder.append(sb, aevg.attr_str("id", arg_str_(ctx, argv, argc, 0)))
    _c = strbuilder.append(sb, aevg.attr_str("cx", arg_str_(ctx, argv, argc, 1)))
    _d = strbuilder.append(sb, aevg.attr_str("cy", arg_str_(ctx, argv, argc, 2)))
    _e = strbuilder.append(sb, aevg.attr_str("r", arg_str_(ctx, argv, argc, 3)))
    if argc > 5 {
        o = quickjs.arg(ctx, argv, 5)
        if quickjs.type_of(ctx, o) == "object" {
            _fx = strbuilder.append(sb, aevg.attr_str("fx", ae_prop_str_(p, o, "fx")))
            _fy = strbuilder.append(sb, aevg.attr_str("fy", ae_prop_str_(p, o, "fy")))
        }
        quickjs.release(ctx, o)
    }
    ae_gradient_opts_(p, sb, argv, argc, 5)
    _g = strbuilder.append(sb, ">")
    if argc > 4 {
        stops = quickjs.arg(ctx, argv, 4)
        if quickjs.type_of(ctx, stops) == "array" { ae_stops_(p, sb, stops) }
        quickjs.release(ctx, stops)
    }
    _h = strbuilder.append(sb, "</radialGradient>")
    return 0
}

// vg.clip_path(id, shapes, opts?): shapes as [["rect", x, y, w, h],
// ["circle", cx, cy, r], ["ellipse", cx, cy, rx, ry], ["path", d],
// ["polygon", points]]. A shape or a group is clipped to it with vg.clip(id)
// in its block (aether-ui's live scenes have carried clip paths since
// c42a8914).
sae_ae_clip_path(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_defs_sb_, ae_index_str_, ae_prop_str_, aevg, arg_str_, js_get_index_, js_length_, quickjs, sae_throw_type_error, strbuilder
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    sb = ae_defs_sb_(p, "clip_path")
    if sb == null { return sae_throw_type_error(ctx, "vg.clip_path() must be called inside vg.defs()") }
    _a = strbuilder.append(sb, "<clipPath")
    _b = strbuilder.append(sb, aevg.attr_str("id", arg_str_(ctx, argv, argc, 0)))
    if argc > 2 {
        o = quickjs.arg(ctx, argv, 2)
        if quickjs.type_of(ctx, o) == "object" {
            _t = strbuilder.append(sb, aevg.attr_str("transform", ae_prop_str_(p, o, "transform")))
            _u = strbuilder.append(sb, aevg.attr_str("clipPathUnits", ae_prop_str_(p, o, "units")))
        }
        quickjs.release(ctx, o)
    }
    _c = strbuilder.append(sb, ">")
    if argc > 1 {
        shapes = quickjs.arg(ctx, argv, 1)
        n = js_length_(p, shapes)
        i = 0
        while i < n {
            s, _e = js_get_index_(p, shapes, i)
            kind = ae_index_str_(p, s, 0)
            if kind == "rect" {
                _r = strbuilder.append(sb, "<rect${aevg.attr_str("x", ae_index_str_(p, s, 1))}${aevg.attr_str("y", ae_index_str_(p, s, 2))}${aevg.attr_str("width", ae_index_str_(p, s, 3))}${aevg.attr_str("height", ae_index_str_(p, s, 4))}/>")
            } else if kind == "circle" {
                _ci = strbuilder.append(sb, "<circle${aevg.attr_str("cx", ae_index_str_(p, s, 1))}${aevg.attr_str("cy", ae_index_str_(p, s, 2))}${aevg.attr_str("r", ae_index_str_(p, s, 3))}/>")
            } else if kind == "ellipse" {
                _el = strbuilder.append(sb, "<ellipse${aevg.attr_str("cx", ae_index_str_(p, s, 1))}${aevg.attr_str("cy", ae_index_str_(p, s, 2))}${aevg.attr_str("rx", ae_index_str_(p, s, 3))}${aevg.attr_str("ry", ae_index_str_(p, s, 4))}/>")
            } else if kind == "path" {
                _pa = strbuilder.append(sb, "<path${aevg.attr_str("d", ae_index_str_(p, s, 1))}/>")
            } else if kind == "polygon" {
                _po = strbuilder.append(sb, "<polygon${aevg.attr_str("points", ae_index_str_(p, s, 1))}/>")
            }
            quickjs.release(ctx, s)
            i = i + 1
        }
        quickjs.release(ctx, shapes)
    }
    _d = strbuilder.append(sb, "</clipPath>")
    return 0
}

// vg.css(text): CSS rules for the open scene (kind selectors such as
// `path { stroke: #000 }`; class selectors wait for a class attribute on
// shapes, as clip paths do).
sae_ae_css(p: *Page, this_val: int, argv: int) -> int {
    seal except AeScene, ae_top_rec_, aevg, arg_str_, own_, quickjs, sae_throw_type_error, vg_scene_open_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(p) == 0 { return sae_throw_type_error(ctx, "vg.css(text) must be called inside vg.scene()") }
    r = ae_top_rec_(p)
    if r == null { return 0 }
    aevg.css_register(r.scene as *AeScene, own_(arg_str_(ctx, argv, argc, 0)))
    return 0
}

// The prelude: the reactive surface over ui's host primitives and vg's, for
// api_register_ (called from there, after the gate spec has made ui and vg).
ae_register_(p: *Page) {
    q = p.ctx
    // The JS surface over these: state, computed, bind, each, batch, the
    // bind tagged template, vg.animate, vg.items (src/sae_prelude.js).
    pre, perr = js_eval_(p, sae_prelude(), "sae:prelude")
    if perr != "" { say_("sae: the prelude failed:\n${perr}") }
    quickjs.release(q, pre)
}

// ===== end wave1/aevg =====

// --- URLs and fetching ---

// --- http (the kernel side of the http page API) ---

struct HttpJob {
    id: int
    method: string
    url: string
    body: string
    ctype: string
    headers: ptr     // strarr of "Name: value", or null
    page_url: string // the page that asked, and its scopes: every redirect
    scopes: string   //   hop is checked against them as the first URL was
    status: int
    resp: string
    resp_headers: string
    err: string
    refused_hop: int // err is capabilities.http refusing a redirect hop: logged on delivery
    net: ptr         // the browser's services/net, which every hop is held to
    inbox: ptr       // the HttpInbox its fetcher hands it to when done
    app: int         // 1 in app mode (the escape rules are the browser's)
}

// A request a page is waiting on: which page (by load), and its callback.
struct HttpWait {
    id: int
    page: ptr
    seq: int
    ref: int         // the page's callback (a handle of its runtime)
}

message HttpDone { job: ptr }
message HttpTake {}

// A request's blocking call runs on a thread of its own (std.worker's
// run_detached), then hands the job to the inbox. It was a small pool of
// HttpFetcher actors, handed requests in turn: a blocking call on an actor
// holds its scheduler core, so a request held open (a long-poll, a slow
// answer) held up every actor sharing that core, other requests among them,
// for as long as it took (on a 4-core host one quick request in five waited
// the whole 3 s of a slow one beside it).
http_run_(jp: @keep ptr) {
    started = worker.run_detached(|| {
        http_do_(jp)
        ib = (jp as *HttpJob).inbox
        ib ! HttpDone { job: jp }
    })
    if started == false {
        j = jp as *HttpJob
        j.err = own_("could not start a thread for the request")
        ib0 = j.inbox
        ib0 ! HttpDone { job: jp }
    }
}

// Finished jobs, until the UI thread takes them. done is the actor's own
// and touched only in these handlers, so the actor serializes every access
// to it.
actor HttpInbox {
    state done: ptr = null
    receive {
        HttpDone(job) -> {
            if done == null { done = list.new() }
            list.add(done, job)
        }
        HttpTake() -> {
            long r = 0
            if done != null {
                if list.size(done) > 0 {
                    j, _ = list.get(done, 0)
                    list.list_remove(done, 0)
                    r = mem.ptr_to_long(j)
                }
            }
            reply r
        }
    }
}

// The browser's requests: the inbox (spawned on first use), the requests
// pages are waiting on, and the timer that polls.
struct HttpJobs {
    waits: ptr     // std.list of *HttpWait
    ids: int       // the last request id handed out
    timer: int     // the UI timer polling the inbox, or 0
    inbox: ptr     // the HttpInbox, or null before the first request
}

http_jobs_new_() -> *HttpJobs {
    hj = heap.new(HttpJobs)
    hj.waits = list.new()
    hj.ids = 0
    hj.timer = 0
    hj.inbox = null
    return hj
}

// A redirect status: the response names where to go next.
is_redirect_(status: int) -> int {
    if status == 301 || status == 302 || status == 303 || status == 307 || status == 308 { return 1 }
    return 0
}

const REDIRECT_HOPS = 5

// Run one request on a fetcher actor. Redirects are followed here, not by
// the client, so every hop is checked against the page's grant and scopes
// exactly as the first URL was: an allowed URL cannot redirect a page to
// one it may not reach.
http_do_(jp: ptr) {
    j = jp as *HttpJob
    url = j.url
    method = j.method
    body = j.body
    host0 = string.string_substring(url, 0, origin_end_(url))
    cross = 0        // a hop left the first origin: credentials stay behind
    if esc_cross_start_(j) == 1 { cross = 1 }   // wave1/escape: or the first URL already did
    hops = 0
    while 1 == 1 {
        // services/net builds the request only if app.json capabilities.http
        // covers the URL; every hop comes back through here.
        req, nerr = net.open_request(j.net, method, url)
        if req == null {
            j.err = own_(nerr)
            if string.string_starts_with(nerr, "this app may not reach") == 1 { j.refused_hop = 1 }
            return
        }
        client.set_timeout(req, 15s)
        if j.headers != null {
            nh = strarr.size(j.headers)
            hi = 0
            while hi < nh {
                line = strarr.get(j.headers, hi)
                c = string.index_of(line, ": ")
                if c > 0 {
                    hname = string.string_substring(line, 0, c)
                    lname = string.to_lower(hname)
                    if esc_header_kept_(j.app, lname) == 1 && (cross == 0 || (lname != "authorization" && lname != "cookie" && lname != "proxy-authorization")) {
                        _sh = client.set_header(req, hname, string.string_substring(line, c + 2, string.length(line)))
                    }
                }
                hi = hi + 1
            }
        }
        esc_send_origin_(req, j, cross)   // wave1/escape: Origin across origins, in the browser
        if body != "" || method == "POST" || method == "PUT" || method == "PATCH" {
            ct = j.ctype
            if ct == "" { ct = "text/plain" }
            _sb = client.set_body(req, string.bytes(body), ct)
        }
        resp, err = client.send_request(req)
        client.request_free(req)
        if err != "" {
            j.err = own_(err)
            return
        }
        status = client.response_status(resp)
        loc = ""
        if is_redirect_(status) == 1 { loc = client.response_header(resp, "Location") }
        if loc == "" {
            if esc_cors_refused_(j, resp, cross, url) == 1 {   // wave1/escape: the CORS-alike
                client.response_free(resp)
                return
            }
            j.status = status
            j.resp = own_(client.response_body(resp))
            j.resp_headers = own_(client.response_headers(resp))
            client.response_free(resp)
            return
        }
        client.response_free(resp)
        hops = hops + 1
        if hops > REDIRECT_HOPS {
            j.err = "too many redirects (more than ${REDIRECT_HOPS}) from ${j.url}"
            return
        }
        next = resolve_(url, loc)
        if string.string_starts_with(url, "https://") == 1 && string.string_starts_with(next, "http://") == 1 {
            j.err = "refused a redirect from https to http: ${next}"
            return
        }
        // 303, and 301/302 after a POST, continue as a GET without a body.
        if status == 303 || ((status == 301 || status == 302) && method == "POST") {
            method = "GET"
            body = ""
        }
        why = http_refusal_(j.net, j.app, j.page_url, j.scopes, method, next)
        if why != "" {
            j.err = "redirected to ${next}: ${why}"
            if net.refusal(j.net, next) != "" { j.refused_hop = 1 }
            return
        }
        if string.string_substring(next, 0, origin_end_(next)) != host0 { cross = 1 }
        url = next
    }
}

// 1 if s[i..] matches the glob g[k..]: "*" is any run of characters but
// "/", "**" any run at all, everything else itself.
glob_at_(g: string, k: int, s: string, i: int) -> int {
    gn = string.length(g)
    sn = string.length(s)
    while k < gn {
        c = string.string_char_at(g, k)
        if c == 42 {
            deep = 0
            if k + 1 < gn && string.string_char_at(g, k + 1) == 42 { deep = 1 }
            nk = k + 1 + deep
            jj = i
            while jj <= sn {
                if glob_at_(g, nk, s, jj) == 1 { return 1 }
                if jj < sn && deep == 0 && string.string_char_at(s, jj) == 47 { return 0 }
                jj = jj + 1
            }
            return 0
        }
        if i >= sn { return 0 }
        if string.string_char_at(s, i) != c { return 0 }
        i = i + 1
        k = k + 1
    }
    if i == sn { return 1 }
    return 0
}

// The path of an http(s) URL, without its query or fragment ("/" if none).
url_path_(u: string) -> string {
    path = string.string_substring(u, origin_end_(u), string.length(u))
    q = string.index_of(path, "?")
    if q >= 0 { path = string.string_substring(path, 0, q) }
    h = string.index_of(path, "#")
    if h >= 0 { path = string.string_substring(path, 0, h) }
    if path == "" { path = "/" }
    return path
}

// 1 if one of a page's scopes ("VERBS\tpattern" lines, patterns absolute)
// covers `method` on `url`: the method is listed, the origin is the
// pattern's exactly, and the path matches its glob. The query is not part
// of the match.
scope_covers_(scopes: string, method: string, url: string) -> int {
    origin = string.string_substring(url, 0, origin_end_(url))
    path = url_path_(url)
    lines = string.split(scopes, "\n")
    n = string.string_array_size(lines)
    i = 0
    while i < n {
        line = string.string_array_get(lines, i)
        i = i + 1
        tab = string.index_of(line, "\t")
        if tab > 0 {
            verbs = string.string_substring(line, 0, tab)
            pat = string.string_substring(line, tab + 1, string.length(line))
            if string.contains(",${verbs},", ",${method},") == 1 {
                if string.string_substring(pat, 0, origin_end_(pat)) == origin {
                    if glob_at_(url_path_(pat), 0, path, 0) == 1 { return 1 }
                }
            }
        }
    }
    return 0
}

// A request app.json capabilities.http refused, on the console: once per
// refusal, from the UI thread.
net_log_(why: string) {
    println("sae: refused: ${why}")
    fflush(sae_stdout())
}

// "" if a page at page_url, with these scopes ("" when it seeks
// outgoing-http unscoped), may make this request, else why not. The grant
// (app.json, or a web page's own origin) is checked first, then the scopes.
http_refusal_(nt: ptr, app: int, page_url: string, scopes: string, method: string, url: string) -> string {
    if is_http_(url) == 0 { return "http.get/post takes an http(s) URL: ${url}" }
    granted = 0
    if app == 1 {
        // app.json capabilities.http, held by services/net: the server first,
        // then the path prefix.
        nwhy = net.refusal(nt, url)
        if nwhy != "" { return nwhy }
        granted = 1
    }
    if granted == 0 {
        if is_http_(page_url) == 0 { return "a page may reach only its own origin: ${url}" }
        po = string.string_substring(page_url, 0, origin_end_(page_url))
        uo = string.string_substring(url, 0, origin_end_(url))
        // wave1/escape: another origin may be tried (the CORS-alike decides on
        // the response); mixed content may not.
        if po != uo {
            ew = esc_cross_why_(page_url, url)
            if ew != "" { return ew }
        }
    }
    if scopes != "" && scope_covers_(scopes, method, url) == 0 {
        return "this page's seeks do not cover ${method} ${url}"
    }
    return ""
}

http_start_(p: *Page, method: string, url_arg: string, body: string, ctype: string, headers: @keep ptr, ref: int) -> int {
    ctx = p.ctx
    if ref == 0 { return sae_throw_type_error(ctx, "http: the last argument must be a function") }
    url = resolve_(p.url, url_arg)
    // A URL app.json capabilities.http does not cover is refused like any
    // other (res.ok false, below), and logged once. Only in an app; in the
    // browser services/net checks nothing.
    if j_app_(p) == 1 && is_http_(url) == 1 {
        nwhy = net.refusal(browser_of_(p).net, url)
        if nwhy != "" { net_log_(nwhy) }
    }
    esc_log_mixed_(p, url)   // wave1/escape: mixed content, logged once here
    if esc_http_inflight_(p) >= ESC_HTTP_INFLIGHT_MAX { return esc_http_refuse_(ctx, p, ref) }   // wave1/escape: the in-flight cap
    hb = p.browser as *Browser
    hj = hb.http_jobs
    hj.ids = hj.ids + 1
    j = heap.new(HttpJob)
    j.id = hj.ids
    j.method = method
    j.url = own_(url)
    j.body = body
    j.ctype = ctype
    j.headers = headers
    j.status = 0
    j.resp = ""
    j.resp_headers = ""
    j.page_url = p.url
    j.net = (p.browser as *Browser).net
    j.app = 0
    if (p.browser as *Browser).app_dir != "" { j.app = 1 }
    j.scopes = p.http_scopes
    j.refused_hop = 0
    j.err = http_refusal_(j.net, j.app, p.url, p.http_scopes, method, url)
    w = heap.new(HttpWait)
    w.id = j.id
    w.page = p as ptr
    w.seq = p.seq
    w.ref = ref
    list.add(hj.waits, w as ptr)
    j.inbox = http_inbox_(hj)
    if j.err != "" {
        // Refused: no request, but the answer comes the same way, later.
        ib0 = j.inbox
        ib0 ! HttpDone { job: j as ptr }
    } else {
        http_run_(j as ptr)
    }
    if hj.timer == 0 { hj.timer = ui.timer(20, || { http_poll_(hb) }) }
    // The request object: { id, cancel() }.
    if http_helpers_(ctx, p) == 0 { return rethrow_(ctx) }
    args = quickjs.new_array(ctx)
    idh = quickjs.new_int(ctx, j.id)
    _s = js_set_index_(p, args, 0, idh)
    quickjs.release(ctx, idh)
    r, err = js_call_(p, p.http_req, 0, args)
    quickjs.release(ctx, args)
    if err != "" { return rethrow_(ctx) }
    return r
}

// The two small JS functions the http API hands pages, compiled once per page
// and held as GC roots: one makes the response object (so res.json() is a
// method), one the request object (so req.cancel() is). 1 when they are
// ready.
http_helpers_(ctx: ptr, p: *Page) -> int {
    if p.http_res != 0 { return 1 }
    rs = "(function (ok, status, text, error, raw) { var h = {}; var ls = raw.split(/\\r?\\n/); for (var i = 1; i < ls.length; i++) { var c = ls[i].indexOf(':'); if (c > 0) h[ls[i].slice(0, c).trim().toLowerCase()] = ls[i].slice(c + 1).trim(); } return { ok: ok, status: status, text: text, error: error, headers: h, json: function () { return JSON.parse(this.text); } }; })"
    qs = "(function (id) { return { id: id, cancel: function () { http.cancel(id); } }; })"
    rf, e1 = js_eval_(p, rs, "sae:http")
    if e1 != "" { return 0 }
    p.http_res = rf
    qf, e2 = js_eval_(p, qs, "sae:http")
    if e2 != "" { return 0 }
    p.http_req = qf
    return 1
}

http_cancel_(p: *Page, id: int) {
    waits = (p.browser as *Browser).http_jobs.waits
    n = list.size(waits)
    i = 0
    while i < n {
        wv, _ = list.get(waits, i)
        w = wv as *HttpWait
        if w.id == id && w.page == p as ptr {
            list.list_remove(waits, i)
            heap.free(w)
            return
        }
        i = i + 1
    }
}

http_inbox_(hj: *HttpJobs) -> ptr {
    if hj.inbox == null { hj.inbox = spawn(HttpInbox()) }
    return hj.inbox
}


// On the UI thread: take every finished job and run its page's callback.
http_poll_(b: *Browser) {
    // Page JS is running (a nested event loop under a host call): the page's
    // grants are in force, and this is the kernel's own work. Wait for the
    // next tick.
    if b.entry_depth > 0 { return }
    hj = b.http_jobs
    ib = http_inbox_(hj)
    while true {
        jl = ib ? HttpTake {}
        if jl == 0 { break }
        http_deliver_(b, mem.long_to_ptr(jl) as *HttpJob)
    }
    if list.size(hj.waits) == 0 {
        ui.timer_cancel(hj.timer)
        hj.timer = 0
    }
}

http_deliver_(b: *Browser, j: *HttpJob) {
    if j.refused_hop == 1 { net_log_(j.err) }
    waits = b.http_jobs.waits
    n = list.size(waits)
    i = 0
    while i < n {
        wv, _ = list.get(waits, i)
        w = wv as *HttpWait
        if w.id == j.id {
            list.list_remove(waits, i)
            cur = b.page
            if cur != null && cur == w.page && (cur as *Page).seq == w.seq {
                p = cur as *Page
                r = call_http_(p, w.ref, j.status, j.resp, j.err, j.resp_headers)
                if r < 0 { report_exception_(p, "an http callback") }
                settle_(p)
            }
            heap.free(w)
            heap.free(j)
            return
        }
        i = i + 1
    }
    heap.free(j)
}

// fn(res): res is made by the page's response maker, then handed to fn.
call_http_(p: *Page, ref: int, status: int, text: string, err: string, raw_headers: string) -> int {
    ctx = p.ctx
    if http_helpers_(ctx, p) == 0 { return 0 - 1 }
    ok = 0
    if err == "" && status >= 200 && status < 300 { ok = 1 }
    args = quickjs.new_array(ctx)
    a0 = quickjs.new_bool(ctx, ok)
    a1 = quickjs.new_int(ctx, status)
    a2 = quickjs.new_string(ctx, text)
    a3 = quickjs.new_string(ctx, err)
    a4 = quickjs.new_string(ctx, raw_headers)
    _s0 = js_set_index_(p, args, 0, a0)
    _s1 = js_set_index_(p, args, 1, a1)
    _s2 = js_set_index_(p, args, 2, a2)
    _s3 = js_set_index_(p, args, 3, a3)
    _s4 = js_set_index_(p, args, 4, a4)
    quickjs.release(ctx, a0)
    quickjs.release(ctx, a1)
    quickjs.release(ctx, a2)
    quickjs.release(ctx, a3)
    quickjs.release(ctx, a4)
    res, e1 = js_call_(p, p.http_res, 0, args)
    quickjs.release(ctx, args)
    if e1 != "" { return 0 - 1 }
    args2 = quickjs.new_array(ctx)
    _s5 = js_set_index_(p, args2, 0, res)
    quickjs.release(ctx, res)
    r = calln_(p, ref, args2)
    quickjs.release(ctx, args2)
    return r
}

// --- capabilities (the kernel side; docs/app-capabilities.md) ---

// The http, fs and shell grants live in services/net, services/files and
// services/shell.

// 1 when the page is an installed app's (the browser runs in app mode).
j_app_(p: *Page) -> int {
    if (p.browser as *Browser).app_dir != "" { return 1 }
    return 0
}

// The app's own data folder: $SAE_APPDATA_DIR, else the platform's place.
app_data_dir_(b: *Browser) -> string {
    d = env_("SAE_APPDATA_DIR")
    if d != "" { return slashes_(d) }
    if os.platform() == "darwin" { return "${home_dir_()}/Library/Application Support/${b.app_name}" }
    if os.platform() == "windows" && env_("APPDATA") != "" { return "${slashes_(env_("APPDATA"))}/${b.app_name}" }
    return "${home_dir_()}/.local/share/${b.app_name}"
}

// $HOME, or on Windows (where a program not started from MSYS2 or Cygwin
// has none) %USERPROFILE%; "" if neither.
home_dir_() -> string {
    h = env_("HOME")
    if h == "" && os.platform() == "windows" { h = env_("USERPROFILE") }
    return slashes_(h)
}

// $TMPDIR, else %TEMP% on Windows, else /tmp; no trailing "/".
temp_dir_() -> string {
    t = env_("TMPDIR")
    if t == "" && os.platform() == "windows" { t = env_("TEMP") }
    if t == "" { t = "/tmp" }
    t = slashes_(t)
    while string.length(t) > 1 && string.string_ends_with(t, "/") == 1 { t = string.string_substring(t, 0, string.length(t) - 1) }
    return t
}

// A JSON text made into a JS value (JSON.parse, from the host), for a
// page-API call to return.
json_value_(ctx: ptr, text: string) -> int {
    h, err = quickjs.parse_json(ctx, text)
    if err != "" { return sae_throw_type_error(ctx, "bad JSON from the host: ${err}") }
    return h
}

// 1 when app.json grants clipboard "read" (a page that also seeks
// clipboard-read may read at any time).

// 1 if this context can give a page the privilege `nm`. A web page in the
// browser gets outgoing-http (to its own origin) and nothing else; an app
// gets each only as far as app.json grants it.
available_(b: *Browser, nm: string) -> int {
    if b.app_dir == "" {
        if nm == "outgoing-http" { return 1 }
        if nm == "clipboard" { return 1 }
        return 0
    }
    if nm == "outgoing-http" { return net.granted(b.net) }
    if nm == "local-filesystem" { return files.granted(b.files) }
    if nm == "documents" { return documents.granted(b.documents) }
    if nm == "clipboard" { return 1 }
    if nm == "clipboard-read" { return b.clip_read_granted }
    // Desktop first: Android and iOS have their own IPC.
    if nm == "control-bus" {
        if os.platform() == "android" || os.platform() == "ios" { return 0 }
        return bus.declared(b.bus)
    }
    if nm == "open-urls" { return shell.granted(b.shell) }
    if nm == "print" { return printing.granted(b.printing) }
    if nm == "backend" { return b.backend_declared }
    if string.string_starts_with(nm, "database ") == 1 { return sqlite_granted_(b, string.string_substring(nm, 9, string.length(nm))) }   // wave1/sqlite
    if string.string_starts_with(nm, "native ") == 1 { return natives_granted_(b, string.string_substring(nm, 7, string.length(nm))) }   // wave1/natives
    return 0
}

// Why a page that seeks `seeks` (",local-filesystem,...", from its "seeks"
// lines) cannot run here, or "".
seek_refusal_(b: *Browser, url: string, seeks: string) -> string {
    if seeks == "" { return "" }
    missing = ""
    parts = string.split(seeks, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.concat(string.string_array_get(parts, i), "")
        if nm != "" && available_(b, nm) == 0 {
            if missing == "" { missing = nm } else { missing = "${missing}, ${nm}" }
        }
        i = i + 1
    }
    if missing == "" { return "" }
    if b.app_dir == "" { return "${url} seeks ${missing}, which a web page in the browser cannot have" }
    return "${url} seeks ${missing}, which this app's app.json does not grant"
}

// A page's outgoing-http scopes (lowerer lines "outgoing-http\tVERBS\tpattern")
// checked against what this context grants, with path-only patterns ("/api/*")
// made absolute against the page's own origin. Returns the scopes as the
// page keeps them ("VERBS\tpattern" lines) and "", or "" and why the page
// cannot run. A scope must lie inside the grant: within app.json's http
// prefixes in an app, on the page's own origin in the browser.
http_scopes_for_(b: *Browser, page_url: string, scopes: string) -> (string, string) {
    out = ""
    lines = string.split(scopes, "\n")
    n = string.string_array_size(lines)
    i = 0
    while i < n {
        line = string.string_array_get(lines, i)
        i = i + 1
        if string.string_starts_with(line, "outgoing-http\t") == 1 {
            rest = string.string_substring(line, 14, string.length(line))
            tab = string.index_of(rest, "\t")
            verbs = string.string_substring(rest, 0, tab)
            pat = string.string_substring(rest, tab + 1, string.length(rest))
            shown = "seeks outgoing-http ${verbs} ${pat}"
            if string.string_starts_with(pat, "/") == 1 {
                if is_http_(page_url) == 0 {
                    return "", "${page_url} ${shown}: a path-only pattern means the page's own origin, and this page has none; name the full URL"
                }
                pat = string.concat(string.string_substring(page_url, 0, origin_end_(page_url)), pat)
            }
            if b.app_dir != "" {
                lit = pat
                star = string.index_of(pat, "*")
                if star >= 0 { lit = string.string_substring(pat, 0, star) }
                if net.refusal(b.net, lit) != "" {
                    return "", "${page_url} ${shown}, beyond what this app's app.json grants (capabilities.http)"
                }
            } else {
                // wave1/escape: any http(s) origin, held to the CORS-alike per
                // request; not http: from an https: page.
                ew = esc_scope_why_(page_url, pat)
                if ew != "" { return "", "${page_url} ${shown}, ${ew}" }
            }
            out = string.concat(out, "${verbs}\t${pat}\n")
        }
    }
    return out, ""
}

// The privileges a page can do without (",outgoing-http,") that this context
// cannot give it, as ",local-filesystem,": their objects are left out, so the
// page sees `typeof fs === "undefined"` and falls back.
absent_of_(b: *Browser, optional: string) -> string {
    out = ","
    parts = string.split(optional, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.string_array_get(parts, i)
        if nm != "" && available_(b, nm) == 0 { out = string.concat(out, "${nm},") }
        i = i + 1
    }
    return out
}

// The privileges a page seeks neither required nor optional
// ("local-filesystem,open-urls,"), to leave out with the absent ones.
unsought_(seeks: string, optional: string) -> string {
    out = ""
    names = string.split("outgoing-http,local-filesystem,open-urls,print,documents,clipboard,clipboard-read,control-bus,backend", ",")
    n = string.string_array_size(names)
    i = 0
    while i < n {
        nm = string.string_array_get(names, i)
        if string.contains(",${seeks},${optional},", ",${nm},") == 0 { out = string.concat(out, "${nm},") }
        i = i + 1
    }
    return out
}

// The strings of a JSON array `key` in object `v` (none if absent), each
// handed to `add`.
grants_from_(v: ptr, key: string, add: fn) {
    if v == null { return }
    a = json.json_object_get_raw(v, key)
    if a == null { return }
    n = json.json_array_size(a)
    i = 0
    while i < n {
        sv, serr = json.get_string(json.json_array_get_raw(a, i))
        if serr == "" { call(add, sv) }
        i = i + 1
    }
}

// The app's grants from app.json "capabilities", handed to the services
// that enforce them (http's stay here, with the actors that make requests).
read_capabilities_(b: *Browser, manifest: ptr) {
    win = 0
    if os.platform() == "windows" { win = 1 }
    files.configure(b.files, 1, app_data_dir_(b), home_dir_(), temp_dir_(), win)
    shell.configure(b.shell, 1, env_("SAE_SHELL_LOG"))
    // capabilities.http is the app's whole network: absent or empty is none
    // (Tauri's deny by default). An entry services/net does not understand
    // allows nothing and is reported.
    net.configure(b.net, 1)
    if manifest == null { return }
    caps = json.json_object_get_raw(manifest, "capabilities")
    if caps == null { return }
    grants_from_(caps, "http", |u: string| {
        nerr = net.allow(b.net, u)
        if nerr != "" { println("sae: ${nerr}") }
    })
    grants_from_(json.json_object_get_raw(caps, "shell"), "open", |u: string| { shell.grant(b.shell, u) })
    fsg = json.json_object_get_raw(caps, "fs")
    grants_from_(fsg, "read", |r: string| { files.grant_read(b.files, r) })
    grants_from_(fsg, "write", |r: string| { files.grant_write(b.files, r) })
    // capabilities.documents ({}): pages may ask the person to pick files
    // (services/documents); what they read and write is what was picked.
    if json.json_object_get_raw(caps, "documents") != null { documents.configure(b.documents, 1) }
    // capabilities.print ({}): pages may hand a PDF to the system's print
    // dialog (services/print), its file written in the app's data folder.
    if json.json_object_get_raw(caps, "print") != null { printing.configure(b.printing, 1, app_data_dir_(b)) }
    // capabilities.controlBus ({ "name": ..., "maxRequestBytes": ... }): the
    // app may be driven by other programs on this machine, while the person
    // has switched it on (--control-bus). services/bus.
    cb = json.json_object_get_raw(caps, "controlBus")
    if cb != null {
        bn = "control"
        bnv = json.json_object_get_raw(cb, "name")
        if bnv != null {
            bs, _bse = json.get_string(bnv)
            if bs != "" { bn = bs }
        }
        bmax = 65536
        bmv = json.json_object_get_raw(cb, "maxRequestBytes")
        if bmv != null { bmax = json.json_get_int(bmv) }
        bus.configure(b.bus, bn, bmax)
        uiv = json.json_object_get_raw(cb, "ui")
        if uiv != null && json.json_get_bool(uiv) == 1 { b.bus_ui_granted = 1 }
    }
    // capabilities.clipboard (["write"], ["read"], both): at any time, not
    // only while the person clicks, types or pastes. Reading also needs the
    // page to seek clipboard-read.
    grants_from_(caps, "clipboard", |g: string| {
        if g == "write" { clipboard.grant_write(b.clipboard) }
        if g == "read" {
            clipboard.grant_read(b.clipboard)
            b.clip_read_granted = 1
        }
    })
}

// --- storage (the kernel side of the storage page API) ---

const STORAGE_MAX = 1048576

storage_key_ok_(k: string) -> int {
    n = string.length(k)
    if n == 0 || n > 128 { return 0 }
    i = 0
    while i < n {
        c = string.char_at(k, i)
        ok = 0
        if c >= 97 && c <= 122 { ok = 1 }
        if c >= 65 && c <= 90 { ok = 1 }
        if c >= 48 && c <= 57 { ok = 1 }
        if c == 46 || c == 95 || c == 45 { ok = 1 }
        if ok == 0 { return 0 }
        i = i + 1
    }
    if string.string_starts_with(k, ".") == 1 { return 0 }
    return 1
}

// A short, stable hash of s as 16 hex digits: two 32-bit multiply-xor lanes
// (FNV-1a, and the same with another seed and multiplier; the products stay
// below 2^57, so nothing overflows). For naming storage folders,
// not for security.
hash_hex_(s: string) -> string {
    long h1 = 2166136261
    long h2 = 2654435761
    n = string.length(s)
    i = 0
    while i < n {
        long c = string.string_char_at(s, i) as long
        h1 = ((h1 ^ c) * 16777619) % 4294967296
        h2 = ((h2 ^ c) * 1000003) % 4294967296
        i = i + 1
    }
    a = string.string_pad_start(string.string_from_int_radix(h1, 16), 8, 48)
    b2 = string.string_pad_start(string.string_from_int_radix(h2, 16), 8, 48)
    return "${a}${b2}"
}

// A directory as the OS spells it (symlinks and .. resolved), or as given if
// it cannot be resolved.
canonical_dir_(d: string) -> string {
    p, _k, err = fs.realpath(d)
    if err != "" || p == "" { return own_(d) }
    return slashes_(p)
}

// The bundle identifier of the macOS .app whose executable is `exe`
// (Contents/Info.plist, as tools/saepack.sh writes it), or "".
bundle_id_(exe: string) -> string {
    plist, err = fs.read(string.concat(dir_of_(exe), "../Info.plist"))
    if err != "" { return "" }
    k = string.index_of(plist, "<key>CFBundleIdentifier</key>")
    if k < 0 { return "" }
    rest = string.string_substring(plist, k, string.length(plist))
    a = string.index_of(rest, "<string>")
    z = string.index_of(rest, "</string>")
    if a < 0 || z < a { return "" }
    return own_(string.string_substring(rest, a + 8, z))
}

// What an installed app's storage is keyed by: never its display name (two
// apps may share one). A packaged macOS .app: its bundle identifier. Any
// other app (sae --app <dir>, an APK, whose pages are copied to app/ in the
// package's own files folder): its folder, canonical, hashed, after the
// folder's own name for a person reading the storage folder.
app_storage_key_(dir: string, exe: string, bundled: int) -> string {
    if bundled == 1 {
        bid = bundle_id_(exe)
        if bid != "" { return "id-${bid}" }
    }
    c = canonical_dir_(dir)
    return "${base_name_(c)}-${hash_hex_(c)}"
}

// The folder a page's storage lives in: one per installed app (app_key_),
// per origin, or, for a page loaded from a file, per directory: the file
// system's nearest thing to a site, so a folder of pages that link to one
// another shares storage, and pages in another folder do not.
// $SAE_STORAGE_DIR, else ~/.sae/storage, or .sae/storage in the working
// directory where there is no $HOME (an Android app: its own files folder).
storage_dir_(b: *Browser, url: string) -> string {
    root = slashes_(env_("SAE_STORAGE_DIR"))
    home = home_dir_()
    if home == "" { home = "." }
    if root == "" { root = "${home}/.sae/storage" }
    scope = "file"
    if is_app_(url) == 1 { scope = string.concat("app-", b.app_key) }
    if is_http_(url) == 1 { scope = string.string_substring(url, 0, origin_end_(url)) }
    if is_app_(url) == 0 && is_http_(url) == 0 {
        d = dir_of_(url)
        if d == "" { d = "." }
        cd = canonical_dir_(d)
        scope = "file-${base_name_(cd)}-${hash_hex_(cd)}"
    }
    // A folder name: anything but letters, digits, '.', '-' becomes '_'.
    out = ""
    i = 0
    while i < string.length(scope) {
        c = string.char_at(scope, i)
        keep = 0
        if c >= 97 && c <= 122 { keep = 1 }
        if c >= 65 && c <= 90 { keep = 1 }
        if c >= 48 && c <= 57 { keep = 1 }
        if c == 46 || c == 45 { keep = 1 }
        if keep == 1 { out = string.concat(out, string.from_char(c)) } else { out = string.concat(out, "_") }
        i = i + 1
    }
    return "${root}/${out}"
}

storage_read_(dir: string, key: string) -> (string, int) {
    v, err = fs.read("${dir}/${key}")
    if err != "" { return "", 0 }
    return v, 1
}

storage_write_(dir: string, key: string, val: string) -> int {
    werr = fs.write_atomic("${dir}/${key}", string.bytes(val))
    if werr != "" { return 0 }
    return 1
}

storage_remove_(dir: string, key: string) {
    _r = fs.remove_tree("${dir}/${key}")
}

is_app_(u: string) -> int {
    return string.string_starts_with(u, "app:")
}

// The file an app: URL names: app:/about is <app>/about.ts (or .js), app:/ is
// the index, and a path that already ends in .ts or .js is taken as it is.
app_file_(b: *Browser, url: string) -> string {
    path = string.string_substring(url, 4, string.length(url))
    if path == "" || path == "/" { path = "/index" }
    if string.string_ends_with(path, "/") == 1 { path = string.concat(path, "index") }
    stem = string.concat(b.app_dir, path)
    if string.string_ends_with(stem, ".ts") == 1 || string.string_ends_with(stem, ".js") == 1 { return stem }
    if fs.exists("${stem}.ts") == 1 { return "${stem}.ts" }
    return "${stem}.js"
}

// Read an app page. A missing one is the app's own 404 page, as the dev page
// server serves it, when the app has one.
fetch_app_(b: *Browser, url: string) -> (int, string, string, string) {
    f = app_file_(b, url)
    src, ferr = fs.read(f)
    if ferr == "" { return 200, src, own_(url), "" }
    nf = app_file_(b, "app:/404")
    src2, ferr2 = fs.read(nf)
    if ferr2 == "" { return 404, src2, own_(url), "" }
    return 0, "", own_(url), "no such page in this app: ${url}"
}

is_http_(u: string) -> int {
    if string.string_starts_with(u, "http://") == 1 { return 1 }
    if string.string_starts_with(u, "https://") == 1 { return 1 }
    return 0
}

// The end of "scheme://host[:port]" in an http(s) URL.
origin_end_(u: string) -> int {
    start = string.string_index_of(u, "://") + 3
    rest = string.string_substring(u, start, string.length(u))
    slash = string.string_index_of(rest, "/")
    if slash < 0 { return string.length(u) }
    return start + slash
}

// Everything up to and including the last '/' of s (or "" if none).
dir_of_(s: string) -> string {
    i = string.length(s) - 1
    while i >= 0 {
        if string.string_substring(s, i, i + 1) == "/" {
            return string.string_substring(s, 0, i + 1)
        }
        i = i - 1
    }
    return ""
}

// Resolve href against the URL of the page that asked for it. Absolute
// http(s) URLs pass through; "/x" is origin-relative; anything else is
// relative to the base's directory. A base that is a file path resolves the
// same way against the file system.
resolve_(base: string, href: string) -> string {
    if is_http_(href) == 1 { return own_(href) }
    if is_app_(href) == 1 { return own_(href) }
    if is_app_(base) == 1 {
        if string.string_starts_with(href, "/") == 1 { return string.concat("app:", href) }
        return string.concat(dir_of_(base), href)
    }
    if is_http_(base) == 1 {
        oe = origin_end_(base)
        if string.string_starts_with(href, "/") == 1 {
            return string.concat(string.string_substring(base, 0, oe), href)
        }
        path_part = string.string_substring(base, oe, string.length(base))
        if path_part == "" { path_part = "/" }
        return string.concat(string.concat(string.string_substring(base, 0, oe), dir_of_(path_part)), href)
    }
    if string.string_starts_with(href, "/") == 1 { return own_(href) }
    return string.concat(dir_of_(base), href)
}

// Fetch a page. Returns (status, body, final_url, err): status is the HTTP
// status (200 for a file read), final_url is where redirects ended, and err
// is "" unless nothing could be fetched at all.
fetch_(b: *Browser, url: string) -> (int, string, string, string) {
    if is_app_(url) == 1 { return fetch_app_(b, url) }
    // An app's pages are its own (app.json "start" included): it loads no
    // page from a file or the network, whatever capabilities.http lists.
    if b.app_dir != "" { return 0, "", own_(url), "this app loads only its own pages (app:/...): ${url}" }
    if is_http_(url) == 0 {
        src, ferr = fs.read(url)
        if ferr != "" { return 0, "", url, ferr }
        return 200, src, url, ""
    }
    req, nerr = net.open_request(b.net, "GET", url)
    if req == null { return 0, "", url, "not a valid URL" }
    client.set_timeout(req, 10s)
    client.set_follow_redirects(req, 5)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", url, err }
    status = client.response_status(resp)
    body = client.response_body(resp)
    final_url = own_(client.response_url(resp))
    client.response_free(resp)
    if final_url == "" { final_url = own_(url) }
    return status, body, final_url, ""
}

// --- pages ---

// --- the page's engine: the only code that makes, runs and frees one ---

engine_new_(mem_bytes: long) -> ptr {
    kb = (mem_bytes / 1024) as int
    return quickjs.runtime(kb, 0)
}

// The page's time limit for one entry into its JS, in ms: PAGE_TIME_MS, or
// SAE_PAGE_TIME_MS (specs use a short one).
page_time_ms_() -> int {
    tv = env_("SAE_PAGE_TIME_MS")
    if tv != "" {
        n, nerr = string.to_int(tv)
        if nerr == "" && n > 0 { return n }
    }
    return PAGE_TIME_MS
}

// An entry into the page's JS runs under a deadline of its own, now plus the
// page's limit (contrib.quickjs's deadline is absolute and no entry resets
// it, as the old set_time_limit did). Page JS runs not only in eval, call and
// run_jobs but in every host conversion of a page's value: a getter (get,
// length, keys), a valueOf (to_int, to_float), a toString (to_string), a
// toJSON (to_json), a setter on a prototype (set, set_index). So each of
// those is an entry too (the js_* helpers below; tests/check_timed_entries.sh
// holds the source to it). An entry made while another is running keeps the
// earlier deadline, which is the running one's (the limit is the same and it
// began first), and each puts back what it found when it ends, so no
// deadline outlives its entry: host code that reads a JS value later is not
// stopped by a deadline long past, and is not left unbounded either.
entry_begin_(p: *Page) -> long {
    // Every begin is counted and every end or stop uncounts it, so the
    // browser can say whether any page's JS is running (the kernel's ticks
    // wait for it to be 0, "kernel_tick_ok_").
    p.entry_depth = p.entry_depth + 1
    browser_of_(p).entry_depth = browser_of_(p).entry_depth + 1
    prev = quickjs.deadline_ns(p.ctx)
    // The outermost entry into a page puts the page's grant list in force
    // (services/pagegrants): sae's own std operations on this thread, until
    // the entry ends, are held to it. A nested entry (a conversion inside a
    // handler, a call from a host function) is under it already, and the
    // runtime allows 64 levels, so only depth 0 to 1 pushes. The list is
    // lent, not copied (sandbox.enforce copies; its grants are frozen):
    // sandbox.enter/leave are not released, so the runtime's builtins stand
    // in; they are named here and nowhere else (check_page_sandbox.sh).
    if p.entry_depth == 1 { sandbox_push(p.grants) }
    if prev != 0 { return prev }
    quickjs.clear_interrupted(p.ctx)
    quickjs.set_deadline_ns(p.ctx, quickjs.now_ns() + (browser_of_(p).page_time_ms as long) * 1000000)
    return 0
}

entry_end_(p: *Page, prev: long) {
    p.entry_depth = p.entry_depth - 1
    browser_of_(p).entry_depth = browser_of_(p).entry_depth - 1
    if p.entry_depth == 0 { sandbox_pop() }
    if prev == 0 { quickjs.set_deadline_ns(p.ctx, 0) }
}

// The end of a host conversion that began an entry of its own (prev == 0):
// if the time limit stopped the page's code, say so, once, naming what the
// host was reading. Inside another entry that entry reports (a handler's
// exception, a promise job's).
entry_stopped_(p: *Page, prev: long, what: string) {
    p.entry_depth = p.entry_depth - 1
    browser_of_(p).entry_depth = browser_of_(p).entry_depth - 1
    if p.entry_depth == 0 { sandbox_pop() }
    if prev != 0 { return }
    if quickjs.interrupted(p.ctx) != 0 {
        say_("sae: stopped: the page's code ran past its limit of ${browser_of_(p).page_time_ms} ms while sae was reading ${what}")
        quickjs.clear_interrupted(p.ctx)
    }
    quickjs.set_deadline_ns(p.ctx, 0)
}

// Leave the page's grants for the one kind of work they cannot cover, and come
// back: services/files resolves a path the page named by walking it
// component by component (fs.is_symlink on each, so /home, /home/paul, ...),
// which is the check that refuses an outside path, and needs to look at paths
// the page has no grant for. That service checks every path against the app's
// app.json grants and acts inside an enforce of exactly those (fence_), so
// the page's list adds nothing to it. Every argument is read before the
// leave: page JS (a toString) never runs outside the grants. Used only by the
// sae_fs_* page-API functions (check_page_sandbox.sh).
leave_grants_(p: *Page) {
    if p.entry_depth > 0 { sandbox_pop() }
}

enter_grants_(p: *Page) {
    if p.entry_depth > 0 { sandbox_push(p.grants) }
}

// quickjs.eval, call and run_jobs, each as one timed entry.
js_eval_(p: *Page, code: string, filename: string) -> (int, string) {
    prev = entry_begin_(p)
    h, err = quickjs.eval(p.ctx, code, filename)
    entry_end_(p, prev)
    return h, err
}

js_call_(p: *Page, f: int, this_h: int, args: int) -> (int, string) {
    prev = entry_begin_(p)
    h, err = quickjs.call(p.ctx, f, this_h, args)
    entry_end_(p, prev)
    return h, err
}

js_run_jobs_(p: *Page) -> (int, string) {
    prev = entry_begin_(p)
    n, err = quickjs.run_jobs(p.ctx)
    entry_end_(p, prev)
    return n, err
}

// The conversions and property accesses that can run page JS, each timed.
// Host code calls these, never the quickjs.* they wrap.
js_get_(p: *Page, obj: int, name: string) -> (int, string) {
    prev = entry_begin_(p)
    h, err = quickjs.get(p.ctx, obj, name)
    entry_stopped_(p, prev, "property ${name}")
    return h, err
}

js_get_index_(p: *Page, obj: int, i: int) -> (int, string) {
    prev = entry_begin_(p)
    h, err = quickjs.get_index(p.ctx, obj, i)
    entry_stopped_(p, prev, "element ${i}")
    return h, err
}

js_set_(p: *Page, obj: int, name: string, v: int) -> string {
    prev = entry_begin_(p)
    err = quickjs.set(p.ctx, obj, name, v)
    entry_stopped_(p, prev, "setting property ${name}")
    return err
}

js_set_index_(p: *Page, obj: int, i: int, v: int) -> string {
    prev = entry_begin_(p)
    err = quickjs.set_index(p.ctx, obj, i, v)
    entry_stopped_(p, prev, "setting element ${i}")
    return err
}

js_get_global_(p: *Page, name: string) -> (int, string) {
    prev = entry_begin_(p)
    h, err = quickjs.get_global(p.ctx, name)
    entry_stopped_(p, prev, "global ${name}")
    return h, err
}

js_set_global_(p: *Page, name: string, v: int) {
    prev = entry_begin_(p)
    quickjs.set_global(p.ctx, name, v)
    entry_stopped_(p, prev, "setting global ${name}")
}

js_length_(p: *Page, obj: int) -> int {
    prev = entry_begin_(p)
    n = quickjs.length(p.ctx, obj)
    entry_stopped_(p, prev, "a length")
    return n
}

js_keys_(p: *Page, obj: int) -> int {
    prev = entry_begin_(p)
    k = quickjs.keys(p.ctx, obj)
    entry_stopped_(p, prev, "an object's keys")
    return k
}

js_to_json_(p: *Page, h: int) -> string {
    prev = entry_begin_(p)
    j = quickjs.to_json(p.ctx, h)
    entry_stopped_(p, prev, "a value as JSON")
    return j
}

js_to_int_(p: *Page, h: int) -> int {
    prev = entry_begin_(p)
    n = quickjs.to_int(p.ctx, h)
    entry_stopped_(p, prev, "a number")
    return n
}

js_to_float_(p: *Page, h: int) -> float {
    prev = entry_begin_(p)
    d = quickjs.to_float(p.ctx, h)
    entry_stopped_(p, prev, "a number")
    return d
}

js_to_bool_(p: *Page, h: int) -> int {
    prev = entry_begin_(p)
    b = quickjs.to_bool(p.ctx, h)
    entry_stopped_(p, prev, "a boolean")
    return b
}

js_to_string_(p: *Page, h: int) -> (string, string) {
    prev = entry_begin_(p)
    s, err = quickjs.to_string(p.ctx, h)
    entry_stopped_(p, prev, "a string")
    return s, err
}

engine_eval_(p: *Page, src: string, url: string) -> (int, string) {
    return js_eval_(p, src, url)
}

engine_dispose_(q: ptr) { quickjs.dispose(q) }

// A page-API function for page p's runtime q: the engine calls it with the
// runtime, and it hands f the page itself, so no function in the page API
// looks a page up (the page is the one its runtime was made for).
host_fn_(p: *Page, q: ptr, name: string, arity: int, f: @keep fn(*Page, int, int) -> int) -> int {
    return quickjs.function(q, name, arity, |c: ptr, this_h: int, args: int| {
        return f(p, this_h, args)
    })
}

// One page-API function: obj[name] calls the Aether function f.
reg_(p: *Page, q: ptr, obj: int, name: string, arity: int, f: @keep fn(*Page, int, int) -> int) {
    h = host_fn_(p, q, name, arity, f)
    _e = js_set_(p, obj, name, h)
    quickjs.release(q, h)
}

// One global page-API function: globalThis[name] calls the Aether function f.
glob_fn_(p: *Page, q: ptr, name: string, arity: int, f: @keep fn(*Page, int, int) -> int) {
    h = host_fn_(p, q, name, arity, f)
    js_set_global_(p, name, h)
    quickjs.release(q, h)
}

// ===== the gate: every name a page can reach, said once (docs/design/gate-dsl.md) =====
//
// gate_spec_ below is the spec; gate_register_ runs it for a page (G_REGISTER:
// each entry is installed through reg_/glob_fn_, the path every page-API
// function took before), and `sae --gate-describe` runs it once (G_DESCRIBE:
// one JSON line per entry on stdout, which tools/saegate turns into sae.d.ts
// and tests/check_gate.sh compares with the objects a page really sees).
// Nothing is generated: the blocks run. The shapes (docs/design/gate-dsl.md,
// "Step 0 findings"; tests/check_gate_probes.sh has each mechanic):
//
//   - `space(g, ...) { ... }`: a namespace; its return is the _ctx of its block.
//   - `api(name, host_fn, arity) { setters }`: one function in the namespace.
//     The function comes BEFORE the arity: a `@keep fn` as the last parameter
//     would take the trailing block for the closure.
//   - Every _ctx function that stores or returns its context takes `@keep ptr`.
//   - A `return` inside a spec block returns from the enclosing function, so
//     the spec never returns early.
//   - There is no end-of-block hook: a space or entry is finished when the next
//     one begins, or at gate_end_.
//   - The setters return at once unless the gate is describing. A space's
//     block holds only `reach`; an entry's holds the rest. Each context starts
//     with a tag and a setter refuses the wrong one.

const G_REGISTER = 0
const G_DESCRIBE = 1

// When a namespace exists for a page (the conditions api_register_ used).
const WHEN_ALWAYS = 0
const WHEN_APP_OR_WEB_SEEKS = 1 // not in p.absent
const WHEN_APP_SEEKS = 2 // not in p.absent, and an installed app
const WHEN_APP_SEEKS_EACH = 3 // an installed app that seeks at least one "<seek> <name>" it has and was not left out: sqlite's databases, natives' modules
const WHEN_PROBE = 4 // a test build with the sandbox probe on (SAE_SANDBOX_PROBE and AETHER_UI_TEST_PORT)
const WHEN_WRAPPED = 5 // a page that imports, or has a top-level await: its units take the loader object $sae

// The types the spec speaks of, named in the description for tools/saegate.
const T_VOID = 0
const T_STR = 1
const T_STR_NULL = 2
const T_NUM = 3
const T_ANY = 4
const T_DELAY = 5
const T_TIMER = 6
const T_FRAME = 7
const T_FN = 8
const T_FRAME_FN = 9
const T_INT = 10 // a number the host reads as an int (ToInt32); as a result, a number
const T_FLAG = 11 // a boolean or a number in; a number out (get_toggle)
const T_WIDGET = 12 // a widget handle the page made
const T_VGNODE = 13 // a vg scene, group or shape handle
const T_GRID = 14 // a datagrid handle: not a widget
const T_BLOCK = 15 // a function called now, with the new thing as the current parent
const T_LEAD_NUM = 16 // a number that a function may stand in for (and so be left out)
const T_LEAD_NODE = 17 // a vg handle that may be left out inside a shape's block
const T_BYTES = 18 // a Uint8Array or Uint8ClampedArray
const T_POINTS = 19 // "x,y x,y" or a flat array of numbers
const T_STR_NUM = 20 // a string or a number, read as a string
const T_OBJ = 21 // an object
const T_RAW = 22 // a result whose TypeScript the entry gives (gives_ts)
const T_BOOL = 23 // a boolean result
const T_HANDLE = 24 // a widget, or a vg scene or shape (or 0, the whole page)

// What `value` takes its string from, when a page is registered.
const V_PAGE_URL = 1
const V_EACH_NAME = 2 // in a space_each: the name of the object it is set on (sqlite.<db>.__db)


// http.fetch(url or options): the same request as a promise of the same
// response object, for `await`. It runs on the same actors; the promise
// resolves where a callback would have run.
const HTTP_FETCH_JS = "http.fetch = function (o) { return new Promise(function (resolve) { if (typeof o === 'string') http.get(o, resolve); else http.request(o, resolve); }); };"

// The JavaScript that takes each hidden __sae_* object of a wrapped namespace,
// makes the object the page sees out of it and deletes it, so a page has only
// `documents`, `clipboard`, `bus` and `backend`, all of it promises or plain
// functions of the page's own.
const DOCUMENTS_JS = "globalThis.documents = (function (raw) { const handle = function (h) { if (!h) return null; const d = { name: raw.name(h), read_text: function () { return Promise.resolve().then(function () { return raw.read(h); }); }, write_text: function (t) { return Promise.resolve().then(function () { raw.write(h, String(t)); }); }, read_base64: function () { return Promise.resolve().then(function () { return raw.read64(h); }); }, write_base64: function (t) { return Promise.resolve().then(function () { raw.write64(h, String(t)); }); } }; Object.defineProperty(d, Symbol.for('sae.document'), { value: h }); return Object.freeze(d); }; return Object.freeze({ pick_open: function (title) { return Promise.resolve().then(function () { return handle(raw.open(title === undefined ? 'Open' : String(title))); }); }, pick_save: function (name) { return Promise.resolve().then(function () { return handle(raw.save(name === undefined ? '' : String(name))); }); } }); })(globalThis.__sae_documents); delete globalThis.__sae_documents;"
const CLIPBOARD_JS = "globalThis.clipboard = (function (raw) { return Object.freeze({ write_text: function (t) { return Promise.resolve().then(function () { raw.write(String(t)); }); }, read_text: function () { return Promise.resolve().then(function () { return raw.read(); }); } }); })(globalThis.__sae_clipboard); delete globalThis.__sae_clipboard;"
const BUS_JS = "globalThis.bus = (function (raw) { return Object.freeze({ serve: function (fn, stopped) { if (typeof fn !== 'function') throw new TypeError('bus.serve(fn): fn must be a function'); if (stopped !== undefined && typeof stopped !== 'function') throw new TypeError('bus.serve(fn, stopped): stopped must be a function'); raw.serve(function (id, command) { Promise.resolve().then(function () { return fn(command); }).then(function (r) { raw.answer(id, 1, JSON.stringify(r === undefined ? null : r), ''); }, function (e) { raw.answer(id, 0, '', String(e && e.message !== undefined ? e.message : e)); }); }, stopped === undefined ? undefined : function (reason) { return stopped(String(reason)); }); return Promise.resolve(); }, stop: function () { raw.stop(); } }); })(globalThis.__sae_bus); delete globalThis.__sae_bus;"
const BACKEND_JS = "globalThis.backend = (function (raw) { var waiting = {}; var handlers = {}; var gone = []; var doc_key = Symbol.for('sae.document'); raw.listen(function (kind, id, ok, name, payload) { if (kind === 0 || kind === 3) { var w = waiting[id]; if (w === undefined) return; delete waiting[id]; if (ok) w.resolve(kind === 3 ? undefined : payload); else w.reject(new Error(payload)); } else if (kind === 1) { var h = handlers[name]; if (h !== undefined) h(payload); } else { for (var i = 0; i < gone.length; i++) gone[i](payload); } }); return Object.freeze({ invoke: function (name, arg, doc) { if (typeof name !== 'string') throw new TypeError('backend.invoke(name, arg, doc): name must be a string'); var a = arg === undefined ? '' : String(arg); var dh = 0; if (doc !== undefined && doc !== null) { dh = doc[doc_key]; if (typeof dh !== 'number' || dh < 1) throw new TypeError('backend.invoke(name, arg, doc): doc must be a document documents gave'); } return new Promise(function (resolve, reject) { var id = raw.call(name, a, dh); if (id <= 0) { reject(new Error(raw.why())); return; } waiting[id] = { resolve: resolve, reject: reject }; }); }, on: function (name, fn) { if (typeof name !== 'string' || typeof fn !== 'function') throw new TypeError('backend.on(name, fn): a name and a function'); handlers[name] = function (d) { return fn(d); }; }, on_gone: function (fn) { if (typeof fn !== 'function') throw new TypeError('backend.on_gone(fn): fn must be a function'); gone.push(function (why) { return fn(String(why)); }); }, running: function () { return raw.why() === ''; }, restart: function () { return new Promise(function (resolve, reject) { waiting[raw.restart()] = { resolve: resolve, reject: reject }; }); } }); })(globalThis.__sae_backend); delete globalThis.__sae_backend;"

const GATE_TAG_SPACE = 71
const GATE_TAG_ENTRY = 72

struct Gate {
    mode: int
    p: ptr // the page being registered; null when describing
    sp: ptr // the one GateSpace, reused by every space
    en: ptr // the one GateEntry, reused by every entry
}

struct GateSpace {
    tag: int
    g: ptr
    on: int // installed for this page
    obj: int // the JS object of an installed space
    cond: int
    each: int // an object for each name the page gets (sqlite.<db>), the entries registered on each
    names: string // the names of an each space or an each-conditioned one, as ",a,b,"
    objs: ptr // a list of the JS objects of an each space, in the order of names
    raw: int // a hidden object a wrapper takes (__sae_documents): its entries are not page-visible
    has_obj: int // has an object of its own (a provided_space has not: its members are JavaScript's)
    name: string // describing only
    seek: string
    reach: string
}

struct GateEntry {
    tag: int
    s: ptr
    open: int // describing: an entry begun and not yet printed
    kind: string
    name: string
    arity: int
    params: ptr // a strbuilder of the params' JSON
    gives: int
    ts: string // the TypeScript of a T_RAW result
    sigs: string // describing: TypeScript signatures that replace the generated one (signature)
    promise: int
    doc: string
    internal: int
}

gate_new_(mode: int, p: @keep ptr) -> *Gate {
    g = heap.new(Gate)
    sp = heap.new(GateSpace)
    en = heap.new(GateEntry)
    g.mode = mode
    g.p = p
    g.sp = sp
    g.en = en
    sp.tag = GATE_TAG_SPACE
    sp.g = g
    en.tag = GATE_TAG_ENTRY
    en.s = sp
    return g
}

gate_type_name_(t: int) -> string {
    if t == T_STR { return "str" }
    if t == T_STR_NULL { return "str_or_null" }
    if t == T_NUM { return "num" }
    if t == T_ANY { return "any" }
    if t == T_DELAY { return "delay" }
    if t == T_TIMER { return "timer" }
    if t == T_FRAME { return "frame" }
    if t == T_FN { return "fn" }
    if t == T_FRAME_FN { return "frame_fn" }
    if t == T_INT { return "int" }
    if t == T_FLAG { return "flag" }
    if t == T_WIDGET { return "widget" }
    if t == T_VGNODE { return "vgnode" }
    if t == T_GRID { return "grid" }
    if t == T_BLOCK { return "block" }
    if t == T_LEAD_NUM { return "lead_num" }
    if t == T_LEAD_NODE { return "lead_node" }
    if t == T_BYTES { return "bytes" }
    if t == T_POINTS { return "points" }
    if t == T_STR_NUM { return "str_num" }
    if t == T_OBJ { return "obj" }
    if t == T_RAW { return "raw" }
    if t == T_BOOL { return "bool" }
    if t == T_HANDLE { return "handle" }
    return "void"
}

when_name_(w: int) -> string {
    if w == WHEN_APP_OR_WEB_SEEKS { return "app_or_web_seeks" }
    if w == WHEN_APP_SEEKS { return "app_seeks" }
    if w == WHEN_APP_SEEKS_EACH { return "app_seeks_each" }
    if w == WHEN_PROBE { return "probe" }
    if w == WHEN_WRAPPED { return "wrapped" }
    return "always"
}

// A string as a JSON string literal (the spec's text has quotes and
// backslashes at most).
gate_json_(s: string) -> string {
    out = string.string_replace_all(s, "\\", "\\\\")
    out = string.string_replace_all(out, "\"", "\\\"")
    out = string.string_replace_all(out, "\n", "\\n")
    return "\"${out}\""
}

// The entry begun, as one JSON line, then forgotten.
gate_flush_(g: *Gate) {
    e = g.en as *GateEntry
    if e.open == 0 { return }
    s = g.sp as *GateSpace
    pj = strbuilder.finish(e.params)
    line = "{\"kind\":${gate_json_(e.kind)},\"space\":${gate_json_(s.name)},\"when\":${gate_json_(when_name_(s.cond))},\"seek\":${gate_json_(s.seek)},\"each\":${s.each},\"reach\":${gate_json_(s.reach)},\"name\":${gate_json_(e.name)},\"arity\":${e.arity},\"params\":[${pj}],\"gives\":${gate_json_(gate_type_name_(e.gives))},\"ts\":${gate_json_(e.ts)},\"sigs\":${gate_json_(e.sigs)},\"promise\":${e.promise},\"doc\":${gate_json_(e.doc)},\"internal\":${e.internal}}\n"
    fputs(line, sae_stdout())
    e.open = 0
}

gate_begin_(g: *Gate, kind: string, name: string, arity: int) -> *GateEntry {
    e = g.en as *GateEntry
    e.open = 1
    e.kind = own_(kind)
    e.name = own_(name)
    e.arity = arity
    e.params = strbuilder.new(64)
    e.gives = T_VOID
    e.ts = ""
    e.sigs = ""
    e.promise = 0
    e.doc = ""
    e.internal = 0
    return e
}

// Finish the space in hand: its entries are all printed, its object released.
gate_close_space_(g: *Gate) {
    gate_flush_(g)
    s = g.sp as *GateSpace
    if s.objs != null {
        n = list.size(s.objs)
        i = 0
        while i < n {
            ov, _ = list.get(s.objs, i)
            quickjs.release((g.p as *Page).ctx, mem.ptr_to_long(ov))
            i = i + 1
        }
        list.free(s.objs)
        s.objs = null
    }
    if s.obj != 0 {
        quickjs.release((g.p as *Page).ctx, s.obj)
        s.obj = 0
    }
    s.on = 0
    s.each = 0
    s.names = ""
    if g.mode == G_DESCRIBE {
        s.name = ""
        s.seek = ""
        s.reach = ""
        s.cond = WHEN_ALWAYS
    }
}

// The names an each-conditioned space is for, as ",a,b,": the databases the
// page gets (seek "database") or the native modules (seek "native").
gate_each_names_(p: *Page, seek: string) -> string {
    if seek == "database" { return sqlite_page_dbs_(p) }
    out = natives_page_mods_(p)
    p.natives_set = own_(out)
    return out
}

// The JavaScript of the page's natives object (natives_js_), for the page being registered.
gate_natives_js_(g: *Gate) -> string {
    if g.mode == G_DESCRIBE { return "" }
    p = g.p as *Page
    return natives_js_(browser_of_(p).native_jobs, p.natives_set)
}

gate_end_(g: *Gate) {
    gate_close_space_(g)
    heap.free(g.en)
    heap.free(g.sp)
    heap.free(g)
}

// The namespace in hand, begun. Registering, it decides whether this page
// has it (as api_register_ did) and, if it has an object (has_obj), makes the
// object and its global; describing, it is on for every page, whatever the
// page's grants.
gate_space_(g: *Gate, name: string, cond: int, seek: string, raw: int, has_obj: int, each: int) -> ptr {
    gate_close_space_(g)
    s = g.sp as *GateSpace
    s.on = 1
    s.cond = cond
    s.raw = raw
    s.has_obj = has_obj
    s.each = each
    if g.mode == G_REGISTER {
        p = g.p as *Page
        if cond == WHEN_APP_SEEKS_EACH {
            s.names = own_(gate_each_names_(p, seek))
            if s.names == "," { s.on = 0 }
        } else if cond == WHEN_PROBE {
            if browser_of_(p).probe_dir == "" { s.on = 0 }
        } else if cond == WHEN_WRAPPED {
            if p.imports == "" && p.wrapped == 0 { s.on = 0 }
        } else if cond != WHEN_ALWAYS && string.contains(p.absent, ",${seek},") == 1 { s.on = 0 }
        if cond == WHEN_APP_SEEKS && browser_of_(p).app_dir == "" { s.on = 0 }
        if s.on == 1 && has_obj == 1 {
            s.obj = quickjs.new_object(p.ctx)
            js_set_global_(p, name, s.obj)
            if each == 1 { gate_each_objects_(s, p) }
        }
    } else {
        s.name = own_(name)
        s.seek = own_(seek)
    }
    return s
}

// An object for each name of s.names, each in s.obj under its name.
gate_each_objects_(s: *GateSpace, p: *Page) {
    s.objs = list.new()
    parts = string.split(s.names, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.string_array_get(parts, i)
        i = i + 1
        if nm == "" { continue }
        o = quickjs.new_object(p.ctx)
        _e = js_set_(p, s.obj, nm, o)
        list.add(s.objs, mem.long_to_ptr(o))
    }
}

// A namespace of the page: an object, and the global that names it.
space(_ctx: @keep ptr, g: *Gate, name: string, cond: int, seek: string) -> ptr {
    return gate_space_(g, name, cond, seek, 0, 1, 0)
}

// A namespace with an object for each name the page gets (sqlite: one per
// database), under the global. Its entries are registered on every one of
// them. `seek` is the kind of the page's "seeks <seek> <name>" lines
// ("database"); the names come from what the page seeks, the app has and
// was not left out.
space_each(_ctx: @keep ptr, g: *Gate, name: string, seek: string) -> ptr {
    return gate_space_(g, name, WHEN_APP_SEEKS_EACH, seek, 0, 1, 1)
}

// The sandbox probe's object (tests only): there only in a build that
// has the probe switched on. All its entries are internal: it is never in sae.d.ts.
test_space(_ctx: @keep ptr, g: *Gate, name: string) -> ptr {
    return gate_space_(g, name, WHEN_PROBE, "", 0, 1, 0)
}

// The hidden object a wrapper takes and deletes (__sae_documents): made and
// registered like a space, but the page never sees it, so it is not part of
// what the page is held to. A js_wrapper in its block makes the object the
// page does see; a provided_space after it describes that.
raw_space(_ctx: @keep ptr, g: *Gate, name: string, cond: int, seek: string) -> ptr {
    return gate_space_(g, name, cond, seek, 1, 1, 0)
}

// A namespace whose object JavaScript makes (documents, from a wrapper): it
// makes nothing, and its provided members are what the page is held to.
provided_space(_ctx: @keep ptr, g: *Gate, name: string, cond: int, seek: string) -> ptr {
    return gate_space_(g, name, cond, seek, 0, 0, 0)
}

// One function of the space: obj[name] calls f, `arity` its .length.
api(_ctx: @keep ptr, name: string, f: @keep fn(*Page, int, int) -> int, arity: int) -> ptr {
    gate_check_(_ctx, GATE_TAG_SPACE, "api")
    s = _ctx as *GateSpace
    if s.has_obj == 0 { gate_wrong_ctx_("api in a provided_space") }
    g = s.g as *Gate
    gate_flush_(g)
    if g.mode == G_REGISTER {
        if s.on == 1 {
            p = g.p as *Page
            if s.each == 1 {
                n = list.size(s.objs)
                i = 0
                while i < n {
                    ov, _ = list.get(s.objs, i)
                    reg_(p, p.ctx, mem.ptr_to_long(ov), name, arity, f)
                    i = i + 1
                }
            } else {
                reg_(p, p.ctx, s.obj, name, arity, f)
            }
        }
        return g.en
    }
    if s.raw == 1 { return gate_begin_(g, "raw", name, arity) }
    return gate_begin_(g, "fn", name, arity)
}

// A bare global function: globalThis[name] calls f.
global_fn(_ctx: @keep ptr, g: *Gate, name: string, f: @keep fn(*Page, int, int) -> int, arity: int) -> ptr {
    gate_close_space_(g)
    if g.mode == G_REGISTER {
        p = g.p as *Page
        glob_fn_(p, p.ctx, name, arity, f)
        return g.en
    }
    return gate_begin_(g, "global", name, arity)
}

// A bare global function that the prelude's JavaScript provides (state):
// nothing is registered, but the page sees it.
provided_global(_ctx: @keep ptr, g: *Gate, name: string, arity: int) -> ptr {
    gate_close_space_(g)
    if g.mode == G_REGISTER { return g.en }
    return gate_begin_(g, "provided_global", name, arity)
}

// A builtin's member the page API replaces: global[name] calls f (Date.now).
patch(_ctx: @keep ptr, g: *Gate, global: string, name: string, f: @keep fn(*Page, int, int) -> int, arity: int) -> ptr {
    gate_close_space_(g)
    if g.mode == G_REGISTER {
        p = g.p as *Page
        d, _e = js_get_global_(p, global)
        reg_(p, p.ctx, d, name, arity, f)
        quickjs.release(p.ctx, d)
        return g.en
    }
    s = g.sp as *GateSpace
    s.name = own_(global)
    return gate_begin_(g, "patch", name, arity)
}

// A readonly string property of the space, which is not a function: what
// the page is told, as `src` names it (V_PAGE_URL).
value(_ctx: @keep ptr, name: string, t: int, src: int) {
    gate_value_(_ctx, name, t, src, 0)
}

// A value that is page-reachable and not part of its documented surface.
internal_value(_ctx: @keep ptr, name: string, t: int, src: int) {
    gate_value_(_ctx, name, t, src, 1)
}

gate_value_(_ctx: @keep ptr, name: string, t: int, src: int, internal: int) {
    s = _ctx as *GateSpace
    g = s.g as *Gate
    gate_flush_(g)
    if g.mode == G_REGISTER {
        if s.on == 1 {
            p = g.p as *Page
            if src == V_EACH_NAME {
                parts = string.split(s.names, ",")
                np = string.string_array_size(parts)
                k = 0
                j = 0
                while k < np {
                    nm = string.string_array_get(parts, k)
                    k = k + 1
                    if nm == "" { continue }
                    ov, _ = list.get(s.objs, j)
                    j = j + 1
                    h = quickjs.new_string(p.ctx, nm)
                    _e = js_set_(p, mem.ptr_to_long(ov), name, h)
                    quickjs.release(p.ctx, h)
                }
            } else {
                v = ""
                if src == V_PAGE_URL { v = p.url }
                h = quickjs.new_string(p.ctx, v)
                _e = js_set_(p, s.obj, name, h)
                quickjs.release(p.ctx, h)
            }
        }
        return
    }
    e = gate_begin_(g, "value", name, 0)
    e.gives = t
    e.internal = internal
    gate_flush_(g)
}

// A function of the space that the page's JavaScript provides (src/sae_prelude.js,
// a wrapper): no host function, nothing registered, but it is on the object a
// page sees, so the spec says it, and tests/check_gate.sh holds the page to it.
provided(_ctx: @keep ptr, name: string, arity: int) -> ptr {
    s = _ctx as *GateSpace
    g = s.g as *Gate
    gate_flush_(g)
    if g.mode == G_REGISTER { return g.en }
    return gate_begin_(g, "provided", name, arity)
}

// A member of the space that the page's JavaScript provides and that is not a
// function (vg.easings, an object): of type t (T_OBJ, T_STR, T_NUM).
provided_value(_ctx: @keep ptr, name: string, t: int) {
    s = _ctx as *GateSpace
    g = s.g as *Gate
    gate_flush_(g)
    if g.mode == G_REGISTER { return }
    e = gate_begin_(g, "provided_value", name, 0)
    e.gives = t
    gate_flush_(g)
}

// A namespace whose members are the names the page gets, made by JavaScript
// (natives: natives.<module>.<function>): an object of objects of functions
// that each have `arity` parameters, `ts` its TypeScript type. Nothing is
// registered and no member is described: the live check holds the shape.
provided_dynamic(_ctx: @keep ptr, g: *Gate, name: string, seek: string, arity: int, ts: string) -> ptr {
    _s = gate_space_(g, name, WHEN_APP_SEEKS_EACH, seek, 0, 0, 0)
    if g.mode == G_REGISTER { return g.en }
    e = gate_begin_(g, "dynamic", name, arity)
    e.ts = own_(ts)
    e.gives = T_RAW
    return e
}

// A function of the module loader that the page's units see: `$sae.m`, which
// a unit's wrapper takes. Kept on the page (p.mod_get), for every page, and
// described in the space `$sae`, which only a wrapped page has (WHEN_WRAPPED).
// Always internal.
loader_fn(_ctx: @keep ptr, g: *Gate, name: string, f: @keep fn(*Page, int, int) -> int, arity: int) -> ptr {
    gate_close_space_(g)
    if g.mode == G_REGISTER {
        p = g.p as *Page
        p.mod_get = host_fn_(p, p.ctx, name, arity, f)
        return g.en
    }
    s = g.sp as *GateSpace
    s.name = own_("$sae")
    s.cond = WHEN_WRAPPED
    e = gate_begin_(g, "loader", name, arity)
    e.internal = 1
    return e
}

// A host function the engine is given and a page cannot name (the handler of
// a rejected top-level await, p.mod_fail): kept on the page, for every page.
held_fn(_ctx: @keep ptr, g: *Gate, name: string, f: @keep fn(*Page, int, int) -> int, arity: int) -> ptr {
    gate_close_space_(g)
    if g.mode == G_REGISTER {
        p = g.p as *Page
        p.mod_fail = host_fn_(p, p.ctx, name, arity, f)
        return g.en
    }
    e = gate_begin_(g, "held", name, arity)
    e.internal = 1
    return e
}

// JavaScript the page's runtime evaluates over the space's functions, once they
// are registered (a wrapper that puts promises over host callbacks): `source`
// as unit `name`. Nothing when the space is not installed for this page, or
// when describing. What the JavaScript adds is said with provided().
js_wrapper(_ctx: @keep ptr, name: string, source: string) {
    s = _ctx as *GateSpace
    g = s.g as *Gate
    gate_flush_(g)
    if g.mode == G_REGISTER && s.on == 1 {
        p = g.p as *Page
        r, _e = js_eval_(p, source, name)
        quickjs.release(p.ctx, r)
    }
}

// What a space's functions may reach beyond the shared helpers (recorded
// now; the seal check of a later step reads it).
reach(_ctx: ptr, what: string) {
    gate_check_(_ctx, GATE_TAG_SPACE, "reach")
    s = _ctx as *GateSpace
    if (s.g as *Gate).mode == G_DESCRIBE { s.reach = own_(what) }
}

gate_wrong_ctx_(setter: string) {
    fputs("sae: gate spec: ${setter} used in the wrong block\n", sae_stderr())
    exit(3)
}

// Refuse a setter used in the wrong kind of block (the tag is each context's
// first field).
gate_check_(_ctx: ptr, tag: int, setter: string) {
    t = _ctx as *GateEntry
    if t.tag != tag { gate_wrong_ctx_(setter) }
}

gate_of_(e: *GateEntry) -> *Gate {
    s = e.s as *GateSpace
    return s.g as *Gate
}

gate_param_(e: *GateEntry, kind: string, name: string, t: string) {
    if gate_of_(e).mode != G_DESCRIBE { return }
    sep = ""
    if strbuilder.length(e.params) > 0 { sep = "," }
    _a = strbuilder.append(e.params, "${sep}{\"k\":${gate_json_(kind)},\"n\":${gate_json_(name)},\"t\":${gate_json_(t)}}")
}

// A required argument.
arg(_ctx: ptr, name: string, t: int) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "arg")
    e = _ctx as *GateEntry
    gate_param_(e, "arg", name, gate_type_name_(t))
}

// An argument a page may leave out.
opt(_ctx: ptr, name: string, t: int) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "opt")
    e = _ctx as *GateEntry
    gate_param_(e, "opt", name, gate_type_name_(t))
}

// An argument of a type the spec has no name for: its TypeScript, as text.
arg_ts(_ctx: ptr, name: string, ts: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "arg_ts")
    e = _ctx as *GateEntry
    gate_param_(e, "arg", name, "ts:${ts}")
}

opt_ts(_ctx: ptr, name: string, ts: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "opt_ts")
    e = _ctx as *GateEntry
    gate_param_(e, "opt", name, "ts:${ts}")
}

// An argument the host reads past the arity (a block that text(label, block)
// takes, with a .length of 1): optional, and not counted in the arity.
beyond(_ctx: ptr, name: string, t: int) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "beyond")
    e = _ctx as *GateEntry
    gate_param_(e, "beyond", name, gate_type_name_(t))
}

beyond_ts(_ctx: ptr, name: string, ts: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "beyond_ts")
    e = _ctx as *GateEntry
    gate_param_(e, "beyond", name, "ts:${ts}")
}

// The rest parameter: more arguments, past the arity.
rest(_ctx: ptr, name: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "rest")
    e = _ctx as *GateEntry
    gate_param_(e, "rest", name, "any")
}

gives(_ctx: ptr, t: int) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "gives")
    e = _ctx as *GateEntry
    e.gives = t
}

// A result no spec type says: its TypeScript, as text ("[number, number]").
gives_ts(_ctx: ptr, ts: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "gives_ts")
    e = _ctx as *GateEntry
    e.gives = T_RAW
    if gate_of_(e).mode == G_DESCRIBE { e.ts = own_(ts) }
}

// The TypeScript of the entry from its type parameters on, instead of the one
// made from its params: "<T>(initial: T): State<T>". One call per overload.
signature(_ctx: ptr, ts: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "signature")
    e = _ctx as *GateEntry
    if gate_of_(e).mode == G_DESCRIBE {
        if e.sigs != "" { e.sigs = own_("${e.sigs}\n${ts}") } else { e.sigs = own_(ts) }
    }
}

gives_promise(_ctx: ptr, t: int) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "gives_promise")
    e = _ctx as *GateEntry
    e.gives = t
    e.promise = 1
}

doc(_ctx: ptr, text: string) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "doc")
    e = _ctx as *GateEntry
    if gate_of_(e).mode == G_DESCRIBE { e.doc = own_(text) }
}

// Reachable from a page but not part of its documented surface.
internal(_ctx: ptr) {
    gate_check_(_ctx, GATE_TAG_ENTRY, "internal")
    e = _ctx as *GateEntry
    e.internal = 1
}

// ===== the spec =====
gate_spec_(g: *Gate) {
    // ui: the widgets (README "The ui object"). A builder takes its block last
    // and returns its widget's handle; a modifier works inside a block.
    space(g, "ui", WHEN_ALWAYS, "") {
        api("vstack", sae_ui_vstack, 2) {
            arg("spacing", T_LEAD_NUM)
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A column under the current parent; body runs with it as the parent.")
        }
        api("hstack", sae_ui_hstack, 2) {
            arg("spacing", T_LEAD_NUM)
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A row under the current parent; body runs with it as the parent.")
        }
        api("wrap", sae_ui_wrap, 1) {
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A flow container: left to right, onto the next line when the width runs out.")
        }
        api("grid", sae_ui_grid, 3) {
            arg("cols", T_INT)
            arg("spacing", T_LEAD_NUM)
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A grid of cols (1 to 64) columns, filled a row at a time by the block's widgets.")
        }
        api("equal_cells", sae_ui_equal_cells, 0) {
            doc("In a grid's block: one width per column and one height per row, for all.")
        }
        api("text", sae_ui_text, 1) {
            arg("s", T_STR)
            beyond("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A label; text(s, body) takes a block that styles it.")
        }
        api("btn", sae_ui_btn, 2) {
            arg("label", T_STR)
            arg_ts("onPress", "() => void")
            gives(T_WIDGET)
            doc("A button that calls onPress when pressed.")
        }
        api("divider", sae_ui_divider, 0) {
            gives(T_WIDGET)
            doc("A thin dividing line.")
        }
        api("button", sae_ui_button, 2) {
            arg("label", T_STR)
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A button whose block styles it (onclick inside the block handles the press).")
        }
        api("scroll", sae_ui_scroll, 1) {
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A scrolling area holding the block's widgets in a column.")
        }
        api("spacer", sae_ui_spacer, 0) {
            gives(T_WIDGET)
            doc("Flexible empty space.")
        }
        api("textfield", sae_ui_textfield, 2) {
            arg("placeholder", T_STR)
            opt("body", T_BLOCK)
            gives(T_WIDGET)
            doc("A one-line text field; its block runs with it on top (onchange, onsubmit, onfocuschange).")
        }
        api("securefield", sae_ui_securefield, 2) {
            arg("placeholder", T_STR)
            opt_ts("onChange", "(text: string) => void")
            gives(T_WIDGET)
            doc("A text field that does not show its text (a password); get_text reads it.")
        }
        api("get_text", sae_ui_get_text, 1) {
            arg("h", T_WIDGET)
            gives(T_STR)
            doc("The text of a label, field or button the page made.")
        }
        api("set_text", sae_ui_set_text, 2) {
            arg("h", T_WIDGET)
            arg("s", T_STR)
            doc("Sets the text of a label, field or button the page made.")
        }
        api("clear", sae_ui_clear, 1) {
            arg("h", T_WIDGET)
            doc("Empties a vstack, hstack or grid the page made.")
        }
        api("into", sae_ui_into, 2) {
            arg("h", T_WIDGET)
            arg("body", T_BLOCK)
            gives(T_WIDGET)
            doc("Builds into a vstack, hstack or grid the page made again.")
        }
        api("toggle", sae_ui_toggle, 2) {
            arg("label", T_STR)
            arg_ts("onChange", "(on: number) => void")
            gives(T_WIDGET)
            doc("A labelled check box; onChange(on) with 1 or 0.")
        }
        api("slider", sae_ui_slider, 4) {
            arg("min", T_NUM)
            arg("max", T_NUM)
            arg("initial", T_NUM)
            arg_ts("onChange", "(v: number) => void")
            gives(T_WIDGET)
            doc("A slider from min to max; onChange(v) as it moves.")
        }
        api("scrollbar", sae_ui_scrollbar, 6) {
            arg("vertical", T_FLAG)
            arg("min", T_NUM)
            arg("max", T_NUM)
            arg("page", T_NUM)
            arg("value", T_NUM)
            arg_ts("onChange", "(v: number) => void")
            gives(T_WIDGET)
            doc("A windowing slider: the thumb is the window, page of max - min; value is the window's start.")
        }
        api("set_scrollbar", sae_ui_set_scrollbar, 5) {
            arg("h", T_WIDGET)
            arg("min", T_NUM)
            arg("max", T_NUM)
            arg("page", T_NUM)
            arg("value", T_NUM)
            doc("Reconfigures a scrollbar without calling its onChange.")
        }
        api("scrollbar_steps", sae_ui_scrollbar_steps, 3) {
            arg("h", T_WIDGET)
            arg("step", T_NUM)
            opt("pageStep", T_NUM)
            doc("The distances of a step and of a page step on a scrollbar.")
        }
        api("get_scrollbar", sae_ui_get_scrollbar, 1) {
            arg("h", T_WIDGET)
            gives(T_NUM)
            doc("A scrollbar's value.")
        }
        api("scrollbar_range", sae_ui_scrollbar_range, 1) {
            arg("h", T_WIDGET)
            gives_ts("[number, number, number]")
            doc("[min, max, page] of a scrollbar.")
        }
        api("context_menu", sae_ui_context_menu, 2) {
            arg("target", T_HANDLE)
            arg_ts("items", "Array<\"-\" | { label: string; accel?: string; enabled?: boolean; action?: () => void }>")
            doc("What a right click (a long press) on a widget, a vg shape, or 0 (the page) offers; items are read again each time the menu opens.")
        }
        api("picker", sae_ui_picker, 1) {
            arg_ts("onChange", "(i: number) => void")
            gives(T_WIDGET)
            doc("A drop-down; onChange(i) with the chosen index.")
        }
        api("picker_add", sae_ui_picker_add, 2) {
            arg("h", T_WIDGET)
            arg("item", T_STR)
            doc("Adds an item to a picker.")
        }
        api("progressbar", sae_ui_progressbar, 1) {
            arg("f", T_NUM)
            gives(T_WIDGET)
            doc("A progress bar at fraction f (0 to 1).")
        }
        api("set_progress", sae_ui_set_progress, 2) {
            arg("h", T_WIDGET)
            arg("f", T_NUM)
            doc("Sets a progress bar's fraction.")
        }
        api("set_toggle", sae_ui_set_toggle, 2) {
            arg("h", T_WIDGET)
            arg("on", T_FLAG)
            doc("Checks or unchecks a toggle.")
        }
        api("get_toggle", sae_ui_get_toggle, 1) {
            arg("h", T_WIDGET)
            gives(T_INT)
            doc("1 when a toggle is checked, else 0.")
        }
        api("set_slider", sae_ui_set_slider, 2) {
            arg("h", T_WIDGET)
            arg("v", T_NUM)
            doc("Moves a slider.")
        }
        api("get_slider", sae_ui_get_slider, 1) {
            arg("h", T_WIDGET)
            gives(T_NUM)
            doc("A slider's value.")
        }
        api("styles", sae_ui_styles, 1) {
            arg("sheet", T_OBJ)
            doc("Applies a style sheet to the page's widgets (README, \"Styles\").")
        }
        api("add_class", sae_ui_add_class, 2) {
            arg("h", T_WIDGET)
            arg("name", T_STR)
            doc("Gives a widget a style class.")
        }
        api("style_id", sae_ui_style_id, 2) {
            arg("h", T_WIDGET)
            arg("name", T_STR)
            doc("Gives a widget a style id.")
        }
        api("timer", sae_ui_timer, 2) {
            arg("ms", T_INT)
            arg("fn", T_FN)
            gives(T_TIMER)
            doc("Calls fn every ms milliseconds (10 at least) until timer_cancel.")
        }
        api("set_visible", sae_ui_set_visible, 2) {
            arg("h", T_WIDGET)
            arg("on", T_FLAG)
            doc("Shows or hides a widget, keeping it and its timers and scenes alive.")
        }
        api("timer_cancel", sae_ui_timer_cancel, 1) {
            opt("id", T_TIMER)
            doc("Stops a timer (or setTimeout, setInterval); another id, or none, is ignored.")
        }
        api("after", sae_ui_after, 2) {
            arg("ms", T_DELAY)
            arg("fn", T_FN)
            gives(T_TIMER)
            doc("Calls fn once, ms milliseconds from now.")
        }
        api("sleep", sae_ui_sleep, 1) {
            arg("ms", T_DELAY)
            gives_promise(T_VOID)
            doc("A promise that settles after ms milliseconds.")
        }
        api("frame", sae_request_frame, 1) {
            arg("fn", T_FRAME_FN)
            gives(T_FRAME)
            doc("Calls fn(timestamp) on the next display frame (requestAnimationFrame).")
        }
        api("frame_cancel", sae_cancel_frame, 1) {
            opt("id", T_FRAME)
            doc("Cancels a frame callback; another id is ignored.")
        }
        api("onclick", sae_ui_onclick, 1) {
            arg("fn", T_FN)
            doc("In a widget's block: fn() when it is clicked.")
        }
        api("on_double_click", sae_ui_on_double_click, 2) {
            arg("h", T_WIDGET)
            arg("fn", T_FN)
            doc("fn() on a widget's double click (a double tap on touch).")
        }
        api("margin", sae_ui_margin, 4) {
            arg("top", T_INT)
            opt("right", T_INT)
            opt("bottom", T_INT)
            opt("left", T_INT)
            doc("In a container's block: its margins in px; with one argument, on all sides.")
        }
        api("bg_color", sae_ui_bg_color, 4) {
            arg("r", T_NUM)
            arg("g", T_NUM)
            arg("b", T_NUM)
            opt("a", T_NUM)
            doc("In a widget's block: its background colour, components from 0 to 1.")
        }
        api("ui_state", sae_ui_state, 1) {
            arg("v", T_NUM)
            gives(T_INT)
            doc("A numeric cell for text_bound and ui_set; the reactive state() is the better way.")
        }
        api("ui_set", sae_ui_set, 2) {
            arg("state", T_INT)
            arg("v", T_NUM)
            doc("Sets a numeric cell.")
        }
        api("text_bound", sae_ui_text_bound, 3) {
            arg("state", T_INT)
            arg("prefix", T_STR)
            arg("suffix", T_STR)
            gives(T_WIDGET)
            doc("A label showing a numeric cell between prefix and suffix.")
