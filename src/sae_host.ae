// --- the page API: context menus ---
//
//   ui.context_menu(target, [
//     { label: "Copy", accel: "Ctrl+C", action: () => copy() },
//     "-",                                         // a separator
//     { label: "Paste", enabled: false },          // shown grey
//   ])
//
// target: a widget the page made, a vg shape's handle, or 0 for the whole
// page. A right click (a long press on touch) opens it: the page's items,
// then, below a divider, sae's own (Back, Forward, Reload, View page
// source, Inspect), which a page cannot remove, reorder, disable or add
// under, and none of whose labels a page item may take. A page with no menu
// still has sae's. The array is read again each time the menu opens.

const SAE_MENU_LABELS_ = ",back,forward,reload,view page source,inspect,"

// A page item's label taking one of sae's: "" or why it is refused.
menu_label_refusal_(label: string) -> string {
    t = string.to_lower(string.trim(label))
    if string.length(t) == 0 { return "a menu item needs a label" }
    if string.contains(SAE_MENU_LABELS_, ",${t},") == 1 { return "\"${label}\" is sae's own menu item" }
    return ""
}

// Why an items array is refused, or "".
menu_items_refusal_(p: *Page, items: int) -> string {
    ctx = p.ctx
    ti = quickjs.type_of(ctx, items)
    if ti != "array" && ti != "object" { return "context_menu(target, items): items is an array of { label, action } and \"-\"" }
    n = js_length_(p, items)
    i = 0
    while i < n {
        it, _e = js_get_index_(p, items, i)
        t = quickjs.type_of(ctx, it)
        why = ""
        if t == "string" {
            if js_str_(p, it) != "-" { why = "context_menu: a string item is \"-\", a separator" }
        } else if t == "object" {
            why = menu_label_refusal_(js_prop_str_(p, it, "label", ""))
            if why == "" {
                f, _fe = js_get_(p, it, "action")
                if quickjs.type_of(ctx, f) != "function" && js_prop_bool_(p, it, "enabled", 1) == 1 {
                    why = "context_menu: \"${js_prop_str_(p, it, "label", "")}\" has no action (a function), and is not enabled: false"
                }
                quickjs.release(ctx, f)
            }
        } else {
            why = "context_menu: an item is { label, action } or \"-\""
        }
        quickjs.release(ctx, it)
        if why != "" { return why }
        i = i + 1
    }
    return ""
}

// A boolean property of obj, or dflt when it is missing.
js_prop_bool_(p: *Page, obj: int, name: string, dflt: int) -> int {
    ctx = p.ctx
    v, err = js_get_(p, obj, name)
    if err != "" { return dflt }
    out = dflt
    if js_nothing_(p, v) == 0 { out = js_to_bool_(p, v) }
    quickjs.release(ctx, v)
    return out
}

// The held items for a target, or 0.
page_menu_items_(p: *Page, target: int) -> int {
    n = list.size(p.menus)
    i = 0
    while i < n {
        v, _ = list.get(p.menus, i)
        pm = v as *PageMenu
        if pm.target == target { return pm.items }
        i = i + 1
    }
    return 0
}

page_menus_free_(p: *Page) {
    n = list.size(p.menus)
    i = 0
    while i < n {
        v, _ = list.get(p.menus, i)
        heap.free(v)
        i = i + 1
    }
    list.free(p.menus)
    n = list.size(p.held)
    i = 0
    while i < n {
        v, _ = list.get(p.held, i)
        heap.free(v)
        i = i + 1
    }
    list.free(p.held)
    // Its items go with the page: none of them can run into a freed runtime.
    b = p.browser as *Browser
    if b != null && b.menu_h != 0 { ui.menu_clear(b.menu_h) }
}

// Open the context menu: the page's items (held array `items`, 0 none),
// a divider, sae's section; popped at `anchor`.
open_menu_(b: *Browser, p: *Page, items: int, anchor: int) {
    if b.menu_h == 0 { b.menu_h = ui.menu("context") }
    m = b.menu_h
    ui.menu_clear(m)
    shown = 0
    // The menu opens from a click, outside any entry into the page, and reads
    // the page's items (getters, toString) as it builds: one entry for all of
    // it, so a page's stuck getter costs the limit once and is reported once.
    long prev = 0
    if p != null && items != 0 {
        ctx = p.ctx
        prev = entry_begin_(p)
        n = js_length_(p, items)
        i = 0
        last_sep = 1
        while i < n {
            it, _e = js_get_index_(p, items, i)
            t = quickjs.type_of(ctx, it)
            if t == "string" {
                // A separator, never two together or one first.
                if last_sep == 0 { ui.menu_separator(m); last_sep = 1 }
            } else if t == "object" {
                label = js_prop_str_(p, it, "label", "")
                if menu_label_refusal_(label) == "" {
                    accel = js_prop_str_(p, it, "accel", "")
                    text_ = label
                    if string.length(accel) > 0 { text_ = "${label}  ${accel}" }
                    f, _fe = js_get_(p, it, "action")
                    on = js_prop_bool_(p, it, "enabled", 1)
                    if on == 1 && quickjs.type_of(ctx, f) == "function" {
                        idx = i
                        ui.menu_item(m, own_(text_), || {
                mp = page_of_(b, ctx)
                if mp != null { fire_menu_item_(mp, items, idx) }
            })
                    } else {
                        ui.menu_item_disabled(m, own_(text_))
                    }
                    quickjs.release(ctx, f)
                    shown = shown + 1
                    last_sep = 0
                }
            }
            quickjs.release(ctx, it)
            i = i + 1
        }
        entry_stopped_(p, prev, "the page's context menu")
    }
    if shown > 0 { ui.menu_separator(m) }
    // sae's own section: always there, always last, always these.
    if b.hist_index > 0 { ui.menu_item(m, "Back", || { request_nav_(b, NAV_BACK, "") }) } else { ui.menu_item_disabled(m, "Back") }
    if b.hist_index >= 0 && b.hist_index < b.hist_len - 1 { ui.menu_item(m, "Forward", || { request_nav_(b, NAV_FORWARD, "") }) } else { ui.menu_item_disabled(m, "Forward") }
    ui.menu_item(m, "Reload", || { request_nav_(b, NAV_RELOAD, "") })
    ui.menu_item(m, "View page source", || { show_source_(b) })
    ui.menu_item(m, "Inspect", || { show_inspect_(b) })
    ui.menu_popup(m, anchor)
}

// A page item chosen: its action, read again from the held array.
fire_menu_item_(p: *Page, items: int, i: int) {
    ctx = p.ctx
    prev = entry_begin_(p)
    it, _e = js_get_index_(p, items, i)
    f, _fe = js_get_(p, it, "action")
    entry_stopped_(p, prev, "the chosen menu item")
    if quickjs.type_of(ctx, f) == "function" { fire_click_(p, f) }
    quickjs.release(ctx, f)
    quickjs.release(ctx, it)
}

// "View page source": a window with the page's source as fetched.
show_source_(b: *Browser) {
    url = ""
    if b.page != null { url = (b.page as *Page).url }
    w = ui.window_create("Source of ${url}", 760, 560)
    r = ui.root_vstack(4)
    _t = ui.text(mem.long_to_ptr(r), "Source of ${url}")
    ta = ui.textarea(mem.long_to_ptr(r), "", |s: string| { })
    ui.set_text(ta, b.source)
    _fw = ui.fill_width(ta)
    _fh = ui.fill_height(ta)
    ui.window_set_body(w, r)
    ui.window_show(w)
}

// "Inspect": a window with the page's widgets, each under its parent:
// its handle and what it shows; the page's address and vg shape count.
show_inspect_(b: *Browser) {
    if b.page == null { return }
    p = b.page as *Page
    sb = strbuilder.new(256)
    _a = strbuilder.append(sb, "${p.url}\n")
    _b = strbuilder.append(sb, "${list.size(p.vg_nodes)} vg shapes handed to the page\n\n")
    last = aether_ui_widget_count_impl()
    h = p.root
    while h <= last {
        if h == p.root || h >= p.first_handle {
            depth = 0
            q = aether_ui_widget_parent_impl(h)
            while q != 0 && q != p.root && depth < 40 {
                depth = depth + 1
                q = aether_ui_widget_parent_impl(q)
            }
            if h == p.root || q == p.root {
                pad = ""
                k = 0
                while k < depth { pad = "${pad}  "; k = k + 1 }
                txt = ui.get_text(h)
                if string.length(txt) > 60 { txt = string.concat(string.substring(txt, 0, 57), "...") }
                _c = strbuilder.append(sb, "${pad}#${h}  ${txt}\n")
            }
        }
        h = h + 1
    }
    w = ui.window_create("Inspect ${p.url}", 560, 600)
    r = ui.root_vstack(4)
    _t = ui.text(mem.long_to_ptr(r), "Inspect ${p.url}")
    ta = ui.textarea(mem.long_to_ptr(r), "", |s: string| { })
    ui.set_text(ta, strbuilder.finish(sb))
    _fw = ui.fill_width(ta)
    _fh = ui.fill_height(ta)
    ui.window_set_body(w, r)
    ui.window_show(w)
}

// ui.context_menu(target, items)
sae_ui_context_menu(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 2 { return sae_throw_type_error(ctx, "context_menu(target, items): target (a widget, a vg shape or 0 for the page) and items") }
    target = arg_int_(ctx, argv, argc, 0, 0)
    items = hold_arg_(ctx, argv, 1)
    why = menu_items_refusal_(p, items)
    if why != "" { return sae_throw_type_error(ctx, why) }
    is_vg = 0
    if target > VG_BASE {
        node = vg_node_of_(p, target)
        if node == null { return sae_throw_type_error(ctx, "context_menu: ${target} is not a vg shape this page made") }
        r = aevg.rec_of(ae_model_(p), node)
        if r == null || r.el == null { return sae_throw_type_error(ctx, "context_menu: ${target} is not a vg shape this page made") }
        r.h_menu = items
        is_vg = 1
    } else if target != 0 && owned_(p, target) == 0 {
        return sae_throw_type_error(ctx, "context_menu: ${target} is not a widget this page made")
    }
    had = page_menu_items_(p, target) != 0
    n = list.size(p.menus)
    i = 0
    while i < n {
        v, _ = list.get(p.menus, i)
        pm = v as *PageMenu
        if pm.target == target {
            if pm.items != items { quickjs.release(ctx, pm.items) }
            pm.items = items
        }
        i = i + 1
    }
    if had == 0 {
        pm = heap.new(PageMenu)
        pm.target = target
        pm.items = items
        list.add(p.menus, pm as ptr)
        // A widget's own: its secondary click opens it (the deepest taker
        // wins, so a right click there is not the page's).
        if target != 0 && is_vg == 0 {
            b = p.browser as *Browser
            ui.on_secondary_click(target, |x: float, y: float| {
                open_menu_(b, p, page_menu_items_(p, target), target)
            })
        }
    }
    return 0
}

