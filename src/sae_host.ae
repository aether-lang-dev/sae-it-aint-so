// ui._textarea(placeholder, onChange?): a multi-line field; onChange(text)
// on every edit. The prelude's ui.textarea wraps it, so bind() knows it.
sae_ui_textarea(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    placeholder = own_(arg_str_(ctx, argv, argc, 0))
    has_fn = 0
    ref = 0
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) != 0 {
        has_fn = 1
        ref = hold_arg_(ctx, argv, 1)
    }
    on_change = |s: string| {
        if has_fn == 1 {
            r = call1_str_(p, ref, s)
            if r < 0 { report_exception_(p, "a textarea handler") }
            settle_(p)
        }
    }
    long t = now_ns_()
    h = ui.textarea(mem.long_to_ptr(top_(p)), placeholder, on_change)
    track_(p, h, ref)
    ui_done_(p, t)
    return quickjs.new_int(ctx, h)
}

