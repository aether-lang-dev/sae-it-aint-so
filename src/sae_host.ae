}

// --- the page API: timers ---

// timer(ms, fn): call fn every ms milliseconds (at least 10) until
// timer_cancel(id) or the page goes. Returns the timer's id.
@c_callback
sae_ui_timer(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    ms = arg_int_(ctx, argv, argc, 0, 1000)
    if ms < 10 { ms = 10 }
    ref = held_fn_(ctx, argv, argc, 1)
    if ref == null { return sae_throw_type_error(ctx, "timer(ms, fn): fn must be a function") }
    id = ui.timer(ms, || {
        r = call0_(ctx, mem.get_long(ref, 0))
        if sae_js_is_exception(r) != 0 { report_exception_(ctx, "a timer") }
    })
    list.add(p.timers, mem.long_to_ptr(id))
    return JS_NewInt32(ctx, id)
}

// timer_cancel(id): stop one of this page's timers. Another id is ignored.
@c_callback
sae_ui_timer_cancel(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    id = arg_int_(ctx, argv, argc, 0, 0)
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        if mem.ptr_to_long(v) == id && id != 0 {
            ui.timer_cancel(id)
            list.set(p.timers, i, mem.long_to_ptr(0))
            return sae_js_undefined()
        }
        i = i + 1
    }
    return sae_js_undefined()
}

// --- the page API: http, on Aether's actor core ---
//
//   http.get(url, (status, body, err) => ...)
//   http.post(url, body, contentType, (status, body, err) => ...)
//
// The request runs on an Aether actor (an HttpFetcher, one of a small pool),
// on the scheduler's threads, so the UI thread never waits on the network.
// Each finished job goes to the HttpInbox actor; while any are in flight a
// UI timer asks the inbox for them and runs the page's callback on the UI
// thread, where the JS engine lives. A reply for a page that has since gone
// is dropped. err is "" on success; status is 0 when nothing came back.
//
// Where a page may reach: in the browser, its own origin; in an app, the
// origins app.json lists under "http" (Tauri's allowlist). The rest is an
// err, delivered the same way.

@c_callback
sae_http_get(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    return http_start_(ctx, "GET", own_(arg_str_(ctx, argv, argc, 0)), "", "", held_fn_(ctx, argv, argc, 1))
}

@c_callback
sae_http_post(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    return http_start_(ctx, "POST", own_(arg_str_(ctx, argv, argc, 0)),
                       own_(arg_str_(ctx, argv, argc, 1)), own_(arg_str_(ctx, argv, argc, 2)),
                       held_fn_(ctx, argv, argc, 3))
}

// --- the page API: storage ---
//
// storage.get(key) / set(key, value) / remove(key): string values that
// outlive the page and the process, like localStorage. Scoped to the app (in
// app mode) or the page's origin (in the browser), so one site never reads
// another's. Keys are letters, digits, '.', '_' and '-'. The file system is
// the kernel's (storage_file_ below); a page reaches only these three calls.

@c_callback
sae_storage_get(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.get(key): key must be letters, digits, '.', '_' or '-'") }
    v, found = storage_read_(page_of_(ctx).url, key)
    if found == 0 { return sae_js_null() }
    return JS_NewString(ctx, v)
}

@c_callback
sae_storage_set(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.set(key, value): key must be letters, digits, '.', '_' or '-'") }
    val = own_(arg_str_(ctx, argv, argc, 1))
    if string.length(val) > STORAGE_MAX { return sae_throw_type_error(ctx, "storage.set: value over 1 MB") }
    if storage_write_(page_of_(ctx).url, key, val) == 0 { return sae_throw_type_error(ctx, "storage.set: could not save") }
    return sae_js_undefined()
}

@c_callback
sae_storage_remove(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    key = own_(arg_str_(ctx, argv, argc, 0))
    if storage_key_ok_(key) == 0 { return sae_throw_type_error(ctx, "storage.remove(key): key must be letters, digits, '.', '_' or '-'") }
    storage_remove_(page_of_(ctx).url, key)
    return sae_js_undefined()
}

