// textfield(placeholder, body?): a one-line field; the block runs with the
// field on top, for onchange(fn) (fn(text) on every edit), onsubmit and the
// rest. The change handler is a verb in the block, not an argument before
// it, so the block is always the last argument (docs/design/trailing-blocks.md).
// The field's closure reads its handler from a HeldRef of its own (kind
// HK_CHANGE, ref 0 until onchange sets it), let go of with the widget.
sae_ui_textfield(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    placeholder = own_(arg_str_(ctx, argv, argc, 0))
    e = heap.new(HeldRef)
    e.widget = 0
    e.ref = 0
    e.kind = HK_CHANGE
    on_change = |s: string| {
        if e.ref != 0 {
            r = call1_str_(p, e.ref, s)
            if r < 0 { report_exception_(p, "a textfield's onchange") }
            settle_(p)
        }
    }
    long t = now_ns_()
    h = ui.textfield(mem.long_to_ptr(top_(p)), placeholder, on_change)
    e.widget = h
    list.add(p.held, e as ptr)
    ui_done_(p, t)
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) != 0 {
        if push_(p, h) == 0 { return sae_throw_type_error(ctx, "containers nested too deeply") }
        r = call_arg_(p, argv, 1)
        pop_(p)
        if r < 0 { return rethrow_(ctx) }
    }
    return quickjs.new_int(ctx, h)
}

// onchange(fn): in a textfield's block, fn(text) on every edit.
sae_ui_onchange(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    target = modifier_target_(p, "onchange")
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "onchange(fn): fn must be a function") }
    n = list.size(p.held)
    i = 0
    while target != 0 && i < n {
        v, _ = list.get(p.held, i)
        e = v as *HeldRef
        if e.widget == target && e.kind == HK_CHANGE {
            if e.ref != 0 { quickjs.release(ctx, e.ref) }
            e.ref = hold_arg_(ctx, argv, 0)
            return 0
        }
        i = i + 1
    }
    return sae_throw_type_error(ctx, "onchange() must be called inside a textfield's block")
}

// securefield(placeholder, onChange?): a field whose text is not shown (a
// password), onChange(text) on every edit, get_text reading it; the
// platform's own secure field on every backend (aether-ui's securefield).
sae_ui_securefield(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    placeholder = own_(arg_str_(ctx, argv, argc, 0))
    has_fn = 0
    ref = 0
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) != 0 {
        has_fn = 1
        ref = hold_arg_(ctx, argv, 1)
    }
    on_change = |s: string| {
        if has_fn == 1 {
            r = call1_str_(p, ref, s)
            if r < 0 { report_exception_(p, "a securefield handler") }
            settle_(p)
        }
    }
    long t = now_ns_()
    h = ui.securefield(mem.long_to_ptr(top_(p)), placeholder, on_change)
    track_(p, h, ref)
    ui_done_(p, t)
    return quickjs.new_int(ctx, h)
}

// ===== keys, Return, focus, wrapping and size (the cloud wishlist, 2026-10-10) =====

// ui.on_key(fn(key, mods)): every key the window gets while the page has the
// focus: a widget the page made, or nothing at all. Names are aether-ui's
// ("Left", "Return", "BackSpace", "a"); mods is 1 shift, 2 ctrl, 4 alt,
// 8 super. A key while the address bar (or any of the browser's own
// widgets) has the focus never reaches a page: what a person types into the
// chrome is not the page's to read. One function per page; a second call
// replaces the first.
sae_ui_on_key(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "ui.on_key(fn): fn must be a function") }
    if p.key_ref != 0 { quickjs.release(ctx, p.key_ref) }
    p.key_ref = hold_arg_(ctx, argv, 0)
    keys_hook_(p.browser as *Browser)
    return 0
}

// One window hook for every page, made the first time any page asks.
keys_hook_(b: *Browser) {
    if b.keys_hooked == 1 { return }
    b.keys_hooked = 1
    ui.window_on_key(|k: string, m: int| { keys_deliver_(b, k, m) })
}

// To the page with the focus, if it asked: the first live page with a key
// function whose widget has the focus (or with nothing focused). One page,
// then return: a handler may navigate, which frees pages.
keys_deliver_(b: *Browser, k: string, m: int) {
    fw = ui.focused_widget()
    i = 0
    while i < list.size(b.pages) {
        pv, _e = list.get(b.pages, i)
        p = pv as *Page
        if p.key_ref != 0 {
            if fw == 0 || owned_(p, fw) == 1 {
                ctx = p.ctx
                args = quickjs.new_array(ctx)
                ks = quickjs.new_string(ctx, k)
                _a = js_set_index_(p, args, 0, ks)
                quickjs.release(ctx, ks)
                ms = quickjs.new_int(ctx, m)
                _b = js_set_index_(p, args, 1, ms)
                quickjs.release(ctx, ms)
                // A key is a gesture; Ctrl or Cmd with V is the person's paste.
                was = b.gesture
                b.gesture = 1
                if (k == "v" || k == "V") && ((m / 2) % 2 == 1 || (m / 8) % 2 == 1) { b.gesture = 2 }
                r = calln_(p, p.key_ref, args)
                quickjs.release(ctx, args)
                if r < 0 { report_exception_(p, "a ui.on_key handler") }
                settle_(p)
                b.gesture = was
                return
            }
        }
        i = i + 1
    }
}

// ===== accessibility: what a screen reader is told (aether-ui's a11y_*) =====
//
// ui.a11y_label(h, text), ui.a11y_role(h, role), ui.a11y_description(h,
// text) and ui.a11y_announce(h, text), each -> h. h is one of the page's
// widgets, or a vg scene it made (its handle, or any shape's of it): a scene
// is one canvas, one element to a screen reader, named and described as a
// whole, as a drawn chess board is. The name and description are the
// platform's own (aether-ui: GTK4's accessible properties, AppKit's and
// UIKit's accessibility label and help, MSAA on Win32, Android's content
// description); an announcement is spoken now, without moving the focus.
// The driver reads them back at GET /widget/{id}/a11y (a scene's id is its
// canvas's).

// The widget an a11y call speaks for, or 0 when h is no widget or vg shape
// of this page's.
a11y_widget_(p: *Page, h: int) -> int {
    if h > VG_BASE {
        n = vg_node_of_(p, h)
        if n == null { return 0 }
        cid = vg.scene_canvas(vg.node_scene(n))
        if cid == 0 { return 0 }
        return ui.canvas_widget(cid)
    }
    if h < 1 || owned_(p, h) == 0 { return 0 }
    return h
}

// aether-ui's role vocabulary (its docs/design/accessibility.md), each
// mapped to the platform's on every backend.
a11y_role_ok_(r: string) -> int {
    return string.contains(",button,checkbox,radio,link,heading,image,group,list,listitem,tab,tablist,menu,menuitem,dialog,alert,textbox,slider,progressbar,grid,row,gridcell,columnheader,table,none,", ",${r},")
}

// One of the four: kind 0 the name, 1 the role, 2 the description, 3 an
// announcement.
a11y_set_(p: *Page, argv: int, argc: int, kind: int, what: string) -> int {
    ctx = p.ctx
    h = arg_int_(ctx, argv, argc, 0, 0)
    w = a11y_widget_(p, h)
    if w == 0 { return sae_throw_type_error(ctx, "${what}: h is not a widget or vg scene this page made") }
    if argc < 2 { return sae_throw_type_error(ctx, "${what}: the text is missing") }
    t = own_(arg_str_(ctx, argv, argc, 1))
    if string.length(t) > 4000 { return sae_throw_type_error(ctx, "${what}: the text is over 4000 bytes") }
    if kind == 1 {
        if a11y_role_ok_(t) == 0 { return sae_throw_type_error(ctx, "${what}: \"${t}\" is not a role (button, checkbox, radio, link, heading, image, group, list, listitem, tab, tablist, menu, menuitem, dialog, alert, textbox, slider, progressbar, grid, row, gridcell, columnheader, table, none)") }
        _r = ui.a11y_role(w, t)
    } else if kind == 0 {
        _l = ui.a11y_label(w, t)
    } else if kind == 2 {
        _d = ui.a11y_description(w, t)
    } else {
        if t == "" { return quickjs.new_int(ctx, h) }
        _a = ui.a11y_announce(w, t)
    }
    return quickjs.new_int(ctx, h)
}

// ui.a11y_label(h, text) -> h: the accessible name, what a screen reader
// calls it (an icon button's, a drawn board's).
sae_ui_a11y_label(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    return a11y_set_(p, argv, argc, 0, "ui.a11y_label(h, text)")
}

// ui.a11y_role(h, role) -> h: what it is to a screen reader ("button",
// "heading", "group", "image", ...; "none" hides a decorative one).
sae_ui_a11y_role(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    return a11y_set_(p, argv, argc, 1, "ui.a11y_role(h, role)")
}

// ui.a11y_description(h, text) -> h: the longer account read after the
// name (a board's position, square by square).
sae_ui_a11y_description(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    return a11y_set_(p, argv, argc, 2, "ui.a11y_description(h, text)")
}

// ui.a11y_announce(h, text) -> h: the screen reader says text now, from h,
// the focus left where it is (a move made, the square under a keyboard
// cursor). "" says nothing.
sae_ui_a11y_announce(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    return a11y_set_(p, argv, argc, 3, "ui.a11y_announce(h, text)")
}

// ===== vg.on_key: keys on a scene's canvas =====
//
// vg.on_key(h, fn(key)) -> h: fn hears each key pressed while the scene's
// canvas (h the scene, or any shape of it) has the keyboard focus, by
// aether-ui's names ("Left", "Up", "Return", "space", "Escape", "a"). The
// canvas takes the focus: it is made focusable, and takes it when shown, or
// when clicked or touched (aether-ui's canvas_on_key, real on GTK4, AppKit,
// Win32, UIKit and Android). One function a canvas; a second call replaces
// the first. A key typed into the browser's own widgets never reaches it,
// since they, not the canvas, have the focus then.
struct VgKey {
    cid: int     // the canvas
    ref: int     // the page's function (held), or 0 once the page is gone
    ctx: ptr
    browser: ptr // *Browser
}

sae_vg_on_key(p: *Page, this_val: int, argv: int) -> int {
    seal except VgKey, arg_int_, hold_arg_, is_fn_arg_, list, quickjs, sae_throw_type_error, vg, vg_key_hook_, vg_node_of_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    n = vg_node_of_(p, h)
    if n == null { return sae_throw_type_error(ctx, "vg.on_key(h, fn): h is not a scene or shape this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "vg.on_key(h, fn): fn must be a function") }
    cid = vg.scene_canvas(vg.node_scene(n))
    if cid == 0 { return sae_throw_type_error(ctx, "vg.on_key(h, fn): the scene has no canvas yet") }
    i = 0
    while i < list.size(p.vg_keys) {
        ev, _e = list.get(p.vg_keys, i)
        e = ev as *VgKey
        if e.cid == cid {
            quickjs.release(ctx, e.ref)
            e.ref = hold_arg_(ctx, argv, 1)
            return quickjs.new_int(ctx, h)
        }
        i = i + 1
    }
    k = heap.new(VgKey)
    k.browser = p.browser
    k.cid = cid
    k.ctx = ctx
    k.ref = hold_arg_(ctx, argv, 1)
    list.add(p.vg_keys, k as ptr)
    vg_key_hook_(k as ptr)
    return quickjs.new_int(ctx, h)
}

// The canvas's one key handler, reading the entry at each key: the
// function a later vg.on_key gave, or nothing once the page is gone.
vg_key_hook_(kp: @keep ptr) {
    k = kp as *VgKey
    ui.canvas_on_key(k.cid, |name: string| { vg_key_fire_(kp, name) })
}

vg_key_fire_(kp: ptr, name: string) {
    k = kp as *VgKey
    if k.ref == 0 { return }
    ctx = k.ctx
    kb = k.browser as *Browser
    p = page_of_(kb, ctx)
    if p == null { return }
    args = quickjs.new_array(ctx)
    ks = quickjs.new_string(ctx, name)
    _a = js_set_index_(p, args, 0, ks)
    quickjs.release(ctx, ks)
    // A key is a gesture, as ui.on_key's are.
    was = kb.gesture
    kb.gesture = 1
    r = calln_(p, k.ref, args)
    quickjs.release(ctx, args)
    kp2 = page_of_(kb, ctx)
    if r < 0 && kp2 != null { report_exception_(kp2, "a vg key handler") }
    if kp2 != null { settle_(kp2) }
    kb.gesture = was
}

// With the page: each entry's function let go, the entry kept (its canvas
// may outlive the page by a moment, and a key then finds ref 0).
vg_keys_free_(p: *Page) {
    i = 0
    while i < list.size(p.vg_keys) {
        ev, _e = list.get(p.vg_keys, i)
        e = ev as *VgKey
        if e.ref != 0 { quickjs.release(p.ctx, e.ref) }
        e.ref = 0
        i = i + 1
    }
    list.free(p.vg_keys)
}

// ui.on_submit(field, fn(text)): Return in one of the page's text fields.
sae_ui_on_submit(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(p, h) == 0 { return sae_throw_type_error(ctx, "ui.on_submit(h, fn): h is not a widget this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.on_submit(h, fn): fn must be a function") }
    ref = hold_arg_(ctx, argv, 1)
    submit_to_(p, h, ref)
    return quickjs.new_int(ctx, h)
}

submit_to_(p: *Page, h: int, ref: int) {
    ctx = p.ctx
    track_(p, h, ref)
    _h = ui.on_submit(h) callback |t: string| {
        r = call1_str_(p, ref, t)
        if r < 0 { report_exception_(p, "a submit handler") }
        settle_(p)
    }
}

// onsubmit(fn(text)): on_submit for the field whose block this is.
sae_ui_onsubmit(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    target = modifier_target_(p, "onsubmit")
    if target == 0 { return sae_throw_type_error(ctx, "onsubmit() must be called inside a field's block") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "onsubmit(fn): fn must be a function") }
    submit_to_(p, target, hold_arg_(ctx, argv, 0))
    return 0
}

// Call a held JS function with (number, number, number).
call_iff_(p: *Page, ref: int, a: int, x: float, y: float, what: string) {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    va = quickjs.new_int(ctx, a)
    _a = js_set_index_(p, args, 0, va)
    quickjs.release(ctx, va)
    vx = quickjs.new_float(ctx, x)
    _x = js_set_index_(p, args, 1, vx)
    quickjs.release(ctx, vx)
    vy = quickjs.new_float(ctx, y)
    _y = js_set_index_(p, args, 2, vy)
    quickjs.release(ctx, vy)
    if calln_(p, ref, args) < 0 { report_exception_(p, what) }
    quickjs.release(ctx, args)
}

drag_to_(p: *Page, h: int, ref: int) {
    track_(p, h, ref)
    _h = ui.on_drag(h) callback |phase: int, x: float, y: float| {
        call_iff_(p, ref, phase, x, y, "a drag handler")
        settle_(p)
    }
}

// ui.on_drag(h, fn(phase, x, y)) -> h: a press (phase 0, at (x, y) in the
// widget), moves (1) and the release (2), those two as offsets from the
// press.
sae_ui_on_drag(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(p, h) == 0 { return sae_throw_type_error(ctx, "ui.on_drag(h, fn): h is not a widget this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.on_drag(h, fn): fn must be a function") }
    drag_to_(p, h, hold_arg_(ctx, argv, 1))
    return quickjs.new_int(ctx, h)
}

// ui.reorderable(h, fn(from, to)) -> h: the children of a vstack or hstack
// the page made can be dragged among themselves (aether-ui's reorderable:
// one gesture on the stack, so children rebuilt later are covered). Let go
// and fn(from, to) runs with the child's index and the index it has after
// the move, both in the order before it; a drop that moves nothing does not
// call back. Nothing moves on its own: the page moves the item in its state
// and rebuilds (each does, from its list). For a row built with each, h is
// the handle each returned (its children are the rows). Arming again
// replaces fn.
sae_ui_reorderable(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if own_stack_(p, h) == 0 { return sae_throw_type_error(ctx, "ui.reorderable(h, fn): h is not a vstack or hstack this page made") }
    kind = own_(aether_ui_widget_kind_impl(h))
    if kind != "vstack" && kind != "hstack" { return sae_throw_type_error(ctx, "ui.reorderable(h, fn): h is not a vstack or hstack this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.reorderable(h, fn): fn must be a function (from, to) => void") }
    ref = hold_arg_(ctx, argv, 1)
    track_(p, h, ref)
    rb = p.browser as *Browser
    ui.reorderable(h) callback |from: int, to: int| {
        was = rb.gesture
        rb.gesture = 1
        call_ii_(p, ref, from, to, "a reorder handler")
        settle_(p)
        rb.gesture = was
    }
    return quickjs.new_int(ctx, h)
}

// Call a held JS function with two numbers.
call_ii_(p: *Page, ref: int, a: int, b: int, what: string) {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    va = quickjs.new_int(ctx, a)
    _a = js_set_index_(p, args, 0, va)
    quickjs.release(ctx, va)
    vb = quickjs.new_int(ctx, b)
    _b = js_set_index_(p, args, 1, vb)
    quickjs.release(ctx, vb)
    if calln_(p, ref, args) < 0 { report_exception_(p, what) }
    quickjs.release(ctx, args)
}

// Call a held JS function with one number.
call_i_(p: *Page, ref: int, n: int, what: string) {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    v = quickjs.new_int(ctx, n)
    _s = js_set_index_(p, args, 0, v)
    quickjs.release(ctx, v)
    if calln_(p, ref, args) < 0 { report_exception_(p, what) }
    quickjs.release(ctx, args)
}

focus_to_(p: *Page, h: int, ref: int) {
    track_(p, h, ref)
    _h = ui.on_focus_change(h) callback |inside: int| {
        call_i_(p, ref, inside, "a focus handler")
        settle_(p)
    }
}

// ui.on_focus_change(h, fn(inside)) -> h: keyboard focus came into the
// widget or anything inside it (1), or left (0). Focus leaving the browser
// for another application is not a change.
sae_ui_on_focus_change(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    w = a11y_widget_(p, h)
    if w == 0 { return sae_throw_type_error(ctx, "ui.on_focus_change(h, fn): h is not a widget or vg scene this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.on_focus_change(h, fn): fn must be a function") }
    focus_to_(p, w, hold_arg_(ctx, argv, 1))
    return quickjs.new_int(ctx, h)
}

// onfocuschange(fn(inside)): ui.on_focus_change for the widget whose block
// this is.
sae_ui_onfocuschange(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    target = modifier_target_(p, "onfocuschange")
    if target == 0 { return sae_throw_type_error(ctx, "onfocuschange() must be called inside a widget's block") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "onfocuschange(fn): fn must be a function") }
    focus_to_(p, target, hold_arg_(ctx, argv, 0))
    return 0
}

// ui.key_text(name) -> the text a key name types ("comma" is ",", "Left"
