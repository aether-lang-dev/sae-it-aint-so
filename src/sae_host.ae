    // stopped it) or "deadline" (it was still running at BUS_DEADLINE_MS).
    raw_space(g, "__sae_bus", WHEN_APP_SEEKS, "control-bus") {
        reach("bus")
        api("serve", sae_bus_serve, 2) {
            arg("fn", T_FN)
