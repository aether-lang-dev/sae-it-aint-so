sae_ae_path(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_shape_done_, aevg_K_SHAPE, arg_str_, own_, quickjs, sae_throw_type_error, vg, vg_scene_open_, vg_top_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(p) == 0 { return sae_throw_type_error(ctx, "vg.path() must be called inside vg.scene()") }
    d = own_(arg_str_(ctx, argv, argc, 0))
    n = vg.path(vg_top_(p), d)
    return ae_shape_done_(p, argv, argc, 1, n, K_SHAPE)
