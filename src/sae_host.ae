// --- the page API: timers ---
//
// Every timer a page starts (ui.timer, ui.after, ui.sleep, setTimeout,
// setInterval) is a PageTimer in the page's own queue, and the queue runs on
// ONE aether-ui one-shot (ui.timer_once) armed for its earliest due time: the
// page's "wake". When it fires, the timers that are due run in order of due
// time, then of creation (HTML's order for timers with the same delay), each
// followed by the page's promise jobs, and the wake is re-armed. A one-shot
// leaves the queue BEFORE its callback runs, so it runs exactly once however
// slow its callback is or whatever it throws; an interval is rescheduled
// before its callback runs, from now, so a slow one drifts rather than
// bursting. A timer started while the batch runs waits for the next wake,
// as a task queued by a task does.
//
// Ids are the page's own (1, 2, ...), shared by every kind, so timer_cancel,
// clearTimeout and clearInterval each cancel any of them, as in a browser.
// A page reaches only its own queue: there is no way to name another page's
// timer. When the page goes, page_free_ cancels the wake and its frame
// subscription and drops the queue: nothing fires afterwards, and a pending
// ui.sleep promise is never settled (it goes with the runtime).
//
// Clamping, as HTML does it: a negative, NaN or overflowing (> 2^31-1)
// delay is 0; a timer started from a timer callback nested more than 5 deep,
// and an interval past its fifth run, has at least 4 ms. ui.timer keeps its
// floor of 10 ms. A delay of 0 runs on the next turn of the event loop.
//
// requestAnimationFrame (and ui.frame) is a separate list: the page holds
// one aether-ui on_frame subscription while the list is not empty, and each
// display frame runs (and empties) the list as it stood when the frame began,
// passing every callback the same timestamp, on performance.now()'s clock in
// fractional milliseconds. A callback that requests again is in the next
// frame. When nothing is waiting the subscription is cancelled, so an idle
// page costs no frames.

struct PageTimer {
    id: int
    due: long        // ms on the real monotonic clock
    interval: int    // ms between runs; 0 for a one-shot
    floor: int       // the interval's minimum (10 for ui.timer, else 0)
    seq: int         // queue order among equal due times
    nesting: int     // HTML's timer nesting level
    fn_h: int        // the held JS function
    args_h: int      // a held JS array of extra arguments, or 0
    alive: int
}

struct PageRaf {
    id: int          // 0 once cancelled
    fn_h: int
}

// The real (unscaled) monotonic clock in ms: SAE_TIME_SCALE speeds up the
// clocks a page reads, not its timers.
real_ms_() -> long { return os.now_monotonic_ms() }

// The clock requestAnimationFrame's timestamp is on: performance.now()'s,
// with the fraction kept.
raf_now_() -> float {
    long ms = now_ms_()   // also starts SAE_TIME_SCALE's base
    if time_scale_ == 1 { return esc_perf_now_() }   // wave1/escape: coarse in the browser
    return ms as float
}

// A delay argument as HTML reads it: NaN, negative and overflowing are 0.
delay_arg_(ctx: ptr, argv: int, argc: int, i: int) -> int {
    if i >= argc { return 0 }
    d = quickjs.arg_float(ctx, argv, i)
    if d != d || d < 0.0 || d > 2147483647.0 { return 0 }
    return d as int
}

// Start a timer on page p: fn_h and args_h become the queue's (released when
// the timer goes). Returns its id.
timer_add_(p: *Page, fn_h: int, args_h: int, ms: int, repeat: int, floor: int) -> int {
    level = p.timer_nesting
    if ms < 0 { ms = 0 }
    if level > 5 && ms < 4 { ms = 4 }
    if ms < floor { ms = floor }
    t = heap.new(PageTimer)
    p.timer_ids = p.timer_ids + 1
    t.id = p.timer_ids
    t.due = real_ms_() + ms
    t.interval = 0
    if repeat == 1 { t.interval = ms }
    if repeat == 1 && t.interval < 1 { t.interval = 0 - 1 }   // setInterval(fn, 0)
    t.floor = floor
    p.timer_seq = p.timer_seq + 1
    t.seq = p.timer_seq
    t.nesting = level + 1
    t.fn_h = fn_h
    t.args_h = args_h
    t.alive = 1
    list.add(p.timers, t as ptr)
    if p.timers_running == 0 { timers_arm_(p) }
    return t.id
}

// Release a timer's JS handles and free it.
timer_drop_(p: *Page, t: *PageTimer) {
    if t.fn_h != 0 { quickjs.release(p.ctx, t.fn_h) }
    if t.args_h != 0 { quickjs.release(p.ctx, t.args_h) }
    heap.free(t)
}

// Remove the cancelled and the finished from the queue.
timers_sweep_(p: *Page) {
    i = list.size(p.timers) - 1
    while i >= 0 {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 0 {
            list.list_remove(p.timers, i)
            timer_drop_(p, t)
        }
        i = i - 1
    }
}

// The index of the earliest timer due by `now` and queued by `seq_max`, -1
// if none is.
timers_next_(p: *Page, now: long, seq_max: int) -> int {
    best = 0 - 1
    long best_due = 0
    best_seq = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 1 && t.due <= now && t.seq <= seq_max {
            if best < 0 || t.due < best_due || (t.due == best_due && t.seq < best_seq) {
                best = i
                best_due = t.due
                best_seq = t.seq
            }
        }
        i = i + 1
    }
    return best
}

// Arm the page's wake for its earliest timer, or disarm it when none is left.
timers_arm_(p: *Page) {
    long due = 0
    found = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 1 && (found == 0 || t.due < due) {
            due = t.due
            found = 1
        }
        i = i + 1
    }
    if found == 0 {
        if p.wake != 0 { ui.timer_cancel(p.wake) }
        p.wake = 0
        return
    }
    if p.wake != 0 && p.wake_due == due { return }
    if p.wake != 0 { ui.timer_cancel(p.wake) }
    long wait = due - real_ms_()
    if wait < 0 { wait = 0 }
    ctx = p.ctx
    p.wake_due = due
    p.wake = ui.timer_once(wait as int, || { timers_wake_(ctx) })
}

// The wake fired: run what is due, in order, then re-arm.
timers_wake_(ctx: ptr) {
    p = page_of_(ctx)
    if p == null { return }
    p.wake = 0
    long now = real_ms_()
    seq_max = p.timer_seq   // what this batch started with
    p.timers_running = 1
    ti = timers_next_(p, now, seq_max)
    while ti >= 0 {
        tv, _ = list.get(p.timers, ti)
        t = tv as *PageTimer
        if t.interval == 0 {
            t.alive = 0   // a one-shot leaves the queue before it runs
        } else {
            level = t.nesting
            iv = t.interval
            if iv < 0 { iv = 0 }
            if level > 5 && iv < 4 { iv = 4 }
            if iv < t.floor { iv = t.floor }
            t.due = now + iv
            t.nesting = level + 1
            p.timer_seq = p.timer_seq + 1
            t.seq = p.timer_seq   // not again in this batch, even at 0 ms
        }
        p.timer_nesting = t.nesting
        r = 0
        if t.args_h != 0 { r = calln_(ctx, t.fn_h, t.args_h) }
        else { r = call0_(ctx, t.fn_h) }
        p.timer_nesting = 0
        if r < 0 { report_exception_(ctx, "a timer") }
        settle_(ctx)
        ti = timers_next_(p, now, seq_max)
    }
    p.timers_running = 0
    timers_sweep_(p)
    timers_arm_(p)
}

// Cancel one of page p's timers by id; any other id is ignored.
timer_cancel_id_(p: *Page, id: int) {
    if id <= 0 { return }
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.id == id && t.alive == 1 {
            t.alive = 0
            if p.timers_running == 0 {
                timers_sweep_(p)
                timers_arm_(p)
            }
            return
        }
        i = i + 1
    }
}

// The page goes: its wake, its frame subscription and every queued callback.
timers_free_(p: *Page) {
    if p.wake != 0 { ui.timer_cancel(p.wake) }
    p.wake = 0
    if p.frame_sub != 0 { ui.frame_cancel(p.frame_sub) }
    p.frame_sub = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        timer_drop_(p, v as *PageTimer)
        i = i + 1
    }
    list.free(p.timers)
    rafs_drop_(p, p.rafs)
    list.free(p.rafs)
}

// Extra arguments i.. of a call as a held JS array, or 0 when there are none.
rest_args_(ctx: ptr, argv: int, argc: int, i: int) -> int {
    if argc <= i { return 0 }
    a = quickjs.new_array(ctx)
    k = i
    while k < argc {
        h = quickjs.arg(ctx, argv, k)
        _e = quickjs.set_index(ctx, a, k - i, h)
        quickjs.release(ctx, h)
        k = k + 1
    }
    return a
}

// timer(ms, fn): call fn every ms milliseconds (at least 10) until
// timer_cancel(id) or the page goes. Returns the timer's id.
sae_ui_timer(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ms = arg_int_(ctx, argv, argc, 0, 1000)
    ref = held_fn_(ctx, argv, argc, 1)
    if ref == 0 { return sae_throw_type_error(ctx, "timer(ms, fn): fn must be a function") }
    return quickjs.new_int(ctx, timer_add_(p, ref, 0, ms, 1, 10))
}

// after(ms, fn): call fn once, ms milliseconds from now. Returns an id that
// timer_cancel (and clearTimeout) take.
sae_ui_after(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ms = delay_arg_(ctx, argv, argc, 0)
    ref = held_fn_(ctx, argv, argc, 1)
    if ref == 0 { return sae_throw_type_error(ctx, "after(ms, fn): fn must be a function") }
    return quickjs.new_int(ctx, timer_add_(p, ref, 0, ms, 0, 0))
}

// sleep(ms): a promise that resolves (to undefined) ms milliseconds from now.
// If the page goes first it never settles, and goes with the page's runtime.
sae_ui_sleep(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    if esc_timers_pending_(p) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, p) }   // wave1/escape: the timers cap
    ms = delay_arg_(ctx, argv, argc, 0)
    pr = quickjs.new_promise(ctx)
    resolve, _e1 = quickjs.get(ctx, pr, "resolve")
    promise, _e2 = quickjs.get(ctx, pr, "promise")
    quickjs.release(ctx, pr)
    _id = timer_add_(p, resolve, 0, ms, 0, 0)
    return promise
}

// timer_cancel(id) / clearTimeout(id) / clearInterval(id): stop one of this
// page's timers. Another id, or none, is ignored.
sae_ui_timer_cancel(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 { return 0 }
    timer_cancel_id_(page_of_(ctx), delay_arg_(ctx, argv, argc, 0))
    return 0
}

// setTimeout(fn, ms, ...args): call fn(...args) once, ms from now.
sae_set_timeout(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if esc_timers_pending_(page_of_(ctx)) >= ESC_TIMERS_MAX { return esc_timers_refuse_(ctx, page_of_(ctx)) }   // wave1/escape: the timers cap
    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "setTimeout(fn, ms, ...args): fn must be a function (sae does not eval a string)") }
    ms = delay_arg_(ctx, argv, argc, 1)
    return quickjs.new_int(ctx, timer_add_(page_of_(ctx), ref, rest_args_(ctx, argv, argc, 2), ms, 0, 0))
}

// setInterval(fn, ms, ...args): call fn(...args) every ms until cleared.
sae_set_interval(ctx: ptr, this_val: int, argv: int) -> int {
