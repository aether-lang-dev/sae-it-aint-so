// ui.on_interrupted(fn): told when the page's time limit (SAE_PAGE_TIME_MS, 5 s
// an entry) stopped an entry into its JS: a handler, a timer, the promise jobs
// one queued. A job stopped so never resumes and runs no finally, so a page
// holding state across an await (a queue, a lock) learns here that the work
// it was waiting on is gone. One handler a page; a second replaces the first;
// it goes with the page.
sae_ui_on_interrupted(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "ui.on_interrupted(fn): fn must be a function") }
    p.on_interrupted = hold_arg_(ctx, argv, 0)
    return 0
}

// The system's appearance flipped: told to the page, if it listens.
appearance_to_page_(b: *Browser, dark: int) {
    if b.page == null { return }
    p = b.page as *Page
    if p.on_appearance == 0 { return }
    if ae_call_bool_(p, p.on_appearance, dark) < 0 { report_exception_(p, "an appearance handler") }
    settle_(p)
}

// The window's size to the page's on_resize handler, if it has one.
resize_to_page_(p: *Page, w: int, h: int) {
    if p.on_resize == 0 { return }
    if call_nums_(p, p.on_resize, w * 1.0, h * 1.0, 2) < 0 { report_exception_(p, "a resize handler") }
    settle_(p)
}

// The window's stack laid out at a new size: kept, and told to the page.
window_laid_out_(b: *Browser, w: int, h: int) {
    b.win_w = w
    b.win_h = h
    if b.page != null { resize_to_page_(b.page as *Page, w, h) }
}

