// ui.datagrid_has_focus(g) -> boolean: the keyboard focus is in the grid (a
// cell, or its editor), so a key the page hears is the grid's and not a
// field's: Delete in a formula field is not Delete over the selection.
sae_ui_datagrid_has_focus(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    g = dgrid_arg_(p, argv, argc)
    if g == null { return sae_throw_type_error(ctx, "ui.datagrid_has_focus: g is not a grid this page made") }
    return quickjs.new_bool(ctx, focus_within_(ui.datagrid_widget(g)))
}

// 1 when the focused widget is `w` or inside it (its nearest registered
// ancestors, as aether-ui's on_key(widget) scopes keys).
focus_within_(w: int) -> int {
    f = ui.focused_widget()
    hops = 0
    while f != 0 && hops < 64 {
        if f == w { return 1 }
        f = aether_ui_widget_parent_impl(f)
        hops = hops + 1
    }
    return 0
}

