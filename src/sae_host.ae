    t = arg_str_(ctx, argv, argc, 0)
    size = arg_num_(ctx, argv, argc, 1, 12.0)
    max_w = arg_num_(ctx, argv, argc, 2, 0.0)
    if size <= 0.0 { return sae_throw_type_error(ctx, "vg.ellipsize(text, size, maxWidth): size must be positive") }
    return quickjs.new_string(ctx, vg.ellipsize(size, t, max_w))
}

// ===== ui.datagrid: aether-ui's virtualised grid for pages =====
//
// Declaratively, the grid is the receiver of its block, as a button is of
// its own (aether-ui's datagrid(...) { ... } in Aether):
//
//   ui.datagrid(1000000, 40, 15, 5, 1, () => {
//     column_width(80);
//     cells((r, c) => `${r},${c}`);
//     headers((c) => letters(c));
//     on_cell_select((r, c) => ...);
//     on_cell_edit((r, c, text) => ...);
//   });
//
// or by handle, each ui.datagrid_* setter returning the grid. A function of
// one or more parameters in the block's place is taken as the cell function
// (the first form this binding had).

// The most cell widgets one grid may show (vis_rows x (frozen + vis_cols)):
// a page asks for a window, and every shown cell is a real widget.
const DATAGRID_MAX_SHOWN = 4000

// Call a held JS function with two numbers; its result as a string ("" for
// undefined or null, or when it throws, which is reported).
call_ii_str_(p: *Page, ref: int, a: int, b: int, what: string) -> string {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    va = quickjs.new_int(ctx, a)
    _a = js_set_index_(p, args, 0, va)
    quickjs.release(ctx, va)
    vb = quickjs.new_int(ctx, b)
    _b = js_set_index_(p, args, 1, vb)
    quickjs.release(ctx, vb)
    g = quickjs.dup(ctx, ref)
    r, err = js_call_(p, g, 0, args)
    quickjs.release(ctx, g)
    quickjs.release(ctx, args)
    if err != "" {
        report_exception_(p, what)
        return ""
    }
    out = ""
    if js_nothing_(p, r) == 0 { out = js_str_(p, r) }
    quickjs.release(ctx, r)
    return out
}

// Call a held JS function with (number, number, string) and nothing back;
// what it throws is reported.
call_iis_(p: *Page, ref: int, a: int, b: int, t: string, what: string) {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    va = quickjs.new_int(ctx, a)
    _a = js_set_index_(p, args, 0, va)
    quickjs.release(ctx, va)
    vb = quickjs.new_int(ctx, b)
    _b = js_set_index_(p, args, 1, vb)
    quickjs.release(ctx, vb)
    vt = quickjs.new_string(ctx, t)
    _t = js_set_index_(p, args, 2, vt)
    quickjs.release(ctx, vt)
    if calln_(p, ref, args) < 0 { report_exception_(p, what) }
    quickjs.release(ctx, args)
}

// Call a held JS function with (string, number) and nothing back; what it
// throws is reported.
call_si_(p: *Page, ref: int, t: string, n: int, what: string) {
    ctx = p.ctx
    args = quickjs.new_array(ctx)
    vt = quickjs.new_string(ctx, t)
    _t = js_set_index_(p, args, 0, vt)
    quickjs.release(ctx, vt)
    vn = quickjs.new_int(ctx, n)
    _n = js_set_index_(p, args, 1, vn)
    quickjs.release(ctx, vn)
    if calln_(p, ref, args) < 0 { report_exception_(p, what) }
    quickjs.release(ctx, args)
}

// The page's grid with handle h (1-based), or null.
dgrid_of_(p: *Page, h: int) -> ptr {
    if h < 1 || h > list.size(p.dgrids) { return null }
    g, _e = list.get(p.dgrids, h - 1)
    return g
}

// The grid whose block is running (its widget is the receiver), or null.
dgrid_at_top_(p: *Page) -> ptr {
    if p.depth < 2 { return null }
    top = top_(p)
    n = list.size(p.dgrids)
    i = 0
    while i < n {
        g, _e = list.get(p.dgrids, i)
        if g != null && ui.datagrid_widget(g) == top { return g }
        i = i + 1
    }
    return null
}

// The grid named by argument 0 of a ui.datagrid_* call, or null.
dgrid_arg_(p: *Page, argv: int, argc: int) -> ptr {
    ctx = p.ctx
    return dgrid_of_(p, arg_int_(ctx, argv, argc, 0, 0))
}

// ---- What a grid hears, shared by the ui.datagrid_* forms and the block's
// verbs: each takes its function from argument i and returns "" or what is
// wrong with it.

dg_cells_(p: *Page, g: @keep ptr, argv: int, argc: int, i: int) -> string {
    ctx = p.ctx
    if argc <= i || is_fn_arg_(ctx, argv, i) == 0 { return "fn must be a function (row, col) => string" }
    ref = hold_arg_(ctx, argv, i)
    _g = ui.datagrid_cells(g) callback |r: int, c: int| {
        return call_ii_str_(p, ref, r, c, "a ui.datagrid cell function")
    }
    return ""
}

// kind: 0 edit text, 1 cell style, 2 tooltip, 3 picture (base64). Each
// (row, model col) -> string.
dg_rc_str_(p: *Page, g: @keep ptr, argv: int, argc: int, i: int, kind: int) -> string {
    ctx = p.ctx
    if argc <= i || is_fn_arg_(ctx, argv, i) == 0 { return "fn must be a function (row, col) => string" }
    ref = hold_arg_(ctx, argv, i)
    f = |r: int, c: int| {
        return call_ii_str_(p, ref, r, c, "a ui.datagrid edit-text or style function")
    }
    if kind == 0 { _g = ui.datagrid_edit_text(g, f) }
    if kind == 1 { _g = ui.datagrid_cell_style(g, f) }
    if kind == 2 { _g = ui.datagrid_cell_tooltip(g, f) }
    if kind == 3 { _g = ui.datagrid_cell_picture(g, f) }
    return ""
}

dg_headers_(p: *Page, g: @keep ptr, argv: int, argc: int, i: int) -> string {
    ctx = p.ctx
    if argc <= i || is_fn_arg_(ctx, argv, i) == 0 { return "fn must be a function (col) => string" }
    ref = hold_arg_(ctx, argv, i)
    _g = ui.datagrid_header(g) callback |c: int| {
        return call_ii_str_(p, ref, c, 0, "a ui.datagrid header function")
    }
    return ""
}

// kind: 0 click, 1 select, 2 activate, 3 column resize, 4 column move,
// 5 a header clicked (fn(c): the second number is 0), 6 an editor closed
// with nothing stored.
dg_on_ii_(p: *Page, g: @keep ptr, argv: int, argc: int, i: int, kind: int) -> string {
    ctx = p.ctx
    if argc <= i || is_fn_arg_(ctx, argv, i) == 0 { return "fn must be a function of two numbers" }
    ref = hold_arg_(ctx, argv, i)
    fire = |a: int, b: int| {
        _s = call_ii_str_(p, ref, a, b, "a ui.datagrid handler")
        settle_(p)
    }
    if kind == 0 { _g = ui.datagrid_on_click(g, fire) }
    if kind == 1 { _g = ui.datagrid_on_select(g, fire) }
    if kind == 2 { _g = ui.datagrid_on_activate(g, fire) }
    if kind == 3 { _g = ui.datagrid_on_col_resize(g, fire) }
    if kind == 4 { _g = ui.datagrid_on_col_move(g, fire) }
    if kind == 6 { _g = ui.datagrid_on_edit_cancel(g, fire) }
    if kind == 5 {
        _g = ui.datagrid_on_header_click(g) callback |c: int| {
            _s = call_ii_str_(p, ref, c, 0, "a ui.datagrid header-click handler")
            settle_(p)
        }
    }
    return ""
}

dg_on_edit_(p: *Page, g: @keep ptr, argv: int, argc: int, i: int) -> string {
    ctx = p.ctx
    if argc <= i || is_fn_arg_(ctx, argv, i) == 0 { return "fn must be a function (row, col, text) => void" }
    ref = hold_arg_(ctx, argv, i)
    _g = ui.datagrid_on_edit(g) callback |r: int, c: int, t: string| {
        call_iis_(p, ref, r, c, t, "a ui.datagrid edit handler")
        settle_(p)
    }
    return ""
}

// ui.datagrid(rows, cols, visRows, visCols, frozen, block?) -> a handle: a
// grid of rows x cols cells whose text comes from its cell function as each
// is shown, so a model of millions of rows costs nothing until scrolled to.
// The block configures it (cells, headers, on_cell_*, column_width, ...);
// a function of one or more parameters there is the cell function itself.
sae_ui_datagrid(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    rows = arg_int_(ctx, argv, argc, 0, 0)
    cols = arg_int_(ctx, argv, argc, 1, 0)
    vr = arg_int_(ctx, argv, argc, 2, 20)
    vc = arg_int_(ctx, argv, argc, 3, 6)
    fz = arg_int_(ctx, argv, argc, 4, 0)
    if rows < 0 || cols < 0 || vr < 1 || vc < 0 || fz < 0 { return sae_throw_type_error(ctx, "ui.datagrid(rows, cols, visRows, visCols, frozen, block): counts must be positive") }
    if vr * (fz + vc) > DATAGRID_MAX_SHOWN { return sae_throw_type_error(ctx, "ui.datagrid: at most ${DATAGRID_MAX_SHOWN} cells may be shown at once") }
    if argc >= 6 && is_fn_arg_(ctx, argv, 5) == 0 { return sae_throw_type_error(ctx, "ui.datagrid(..., block): block must be a function") }
    long t = now_ns_()
    g = ui.datagrid(mem.long_to_ptr(top_(p)), rows, cols, vr, vc, fz)
    ui_done_(p, t)
    list.add(p.dgrids, g)
    hnd = list.size(p.dgrids)
    if argc >= 6 {
        fh = quickjs.arg(ctx, argv, 5)
        nparams = js_length_(p, fh)
        quickjs.release(ctx, fh)
        if nparams >= 1 {
            _e = dg_cells_(p, g, argv, argc, 5)
        } else {
            if push_(p, ui.datagrid_widget(g)) == 0 { return sae_throw_type_error(ctx, "containers nested too deeply") }
            r = call_arg_(p, argv, 5)
            pop_(p)
            if r < 0 { return rethrow_(ctx) }
        }
    }
    return quickjs.new_int(ctx, hnd)
}

