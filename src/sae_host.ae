    n = vg_node_of_(page_of_(ctx), arg_int_(ctx, argv, argc, 0, 0))
    if n == null { return sae_throw_type_error(ctx, "vg.set_fill(h, color): h is not a vg shape") }
    vg.element_set_fill(vg.node_element(n), arg_str_(ctx, argv, argc, 1))
    vg_repaint_(n)
    return sae_js_undefined()
}

