    vg.element_set_text(vg.node_element(n), arg_str_(ctx, argv, argc, 1))
    vg_repaint_(n)
    return 0
}

sae_vg_set_stroke(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_int_, arg_num_, arg_str_, own_, quickjs, sae_throw_type_error, vg, vg_node_of_, vg_repaint_
