sae_ui_toggle(ctx: ptr, this_val: ptr, argc: int, argv: ptr) -> long {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, sae_new_context, JS_Parse, JS_Run, JS_FreeContext
    p = page_of_(ctx)
    label = own_(arg_str_(ctx, argv, argc, 0))
    ref = held_fn_(ctx, argv, argc, 1)
    long t = now_ns_()
    h = ui.toggle(mem.long_to_ptr(top_(p)), label, |on: int| { fire_num_(ctx, ref, on, "a toggle handler") })
    ui_done_(p, t)
    return JS_NewInt32(ctx, h)
}

