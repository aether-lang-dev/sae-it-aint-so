// ui.width(h) / ui.height(h): a widget's laid-out size, in pixels.
// ui.on_layout(h, fn(w, h)) -> h: a stack the page made was laid out at a
// new size (w, h, in px): after its allocation settles and changes, not per
// frame (aether-ui's on_layout, on every backend). Widgets may be built or
// changed from the handler.
sae_ui_on_layout(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    lb_ = p.browser as *Browser
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(p, h) == 0 || own_stack_(p, h) == 0 || in_list_(p.grids, h) == 1 { return sae_throw_type_error(ctx, "ui.on_layout(h, fn): h is not a stack (vstack or hstack) this page made") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.on_layout(h, fn): fn must be a function") }
    ref = hold_arg_(ctx, argv, 1)
    track_(p, h, ref)
    seq = p.seq
    ui.on_layout(h) callback |w: int, hh: int| {
        if ae_live_(lb_, ctx, seq) == 0 { return }
        if call_nums_(p, ref, w * 1.0, hh * 1.0, 2) < 0 { report_exception_(p, "a layout handler") }
        settle_(p)
    }
    return quickjs.new_int(ctx, h)
}

// ui.on_resize(fn(w, h)): the window's content was laid out at a new size
// (w, h, in px; in the browser, the chrome included): told once soon after
// with the size it is, then on every change. One handler a page; a second
// replaces the first; it goes with the page.
sae_ui_on_resize(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "ui.on_resize(fn): fn must be a function") }
    p.on_resize = hold_arg_(ctx, argv, 0)
    b = p.browser as *Browser
    if b.win_w > 0 {
        seq = p.seq
        _t = ui.timer_once(1, || {
            lp = page_of_(b, ctx)
            if lp == null || lp.seq != seq || lp.on_resize == 0 { return }
            lb = lp.browser as *Browser
            resize_to_page_(lp, lb.win_w, lb.win_h)
        })
    }
    return 0
}

