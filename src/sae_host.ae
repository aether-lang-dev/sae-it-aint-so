// polygon(points, fn?) and polyline(points, fn?): points as SVG writes them
// ("x,y x,y ...") or as a flat array of numbers; a path underneath, as
// aether-ui's transpiler and loader draw them.
ae_points_arg_(p: *Page, argv: int, argc: int) -> string {
    ctx = p.ctx
    if argc < 1 { return "" }
    h = quickjs.arg(ctx, argv, 0)
    t = quickjs.type_of(ctx, h)
    if t == "string" {
        quickjs.release(ctx, h)
        return own_(arg_str_(ctx, argv, argc, 0))
    }
    n = js_length_(p, h)
    sb = strbuilder.new(64)
    i = 0
    while i < n {
        if i > 0 {
            if i % 2 == 1 { _c = strbuilder.append(sb, ",") } else { _s = strbuilder.append(sb, " ") }
        }
        _v = strbuilder.append(sb, ae_index_str_(p, h, i))
        i = i + 1
    }
    quickjs.release(ctx, h)
    return strbuilder.finish(sb)
}

sae_ae_polygon(p: *Page, this_val: int, argv: int) -> int {
    seal except ae_points_arg_, ae_shape_done_, aevg_K_SHAPE, quickjs, sae_throw_type_error, utils, vg, vg_scene_open_, vg_top_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(p) == 0 { return sae_throw_type_error(ctx, "vg.polygon() must be called inside vg.scene()") }
    n = vg.path(vg_top_(p), utils.points_to_path(ae_points_arg_(p, argv, argc), 1))
    return ae_shape_done_(p, argv, argc, 1, n, K_SHAPE)
}

sae_ae_polyline(p: *Page, this_val: int, argv: int) -> int {
