// sae's host: the browser window, one QuickJS runtime per page
// (contrib.quickjs), and the page API that runtime can reach.
//
// The page API mirrors the Aether DSL. In Aether, `vstack(4) { ... }` makes a
// handle, attaches it to the ambient `_ctx`, and runs the trailing block with
// `_ctx` set to that handle. Here a page calls `ui.vstack(4, function () {
// ... })` and the host does the same thing at run time with a stack of
// handles: push, call the function, pop. The bottom of the stack is the
// browser's content area, so a page's top-level widgets land there.
//
// Navigation is deferred. A page asks for it (browserContext.changePage)
// from inside its own JS, often from a click handler whose button is about to
// be destroyed; so the request is recorded and carried out on the next turn
// of the event loop, after the JS call has returned.

import ui hiding (open_url, print_pdf, clipboard_read, clipboard_write)
import std.mem
import std.fs
import std.os
import std.list
import std.strarr
import std.string
import std.http.client hiding (request)
import std.tcp
// HTTPS in a build without OpenSSL (every cross-build, including Android):
// std.http.client uses the pure-Aether TLS 1.3 client when it is linked.
import std.cryptography.tls13_client
import lower
import lower (Lowered)
import vg
import vg.live
import std.json
import services.files
import services.documents
import services.pagegrants
import services.sandboxprobe
import services.clipboard
import services.bus
import services.channel
import services.backend
import services.shell
import services.print as printing
import services.net
import services.sqlite
import services.stdlib
import natives
import contrib.quickjs
// wave1/aevg: the scene record and the grammar modules its surface reaches.
import aevg
import aevg (AeModel, AeScene, AeRec, K_SCENE, K_GROUP, K_SHAPE, K_TEXT)
import vg.grammar.events
import vg.grammar.element
import vg.grammar.element (SHAPE_CIRCLE, SHAPE_RECT, SHAPE_LINE)
import vg.grammar.utils
import std.strbuilder
import std.worker

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern sae_stdout() -> ptr
extern sae_stderr() -> ptr
extern putchar(c: int) -> int
extern fputs(s: string, stream: ptr) -> int
extern fflush(stream: ptr) -> int
extern aether_ui_vstack_create(spacing: int) -> int
extern aether_ui_surface_flush_deferred_impl()
extern aether_ui_widget_count_impl() -> int
extern aether_ui_test_server_banner_handle() -> int
extern aether_ui_current_sheet_set_impl(sheet: ptr)
extern aether_ui_widget_parent_impl(handle: int) -> int

const STACK_MAX = 64
// A vg handle is VG_BASE + its index in the page's vg_nodes: apart from every
// widget handle (aether-ui numbers widgets from 1, one at a time), so a
// function that takes either (ui.a11y_label(h, ...)) knows which it was given.
const VG_BASE = 1073741824
// A page's runtime: its heap cap, and how long one entry into its JS (the
// page's run, a handler, a timer, an http callback) may take before it is
// stopped. A page that loops forever is interrupted, not the browser hung.
const PAGE_MEM_DEFAULT = 33554432
const PAGE_TIME_MS = 5000

const NAV_NONE = 0
const NAV_GO = 1
const NAV_BACK = 2
const NAV_FORWARD = 3
const NAV_RELOAD = 4


// The browser: chrome widgets, history, and the page currently shown.
struct Browser {
    addr: int        // address field
    status: int      // status line
    content: int     // the content area pages build into
    history: ptr     // std.strarr of URL copies; entries past hist_len are stale
    hist_len: int
    hist_index: int
    page: ptr        // *Page, or null
    pending_kind: int
    pending_url: string
    nav_timer: int
    page_mem: long
    probe_dir: string  // SAE_SANDBOX_PROBE: the canary folder of the sandbox probe (tests), "" when off
    probe_port: int    // AETHER_UI_TEST_PORT, which the probe tries to connect to
    later: ptr         // std.list of *LaterJob: effects a page asked for, done once no entry is running ("after the entry")
    later_timer: int   // the UI timer taking them, or 0 while none wait
    app_data: string   // the app's data folder (app_data_dir_), worked out once at start: bus.serve starts the bus in an entry
    entry_depth: int   // entries running now, all pages (entry_begin_); a kernel tick waits for 0
    page_time_ms: int  // a page's time limit for one entry (SAE_PAGE_TIME_MS), read once at start: no entry reads the environment
    last_ok: int     // did the last load fetch and run cleanly
    root: int        // the window's own stack (chrome and content): its size is the window's
    menu_h: int      // the context menu (one aether-ui menu, built again each time it opens), or 0
    body: int        // the scroller pages build into: a right click there is the page's
    source: string   // the current page's source as fetched ("View page source")
    win_w: int       // the window's content size, as on_layout last gave it (0 before)
    win_h: int
    // The app's backend (docs/app-backend.md): its own process.
    backend_declared: int  // 1: app.json declares one (a page may seek it, even if it did not start)
    backend: ptr     // services/backend's instance, or null (none declared, or it never started)
    backend_why: string  // why there is none running, "" while it runs
    backend_ids: int     // the last call id handed out
    backend_calls: ptr   // std.list of *BackendCall: calls not yet answered
    backend_timer: int   // the UI timer reading its frames, or 0
    backend_deadline_ms: int  // a call not answered in this is failed (app.json deadlineMs)
    backend_decl: ptr    // *BackendDecl: how to start it (again, for backend.restart), or null
    backend_restarts: ptr  // std.list of *BackendRestart: pages waiting for a restart to settle
    // The control channel (--control-stdio, services/channel): the program
    // that started sae drives the app over sae's stdin and stdout.
    control: ptr     // services/channel's instance, or null (not started that way)
    control_timer: int   // the UI timer reading it, or 0
    // The control bus (--control-bus, services/bus): this launch's instance,
    // declared or not.
    bus: ptr
    // The kernel's side of serving either one ("The control bus" below):
    // the page whose handler serves and the request it has, for the bus or
    // the channel, whichever this launch has.
    bus_flag: int        // the person started the app with --control-bus
    uncontained: int     // the person started the app with --uncontained-backend
    bus_ui_granted: int  // app.json capabilities.controlBus.ui: the UI driver's keys, pointer and screenshots, over the bus
    bus_page: ptr        // the *Page whose handler serves, or null
    bus_timer: int       // the UI timer reading the bus, or 0
    bus_told_off: int    // 1 once "control bus: off" has been said
    bus_inflight: int    // the request with the page, or 0
    bus_since: long      // when it was handed to the page
    bus_interrupted: int // the page's time limit stopped the request in flight
    bus_ui_pending: ptr  // std.list of *BusUi: @ui requests waiting on the driver
    // The services' instances (services/*): what this launch grants, read
    // from app.json in app mode; a web page's are made and left unconfigured.
    files: ptr       // services/files
    documents: ptr   // services/documents
    clipboard: ptr   // services/clipboard
    shell: ptr       // services/shell
    printing: ptr    // services/print
    net: ptr         // services/net: capabilities.http
    stdlib: ptr      // services/stdlib: the sae: library
    // The kernel's job tables: work a page asked for that finishes later.
    sqlite_jobs: *SqliteJobs   // wave1/sqlite: the app's databases and the calls on them
    native_jobs: *NativeJobs   // wave1/natives: the app's native modules and the calls on them
    http_jobs: *HttpJobs       // http.get/post: the fetchers and the requests in flight
    // App mode (`sae --app <dir>`, or a packaged .app): the folder of pages
    // the app is made of, "" in browser mode. Its pages are app:/<path> URLs,
    // mapped onto <dir>/<path>.ts or .js the way tools/pageserver maps a site.
    app_dir: string
    app_name: string
    app_key: string   // app mode: app_storage_key_, set at start ("" in the browser)
    pages: ptr       // std.list of *Page: the pages whose runtimes are live (one, as a rule)
    page_seq: int    // the last page load's number
    clock: *Clock    // the clocks pages read (SAE_TIME_SCALE)
    gesture: int     // what the person is doing while a handler runs (fire_click_)
    // ui.menu's bar ("ui.menu" below).
    menu_bar: int    // the bar the menus go on, or 0
    menu_bar_seq: int    // the page load that made it
    app_menus: ptr   // std.list: the menus of the current page's bar, emptied with the next page's
    menu_open: int   // the menu whose block is running, or 0
    window_up: int   // 1 once window_run has made the window
    keys_hooked: int // 1 once the window's key hook is made (keys_hook_)
    esc_coarse: int  // wave1/escape: 0 not decided yet, 1 the clocks are fine, 2 coarse
    clip_read_granted: int   // app.json grants clipboard "read"
    nav_typed: int   // 1 while the pending navigation is one typed into the address bar
}

// The clocks pages read (Date.now, new Date(), performance.now): real, or
// under SAE_TIME_SCALE=<n> n times fast from the moment each is first read,
// so a spec can watch a minute-long timer finish in seconds.
struct Clock {
    scale: int       // 0 not read yet, 1 real time, n > 1 n times fast
    base_mono: long  // the monotonic clock's first reading under a scale
    base_unix: long  // the wall clock's
}

// A call to the backend not yet answered: which page made it (an answer for
// a page that has gone is dropped) and when (its deadline).
struct BackendCall {
    id: int
    seq: int
    since: long
}

// What app.json capabilities.backend declares, kept to start it again.
struct BackendDecl {
    wslc: int        // 1: a Linux program in a WSL container (program is the image)
    socket: int      // 1: channel "socket" (docs/design/ipc-backends.md)
    program: string  // the program as app.json names it, inside the app; or the image
    args: ptr        // std.list: its arguments, or the wslc command
    grants: ptr      // std.list of "kind value" (services/backend.start_socket), or null: sandbox "none"
}

// A page waiting for backend.restart() to settle (its id, its page).
struct BackendRestart {
    id: int
    seq: int
}

// One per loaded page: its QuickJS runtime (ctx), found again from the
// runtime by page_of_.
struct Page {
    ctx: ptr         // the page's contrib.quickjs runtime
    browser: ptr     // *Browser
    url: string
    stack: ptr       // handles, STACK_MAX ints
    depth: int
    ui_ns: long      // time spent inside ui builders (excludes nested page blocks)
    ui_calls: int
    // AeVG: a second stack, of vg nodes. vg.scene pushes its root, each
    // shape with a block pushes itself; fill/stroke/... act on the top.
    vg_stack: ptr    // STACK_MAX node pointers
    vg_depth: int
    vg_nodes: ptr    // std.list: the nodes handed to the page (handle = VG_BASE + index + 1)
    vg_keys: ptr     // std.list of *VgKey: the canvases vg.on_key hears, one entry each
    // Widget handles are never reused, so every widget this page made has a
    // handle at least first_handle. A page may name only those: not the
    // address bar, the status line, the driver's banner or a past page's.
    first_handle: int
    stacks: ptr      // std.list: the vstack/hstack/grid handles this page made
    grids: ptr       // std.list: the grid handles this page made
    root: int        // the page's own stack in the content area: its widgets
                     //   go in it, its styles stop at it, it goes with the page
    sheet: ptr       // the page's AeCS sheet (ui.styles), or null
    sheet_strs: ptr  // std.list: selector and family strings the sheet borrows
    timers: ptr      // std.list of *PageTimer: the page's timer queue ("the page API: timers")
    timer_ids: int   // the last timer id handed out
    timer_seq: int   // queue order
    timer_nesting: int // the running timer callback's nesting level, 0 outside one
    timers_running: int // 1 while a wake runs the queue
    wake: int        // the aether-ui one-shot armed for the earliest timer, or 0
    wake_due: long   // the due time it is armed for
    rafs: ptr        // std.list of *PageRaf: the next frame's callbacks
    raf_batch: ptr   // the frame's callbacks while they run, else null
    raf_ids: int     // the last animation-frame id handed out
    frame_sub: int   // the aether-ui on_frame subscription while rafs wait, or 0
    seq: int         // which load this is: an http reply for an older page is dropped
    http_res: int    // the page's response-object maker (http_helpers_), or 0
    http_req: int    // the page's request-object maker
    on_resize: int   // the page's ui.on_resize handler (a held ref), or 0
    on_appearance: int   // the page's ui.on_appearance handler (a held ref), or 0
    on_interrupted: int  // the page's ui.on_interrupted handler (a held ref), or 0
    interrupting: int    // 1 while that handler runs (a limit it meets itself is not told again)
    http_scopes: string // its outgoing-http scopes, "VERBS\tabsolute-pattern\n"
                     //   per line, or "" when it seeks outgoing-http unscoped
    absent: string   // privileges it can do without and was not granted, as
                     //   ",local-filesystem,": their objects are not installed
    // ===== wave1/imports: the page's module registry (README "Modules") =====
    modules: ptr     // std.list of *PageModule: the page's import closure, run
    mod_get: int     // $sae.m, the host function (api_register_)
    mod_fail: int    // reports a rejection after a top-level await
    mod_factory: int // the JS factory making each unit's $sae object, or 0
    wrapped: int     // 1: the lowered page is a function to call with $sae
    key_ref: int     // ui.on_key's held function, or 0
    bus_ref: int     // bus.serve's dispatcher (the page's handler, wrapped), or 0
    bus_stopped_ref: int  // bus.serve's second function: told when a request was stopped, or 0
    backend_ref: int // the backend object's dispatcher (answers, events, its end), or 0
    dgrids: ptr      // std.list of aether-ui datagrids this page made (ui.datagrid)
    menus: ptr       // std.list of *PageMenu: ui.context_menu's targets and items
    held: ptr        // std.list of *HeldRef: the callbacks widgets hold, to let go with their widget
    sqlite_fns: ptr  // wave1/sqlite: its *SqlitePageFns, made on first use, or null
    natives_set: string  // wave1/natives: the modules it gets, as ",engine,", worked out at api_register_
    esc_logged_http: int     // wave1/escape: each cap's refusal logged once per page
    esc_logged_timers: int
    esc_logged_storage: int
    rasters: ptr     // wave1/raster: std.list of *PageRaster, freed with the page
    ae: ptr          // wave1/aevg: its *AePage, made on first use, or null
    // What its lowering said (lower.Lowered): the privileges it seeks, as
    // ",local-filesystem,", those it can do without, and its imports
    // ("spec\tline\tcol" per line); `wrapped` above is the fourth.
    seeks: string
    optional: string
    imports: string
    // The page's storage folder (storage_dir_), worked out and made once in
    // page_new_: storage calls and the page's sandbox grant use it, and none
    // reads the environment or resolves a path again.
    storage_dir: string
    grants: ptr      // the grant list its entries run under (services/pagegrants), made in page_new_, freed with the page
    entry_depth: int  // entries into this page's JS running now (entry_begin_): 0 outside any
}

// A JS function a widget holds for its callback (a click, a change, a
// context menu's items), noted with the widget so it can be let go when the
// widget is destroyed: without that a page that builds part of itself again
// (a row of tabs, a panel) keeps every callback it ever made, and whatever
// each one closes over, for as long as the page lives.
struct HeldRef {
    widget: int
    ref: int
    kind: int        // HK_PLAIN, or HK_CHANGE: a textfield's change handler, set by onchange()
}

const HK_PLAIN = 0
const HK_CHANGE = 1

// ui.context_menu(target, items): a widget's, a vg shape's or the whole
// page's (target 0) menu items, the page's array held and read again each
// time the menu opens, so the page changes it by changing the array.
struct PageMenu {
    target: int
    items: int       // the held items array
}

// The live page whose runtime is ctx, or null once that page is gone: what
// a callback that outlives its page (a timer, a canvas's click) checks.
page_of_(b: *Browser, ctx: ptr) -> *Page {
    pages = b.pages
    n = list.size(pages)
    i = 0
    while i < n {
        pv, _ = list.get(pages, i)
        pp = pv as *Page
        if pp.ctx == ctx { return pp }
        i = i + 1
    }
    return null
}

sae_throw_type_error(ctx: ptr, msg: string) -> int {
    return quickjs.throw_error(ctx, "TypeError", msg)
}

browser_of_(p: *Page) -> *Browser {
    return p.browser as *Browser
}

// An owned copy of a borrowed string (a JS_ToCStringLen result, say).
own_(s: string) -> string {
    return string.concat(s, "")
}

// An environment variable's value, "" when unset (os.getenv gives null).
env_(name: string) -> string {
    v = os.getenv(name)
    if v == null { return "" }
    return v
}

us_(ns: long) -> long { return ns / 1000 }

// The clocks, for page-API functions, which cannot name `os` (see "The page
// veto" below).
now_ns_() -> long { return os.now_monotonic_ns() }
now_ms_(c: *Clock) -> long { return scaled_(c, os.now_monotonic_ms(), 0) }
now_unix_ms_(c: *Clock) -> long { return scaled_(c, os.now_unix_ms(), 1) }

// The gap between a stack's or grid's children when the page gives none.
const SPACING = 4

// SAE_TIME_SCALE=<n> runs the clocks pages see (Date.now, new Date(),
// performance.now) n times fast, from the moment each is first read. Off
// (1x) unless set. The variable is read once, by clock_start_ at the
// browser's start: a clock read happens inside a page entry, which does not
// read the environment.
clock_start_(c: *Clock) {
    c.scale = 1
    sv = env_("SAE_TIME_SCALE")
    if sv != "" {
        n, nerr = string.to_int(sv)
        if nerr == "" && n > 1 { c.scale = n }
    }
}

scaled_(c: *Clock, real: long, which: int) -> long {
    if c.scale == 1 { return real }
    if which == 0 {
        if c.base_mono == 0 { c.base_mono = real }
        return c.base_mono + (real - c.base_mono) * c.scale
    }
    if c.base_unix == 0 { c.base_unix = real }
    return c.base_unix + (real - c.base_unix) * c.scale
}

// --- reading a page-API call's arguments (args is the engine's array handle) ---

// Argument i as an owned string ("" past the end).
arg_str_(ctx: ptr, argv: int, argc: int, i: int) -> string {
    if i >= argc { return "" }
    return quickjs.arg_string(ctx, argv, i)
}

// 1 if argument i is a function.
is_fn_arg_(ctx: ptr, argv: int, i: int) -> int {
    h = quickjs.arg(ctx, argv, i)
    yes = 0
    if quickjs.type_of(ctx, h) == "function" { yes = 1 }
    quickjs.release(ctx, h)
    return yes
}

// A leading number a block may stand in for: vstack(() => ...) has no
// spacing, vstack(8, () => ...) has.
lead_int_(ctx: ptr, argv: int, argc: int, i: int, dflt: int) -> int {
    if i >= argc { return dflt }
    if is_fn_arg_(ctx, argv, i) == 1 { return dflt }
    return arg_int_(ctx, argv, argc, i, dflt)
}

arg_int_(ctx: ptr, argv: int, argc: int, i: int, dflt: int) -> int {
    if i >= argc { return dflt }
    return quickjs.arg_int(ctx, argv, i)
}

top_(p: *Page) -> int {
    return mem.get_int(p.stack, (p.depth - 1) * 4)
}

push_(p: *Page, handle: int) -> int {
    if p.depth >= STACK_MAX { return 0 }
    mem.set_int(p.stack, p.depth * 4, handle)
    p.depth = p.depth + 1
    return 1
}

pop_(p: *Page) {
    if p.depth > 0 { p.depth = p.depth - 1 }
}

// Call a held JS function with no arguments: 0, or -1 if it threw (the
// error is in quickjs.last_error). Its promise jobs run after it.
call0_(p: *Page, f: int) -> int {
    ctx = p.ctx
    // The call holds a reference of its own: a handler may destroy its own
    // widget, which lets go of f (drop_held_), while it is still running.
    g = quickjs.dup(ctx, f)
    r, err = js_call_(p, g, 0, 0)
    quickjs.release(ctx, g)
    if err != "" { return 0 - 1 }
    quickjs.release(ctx, r)
    return 0
}

// Call argument i (a function) with no arguments, as call0_.
call_arg_(p: *Page, argv: int, i: int) -> int {
    ctx = p.ctx
    f = quickjs.arg(ctx, argv, i)
    r = call0_(p, f)
    quickjs.release(ctx, f)
    return r
}

// Call a held function with the elements of an args array: as call0_.
calln_(p: *Page, f: int, args: int) -> int {
    ctx = p.ctx
    g = quickjs.dup(ctx, f)
    r, err = js_call_(p, g, 0, args)
    quickjs.release(ctx, g)
    if err != "" { return 0 - 1 }
    quickjs.release(ctx, r)
    return 0
}

// A host function's nested call threw: throw that same exception on from
// this call, so the page's catch gets its class and stack, not a copy.
rethrow_(ctx: ptr) -> int {
    return quickjs.rethrow(ctx)
}

// Run the promise jobs a callback queued (its awaits, its .then()s). A job
// the page's time limit stopped while a control-bus request was with the
// page stopped that request: the bus tick answers it and tells the page.
settle_(p: *Page) {
    ctx = p.ctx
    n, err = js_run_jobs_(p)
    if n < 0 {
        say_("sae: uncaught exception in a promise job:\n${err}")
        if p != null {
            b = p.browser as *Browser
            if b.bus_inflight != 0 && string.contains(err, "interrupted") == 1 { b.bus_interrupted = 1 }
        }
        note_interrupted_(p, err)
    }
    // A vg scene made in a handler (a drawing floated over a grid, a chart)
    // records its shapes until it is told to draw: now, its canvas made at
    // its final size gets no resize to do it.
    aether_ui_surface_flush_deferred_impl()
}

// Run a held handler with no arguments, as a widget does when it fires:
// report what it throws, then run the promise jobs it queued.
fire0_(p: *Page, ref: int, what: string) {
    ctx = p.ctx
    if call0_(p, ref) < 0 { report_exception_(p, what) }
    settle_(p)
}

// What the person is doing while a page's handler runs, for the clipboard
// (services/clipboard): b.gesture is 0 nothing (a timer, a frame, a reply),
// 1 a click or a key, 2 their paste (Ctrl or Cmd+V). Set around a click's or
// a key's handler and the promise jobs it queued, then put back.
fire_click_(p: *Page, ref: int) {
    b = browser_of_(p)
    was = b.gesture
    b.gesture = 1
    fire0_(p, ref, "a click handler")
    b.gesture = was
}

report_exception_(p: *Page, where_: string) {
    ctx = p.ctx
    err = quickjs.last_error(ctx)
    say_("sae: uncaught exception in ${where_}:\n${err}")
    note_interrupted_(p, err)
}

// An entry into the page's JS the time limit stopped (its error says
// "interrupted"): the work it was part of, a promise job, never comes back,
// and nothing in the page can know, as no finally runs. The page's
// ui.on_interrupted handler is told, in an entry of its own, to fail what
// was waiting on it. The control bus's request in flight is answered
// separately (bus.serve's stopped).
note_interrupted_(p: *Page, err: string) {
    ctx = p.ctx
    if string.contains(err, "interrupted") == 0 { return }
    if p == null || p.on_interrupted == 0 || p.interrupting == 1 { return }
    p.interrupting = 1
    if call0_(p, p.on_interrupted) < 0 { report_exception_(p, "an interrupted handler") }
    settle_(p)
    p.interrupting = 0
}

// A line on stdout through C stdio, flushed, as print's output is: the two
// cannot interleave, and a spec watching the log sees it at once.
say_(s: string) {
    out = sae_stdout()
    fputs(s, out)
    putchar(10)
    fflush(out)
}

// Keep a JS value alive for as long as the page lives: a handle of the
// page's own, released when the page's runtime is.
hold_(ctx: ptr, h: int) -> int {
    return quickjs.dup(ctx, h)
}

// Hold argument i.
hold_arg_(ctx: ptr, argv: int, i: int) -> int {
    return quickjs.arg(ctx, argv, i)
}

// Note that held function `ref` is widget `h`'s callback, to be let go of
// when h is destroyed (drop_held_).
track_(p: *Page, h: int, ref: int) {
    if ref == 0 || h == 0 { return }
    e = heap.new(HeldRef)
    e.widget = h
    e.ref = ref
    e.kind = HK_PLAIN
    list.add(p.held, e as ptr)
}

// Is widget `w` the widget `root`, or inside it?
under_(w: int, root: int) -> int {
    cur = w
    steps = 0
    while cur > 0 && steps < 1024 {
        if cur == root { return 1 }
        cur = aether_ui_widget_parent_impl(cur)
        steps = steps + 1
    }
    return 0
}

// The widgets inside `root` (and root itself when `self_too`) are about to be
// destroyed: let go of the callbacks they hold and the context menus they
// carry, and forget them as stacks. Called before they go, while the tree
// can still be walked. A handler of theirs running right now is safe: the
// calls into JS hold a reference of their own (hold_call_).
drop_held_(ctx: ptr, p: *Page, root: int, self_too: int) {
    if root == 0 { return }
    kept = list.new()
    n = list.size(p.held)
    i = 0
    while i < n {
        v, _ = list.get(p.held, i)
        e = v as *HeldRef
        if under_(e.widget, root) == 1 && (self_too == 1 || e.widget != root) {
            if e.ref != 0 { quickjs.release(ctx, e.ref) }
            heap.free(e)
        } else {
            list.add(kept, v)
        }
        i = i + 1
    }
    list.free(p.held)
    p.held = kept
    mkept = list.new()
    n = list.size(p.menus)
    i = 0
    while i < n {
        v, _ = list.get(p.menus, i)
        pm = v as *PageMenu
        if pm.target > 0 && pm.target < VG_BASE && under_(pm.target, root) == 1 && (self_too == 1 || pm.target != root) {
            quickjs.release(ctx, pm.items)
            heap.free(pm)
        } else {
            list.add(mkept, v)
        }
        i = i + 1
    }
    list.free(p.menus)
    p.menus = mkept
    p.stacks = forget_under_(p.stacks, root, self_too)
    p.grids = forget_under_(p.grids, root, self_too)
}

// A list of widget handles, less those inside `root` (and root itself when
// `self_too`).
forget_under_(l: ptr, root: int, self_too: int) -> ptr {
    kept = list.new()
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        w = mem.ptr_to_long(v) as int
        if under_(w, root) == 1 && (self_too == 1 || w != root) { } else { list.add(kept, v) }
        i = i + 1
    }
    list.free(l)
    return kept
}

// A container builder: make it under the current top, then run the page's
// block function (its last argument) with it on top. The pop happens even if
// the block throws, so later widgets never attach to the wrong parent.
container_(p: *Page, argv: int, argc: int, handle: int) -> int {
    ctx = p.ctx
    if argc == 1 && is_fn_arg_(ctx, argv, 0) == 0 { return quickjs.new_int(ctx, handle) }
    if argc >= 1 {
        if is_fn_arg_(ctx, argv, argc - 1) == 0 {
            return sae_throw_type_error(ctx, "container block must be a function")
        }
        if push_(p, handle) == 0 {
            return sae_throw_type_error(ctx, "containers nested too deeply")
        }
        r = call_arg_(p, argv, argc - 1)
        pop_(p)
        if r < 0 { return rethrow_(ctx) }
    }
    return quickjs.new_int(ctx, handle)
}

// Is `h` a widget this page made? (See Page.first_handle.)
owned_(p: *Page, h: int) -> int {
    if h < p.first_handle { return 0 }
    // The driver's banner is made lazily, on its first request, so in a
    // sae-driver build it can land among the first page's handles.
    if h == aether_ui_test_server_banner_handle() { return 0 }
    return 1
}

// Is `h` a vstack, hstack or grid this page made?
own_stack_(p: *Page, h: int) -> int {
    return in_list_(p.stacks, h)
}

in_list_(l: ptr, h: int) -> int {
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        if mem.ptr_to_long(v) == h { return 1 }
        i = i + 1
    }
    return 0
}

// Account a builder call's native time to the page, so the timing report
// can split engine time from widget-creation time.
ui_done_(p: *Page, t: long) {
    p.ui_ns = p.ui_ns + (os.now_monotonic_ns() - t)
    p.ui_calls = p.ui_calls + 1
}

// --- The page veto ---
//
// Every function a page can reach (everything api_register_ below installs
// in a page's runtime) opens with the same `hide`
// line. It takes the kernel out of that function's scope: the file system,
// the environment and clocks (`os`), the network (`client`, and `net`,
// services/net, the one place a request is opened), the lowerer,
// the page-lifecycle functions that fetch, parse and run pages, and the
// engine's raw parse/run/context calls. Naming any of them in a page-API
// function, at any depth (an `if` body, a nested block, a closure), is a
// compile error.
//
// What a page-API function may use of the kernel, it reaches through named
// helpers: `request_nav_` (navigation, deferred to the event loop),
// `resolve_` (URL arithmetic), `now_ns_`/`now_ms_`/`now_unix_ms_` (clocks).
//
// This is Aether's compile-time `hide` (aether/docs/hide-and-seal.md):
// it stops a page-facing function from naming the kernel, not a helper it
// calls from doing so, so the helpers stay few and narrow. The list grows;
// the end state is `seal except`, a whitelist per function.
// tests/check_page_veto.sh fails if a page-API function lacks the line, or
// if the compiler does not enforce it.

// --- the page API: ui (installed by api_register_) ---

sae_ui_vstack(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    long t = now_ns_()
    h = ui.vstack(mem.long_to_ptr(top_(p)), lead_int_(ctx, argv, argc, 0, SPACING))
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    return container_(p, argv, argc, h)
}

sae_ui_hstack(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    long t = now_ns_()
    h = ui.hstack(mem.long_to_ptr(top_(p)), lead_int_(ctx, argv, argc, 0, SPACING))
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    return container_(p, argv, argc, h)
}

// wrap(block): a flow container (aether-ui's wrap: GtkFlowBox, AppKit's
// AetherWrapView, Win32's and UIKit's flow layouts, Android's AetherWrap):
// the block's widgets left to right, onto the next line when the width runs
// out, so a row of buttons and fields never asks for more than its window.
sae_ui_wrap(p: *Page, this_val: int, argv: int) -> int {
