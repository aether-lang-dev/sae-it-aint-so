    target = modifier_target_(ctx, "margin")
    if target == 0 { return sae_throw_type_error(ctx, "margin() must be called inside a container's block") }
    top = arg_int_(ctx, argv, argc, 0, 0)
    ui.margin(mem.long_to_ptr(target), top, arg_int_(ctx, argv, argc, 1, top), arg_int_(ctx, argv, argc, 2, top), arg_int_(ctx, argv, argc, 3, top))
    return sae_js_undefined()
}

