// vg.on_click(fn(x, y)): x and y are where the click landed, in the scene's
// viewBox coordinates.
sae_vg_on_click(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_shape_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.on_click() must be called inside a shape's block") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 {
        return sae_throw_type_error(ctx, "vg.on_click(fn): fn must be a function")
    }
    ref = hold_arg_(ctx, argv, 0)
    node = vg_top_(page_of_(ctx))
    scene = vg.node_scene(node)
    // AeVG hands the handler canvas pixels; a page thinks in its viewBox.
    // The mapping is read at click time, since a resize replaces it.
    vg.on_click(node, |x: float, y: float| {
        r = call_nums_(ctx, ref, vg.scene_px_to_vb_x(scene, x), vg.scene_px_to_vb_y(scene, y), 2)
        if r < 0 { report_exception_(ctx, "a vg click handler") }
        settle_(ctx)
    })
    return 0
}

