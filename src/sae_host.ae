// ui.datagrid_float(g, row, col, dx, dy, w, h): a container w x h px floating
// over the grid at (dx, dy) from the top-left of the cell at model row, model
// column, moving with it as the grid scrolls and clipped to the grid's body
// and at its freeze line (a float over the scrolling cells goes under the
// frozen columns and rows as the cells do); ui.into(f, ...) fills it. The
// pointer passes through it to the cells (ui.datagrid_float_takes_clicks(g, f, 1)
// makes it take the pointer). 0 when the grid already has 256.
sae_ui_datagrid_float(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    g = dgrid_arg_(p, argv, argc)
    if g == null { return sae_throw_type_error(ctx, "ui.datagrid_float: g is not a grid this page made") }
    w = arg_int_(ctx, argv, argc, 5, 0)
    h = arg_int_(ctx, argv, argc, 6, 0)
    if w < 1 || h < 1 || w > 8000 || h > 8000 { return sae_throw_type_error(ctx, "ui.datagrid_float(g, row, col, dx, dy, w, h): w and h are 1 to 8000") }
    f = ui.datagrid_float(g, arg_int_(ctx, argv, argc, 1, 0), arg_int_(ctx, argv, argc, 2, 0), arg_int_(ctx, argv, argc, 3, 0), arg_int_(ctx, argv, argc, 4, 0), w, h)
    if f != 0 { list.add(p.stacks, mem.long_to_ptr(f)) }
    return quickjs.new_int(ctx, f)
}

