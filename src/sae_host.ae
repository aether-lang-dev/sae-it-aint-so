// The handler's shape and its scene, for a modifier that takes fn.
ae_event_rec_(ctx: ptr, argv: int, argc: int, name: string) -> *AeRec {
    r = ae_modifier_rec_(ctx, name)
    if r == null || r.el == null { return null }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return null }
    r.interactive = 1
    return r
}

