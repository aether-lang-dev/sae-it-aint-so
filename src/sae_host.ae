}

// --- the page API: the menu bar (an installed app) ---
//
// ui.menu(label, fn): a menu on the app window's native menu bar
// (aether-ui's menu_bar: GTK4's GtkPopoverMenuBar, AppKit's NSMenu,
// Win32's menu), its items made by fn's ui.menu_item(label, fn) and
// ui.menu_separator() calls. Only an installed app has one: a web page in
// the browser may not touch the browser's own menus. The menus of one page
// load make one bar; a later page's ui.menu starts a bar of its own, which
// replaces it on the window. An item fires only for the page that made it
// (a past page's item does nothing). The bar and the menus are the
// Browser's (menu_bar, menu_bar_seq, app_menus, menu_open, window_up).

sae_ui_menu(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    b = browser_of_(p)
    if b.app_dir == "" { return sae_throw_type_error(ctx, "ui.menu: only an installed app has a menu bar (a web page may not change the browser's)") }
    if b.menu_open != 0 { return sae_throw_type_error(ctx, "ui.menu(label, fn): a menu inside a menu is not made yet") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.menu(label, fn): fn must be a function") }
    m = ui.menu(arg_str_(ctx, argv, argc, 0))
    b.menu_open = m
    r = call_arg_(p, argv, 1)
    b.menu_open = 0
    if r < 0 { return rethrow_(ctx) }
    if b.menu_bar == 0 || b.menu_bar_seq != p.seq {
        // A new page's bar: the last page's menus emptied first, so none of
        // their accelerators (a key GTK maps to an action, the driver's
        // registry) outlives the page that made them.
        k = 0
        while k < list.size(b.app_menus) {
            hv, _ = list.get(b.app_menus, k)
            ui.menu_clear(mem.ptr_to_long(hv) as int)
            k = k + 1
        }
        list.free(b.app_menus)
        b.app_menus = list.new()
        b.menu_bar = ui.menu_bar()
        b.menu_bar_seq = p.seq
    }
    list.add(b.app_menus, mem.long_to_ptr(m * 1))
    ui.menu_bar_add(b.menu_bar, m)
    // A bar made once the window is up goes on it now; before, window_run
    // attaches it as it makes the window.
    if b.window_up == 1 { ui.attach_menu_bar_to_window(1, b.menu_bar) }
    return quickjs.new_int(ctx, m)
}

// ui.menu_item(label, fn): an item of the menu whose block is running.
sae_ui_menu_item(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    lb_ = p.browser as *Browser
    argc = quickjs.arg_count(ctx, argv)
    mo = browser_of_(p).menu_open
    if mo == 0 { return sae_throw_type_error(ctx, "ui.menu_item(label, fn) must be called inside a ui.menu block") }
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.menu_item(label, fn): fn must be a function") }
    seq = p.seq
    ref = hold_arg_(ctx, argv, 1)
    ui.menu_item(mo, arg_str_(ctx, argv, argc, 0), || {
        if ae_live_(lb_, ctx, seq) == 1 { fire_click_(p, ref) }
    })
    return 0
}

// ui.menu_item_accel(label, accel, fn): an item with its accelerator, the
// platform's own ("Primary+S": Command on macOS, Ctrl elsewhere): drawn in
// the menu, and the key runs the item, once.
sae_ui_menu_item_accel(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
