// sae's host: the browser window, one QuickJS runtime per page
// (contrib.quickjs), and the page API that runtime can reach.
//
// The page API mirrors the Aether DSL. In Aether, `vstack(4) { ... }` makes a
// handle, attaches it to the ambient `_ctx`, and runs the trailing block with
// `_ctx` set to that handle. Here a page calls `ui.vstack(4, function () {
// ... })` and the host does the same thing at run time with a stack of
// handles: push, call the function, pop. The bottom of the stack is the
// browser's content area, so a page's top-level widgets land there.
//
// Navigation is deferred. A page asks for it (browserContext.changePage)
// from inside its own JS, often from a click handler whose button is about to
// be destroyed; so the request is recorded and carried out on the next turn
// of the event loop, after the JS call has returned.

import ui
import std.mem
import std.fs
import std.os
import std.list
import std.strarr
import std.string
import std.http.client
// HTTPS in a build without OpenSSL (every cross-build, including Android):
// std.http.client uses the pure-Aether TLS 1.3 client when it is linked.
import std.cryptography.tls13_client
import lower
import vg
import vg.live
import std.json
import std.actors
import services.files
import services.shell
import services.net
import services.sqlite
import services.stdlib
import contrib.quickjs
// wave1/aevg: the scene record and the grammar modules its surface reaches.
import aevg
import aevg (AeModel, AeScene, AeRec, K_SCENE, K_GROUP, K_SHAPE, K_TEXT)
import vg.grammar.events
import vg.grammar.element
import vg.grammar.element (SHAPE_CIRCLE, SHAPE_RECT, SHAPE_LINE)
import vg.grammar.utils
import std.strbuilder

extern malloc(n: long) -> ptr
extern free(p: ptr)
extern sae_stdout() -> ptr
extern putchar(c: int) -> int
extern fputs(s: string, stream: ptr) -> int
extern fflush(stream: ptr) -> int
extern aether_ui_vstack_create(spacing: int) -> int
extern aether_ui_surface_flush_deferred_impl()
extern aether_ui_widget_count_impl() -> int
extern aether_ui_test_server_banner_handle() -> int
extern aether_ui_current_sheet_set_impl(sheet: ptr)

const STACK_MAX = 64
// A page's runtime: its heap cap, and how long one entry into its JS (the
// page's run, a handler, a timer, an http callback) may take before it is
// stopped. A page that loops forever is interrupted, not the browser hung.
const PAGE_MEM_DEFAULT = 33554432
const PAGE_TIME_MS = 5000

const NAV_NONE = 0
const NAV_GO = 1
const NAV_BACK = 2
const NAV_FORWARD = 3
const NAV_RELOAD = 4

// App mode (`sae --app <dir>`, or a packaged .app): the folder of pages the
// app is made of, "" in browser mode. Its pages are app:/<path> URLs, mapped
// onto <dir>/<path>.ts or .js the way tools/pageserver maps a site.
var app_dir_ = ""
var app_name_ = ""
var page_seq_ = 0
var browser_: ptr = null   // the one browser, for completions that arrive later

// The browser: chrome widgets, history, and the page currently shown.
struct Browser {
    addr: int        // address field
    status: int      // status line
    content: int     // the content area pages build into
    history: ptr     // std.strarr of URL copies; entries past hist_len are stale
    hist_len: int
    hist_index: int
    page: ptr        // *Page, or null
    pending_kind: int
    pending_url: string
    nav_timer: int
    page_mem: long
    last_ok: int     // did the last load fetch and run cleanly
}

// One per loaded page: its QuickJS runtime (ctx), found again from the
// runtime by page_of_.
struct Page {
    ctx: ptr         // the page's contrib.quickjs runtime
    browser: ptr     // *Browser
    url: string
    stack: ptr       // handles, STACK_MAX ints
    depth: int
    ui_ns: long      // time spent inside ui builders (excludes nested page blocks)
    ui_calls: int
    // AeVG: a second stack, of vg nodes. vg.scene pushes its root, each
    // shape with a block pushes itself; fill/stroke/... act on the top.
    vg_stack: ptr    // STACK_MAX node pointers
    vg_depth: int
    vg_nodes: ptr    // std.list: the nodes handed to the page (handle = index + 1)
    // Widget handles are never reused, so every widget this page made has a
    // handle at least first_handle. A page may name only those: not the
    // address bar, the status line, the driver's banner or a past page's.
    first_handle: int
    stacks: ptr      // std.list: the vstack/hstack/grid handles this page made
    grids: ptr       // std.list: the grid handles this page made
    root: int        // the page's own stack in the content area: its widgets
                     //   go in it, its styles stop at it, it goes with the page
    sheet: ptr       // the page's AeCS sheet (ui.styles), or null
    sheet_strs: ptr  // std.list: selector and family strings the sheet borrows
    timers: ptr      // std.list of *PageTimer: the page's timer queue ("the page API: timers")
    timer_ids: int   // the last timer id handed out
    timer_seq: int   // queue order
    timer_nesting: int // the running timer callback's nesting level, 0 outside one
    timers_running: int // 1 while a wake runs the queue
    wake: int        // the aether-ui one-shot armed for the earliest timer, or 0
    wake_due: long   // the due time it is armed for
    rafs: ptr        // std.list of *PageRaf: the next frame's callbacks
    raf_batch: ptr   // the frame's callbacks while they run, else null
    raf_ids: int     // the last animation-frame id handed out
    frame_sub: int   // the aether-ui on_frame subscription while rafs wait, or 0
    seq: int         // which load this is: an http reply for an older page is dropped
    http_res: int    // the page's response-object maker (http_helpers_), or 0
    http_req: int    // the page's request-object maker
    http_scopes: string // its outgoing-http scopes, "VERBS\tabsolute-pattern\n"
                     //   per line, or "" when it seeks outgoing-http unscoped
    absent: string   // privileges it can do without and was not granted, as
                     //   ",local-filesystem,": their objects are not installed
    // ===== wave1/imports: the page's module registry (README "Modules") =====
    modules: ptr     // std.list of *PageModule: the page's import closure, run
    mod_get: int     // $sae.m, the host function (api_register_)
    mod_fail: int    // reports a rejection after a top-level await
    mod_factory: int // the JS factory making each unit's $sae object, or 0
    wrapped: int     // 1: the lowered page is a function to call with $sae
    key_ref: int     // ui.on_key's held function, or 0
}

// The pages whose runtimes are live (one in the browser, as a rule).
var pages_: ptr = null

// The page a runtime belongs to.
page_of_(ctx: ptr) -> *Page {
    n = list.size(pages_)
    i = 0
    while i < n {
        pv, _ = list.get(pages_, i)
        pp = pv as *Page
        if pp.ctx == ctx { return pp }
        i = i + 1
    }
    return null
}

sae_throw_type_error(ctx: ptr, msg: string) -> int {
    return quickjs.throw_error(ctx, "TypeError", msg)
}

browser_of_(ctx: ptr) -> *Browser {
    return page_of_(ctx).browser as *Browser
}

// An owned copy of a borrowed string (a JS_ToCStringLen result, say).
own_(s: string) -> string {
    return string.concat(s, "")
}

// An environment variable's value, "" when unset (os.getenv gives null).
env_(name: string) -> string {
    v = os.getenv(name)
    if v == null { return "" }
    return v
}

us_(ns: long) -> long { return ns / 1000 }

// The clocks, for page-API functions, which cannot name `os` (see "The page
// veto" below).
now_ns_() -> long { return os.now_monotonic_ns() }
now_ms_() -> long { return scaled_(os.now_monotonic_ms(), 0) }
now_unix_ms_() -> long { return scaled_(os.now_unix_ms(), 1) }

// SAE_TIME_SCALE=<n> runs the clocks pages see (Date.now, new Date(),
// performance.now) n times fast, from the moment each is first read, so a
// spec can watch a minute-long timer finish in seconds. Off (1x) unless set.
var time_scale_ = 0
// The gap between a stack's or grid's children when the page gives none.
const SPACING = 4

var time_base_mono_: long = 0
var time_base_unix_: long = 0

scaled_(real: long, which: int) -> long {
    if time_scale_ == 0 {
        time_scale_ = 1
        sv = env_("SAE_TIME_SCALE")
        if sv != "" {
            n, nerr = string.to_int(sv)
            if nerr == "" && n > 1 { time_scale_ = n }
        }
    }
    if time_scale_ == 1 { return real }
    if which == 0 {
        if time_base_mono_ == 0 { time_base_mono_ = real }
        return time_base_mono_ + (real - time_base_mono_) * time_scale_
    }
    if time_base_unix_ == 0 { time_base_unix_ = real }
    return time_base_unix_ + (real - time_base_unix_) * time_scale_
}

// --- reading a page-API call's arguments (args is the engine's array handle) ---

// Argument i as an owned string ("" past the end).
arg_str_(ctx: ptr, argv: int, argc: int, i: int) -> string {
    if i >= argc { return "" }
    return quickjs.arg_string(ctx, argv, i)
}

// 1 if argument i is a function.
is_fn_arg_(ctx: ptr, argv: int, i: int) -> int {
    h = quickjs.arg(ctx, argv, i)
    yes = 0
    if quickjs.type_of(ctx, h) == "function" { yes = 1 }
    quickjs.release(ctx, h)
    return yes
}

// A leading number a block may stand in for: vstack(() => ...) has no
// spacing, vstack(8, () => ...) has.
lead_int_(ctx: ptr, argv: int, argc: int, i: int, dflt: int) -> int {
    if i >= argc { return dflt }
    if is_fn_arg_(ctx, argv, i) == 1 { return dflt }
    return arg_int_(ctx, argv, argc, i, dflt)
}

arg_int_(ctx: ptr, argv: int, argc: int, i: int, dflt: int) -> int {
    if i >= argc { return dflt }
    return quickjs.arg_int(ctx, argv, i)
}

top_(p: *Page) -> int {
    return mem.get_int(p.stack, (p.depth - 1) * 4)
}

push_(p: *Page, handle: int) -> int {
    if p.depth >= STACK_MAX { return 0 }
    mem.set_int(p.stack, p.depth * 4, handle)
    p.depth = p.depth + 1
    return 1
}

pop_(p: *Page) {
    if p.depth > 0 { p.depth = p.depth - 1 }
}

// Call a held JS function with no arguments: 0, or -1 if it threw (the
// error is in quickjs.last_error). Its promise jobs run after it.
call0_(ctx: ptr, f: int) -> int {
    r, err = quickjs.call(ctx, f, 0, 0)
    if err != "" { return 0 - 1 }
    quickjs.release(ctx, r)
    return 0
}

// Call argument i (a function) with no arguments, as call0_.
call_arg_(ctx: ptr, argv: int, i: int) -> int {
    f = quickjs.arg(ctx, argv, i)
    r = call0_(ctx, f)
    quickjs.release(ctx, f)
    return r
}

// Call a held function with the elements of an args array: as call0_.
calln_(ctx: ptr, f: int, args: int) -> int {
    r, err = quickjs.call(ctx, f, 0, args)
    if err != "" { return 0 - 1 }
    quickjs.release(ctx, r)
    return 0
}

// A host function's nested call threw: throw that same exception on from
// this call, so the page's catch gets its class and stack, not a copy.
rethrow_(ctx: ptr) -> int {
    return quickjs.rethrow(ctx)
}

// Run the promise jobs a callback queued (its awaits, its .then()s).
settle_(ctx: ptr) {
    n, err = quickjs.run_jobs(ctx)
    if n < 0 { say_("sae: uncaught exception in a promise job:\n${err}") }
}

// Run a held handler with no arguments, as a widget does when it fires:
// report what it throws, then run the promise jobs it queued.
fire0_(ctx: ptr, ref: int, what: string) {
    if call0_(ctx, ref) < 0 { report_exception_(ctx, what) }
    settle_(ctx)
}

report_exception_(ctx: ptr, where_: string) {
    say_("sae: uncaught exception in ${where_}:\n${quickjs.last_error(ctx)}")
}

// A line on stdout through C stdio, flushed, as print's output is: the two
// cannot interleave, and a spec watching the log sees it at once.
say_(s: string) {
    out = sae_stdout()
    fputs(s, out)
    putchar(10)
    fflush(out)
}

// Keep a JS value alive for as long as the page lives: a handle of the
// page's own, released when the page's runtime is.
hold_(ctx: ptr, h: int) -> int {
    return quickjs.dup(ctx, h)
}

// Hold argument i.
hold_arg_(ctx: ptr, argv: int, i: int) -> int {
    return quickjs.arg(ctx, argv, i)
}

// A container builder: make it under the current top, then run the page's
// block function (its last argument) with it on top. The pop happens even if
// the block throws, so later widgets never attach to the wrong parent.
container_(ctx: ptr, argv: int, argc: int, handle: int) -> int {
    p = page_of_(ctx)
    if argc == 1 && is_fn_arg_(ctx, argv, 0) == 0 { return quickjs.new_int(ctx, handle) }
    if argc >= 1 {
        if is_fn_arg_(ctx, argv, argc - 1) == 0 {
            return sae_throw_type_error(ctx, "container block must be a function")
        }
        if push_(p, handle) == 0 {
            return sae_throw_type_error(ctx, "containers nested too deeply")
        }
        r = call_arg_(ctx, argv, argc - 1)
        pop_(p)
        if r < 0 { return rethrow_(ctx) }
    }
    return quickjs.new_int(ctx, handle)
}

// Is `h` a widget this page made? (See Page.first_handle.)
owned_(p: *Page, h: int) -> int {
    if h < p.first_handle { return 0 }
    // The driver's banner is made lazily, on its first request, so in a
    // sae-driver build it can land among the first page's handles.
    if h == aether_ui_test_server_banner_handle() { return 0 }
    return 1
}

// Is `h` a vstack, hstack or grid this page made?
own_stack_(p: *Page, h: int) -> int {
    return in_list_(p.stacks, h)
}

in_list_(l: ptr, h: int) -> int {
    n = list.size(l)
    i = 0
    while i < n {
        v, _ = list.get(l, i)
        if mem.ptr_to_long(v) == h { return 1 }
        i = i + 1
    }
    return 0
}

// Account a builder call's native time to the page, so the timing report
// can split engine time from widget-creation time.
ui_done_(p: *Page, t: long) {
    p.ui_ns = p.ui_ns + (os.now_monotonic_ns() - t)
    p.ui_calls = p.ui_calls + 1
}

// --- The page veto ---
//
// Every function a page can reach (everything api_register_ below installs
// in a page's runtime) opens with the same `hide`
// line. It takes the kernel out of that function's scope: the file system,
// the environment and clocks (`os`), the network (`client`, and `net`,
// services/net, the one place a request is opened), the lowerer,
// the page-lifecycle functions that fetch, parse and run pages, and the
// engine's raw parse/run/context calls. Naming any of them in a page-API
// function, at any depth (an `if` body, a nested block, a closure), is a
// compile error.
//
// What a page-API function may use of the kernel, it reaches through named
// helpers: `request_nav_` (navigation, deferred to the event loop),
// `resolve_` (URL arithmetic), `now_ns_`/`now_ms_`/`now_unix_ms_` (clocks).
//
// This is Aether's compile-time `hide` (aether/docs/hide-and-seal.md):
// it stops a page-facing function from naming the kernel, not a helper it
// calls from doing so, so the helpers stay few and narrow. The list grows;
// the end state is `seal except`, a whitelist per function.
// tests/check_page_veto.sh fails if a page-API function lacks the line, or
// if the compiler does not enforce it.

// --- the page API: ui (installed by api_register_) ---

sae_ui_vstack(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    long t = now_ns_()
    h = ui.vstack(mem.long_to_ptr(top_(p)), lead_int_(ctx, argv, argc, 0, SPACING))
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    return container_(ctx, argv, argc, h)
}

sae_ui_hstack(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    long t = now_ns_()
    h = ui.hstack(mem.long_to_ptr(top_(p)), lead_int_(ctx, argv, argc, 0, SPACING))
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    return container_(ctx, argv, argc, h)
}

// grid(cols, block) or grid(cols, spacing, block): the block's widgets fill
// it a row at a time, cols to a row (aether-ui's grid block).
sae_ui_grid(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    cols = lead_int_(ctx, argv, argc, 0, 1)
    if cols < 1 || cols > 64 { return sae_throw_type_error(ctx, "grid(cols, ...): cols must be 1 to 64") }
    sp = lead_int_(ctx, argv, argc, 1, SPACING)
    long t = now_ns_()
    h = ui.grid(mem.long_to_ptr(top_(p)), cols, sp, sp)
    ui_done_(p, t)
    list.add(p.stacks, mem.long_to_ptr(h))
    list.add(p.grids, mem.long_to_ptr(h))
    return container_(ctx, argv, argc, h)
}

// equal_cells(): in a grid's block, every column one width and every row one
// height, children filling their cells (a keypad).
sae_ui_equal_cells(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    target = modifier_target_(ctx, "equal_cells")
    if target == 0 || in_list_(p.grids, target) == 0 {
        return sae_throw_type_error(ctx, "equal_cells() must be called inside a grid's block")
    }
    ui.equal_cells(mem.long_to_ptr(target))
    return 0
}

sae_ui_text(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    label = arg_str_(ctx, argv, argc, 0)
    long t = now_ns_()
    h = ui.text(mem.long_to_ptr(top_(p)), label)
    ui_done_(p, t)
    return quickjs.new_int(ctx, h)
}

sae_ui_divider(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    long t = now_ns_()
    h = ui.divider(mem.long_to_ptr(top_(p)))
    ui_done_(p, t)
    return quickjs.new_int(ctx, h)
}

sae_ui_btn(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    label = arg_str_(ctx, argv, argc, 0)
    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 {
        return sae_throw_type_error(ctx, "btn(label, fn): fn must be a function")
    }
    ref = hold_arg_(ctx, argv, 1)
    on_press = || { fire0_(ctx, ref, "a click handler") }
    long t = now_ns_()
    h = ui.btn(mem.long_to_ptr(top_(p)), label, on_press)
    ui_done_(p, t)
    return quickjs.new_int(ctx, h)
}

// A modifier (margin, bg_color, onclick) acts on the innermost container or
// widget the page opened. At the page's top level there is none: the top of
// the stack is the browser's own content area, which a page must not
// restyle. Aether makes that a compile error; here it throws.
modifier_target_(ctx: ptr, name: string) -> int {
    p = page_of_(ctx)
    if p.depth < 2 { return 0 }
    return top_(p)
}

arg_num_(ctx: ptr, argv: int, argc: int, i: int, dflt: float) -> float {
    if i >= argc { return dflt }
    return quickjs.arg_float(ctx, argv, i)
}

// Call a held JS function with one string argument.
call1_str_(ctx: ptr, ref: int, s: string) -> int {
    args = quickjs.new_array(ctx)
    v = quickjs.new_string(ctx, s)
    _s = quickjs.set_index(ctx, args, 0, v)
    quickjs.release(ctx, v)
    r = calln_(ctx, ref, args)
    quickjs.release(ctx, args)
    return r
}

// button(label, block?): a plain button; the block (if any) runs with the
// button on top, for onclick/bg_color/margin.
sae_ui_button(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    label = arg_str_(ctx, argv, argc, 0)
    long t = now_ns_()
    h = ui.button(mem.long_to_ptr(top_(p)), label)
    ui_done_(p, t)
    return container_(ctx, argv, argc, h)
}

sae_ui_scroll(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    long t = now_ns_()
    sv = ui.scrollview(mem.long_to_ptr(top_(p)))
    h = ui.vstack(mem.long_to_ptr(sv), 0)
    ui_done_(p, t)
    // scroll(block): the block's widgets go in the scrolled stack
    if argc >= 1 && is_fn_arg_(ctx, argv, 0) != 0 {
        if push_(p, h) == 0 { return sae_throw_type_error(ctx, "containers nested too deeply") }
        r = call_arg_(ctx, argv, 0)
        pop_(p)
        if r < 0 { return rethrow_(ctx) }
    }
    return quickjs.new_int(ctx, sv)
}

sae_ui_spacer(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    h = ui.spacer(mem.long_to_ptr(top_(p)))
    return quickjs.new_int(ctx, h)
}

// textfield(placeholder, onChange?): onChange(text) on every edit.
sae_ui_textfield(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    placeholder = own_(arg_str_(ctx, argv, argc, 0))
    has_fn = 0
    ref = 0
    if argc >= 2 && is_fn_arg_(ctx, argv, 1) != 0 {
        has_fn = 1
        ref = hold_arg_(ctx, argv, 1)
    }
    on_change = |s: string| {
        if has_fn == 1 {
            r = call1_str_(ctx, ref, s)
            if r < 0 { report_exception_(ctx, "a textfield handler") }
            settle_(ctx)
        }
    }
    long t = now_ns_()
    h = ui.textfield(mem.long_to_ptr(top_(p)), placeholder, on_change)
    ui_done_(p, t)
    return quickjs.new_int(ctx, h)
}

// ===== keys, Return, focus, wrapping and size (the cloud wishlist, 2026-10-10) =====

// ui.on_key(fn(key, mods)): every key the window gets while the page has the
// focus: a widget the page made, or nothing at all. Names are aether-ui's
// ("Left", "Return", "BackSpace", "a"); mods is 1 shift, 2 ctrl, 4 alt,
// 8 super. A key while the address bar (or any of the browser's own
// widgets) has the focus never reaches a page: what a person types into the
// chrome is not the page's to read. One function per page; a second call
// replaces the first.
sae_ui_on_key(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "ui.on_key(fn): fn must be a function") }
    if p.key_ref != 0 { quickjs.release(ctx, p.key_ref) }
    p.key_ref = hold_arg_(ctx, argv, 0)
    keys_hook_()
    return 0
}

// One window hook for every page, made the first time any page asks.
var keys_hooked_: int = 0
keys_hook_() {
    if keys_hooked_ == 1 { return }
    keys_hooked_ = 1
    ui.window_on_key(|k: string, m: int| { keys_deliver_(k, m) })
}

// To the page with the focus, if it asked: the first live page with a key
// function whose widget has the focus (or with nothing focused). One page,
// then return: a handler may navigate, which frees pages.
keys_deliver_(k: string, m: int) {
    if pages_ == null { return }
    fw = ui.focused_widget()
    i = 0
    while i < list.size(pages_) {
        pv, _e = list.get(pages_, i)
        p = pv as *Page
        if p.key_ref != 0 {
            if fw == 0 || owned_(p, fw) == 1 {
                ctx = p.ctx
                args = quickjs.new_array(ctx)
                ks = quickjs.new_string(ctx, k)
                _a = quickjs.set_index(ctx, args, 0, ks)
                quickjs.release(ctx, ks)
                ms = quickjs.new_int(ctx, m)
                _b = quickjs.set_index(ctx, args, 1, ms)
                quickjs.release(ctx, ms)
                r = calln_(ctx, p.key_ref, args)
                quickjs.release(ctx, args)
                if r < 0 { report_exception_(ctx, "a ui.on_key handler") }
                settle_(ctx)
                return
            }
        }
        i = i + 1
    }
}

// ui.on_submit(field, fn(text)): Return in one of the page's text fields.
sae_ui_on_submit(ctx: ptr, this_val: int, argv: int) -> int {
