// --- the page's globals beyond the page API: print, and the clocks ---

// All of print's output goes through C stdio, then is flushed, so it cannot
// interleave with the host's own println output. Objects print as JSON.
js_print(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    out = sae_stdout()
    i = 0
    while i < argc {
        if i != 0 { putchar(32) }
        v = quickjs.arg(ctx, argv, i)
        t = quickjs.type_of(ctx, v)
        if t == "object" || t == "array" {
            fputs(quickjs.to_json(ctx, v), out)
        } else {
            fputs(quickjs.to_string(ctx, v), out)
        }
        quickjs.release(ctx, v)
        i = i + 1
    }
    putchar(10)
    fflush(out)
    return 0
}

// Date.now() and performance.now(), on sae's clocks (SAE_TIME_SCALE).
js_date_now(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_float(ctx, now_unix_ms_() as float)
}

js_performance_now(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_float(ctx, esc_perf_now_())
}

// ===== wave1/escape: the browser's security rules (docs/roadmap.md 1.1, 1.2) =====
//
// What a web page is held to beyond same-origin-by-construction, each rule
// with its attempt in tests/escape (the red-team corpus, spec_escape) and
// its happy path in site/webrules.ts (spec_webrules). The pure parts (what an
// origin is, mixed content, the consent header) are services/net's, held
// without a window by spec_origin_rules; this section is the kernel wiring.
//
// - Mixed content: a page from https: may not fetch http:, from any origin.
//   Refused before any socket, with the page-level reason, logged once.
// - The CORS-alike: in the browser a page may request another origin. sae
//   sends `Origin: <the page's origin>`, never a Referer, and drops the
//   page's own Origin, Referer, Cookie and Authorization on the way out;
//   the answer reaches the page only if its final response carries
//   `Sae-Allow-Origin: <that origin>` or `*`. Otherwise the body, status
//   and headers are withheld and res.error says why (logged once). No
//   preflight: there are no cookies to protect. A redirect chain that ever
//   leaves the origin needs the consent on the response that ends it. App
//   mode is unaffected: capabilities.http is the list, and the installer
//   saw it.
// - No ambient credentials: nothing here adds a header a page did not set;
//   there is no cookie jar (a Set-Cookie is never kept). Written down as a
//   rule and held by spec_webrules.
// - Caps per page: ESC_HTTP_INFLIGHT_MAX requests in flight; ESC_TIMERS_MAX
//   timers and animation frames pending. Per origin: ESC_STORAGE_ORIGIN_MAX
//   bytes of storage. Over a cap the call throws a TypeError naming it,
//   logged once per page per cap (not once per call: a page in a loop must
//   not fill the console).
// - Coarse clocks (roadmap decision 1, implemented behind one switch):
//   performance.now() and frame timestamps are rounded down to 100 us in
//   the browser; an app has full resolution. SAE_COARSE_CLOCKS=0 (or off)
//   turns it off, =1 (or on) turns it on, in either mode. Date.now stays
//   whole milliseconds, as before.
// - A web page navigates only to http(s) URLs: not into app: pages (which
//   the browser would map onto a file by path) nor to a file.
//
// A page-reachable function here carries the page veto as its neighbours
// do; the esc_* helpers are the kernel's, reached from the gates as now_ns_
// is.

const ESC_HTTP_INFLIGHT_MAX = 8
const ESC_TIMERS_MAX = 256
const ESC_STORAGE_ORIGIN_MAX = 4194304   // 4 MB, in bytes of values
const ESC_CLOCK_UNIT_NS = 100000         // 100 us: the coarse clocks' tick

// Per-page state this section keeps beside the Page (which stays as it is):
// which caps have been logged for the page. Keyed by the page's runtime,
// freed with the page (esc_free_).
struct EscState {
    ctx: ptr
    logged_http: int
    logged_timers: int
    logged_storage: int
}

var esc_states_: ptr = null   // std.list of *EscState

esc_state_(p: *Page) -> *EscState {
    if esc_states_ == null { esc_states_ = list.new() }
    n = list.size(esc_states_)
    i = 0
    while i < n {
        v, _ = list.get(esc_states_, i)
        s = v as *EscState
        if s.ctx == p.ctx { return s }
        i = i + 1
    }
    ns = heap.new(EscState)
    ns.ctx = p.ctx
    ns.logged_http = 0
    ns.logged_timers = 0
    ns.logged_storage = 0
    list.add(esc_states_, ns as ptr)
    return ns
}

// The page goes: so does its state here.
esc_free_(p: *Page) {
    if esc_states_ == null { return }
    i = list.size(esc_states_) - 1
    while i >= 0 {
        v, _ = list.get(esc_states_, i)
        s = v as *EscState
        if s.ctx == p.ctx {
            list.list_remove(esc_states_, i)
            heap.free(s)
        }
        i = i - 1
    }
}

// A refusal on the console, once, in the form every refusal takes.
esc_log_(why: string) { say_("sae: refused: ${why}") }

// 1 in the browser (no app folder): where these rules apply.
esc_browser_() -> int {
    if app_dir_ == "" { return 1 }
    return 0
}

// --- mixed content, and crossing an origin ---

// Why a page at page_url may not even try `url`, another origin, or "" when
// it may (the CORS-alike then decides on the response). Only mixed content
// stops a web page here; an app never reaches this (capabilities.http is
// checked first).
esc_cross_why_(page_url: string, url: string) -> string {
    return net.mixed_content(page_url, url)
}

// Log a mixed-content refusal at the call, once, as a capabilities.http
// refusal is logged (the callback gets the same reason).
esc_log_mixed_(p: *Page, url: string) {
    why = net.mixed_content(p.url, url)
    if why != "" { esc_log_(why) }
}

// Why a web page's scope may not name `pat`'s origin, or "". In the browser
// a scope may name any http(s) origin (the CORS-alike holds each request to
// that origin's consent), but not http: from an https: page.
esc_scope_why_(page_url: string, pat: string) -> string {
    if is_http_(page_url) == 0 || is_http_(pat) == 0 { return "which is not its own origin; a web page may reach only http(s) origins" }
    return net.mixed_content(page_url, pat)
}

// (On the fetcher actor.) 1 if the request's first URL already leaves the
// page's origin, in the browser: credentials stay behind from the start.
esc_cross_start_(j: *HttpJob) -> int {
    if app_dir_ != "" { return 0 }
    return net.cross_origin(j.page_url, j.url)
}

// (On the fetcher actor.) 1 if a page-set header named `lname` (lowercased)
// is sent. In the browser Origin and Referer are sae's to send, never the
// page's: a forged Origin would be the page naming another site.
esc_header_kept_(lname: string) -> int {
    if app_dir_ == "" && (lname == "origin" || lname == "referer") { return 0 }
    return 1
}

// (On the fetcher actor.) Across origins, in the browser, the one header sae
// adds: Origin, the page's origin as its URL spells it.
esc_send_origin_(req: ptr, j: *HttpJob, cross: int) {
    if cross == 1 && app_dir_ == "" && is_http_(j.page_url) == 1 {
        _s = client.set_header(req, "Origin", string.string_substring(j.page_url, 0, origin_end_(j.page_url)))
    }
}

// (On the fetcher actor.) The CORS-alike, on the response that ends the
// request: 1 if the page may not read it, with j.err saying why and the
// body, status and headers withheld; the refusal is logged once when it is
// delivered (j.refused_hop, as a refused redirect hop is).
esc_cors_refused_(j: *HttpJob, resp: ptr, cross: int, url: string) -> int {
    if cross == 0 || app_dir_ != "" { return 0 }
    allow = client.response_header(resp, "Sae-Allow-Origin")
    if net.allows_origin(j.page_url, allow) == 1 { return 0 }
    po = string.string_substring(j.page_url, 0, origin_end_(j.page_url))
    j.err = "${url} did not allow this page's origin ${po}: the response carries no Sae-Allow-Origin: ${po} (or *)"
    j.status = 0
    j.resp = ""
    j.resp_headers = ""
    j.refused_hop = 1
    return 1
}

// --- caps ---

// How many requests page p has in flight: its callbacks still waiting.
esc_http_inflight_(p: *Page) -> int {
    if http_waits_ == null { return 0 }
    c = 0
    n = list.size(http_waits_)
    i = 0
    while i < n {
        wv, _ = list.get(http_waits_, i)
        w = wv as *HttpWait
        if w.page == p as ptr && w.seq == p.seq { c = c + 1 }
        i = i + 1
    }
    return c
}

// The in-flight cap: release the held callback, log once per page, throw.
esc_http_refuse_(ctx: ptr, p: *Page, ref: int) -> int {
    quickjs.release(ctx, ref)
    why = "http: this page has ${ESC_HTTP_INFLIGHT_MAX} requests in flight (the cap); wait for one to finish"
    s = esc_state_(p)
    if s.logged_http == 0 {
        s.logged_http = 1
        esc_log_(why)
    }
    return sae_throw_type_error(ctx, why)
}

// How many timers (alive) and animation frames (requested, not cancelled)
// page p has pending.
esc_timers_pending_(p: *Page) -> int {
    c = 0
    n = list.size(p.timers)
    i = 0
    while i < n {
        v, _ = list.get(p.timers, i)
        t = v as *PageTimer
        if t.alive == 1 { c = c + 1 }
        i = i + 1
    }
    m = list.size(p.rafs)
    k = 0
    while k < m {
        rv, _ = list.get(p.rafs, k)
        r = rv as *PageRaf
        if r.id != 0 { c = c + 1 }
        k = k + 1
    }
    return c
}

// The timers cap: log once per page, throw. Called before anything is held.
esc_timers_refuse_(ctx: ptr, p: *Page) -> int {
    why = "this page has ${ESC_TIMERS_MAX} timers and animation frames pending (the cap); cancel or let some run first"
    s = esc_state_(p)
    if s.logged_timers == 0 {
        s.logged_timers = 1
        esc_log_(why)
    }
    return sae_throw_type_error(ctx, why)
}

// The bytes the storage folder `dir` holds, less the file `key` (which is
// about to be replaced). 0 for a folder that is not there yet.
esc_storage_used_(dir: string, key: string) -> long {
    long total = 0
    l, err = fs.list_dir(dir)
    if err != "" || l == null { return total }
    n = fs.dir_list_count(l)
    i = 0
    while i < n {
        name = fs.dir_list_get(l, i)
        if name != key {
            sz, serr = fs.size("${dir}/${name}")
            if serr == "" { total = total + sz }
        }
        i = i + 1
    }
    fs.dir_list_free(l)
    return total
}

// 1 if writing `add` bytes under `key` would take the page's origin (or
// app, or file folder) over its storage cap.
esc_storage_over_(url: string, key: string, add: int) -> int {
    long cap = ESC_STORAGE_ORIGIN_MAX
    long more = add
    if esc_storage_used_(storage_dir_(url), key) + more > cap { return 1 }
    return 0
}

// The storage cap: log once per page, throw.
esc_storage_refuse_(ctx: ptr, p: *Page) -> int {
    why = "storage.set: this origin's storage would exceed 4 MB (the cap); remove something first"
    s = esc_state_(p)
    if s.logged_storage == 0 {
        s.logged_storage = 1
        esc_log_(why)
    }
    return sae_throw_type_error(ctx, why)
}

// --- coarse clocks ---

var esc_coarse_ = 0   // 0 not decided yet, 1 off, 2 on

// 1 when the clocks a page reads are coarse: in the browser unless
// SAE_COARSE_CLOCKS=0, in an app only with SAE_COARSE_CLOCKS=1.
esc_coarse_on_() -> int {
    if esc_coarse_ == 0 {
        esc_coarse_ = 1
        if app_dir_ == "" { esc_coarse_ = 2 }
        v = env_("SAE_COARSE_CLOCKS")
        if v == "0" || v == "off" { esc_coarse_ = 1 }
        if v == "1" || v == "on" { esc_coarse_ = 2 }
    }
    if esc_coarse_ == 2 { return 1 }
    return 0
}

// performance.now() and the frame clock: milliseconds with the fraction
// kept, rounded down to 100 us when the clocks are coarse. Under
// SAE_TIME_SCALE the scaled clock is whole milliseconds, as before.
esc_perf_now_() -> float {
    long ms = now_ms_()   // also starts SAE_TIME_SCALE's base
    if time_scale_ != 1 { return ms as float }
    long ns = os.now_monotonic_ns()
    if esc_coarse_on_() == 1 { return ((ns / ESC_CLOCK_UNIT_NS) as float) / 10.0 }
    return (ns as float) / 1000000.0
}

// --- navigation ---

// A navigation a page asked for, checked and cleaned: returns (url, why).
// why is "" and url the one to load (its "." and ".." collapsed, as the
// import loader's norm_path_ does), or why names the refusal, logged once:
//   - a web page navigates only to http(s) URLs (not an app: page, which the
//     browser would map onto a file by path, nor a file); a page loaded from
//     a file may open files, as the address bar may;
//   - a path may not climb: above the app's bundle (app:/../x would read
//     <dir>/../x.ts), above the site root in the browser, or out of the
//     page's own folder for a page loaded from a file.
esc_nav_check_(b: *Browser, url: string) -> (string, string) {
    if b.page == null { return own_(url), "" }
    cur = (b.page as *Page).url
    if app_dir_ != "" {
        if is_app_(url) == 0 { return own_(url), "" }   // run_nav_ refuses it, as before
        path, climbed = norm_path_(string.string_substring(url, 4, string.length(url)))
        if climbed == 1 { return own_(url), "a page may not navigate above the app's bundle; refused ${url}" }
        return string.concat("app:", path), ""
    }
    if is_http_(cur) == 1 {
        if is_http_(url) == 0 { return own_(url), "a web page may navigate only to http(s) URLs; refused ${url}" }
        oe = origin_end_(url)
        rest = string.string_substring(url, oe, string.length(url))
        q = string.index_of(rest, "?")
        h = string.index_of(rest, "#")
        cut = string.length(rest)
        if q >= 0 && q < cut { cut = q }
        if h >= 0 && h < cut { cut = h }
        path, climbed = norm_path_(string.string_substring(rest, 0, cut))
        if climbed == 1 { return own_(url), "a page may not navigate above its site's root; refused ${url}" }
        if string.string_starts_with(path, "/") == 0 { path = string.concat("/", path) }
        return string.concat(string.string_substring(url, 0, oe), string.concat(path, string.string_substring(rest, cut, string.length(rest)))), ""
    }
    if is_http_(url) == 1 || is_app_(url) == 1 { return own_(url), "" }
    // A file page: stays in its own folder.
    path, _c = norm_path_(url)
    folder, _c2 = norm_path_(dir_of_(cur))
    if string.string_ends_with(folder, "/") == 0 { folder = string.concat(folder, "/") }
    if string.string_starts_with(path, folder) == 0 { return own_(url), "a page loaded from a file may navigate only within its own folder; refused ${url}" }
    return own_(path), ""
}

// ===== end wave1/escape =====
// ===== wave1/sqlite: the page API: sqlite.<name> (app mode), one actor per database =====
//
//   const rows = await sqlite.fred.all("select * from notes where tag = ?", [tag]);
//   const one  = await sqlite.fred.get("select * from notes where id = ?", [id]);
//   const r    = await sqlite.fred.run("insert into notes(body) values (?)", [text]);  // r.changes, r.lastId
//   await sqlite.fred.transaction(async tx => { await tx.run(...); });   // rolled back if it throws
//
// app.json declares each database under capabilities.sqlite, with its
// migrations; a page seeks "database fred" and gets sqlite.fred, an object
// holding the name (__db) and these calls. The kernel opened the file at
// start (sqlite_start_: the app's private data folder, keyed per installed
// app, never a page-named path), applied the migrations the database had
// not seen, and gave the connection to one SqliteWorker actor per database.
// Each call becomes a SqliteJob run on that actor, off the UI thread, in the
// order the page made them; the finished job goes to the SqliteInbox actor,
// and a UI timer takes it and settles the page's promise on the UI thread,
// where the engine lives (the http pattern). A reply for a page that has
// since been left is dropped. Values reach the service as JSON and rows
// come back as JSON (services/sqlite, the one module that names the
// engine; docs/page-services.md, 6).
//
// A transaction is a BEGIN job, the page's callback with a tx object whose
// calls carry the transaction's id, then COMMIT or ROLLBACK as the callback's
// promise settles. While one is open, jobs from any other caller wait in
// the database's queue until it ends (the owning page's own plain calls
// join it, so a page cannot deadlock itself); a page left mid-transaction
// has it rolled back before anything else runs.

const SQLITE_OP_QUERY = 0
const SQLITE_OP_BEGIN = 1
const SQLITE_OP_END = 2

// One declared database: its connection (used only on its worker once the
// app has started), its worker, and the open transaction, if any.
struct SqliteDb {
    name: string
    path: string
    db: ptr          // the connection (services/sqlite opened it)
    worker: ptr      // its SqliteWorker actor
    tx_owner: int    // the open transaction's id, or 0
    tx_page: ptr     // the page that owns it, and its load
    tx_seq: int
    waiting: ptr     // std.list of *SqliteJob held until the transaction ends
}

struct SqliteJob {
    id: int          // 0 for the kernel's own (an automatic rollback)
    db: ptr          // *SqliteDb
    kind: int        // sqlite.KIND_*
    op: int          // SQLITE_OP_*
    sql: string
    params: string   // the page's parameters as JSON, or ""
    tx: int          // the transaction it belongs to, or 0
    page: ptr        // the page that asked, and its load
    seq: int
    result: string   // JSON, when err is ""
    err: string
}

// A call a page is waiting on: its promise's resolve and reject.
struct SqliteWait {
    id: int
    page: ptr
    seq: int
    resolve: int
    reject: int
}

// The two small JS functions the sqlite API hands a page, compiled once per
// page and held: one makes an Error (a rejection carries a real Error), one
// runs a transaction around the page's callback.
struct SqlitePageFns {
    page: ptr
    seq: int
    err_fn: int
    tx_fn: int
}

message SqliteRun { job: ptr }
message SqliteDone { job: ptr }
message SqliteTake {}

// Runs one job on a scheduler thread, then hands it to the inbox. One per
// database, so a database's statements run one at a time, in order.
actor SqliteWorker {
    receive {
        SqliteRun(job) -> {
            sqlite_do_(job)
            ib = actors.whereis("sae-sqlite-inbox")
            ib ! SqliteDone { job: job }
        }
    }
}

// Finished jobs, until the UI thread takes them. sqlite_done_ is touched only
// in these handlers, so the actor serializes every access to it.
var sqlite_done_: ptr = null

actor SqliteInbox {
    receive {
        SqliteDone(job) -> {
            if sqlite_done_ == null { sqlite_done_ = list.new() }
            list.add(sqlite_done_, job)
        }
        SqliteTake() -> {
            long r = 0
            if sqlite_done_ != null {
                if list.size(sqlite_done_) > 0 {
                    j, _ = list.get(sqlite_done_, 0)
                    list.list_remove(sqlite_done_, 0)
                    r = mem.ptr_to_long(j)
                }
            }
            reply r
        }
    }
}

var sqlite_dbs_: ptr = null      // std.list of *SqliteDb, from app.json, at start
var sqlite_waits_: ptr = null    // std.list of *SqliteWait
var sqlite_fns_: ptr = null      // std.list of *SqlitePageFns
var sqlite_ids_ = 0
var sqlite_tx_ids_ = 0
var sqlite_timer_ = 0

// On the worker: run the job's statement.
sqlite_do_(jp: ptr) {
    j = jp as *SqliteJob
    d = j.db as *SqliteDb
    res, err = sqlite.execute(d.db, j.kind, j.sql, j.params)
    if err != "" && j.op == SQLITE_OP_END && j.sql == "COMMIT" {
        // A COMMIT that fails leaves the transaction open: close it.
        _r, _e = sqlite.execute(d.db, sqlite.KIND_EXEC, "ROLLBACK", "")
    }
    j.result = own_(res)
    j.err = own_(err)
}

sqlite_inbox_() -> ptr {
    ib = actors.whereis("sae-sqlite-inbox")
    if ib == null {
        ib = spawn(SqliteInbox())
        actors.register("sae-sqlite-inbox", ib)
    }
    return ib
}

// The declared database called `name`, or null.
sqlite_db_(name: string) -> ptr {
    if sqlite_dbs_ == null { return null }
    n = list.size(sqlite_dbs_)
    i = 0
    while i < n {
        dv, _ = list.get(sqlite_dbs_, i)
        if (dv as *SqliteDb).name == name { return dv }
        i = i + 1
    }
    return null
}

// 1 if app.json declares a database called `name` (available_ asks, for
// "seeks database <name>").
sqlite_granted_(name: string) -> int {
    if sqlite_db_(name) != null { return 1 }
    return 0
}

// 1 if the database's name can be a sqlite property and a file name: a
// letter or "_", then letters, digits and "_" (the lowerer's rule).
sqlite_name_ok_(s: string) -> int {
    n = string.length(s)
    if n == 0 || n > 64 { return 0 }
    i = 0
    while i < n {
        c = string.char_at(s, i)
        ok = 0
        if c >= 97 && c <= 122 { ok = 1 }
        if c >= 65 && c <= 90 { ok = 1 }
        if c == 95 { ok = 1 }
        if i > 0 && c >= 48 && c <= 57 { ok = 1 }
        if ok == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// At start, in app mode: open each database app.json declares under
// capabilities.sqlite, apply its migrations in order, and give it a worker.
// Returns "" or why the app cannot start (a database that cannot be opened,
// a migration that fails: nothing of it is kept, and the app is refused with
// the reason rather than run against a schema it did not ask for).
sqlite_start_(manifest: ptr) -> string {
    sqlite_dbs_ = list.new()
    if manifest == null { return "" }
    caps = json.json_object_get_raw(manifest, "capabilities")
    if caps == null { return "" }
    decl = json.json_object_get_raw(caps, "sqlite")
    if decl == null { return "" }
    if json.json_type(decl) != 5 { return "app.json capabilities.sqlite must be an object: { \"<name>\": { \"migrations\": [...] } }" }
    dir = "${storage_dir_("app:/")}/.sqlite"
    n = json.json_object_size_raw(decl)
    i = 0
    while i < n {
        name = json.json_object_key_at(decl, i)
        spec_ = json.json_object_value_at(decl, i)
        i = i + 1
        if sqlite_name_ok_(name) == 0 { return "app.json capabilities.sqlite: \"${name}\" is not a database name (a letter or _, then letters, digits and _)" }
        if json.json_type(spec_) != 5 { return "app.json capabilities.sqlite.${name} must be an object with \"migrations\"" }
        if json.json_object_has(spec_, "bundled") == 1 || json.json_object_has(spec_, "readonly") == 1 {
            return "app.json capabilities.sqlite.${name}: \"bundled\" and \"readonly\" databases are not built yet (version 2); version 1 is app-owned databases with migrations"
        }
        _m = fs.mkdir_p(dir)
        path = "${dir}/${name}.db"
        db, oerr = sqlite.open(path)
        if db == null { return "sqlite ${name}: ${oerr}" }
        migs = json.json_object_get_raw(spec_, "migrations")
        nm = 0
        if migs != null { nm = json.json_array_size(migs) }
        k = 0
        while k < nm {
            mv, merr0 = json.get_string(json.json_array_get_raw(migs, k))
            k = k + 1
            if merr0 != "" {
                _c0 = sqlite.close(db)
                return "sqlite ${name}: app.json capabilities.sqlite.${name}.migrations: each entry is a path in the app, like \"db/001_init.sql\""
            }
            if string.string_starts_with(mv, "/") == 1 || string.contains(mv, "..") == 1 || string.contains(mv, "\\") == 1 {
                _c1 = sqlite.close(db)
                return "sqlite ${name}: migration ${mv}: a migration is a file inside the app (no \"..\", no absolute path)"
            }
            text, rerr = fs.read("${app_dir_}/${mv}")
            if rerr != "" {
                _c2 = sqlite.close(db)
                return "sqlite ${name}: migration ${mv}: ${rerr}"
            }
            applied, merr = sqlite.migrate(db, mv, text)
            if merr != "" {
                _c3 = sqlite.close(db)
                return "sqlite ${name}: migration ${mv} failed: ${merr}"
            }
            if applied == 1 { say_("sae: sqlite ${name}: applied ${mv}") }
        }
        d = heap.new(SqliteDb)
        d.name = own_(name)
        d.path = own_(path)
        d.db = db
        d.worker = spawn(SqliteWorker())
        d.tx_owner = 0
        d.tx_page = null
        d.tx_seq = 0
        d.waiting = list.new()
        list.add(sqlite_dbs_, d as ptr)
        say_("sae: sqlite ${name}: ${path}")
    }
    _ib = sqlite_inbox_()
    return ""
}

// An app sqlite_start_ refused: say why in the window and the console, and
// run no page.
sqlite_refuse_app_(b: *Browser, why: string) {
    ui.text(mem.long_to_ptr(b.content), "This app cannot start:")
    ui.text(mem.long_to_ptr(b.content), why)
    set_status_(b, "error: ${why}")
    say_("sae: ${why}")
    b.last_ok = 0
}

// The databases a page gets, as ",fred,atlas,": those it seeks (required
// or optional) that app.json declares and were not left out (p.absent).
// Runs from api_register_, in page_new_, in load_, right after the page was
// lowered, so the lowerer's answers are this page's.
sqlite_page_dbs_(p: *Page) -> string {
    out = ","
    if app_dir_ == "" { return out }
    parts = string.split("${lower.page_seeks()},${lower.page_optional()}", ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        e = string.string_array_get(parts, i)
        i = i + 1
        if string.string_starts_with(e, "database ") == 0 { continue }
        name = string.string_substring(e, 9, string.length(e))
        if string.contains(p.absent, ",${e},") == 1 { continue }
        if sqlite_db_(name) == null { continue }
        if string.contains(out, ",${name},") == 0 { out = string.concat(out, "${name},") }
    }
    return out
}

// 1 if the page `pg` (as loaded `seq`) is the one on screen.
sqlite_page_live_(pg: ptr, seq: int) -> int {
    b = browser_
    if b == null { return 0 }
    cur = (b as *Browser).page
    if cur == null || cur != pg { return 0 }
    if (cur as *Page).seq != seq { return 0 }
    return 1
}

// The page's helper functions (SqlitePageFns), made on first use.
sqlite_fns_for_(ctx: ptr, p: *Page) -> *SqlitePageFns {
    if sqlite_fns_ == null { sqlite_fns_ = list.new() }
    // Entries for pages that are gone go first (their handles went with
    // the runtime; nothing to release).
    i = 0
    while i < list.size(sqlite_fns_) {
        fv, _ = list.get(sqlite_fns_, i)
        f = fv as *SqlitePageFns
        if f.page == p as ptr && f.seq == p.seq { return f }
        if sqlite_page_live_(f.page, f.seq) == 0 {
            list.list_remove(sqlite_fns_, i)
            heap.free(f)
        } else {
            i = i + 1
        }
    }
    es = "(function (m) { return new Error(m); })"
    ts = "(function (db, fn, id) { return db.__begin(id).then(function () { var tx = { __db: db.__db, __tx: id, all: db.all, get: db.get, run: db.run }; var r; try { r = Promise.resolve(fn(tx)); } catch (e) { r = Promise.reject(e); } return r.then(function (v) { return db.__end(id, true).then(function () { return v; }); }, function (e) { return db.__end(id, false).then(function () { throw e; }, function () { throw e; }); }); }); })"
    ef, e1 = quickjs.eval(ctx, es, "sae:sqlite")
    if e1 != "" { return null }
    tf, e2 = quickjs.eval(ctx, ts, "sae:sqlite")
    if e2 != "" { return null }
    f = heap.new(SqlitePageFns)
    f.page = p as ptr
    f.seq = p.seq
    f.err_fn = ef
    f.tx_fn = tf
    list.add(sqlite_fns_, f as ptr)
    return f
}

// Send a job to its database's worker, or hold it while another caller's
// transaction is open. Jobs reach the worker in the order they are sent,
// and the worker runs them in that order, so the transaction's bracket is
// exactly the jobs sent between its BEGIN and its END.
sqlite_enqueue_(d: *SqliteDb, j: *SqliteJob) {
    // A transaction whose page has gone is rolled back before anything
    // else runs on the database.
    if d.tx_owner != 0 && sqlite_page_live_(d.tx_page, d.tx_seq) == 0 {
        sqlite_rollback_stale_(d)
    }
    if d.tx_owner != 0 && j.tx != d.tx_owner && (j.page != d.tx_page || j.seq != d.tx_seq) {
        list.add(d.waiting, j as ptr)
        return
    }
    sqlite_send_(d, j)
    if j.op == SQLITE_OP_END { sqlite_flush_(d) }
}

sqlite_send_(d: *SqliteDb, j: *SqliteJob) {
    if j.op == SQLITE_OP_BEGIN {
        d.tx_owner = j.tx
        d.tx_page = j.page
        d.tx_seq = j.seq
    }
    if j.op == SQLITE_OP_END { d.tx_owner = 0 }
    w = d.worker
    w ! SqliteRun { job: j as ptr }
}

// The open transaction's page is gone: send its ROLLBACK (no page waits on
// it) and free the lock.
sqlite_rollback_stale_(d: *SqliteDb) {
    j = heap.new(SqliteJob)
    j.id = 0
    j.db = d as ptr
    j.kind = sqlite.KIND_EXEC
    j.op = SQLITE_OP_END
    j.sql = "ROLLBACK"
    j.params = ""
    j.tx = d.tx_owner
    j.page = d.tx_page
    j.seq = d.tx_seq
    j.result = ""
    j.err = ""
    say_("sae: sqlite ${d.name}: a page left its transaction open; rolled back")
    sqlite_send_(d, j)
}

// After a transaction ends: send what waited, in order, until the next
// BEGIN among them opens another transaction (then its own jobs go, the
// rest keep waiting). Jobs for pages that have gone are dropped.
sqlite_flush_(d: *SqliteDb) {
    held = d.waiting
    d.waiting = list.new()
    n = list.size(held)
    i = 0
    while i < n {
        jv, _ = list.get(held, i)
        i = i + 1
        j = jv as *SqliteJob
        if sqlite_page_live_(j.page, j.seq) == 0 {
            // Its promise can never settle; the wait goes when the inbox is
            // next polled (sqlite_deliver_ frees a wait whose page is gone).
            ib = sqlite_inbox_()
            j.err = "the page is gone"
            ib ! SqliteDone { job: j as ptr }
            continue
        }
        if d.tx_owner != 0 && j.tx != d.tx_owner && (j.page != d.tx_page || j.seq != d.tx_seq) {
            list.add(d.waiting, j as ptr)
            continue
        }
        sqlite_send_(d, j)
    }
    list.free(held)
}

// On the UI thread: take every finished job and settle its page's promise.
sqlite_poll_() {
    ib = sqlite_inbox_()
    while true {
        jl = ib ? SqliteTake {}
        if jl == 0 { break }
        sqlite_deliver_(mem.long_to_ptr(jl) as *SqliteJob)
    }
    // A transaction whose page has gone, with nothing else asking: roll it
    // back now rather than at the next call.
    if sqlite_dbs_ != null {
        k = 0
        while k < list.size(sqlite_dbs_) {
            dv, _ = list.get(sqlite_dbs_, k)
            d = dv as *SqliteDb
            if d.tx_owner != 0 && sqlite_page_live_(d.tx_page, d.tx_seq) == 0 {
                sqlite_rollback_stale_(d)
                sqlite_flush_(d)
            }
            k = k + 1
        }
    }
    if list.size(sqlite_waits_) == 0 {
        ui.timer_cancel(sqlite_timer_)
        sqlite_timer_ = 0
    }
}

sqlite_deliver_(j: *SqliteJob) {
    n = list.size(sqlite_waits_)
    i = 0
    while i < n {
        wv, _ = list.get(sqlite_waits_, i)
        w = wv as *SqliteWait
        if w.id == j.id && j.id != 0 {
            list.list_remove(sqlite_waits_, i)
            if sqlite_page_live_(w.page, w.seq) == 1 {
                p = w.page as *Page
                ctx = p.ctx
                args = quickjs.new_array(ctx)
                r = 0
                e = ""
                if j.err == "" {
                    vh, perr = quickjs.parse_json(ctx, j.result)
                    if perr != "" {
                        j.err = "bad JSON from the database actor: ${perr}"
                    } else {
                        _s = quickjs.set_index(ctx, args, 0, vh)
                        quickjs.release(ctx, vh)
                        r, e = quickjs.call(ctx, w.resolve, 0, args)
                    }
                }
                if j.err != "" {
                    f = sqlite_fns_for_(ctx, p)
                    eh = 0
                    if f != null {
                        margs = quickjs.new_array(ctx)
                        ms = quickjs.new_string(ctx, j.err)
                        _s1 = quickjs.set_index(ctx, margs, 0, ms)
                        quickjs.release(ctx, ms)
                        eh, _ee = quickjs.call(ctx, f.err_fn, 0, margs)
                        quickjs.release(ctx, margs)
                    }
                    if eh == 0 { eh = quickjs.new_string(ctx, j.err) }
                    _s2 = quickjs.set_index(ctx, args, 0, eh)
                    quickjs.release(ctx, eh)
                    r, e = quickjs.call(ctx, w.reject, 0, args)
                }
                quickjs.release(ctx, args)
                if e != "" { report_exception_(ctx, "a sqlite promise") }
                if r != 0 { quickjs.release(ctx, r) }
                quickjs.release(ctx, w.resolve)
                quickjs.release(ctx, w.reject)
                settle_(ctx)
            }
            heap.free(w)
            break
        }
        i = i + 1
    }
    heap.free(j)
}

// The page's database `name` from this_val (sqlite.<name>, or a tx object),
// with the transaction id it carries, or 0; "" if this is neither.
sqlite_this_(ctx: ptr, this_val: int) -> (string, int) {
    if quickjs.type_of(ctx, this_val) != "object" { return "", 0 }
    name = js_prop_str_(ctx, this_val, "__db", "")
    tx = 0
    th, terr = quickjs.get(ctx, this_val, "__tx")
    if terr == "" {
        if quickjs.type_of(ctx, th) == "number" { tx = quickjs.to_int(ctx, th) }
        quickjs.release(ctx, th)
    }
    return name, tx
}

// Queue one job for the page and return the promise it settles.
sqlite_submit_(ctx: ptr, kind: int, op: int, sql: string, params: string, name: string, tx: int) -> int {
    p = page_of_(ctx)
    dv = sqlite_db_(name)
    if dv == null { return sae_throw_type_error(ctx, "sqlite: no database called \"${name}\" (call it as sqlite.<name>.all/get/run)") }
    d = dv as *SqliteDb
    if string.contains(sqlite_page_dbs_(p), ",${name},") == 0 {
        return sae_throw_type_error(ctx, "sqlite.${name}: this page did not seek it")
    }
    if op == SQLITE_OP_END && tx != d.tx_owner {
        return sae_throw_type_error(ctx, "sqlite.${name}: no such open transaction")
    }
    if sqlite_waits_ == null { sqlite_waits_ = list.new() }
    pr = quickjs.new_promise(ctx)
    resolve, _e1 = quickjs.get(ctx, pr, "resolve")
    reject, _e2 = quickjs.get(ctx, pr, "reject")
    promise, _e3 = quickjs.get(ctx, pr, "promise")
    quickjs.release(ctx, pr)
    sqlite_ids_ = sqlite_ids_ + 1
    j = heap.new(SqliteJob)
    j.id = sqlite_ids_
    j.db = dv
    j.kind = kind
    j.op = op
    j.sql = own_(sql)
    j.params = own_(params)
    j.tx = tx
    j.page = p as ptr
    j.seq = p.seq
    j.result = ""
    j.err = ""
    w = heap.new(SqliteWait)
    w.id = j.id
    w.page = p as ptr
    w.seq = p.seq
    w.resolve = resolve
    w.reject = reject
    list.add(sqlite_waits_, w as ptr)
    sqlite_enqueue_(d, j)
    if sqlite_timer_ == 0 { sqlite_timer_ = ui.timer(10, || { sqlite_poll_() }) }
    return promise
}

// sqlite.<name>.all(sql, params?) / get / run: the page's SQL with its
// values as parameters (an array for ?, an object for $name), never spliced
// in. A promise of the rows (all), the first row or null (get), or
// { changes, lastId } (run); rejected with an Error carrying the engine's
// message.
sqlite_call_(ctx: ptr, this_val: int, argv: int, argc: int, kind: int, what: string) -> int {
    name, tx = sqlite_this_(ctx, this_val)
    if name == "" { return sae_throw_type_error(ctx, "sqlite: call it as sqlite.<name>.${what}(sql, params)") }
    if argc < 1 { return sae_throw_type_error(ctx, "sqlite.${name}.${what}(sql, params?)") }
    sql = arg_str_(ctx, argv, argc, 0)
    params = ""
    if argc > 1 {
        ph = quickjs.arg(ctx, argv, 1)
        params = quickjs.to_json(ctx, ph)
        quickjs.release(ctx, ph)
    }
    return sqlite_submit_(ctx, kind, SQLITE_OP_QUERY, sql, params, name, tx)
}

sae_sqlite_all(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    return sqlite_call_(ctx, this_val, argv, argc, sqlite.KIND_ALL, "all")
}

sae_sqlite_get(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    return sqlite_call_(ctx, this_val, argv, argc, sqlite.KIND_GET, "get")
}

sae_sqlite_run(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    return sqlite_call_(ctx, this_val, argv, argc, sqlite.KIND_RUN, "run")
}

// sqlite.<name>.transaction(async tx => { ... }): BEGIN, the callback with
// a tx object whose all/get/run run inside the transaction, then COMMIT,
// or ROLLBACK if the callback throws or its promise rejects (the promise
// returned rejects with the same error). Resolves to the callback's value.
sae_sqlite_transaction(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    name, _tx = sqlite_this_(ctx, this_val)
    if name == "" { return sae_throw_type_error(ctx, "sqlite: call it as sqlite.<name>.transaction(fn)") }
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "sqlite.${name}.transaction(fn): fn must be a function") }
    p = page_of_(ctx)
    if string.contains(sqlite_page_dbs_(p), ",${name},") == 0 { return sae_throw_type_error(ctx, "sqlite.${name}: this page did not seek it") }
    f = sqlite_fns_for_(ctx, p)
    if f == null { return sae_throw_type_error(ctx, "sqlite: could not set up the transaction helper") }
    sqlite_tx_ids_ = sqlite_tx_ids_ + 1
    args = quickjs.new_array(ctx)
    fh = quickjs.arg(ctx, argv, 0)
    idh = quickjs.new_int(ctx, sqlite_tx_ids_)
    _s0 = quickjs.set_index(ctx, args, 0, this_val)
    _s1 = quickjs.set_index(ctx, args, 1, fh)
    _s2 = quickjs.set_index(ctx, args, 2, idh)
    quickjs.release(ctx, fh)
    quickjs.release(ctx, idh)
    r, err = quickjs.call(ctx, f.tx_fn, 0, args)
    quickjs.release(ctx, args)
    if err != "" { return rethrow_(ctx) }
    return r
}

// sqlite.<name>.__begin(id): the transaction helper's BEGIN (a job in the
// database's order; waits while another caller's transaction is open).
sae_sqlite_begin(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    name, _tx = sqlite_this_(ctx, this_val)
    if name == "" { return sae_throw_type_error(ctx, "sqlite: call it as sqlite.<name>.transaction(fn)") }
    id = arg_int_(ctx, argv, argc, 0, 0)
    if id <= 0 || id > sqlite_tx_ids_ { return sae_throw_type_error(ctx, "sqlite.${name}: no such transaction") }
    return sqlite_submit_(ctx, sqlite.KIND_EXEC, SQLITE_OP_BEGIN, "BEGIN", "", name, id)
}

// sqlite.<name>.__end(id, commit): its COMMIT (true) or ROLLBACK (false).
sae_sqlite_end(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    name, _tx = sqlite_this_(ctx, this_val)
    if name == "" { return sae_throw_type_error(ctx, "sqlite: call it as sqlite.<name>.transaction(fn)") }
    id = arg_int_(ctx, argv, argc, 0, 0)
    sql = "ROLLBACK"
    if argc > 1 {
        bh = quickjs.arg(ctx, argv, 1)
        if quickjs.to_bool(ctx, bh) == 1 { sql = "COMMIT" }
        quickjs.release(ctx, bh)
    }
    return sqlite_submit_(ctx, sqlite.KIND_EXEC, SQLITE_OP_END, sql, "", name, id)
}
// ===== end wave1/sqlite =====
// ===== wave1/raster: the page API: rasters (vg.raster, vg.image, ui.image) =====
//
// Pixels from a page (docs/roadmap.md 8.2). A raster is an AeVG image element
// (aether-ui's vg.image) whose pixels the page gives as a Uint8Array of
// straight RGBA8, w*h*4 bytes, copied into a buffer the host owns and updates
// in place on vg.raster_update. vg.image decodes PNG/JPEG/GIF/BMP bytes
// through the toolkit into an element that owns its pixels; ui.image makes
// the same picture a widget. Page-scoped, no capability: a page's rasters
// are freed with the page (raster_page_free_, called from page_free_).
//
// Budgets (roadmap decision 9, provisional): RASTER_MAX_DIM on either
// dimension and RASTER_BUDGET bytes of pixels per page in total, decoded
// images included, refused with a TypeError that says which.
//
// The bytes come out of the engine through contrib.quickjs's arg_bytes
// (aether 0.801.0; asks/quickjs-typed-array-bytes.md, resolved): a pointer
// into the array's own window of its buffer, no copy.

const RASTER_BUDGET = 33554432
const RASTER_MAX_DIM = 4096

extern aether_ui_image_decode_rgba_impl(data: ptr, length: int, out_w: ptr, out_h: ptr) -> ptr

// One raster a page made: its vg node (handle = its index in p.vg_nodes),
// the buffer (ours for vg.raster, the element's for vg.image: pix null) and
// its size against the page's budget.
struct PageRaster {
    ctx: ptr
    handle: int
    node: ptr
    pix: ptr
    bytes: int
    pw: int
    ph: int
}

var rasters_: ptr = null     // std.list of *PageRaster, every page's

raster_list_() -> ptr {
    if rasters_ == null { rasters_ = list.new() }
    return rasters_
}

// The page's rasters' bytes so far.
raster_used_(ctx: ptr) -> int {
    l = raster_list_()
    n = list.size(l)
    used = 0
    i = 0
    while i < n {
        rv, _ = list.get(l, i)
        r = rv as *PageRaster
        if r.ctx == ctx { used = used + r.bytes }
        i = i + 1
    }
    return used
}

raster_of_(ctx: ptr, h: int) -> *PageRaster {
    l = raster_list_()
    n = list.size(l)
    i = 0
    while i < n {
        rv, _ = list.get(l, i)
        r = rv as *PageRaster
        if r.ctx == ctx && r.handle == h { return r }
        i = i + 1
    }
    return null
}

raster_add_(ctx: ptr, h: int, node: ptr, pix: ptr, bytes: int, pw: int, ph: int) {
    r = heap.new(PageRaster)
    r.ctx = ctx
    r.handle = h
    r.node = node
    r.pix = pix
    r.bytes = bytes
    r.pw = pw
    r.ph = ph
    list.add(raster_list_(), r as ptr)
}

// Free a page's rasters with it (from page_free_): the buffers vg.raster
// copied into; vg.image's belong to their elements.
raster_page_free_(p: *Page) {
    if rasters_ == null { return }
    i = list.size(rasters_) - 1
    while i >= 0 {
        rv, _ = list.get(rasters_, i)
        r = rv as *PageRaster
        if r.ctx == p.ctx {
            if r.pix != null { free(r.pix) }
            list.list_remove(rasters_, i)
            heap.free(r)
        }
        i = i - 1
    }
}

// "" when a w x h raster of `bytes` more fits the page, else the refusal.
raster_refusal_(ctx: ptr, what: string, w: int, h: int, bytes: int) -> string {
    if w < 1 || h < 1 { return "${what}: ${w}x${h} is not a size" }
    if w > RASTER_MAX_DIM || h > RASTER_MAX_DIM {
        return "${what}: ${w}x${h} is over the ${RASTER_MAX_DIM} limit on either dimension"
    }
    if raster_used_(ctx) + bytes > RASTER_BUDGET {
        return "${what}: this page's rasters would exceed 32 MB of pixels"
    }
    return ""
}

// The bytes of argument i, a Uint8Array (or Uint8ClampedArray): a pointer
// into the engine's buffer, valid until JS runs, and their count; null and
// -1 when it is not one (or is missing).
arg_bytes_(ctx: ptr, argv: int, argc: int, i: int) -> (ptr, int) {
    if i >= argc { return null, -1 }
    b, n = quickjs.arg_bytes(ctx, argv, i)
    if b == null { return null, -1 }
    return b, n
}

// The refusal for a bytes argument that is not one.
bytes_refusal_(what: string, n: int) -> string {
    return "${what}: expected a Uint8Array"
}

// vg.raster(w, h, rgba, block?): a w x h image element at viewBox (0, 0),
// one unit a pixel, drawing a copy of rgba (w*h*4 bytes). Returns its
// handle; the block's vg.box / vg.fit / vg.on_click / vg.transform / ...
// apply to it.
sae_vg_raster(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.raster() must be called inside vg.scene()") }
    p = page_of_(ctx)
    w = arg_int_(ctx, argv, argc, 0, 0)
    h = arg_int_(ctx, argv, argc, 1, 0)
    why = raster_refusal_(ctx, "vg.raster", w, h, w * h * 4)
    if why != "" { return sae_throw_type_error(ctx, why) }
    b, n = arg_bytes_(ctx, argv, argc, 2)
    if b == null { return sae_throw_type_error(ctx, bytes_refusal_("vg.raster(w, h, rgba)", n)) }
    if n != w * h * 4 { return sae_throw_type_error(ctx, "vg.raster(w, h, rgba): rgba has ${n} bytes, not w*h*4 = ${w * h * 4}") }
    pix = malloc(n as long)
    _c = mem.copy(pix, b, n as long)
    node = vg.image(vg_top_(p), 0.0, 0.0, w as float, h as float)
    vg.image_pixels(node, pix, w, h)
    raster_add_(ctx, list.size(p.vg_nodes) + 1, node, pix, n, w, h)
    return vg_shape_done_(ctx, argv, argc, 3, node)
}

// vg.raster_update(h, rgba): new pixels for a raster, the same size, in
// place; the scene repaints.
sae_vg_raster_update(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    r = raster_of_(ctx, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.raster_update(h, rgba): h is not a vg.raster of this page") }
    if r.pix == null { return sae_throw_type_error(ctx, "vg.raster_update(h, rgba): h is a vg.image; its pixels are the picture's") }
    b, n = arg_bytes_(ctx, argv, argc, 1)
    if b == null { return sae_throw_type_error(ctx, bytes_refusal_("vg.raster_update(h, rgba)", n)) }
    if n != r.bytes { return sae_throw_type_error(ctx, "vg.raster_update(h, rgba): rgba has ${n} bytes, not the raster's ${r.bytes}") }
    _c = mem.copy(r.pix, b, n as long)
    vg_repaint_(r.node)
    return 0
}

// vg.image(bytes, block?): an encoded image (PNG, JPEG, GIF, BMP) decoded
// by the toolkit into an element at viewBox (0, 0), one unit a pixel,
// sized as the picture is. Returns its handle.
sae_vg_image(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.image() must be called inside vg.scene()") }
    p = page_of_(ctx)
    b, n = arg_bytes_(ctx, argv, argc, 0)
    if b == null { return sae_throw_type_error(ctx, bytes_refusal_("vg.image(bytes)", n)) }
    node = vg.image(vg_top_(p), 0.0, 0.0, 0.0, 0.0)
    if vg.image_bytes(node, b, n) == 0 {
        return sae_throw_type_error(ctx, "vg.image(bytes): not an image this platform decodes (PNG, JPEG, GIF, BMP)")
    }
    pw = vg.image_pixel_w(node)
    ph = vg.image_pixel_h(node)
    why = raster_refusal_(ctx, "vg.image", pw, ph, pw * ph * 4)
    if why != "" {
        vg.image_pixels(node, null, 0, 0)    // drops the decoded pixels
        return sae_throw_type_error(ctx, why)
    }
    vg.image_box(node, 0.0, 0.0, pw as float, ph as float)
    raster_add_(ctx, list.size(p.vg_nodes) + 1, node, null, pw * ph * 4, pw, ph)
    return vg_shape_done_(ctx, argv, argc, 1, node)
}

// vg.box(x, y, w, h): inside a raster's or image's block, the viewBox box
// it draws into (the default is (0, 0) and its own size).
sae_vg_box(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_shape_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.box() must be called inside a raster's or image's block") }
    vg.image_box(vg_top_(page_of_(ctx)), arg_num_(ctx, argv, argc, 0, 0.0), arg_num_(ctx, argv, argc, 1, 0.0), arg_num_(ctx, argv, argc, 2, 0.0), arg_num_(ctx, argv, argc, 3, 0.0))
    return 0
}

// vg.fit(mode): inside a raster's or image's block, how its pixels fill
// the box: "stretch" (the default), "contain", "cover" or "original".
sae_vg_fit(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_shape_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.fit() must be called inside a raster's or image's block") }
    vg.image_fit(vg_top_(page_of_(ctx)), arg_str_(ctx, argv, argc, 0))
    return 0
}

// vg.rendering(mode): inside a raster's or image's block, how its pixels
// are sampled when scaled: "auto" (the default, smoothed) or "pixelated"
// (each pixel a crisp square: a Life board, pixel art), CSS's
// image-rendering. aether-ui's image_rendering, on every backend.
sae_vg_rendering(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_shape_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.rendering() must be called inside a raster's or image's block") }
    vg.image_rendering(vg_top_(page_of_(ctx)), arg_str_(ctx, argv, argc, 0))
    return 0
}

// vg.raster_size(h): [w, h] of a raster or image, in pixels.
sae_vg_raster_size(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    r = raster_of_(ctx, arg_int_(ctx, argv, argc, 0, 0))
    if r == null { return sae_throw_type_error(ctx, "vg.raster_size(h): h is not a raster or image of this page") }
    return json_value_(ctx, "[${r.pw}, ${r.ph}]")
}

// ui.image(bytes, block?): an encoded image as a widget under the current
// container, at its own size. The picture is decoded once more to count
// its pixels against the page's budget (the widget keeps its own copy).
sae_ui_image(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    b, n = arg_bytes_(ctx, argv, argc, 0)
    if b == null { return sae_throw_type_error(ctx, bytes_refusal_("ui.image(bytes)", n)) }
    wh = malloc(8)
    mem.set_int(wh, 0, 0)
    mem.set_int(wh, 4, 0)
    pix = aether_ui_image_decode_rgba_impl(b, n, wh, mem.long_to_ptr(mem.ptr_to_long(wh) + 4))
    pw = mem.get_int(wh, 0)
    ph = mem.get_int(wh, 4)
    free(wh)
    if pix == null { return sae_throw_type_error(ctx, "ui.image(bytes): not an image this platform decodes (PNG, JPEG, GIF, BMP)") }
    free(pix)
    why = raster_refusal_(ctx, "ui.image", pw, ph, pw * ph * 4)
    if why != "" { return sae_throw_type_error(ctx, why) }
    long t = now_ns_()
    h = ui.image_from_bytes_ptr(mem.long_to_ptr(top_(p)), b, n)
    ui.image_size(h, pw, ph)
    ui_done_(p, t)
    raster_add_(ctx, 0 - h, null, null, pw * ph * 4, pw, ph)
    return container_(ctx, argv, argc, h)
}

// ===== wave1/aevg: the reactive surface and the AeVG surface for pages =====
//
// docs/roadmap.md sections 3.4 and 4. Two halves:
//
// 1. Reactive primitives for the page's `state`/`computed`/`bind`/`each`/
//    `batch` (the JS surface itself is src/sae_prelude.js, evaluated into
//    every page's runtime by api_register_): typed aether-ui cells
//    (ui_state/ui_state_s/_b/_i), computed_s observers, ui_batch, and the
//    property bindings bind_text/bind_value/bind_enabled/bind_hidden.
// 2. The AeVG grammar in TypeScript guise: every shape and modifier goes
//    through aevg/module.ae's record of the scene (groups whose transform,
//    opacity, fill and stroke cascade; defs; a rebuildable viewBox), plus
//    bindings evaluated by vg.refresh(), events beyond click (hover, drag,
//    scroll, double click), tooltips, and defs (gradients, clip paths).
//
// The vg shape verbs and the fill/stroke/opacity/transform/on_click
// modifiers below are registered AFTER the earlier ones of the same name in
// api_register_, so a page gets these: the same arguments and results, plus
// the group cascade and the records that bindings and set_transform need.
// The earlier functions stay as they were (unreferenced from a page, still
// page-veto'd for tests/check_page_veto.sh).
//
// Per-page state lives in a side table keyed by the runtime (ae_page_), not
// in Page: four agents share that struct, and a dead entry (a page that has
// gone) is pruned on the next lookup, so nothing here outlives its page.

extern aether_ui_widget_kind_impl(handle: int) -> string
extern sae_prelude() -> string

struct AePage {
    ctx: ptr
    seq: int
    model: ptr       // *AeModel
    binds: ptr       // std.list of *AeBind
    defs_sb: ptr     // strbuilder while a vg.defs() block runs, else null
    defs_scene: ptr  // the *AeScene the defs go to
}

// A binding the page made with vg.bind_*/visible_when/view_box: evaluated
// by vg.refresh() (which the prelude calls after a state changes).
struct AeBind {
    rec: ptr         // *AeRec (null for a view_box binding: see scene)
    scene: ptr       // *AeScene
    kind: int        // AB_*
    fn_h: int        // the held JS function
}

const AB_FILL = 1
const AB_STROKE = 2
const AB_OPACITY = 3
const AB_TEXT = 4
const AB_POS = 5
const AB_TRANSFORM = 6
const AB_WHEN = 7
const AB_VIEWBOX = 8

var ae_pages_: ptr = null

// The page's wave1/aevg record, made on first use, dropped when its page is
// gone (the runtime pointer may be reused by a later page; the sequence
// number tells them apart).
ae_page_(ctx: ptr) -> *AePage {
    if ae_pages_ == null { ae_pages_ = list.new() }
    p = page_of_(ctx)
    // Prune the dead: entries whose page is no longer live.
    i = 0
    while i < list.size(ae_pages_) {
        v, _ = list.get(ae_pages_, i)
        ap = v as *AePage
        lp = page_of_(ap.ctx)
        if lp == null || lp.seq != ap.seq {
            ae_page_free_(ap)
            list.list_remove(ae_pages_, i)
        } else {
            i = i + 1
        }
    }
    if p == null { return null }
    n = list.size(ae_pages_)
    i = 0
    while i < n {
        v2, _2 = list.get(ae_pages_, i)
        ap2 = v2 as *AePage
        if ap2.ctx == ctx && ap2.seq == p.seq { return ap2 }
        i = i + 1
    }
    ap3 = heap.new(AePage)
    ap3.ctx = ctx
    ap3.seq = p.seq
    ap3.model = aevg.model_new() as ptr
    ap3.binds = list.new()
    ap3.defs_sb = null
    ap3.defs_scene = null
    list.add(ae_pages_, ap3 as ptr)
    return ap3
}

ae_page_free_(ap: *AePage) {
    // The runtime that held the bound functions is gone with the page, so
    // the handles need no release.
    n = list.size(ap.binds)
    i = 0
    while i < n {
        v, _ = list.get(ap.binds, i)
        heap.free(v as *AeBind)
        i = i + 1
    }
    list.free(ap.binds)
    aevg.model_free(ap.model as *AeModel)
    heap.free(ap)
}

ae_model_(ctx: ptr) -> *AeModel {
    return ae_page_(ctx).model as *AeModel
}

// The record of the node on top of the vg stack (the open shape, group or
// scene root), or null.
ae_top_rec_(ctx: ptr) -> *AeRec {
    p = page_of_(ctx)
    if p.vg_depth < 1 { return null }
    m = ae_model_(ctx)
    node = vg_top_(p)
    r = aevg.rec_of(m, node)
    if r != null { return r }
    // A node another section made (wave1/raster's vg.raster and vg.image
    // push theirs through vg_shape_done_): record it now, under the node
    // below it, so the modifiers in its block work as on any shape.
    if p.vg_depth < 2 { return null }
    parent = aevg.rec_of(m, mem.get_ptr(p.vg_stack, (p.vg_depth - 2) * 8))
    if parent == null { return null }
    return aevg.rec_add(m, node, vg.node_element(node), K_SHAPE, parent, parent.scene as *AeScene)
}

// The record of a handle a page holds, or null.
ae_rec_of_handle_(ctx: ptr, h: int) -> *AeRec {
    n = vg_node_of_(page_of_(ctx), h)
    if n == null { return null }
    return aevg.rec_of(ae_model_(ctx), n)
}

// Repaint whatever the call changed.
ae_repaint_(ctx: ptr) {
    aevg.repaint_dirty(ae_model_(ctx))
}

// --- JS value helpers (reading a page's objects) ---

// obj[name] as a string, "" when absent.
ae_prop_str_(ctx: ptr, obj: int, name: string) -> string {
    h, err = quickjs.get(ctx, obj, name)
    if err != "" { return "" }
    t = quickjs.type_of(ctx, h)
    if t == "undefined" || t == "null" {
        quickjs.release(ctx, h)
        return ""
    }
    s = own_(quickjs.to_string(ctx, h))
    quickjs.release(ctx, h)
    return s
}

// 1 if obj has a non-undefined property `name`.
ae_has_prop_(ctx: ptr, obj: int, name: string) -> int {
    h, err = quickjs.get(ctx, obj, name)
    if err != "" { return 0 }
    t = quickjs.type_of(ctx, h)
    quickjs.release(ctx, h)
    if t == "undefined" { return 0 }
    return 1
}

ae_prop_num_(ctx: ptr, obj: int, name: string, dflt: float) -> float {
    h, err = quickjs.get(ctx, obj, name)
    if err != "" { return dflt }
    t = quickjs.type_of(ctx, h)
    if t == "undefined" || t == "null" {
        quickjs.release(ctx, h)
        return dflt
    }
    v = quickjs.to_float(ctx, h)
    quickjs.release(ctx, h)
    return v
}

// arr[i] as a string ("" past the end).
ae_index_str_(ctx: ptr, arr: int, i: int) -> string {
    h, err = quickjs.get_index(ctx, arr, i)
    if err != "" { return "" }
    t = quickjs.type_of(ctx, h)
    if t == "undefined" {
        quickjs.release(ctx, h)
        return ""
    }
    s = own_(quickjs.to_string(ctx, h))
    quickjs.release(ctx, h)
    return s
}

ae_index_num_(ctx: ptr, arr: int, i: int) -> float {
    h, err = quickjs.get_index(ctx, arr, i)
    if err != "" { return 0.0 }
    v = quickjs.to_float(ctx, h)
    quickjs.release(ctx, h)
    return v
}

// Call a held JS function with up to four numbers.
ae_call_nums4_(ctx: ptr, ref: int, a: float, b: float, c: float, d: float, n: int) -> int {
    args = quickjs.new_array(ctx)
    i = 0
    while i < n {
        v = a
        if i == 1 { v = b }
        if i == 2 { v = c }
        if i == 3 { v = d }
        vh = quickjs.new_float(ctx, v)
        _s = quickjs.set_index(ctx, args, i, vh)
        quickjs.release(ctx, vh)
        i = i + 1
    }
    r = calln_(ctx, ref, args)
    quickjs.release(ctx, args)
    return r
}

ae_call_bool_(ctx: ptr, ref: int, b: int) -> int {
    args = quickjs.new_array(ctx)
    vh = quickjs.new_bool(ctx, b)
    _s = quickjs.set_index(ctx, args, 0, vh)
    quickjs.release(ctx, vh)
    r = calln_(ctx, ref, args)
    quickjs.release(ctx, args)
    return r
}

// Call a held JS function with no arguments and return its value's handle
// (0 if it threw; the error is reported).
ae_call_value_(ctx: ptr, ref: int, what: string) -> int {
    r, err = quickjs.call(ctx, ref, 0, 0)
    if err != "" {
        report_exception_(ctx, what)
        return 0
    }
    return r
}

// --- the page API: reactive primitives (the prelude's state/computed/bind) ---

// ui._cell(kind, init): a typed aether-ui cell. kind "f" (number), "s"
// (string), "b" (boolean), "i" (a version counter the prelude bumps for a
// JS value it keeps itself). Returns the cell handle, which is also what
// ui_set/text_bound accept, so the two surfaces interoperate.
sae_ae_cell(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    kind = arg_str_(ctx, argv, argc, 0)
    if kind == "s" { return quickjs.new_int(ctx, ui.ui_state_s(own_(arg_str_(ctx, argv, argc, 1)))) }
    if kind == "b" { return quickjs.new_int(ctx, ui.ui_state_b(quickjs.arg_bool(ctx, argv, 1))) }
    if kind == "i" { return quickjs.new_int(ctx, ui.ui_state_i(arg_int_(ctx, argv, argc, 1, 0))) }
    return quickjs.new_int(ctx, ui.ui_state(arg_num_(ctx, argv, argc, 1, 0.0)))
}

sae_ae_cell_get(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    kind = arg_str_(ctx, argv, argc, 0)
    h = arg_int_(ctx, argv, argc, 1, 0)
    if kind == "s" { return quickjs.new_string(ctx, ui.ui_get_s(h)) }
    if kind == "b" { return quickjs.new_bool(ctx, ui.ui_get_b(h)) }
    if kind == "i" { return quickjs.new_int(ctx, ui.ui_get_i(h)) }
    return quickjs.new_float(ctx, ui.ui_get(h))
}

sae_ae_cell_set(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    kind = arg_str_(ctx, argv, argc, 0)
    h = arg_int_(ctx, argv, argc, 1, 0)
    if kind == "s" { _a = ui.ui_set_s(h, own_(arg_str_(ctx, argv, argc, 2))) }
    else if kind == "b" { _b = ui.ui_set_b(h, quickjs.arg_bool(ctx, argv, 2)) }
    else if kind == "i" { _c = ui.ui_set_i(h, arg_int_(ctx, argv, argc, 2, 0)) }
    else { _d = ui.ui_set(h, arg_num_(ctx, argv, argc, 2, 0.0)) }
    return 0
}

// ui._computed(fn, a, b): run fn now, and again whenever cell a or b
// changes (once per batch). aether-ui's computed_s, whose observer watches
// two cells; the prelude registers one per pair for more inputs.
sae_ae_computed(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    ref = held_fn_(ctx, argv, argc, 0)
    if ref == 0 { return sae_throw_type_error(ctx, "computed(fn, ...states): fn must be a function") }
    a = arg_int_(ctx, argv, argc, 1, 0)
    b = arg_int_(ctx, argv, argc, 2, 0)
    seq = page_of_(ctx).seq
    ui.computed_s(|| {
        // The cell outlives the page; a later page must not be called into.
        lp = page_of_(ctx)
        if lp == null { return }
        if lp.seq != seq { return }
        fire0_(ctx, ref, "a computed")
    }, a, b)
    return 0
}

// ui._batch(fn): aether-ui's ui_batch: observers run once at the end.
sae_ae_batch(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if argc < 1 || is_fn_arg_(ctx, argv, 0) == 0 { return sae_throw_type_error(ctx, "batch(fn): fn must be a function") }
    threw = 0
    ui.ui_batch(|| {
        if call_arg_(ctx, argv, 0) < 0 { threw = 1 }
    })
    if threw == 1 { return rethrow_(ctx) }
    return 0
}

// ui._bind(what, widget, cell, invert): a property binding on a widget the
// page made. what: "text", "value" (two-way, a text field and a string
// cell), "enabled", "hidden".
sae_ae_bind(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    what = arg_str_(ctx, argv, argc, 0)
    w = arg_int_(ctx, argv, argc, 1, 0)
    if owned_(page_of_(ctx), w) == 0 { return sae_throw_type_error(ctx, "bind(widget, state): widget is not one this page made") }
    cell = arg_int_(ctx, argv, argc, 2, 0)
    inv = arg_int_(ctx, argv, argc, 3, 0)
    if what == "value" { ui.bind_value(w, cell) }
    else if what == "enabled" { ui.bind_enabled(w, cell, inv) }
    else if what == "hidden" { ui.bind_hidden(w, cell, inv) }
    else { ui.bind_text(w, cell) }
    return 0
}

// ui._widget_kind(h): the backend's kind name ("textfield", "label", ...),
// so the prelude's bind() can pick two-way for a field.
sae_ae_widget_kind(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    h = arg_int_(ctx, argv, argc, 0, 0)
    if owned_(page_of_(ctx), h) == 0 { return quickjs.new_string(ctx, "") }
    return quickjs.new_string(ctx, own_(aether_ui_widget_kind_impl(h)))
}

// ui._remove_child(parent, child): for each()'s keyed reconciliation: a row
// whose key has gone leaves its container; both must be the page's own.
sae_ae_remove_child(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    parent = arg_int_(ctx, argv, argc, 0, 0)
    child = arg_int_(ctx, argv, argc, 1, 0)
    if own_stack_(p, parent) == 0 || owned_(p, child) == 0 {
        return sae_throw_type_error(ctx, "remove_child(parent, child): not widgets this page made")
    }
    ui.remove_child(parent, child)
    return 0
}

// ui.set_enabled(h, on): grey a widget out, or back.
sae_ae_set_enabled(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    h = own_arg_(ctx, argv, argc)
    if h == 0 { return sae_throw_type_error(ctx, "set_enabled(h, on): h is not a widget this page made") }
    _r = ui.style_enabled(h, quickjs.arg_bool(ctx, argv, 1))
    return 0
}

// --- the page API: vg, with the scene record (aevg/module.ae) ---

// vg.scene(viewBox, w, h, fn): as before, plus the record and the canvas
// events beyond click: hover (and the tooltip), drag, scroll, resize.
sae_ae_scene(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    p = page_of_(ctx)
    vb = own_(arg_str_(ctx, argv, argc, 0))
    w = arg_int_(ctx, argv, argc, 1, 100)
    h = arg_int_(ctx, argv, argc, 2, 100)
    long t = now_ns_()
    root = live.vg(mem.long_to_ptr(top_(p)), vb, w, h)
    ui_done_(p, t)
    scene = vg.node_scene(root)
    m = ae_model_(ctx)
    sc = aevg.scene_add(m, scene, root, vg.scene_canvas(scene), vb, w, h)
    ae_wire_canvas_(ctx, sc)
    return vg_shape_done_(ctx, argv, argc, 3, root)
}

// The canvas hooks for a scene. They replace live.vg's own (one per canvas
// per kind) and keep its work: a full repaint after a click. The page's
// handlers are dispatched here, not through aether-ui's element handlers:
// the record (aevg.hit_at) finds the topmost shape with a handler for the
// event, and the handler runs with viewBox coordinates. A second click
// within 400 ms and 6 px is also a double click. A press on a shape with a
// drag handler captures it until the release. Repaints are held while the
// handlers run (aevg.hold_repaints): each hook repaints once, after them.
ae_wire_canvas_(ctx: ptr, sc: *AeScene) {
    scene = sc.scene
    cid = sc.cid
    seq = page_of_(ctx).seq
    ui.canvas_on_click(cid, |x: float, y: float| {
        if ae_live_(ctx, seq) == 0 { return }
        long now = now_ms_()
        dbl = 0
        if sc.last_click_ms != 0 && now - sc.last_click_ms < 400 {
            dx = x - sc.last_cx
            dy = y - sc.last_cy
            if dx < 6.0 && dx > 0.0 - 6.0 && dy < 6.0 && dy > 0.0 - 6.0 { dbl = 1 }
        }
        sc.last_click_ms = now
        sc.last_cx = x
        sc.last_cy = y
        sc.pressed = 1
        m = ae_model_(ctx)
        aevg.hold_repaints(m)
        r = aevg.hit_at(m, sc, aevg.EV_CLICK, x, y)
        if r != null { ae_fire_xy_(ctx, scene, r.h_click, x, y, "a vg click handler") }
        if dbl == 1 {
            sc.last_click_ms = 0
            rd = aevg.hit_at(m, sc, aevg.EV_DBL, x, y)
            if rd != null { ae_fire_xy_(ctx, scene, rd.h_dbl, x, y, "a vg double-click handler") }
        }
        sc.dragged = aevg.hit_at(m, sc, aevg.EV_DRAG, x, y) as ptr
        if sc.dragged != null {
            dr = sc.dragged as *AeRec
            if dr.h_drag != 0 { ae_fire_drag_(ctx, scene, dr.h_drag, x, y, 0.0, 0.0) }
        }
        if ae_live_(ctx, seq) == 0 { return }
        aevg.scene_mark_dirty(sc)
        aevg.release_repaints(m)
    })
    ui.canvas_on_move(cid, |x: float, y: float| {
        if ae_live_(ctx, seq) == 0 { return }
        m = ae_model_(ctx)
        aevg.hold_repaints(m)
        hv = aevg.hit_at(m, sc, aevg.EV_HOVER, x, y)
        if hv as ptr != sc.hovered {
            old = sc.hovered
            sc.hovered = hv as ptr
            if old != null {
                ro = old as *AeRec
                ae_fire_bool_(ctx, ro.h_hover, 0)
            }
            if hv != null { ae_fire_bool_(ctx, hv.h_hover, 1) }
        }
        if sc.pressed == 1 && sc.dragged != null {
            dr = sc.dragged as *AeRec
            if dr.h_drag != 0 { ae_fire_drag_(ctx, scene, dr.h_drag, x, y, x - sc.last_cx, y - sc.last_cy) }
        }
        sc.last_cx = x
        sc.last_cy = y
        if ae_live_(ctx, seq) == 0 { return }
        c = vg.scene_ctx(scene)
        tip = events.tooltip_at(c, x, y)
        if ui.vg_tooltip_drawn() == 1 {
            if string.length(tip) > 0 { _t = ui.vg_tooltip_show(cid, tip, x, y) } else { ui.vg_tooltip_hide() }
        } else if tip != sc.tooltip {
            sc.tooltip = own_(tip)
            _tt = ui.style_tooltip(ui.canvas_widget(cid), tip)
        }
        aevg.release_repaints(m)
    })
    ui.canvas_on_release(cid, |x: float, y: float| {
        if ae_live_(ctx, seq) == 0 { return }
        sc.pressed = 0
        if sc.dragged != null {
            dr = sc.dragged as *AeRec
            sc.dragged = null
            m = ae_model_(ctx)
            aevg.hold_repaints(m)
            if dr.h_drag_end != 0 { ae_fire_xy_(ctx, scene, dr.h_drag_end, x, y, "a vg drag-end handler") }
            if ae_live_(ctx, seq) == 0 { return }
            aevg.release_repaints(m)
        }
    })
    ui.canvas_on_scroll(cid, |dx: float, dy: float| {
        if ae_live_(ctx, seq) == 0 { return }
        m = ae_model_(ctx)
        aevg.hold_repaints(m)
        r = aevg.hit_at(m, sc, aevg.EV_SCROLL, sc.last_cx, sc.last_cy)
        if r != null {
            if ae_call_nums4_(ctx, r.h_scroll, dx, dy, 0.0, 0.0, 2) < 0 { report_exception_(ctx, "a vg scroll handler") }
            settle_(ctx)
        }
        if ae_live_(ctx, seq) == 0 { return }
        aevg.release_repaints(m)
    })
    ui.canvas_on_resize(cid, |rw: float, rh: float| {
        if ae_live_(ctx, seq) == 0 { return }
        aevg.scene_resize(ae_model_(ctx), sc, rw as int, rh as int)
        ui.canvas_clear(cid)
        live.vg_flush_live(scene, cid, 0.0)
        sc.dirty = 0
    })
}

// Run a page handler with a point, in the scene's viewBox units.
ae_fire_xy_(ctx: ptr, scene: ptr, ref: int, x: float, y: float, what: string) {
    if ae_call_nums4_(ctx, ref, vg.scene_px_to_vb_x(scene, x), vg.scene_px_to_vb_y(scene, y), 0.0, 0.0, 2) < 0 { report_exception_(ctx, what) }
    settle_(ctx)
}

// A drag handler: the point and the step, both in viewBox units (a step
// scales as a position does; the origin cancels out).
ae_fire_drag_(ctx: ptr, scene: ptr, ref: int, x: float, y: float, dx: float, dy: float) {
    sx = vg.scene_px_to_vb_x(scene, dx) - vg.scene_px_to_vb_x(scene, 0.0)
    sy = vg.scene_px_to_vb_y(scene, dy) - vg.scene_px_to_vb_y(scene, 0.0)
    if ae_call_nums4_(ctx, ref, vg.scene_px_to_vb_x(scene, x), vg.scene_px_to_vb_y(scene, y), sx, sy, 4) < 0 { report_exception_(ctx, "a vg drag handler") }
    settle_(ctx)
}

ae_fire_bool_(ctx: ptr, ref: int, b: int) {
    if ae_call_bool_(ctx, ref, b) < 0 { report_exception_(ctx, "a vg hover handler") }
    settle_(ctx)
}

// 1 while the page that made a scene is still the page the runtime pointer
// belongs to (a canvas hook outliving its page must do nothing).
ae_live_(ctx: ptr, seq: int) -> int {
    lp = page_of_(ctx)
    if lp == null { return 0 }
    if lp.seq != seq { return 0 }
    return 1
}

// A shape under the open node: record it (inheriting the group's transform,
// opacity and paint), then run its block as vg_shape_done_ does.
ae_shape_done_(ctx: ptr, argv: int, argc: int, fn_at: int, node: ptr, kind: int) -> int {
    m = ae_model_(ctx)
    parent = ae_top_rec_(ctx)
    sc = null
    if parent != null { sc = parent.scene }
    _r = aevg.rec_add(m, node, vg.node_element(node), kind, parent, sc as *AeScene)
    return vg_shape_done_(ctx, argv, argc, fn_at, node)
}

sae_ae_circle(ctx: ptr, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    argc = quickjs.arg_count(ctx, argv)
    if vg_scene_open_(ctx) == 0 { return sae_throw_type_error(ctx, "vg.circle() must be called inside vg.scene()") }
    p = page_of_(ctx)
    n = vg.circle(vg_top_(p), arg_num_(ctx, argv, argc, 0, 0.0), arg_num_(ctx, argv, argc, 1, 0.0), arg_num_(ctx, argv, argc, 2, 0.0))
    return ae_shape_done_(ctx, argv, argc, 3, n, K_SHAPE)
}

