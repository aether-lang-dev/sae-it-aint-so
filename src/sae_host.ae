// vg.measure(text, size): { width, height, ascent, descent } in pixels, as
// vg.text draws it (the toolkit's own font metrics on every platform).
sae_vg_measure(p: *Page, this_val: int, argv: int) -> int {
    seal except arg_num_, arg_str_, json_value_, quickjs, sae_throw_type_error, vg
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    t = arg_str_(ctx, argv, argc, 0)
    size = arg_num_(ctx, argv, argc, 1, 12.0)
    if size <= 0.0 { return sae_throw_type_error(ctx, "vg.measure(text, size): size must be positive") }
    w = vg.text_width(size, t)
    return json_value_(ctx, "{\"width\": ${w}, \"height\": ${vg.font_height(size)}, \"ascent\": ${vg.font_ascent(size)}, \"descent\": ${vg.font_descent(size)}}")
}

// vg.ellipsize(text, size, maxWidth): text cut to fit maxWidth, ending in
