            doc("What a shape or group is now: its paint, transform and geometry.")
        }
        api("bind_fill", sae_ae_bind_fill, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("The fill follows fn(), re-evaluated on every state set (in a block, or from anywhere with h).")
        }
        api("bind_stroke", sae_ae_bind_stroke, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("The stroke follows fn(): a colour or [colour, width].")
        }
        api("bind_opacity", sae_ae_bind_opacity, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("The opacity follows fn().")
        }
        api("bind_text", sae_ae_bind_text, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("The text follows fn().")
        }
        api("bind_pos", sae_ae_bind_pos, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("The geometry follows fn(): an object of cx, cy, r, x, y, w, h, x1 and so on.")
        }
        api("bind_transform", sae_ae_bind_transform, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("The transform follows fn().")
        }
        api("visible_when", sae_ae_visible_when, 2) {
            arg("h", T_LEAD_NODE)
            arg("fn", T_FN)
            doc("Shown while fn() is true.")
        }
        api("view_box", sae_ae_view_box, 1) {
            arg("source", T_ANY)
            doc("In a scene's block: the viewBox follows a state or fn() (zoom and pan).")
        }
        api("set_view_box", sae_ae_set_view_box, 2) {
            arg("scene", T_VGNODE)
            arg("vb", T_STR)
            doc("Sets a scene's viewBox, \"x y w h\".")
        }
        api("refresh", sae_ae_refresh, 0) {
            doc("Re-evaluates every binding now.")
        }
        api("defs", sae_ae_defs, 1) {
            arg("body", T_BLOCK)
            doc("In a scene's block: its block holds linear_gradient, radial_gradient and clip_path.")
        }
        api("linear_gradient", sae_ae_linear_gradient, 7) {
            arg("id", T_STR)
            arg("x1", T_STR_NUM)
            arg("y1", T_STR_NUM)
            arg("x2", T_STR_NUM)
            arg("y2", T_STR_NUM)
            arg("stops", T_ANY)
            opt("opts", T_OBJ)
            doc("In defs: a linear gradient; stops [[offset, color, opacity?], ...], opts { units, transform, href, spread }.")
        }
        api("radial_gradient", sae_ae_radial_gradient, 6) {
            arg("id", T_STR)
            arg("cx", T_STR_NUM)
            arg("cy", T_STR_NUM)
            arg("r", T_STR_NUM)
            arg("stops", T_ANY)
            opt("opts", T_OBJ)
            doc("In defs: a radial gradient; opts { units, transform, href, spread, fx, fy }.")
        }
        api("clip_path", sae_ae_clip_path, 3) {
            arg("id", T_STR)
            arg("shapes", T_ANY)
            opt("opts", T_OBJ)
            doc("In defs: a clip path of shapes as [[\"circle\", cx, cy, r], [\"rect\", x, y, w, h], [\"path\", d], ...].")
        }
        api("clip", sae_ae_clip, 1) {
            arg("id", T_STR)
            doc("In a block: only what lies inside the clip path id draws.")
        }
        api("css", sae_ae_css, 1) {
            arg("text", T_STR)
            doc("In a scene's block: CSS for the scene's shapes.")
        }
        api("resize", sae_vg_resize, 3) {
            arg("scene", T_VGNODE)
            arg("w", T_INT)
            arg("h", T_INT)
            gives(T_VGNODE)
            doc("The scene's canvas asks for w x h px from now on (1 to 16384); its shapes and handlers stay.")
        }
        api("on_key", sae_vg_on_key, 2) {
            arg("h", T_VGNODE)
            arg("fn", T_FN)
            gives(T_VGNODE)
            doc("fn(key) for keys pressed while the scene's canvas has the keyboard focus; one function a canvas.")
        }
        api("raster", sae_vg_raster, 4) {
            arg("w", T_INT)
            arg("h", T_INT)
            arg("rgba", T_BYTES)
            opt("body", T_BLOCK)
            gives(T_VGNODE)
            doc("A w x h image from RGBA8 bytes (w*h*4), at (0, 0), one viewBox unit a pixel.")
        }
        api("raster_update", sae_vg_raster_update, 2) {
            arg("h", T_VGNODE)
            arg("rgba", T_BYTES)
            doc("New pixels for a raster, in place.")
        }
        api("raster_size", sae_vg_raster_size, 1) {
            arg("h", T_VGNODE)
            gives_ts("[number, number]")
            doc("[w, h] in pixels of a raster or image.")
        }
        api("image", sae_vg_image, 2) {
            arg("bytes", T_BYTES)
            opt("body", T_BLOCK)
            gives(T_VGNODE)
            doc("A PNG, JPEG, GIF or BMP the toolkit decodes, at its own size.")
        }
        api("box", sae_vg_box, 4) {
            arg("x", T_NUM)
            arg("y", T_NUM)
            arg("w", T_NUM)
            arg("h", T_NUM)
            doc("In a raster's or image's block: where it draws.")
        }
        api("fit", sae_vg_fit, 1) {
            arg("mode", T_STR)
            doc("In a raster's or image's block: \"stretch\", \"contain\", \"cover\" or \"original\".")
        }
        api("rendering", sae_vg_rendering, 1) {
            arg("mode", T_STR)
            doc("In a raster's or image's block: \"auto\" (smoothed) or \"pixelated\".")
        }
        api("measure", sae_vg_measure, 2) {
            arg("text", T_STR)
            arg("size", T_NUM)
            gives_ts("{ width: number; height: number; ascent: number; descent: number }")
            doc("The toolkit's metrics, in px, for text drawn at size.")
        }
        api("ellipsize", sae_vg_ellipsize, 3) {
            arg("text", T_STR)
            arg("size", T_NUM)
            arg("maxWidth", T_NUM)
            gives(T_STR)
            doc("text cut to fit maxWidth px, ending in an ellipsis.")
        }
        // From the prelude (src/sae_prelude.js), not the host.
        provided("animate", 3) {
            arg("target", T_ANY)
            arg("opts", T_OBJ)
            opt("done", T_FN)
            gives_ts("{ cancel(): void; done: Promise<void> }")
            doc("Tweens a shape or group (or a numeric state) on the frame clock: opts { to, ms, easing, from, center }.")
        }
        provided("items", 4) {
            arg("list", T_ANY)
            arg("key", T_ANY)
            arg("render", T_FN)
            opt("update", T_FN)
            gives(T_VGNODE)
            doc("A data join into the open group: render(item, i) draws an item and returns its handle; update(item, h, i) refreshes a kept one.")
        }
        provided_value("easings", T_OBJ)
    }
    // The sandbox probe (tests only): what tests/escape/kernel_slip.ts asks
    // sae's own code to do that the page's grants do not allow. There only in a
    // build with SAE_SANDBOX_PROBE and AETHER_UI_TEST_PORT set; never in sae.d.ts.
    test_space(g, "__sae_probe") {
        reach("sandboxprobe")
        api("fs", sae_probe_fs, 0) {
            gives(T_STR)
            internal()
        }
        api("write", sae_probe_write, 0) {
            gives(T_STR)
            internal()
        }
        api("env", sae_probe_env, 0) {
            gives(T_STR)
            internal()
        }
        api("tcp", sae_probe_tcp, 0) {
            gives(T_STR)
            internal()
        }
        api("exec", sae_probe_exec, 0) {
            gives(T_STR)
            internal()
        }
        api("depth", sae_probe_depth, 0) {
            gives(T_INT)
            internal()
        }
        api("tick", sae_probe_tick, 0) { internal() }
    }
    // The module loader's two functions. Not globals: a unit's wrapper takes
    // $sae.m, and the engine calls fail when a page's top-level await rejects.
    loader_fn(g, "m", sae_mod_get, 1) {
        arg("spec", T_STR)
        gives(T_OBJ)
        doc("$sae.m(spec): the namespace of a module this page imported, resolved against the unit's own url. Nothing is fetched; a module not imported statically is a TypeError.")
    }
    provided_space(g, "$sae", WHEN_WRAPPED, "") {
        provided_value("url", T_STR)
        provided("x", 1) {
            arg("exports", T_OBJ)
            rest("pairs")
            internal()
        }
        provided("all", 2) {
            arg("exports", T_OBJ)
            arg("ns", T_OBJ)
            internal()
        }
    }
    held_fn(g, "fail", sae_mod_fail, 1) {
        arg("e", T_ANY)
        doc("What the engine calls when a page's top-level await rejects (a page cannot name it).")
    }
}

// Install the spec's names in a page's runtime.
gate_register_(p: *Page) {
    g = gate_new_(G_REGISTER, p as ptr)
    gate_spec_(g)
    gate_end_(g)
}

// sae --gate-describe: the spec, one JSON line per entry, no UI.
gate_describe_() {
    g = gate_new_(G_DESCRIBE, null)
    gate_spec_(g)
    gate_end_(g)
    fflush(sae_stdout())
}

sae_probe_fs(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_string(p.ctx, sandboxprobe.read_canary(browser_of_(p).probe_dir))
}

sae_probe_write(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_string(p.ctx, sandboxprobe.write_canary(browser_of_(p).probe_dir))
}

sae_probe_env(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_string(p.ctx, sandboxprobe.read_path_var())
}

sae_probe_tcp(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_string(p.ctx, sandboxprobe.connect(browser_of_(p).probe_port))
}

sae_probe_exec(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_string(p.ctx, sandboxprobe.run_true())
}

// The grant levels in force on this thread: 0 outside any entry.
sae_probe_depth(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    return quickjs.new_int(p.ctx, sandboxprobe.levels())
}

sae_probe_tick(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    probe_tick_(browser_of_(p))
    return 0
}

// Install the page API in a page's runtime: everything a page can reach is
// registered here (or in the gate spec it runs, gate_spec_), so this function
// is the sandbox boundary. fs and shell
// exist only in app mode: a
// web page has no such objects at all.
api_register_(p: *Page) {
    // everything but the prelude: said in the gate spec (gate_spec_)
    gate_register_(p)
    // The prelude: the reactive surface over ui's and vg's host primitives
    // (ae_register_), after the gate spec has made them.
    ae_register_(p)
}

page_new_(b: *Browser, url: string, absent: string, http_scopes: string, seeks: string, optional: string, imports: string, wrapped: int) -> *Page {
    p = heap.new(Page)
    p.browser = b
    p.url = own_(url)
    p.absent = own_(absent)
    p.http_scopes = own_(http_scopes)
    p.seeks = own_(seeks)
    p.optional = own_(optional)
    p.imports = own_(imports)
    p.wrapped = wrapped
    p.stack = malloc(STACK_MAX * 4)
    p.depth = 0
    p.ui_ns = 0
    p.ui_calls = 0
    p.vg_stack = malloc(STACK_MAX * 8)
    p.vg_depth = 0
    p.vg_nodes = list.new()
    p.vg_keys = list.new()
    p.stacks = list.new()
    p.grids = list.new()
    p.sheet = null
    p.sheet_strs = list.new()
    p.timers = list.new()
    p.timer_ids = 0
    p.timer_seq = 0
    p.timer_nesting = 0
    p.timers_running = 0
    p.wake = 0
    p.wake_due = 0
    p.rafs = list.new()
    p.raf_batch = null
    p.raf_ids = 0
    p.frame_sub = 0
    p.key_ref = 0
    p.bus_ref = 0
    p.bus_stopped_ref = 0
    p.backend_ref = 0
    p.dgrids = list.new()
    p.menus = list.new()
    p.held = list.new()
    p.sqlite_fns = null
    p.natives_set = ","
    p.esc_logged_http = 0
    p.esc_logged_timers = 0
    p.esc_logged_storage = 0
    p.rasters = list.new()
    p.ae = null
    p.entry_depth = 0
    esc_coarse_decide_(b)
    p.storage_dir = own_(storage_dir_(b, url))
    _sd = fs.mkdir_p(p.storage_dir)
    p.grants = pagegrants.new_page(url, p.storage_dir)
    // An app page: also the documents picked so far (a page loaded after the
    // pick holds them too). Its fs roots are not here: the sae_fs_* functions
    // run services/files outside the list (leave_grants_).
    if b.app_dir != "" { documents.add_grants(b.documents, p.grants) }
    b.page_seq = b.page_seq + 1
    p.seq = b.page_seq
    p.http_res = 0
    p.http_req = 0
    p.on_resize = 0
    p.on_appearance = 0
    p.on_interrupted = 0
    p.interrupting = 0
    p.ctx = engine_new_(b.page_mem)
    list.add(b.pages, p as ptr)
    api_register_(p)
    p.root = ui.vstack(mem.long_to_ptr(b.content), 4)
    // After the root: it is the browser's, like the content area it sits in.
    p.first_handle = aether_ui_widget_count_impl() + 1
    push_(p, p.root)
    return p
}

page_free_(p: *Page) {
    // The control bus's handler goes with its page; the bus keeps listening,
    // and answers that no page serves it until another calls bus.serve.
    bb = p.browser as *Browser
    if bb.bus_page == p as ptr { bb.bus_page = null }
    // A page's timers and animation frames stop with it: a tick after this
    // would call into a freed runtime.
    timers_free_(p)
    modules_free_(p)   // wave1/imports: its module registry
    raster_page_free_(p)   // wave1/raster: its rasters' buffers
    vg_keys_free_(p)
    list.free(p.vg_nodes)
    list.free(p.stacks)
    list.free(p.grids)
    list.free(p.dgrids)
    page_menus_free_(p)
    // The page's sheet styles only its own widgets: un-set it before the
    // next page builds, then free it (free_styles refuses the current one).
    if p.sheet != null {
        aether_ui_current_sheet_set_impl(null)
        ui.free_styles(p.sheet)
    }
    list.free(p.sheet_strs)
    free(p.vg_stack)
    // The runtime goes with everything it held: the page's handlers, its
    // http helpers, its pending promises.
    n = list.size(bb.pages)
    i = 0
    while i < n {
        pv, _ = list.get(bb.pages, i)
        if pv == p as ptr {
            list.list_remove(bb.pages, i)
            break
        }
        i = i + 1
    }
    engine_dispose_(p.ctx)
    if p.ae != null { ae_page_free_(p.ae as *AePage) }   // wave1/aevg: its scene record, once nothing can run
    if p.sqlite_fns != null { heap.free(p.sqlite_fns as *SqlitePageFns) }
    pagegrants.free(p.grants)
    free(p.stack)
    heap.free(p)
}

// Run page source into the page's content area, then the promise jobs it
// queued. Returns 1 on success. Fills times_ns[0..1]: QuickJS compiles and
// runs in one call, so the run time holds both and the parse time is 0.
page_run_(p: *Page, src: string, times_ns: ptr) -> int {
    long t0 = os.now_monotonic_ns()
    mem.set_long(times_ns, 0, 0)
    v, err = engine_eval_(p, src, p.url)
    // wave1/imports: a page with imports or a top-level await is a function
    if err == "" && p.wrapped == 1 { v, err = modules_run_page_(p, v) }
    mem.set_long(times_ns, 8, os.now_monotonic_ns() - t0)
    if err != "" {
        say_("sae: uncaught exception in ${p.url}:\n${err}")
        return 0
    }
    quickjs.release(p.ctx, v)
    settle_(p)
    return 1
}

// ===== wave1/imports: static import, the module registry, and the sae: =====
// ===== library (README "Modules", lower/README.md "Modules") =====
//
// A page's `import` statements are resolved and run before the page. The
// lowerer rewrites each into `$sae.m(spec)` and wraps the page in a function
// taking `$sae`; modules_prepare_ walks the import closure (fetched on the
// same path and rules as pages, each module lowered as a module, hashed,
// cycles refused), runs each module in dependency order into the page's
// registry (url -> namespace object, freed with the page), and
// modules_run_page_ then calls the page with its $sae. `$sae.m` is the one
// page-reachable function here: it looks a resolved URL up in the registry
// and nothing else, so a page can reach only what it imported statically.
//
// Resolution (module_resolve_): "sae:<name>" is the library bundled with
// sae (services/stdlib, no capability needed); "./x.ts", "../x.ts" and
// "/x.ts" resolve against the importer, and must stay on the page's origin
// (browser), inside the bundle (app: URLs), or inside the page's folder
// (a page loaded from a file); an absolute http(s) URL is allowed only on
// the page's own origin. Everything else is refused: another origin, data:,
// any other scheme, bare names. An import may name the bytes it expects,
// "./x.ts#sha256-<hex>", and is refused on a mismatch.
//
// The loader lives here, in the kernel, because it is page lifecycle: it
// needs fetch_ (the one page-fetch path, with its own-origin and app rules)
// and the engine's eval. The library and the integrity checks are a
// service (services/stdlib), an effect held to its imports: it reads one
// directory and digests bytes, and nothing else.

struct PageModule {
    url: string
    ns: int          // the module's namespace ($exports) object, held
}

// A guard against a runaway import graph, not a budget: the spreadsheet
// app (../spraedsheet) is past 64 modules on its own.
const MODULES_MAX = 256

// Where lib/sae is: $SAE_LIB_DIR, or beside the binary (an install's
// lib/sae next to bin/, a packaged .app's Resources/lib/sae, or this
// repository's lib/sae above target/build/bin/). "" if nowhere.
lib_dir_(exe: string) -> string {
    d = env_("SAE_LIB_DIR")
    if d != "" { return d }
    base = dir_of_(exe)
    cands = strarr.new()
    _c1 = strarr.push_copy(cands, "${base}../lib/sae")
    _c2 = strarr.push_copy(cands, "${base}../Resources/lib/sae")
    _c3 = strarr.push_copy(cands, "${base}../../../lib/sae")
    _c4 = strarr.push_copy(cands, "${base}lib/sae")
    out = ""
    i = 0
    while i < strarr.size(cands) {
        c = strarr.get(cands, i)
        if out == "" && fs.exists("${c}/MANIFEST") == 1 { out = own_(c) }
        i = i + 1
    }
    strarr.free(cands)
    return out
}

// A path with its "." and ".." segments collapsed (a leading "/" is kept,
// a relative path stays relative). Returns (path, climbed): climbed 1 if a
// ".." reached above the root.
norm_path_(path: string) -> (string, int) {
    abs = string.string_starts_with(path, "/")
    parts = string.split(path, "/")
    n = string.string_array_size(parts)
    kept = strarr.new()
    nk = 0      // entries of kept in use (strarr has no pop)
    climbed = 0
    i = 0
    while i < n {
        seg = string.string_array_get(parts, i)
        if seg == ".." {
            if nk == 0 { climbed = 1 } else { nk = nk - 1 }
        } else if seg != "." && (seg != "" || i == n - 1) {
            if nk < strarr.size(kept) { strarr.set(kept, nk, seg) } else { _k = strarr.push_copy(kept, seg) }
            nk = nk + 1
        }
        i = i + 1
    }
    out = ""
    k = 0
    while k < nk {
        out = string.concat(out, "/${strarr.get(kept, k)}")
        k = k + 1
    }
    strarr.free(kept)
    if out == "" { out = "/" }
    if abs == 0 { out = string.string_substring(out, 1, string.length(out)) }
    return out, climbed
}

// The origin of an http(s) URL, lowercased.
origin_of_(u: string) -> string {
    return string.string_to_lower(string.string_substring(u, 0, origin_end_(u)))
}

// Resolve an import specifier against the URL of the unit that imports it.
// Returns (url, why): why is "" when the import is allowed.
module_resolve_(b: *Browser, importer: string, spec: string) -> (string, string) {
    clean, _hex, ierr = stdlib.integrity_of(spec)
    if ierr != "" { return "", ierr }
    if string.string_starts_with(clean, "sae:") == 1 {
        name = string.string_substring(clean, 4, string.length(clean))
        if stdlib.name_ok(name) == 0 { return "", "\"${clean}\" is not a library module name: sae:<letters, digits and dashes>" }
        return own_(clean), ""
    }
    if string.string_starts_with(clean, "data:") == 1 {
        return "", "\"${clean}\": data: imports are refused; a page's code comes from its own origin, its bundle, or sae:"
    }
    rel = 0
    if string.string_starts_with(clean, "./") == 1 || string.string_starts_with(clean, "../") == 1 || string.string_starts_with(clean, "/") == 1 { rel = 1 }
    if rel == 0 && is_http_(clean) == 0 && is_app_(clean) == 0 {
        return "", "\"${clean}\" cannot be imported: no bare names (there is no npm here) and no other scheme; a path on this origin (\"./m.ts\", \"/lib/m.ts\") or \"sae:<name>\""
    }
    if b.app_dir != "" {
        if is_http_(clean) == 1 { return "", "\"${clean}\": an app imports only from its own bundle (app:/...) or sae:" }
        u = clean
        if rel == 1 { u = resolve_(importer, clean) }
        path, climbed = norm_path_(string.string_substring(u, 4, string.length(u)))
        if climbed == 1 { return "", "\"${clean}\" climbs above the app's bundle" }
        return string.concat("app:", path), ""
    }
    if is_app_(clean) == 1 { return "", "\"${clean}\": app: pages exist only in an app" }
    if is_http_(importer) == 1 {
        u = clean
        if rel == 1 { u = resolve_(importer, clean) }
        if origin_of_(u) != origin_of_(importer) {
            return "", "\"${clean}\" is not on this page's origin (${origin_of_(importer)}): a page imports only from its own origin or sae:"
        }
        oe = origin_end_(u)
        path, climbed = norm_path_(string.string_substring(u, oe, string.length(u)))
        if climbed == 1 { return "", "\"${clean}\" climbs above the site's root" }
        return string.concat(string.string_substring(u, 0, oe), path), ""
    }
    // a page loaded from a file: its folder is its origin
    if is_http_(clean) == 1 { return "", "\"${clean}\": a page loaded from a file imports only from its own folder or sae:" }
    folder = dir_of_(importer)
    u = resolve_(importer, clean)
    path, climbed = norm_path_(u)
    if climbed == 1 || string.string_starts_with(path, folder) == 0 {
        return "", "\"${clean}\" is outside this page's folder (${folder}): a page loaded from a file imports only from there or sae:"
    }
    return path, ""
}

// The JavaScript side of the loader: a factory making each unit's $sae
// object (its url, $sae.m, and the two helpers the export rewrites use).
const MOD_FACTORY_JS = "(function (m) { return function (url) { return { url: url, m: m, x: function (e) { for (var i = 1; i + 1 < arguments.length; i += 2) Object.defineProperty(e, arguments[i], { get: arguments[i + 1], enumerable: true, configurable: true }); }, all: function (e, ns) { Object.keys(ns).forEach(function (k) { if (k !== 'default' && !(k in e)) Object.defineProperty(e, k, { get: function () { return ns[k]; }, enumerable: true, configurable: true }); }); } }; }; })"

// A one-element arguments array for quickjs.call (released by the caller).
args1_(p: *Page, h: int) -> int {
    ctx = p.ctx
    a = quickjs.new_array(ctx)
    _e = js_set_index_(p, a, 0, h)
    return a
}

// A unit's $sae object (a new handle).
mod_loader_(p: *Page, url: string) -> (int, string) {
    us = quickjs.new_string(p.ctx, url)
    a = args1_(p, us)
    lo, err = js_call_(p, p.mod_factory, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, us)
    return lo, err
}

// The registry entry for url, or null.
mod_find_(p: *Page, url: string) -> *PageModule {
    if p.modules == null { return null }
    n = list.size(p.modules)
    i = 0
    while i < n {
        mv, _ = list.get(p.modules, i)
        m = mv as *PageModule
        if m.url == url { return m }
        i = i + 1
    }
    return null
}

// Fetch, check, lower and run one module and, first, the modules it
// imports. chain is the import path so far ("a -> b"), for cycles. Returns
// "" or why not.
mod_load_(p: *Page, url: string, seeks: string, hex: string, chain: string, loading: ptr) -> string {
    if mod_find_(p, url) != null { return "" }
    if list.size(p.modules) >= MODULES_MAX { return "${url}: more than ${MODULES_MAX} modules in one page" }
    n = strarr.size(loading)
    i = 0
    while i < n {
        if strarr.get(loading, i) == url { return "import cycle: ${chain} -> ${url}" }
        i = i + 1
    }
    src = ""
    if string.string_starts_with(url, "sae:") == 1 {
        s, rerr = stdlib.read_module((p.browser as *Browser).stdlib, string.string_substring(url, 4, string.length(url)))
        if rerr != "" { return rerr }
        src = s
    } else {
        status, body, _final, ferr = fetch_(p.browser as *Browser, url)
        if ferr != "" { return "${url}: ${ferr}" }
        if status != 200 { return "${url}: answered ${status}, not 200 (a module must be served as itself)" }
        src = body
    }
    if hex != "" {
        got = stdlib.sha256(src)
        if got != hex { return "${url}: sha256 ${got} does not match the import's #sha256-${hex}" }
    }
    lw = lower.lower_module(src, url, seeks)
    lerr = own_(lw.err)
    text = own_(lw.js)
    imports = own_(lw.imports)
    lower.lowered_free(lw)
    if lerr != "" { return lerr }
    _l = strarr.push_copy(loading, url)
    why = mod_imports_(p, url, imports, seeks, "${chain} -> ${url}", loading)
    strarr.set(loading, strarr.size(loading) - 1, "")   // popped (no pop in strarr)
    if why != "" { return why }
    return mod_run_(p, url, text)
}

// Load each import of a unit at url, from the lowerer's list ("spec\tline\tcol").
mod_imports_(p: *Page, url: string, imports: string, seeks: string, chain: string, loading: ptr) -> string {
    lines = string.split(imports, "\n")
    n = string.string_array_size(lines)
    i = 0
    while i < n {
        l = string.string_array_get(lines, i)
        if l != "" {
            f = string.split(l, "\t")
            spec = string.string_array_get(f, 0)
            at = "${url}:${string.string_array_get(f, 1)}:${string.string_array_get(f, 2)}"
            target, why = module_resolve_(p.browser as *Browser, url, spec)
            if why != "" { return "${at}: import refused: ${why}" }
            _c, hex, _e = stdlib.integrity_of(spec)
            why2 = mod_load_(p, target, seeks, hex, chain, loading)
            if why2 != "" { return "${at}: import \"${spec}\": ${why2}" }
        }
        i = i + 1
    }
    return ""
}

// Run a lowered module (a function of ($sae, $exports)) and register its
// namespace.
mod_run_(p: *Page, url: string, text: string) -> string {
    fn, err = engine_eval_(p, text, url)
    if err != "" { return "${url}: ${err}" }
    lo, lerr = mod_loader_(p, url)
    if lerr != "" {
        quickjs.release(p.ctx, fn)
        return "${url}: ${lerr}"
    }
    ns = quickjs.new_object(p.ctx)
    a = quickjs.new_array(p.ctx)
    _e1 = js_set_index_(p, a, 0, lo)
    _e2 = js_set_index_(p, a, 1, ns)
    r, cerr = js_call_(p, fn, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, lo)
    quickjs.release(p.ctx, fn)
    if cerr != "" {
        quickjs.release(p.ctx, ns)
        return "${url}: ${cerr}"
    }
    quickjs.release(p.ctx, r)
    m = heap.new(PageModule)
    m.url = own_(url)
    m.ns = ns
    list.add(p.modules, m as ptr)
    return ""
}

// After the page is lowered and made, before it runs: load its import
// closure. Reads the lowerer's record of the page (what it imports, whether
// it is wrapped) before any module is lowered over it. Returns "" or why
// the page cannot run.
modules_prepare_(p: *Page) -> string {
    p.modules = list.new()
    p.mod_factory = 0
    imports = p.imports
    seeks = string.concat(p.seeks, p.optional)
    if imports == "" && p.wrapped == 0 { return "" }
    f, ferr = engine_eval_(p, MOD_FACTORY_JS, "sae:loader")
    if ferr != "" { return "the module loader could not start: ${ferr}" }
    a = args1_(p, p.mod_get)
    fac, cerr = js_call_(p, f, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, f)
    if cerr != "" { return "the module loader could not start: ${cerr}" }
    p.mod_factory = fac
    loading = strarr.new()
    _l = strarr.push_copy(loading, p.url)
    why = mod_imports_(p, p.url, imports, seeks, p.url, loading)
    strarr.free(loading)
    return why
}

// Run a wrapped page: call its function with the page's $sae. An async
// wrapper (a top-level await) gives a promise; a rejection of it is
// reported as an uncaught exception, through $sae.fail. Returns (value, "")
// or (0, error).
modules_run_page_(p: *Page, fn: int) -> (int, string) {
    lo, lerr = mod_loader_(p, p.url)
    if lerr != "" {
        quickjs.release(p.ctx, fn)
        return 0, lerr
    }
    a = args1_(p, lo)
    r, err = js_call_(p, fn, 0, a)
    quickjs.release(p.ctx, a)
    quickjs.release(p.ctx, lo)
    quickjs.release(p.ctx, fn)
    if err != "" { return 0, err }
    if quickjs.type_of(p.ctx, r) == "promise" {
        then, terr = js_get_(p, r, "then")
        if terr == "" {
            ta = quickjs.new_array(p.ctx)
            und = quickjs.new_undefined(p.ctx)
            _t1 = js_set_index_(p, ta, 0, und)
            _t2 = js_set_index_(p, ta, 1, p.mod_fail)
            r2, _e = js_call_(p, then, r, ta)
            quickjs.release(p.ctx, r2)
            quickjs.release(p.ctx, und)
            quickjs.release(p.ctx, ta)
            quickjs.release(p.ctx, then)
        }
    }
    return r, ""
}

modules_free_(p: *Page) {
    if p.modules == null { return }
    n = list.size(p.modules)
    i = 0
    while i < n {
        mv, _ = list.get(p.modules, i)
        m = mv as *PageModule
        quickjs.release(p.ctx, m.ns)
        heap.free(m)
        i = i + 1
    }
    list.free(p.modules)
    p.modules = null
    if p.mod_factory != 0 { quickjs.release(p.ctx, p.mod_factory) }
    quickjs.release(p.ctx, p.mod_get)
    quickjs.release(p.ctx, p.mod_fail)
}

// --- the page API: $sae, the loader object a unit's wrapper takes ---

// $sae.m(spec): the namespace of a module this page imported, resolved
// against the unit's own URL (this.url). Nothing is fetched here: a module
// not in the registry (not imported statically) is a TypeError.
sae_mod_get(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    spec = arg_str_(ctx, argv, argc, 0)
    url = js_prop_str_(p, this_val, "url", p.url)
    target, why = module_resolve_(p.browser as *Browser, url, spec)
    if why != "" { return sae_throw_type_error(ctx, "import refused: ${why}") }
    m = mod_find_(p, target)
    if m == null { return sae_throw_type_error(ctx, "\"${spec}\" is not imported by this page (imports are static: an import statement at the top of the page)") }
    return quickjs.dup(ctx, m.ns)
}

// $sae.fail(e): what a page's top-level await left unhandled.
sae_mod_fail(p: *Page, this_val: int, argv: int) -> int {
    hide fs, os, client, net, lower, pagegrants, env_, fetch_, load_, go_, run_nav_, page_new_, page_free_, page_run_, browser_new_, build_chrome_, set_status_, sae_main, engine_new_, engine_eval_, engine_dispose_
    ctx = p.ctx
    argc = quickjs.arg_count(ctx, argv)
    say_("sae: uncaught exception in ${p.url} (after a top-level await):\n${arg_str_(ctx, argv, argc, 0)}")
    return 0
}

// --- navigation ---

set_status_(b: *Browser, s: string) {
    if b.status != 0 { ui.set_text(b.status, s) }
}

// Tear down the current page (its widgets, then its context) and load url
// into the content area. Does not touch history.
load_(b: *Browser, url: string) {
    long t0 = os.now_monotonic_ns()
    status, body, final_url, err = fetch_(b, url)
    long t_fetch = os.now_monotonic_ns()

    ui.clear_children(b.content)
    if b.page != null {
        page_free_(b.page as *Page)
        b.page = null
    }
    if b.addr != 0 { ui.set_text(b.addr, final_url) }

    if err != "" {
        ui.text(mem.long_to_ptr(b.content), "Could not load ${url}")
        ui.text(mem.long_to_ptr(b.content), err)
        set_status_(b, "error: ${err}")
        println("sae: could not load ${url}: ${err}")
        b.last_ok = 0
        return
    }

    b.source = own_(body)   // for "View page source"
    long t_lower0 = os.now_monotonic_ns()
    lw = lower.lower_source(body, final_url)
    long lower_ns = os.now_monotonic_ns() - t_lower0
    lerr = own_(lw.err)
    es5 = own_(lw.js)
    seeks = own_(lw.seeks)
    optional = own_(lw.optional)
    page_scopes = own_(lw.scopes)
    imports = own_(lw.imports)
    wrapped = lw.wrapped
    lower.lowered_free(lw)
    if lerr != "" {
        ui.text(mem.long_to_ptr(b.content), "This page could not be read:")
        ui.text(mem.long_to_ptr(b.content), lerr)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${lerr}")
        b.last_ok = 0
        return
    }

    // What the page seeks, against what this context grants: refused here,
    // before any of its code runs, with the reason (docs/app-capabilities.md).
    why = seek_refusal_(b, final_url, seeks)
    if why != "" {
        ui.text(mem.long_to_ptr(b.content), "This page cannot run here:")
        ui.text(mem.long_to_ptr(b.content), why)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${why}")
        b.last_ok = 0
        return
    }

    // Optional privileges this context cannot give are left out; scopes are
    // checked against the grant here too, before any of the page runs. An
    // optional outgoing-http whose scope reaches past the grant goes the
    // same way as one not granted at all: the page does without.
    absent = absent_of_(b, optional)
    // A privilege the page does not seek at all has no object either. The
    // lowerer refuses a page that names one unsought, but only by name:
    // without this, globalThis["ht" + "tp"] would reach it.
    absent = string.concat(absent, unsought_(seeks, optional))
    scopes, swhy = http_scopes_for_(b, final_url, page_scopes)
    if swhy != "" {
        if string.contains(optional, ",outgoing-http,") == 1 {
            absent = string.concat(absent, "outgoing-http,")
            swhy = ""
            scopes = ""
        }
    }
    if swhy != "" {
        ui.text(mem.long_to_ptr(b.content), "This page cannot run here:")
        ui.text(mem.long_to_ptr(b.content), swhy)
        set_status_(b, "${status} ${final_url}")
        println("sae: ${swhy}")
        b.last_ok = 0
        return
    }

    p = page_new_(b, final_url, absent, scopes, seeks, optional, imports, wrapped)
    b.page = p
    // ===== wave1/imports: the page's static imports, fetched, lowered and
    // run before the page (README "Modules"); refused with the reason.
    mwhy = modules_prepare_(p)
    if mwhy != "" {
        ui.text(mem.long_to_ptr(b.content), "This page's imports could not be loaded:")
        ui.text(mem.long_to_ptr(b.content), mwhy)
        set_status_(b, "${status} ${final_url}")
        say_("sae: ${mwhy}")
        b.last_ok = 0
        return
    }
    times = malloc(16)
    ok = page_run_(p, es5, times)
    long parse_ns = mem.get_long(times, 0)
    long run_ns = mem.get_long(times, 8)
    free(times)
    b.last_ok = ok
    // vg scenes record their shapes while the page builds and draw once it
    // is done (AeVG's deferred mode, so a shape's trailing fill() is known
    // before it paints). Aether's window() drains that after its block; a
    // page loads into an already-running window, so drain it here.
    aether_ui_surface_flush_deferred_impl()
    if ok == 0 {
        ui.text(mem.long_to_ptr(b.content), "This page failed: see the console.")
    }
    set_status_(b, "${status} ${final_url}")
    println("sae: ${status} ${final_url} (us) fetch=${us_(t_fetch - t0)} lower=${us_(lower_ns)} parse=${us_(parse_ns)} run=${us_(run_ns)} widgets=${us_(p.ui_ns)}/${p.ui_calls} js=${us_(run_ns - p.ui_ns)}")
}

hist_url_(b: *Browser, i: int) -> string {
    return strarr.get(b.history, i)
}

// Go to url as a new history entry, dropping any forward entries.
go_(b: *Browser, url: string) {
    i = b.hist_index + 1
    if i < strarr.size(b.history) {
        strarr.set(b.history, i, own_(url))
    } else {
        strarr.push_copy(b.history, url)
    }
    b.hist_index = i
    b.hist_len = i + 1
    load_(b, url)
}

run_nav_(b: *Browser) {
    kind = b.pending_kind
    url = b.pending_url
    b.pending_kind = NAV_NONE
    if kind == NAV_GO {
        // An app's pages navigate only among themselves (Tauri's default).
        if b.app_dir != "" && is_app_(url) == 0 {
            println("sae: this app navigates only to its own pages; refused ${url}")
            fflush(sae_stdout())
            return
        }
        // wave1/escape: a web page stays on http(s); no path climbs out.
        // The rule holds a page's own navigations; an address typed into
        // the browser's bar is the person's, and goes where they say (a file
        // page's folder does not bound them), as esc_nav_check_ intends.
        typed = b.nav_typed
        b.nav_typed = 0
        nurl = url
        if typed == 0 || b.app_dir != "" {
            n2, nwhy = esc_nav_check_(b, url)
            if nwhy != "" {
                esc_log_(nwhy)
                return
            }
            nurl = n2
        }
        go_(b, nurl)
    }
    if kind == NAV_BACK {
        if b.hist_index > 0 {
            b.hist_index = b.hist_index - 1
            load_(b, hist_url_(b, b.hist_index))
        }
    }
    if kind == NAV_FORWARD {
        if b.hist_index + 1 < b.hist_len {
            b.hist_index = b.hist_index + 1
            load_(b, hist_url_(b, b.hist_index))
        }
    }
    if kind == NAV_RELOAD {
        if b.hist_index >= 0 { load_(b, hist_url_(b, b.hist_index)) }
    }
}

// --- the sandbox probe (tests only) ---
//
// tests/escape/kernel_slip.ts asks sae's own code to do something the page's
// grants do not allow, from every kind of entry. The probe is that code: each
// operation is what a slip in the kernel would be (a read of a file that is
// not the page's, the environment, a connection, exec, a write), taking
// nothing from the page, and reports what happened. It is installed by
// api_register_ only when SAE_SANDBOX_PROBE=<canary folder> and
// AETHER_UI_TEST_PORT are both set (browser_new_ reads them), so a browser
// run by a person has no __sae_probe.
// The kernel's ticks, run from inside the entry that called this: what a
// nested event loop would do. Each begins by returning while an entry runs.
probe_tick_(b: *Browser) {
    http_poll_(b)
    later_tick_(b)
}

// --- after the entry ---
//
// An effect a page asks for that is not the page's to do under its grants (it
// opens a URL in the system's browser, shows a print dialog, may run a nested
// event loop) is checked at the call, queued, and done by a kernel tick once
// no page JS is running: not under the page's list, which holds its own
// storage and nothing else, and not on the page's stack. The checks stay
// synchronous, so the page still gets its refusal as a throw; a failure after
// them is reported on the console.
const LATER_SHELL_OPEN = 1   // a: the URL
const LATER_PRINT_PDF = 2    // a: the PDF as base64, b: the job's title
const LATER_BUS_LISTEN = 3   // the control bus starts listening (its courier file, its socket)
const LATER_BUS_SILENCE = 4  // it stops (its courier file is deleted, its socket closed)
const LATER_BACKEND_RESTART = 5  // backend.restart(): the backend killed and started again

struct LaterJob {
    kind: int
    a: string
    b: string
}

later_add_(b: *Browser, kind: int, a: string, arg_b: string) {
    j = heap.new(LaterJob)
    j.kind = kind
    j.a = own_(a)
    j.b = own_(arg_b)
    list.add(b.later, j as ptr)
    if b.later_timer == 0 { b.later_timer = ui.timer(1, || { later_tick_(b) }) }
}

// Each tick: the queued effects, in order, once no entry is running.
later_tick_(b: *Browser) {
    // Page JS is running (a nested event loop under a host call): wait.
    if b.entry_depth > 0 { return }
    while list.size(b.later) > 0 {
        v, _ = list.get(b.later, 0)
        list.list_remove(b.later, 0)
        j = v as *LaterJob
        why = ""
        if j.kind == LATER_SHELL_OPEN { why = shell.open(b.shell, j.a) }
        if j.kind == LATER_PRINT_PDF { why = printing.pdf(b.printing, j.a, j.b) }
        if j.kind == LATER_BUS_LISTEN { why = bus_listen_(b) }
        if j.kind == LATER_BUS_SILENCE { bus_silence_(b) }
        if j.kind == LATER_BACKEND_RESTART { backend_restart_(b) }
        if why != "" { say_("sae: ${why}") }
        heap.free(j)
    }
    ui.timer_cancel(b.later_timer)
    b.later_timer = 0
}

// Record a navigation and carry it out on the next turn of the event loop.
// The latest request wins, as a second click on a link would.
request_nav_(b: *Browser, kind: int, url: string) {
    b.pending_kind = kind
    b.pending_url = own_(url)
    b.nav_typed = 0   // the Go button sets it again after this; a page never does
    if b.nav_timer == 0 {
        b.nav_timer = ui.timer(1, || {
            // Not while page JS is running (a nested event loop under a host
            // call): the timer stays armed and the next tick navigates.
            if b.entry_depth > 0 { return }
            ui.timer_cancel(b.nav_timer)
            b.nav_timer = 0
            run_nav_(b)
        })
    }
}

// --- the window ---

build_chrome_(b: *Browser, root: int) {
    rctx = mem.long_to_ptr(root)
    bar = ui.hstack(rctx, 4)
    bctx = mem.long_to_ptr(bar)
    ui.btn(bctx, "Back", || { request_nav_(b, NAV_BACK, "") })
    ui.btn(bctx, "Forward", || { request_nav_(b, NAV_FORWARD, "") })
    ui.btn(bctx, "Reload", || { request_nav_(b, NAV_RELOAD, "") })
    b.addr = ui.textfield(bctx, "address", |s: string| { })
    // The bar's spare width (a field's own is its natural 140 px).
    _fa = ui.fill_width(b.addr)
    // Named for a screen reader (a placeholder is a hint, not a name).
    _fl = ui.a11y_label(b.addr, "Address")
    ui.btn(bctx, "Go", || {
        typed = ui.get_text(b.addr)
        base = ""
        if b.page != null { base = (b.page as *Page).url }
        // Local addresses are paths from the working directory, just like
        // the command-line argument and the path shown in this field.
        // Only web/app addresses resolve against the current page. Page
        // links still use resolve_ for directory-relative navigation.
        target = own_(typed)
        if is_http_(base) == 1 || is_app_(base) == 1 {
            target = resolve_(base, typed)
        }
        request_nav_(b, NAV_GO, target)
        b.nav_typed = 1   // the person asked, not the page: see run_nav_
    })
    b.status = ui.text(rctx, "")
    ui.divider(rctx)
    build_content_(b, rctx)
}

// The scrolling area pages build into. In app mode it is all there is.
build_content_(b: *Browser, rctx: ptr) {
    scroller = ui.scrollview(rctx)
    b.content = ui.vstack(mem.long_to_ptr(scroller), 4)
    b.body = scroller
    // A right click in the page, on nothing deeper with a menu of its own:
    // the page's menu (ui.context_menu(0, items)), then sae's section. A
    // page with no menu still has sae's.
    ui.on_secondary_click(scroller, |x: float, y: float| {
        if b.page == null { open_menu_(b, null, 0, scroller); return }
        p = b.page as *Page
        open_menu_(b, p, page_menu_items_(p, 0), scroller)
    })
}

browser_new_() -> *Browser {
    b = heap.new(Browser)
    b.history = strarr.new()
    b.hist_len = 0
    b.hist_index = -1
    b.page = null
    b.pending_kind = NAV_NONE
    b.nav_timer = 0
    b.page_mem = PAGE_MEM_DEFAULT
    b.page_time_ms = page_time_ms_()
    b.entry_depth = 0
    b.app_data = ""
    b.later = list.new()
    // The sandbox probe: a page-API object only a test build with both
    // variables set installs (probe_* below).
    b.probe_dir = ""
    b.probe_port = 0
    if env_("AETHER_UI_TEST_PORT") != "" {
        b.probe_dir = own_(env_("SAE_SANDBOX_PROBE"))
        pn, _perr = string.to_int(env_("AETHER_UI_TEST_PORT"))
        b.probe_port = pn
    }
    b.later_timer = 0
    b.menu_h = 0
    b.body = 0
    b.source = ""
    b.backend_declared = 0
    b.backend = null
    b.backend_why = "this app has no backend (app.json capabilities.backend)"
    b.backend_ids = 0
    b.backend_calls = list.new()
    b.backend_timer = 0
    b.backend_deadline_ms = BACKEND_DEADLINE_MS
    b.control = null
    b.control_timer = 0
    b.bus = bus.new()
    b.bus_flag = 0
    b.uncontained = 0
    b.backend_decl = null
    b.backend_restarts = list.new()
    b.bus_ui_granted = 0
    b.bus_page = null
    b.bus_timer = 0
    b.bus_told_off = 0
    b.bus_inflight = 0
    b.bus_since = 0
    b.bus_interrupted = 0
    b.bus_ui_pending = list.new()
    b.files = files.new()
    b.documents = documents.new()
    b.clipboard = clipboard.new()
    b.shell = shell.new()
    b.printing = printing.new()
    b.net = net.new()
    b.stdlib = stdlib.new()
    b.sqlite_jobs = sqlite_jobs_new_()
    b.native_jobs = native_jobs_new_()
    b.http_jobs = http_jobs_new_()
    b.app_dir = ""
    b.app_name = ""
    b.app_key = ""
    b.pages = list.new()
    b.page_seq = 0
    clk = heap.new(Clock)
    clk.scale = 1
    clock_start_(clk)
    clk.base_mono = 0
    clk.base_unix = 0
    b.clock = clk
    b.gesture = 0
    b.menu_bar = 0
    b.menu_bar_seq = 0
    b.app_menus = list.new()
    b.menu_open = 0
    b.window_up = 0
    b.keys_hooked = 0
    b.esc_coarse = 0
    b.clip_read_granted = 0
    b.nav_typed = 0
    pm = env_("SAE_PAGE_MEM")
    if pm != "" {
        v, perr = string.to_long(pm)
        if perr == "" && v > 0 { b.page_mem = v }
    }
    return b
}

// --- app mode ---
//
// `sae --app <dir>`, or a binary that finds its pages beside it in a macOS
// .app bundle (Contents/Resources/app): no browser chrome, the window titled
// and sized for the app, pages loaded from <dir> as app: URLs. The optional
// <dir>/app.json:
//   { "name": "Banking", "start": "/", "width": 800, "height": 600 }

// 1 if `d` holds an app: an app.json, index.ts or index.js.
is_app_dir_(d: string) -> int {
    if fs.exists("${d}/app.json") == 1 { return 1 }
    if fs.exists("${d}/index.ts") == 1 { return 1 }
    if fs.exists("${d}/index.js") == 1 { return 1 }
    return 0
}

// The pages a packaged binary carries, or "" when there are none:
// <exe dir>/../Resources/app (the .app layout tools/saepack.sh makes), else
// app/ in the working directory (an APK from tools/saepack-android.sh: the
// Android backend copies the app's assets out and runs it among them).
bundled_app_dir_(exe: string) -> string {
    d = string.concat(dir_of_(exe), "../Resources/app")
    if is_app_dir_(d) == 1 { return d }
    if is_app_dir_("app") == 1 { return "app" }
    return ""
}

// A string or int setting from app.json, or the default.
app_setting_(v: ptr, key: string, dflt: string) -> string {
    if v == null { return dflt }
    f = json.json_object_get_raw(v, key)
    if f == null { return dflt }
    sv, serr = json.get_string(f)
    if serr != "" { return dflt }
    return own_(sv)
}

app_setting_int_(v: ptr, key: string, dflt: int) -> int {
    if v == null { return dflt }
    f = json.json_object_get_raw(v, key)
    if f == null { return dflt }
    return json.json_get_int(f)
}

// The last path component, for an app's default name.
base_name_(d: string) -> string {
    t = d
    while string.string_ends_with(t, "/") == 1 { t = string.string_substring(t, 0, string.length(t) - 1) }
    return string.string_substring(t, string.length(dir_of_(t)), string.length(t))
}

// sae <url | page>             the browser
// sae --app <dir>              an app, without browser chrome
// sae --app <dir> --control-bus     its control bus on (docs/control-bus.md)
// sae --app <dir> --control-stdio   driven by the program that started it, over stdin and stdout (docs/app-backend.md)
// sae (in a packaged .app)     the app bundled beside the binary
// sae (in an APK)              the app among the files it runs in
main() {
    // sae --gate-describe: the gate spec as JSON lines, no UI (tools/saegate).
    if os.args_get(1) == "--gate-describe" {
        gate_describe_()
        return
    }
    // sae --app <dir> --control-stdio: the program that started sae drives
    // the app over sae's stdin and stdout (docs/app-backend.md, "The control
    // channel"). Claimed before anything is printed: a byte written to
    // stdout before the claim would land in the channel.
    ctl = null
    if os.args_get(1) == "--app" && os.args_get(3) == "--control-stdio" {
        ch, cerr = channel.claim()
        if cerr != "" {
            _w = fputs("sae: ${cerr}\n", sae_stderr())
            exit(2)
        }
        ctl = ch
    }
    // sae --app <dir> --control-bus: the person switches the app's control
    // bus on for this launch (docs/control-bus.md, decision 2).
    bus_flag = 0
    if os.args_get(3) == "--control-bus" { bus_flag = 1 }
    // sae --app <dir> [...] --uncontained-backend: the person runs a socket
    // backend with no process sandbox whatever app.json says, where Aether
    // cannot contain one (docs/design/ipc-backends.md).
    uncontained = 0
    k = 3
    while k < os.args_count() {
        if os.args_get(k) == "--uncontained-backend" { uncontained = 1 }
        k = k + 1
    }
    code = sae_main(os.args_get(1), os.args_get(2), slashes_(os.argv0()), ctl, bus_flag, uncontained)
    if code != 0 { exit(code) }
}

// A path from the system with "/" separators. Windows gives them with "\\"
// (os.argv0() as C:\dir\sae.exe, fs.realpath, %APPDATA%), and every path
// the kernel takes apart (dir_of_, base_name_, the files service) splits on
// "/". Elsewhere a "\\" is a character a name may hold, and is kept.
slashes_(p: string) -> string {
    if os.platform() == "windows" { return string.string_replace_all(p, "\\", "/") }
    return p
}

sae_main(arg1: string, arg2: string, exe: string, ctl: @keep ptr, bus_flag: int, uncontained: int) -> int {
    app = ""
    start_url = arg1
    if arg1 == "--app" { app = arg2 }
    if arg1 == "" { app = bundled_app_dir_(exe) }
    if app == "" && start_url == "" {
        println("usage: sae <url | page.js>   or   sae --app <dir>")
        return 2
    }
    title = "Sae it ain't so"
    w = 800
    h = 600
    b = browser_new_()
    b.control = ctl
    b.bus_flag = bus_flag
    b.uncontained = uncontained
    stdlib.configure(b.stdlib, lib_dir_(exe))   // wave1/imports: the sae: library
    root = aether_ui_vstack_create(6)
    b.root = root
    // The window's size, for ui.on_resize: its own stack's layout.
    ui.on_layout(root) callback |w: int, h: int| { window_laid_out_(b, w, h) }
    // The system's light or dark, for ui.on_appearance.
    ui.on_appearance_change(|dark: int| { appearance_to_page_(b, dark) })
    sqlite_why = ""   // wave1/sqlite: why the app cannot start, if a database cannot be opened or migrated
    if app != "" {
        while string.string_ends_with(app, "/") == 1 { app = string.string_substring(app, 0, string.length(app) - 1) }
        b.app_dir = own_(app)
        manifest = null
        mtext, merr = fs.read("${app}/app.json")
        if merr == "" {
            mv, _jerr = json.parse(mtext)
            manifest = mv
        }
        title = app_setting_(manifest, "name", base_name_(app))
        b.app_name = own_(title)
        b.app_data = own_(app_data_dir_(b))
        bundled = 0
        if arg1 == "" { bundled = 1 }
        b.app_key = app_storage_key_(app, exe, bundled)
        w = app_setting_int_(manifest, "width", 800)
        h = app_setting_int_(manifest, "height", 600)
        // memory (MB): an installed app's page may have more heap than a web
        // page's 32 MB (a spreadsheet of 100,000 cells needs some hundreds),
        // from 32 to 2048; SAE_PAGE_MEM, a test's, still comes first.
        if env_("SAE_PAGE_MEM") == "" {
            mb = app_setting_int_(manifest, "memory", 32)
            if mb < 32 { mb = 32 }
            if mb > 2048 { mb = 2048 }
            long mbl = mb
            b.page_mem = mbl * 1048576
        }
        start_url = resolve_("app:/", app_setting_(manifest, "start", "/"))
        read_capabilities_(b, manifest)
        sqlite_why = sqlite_start_(b, manifest)   // wave1/sqlite: before any page runs
        if sqlite_why == "" { sqlite_why = natives_start_(b, manifest) }   // wave1/natives
        if sqlite_why == "" { sqlite_why = backend_start_(b, manifest) }   // the app's backend
        if b.control != null { control_start_(b) }   // --control-stdio
        build_content_(b, mem.long_to_ptr(root))
    } else {
        build_chrome_(b, root)
        b.app_data = own_(app_data_dir_(b))
    }
    if sqlite_why != "" { sqlite_refuse_app_(b, sqlite_why) } else { go_(b, start_url) }   // wave1/sqlite

    if env_("SAE_NO_WINDOW") != "" {
        if b.page != null { page_free_(b.page as *Page) }
        if b.last_ok == 1 { return 0 }
        return 1
    }
    port = env_("AETHER_UI_TEST_PORT")
    if port != "" {
        pn, _ = string.to_int(port)
        ui.enable_test_server_root(pn, root)
    }
    // The page lives as long as the window, so it is not freed here: a
    // desktop backend's window_run returns as the process ends, and
    // Android's returns at once (the platform's loop runs the app from
    // then on, through the page's handlers).
    // The first page may have started the control bus before the window
    // existed: its title says so from the start.
    if bus.listening(b.bus) == 1 { title = "${title} - control bus on" }
    if channel.alive(b.control) == 1 { title = "${title} - control channel on" }
    b.window_up = 1
    if b.menu_bar != 0 {
        // The first page made menus: the window is made with its bar.
        app_h = ui.app_create(title, w, h)
        ui.attach_menu_bar(app_h, b.menu_bar)
        ui.app_start(app_h, root)
        return 0
    }
    ui.window_run(title, w, h, root)
    if b.backend != null { backend.stop(b.backend) }
    return 0
}
