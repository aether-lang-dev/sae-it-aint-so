    if argc < 2 || is_fn_arg_(ctx, argv, 1) == 0 { return sae_throw_type_error(ctx, "ui.on_submit(h, fn): fn must be a function") }
    ref = hold_arg_(ctx, argv, 1)
    ui.on_submit(h) callback |t: string| {
        r = call1_str_(ctx, ref, t)
        if r < 0 { report_exception_(ctx, "a ui.on_submit handler") }
        settle_(ctx)
    }
    return 0
}

