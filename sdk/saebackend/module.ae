// saebackend — the backend side of an app's backend process (docs/app-backend.md): what an
// app's own Aether program imports to answer its pages.
//
// sae starts the backend with the channel as its stdin and stdout (std.os's
// run_stdio; `wslc run -i` passes them through from a container), and
// open() claims them first thing (std.ipc's stdio_channel): from then on
// stdin reads end of file and stdout is stderr, so a stray print, a
// library's diagnostic or a panic lands on stderr, never inside a frame.
// Print nothing before open(): that would go into the channel, and sae
// stops a backend that writes something that is not a frame. A backend
// reads calls, answers each one, and may send events its pages listen for:
//
//   import std.io
//   import saebackend
//   main() {
//       sb, err = saebackend.open()
//       if err != "" { io.stderr_write("${err}\n"); exit(2) }   // stderr: stdout may be the channel
//       while 1 == 1 {
//           id, name, arg, rerr = saebackend.next(sb)
//           if rerr != "" { break }          // sae closed the channel: exit
//           if name == "echo" { saebackend.answer(sb, id, arg) }
//           else { saebackend.fail(sb, id, "no call ${name}") }
//       }
//   }
//
// Build it with this folder on the module path:
//   AETHER_LIB_DIR=<sae>/sdk ae build backend/main.ae -o backend/main
//
// sae may instead start the backend on a socket (app.json
// capabilities.backend.channel "socket", docs/design/ipc-backends.md): its
// fd 3, std.ipc's socket channel, and open() takes that when it is there,
// leaving stdin and stdout as they were. The program is the same either
// way. A socket carries one thing the pipes cannot: an open descriptor, a
// document the person picked, handed over with a call; handed() gives it.
// poll() is next() without waiting, for a backend that looks for a call
// (a cancel, say) between the steps of a long job.
//
// The frames are services/backend's (one JSON object each). Each SaeBackend
// is an instance with its own channel; nothing here is shared.
//
// Writes (answer, fail, emit) wait while the pipe is full. sae reads it every
// tick whatever its page is doing, and when it gives the backend up it closes
// its end, so a write fails rather than waits for good. The other way sae
// holds the bound itself: a backend that stops reading its stdin for 5 s is
// killed (docs/app-backend.md, "The write bound").

import std.ipc
import std.io (fd_close)
import std.json
import std.string

exports (open, next, poll, handed, answer, fail, emit, channel_kind)

const MAX_FRAME = 1048576

struct SaeBackend {
    rd: int     // the channel's read end (what was stdin, or the socket)
    wr: int     // its write end (what was stdout, or the same socket)
    kind: string  // "socket" or "stdio"
    fd: int     // the descriptor handed with the last call, not yet taken, or -1
}

// A descriptor's byte must follow its frame within this.
const FD_MS = 2000

// The channel sae started this program with: the socket at fd 3 when there
// is one, else stdin and stdout, claimed. (backend, "") or (null, why). Call
// it first thing in main, once.
open() -> (ptr, string) {
    rd = 0 - 1
    wr = 0 - 1
    kind = "stdio"
    if ipc.parent_channel_kind() == "socket" {
        rd = ipc.parent_channel()
        wr = rd
        kind = "socket"
    } else {
        r, w, err = ipc.stdio_channel()
        if err != "" { return null, "saebackend: ${err}" }
        rd = r
        wr = w
    }
    b = heap.new(SaeBackend)
    b.rd = rd
    b.wr = wr
    b.kind = kind
    b.fd = 0 - 1
    return b as ptr, ""
}

// "socket" or "stdio": the channel open() took.
channel_kind(h: ptr) -> string {
    b = h as *SaeBackend
    return b.kind
}

// The open descriptor sae handed over with the call next() (or poll())
// returned last, or -1. The caller owns it from here and closes it; one not
// taken is closed by the next call to next().
handed(h: ptr) -> int {
    b = h as *SaeBackend
    fd = b.fd
    b.fd = 0 - 1
    return fd
}

// The next call if one is waiting, without waiting for one:
// (id, name, arg, "") with name "" when none is, or (0, "", "", why) as next.
poll(h: ptr) -> (int, string, string, string) {
    b = h as *SaeBackend
    ready, err = ipc.wait_readable(b.rd, 0)
    if err != "" { return 0, "", "", err }
    if ready == 0 { return 0, "", "", "" }
    return next(h)
}

// The next call: (id, name, arg, ""), or (0, "", "", why) when the channel
// has closed (sae is stopping: the backend should exit) or broke.
next(h: ptr) -> (int, string, string, string) {
    b = h as *SaeBackend
    if b.fd >= 0 {
        _c = fd_close(b.fd)
        b.fd = 0 - 1
    }
    data, err = ipc.read_frame(b.rd, MAX_FRAME)
    if err != "" { return 0, "", "", err }
    v, perr = json.parse(data)
    if perr != "" || v == null { return 0, "", "", "saebackend: a frame that is not JSON: ${perr}" }
    idv = json.json_object_get_raw(v, "id")
    id = 0
    if idv != null { id = json.json_get_int(idv) }
    name, _ne = json.get_string(json.json_object_get_raw(v, "call"))
    arg, _ae = json.get_string(json.json_object_get_raw(v, "arg"))
    name = string.copy(name)
    arg = string.copy(arg)
    fdv = json.json_object_get_raw(v, "fd")
    with_fd = 0
    if fdv != null { with_fd = json.json_get_bool(fdv) }
    json.json_free(v)
    if with_fd == 1 {
        // The descriptor rides on one byte straight after the frame.
        ready, werr = ipc.wait_readable(b.rd, FD_MS)
        if werr != "" { return 0, "", "", werr }
        if ready == 0 { return 0, "", "", "saebackend: call ${id} said a descriptor was coming, and none came within ${FD_MS} ms" }
        _byte, fd, rerr = ipc.recv(b.rd, 1)
        if rerr != "" { return 0, "", "", "saebackend: ${rerr}" }
        if fd < 0 { return 0, "", "", "saebackend: call ${id} said a descriptor was coming, and the byte after it carried none" }
        b.fd = fd
    }
    return id, name, arg, ""
}

// Answer call `id` with `result`. "" or why not.
answer(h: ptr, id: int, result: string) -> string {
    o = json.obj()
    _i = json.set(o, "id", json.from_int(id))
    _k = json.set(o, "ok", json.boolean(1))
    _r = json.set(o, "result", json.str(result))
    return send_(h, o)
}

// Answer call `id` with a failure: the page's promise rejects with `why`.
fail(h: ptr, id: int, why: string) -> string {
    o = json.obj()
    _i = json.set(o, "id", json.from_int(id))
    _k = json.set(o, "ok", json.boolean(0))
    _e = json.set(o, "error", json.str(why))
    return send_(h, o)
}

// An event the page hears with backend.on(name, fn), unasked.
emit(h: ptr, name: string, data: string) -> string {
    o = json.obj()
    _e = json.set(o, "event", json.str(name))
    _d = json.set(o, "data", json.str(data))
    return send_(h, o)
}

send_(h: ptr, o: ptr) -> string {
    b = h as *SaeBackend
    text, eerr = json.encode(o)
    json.json_free(o)
    if eerr != "" { return "saebackend: ${eerr}" }
    return ipc.write_frame(b.wr, text)
}
