// sae, the browser. One native binary: the QuickJS engine (Aether's
// contrib.quickjs, compiled from the Aether tree sae builds against), the
// aether-ui toolkit (via the aether-ui and ui symlinks) and sae's own host.

import bldr
import bldr (dep)
import c
import c (sources, aether_source, cflag, link_flag, output_file, aether_home, aether_caps, include)
import std.os
import std.string

// The AetherUIDriver control server is opt-in, as in aether-ui: a listening
// socket must not ship by default. AETHER_UI_WITH_DRIVER=1 links it.
// The driver build is a separate binary, sae-driver: aeb's link cache does
// not key on the environment, so one output name for both would hand back
// whichever was linked last.
with_driver_() -> int {
    if string.length(os.getenv("AETHER_UI_WITH_DRIVER")) > 0 { return 1 }
    return 0
}

control_source_() -> string {
    if with_driver_() == 1 { return "aether-ui/backend/aether_ui_test_server.c" }
    return "aether-ui/backend/aether_ui_no_control.c"
}

output_name_() -> string {
    if with_driver_() == 1 { return "sae-driver" }
    return "sae"
}

// The Aether the engine and host compile against. SAE_AETHER_HOME names an
// Aether dev tree (one with build/libaether.a), for working on the compiler
// alongside sae; ./build.sh sets it when ../aether is one. Unset, the
// installed toolchain on PATH is used (what ./bootstrap.sh installs). Not
// AETHER_HOME, which names the toolchain aeb itself runs on (the same split
// as a dev tree's own build uses).
aether_root_() -> string {
    root = os.getenv("SAE_AETHER_HOME")
    if string.length(root) > 0 { return root }
    return ""
}

// wave1/raster: where contrib.quickjs's QuickJS header is, for
// src/sae_raster.c (the typed-array bytes workaround): the dev tree's
// contrib/, or the installed toolchain's share/aether/contrib/.
quickjs_include_() -> string {
    root = aether_root_()
    if string.length(root) > 0 { return "${root}/contrib/quickjs/amalgamation" }
    return "${os.getenv("AETHER_HOME")}/current/share/aether/contrib/quickjs/amalgamation"
}

// The `ae` that reports libaether's own link dependencies.
ae_bin_() -> string {
    root = aether_root_()
    if string.length(root) > 0 { return "${root}/build/ae" }
    return "ae"
}

aeb(cap) {
    bldr.build() {
        c.program() {
            cflag("-Os")
            cflag("-D_GNU_SOURCE")
            cflag("-fno-math-errno")
            cflag("-fno-trapping-math")
            if string.length(aether_root_()) > 0 { aether_home(aether_root_()) }
            // ui reads theme files (std.fs) and the environment (std.os);
            // the host reads and fetches pages (std.fs, std.http). Pages
            // themselves get none of these.
            aether_caps("fs,os,net")

            // The engine, contrib.quickjs, comes with the import: aeb
            // compiles the C its module ships (@source) and the amalgamation
            // that C includes (fetched into the Aether tree by build.sh).
            aether_source("src/sae_host.ae")
            sources("src/sae_rom.c")
            // wave1/raster: a page's Uint8Array bytes (see the file's header).
            sources("src/sae_raster.c")
            include(quickjs_include_())

            // aether-ui's macOS backend (the darwin arm of aether-ui's
            // build_support/aetherui ui_backend, which targets the aether
            // SDK rather than c.program).
            sources("aether-ui/backend/aether_ui_macos.m")
            sources(control_source_())
            sources("aether-ui/backend/aether_ui_system_extras.c")
            cflag("-fobjc-arc")
            link_flag("-framework AppKit")
            link_flag("-framework Foundation")
            link_flag("-framework QuartzCore")
            link_flag("-framework CoreText")
            link_flag("-framework ImageIO")
            link_flag("-framework OpenGL")

            // libaether's own dependencies (OpenSSL for std.http, ...),
            // as aether-ui's ui_backend gets them.
            link_flag("$(${ae_bin_()} cflags --libs 2>/dev/null)")
            link_flag("-lpthread")
            link_flag("-lm")
            output_file(output_name_())
        }
        return 0
    }
}
