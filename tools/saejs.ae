// saejs — run a JavaScript file on the engine sae runs pages on
// (contrib.quickjs), with only `print`: what the lowerer tests run their
// output with.
//
//   target/saejs file.js
import contrib.quickjs
import std.fs
import std.os
import std.string

extern exit(code: int)
extern putchar(c: int) -> int

print_(q: ptr, this_h: int, args: int) -> int {
    n = quickjs.arg_count(q, args)
    i = 0
    while i < n {
        if i > 0 { putchar(32) }
        print(quickjs.arg_string(q, args, i))
        i = i + 1
    }
    println("")
    return 0
}

main() {
    if os.args_count() < 2 {
        println("usage: saejs file.js")
        exit(2)
    }
    path = os.args_get(1)
    src, err = fs.read(path)
    if err != "" {
        println("saejs: cannot read ${path}: ${err}")
        exit(2)
    }
    // The heap, 64 MB, or SAE_PAGE_MEM's bytes (an app may ask its page
    // for more: app.json's memory, which a test of it runs with).
    kb = 65536
    mv = os.getenv("SAE_PAGE_MEM")
    if mv != null {
        n, nerr = string.to_int(mv)
        if nerr == "" && n >= 1048576 { kb = n / 1024 }
    }
    q = quickjs.runtime(kb, 0)
    // The time limit, 10 s, or SAE_TIME_LIMIT's ms (a test that times a big
    // workbook's steps, which together take longer).
    limit = 10000
    lv = os.getenv("SAE_TIME_LIMIT")
    if lv != null {
        ln, lerr = string.to_int(lv)
        if lerr == "" && ln >= 1000 { limit = ln }
    }
    quickjs.set_time_limit(q, limit)
    pf = quickjs.function(q, "print", 1, print_)
    quickjs.set_global(q, "print", pf)
    quickjs.release(q, pf)
    v, e = quickjs.eval(q, src, path)
    if e != "" {
        println(e)
        quickjs.dispose(q)
        exit(1)
    }
    quickjs.release(q, v)
    _n, je = quickjs.run_jobs(q)
    quickjs.dispose(q)
    if je != "" {
        println(je)
        exit(1)
    }
}
