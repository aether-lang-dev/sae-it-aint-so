// A development page server, filesystem-mapped the way Tsyne's sample server
// is: GET /about serves <site>/about.ts (or about.js), GET / serves the index
// page, an unknown path serves the 404 page with status 404. GET /old-home answers
// 302 to /, to exercise redirect following.
//
//   ae run tools/pageserver.ae -- <site-dir> [port]     (default port 8090)

import std.http
import std.http.middleware
import std.fs
import std.dir
import std.os
import std.string

// Declared here because std.http.middleware does not export it, although
// aether's docs/http-server.md calls it bare ("Custom error pages").
extern aether_error_pages_opts_new() -> ptr

struct Site {
    dir: string
}

// A page is <name>.ts, or <name>.js if there is no .ts; a path that already
// ends in .ts or .js (a module, imported as written) is that file.
page_file_(site: *Site, path: string) -> string {
    stem = "${site.dir}${path}"
    if path == "/" || path == "" { stem = "${site.dir}/index" }
    if string.string_ends_with(stem, ".ts") == 1 || string.string_ends_with(stem, ".js") == 1 { return stem }
    if fs.exists("${stem}.ts") == 1 { return "${stem}.ts" }
    return "${stem}.js"
}

// Routes for the pages of <site>/<sub> (sub "" or "lib/", say), one level
// of subdirectories under the root.
route_dir_(server: ptr, site: *Site, sub: string) {
    l, lerr = dir.list("${site.dir}/${sub}")
    if lerr != "" {
        println("pageserver: cannot list ${site.dir}/${sub}")
        exit(1)
    }
    n = dir.list_count(l)
    i = 0
    while i < n {
        name = dir.list_get(l, i)
        is_page = string.string_ends_with(name, ".js") == 1 || string.string_ends_with(name, ".ts") == 1
        if is_page && name != "index.js" && name != "index.ts" {
            route = "/${sub}${string.string_substring(name, 0, string.length(name) - 3)}"
            http.server_get(server, route, serve_page_, site)
            http.server_get(server, "/${sub}${name}", serve_page_, site)
        } else if is_page == 0 && sub == "" && string.contains(name, ".") == 0 {
            route_dir_(server, site, "${name}/")
        }
        i = i + 1
    }
}

serve_page_(req: ptr, res: ptr, ud: ptr) {
    site = ud as *Site
    f = page_file_(site, http.request_path(req))
    body, err = fs.read(f)
    if err != "" {
        body, err = fs.read(page_file_(site, "/404"))
        http.response_set_status(res, 404)
    } else {
        http.response_set_status(res, 200)
    }
    http.response_set_header(res, "Content-Type", "text/javascript")
    http.response_set_body(res, body)
}

// A small API for pages that use http.get / http.post (spec_http):
//   GET  /api/echo?msg=x   -> "echo: x"
//   POST /api/echo         -> "posted: <body>"
//   GET  /api/json         -> {"n":42,"items":["a","b","c"]}
//   any  /api/headers      -> "<METHOD> x-test=<X-Test header> body=<body>",
//                             with an X-Answer: forty-two response header
//   GET  /api/slow?ms=n    -> "slow done", after n milliseconds
api_echo_get_(req: ptr, res: ptr, ud: ptr) {
    m = http.http_get_query_param(req, "msg")
    if m == null { m = "" }
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "echo: ${m}")
}

api_echo_post_(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "posted: ${http.request_body(req)}")
}

api_json_(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, "{\"n\":42,\"items\":[\"a\",\"b\",\"c\"]}")
}

api_headers_(req: ptr, res: ptr, ud: ptr) {
    t = http.http_get_header(req, "X-Test")
    if t == null { t = "" }
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_header(res, "X-Answer", "forty-two")
    http.response_set_body(res, "${http.request_method(req)} x-test=${t} body=${http.request_body(req)}")
}

api_slow_(req: ptr, res: ptr, ud: ptr) {
    ms = 1000
    q = http.http_get_query_param(req, "ms")
    if q != null {
        v, verr = string.to_int(q)
        if verr == "" { ms = v }
    }
    sleep(ms)
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "slow done")
}

// --- A mock GitHub (Enterprise layout, /api/v3), for spec_gitify ---
//
// Three notifications in two repositories; the token is "test-token". Read
// and done state lives here until the server stops, so a spec sees what a
// PATCH or PUT did. Not GitHub: only the calls examples/gitify makes.

var gh_live_ = 7    // bit n-1: notification n is unread

gh_authed_(req: ptr, res: ptr) -> int {
    a = http.http_get_header(req, "Authorization")
    if a != null && a == "token test-token" { return 1 }
    http.response_set_status(res, 401)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, "{\"message\":\"Bad credentials\"}")
    return 0
}

gh_json_(res: ptr, status: int, body: string) {
    http.response_set_status(res, status)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, body)
}

gh_note_(n: int) -> string {
    if n == 1 {
        return "{\"id\":\"1\",\"unread\":true,\"reason\":\"mention\",\"updated_at\":\"2026-10-03T10:00:00Z\",\"subject\":{\"title\":\"Crash on start\",\"url\":\"http://127.0.0.1:8091/api/v3/repos/octo/hello/issues/7\",\"latest_comment_url\":null,\"type\":\"Issue\"},\"repository\":{\"full_name\":\"octo/hello\",\"html_url\":\"https://github.com/octo/hello\"}}"
    }
    if n == 2 {
        return "{\"id\":\"2\",\"unread\":true,\"reason\":\"review_requested\",\"updated_at\":\"2026-10-02T09:00:00Z\",\"subject\":{\"title\":\"Add dark mode\",\"url\":\"http://127.0.0.1:8091/api/v3/repos/octo/hello/pulls/8\",\"latest_comment_url\":null,\"type\":\"PullRequest\"},\"repository\":{\"full_name\":\"octo/hello\",\"html_url\":\"https://github.com/octo/hello\"}}"
    }
    return "{\"id\":\"3\",\"unread\":true,\"reason\":\"subscribed\",\"updated_at\":\"2026-09-30T08:00:00Z\",\"subject\":{\"title\":\"v1.2.0\",\"url\":null,\"latest_comment_url\":null,\"type\":\"Release\"},\"repository\":{\"full_name\":\"octo/tools\",\"html_url\":\"https://github.com/octo/tools\"}}"
}

gh_user_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    gh_json_(res, 200, "{\"login\":\"octocat\",\"id\":583231}")
}

gh_notifications_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    part = http.http_get_query_param(req, "participating")
    only = 0
    if part != null && part == "true" { only = 1 }
    out = "["
    n = 1
    while n <= 3 {
        bit = 1
        if n == 2 { bit = 2 }
        if n == 3 { bit = 4 }
        // Notification 3 (a subscription) is not participating.
        if (gh_live_ & bit) != 0 && (only == 0 || n != 3) {
            if out != "[" { out = string.concat(out, ",") }
            out = string.concat(out, gh_note_(n))
        }
        n = n + 1
    }
    http.response_set_header(res, "X-Poll-Interval", "60")
    gh_json_(res, 200, string.concat(out, "]"))
}

gh_thread_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    p = http.request_path(req)
    bit = 1
    if string.string_ends_with(p, "/2") == 1 { bit = 2 }
    if string.string_ends_with(p, "/3") == 1 { bit = 4 }
    gh_live_ = gh_live_ & (7 - bit)
    http.response_set_status(res, 205)
    http.response_set_body(res, "")
}

gh_mark_all_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    gh_live_ = 0
    gh_json_(res, 205, "")
}

gh_mark_repo_hello_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    gh_live_ = gh_live_ & 4
    gh_json_(res, 205, "")
}

gh_issue_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    gh_json_(res, 200, "{\"html_url\":\"https://github.com/octo/hello/issues/7\"}")
}

gh_pull_(req: ptr, res: ptr, ud: ptr) {
    if gh_authed_(req, res) == 0 { return }
    gh_json_(res, 200, "{\"html_url\":\"https://github.com/octo/hello/pull/8\"}")
}

redirect_home_(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 302)
    http.response_set_header(res, "Location", "/")
    http.response_set_body(res, "")
}

// /api/redirect?to=<url>: a 302 to wherever `to` says, for checking that a
// page's request is held to its grant and scopes on every redirect hop.
api_redirect_(req: ptr, res: ptr, ud: ptr) {
    to = http.http_get_query_param(req, "to")
    if to == null { to = "/" }
    http.response_set_status(res, 302)
    http.response_set_header(res, "Location", to)
    http.response_set_body(res, "")
}

// --- wave1/escape: the browser's security rules (spec_webrules, spec_escape) ---
//
// The request's headers, one "name: value" line each, names lowercased, in
// the order they came: what sae actually sent (no Referer, no Cookie, an
// Origin only across origins).
req_headers_text_(req: ptr) -> string {
    out = ""
    n = http.request_header_count(req)
    i = 0
    while i < n {
        out = string.concat(out, "${string.to_lower(http.request_header_name(req, i))}: ${http.request_header_value(req, i)}\n")
        i = i + 1
    }
    return out
}

//   GET /api/reqheaders   -> the request's headers (req_headers_text_)
api_reqheaders_(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, req_headers_text_(req))
}

//   GET /api/setcookie    -> "cookie set", with a Set-Cookie sae must ignore
api_setcookie_(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_header(res, "Set-Cookie", "sae=1; Path=/")
    http.response_set_body(res, "cookie set")
}

//   GET /api/cors?allow=<origin or *>  -> "cors: ok" then the request's
//   headers, with Sae-Allow-Origin: <allow> when `allow` is given (the
//   CORS-alike's consent), and no such header otherwise. A page on another
//   origin (http://localhost:8091 is one, beside http://127.0.0.1:8091) is
//   handed the body only when the header names its origin or is *.
api_cors_(req: ptr, res: ptr, ud: ptr) {
    allow = http.http_get_query_param(req, "allow")
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_header(res, "X-Secret", "the body and headers stay out of reach without consent")
    if allow != null && allow != "" { http.response_set_header(res, "Sae-Allow-Origin", allow) }
    http.response_set_body(res, "cors: ok\n${req_headers_text_(req)}")
}

main() {
    if os.args_count() < 2 {
        println("usage: pageserver <site-dir> [port]")
        exit(2)
    }
    site = heap.new(Site)
    site.dir = string.concat(os.args_get(1), "")
    port = 8090
    if os.args_count() > 2 {
        p, _ = string.to_int(os.args_get(2))
        port = p
    }

    server = http.server_create(port)
    if server == 0 {
        println("pageserver: could not bind ${port}")
        exit(1)
    }
    http.server_get(server, "/", serve_page_, site)
    http.server_get(server, "/old-home", redirect_home_, 0)
    http.server_get(server, "/api/echo", api_echo_get_, 0)
    http.server_post(server, "/api/echo", api_echo_post_, 0)
    http.server_get(server, "/api/json", api_json_, 0)
    http.server_get(server, "/api/redirect", api_redirect_, 0)
    http.http_server_add_route(server, "GET", "/api/headers", api_headers_, 0)
    http.http_server_add_route(server, "PATCH", "/api/headers", api_headers_, 0)
    http.http_server_add_route(server, "PUT", "/api/headers", api_headers_, 0)
    http.http_server_add_route(server, "DELETE", "/api/headers", api_headers_, 0)
    http.server_get(server, "/api/v3/user", gh_user_, 0)
    http.server_get(server, "/api/v3/notifications", gh_notifications_, 0)
    http.http_server_add_route(server, "PUT", "/api/v3/notifications", gh_mark_all_, 0)
    http.http_server_add_route(server, "PUT", "/api/v3/repos/octo/hello/notifications", gh_mark_repo_hello_, 0)
    http.server_get(server, "/api/v3/repos/octo/hello/issues/7", gh_issue_, 0)
    http.server_get(server, "/api/v3/repos/octo/hello/pulls/8", gh_pull_, 0)
    t = 1
    while t <= 3 {
        http.http_server_add_route(server, "PATCH", "/api/v3/notifications/threads/${t}", gh_thread_, 0)
        http.http_server_add_route(server, "DELETE", "/api/v3/notifications/threads/${t}", gh_thread_, 0)
        t = t + 1
    }
    http.server_get(server, "/api/slow", api_slow_, 0)
    // wave1/escape: the browser's security rules
    http.server_get(server, "/api/reqheaders", api_reqheaders_, 0)
    http.server_get(server, "/api/setcookie", api_setcookie_, 0)
    http.server_get(server, "/api/cors", api_cors_, 0)

    // One route per page file (routes are exact paths, no wildcard), and
    // for the files of each subdirectory (site/lib/card.ts: a module a page
    // imports) both as written (/lib/card.ts) and as a page (/lib/card).
    route_dir_(server, site, "")

    // Anything unrouted gets the site's own 404 page.
    nf, nerr = fs.read(page_file_(site, "/404"))
    if nerr == "" {
        ep = aether_error_pages_opts_new()
        middleware.error_pages_register(ep, 404, nf, "text/javascript")
        middleware.use_error_pages(server, ep)
    }

    println("pageserver: serving ${site.dir} on http://127.0.0.1:${port}/")
    http.server_start(server)
}
