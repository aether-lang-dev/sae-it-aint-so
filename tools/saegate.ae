// saegate: what the gate spec says (`sae --gate-describe`: one JSON line per
// entry on stdin), as TypeScript, and as the expectations
// tests/check_gate.sh holds the live page objects to
// (docs/design/gate-dsl.md, section 2).
//
//   sae --gate-describe | saegate             sae.d.ts on stdout
//   sae --gate-describe | saegate --expect M  the lines tests/gate/dump.ts
//                                             should print for the described
//                                             names, M = web, all or none
//   sae --gate-describe | saegate --check-arity
//                                             each entry's arity equals its
//                                             count of non-rest parameters
//
// The line's fields: kind (fn, global, patch, value), space, when (always,
// app_or_web_seeks, app_seeks), seek, reach, name, arity, params (each
// {k: arg|opt|rest, n, t}), gives, promise, doc, internal.

import std.io
import std.json
import std.os
import std.string
import std.strbuilder

extern exit(code: int)

fail_(why: string) {
    _w = io.stderr_write("saegate: ${why}\n")
    exit(2)
}

str_of_(v: ptr, key: string) -> string {
    f = json.json_object_get_raw(v, key)
    if f == null { return "" }
    s, _e = json.get_string(f)
    return s
}

int_of_(v: ptr, key: string) -> int {
    f = json.json_object_get_raw(v, key)
    if f == null { return 0 }
    return json.json_get_int(f)
}

// The TypeScript of a spec type (gate_type_name_ in src/sae_host.ae).
ts_type_(t: string) -> string {
    if t == "str" { return "string" }
    if t == "str_or_null" { return "string | null" }
    if t == "num" { return "number" }
    if t == "delay" { return "number" }
    if t == "timer" { return "sae.Timer" }
    if t == "frame" { return "sae.Frame" }
    if t == "fn" { return "(...args: any[]) => void" }
    if t == "frame_fn" { return "(timestamp: number) => void" }
    if t == "any" { return "unknown" }
    return "void"
}

// A function's TypeScript parameter list, from its params array.
ts_params_(params: ptr) -> string {
    out = ""
    n = json.json_array_size(params)
    i = 0
    while i < n {
        pr = json.json_array_get_raw(params, i)
        k = str_of_(pr, "k")
        nm = str_of_(pr, "n")
        t = str_of_(pr, "t")
        sep = ""
        if i > 0 { sep = ", " }
        if k == "arg" { out = "${out}${sep}${nm}: ${ts_type_(t)}" }
        if k == "opt" { out = "${out}${sep}${nm}?: ${ts_type_(t)}" }
        if k == "rest" { out = "${out}${sep}...${nm}: unknown[]" }
        i = i + 1
    }
    return out
}

// The count of parameters that are not the rest parameter.
nonrest_(params: ptr) -> int {
    c = 0
    n = json.json_array_size(params)
    i = 0
    while i < n {
        if str_of_(json.json_array_get_raw(params, i), "k") != "rest" { c = c + 1 }
        i = i + 1
    }
    return c
}

// The line of a function's result: T, or Promise<T>.
ts_result_(e: ptr) -> string {
    r = ts_type_(str_of_(e, "gives"))
    if int_of_(e, "promise") == 1 { return "Promise<${r}>" }
    return r
}

doc_(out: ptr, indent: string, e: ptr) {
    d = str_of_(e, "doc")
    if d != "" { _a = strbuilder.append(out, "${indent}/** ${d} */\n") }
}

// What a page's dump (tests/gate/dump.ts) prints of an installed function.
shape_of_(e: ptr) -> string {
    return "function length=${int_of_(e, "arity")}"
}

// Whether the space exists in the dump mode `mode` (web: a page loaded from
// a file that seeks nothing; all: an app that grants and seeks everything;
// none: an app that grants and seeks nothing).
present_(e: ptr, mode: string) -> int {
    if str_of_(e, "when") == "always" { return 1 }
    if mode == "all" { return 1 }
    return 0
}

// The d.ts for one entry (an installed member), indented, into `out`.
member_(out: ptr, e: ptr) {
    kind = str_of_(e, "kind")
    doc_(out, "  ", e)
    if kind == "value" {
        _a = strbuilder.append(out, "  readonly ${str_of_(e, "name")}: ${ts_type_(str_of_(e, "gives"))};\n")
        return
    }
    _b = strbuilder.append(out, "  ${str_of_(e, "name")}(${ts_params_(json.json_object_get_raw(e, "params"))}): ${ts_result_(e)};\n")
}

dts_header_(out: ptr) {
    _a = strbuilder.append(out, "// Generated by tools/saegate from the gate spec in src/sae_host.ae\n")
    _b = strbuilder.append(out, "// (tools/gen-dts.sh; tests/check_gate.sh holds it to the spec). Do not edit.\n")
    _c = strbuilder.append(out, "//\n")
    _d = strbuilder.append(out, "// What a page of sae sees, for the namespaces the spec describes so far. It\n")
    _e = strbuilder.append(out, "// assumes \"lib\": [\"es2023\"] with no DOM: print, setTimeout and performance\n")
    _f = strbuilder.append(out, "// here are sae's own. A namespace marked @seeks exists only for a page that\n")
    _g = strbuilder.append(out, "// seeks that privilege and is granted it (@appOnly: in an installed app).\n")
    _h = strbuilder.append(out, "declare namespace sae {\n")
    _i = strbuilder.append(out, "  /** An id from setTimeout or setInterval, for clearTimeout and clearInterval. */\n")
    _j = strbuilder.append(out, "  type Timer = number;\n")
    _j2 = strbuilder.append(out, "  /** An id from requestAnimationFrame, for cancelAnimationFrame. */\n")
    _j3 = strbuilder.append(out, "  type Frame = number;\n")
    _k = strbuilder.append(out, "}\n")
}

main() {
    arg1 = os.args_get(1)
    expect_mode = ""
    if arg1 == "--expect" {
        expect_mode = os.args_get(2)
        if expect_mode != "web" && expect_mode != "all" && expect_mode != "none" { fail_("--expect takes web, all or none") }
    } else {
        if arg1 != "" && arg1 != "--check-arity" { fail_("usage: saegate [--expect web|all|none | --check-arity]") }
    }
    out = strbuilder.new(4096)
    if arg1 == "" { dts_header_(out) }
    cur = "" // the space whose declaration is open
    bad = 0
    count = 0
    while true {
        line, eof, err = io.fd_read_line_status(0)
        if err != "" { fail_("reading stdin: ${err}") }
        if line != "" {
            e, perr = json.parse(line)
            if perr != "" { fail_("not JSON (${perr}): ${line}") }
            count = count + 1
            kind = str_of_(e, "kind")
            space = str_of_(e, "space")
            name = str_of_(e, "name")
            params = json.json_object_get_raw(e, "params")
            if arg1 == "--check-arity" {
                if kind != "value" && nonrest_(params) != int_of_(e, "arity") {
                    _w = io.stderr_write("FAIL ${space}.${name}: arity ${int_of_(e, "arity")} but ${nonrest_(params)} non-rest parameters\n")
                    bad = bad + 1
                }
            } else if expect_mode != "" {
                if kind == "patch" {
                    _a = strbuilder.append(out, "M ${space}.${name} ${shape_of_(e)}\n")
                } else if kind == "global" {
                    _b = strbuilder.append(out, "G ${name} ${shape_of_(e)}\n")
                } else {
                    here = present_(e, expect_mode)
                    if space != cur {
                        cur = space
                        if here == 1 {
                            _c = strbuilder.append(out, "G ${space} object\n")
                        } else {
                            _d = strbuilder.append(out, "G ${space} absent\n")
                        }
                    }
                    if here == 1 {
                        if kind == "value" {
                            _e = strbuilder.append(out, "M ${space}.${name} ${ts_type_(str_of_(e, "gives"))}\n")
                        } else {
                            _f = strbuilder.append(out, "M ${space}.${name} ${shape_of_(e)}\n")
                        }
                    }
                }
            } else if kind != "patch" && int_of_(e, "internal") == 0 {
                if kind == "global" {
                    if cur != "" {
                        _g = strbuilder.append(out, "};\n")
                        cur = ""
                    }
                    doc_(out, "", e)
                    _h = strbuilder.append(out, "declare function ${name}(${ts_params_(params)}): ${ts_result_(e)};\n")
                } else {
                    if space != cur {
                        if cur != "" { _i = strbuilder.append(out, "};\n") }
                        cur = space
                        when_ = str_of_(e, "when")
                        if when_ != "always" {
                            note = "@seeks ${str_of_(e, "seek")}"
                            if when_ == "app_seeks" { note = "${note} @appOnly" }
                            _j = strbuilder.append(out, "/** ${note} */\n")
                        }
                        _k = strbuilder.append(out, "declare const ${space}: {\n")
                    }
                    member_(out, e)
                }
            }
        }
        if eof == true { break }
    }
    if arg1 == "--check-arity" {
        if count == 0 { fail_("no entries on stdin") }
        if bad > 0 { exit(1) }
        io.stdout_write("ok   ${count} entries: each arity is its count of non-rest parameters\n")
        return
    }
    if cur != "" && expect_mode == "" { _l = strbuilder.append(out, "};\n") }
    if count == 0 { fail_("no entries on stdin") }
    io.stdout_write(strbuilder.finish(out))
}
