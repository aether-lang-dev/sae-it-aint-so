// saegate: what the gate spec says (`sae --gate-describe`: one JSON line per
// entry on stdin), as TypeScript, and as the expectations
// tests/check_gate.sh holds the live page objects to
// (docs/design/gate-dsl.md, section 2).
//
//   sae --gate-describe | saegate             sae.d.ts on stdout
//   sae --gate-describe | saegate --expect M [--names N]
//                                             the lines tests/gate/dump.ts
//                                             should print for the described
//                                             names, M a mode of
//                                             tests/gate/dump.sh; N the names
//                                             the page's each spaces have
//                                             (sqlite: notes; natives:
//                                             calc=sum+upper)
//   sae --gate-describe | saegate --seeks     one "<privilege>:<object>" a line: the
//                                             spaces a page seeks to have, once each
//                                             (the lowerer's SEEKABLE is held to it)
//   sae --gate-describe | saegate --always    the names every page has: the spaces that
//                                             are always there and the global functions
//                                             (tests/spec_globals.ae's SAE_EVERY_PAGE)
//   sae --gate-describe | saegate --check-arity
//                                             each entry's arity equals its
//                                             count of non-rest parameters
//
// The line's fields: kind (fn, global, patch, value, provided,
// provided_value, provided_global, raw: a hidden object's function, which a
// page never sees; dynamic: members the page's own names make; loader: the
// module loader's `$sae.m`; held: a function the engine is given), space, when
// (always, app_or_web_seeks, app_seeks, app_seeks_each, probe, wrapped), seek,
// each (1: an object for each name the page gets), reach, name, arity, params (each {k: arg|opt|rest|beyond, n, t}, t a spec type or "ts:..."), gives, ts (the
// TypeScript of a "raw" result), promise, doc, internal.

import std.io
import std.json
import std.os
import std.string
import std.strbuilder

extern exit(code: int)

fail_(why: string) {
    _w = io.stderr_write("saegate: ${why}\n")
    exit(2)
}

str_of_(v: ptr, key: string) -> string {
    f = json.json_object_get_raw(v, key)
    if f == null { return "" }
    s, _e = json.get_string(f)
    return s
}

int_of_(v: ptr, key: string) -> int {
    f = json.json_object_get_raw(v, key)
    if f == null { return 0 }
    return json.json_get_int(f)
}

// The TypeScript of a spec type (gate_type_name_ in src/sae_host.ae).
ts_type_(t: string) -> string {
    if t == "str" { return "string" }
    if t == "str_or_null" { return "string | null" }
    if t == "num" { return "number" }
    if t == "delay" { return "number" }
    if t == "timer" { return "sae.Timer" }
    if t == "frame" { return "sae.Frame" }
    if t == "fn" { return "(...args: any[]) => void" }
    if t == "frame_fn" { return "(timestamp: number) => void" }
    if t == "any" { return "unknown" }
    if t == "int" { return "number" }
    if t == "flag" { return "boolean | number" }
    if t == "widget" { return "sae.Widget" }
    if t == "vgnode" { return "sae.VgNode" }
    if t == "grid" { return "sae.Grid" }
    if t == "block" { return "() => void" }
    if t == "lead_num" { return "number" }
    if t == "lead_node" { return "sae.VgNode" }
    if t == "bytes" { return "Uint8Array | Uint8ClampedArray" }
    if t == "points" { return "string | number[]" }
    if t == "str_num" { return "string | number" }
    if t == "obj" { return "Record<string, unknown>" }
    if t == "bool" { return "boolean" }
    if t == "handle" { return "sae.Widget | sae.VgNode" }
    return "void"
}

// The TypeScript of a parameter's type: a spec type, or "ts:..." (arg_ts) as written.
param_type_(t: string) -> string {
    if string.starts_with(t, "ts:") == 1 { return string.substring(t, 3, string.length(t)) }
    return ts_type_(t)
}

// What `typeof` says of a non-function member of a spec type.
typeof_(t: string) -> string {
    if t == "str" || t == "str_or_null" { return "string" }
    if t == "num" || t == "int" { return "number" }
    if t == "obj" { return "object" }
    return t
}

// A function's TypeScript parameter list, from its params array. A parameter
// of a "lead_" type (a number or handle that may be left out) is dropped when
// `lead` is 0: the entry is then written as two overloads.
ts_params_(params: ptr, lead: int) -> string {
    out = ""
    n = json.json_array_size(params)
    i = 0
    while i < n {
        pr = json.json_array_get_raw(params, i)
        k = str_of_(pr, "k")
        nm = str_of_(pr, "n")
        t = str_of_(pr, "t")
        if lead == 0 && string.starts_with(t, "lead_") == 1 {
            i = i + 1
            continue
        }
        sep = ""
        if out != "" { sep = ", " }
        if k == "arg" { out = "${out}${sep}${nm}: ${param_type_(t)}" }
        if k == "opt" || k == "beyond" { out = "${out}${sep}${nm}?: ${param_type_(t)}" }
        if k == "rest" { out = "${out}${sep}...${nm}: unknown[]" }
        i = i + 1
    }
    return out
}

// The count of parameters that are not the rest parameter.
nonrest_(params: ptr) -> int {
    c = 0
    n = json.json_array_size(params)
    i = 0
    while i < n {
        k = str_of_(json.json_array_get_raw(params, i), "k")
        if k != "rest" && k != "beyond" { c = c + 1 }
        i = i + 1
    }
    return c
}

// Whether a parameter is of a "lead_" type.
has_lead_(params: ptr) -> int {
    n = json.json_array_size(params)
    i = 0
    while i < n {
        if string.starts_with(str_of_(json.json_array_get_raw(params, i), "t"), "lead_") == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// The line of a function's result: T, or Promise<T>.
ts_result_(e: ptr) -> string {
    r = ts_type_(str_of_(e, "gives"))
    if str_of_(e, "gives") == "raw" { r = str_of_(e, "ts") }
    if int_of_(e, "promise") == 1 { return "Promise<${r}>" }
    return r
}

doc_(out: ptr, indent: string, e: ptr) {
    d = str_of_(e, "doc")
    if d != "" { _a = strbuilder.append(out, "${indent}/** ${d} */\n") }
}

// What a page's dump (tests/gate/dump.ts) prints of an installed function.
shape_of_(e: ptr) -> string {
    return "function length=${int_of_(e, "arity")}"
}

// The privileges a page of the dump mode `mode` seeks and has (sought, and
// granted or available: tests/gate/dump.sh has each mode). Separated by commas.
//   web, none, unsought   nothing: a page seeking nothing, or an app that
//                         grants everything and seeks nothing
//   probe, module         nothing, from a page loaded from a file: the sandbox
//                         probe switched on; a page that imports
//   webseeks, some        outgoing-http, clipboard
//   optional              clipboard (the one privilege an app has without a grant)
//   all                   every privilege an app can seek and be granted
//   just-<privilege>      that one (an app granted everything)
mode_has_(mode: string) -> string {
    if string.starts_with(mode, "just-") == 1 { return ",${string.substring(mode, 5, string.length(mode))}," }
    if mode == "webseeks" || mode == "some" { return ",outgoing-http,clipboard," }
    if mode == "optional" { return ",clipboard," }
    if mode == "all" { return ",local-filesystem,outgoing-http,open-urls,print,documents,clipboard,clipboard-read,control-bus,backend," }
    return ","
}

// Whether the mode is an installed app (web, webseeks, probe and module load a
// page from a file).
mode_is_app_(mode: string) -> int {
    if mode == "web" || mode == "webseeks" || mode == "probe" || mode == "module" { return 0 }
    return 1
}

// Whether the space exists in the dump mode `mode`.
present_(e: ptr, mode: string) -> int {
    when_ = str_of_(e, "when")
    if when_ == "always" { return 1 }
    if when_ == "probe" {
        if mode == "probe" { return 1 }
        return 0
    }
    if when_ == "wrapped" {
        if mode == "module" { return 1 }
        return 0
    }
    if string.contains(mode_has_(mode), ",${str_of_(e, "seek")},") == 0 { return 0 }
    if (when_ == "app_seeks" || when_ == "app_seeks_each") && mode_is_app_(mode) == 0 { return 0 }
    return 1
}

// What `--names` says of one space: "sqlite=notes;natives=calc:sum+upper" has
// "notes" for sqlite (the names its objects have) and "calc:sum+upper" for
// natives (a module and its functions, more than one separated by commas).
names_of_(names: string, space: string) -> string {
    parts = string.split(names, ";")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        part = string.string_array_get(parts, i)
        if string.starts_with(part, "${space}=") == 1 { return string.substring(part, string.length(space) + 1, string.length(part)) }
        i = i + 1
    }
    return ""
}

// The d.ts for one entry (an installed member), indented, into `out`.
member_(out: ptr, e: ptr, ind: string) {
    kind = str_of_(e, "kind")
    doc_(out, ind, e)
    if kind == "value" || kind == "provided_value" {
        _a = strbuilder.append(out, "${ind}readonly ${str_of_(e, "name")}: ${ts_type_(str_of_(e, "gives"))};\n")
        return
    }
    params = json.json_object_get_raw(e, "params")
    sigs = str_of_(e, "sigs")
    if sigs != "" {
        parts = string.split(sigs, "\n")
        np = string.string_array_size(parts)
        pi = 0
        while pi < np {
            _s = strbuilder.append(out, "${ind}${str_of_(e, "name")}${string.string_array_get(parts, pi)};\n")
            pi = pi + 1
        }
        return
    }
    _b = strbuilder.append(out, "${ind}${str_of_(e, "name")}(${ts_params_(params, 1)}): ${ts_result_(e)};\n")
    if has_lead_(params) == 1 {
        _c = strbuilder.append(out, "${ind}${str_of_(e, "name")}(${ts_params_(params, 0)}): ${ts_result_(e)};\n")
    }
}

dts_header_(out: ptr) {
    _a = strbuilder.append(out, "// Generated by tools/saegate from the gate spec in src/sae_host.ae\n")
    _b = strbuilder.append(out, "// (tools/gen-dts.sh; tests/check_gate.sh holds it to the spec). Do not edit.\n")
    _c = strbuilder.append(out, "//\n")
    _d = strbuilder.append(out, "// What a page of sae sees, for the namespaces the spec describes so far. It\n")
    _e = strbuilder.append(out, "// assumes \"lib\": [\"es2023\"] with no DOM: print, setTimeout and performance\n")
    _f = strbuilder.append(out, "// here are sae's own. A namespace marked @seeks exists only for a page that\n")
    _g = strbuilder.append(out, "// seeks that privilege and is granted it (@appOnly: in an installed app).\n")
    _h = strbuilder.append(out, "declare namespace sae {\n")
    _i0 = strbuilder.append(out, "  /** A widget handle: what a builder of ui returns, for the calls that take one. */\n")
    _i1 = strbuilder.append(out, "  type Widget = number;\n")
    _i2 = strbuilder.append(out, "  /** A vg scene, group or shape handle. */\n")
    _i3 = strbuilder.append(out, "  type VgNode = number;\n")
    _i4 = strbuilder.append(out, "  /** A datagrid handle (not a widget). */\n")
    _i5 = strbuilder.append(out, "  type Grid = number;\n")
    _i6 = strbuilder.append(out, "  /** A reactive value (state, computed): a number, string or boolean is held in one cell, any other value by the page. */\n")
    _i7 = strbuilder.append(out, "  interface State<T> {\n")
    _i8 = strbuilder.append(out, "    /** The raw cell handle, for ui.ui_set and ui.text_bound. */\n")
    _i9 = strbuilder.append(out, "    h: number;\n    value: T;\n    get(): T;\n    set(v: T): T;\n    update(fn: (v: T) => T): T;\n")
    _ia = strbuilder.append(out, "    subscribe(fn: (v: T) => void): State<T>;\n  }\n")
    _ib = strbuilder.append(out, "  /** What an http callback gets: ok is a 2xx answer; status is 0 when nothing came back; error is empty unless the request failed or was refused. */\n")
    _ic = strbuilder.append(out, "  interface HttpResponse {\n    ok: boolean;\n    status: number;\n    text: string;\n    error: string;\n    headers: Record<string, string>;\n    json(): any;\n  }\n")
    _id = strbuilder.append(out, "  /** What http.get, post and request return. */\n")
    _ie = strbuilder.append(out, "  interface HttpRequest {\n    id: number;\n    cancel(): void;\n  }\n")
    _if = strbuilder.append(out, "  interface HttpOptions {\n    method?: string;\n    url: string;\n    headers?: Record<string, string>;\n    body?: string;\n    contentType?: string;\n  }\n")
    _if2 = strbuilder.append(out, "  /** What a sqlite transaction's callback gets: the database's own all, get and run, run inside the transaction. */\n  type SqliteTx = Pick<(typeof sqlite)[string], \"all\" | \"get\" | \"run\">;\n")
    _ig = strbuilder.append(out, "  /** A file the person picked, by handle: the page never sees its path, and a handle reaches that one file only. */\n")
    _ih = strbuilder.append(out, "  interface Document {\n    readonly name: string;\n    read_text(): Promise<string>;\n    write_text(text: string): Promise<void>;\n    read_base64(): Promise<string>;\n    write_base64(b64: string): Promise<void>;\n  }\n")
    _i = strbuilder.append(out, "  /** An id from setTimeout or setInterval, for clearTimeout and clearInterval. */\n")
    _j = strbuilder.append(out, "  type Timer = number;\n")
    _j2 = strbuilder.append(out, "  /** An id from requestAnimationFrame, for cancelAnimationFrame. */\n")
    _j3 = strbuilder.append(out, "  type Frame = number;\n")
    _k = strbuilder.append(out, "}\n")
}

// --seal: one line per name of the seal policy, "basis NAME", "reach SPACE
// NAME" (the global functions' space is "(global)") and "kernel NAME", for
// tests/check_gate.sh to hold each host function's seal line to.
seal_names_(prefix: string, names: string) {
    parts = string.split(names, ",")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        nm = string.trim(string.string_array_get(parts, i))
        if nm != "" { io.stdout_write("${prefix} ${nm}\n") }
        i = i + 1
    }
}

seal_lines_(kind: string, names: string) {
    if kind == "seal_basis" { seal_names_("basis", names) }
    if kind == "seal_global_reach" { seal_names_("reach (global)", names) }
    if kind == "seal_kernel_helper" { seal_names_("kernel", names) }
}

main() {
    arg1 = os.args_get(1)
    expect_mode = ""
    each_names = ""
    if arg1 == "--expect" {
        expect_mode = os.args_get(2)
        if string.contains(",web,webseeks,all,some,unsought,optional,none,probe,module,", ",${expect_mode},") == 0 && string.starts_with(expect_mode, "just-") == 0 { fail_("--expect takes web, webseeks, all, some, unsought, optional, none, probe, module or just-<privilege>") }
        if os.args_get(3) == "--names" { each_names = os.args_get(4) }
    } else {
        if arg1 != "" && arg1 != "--check-arity" && arg1 != "--seeks" && arg1 != "--always" && arg1 != "--seal" { fail_("usage: saegate [--expect MODE [--names N] | --check-arity | --seeks | --always | --seal]") }
    }
    out = strbuilder.new(4096)
    if arg1 == "" { dts_header_(out) }
    cur = "" // the space whose declaration is open
    cur_each = 0 // it has an object for each name the page gets: one more level
    bad = 0
    count = 0
    while true {
        line, eof, err = io.fd_read_line_status(0)
        if err != "" { fail_("reading stdin: ${err}") }
        if line != "" {
            e, perr = json.parse(line)
            if perr != "" { fail_("not JSON (${perr}): ${line}") }
            count = count + 1
            kind = str_of_(e, "kind")
            space = str_of_(e, "space")
            name = str_of_(e, "name")
            params = json.json_object_get_raw(e, "params")
            if string.starts_with(kind, "seal_") == 1 {
                // the seal policy (basis, global_reach, kernel_helper): not part of
                // what a page sees; only --seal prints it
                count = count - 1
                if arg1 == "--seal" { seal_lines_(kind, str_of_(e, "names")) }
            } else if arg1 == "--seal" {
                if str_of_(e, "reach") != "" { seal_names_("reach ${space}", str_of_(e, "reach")) }
            } else if arg1 == "--check-arity" {
                if kind != "value" && kind != "provided_value" && kind != "dynamic" && nonrest_(params) != int_of_(e, "arity") {
                    _w = io.stderr_write("FAIL ${space}.${name}: arity ${int_of_(e, "arity")} but ${nonrest_(params)} non-rest parameters\n")
                    bad = bad + 1
                }
            } else if arg1 == "--seeks" {
                if kind != "raw" && str_of_(e, "seek") != "" { io.stdout_write("${str_of_(e, "seek")}:${space}\n") }
            } else if arg1 == "--always" {
                if str_of_(e, "when") == "always" && kind != "patch" && kind != "held" {
                    if kind == "global" || kind == "provided_global" { io.stdout_write("${name}\n") } else { io.stdout_write("${space}\n") }
                }
            } else if kind == "raw" && expect_mode != "" {
                // a hidden object a wrapper deletes: the page never sees it
                if space != cur {
                    cur = space
                    _r = strbuilder.append(out, "G ${space} absent\n")
                }
            } else if expect_mode != "" {
                if kind == "held" {
                    // a function the engine is given: a page cannot name it
                    cur = cur
                } else if kind == "patch" {
                    _a = strbuilder.append(out, "M ${space}.${name} ${shape_of_(e)}\n")
                } else if kind == "global" || kind == "provided_global" {
                    _b = strbuilder.append(out, "G ${name} ${shape_of_(e)}\n")
                } else if kind == "dynamic" {
                    // natives.<module>.<function>: objects of functions of the arity the entry says
                    cur = space
                    if present_(e, expect_mode) == 0 {
                        _d2 = strbuilder.append(out, "G ${space} absent\n")
                    } else {
                        _c2 = strbuilder.append(out, "G ${space} object\n")
                        mods = string.split(names_of_(each_names, space), ",")
                        nm_ = string.string_array_size(mods)
                        mi = 0
                        while mi < nm_ {
                            mspec = string.string_array_get(mods, mi)
                            mi = mi + 1
                            if mspec == "" { continue }
                            mparts = string.split(mspec, ":")
                            mname = string.string_array_get(mparts, 0)
                            _m1 = strbuilder.append(out, "M ${space}.${mname} object\n")
                            fns = string.split(string.string_array_get(mparts, 1), "+")
                            nf_ = string.string_array_size(fns)
                            fi = 0
                            while fi < nf_ {
                                _m2 = strbuilder.append(out, "M ${space}.${mname}.${string.string_array_get(fns, fi)} ${shape_of_(e)}\n")
                                fi = fi + 1
                            }
                        }
                    }
                } else {
                    here = present_(e, expect_mode)
                    eachn = string.split(names_of_(each_names, space), ",")
                    ne_ = string.string_array_size(eachn)
                    if space != cur {
                        cur = space
                        if here == 1 {
                            _c = strbuilder.append(out, "G ${space} object\n")
                            if int_of_(e, "each") == 1 {
                                ei = 0
                                while ei < ne_ {
                                    if string.string_array_get(eachn, ei) != "" { _c3 = strbuilder.append(out, "M ${space}.${string.string_array_get(eachn, ei)} object\n") }
                                    ei = ei + 1
                                }
                            }
                        } else {
                            _d = strbuilder.append(out, "G ${space} absent\n")
                        }
                    }
                    if here == 1 {
                        line_ = "${shape_of_(e)}"
                        if kind == "value" || kind == "provided_value" { line_ = "${typeof_(str_of_(e, "gives"))}" }
                        if int_of_(e, "each") == 1 {
                            ei2 = 0
                            while ei2 < ne_ {
                                if string.string_array_get(eachn, ei2) != "" { _f2 = strbuilder.append(out, "M ${space}.${string.string_array_get(eachn, ei2)}.${name} ${line_}\n") }
                                ei2 = ei2 + 1
                            }
                        } else {
                            _f = strbuilder.append(out, "M ${space}.${name} ${line_}\n")
                        }
                    }
                }
            } else if kind != "patch" && kind != "raw" && kind != "held" && kind != "loader" && str_of_(e, "when") != "probe" && str_of_(e, "when") != "wrapped" && int_of_(e, "internal") == 0 {
                if kind == "dynamic" {
                    if cur != "" {
                        if cur_each == 1 { _g3 = strbuilder.append(out, "  };\n") }
                        _g2 = strbuilder.append(out, "};\n")
                        cur = ""
                        cur_each = 0
                    }
                    _dn = strbuilder.append(out, "/**\n * ${str_of_(e, "doc")}\n * @seeks ${str_of_(e, "seek")} @appOnly\n */\ndeclare const ${space}: ${str_of_(e, "ts")};\n")
                } else if kind == "global" || kind == "provided_global" {
                    if cur != "" {
                        if cur_each == 1 { _g4 = strbuilder.append(out, "  };\n") }
                        _g = strbuilder.append(out, "};\n")
                        cur = ""
                        cur_each = 0
                    }
                    doc_(out, "", e)
                    if str_of_(e, "sigs") != "" {
                        gsigs = string.split(str_of_(e, "sigs"), "\n")
                        gn = string.string_array_size(gsigs)
                        gi = 0
                        while gi < gn {
                            _gs = strbuilder.append(out, "declare function ${name}${string.string_array_get(gsigs, gi)};\n")
                            gi = gi + 1
                        }
                    } else {
                        _h = strbuilder.append(out, "declare function ${name}(${ts_params_(params, 1)}): ${ts_result_(e)};\n")
                    }
                } else {
                    if space != cur {
                        if cur != "" {
                            if cur_each == 1 { _i2 = strbuilder.append(out, "  };\n") }
                            _i = strbuilder.append(out, "};\n")
                        }
                        cur = space
                        cur_each = int_of_(e, "each")
                        when_ = str_of_(e, "when")
                        if when_ != "always" {
                            note = "@seeks ${str_of_(e, "seek")}"
                            if when_ == "app_seeks" || when_ == "app_seeks_each" { note = "${note} @appOnly" }
                            _j = strbuilder.append(out, "/** ${note} */\n")
                        }
                        _k = strbuilder.append(out, "declare const ${space}: {\n")
                        if cur_each == 1 { _k2 = strbuilder.append(out, "  [${str_of_(e, "seek")}: string]: {\n") }
                    }
                    if cur_each == 1 { member_(out, e, "    ") } else { member_(out, e, "  ") }
                }
            }
        }
        if eof == true { break }
    }
    if arg1 == "--check-arity" {
        if count == 0 { fail_("no entries on stdin") }
        if bad > 0 { exit(1) }
        io.stdout_write("ok   ${count} entries: each arity is its count of non-rest parameters\n")
        return
    }
    if arg1 == "--seeks" || arg1 == "--always" || arg1 == "--seal" { return }
    if cur != "" && expect_mode == "" {
        if cur_each == 1 { _l2 = strbuilder.append(out, "  };\n") }
        _l = strbuilder.append(out, "};\n")
    }
    if count == 0 { fail_("no entries on stdin") }
    io.stdout_write(strbuilder.finish(out))
}
